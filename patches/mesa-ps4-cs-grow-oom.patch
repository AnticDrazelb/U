+/* A CS that has failed (cs->status, which vkEndCommandBuffer returns: the command buffer is never
+ * submitted) records into a host buffer, at least `min_size` dwords long, until it is reset.
+ * Upstream went on with the IB it had: it wrote a chain packet 4 dwords before its start (cdw 0)
+ * and gave it the max_dw of the IB that couldn't be allocated, so what followed ran past its end -
+ * a crash instead of VK_ERROR_OUT_OF_DEVICE_MEMORY when the PS4's GPU memory ran out (Eden4's
+ * KNOWN_ISSUES). */
+static void
+radv_amdgpu_cs_discard(struct radv_amdgpu_cs *cs, size_t min_size)
+{
+   const size_t want = MAX2(min_size + 16, 16384);
+   if (cs->discard_dw < want) {
+      uint32_t *buf = realloc(cs->discard_buf, want * 4);
+      if (!buf) {
+         fprintf(stderr, "radv: out of host memory for a failed command buffer\n");
+         abort();
+      }
+      if (cs->base.buf == cs->discard_buf)
+         cs->base.buf = buf;
+      cs->discard_buf = buf;
+      cs->discard_dw = want;
+   }
+   if (cs->base.buf != cs->discard_buf)
+      cs->ib_max_dw = cs->base.max_dw;
+   cs->base.buf = cs->discard_buf;
+   cs->base.cdw = 0;
+   cs->base.reserved_dw = 0;
+   cs->base.max_dw = cs->discard_dw - 32; /* (finalize's padding and 4 dwords of chain NOPs) */
+}
