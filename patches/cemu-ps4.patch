+	void Menu::BuildItems()
+	{
+		for (auto& items : m_items)
+			items.clear();
+
+		auto& settings = m_items[(int)Category::Settings];
+		const auto& categories = CremaSettings::Categories();
+		constexpr const char* GROUP_HELP[] = {"TV picture, touch pointer, FPS counter", "CPU mode, shaders, language",
+			"Volume, GamePad speaker, buffer", "Touchpad, motion controls", "Logs and freeze reports - on or off"};
+		for (size_t i = 0; i < categories.size(); i++)
+			settings.push_back({categories[i], i < std::size(GROUP_HELP) ? GROUP_HELP[i] : "", -1, -1, SET_GROUP + (int)i});
+		settings.push_back({"Language", PS4Lang::Current().name, -1, -1, SET_LANGUAGE});
+		settings.push_back({"Sound Effects", m_prefs.sounds ? "On" : "Off", -1, -1, SET_SOUNDS});
+		settings.push_back({"Volume", std::to_string(m_prefs.volume), -1, -1, SET_VOLUME});
+		settings.push_back({"Menu Style", Library() ? "Library" : "XMB", -1, -1, SET_STYLE});
+		settings.push_back({"Clock", m_prefs.clock ? "On" : "Off", -1, -1, SET_CLOCK});
+		settings.push_back({"Game Folder", GamesFolder(), -1, -1, SET_GAMES_DIR});
+		settings.push_back({"Download Covers", "Box art from GameTDB for your games", -1, -1, SET_COVERS});
+		settings.push_back({"Reset All Settings", "Every setting back to the defaults", -1, -1, SET_RESET_ALL});
+		settings.push_back({"About", "", -1, -1, SET_ABOUT});
+
+		auto& games = m_items[(int)Category::Games];
+		std::vector<int> order(m_games.size());
+		for (size_t i = 0; i < order.size(); i++)
+			order[i] = (int)i;
+		if (m_prefs.sort == "recent")
+		{
+			std::stable_sort(order.begin(), order.end(),
+				[this](int a, int b) { return Played(m_games[a].path) > Played(m_games[b].path); });
+		}
+		for (const int i : order)
+		{
+			const Game& game = m_games[i];
+			std::string detail = game.homebrew ? "Homebrew" : game.id;
+			if (!m_prefs.defaultGame.empty() && game.path == m_prefs.defaultGame)
+				detail += "  -  Starts when Crema opens";
+			games.push_back({game.title, detail, i, -1, -1});
+		}
+		if (games.empty())
+			games.push_back({"No games found", "Copy games to " + GamesFolder() + ", then press Square"});
+		for (int c = 0; c < CATEGORY_COUNT; c++)
+			m_selected[c] = std::clamp(m_selected[c], 0, std::max(0, (int)m_items[c].size() - 1));
+
+		auto& themes = m_items[(int)Category::Themes];
+		for (size_t i = 0; i < std::size(THEMES); i++)
+		{
+			const bool active = m_prefs.wallpaper.empty() && m_prefs.theme == THEMES[i].name;
+			themes.push_back({THEMES[i].name, active ? "In use" : "Color theme", -1, (int)i});
+		}
+		for (size_t i = 0; i < m_wallpapers.size(); i++)
+		{
+			const bool active = m_prefs.wallpaper == m_wallpapers[i];
+			themes.push_back({fs::path(m_wallpapers[i]).stem().string(), active ? "In use" : "Wallpaper", -1, -2 - (int)i});
+		}
+	}
