+	uint32 CremaCodeHash(uint32 address)
+	{
+		if (!memory_isAddressRangeAccessible(address, 32))
+			return 0;
+		const uint8* code = memory_getPointerFromVirtualOffset(address);
+		uint32 hash = 2166136261u;
+		for (int i = 0; i < 32; i++)
+			hash = (hash ^ code[i]) * 16777619u;
+		return hash ? hash : 1;
+	}
+
+	// the list for the running game, once its title ID is known (under s_cremaWarmLock)
+	bool CremaWarmLoad()
+	{
+		if (s_cremaWarmLoaded)
+			return true;
+		const uint64 titleId = CafeSystem::GetForegroundTitleId();
+		if (titleId == 0)
+			return false;
+		s_cremaWarmLoaded = true;
+		const fs::path folder = ActiveSettings::GetCachePath("jit");
+		std::error_code ec;
+		fs::create_directories(folder, ec);
+		s_cremaWarmPath = _pathToUtf8(folder / fmt::format("{:016x}.txt", titleId));
+		// "address hash" lines, and "address hash cost" (CPU ms) for the expensive ones (1.81)
+		std::unordered_map<uint32, uint32> cost;
+		if (FILE* file = fopen(s_cremaWarmPath.c_str(), "r"))
+		{
+			char line[64];
+			while (fgets(line, sizeof(line), file))
+			{
+				unsigned int address, hash, ms = 0;
+				if (sscanf(line, "%x %x %u", &address, &hash, &ms) < 2)
+					continue;
+				if (ms)
+				{
+					cost[address] = std::max(cost[address], (uint32)ms);
+					s_cremaWarmCosted.insert(address);
+				}
+				if (s_cremaWarmList.size() < kCremaWarmMax && s_cremaWarmRecorded.insert(address).second)
+					s_cremaWarmList.emplace_back(address, hash);
+			}
+			fclose(file);
+		}
+		// the expensive ones first (they are what makes the game stutter), the rest in the order the
+		// game first needed them
+		std::stable_sort(s_cremaWarmList.begin(), s_cremaWarmList.end(), [&](const auto& a, const auto& b) {
+			const auto ca = cost.find(a.first), cb = cost.find(b.first);
+			return (ca == cost.end() ? 0 : ca->second) > (cb == cost.end() ? 0 : cb->second);
+		});
+		char text[220];
+		snprintf(text, sizeof(text), "recompiler: %zu game functions remembered from earlier sessions, %zu of them expensive (%s)",
+			s_cremaWarmList.size(), cost.size(), s_cremaWarmPath.c_str());
+		ps4_boot_trace(text);
+		return true;
+	}
+
+	// writes the new lines (all of them when forced, else in batches) (under s_cremaWarmLock)
+	void CremaWarmFlushLocked(bool force)
+	{
+		if (s_cremaWarmPending.empty() || s_cremaWarmPath.empty())
+			return;
+		const uint64 now = CremaNowNs();
+		if (!force && s_cremaWarmPending.size() < 32 * 18 && now - s_cremaWarmLastFlush < 30000000000ull)
+			return;
+		s_cremaWarmLastFlush = now;
+		if (FILE* file = fopen(s_cremaWarmPath.c_str(), "a"))
+		{
+			fwrite(s_cremaWarmPending.data(), 1, s_cremaWarmPending.size(), file);
+			fclose(file);
+		}
+		s_cremaWarmPending.clear();
+	}
+
+	// a function compiled and made active: remembered for the next session, with its cost (CPU
+	// ms) when that was at least kCremaWarmCostly
+	constexpr uint32 kCremaWarmCostly = 50;
+	void CremaWarmRecord(uint32 address, uint32 costMs)
+	{
+		const uint32 hash = CremaCodeHash(address);
+		std::lock_guard lock(s_cremaWarmLock);
+		s_cremaWarmStarted.store(true, std::memory_order_relaxed);
+		if (!CremaWarmLoad() || hash == 0)
+			return;
+		const bool costly = costMs >= kCremaWarmCostly;
+		const bool known = s_cremaWarmRecorded.count(address) != 0;
+		if (known && (!costly || s_cremaWarmCosted.count(address)))
+			return;
+		if (!known && s_cremaWarmRecorded.size() >= kCremaWarmMax)
+			return;
+		s_cremaWarmRecorded.insert(address);
+		char line[40];
+		if (costly)
+		{
+			s_cremaWarmCosted.insert(address);
+			snprintf(line, sizeof(line), "%08x %08x %u\n", address, hash, costMs);
+		}
+		else
+			snprintf(line, sizeof(line), "%08x %08x\n", address, hash);
+		s_cremaWarmPending += line;
+		CremaWarmFlushLocked(false);
+	}
+
+	void CremaJitRecord(PPCRecFunction_t* func)
+	{
+		const uint32 slot = s_cremaJitNext.load(std::memory_order_relaxed) % kCremaJitRanges;
+		CremaJitRange& r = s_cremaJitRanges[slot];
+		r.x86Start.store(0, std::memory_order_relaxed);
+		r.x86Size.store((uint32)func->x86Size, std::memory_order_relaxed);
+		r.ppcStart.store(func->ppcAddress, std::memory_order_relaxed);
+		r.ppcSize.store(func->ppcSize, std::memory_order_relaxed);
+		r.x86Start.store((uintptr_t)func->x86Code, std::memory_order_release);
+		s_cremaJitNext.fetch_add(1, std::memory_order_release);
+	}
