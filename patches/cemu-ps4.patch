+#pragma once
+
+#include "IAudioAPI.h"
+
+#include <atomic>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+// PS4: sound through libSceAudioOut. The emulated sound hardware (snd_core) feeds blocks of
+// samples into a ring buffer; an output thread hands the PS4 grains of 256 frames
+// (sceAudioOutOutput blocks until the previous grain is playing, which paces it). Each device
+// (TV, GamePad) is its own AudioOut port; the PS4 mixes the ports.
+class PS4AudioAPI : public IAudioAPI
+{
+public:
+	class PS4DeviceDescription : public DeviceDescription
+	{
+	public:
+		PS4DeviceDescription() : DeviceDescription(L"PS4 audio out") {}
+		std::wstring GetIdentifier() const override { return L"default"; }
+	};
+
+	PS4AudioAPI(uint32 samplerate, uint32 channels, uint32 samples_per_block, uint32 bits_per_sample);
+	~PS4AudioAPI();
+
+	AudioAPI GetType() const override { return PS4AudioOut; }
+	bool NeedAdditionalBlocks() const override;
+	bool FeedBlock(sint16* data) override;
+	bool Play() override;
+	bool Stop() override;
+	void SetVolume(sint32 volume) override;
+
+	static std::vector<DeviceDescriptionPtr> GetDevices();
+	static bool InitializeStatic();
+
+private:
+	static constexpr uint32 kGrainFrames = 256; // sceAudioOutOutput's unit
+
+	void OutputLoop();
+
+	int m_port = -1;
+	std::thread m_thread;
+	std::atomic<bool> m_running{false};
+
+	// queued samples (interleaved, m_channels each): a ring of m_ring.size() samples
+	mutable std::mutex m_mutex;
+	std::vector<sint16> m_ring;
+	size_t m_readPos = 0, m_count = 0;
+};
