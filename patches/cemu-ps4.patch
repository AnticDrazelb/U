+	// the hash over the function's first 32 bytes of code (a changed or not loaded function is
+	// skipped). Tekken Tag Tournament 2 compiled ~175 functions for 1-3 s each in every session,
+	// each a stutter while the game ran it in the interpreter, in menus and fights alike.
+	constexpr size_t kCremaWarmMax = 40000;
+	std::mutex s_cremaWarmLock;
+	std::vector<std::pair<uint32, uint32>> s_cremaWarmList; // address, code hash, in first-compiled order
+	size_t s_cremaWarmNext = 0;
+	std::unordered_set<uint32> s_cremaWarmRecorded; // addresses in the file
+	std::unordered_set<uint32> s_cremaWarmCosted; // ... with their cost
