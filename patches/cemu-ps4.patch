+	void Menu::OpenSettingPanel(int setting)
+	{
+		m_panel = {};
+		m_panel.open = true;
+		m_panel.setting = setting;
+		switch (setting)
+		{
+		case SET_SOUNDS:
+			m_panel.title = "Sound Effects";
+			m_panel.options = {"On", "Off"};
+			m_panel.selected = m_prefs.sounds ? 0 : 1;
+			break;
+		case SET_VOLUME:
+			m_panel.title = "Volume";
+			for (int v = 100; v >= 0; v -= 10)
+				m_panel.options.push_back(std::to_string(v));
+			m_panel.selected = (100 - m_prefs.volume) / 10;
+			break;
+		case SET_LANGUAGE:
+		{
+			m_panel.title = "Language";
+			const auto& languages = PS4Lang::All();
+			for (size_t i = 0; i < languages.size(); i++)
+			{
+				m_panel.options.push_back(languages[i].name);
+				if (std::string(languages[i].code) == PS4Lang::Current().code)
+					m_panel.selected = (int)i;
+			}
+			break;
+		}
+		case SET_STYLE:
+			m_panel.title = "Menu Style";
+			m_panel.options = {"Library", "XMB"};
+			m_panel.selected = Library() ? 0 : 1;
+			m_panel.lines = {"", "Library: your games in a row,", "tabs switched with L1 / R1.", "",
+				"XMB: the PSP-style columns."};
+			break;
+		case SET_CLOCK:
+			m_panel.title = "Clock";
+			m_panel.options = {"On", "Off"};
+			m_panel.selected = m_prefs.clock ? 0 : 1;
+			break;
+		case SET_GAMES_DIR:
+			OpenFolderBrowser(GamesFolder());
+			return;
+		case SET_COVERS:
+			m_panel.title = "Download Covers";
+			if (!m_coverThread.joinable())
+			{
+				// covers that failed or were removed: look again
+				StartCoverDownload();
+			}
+			m_panel.lines = {"", "Connecting to GameTDB..."};
+			break;
+		case SET_UPDATE_CHECK:
+			StartUpdateCheck(true);
+			ShowUpdatePanel();
+			return;
+		case SET_AUTO_UPDATE:
+			m_panel.title = "Automatic Updates";
+			m_panel.options = {"On", "Off"};
+			m_panel.selected = m_prefs.autoUpdate ? 0 : 1;
+			m_panel.lines = {"", "On: when Crema opens, it looks", "for a new version on GitHub", "and asks before downloading it."};
+			break;
+		case SET_RESET_ALL:
+			m_panel.title = "Reset All Settings";
+			m_panel.options = {"Cancel", "Reset everything"};
+			m_panel.lines = {"", "All games, global and per game,", "go back to the default settings."};
+			break;
+		case SET_ABOUT:
+			m_panel.title = "About";
+			m_panel.lines = {"Crema",
+				"Wii U emulator for PS4, based on Cemu",
+				"Ported to PS4 by ShiroKlein",
+				"GitHub: github.com/iHaiDeeZ",
+				"Version " + m_version,
+				"",
+				"Games: " + GamesFolder(),
+				"Wallpapers (PNG): " + m_dataDir + "/themes",
+				"Sounds (WAV): " + m_dataDir + "/themes/sounds",
+				"Box art (PNG): " + m_dataDir + "/covers/<ID>.png",
+				"",
+				"Cemu is free software (MPL 2.0).",
+				"Menus from Dolphin for PS4 (GPLv2+).",
+				"Fonts: Nunito, Noto Sans (SIL Open Font License)."};
+			break;
+		default:
+			if (setting >= SET_GROUP && setting < SET_GROUP + (int)CremaSettings::Categories().size())
+			{
+				OpenSettingsList(CremaSettings::Categories()[setting - SET_GROUP], {});
+				return;
+			}
+			m_panel.open = false;
+		}
+	}
+
+	// A settings list: one category of the global settings, or every setting of one game (with
+	// "Apply To" first: all games = the game follows the global settings, this game = its own).
+	void Menu::OpenSettingsList(const std::string& category, const std::string& gameId)
+	{
+		m_panel = {};
+		m_panel.open = true;
+		m_panel.category = category;
+		m_panel.gameId = gameId;
+		m_panel.title = category.empty() ? "Game Settings" : category;
+		BuildSettingRows();
+		m_panel.selected = 0;
+		MoveSettingRow(0);
+	}
+
+	void Menu::BuildSettingRows()
+	{
+		std::vector<SettingRow> rows;
+		const std::string& game = m_panel.gameId;
+		if (!game.empty())
+			rows.push_back({"Apply To", CremaSettings::IsCustom(game) ? "This Game" : "All Games", "", false, true});
+		for (const char* category : CremaSettings::Categories())
+		{
+			if (!m_panel.category.empty() && m_panel.category != category)
+				continue;
+			if (m_panel.category.empty())
+				rows.push_back({category, "", "", true});
+			for (const CremaSettings::Setting& setting : CremaSettings::All())
+			{
+				if (std::string(setting.category) != category)
+					continue;
+				// the menus' language and the online world are per console, not per game
+				if (!game.empty() && (std::string(setting.key) == "language" || std::string(setting.key) == "online" ||
+										 std::string(setting.key) == "net_library" || std::string(setting.key) == "recommended"))
+					continue;
+				rows.push_back({setting.label, CremaSettings::LabelOf(setting, CremaSettings::Get(setting.key, game)),
+					setting.key, false, false, !setting.live});
+				if (game.empty() && std::string(setting.key) == "online")
+					AddOnlineRows(rows);
+				if (game.empty() && std::string(setting.key) == "net_library")
+					AddNetworkRows(rows);
+			}
+		}
+		rows.push_back({"", "", "", true});
+		rows.push_back({game.empty() ? "Reset to Defaults" : "Reset This Game", "", "__reset__"});
+		m_panel.rows = std::move(rows);
+	}
+
+	// Settings > Online, under "Online": the private server's address, and what each world's
+	// folder has (CremaOnline.h; Cross looks again).
+	void Menu::AddOnlineRows(std::vector<SettingRow>& rows)
+	{
+		const std::string server = CremaSettings::Get("online_server");
+		SettingRow address{"Server Address", server.empty() ? "Not Set" : server, "__server__"};
+		address.help = "Your private server's proxy: address and port, for example 192.168.0.10:8888 (pretendo-docker). Cross: type it. Used with Online: Private Server.";
+		rows.push_back(address);
+		const std::pair<const char*, const char*> worlds[] = {{"pretendo", "Pretendo Files"}, {"private", "Private Server Files"}};
+		for (const auto& [world, label] : worlds)
+		{
+			const CremaOnline::Status status = CremaOnline::Check(m_dataDir, world);
+			const int missing = status.Missing();
+			SettingRow row{label, missing == 0 ? "Ready" : fmt::format("{} Missing", missing), std::string("__files__") + world};
+			auto item = [](bool found) { return found ? "found" : "missing"; };
+			row.help = fmt::format("{}: otp.bin {}, seeprom.bin {}, certificates {}, account {}. README.txt there lists the files. Cross: look again.",
+				CremaOnline::WorldFolder(m_dataDir, world), item(status.otp), item(status.seeprom), item(status.certs),
+				status.account.empty() ? std::string("missing") : status.account);
+			row.note = missing != 0;
+			rows.push_back(row);
+		}
+	}
+
+	// Settings > Online, under "Network Library": where the share is, who to sign in as (SMB), and
+	// a connection test. The share is read at /net/library (port/ps4_netfs.cpp).
+	void Menu::AddNetworkRows(std::vector<SettingRow>& rows)
+	{
+		const std::string type = CremaSettings::Get("net_library");
+		if (type != "smb" && type != "nfs")
+			return;
+		const std::string address = CremaSettings::Get("net_address");
+		SettingRow where{"Share Address", address.empty() ? "Not Set" : address, "__net_address__"};
+		where.help = type == "smb" ?
+			"The computer and its shared folder, for example 192.168.0.10/Games (a folder in it: 192.168.0.10/Games/WiiU). Cross: type it." :
+			"The computer and the exported folder, for example 192.168.0.10/c/Games (WinNFSd: the drive letter, then the folder). Cross: type it.";
+		where.note = address.empty();
+		rows.push_back(where);
+		if (type == "smb")
+		{
+			const std::string user = CremaSettings::Get("net_user");
+			SettingRow name{"User Name", user.empty() ? "Guest" : user, "__net_user__"};
+			name.help = "The computer's user name (a Microsoft account: its e-mail address). Empty: guest. Cross: type it.";
+			rows.push_back(name);
+			SettingRow password{"Password", CremaSettings::Get("net_password").empty() ? "Not Set" : "********", "__net_password__"};
+			password.help = "That user's password, kept in /data/Crema/crema.ini. Cross: type it.";
+			rows.push_back(password);
+		}
+		SettingRow check{"Connection", m_netCheck.joinable() ? "Connecting..." : m_netStatus.empty() ? "Test" : m_netStatus, "__net_check__"};
+		check.help = "Cross: connect and look at the folder. Then press Square on your games to list the share's games.";
+		rows.push_back(check);
+	}
+
+	void Menu::StartNetworkCheck()
+	{
+		if (m_netCheck.joinable())
+			return;
+		CremaSettings::MountNetworkLibrary();
+		m_netCheckDone = false;
+		m_netCheck = std::thread([this] {
+			char message[256] = {};
+			ps4_netfs_check("library", message, sizeof(message));
+			m_netStatusThread = message;
+			m_netCheckDone = true;
+		});
+		Log("network library: connecting");
+	}
+
+	// every frame: the test's answer, when it has one
+	void Menu::UpdateNetworkCheck()
+	{
+		if (!m_netCheck.joinable() || !m_netCheckDone)
+			return;
+		m_netCheck.join();
+		m_netStatus = m_netStatusThread;
+		Log("network library: " + m_netStatus);
+		if (m_panel.open && m_panel.category == "Online")
+		{
+			const int selected = m_panel.selected;
+			BuildSettingRows();
+			m_panel.selected = std::min(selected, (int)m_panel.rows.size() - 1);
+		}
+	}
