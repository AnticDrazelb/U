+	void Menu::ApplyPreferences()
+	{
+		m_audio.SetEnabled(m_prefs.sounds);
+		m_audio.SetVolume(m_prefs.volume);
+		if (m_wallpaper)
+			m_display.DestroyTexture(m_wallpaper);
+		m_wallpaper = nullptr;
+		if (!m_prefs.wallpaper.empty())
+			m_wallpaper = LoadPngTexture(m_dataDir + "/themes/" + m_prefs.wallpaper);
+		m_prefs.Save(m_dataDir + "/launcher.ini");
+	}
