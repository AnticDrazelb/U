+	std::string Trim(std::string text)
+	{
+		while (!text.empty() && (text.back() == '\r' || text.back() == ' ' || text.back() == '\t'))
+			text.pop_back();
+		size_t start = 0;
+		while (start < text.size() && (text[start] == ' ' || text[start] == '\t'))
+			start++;
+		return text.substr(start);
+	}
+
+	std::string Fallback(const std::string& key)
+	{
+		for (const Setting& setting : SETTINGS)
+		{
+			if (key == setting.key)
+				return setting.fallback;
+		}
+		return {};
+	}
+
+	std::string GetLocked(const std::string& key, const std::string& gameId)
+	{
+		if (!gameId.empty())
+		{
+			auto game = s_sections.find(gameId);
+			if (game != s_sections.end() && game->second.count("custom") && game->second.at("custom") == "on")
+			{
+				auto value = game->second.find(key);
+				if (value != game->second.end())
+					return value->second;
+			}
+			// the game's recommended settings (Recommended Settings on: global, else its default)
+			std::string id = gameId;
+			std::transform(id.begin(), id.end(), id.begin(), [](unsigned char c) { return (char)std::tolower(c); });
+			auto recommended = s_recommended.find(id);
+			if (recommended != s_recommended.end() && GetLocked("recommended", {}) != "off")
+			{
+				for (const auto& [name, value] : recommended->second.values)
+				{
+					if (name == key)
+						return value;
+				}
+			}
+		}
+		auto global = s_sections.find("global");
+		if (global != s_sections.end())
+		{
+			auto value = global->second.find(key);
+			if (value != global->second.end())
+				return value->second;
+		}
+		return Fallback(key);
+	}
+	// Settings a recommendation may hold: not the console's own choices (language, online, the
+	// network library) and not Diagnostics (the player turns those on to report a problem).
+	bool Recommendable(const Setting& setting)
+	{
+		const std::string key = setting.key, category = setting.category;
+		return category != "Diagnostics" && category != "Online" && key != "language" && key != "recommended";
+	}
+
+	// game-settings.ini: [crema] revision=, and [title ID] sections (16 hex digits, lower case) with
+	// name / status / fps / note and crema.ini keys. Unknown keys and values are skipped.
+	uint64_t ParseRecommended(const std::string& text, std::map<std::string, Recommendation>* games)
+	{
+		uint64_t revision = 0;
+		std::string section;
+		size_t start = 0;
+		while (start < text.size())
+		{
+			size_t end = text.find('\n', start);
+			if (end == std::string::npos)
+				end = text.size();
+			const std::string line = Trim(text.substr(start, end - start));
+			start = end + 1;
+			if (line.empty() || line[0] == '#' || line[0] == ';')
+				continue;
+			if (line.front() == '[' && line.back() == ']')
+			{
+				section = line.substr(1, line.size() - 2);
+				std::transform(section.begin(), section.end(), section.begin(), [](unsigned char c) { return (char)std::tolower(c); });
+				continue;
+			}
+			const size_t eq = line.find('=');
+			if (eq == std::string::npos)
+				continue;
+			const std::string key = Trim(line.substr(0, eq)), value = Trim(line.substr(eq + 1));
+			if (section == "crema")
+			{
+				if (key == "revision")
+					revision = std::strtoull(value.c_str(), nullptr, 10);
+				continue;
+			}
+			if (section.size() != 16 || section.find_first_not_of("0123456789abcdef") != std::string::npos)
+				continue;
+			Recommendation& game = (*games)[section];
+			if (key == "name")
+				game.name = value;
+			else if (key == "status")
+				game.status = value;
+			else if (key == "fps")
+				game.fps = value;
+			else if (key == "note")
+				game.note = value;
+			else if (const Setting* setting = Find(key); setting && Recommendable(*setting))
+			{
+				for (const Choice& choice : setting->choices)
+				{
+					if (value == choice.value)
+						game.values.emplace_back(key, value);
+				}
+			}
+		}
+		return revision;
+	}
+
+	std::string ReadAll(const std::string& path)
+	{
+		std::ifstream file(path, std::ios::binary);
+		return std::string((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+	}
+
+	// The packaged copy and the downloaded one: the higher revision wins.
+	void LoadRecommendedLocked(const std::string& dataDir)
+	{
+		s_recommendedPath = dataDir + "/game-settings.ini";
+		s_recommended.clear();
+		s_recommendedRevision = 0;
+		for (const std::string& path : {std::string("/app0/game-settings.ini"), s_recommendedPath})
+		{
+			std::map<std::string, Recommendation> games;
+			const uint64_t revision = ParseRecommended(ReadAll(path), &games);
+			if (!games.empty() && revision >= s_recommendedRevision)
+			{
+				s_recommended = std::move(games);
+				s_recommendedRevision = revision;
+			}
+		}
+	}
+} // namespace
