+#if defined(__ORBIS__)
+#include "Cafe/OS/RPL/rpl_symbol_storage.h"
+
+// Crema: the Profiler, Wii U side. What each game thread does, sampled about 500 times a second
+// (CremaThreadCensusSample, from the profiler) and reported every 30 s (CremaThreadCensusReport):
+// running on its core, ready but waiting for the core, or waiting on an OSMutex, an OSFastMutex or
+// a thread queue (events, semaphores, messages, sleeps, joins), with the calls it waits in most
+// (the function the bl before the saved LR goes to). The PS4 side (samples.log) shows only where
+// the host threads are; this shows why a game is slow when no host thread is busy.
+namespace coreinit
+{
+	enum CensusKind : uint32 { kRunning, kReady, kMutex, kFastMutex, kQueue, kSuspended, kOther, kKinds };
+	struct CensusThread
+	{
+		char name[48]{};
+		uint8 affinity = 0; // OSThread_t::ATTR_AFFINITY_CORE0..2 bits
+		uint32 samples = 0;
+		uint32 kinds[kKinds]{};
+		std::unordered_map<uint64, uint32> waitSites; // kind << 32 | LR
+	};
+	std::mutex s_censusMutex;
+	std::unordered_map<MPTR, CensusThread> s_census;
+	uint32 s_censusCoreSamples = 0, s_censusCoreIdle[Espresso::CORE_COUNT]{};
+
+	void CremaThreadCensusSample()
+	{
+		OSThread_t* current[Espresso::CORE_COUNT];
+		for (sint32 i = 0; i < Espresso::CORE_COUNT; i++)
+			current[i] = __currentCoreThread[i];
+		std::unique_lock _l(s_censusMutex);
+		// a core is idle when no thread runs on it (the pointer can still name a thread that blocked)
+		s_censusCoreSamples++;
+		for (sint32 i = 0; i < Espresso::CORE_COUNT; i++)
+		{
+			if (!current[i] || current[i]->state.value() != OSThread_t::THREAD_STATE::STATE_RUNNING)
+			{
+				s_censusCoreIdle[i]++;
+				current[i] = nullptr;
+			}
+		}
+		srwlock_activeThreadList.LockRead();
+		for (sint32 i = 0; i < activeThreadCount; i++)
+		{
+			const MPTR ptr = activeThread[i];
+			OSThread_t* t = MEMPTR<OSThread_t>(ptr).GetPtr();
+			if (!t)
+				continue;
+			const auto state = t->state.value();
+			if (state != OSThread_t::THREAD_STATE::STATE_RUNNING && state != OSThread_t::THREAD_STATE::STATE_WAITING &&
+				state != OSThread_t::THREAD_STATE::STATE_READY)
+				continue;
+			CensusThread& c = s_census[ptr];
+			if (c.name[0] == 0)
+			{
+				const char* name = t->threadName.GetPtr();
+				snprintf(c.name, sizeof(c.name), "%s", name ? name : "?");
+				if (c.name[0] == 0)
+					snprintf(c.name, sizeof(c.name), "thread %08x", ptr);
+			}
+			c.samples++;
+			c.affinity = t->attr & 7;
+			CensusKind kind;
+			if (t == current[0] || t == current[1] || t == current[2])
+				kind = kRunning;
+			else if (state != OSThread_t::THREAD_STATE::STATE_WAITING)
+				kind = t->suspendCounter.value() > 0 ? kSuspended : kReady; // READY: created, not resumed yet
+			else if (t->waitingForMutex)
+				kind = kMutex;
+			else if (t->waitingForFastMutex)
+				kind = kFastMutex;
+			else if (t->currentWaitQueue)
+				kind = kQueue;
+			else if (t->suspendCounter.value() > 0)
+				kind = kSuspended;
+			else
+				kind = kOther;
+			c.kinds[kind]++;
+			if (kind >= kMutex)
+				c.waitSites[(uint64)kind << 32 | _swapEndianU32(t->context.lr)]++;
+		}
+		srwlock_activeThreadList.UnlockRead();
+	}
+
+	// the call a return address comes back from: "name" of the bl target, else its address
+	static std::string CensusCallName(uint32 lr)
+	{
+		if (lr < 0x01000004 || !memory_isAddressRangeAccessible(lr - 4, 4))
+			return fmt::format("? (lr {:08x})", lr);
+		const uint32 instr = memory_readU32(lr - 4);
+		if ((instr >> 26) != 18 || (instr & 1) == 0)
+			return fmt::format("indirect call (lr {:08x})", lr);
+		sint32 offset = (sint32)(instr & 0x03FFFFFC);
+		if (offset & 0x02000000)
+			offset -= 0x04000000;
+		const uint32 target = (instr & 2) ? (uint32)offset : lr - 4 + offset;
+		RPLStoredSymbol* symbol = rplSymbolStorage_getByAddress(target);
+		if (symbol && symbol->symbolName)
+			return fmt::format("{} (lr {:08x})", (const char*)symbol->symbolName, lr);
+		return fmt::format("{:08x} (lr {:08x})", target, lr);
+	}
+
+	// one line per thread that ran or waited, busiest first, then the counters start over
+	std::vector<std::string> CremaThreadCensusReport()
+	{
+		static const char* kNames[kKinds] = {"run", "ready", "mutex", "fastmutex", "queue", "suspended", "other"};
+		std::unordered_map<MPTR, CensusThread> census;
+		uint32 coreSamples, coreIdle[Espresso::CORE_COUNT];
+		{
+			std::unique_lock _l(s_censusMutex);
+			census.swap(s_census);
+			coreSamples = std::max<uint32>(s_censusCoreSamples, 1);
+			for (sint32 i = 0; i < Espresso::CORE_COUNT; i++)
+			{
+				coreIdle[i] = s_censusCoreIdle[i];
+				s_censusCoreIdle[i] = 0;
+			}
+			s_censusCoreSamples = 0;
+		}
+		std::vector<const CensusThread*> threads;
+		for (auto& it : census)
+			threads.push_back(&it.second);
+		std::sort(threads.begin(), threads.end(), [](const CensusThread* a, const CensusThread* b) {
+			return a->kinds[kRunning] + a->kinds[kReady] > b->kinds[kRunning] + b->kinds[kReady];
+		});
+		std::vector<std::string> lines;
+		lines.push_back(fmt::format("wiiu cores idle: core0 {}%, core1 {}%, core2 {}%", coreIdle[0] * 100 / coreSamples,
+			coreIdle[1] * 100 / coreSamples, coreIdle[2] * 100 / coreSamples));
+		for (const CensusThread* c : threads)
+		{
+			if (lines.size() == 20)
+				break;
+			std::string line = fmt::format("wiiu thread {} [core {}{}{}]:", c->name, (c->affinity & 1) ? "0" : "",
+				(c->affinity & 2) ? "1" : "", (c->affinity & 4) ? "2" : "");
+			for (uint32 k = 0; k < kKinds; k++)
+			{
+				if (c->kinds[k] * 100 >= c->samples)
+					line += fmt::format(" {} {}%", kNames[k], c->kinds[k] * 100 / c->samples);
+			}
+			std::vector<std::pair<uint32, uint64>> sites;
+			for (auto& it : c->waitSites)
+				sites.emplace_back(it.second, it.first);
+			std::sort(sites.begin(), sites.end(), std::greater<>());
+			for (size_t i = 0; i < sites.size() && i < 3; i++)
+			{
+				if (sites[i].first * 100 < c->samples * 3)
+					break;
+				line += fmt::format(" | {} {}% in {}", kNames[sites[i].second >> 32], sites[i].first * 100 / c->samples,
+					CensusCallName((uint32)sites[i].second));
+			}
+			lines.push_back(std::move(line));
+		}
+#if defined(__ORBIS__)
+		{
+			// idle time measured in the idle loop (a core idle right now: its open stretch isn't in yet)
+			static uint64 s_lastReport = 0, s_lastIdle[3]{};
+			const uint64 now = __rdtsc();
+			if (s_lastReport)
+			{
+				const double elapsed = (double)(now - s_lastReport);
+				std::string line = "wiiu cores busy (measured):";
+				for (int c = 0; c < 3; c++)
+				{
+					const uint64 idle = s_cremaIdleTicks[c] - s_lastIdle[c];
+					line += fmt::format(" core{} {:.0f}%", c, std::max(0.0, 100.0 - 100.0 * (double)idle / elapsed));
+				}
+				lines.push_back(line);
+			}
+			s_lastReport = now;
+			for (int c = 0; c < 3; c++)
+				s_lastIdle[c] = s_cremaIdleTicks[c];
+			for (std::string& line : CremaHLEReport())
+				lines.push_back(std::move(line));
+		}
+#endif
+		return lines;
+	}
+}
+#endif
