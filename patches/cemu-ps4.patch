+	const fs::path kAppRoot = "/app0";
+	constexpr int kWidth = 1920, kHeight = 1080;
+
+	WindowSystem::WindowInfo sWindowInfo{};
+	std::atomic<uint64> sHeartbeat{0}; // the main loop's seconds
+	bool sPerfLog = false, sFreezeReports = false, sTvScreenshots = false; // Crema's Diagnostics (all off by default)
+
+	void Trace(std::string_view text)
+	{
+		std::string line(text);
+		ps4_boot_trace(line.c_str());
+		cemuLog_log(LogType::Force, "{}", text);
+	}
+
+	// Where the time goes, every 5 s: the GPU's busy share (GPU timestamps around each submission)
+	// and the busy share of each named thread above 10% (OSSched[core=N] = the emulated CPU cores,
+	// LatteThread = GPU command processing). A thread near 100% is what limits the frame rate.
+	void LogPerformance()
+	{
+		static uint64_t sPrevBusy = 0, sPrevSpan = 0;
+		uint64_t busy, span;
+		ac_ps4_get_gpu_busy(&busy, &span);
+		const uint64_t busyDelta = busy - sPrevBusy, spanDelta = span - sPrevSpan;
+		sPrevBusy = busy;
+		sPrevSpan = span;
+		char threads[640];
+		ps4_thread_busy_report(threads, sizeof(threads), 10);
+		Trace(fmt::format("perf: gpu {}% | {}", spanDelta ? busyDelta * 100 / spanDelta : 0, threads));
+	}
+
+	// Hang watchdog: when the main loop's heartbeat or the TV frames stop for 15 s, the stacks of
+	// all named threads (SetThreadName), with the lock each one waits on, go to hang.log (up to
+	// three dumps a minute apart). No Cemu log and no allocations here: a hang may hold their locks.
+	void StartHangWatchdog()
+	{
+		const std::string path = _pathToUtf8(kDataRoot / "hang.log");
+		std::error_code ec;
+		fs::remove(kDataRoot / "hang.log", ec);
+		std::thread([path] {
+			uint64 lastBeat = sHeartbeat.load(), lastFrame = LatteGPUState.frameCounter;
+			int beatStall = 0, frameStall = 0, dumps = 0, sinceDump = 60;
+			char reason[160], line[200];
+			for (uint64 seconds = 1;; seconds++)
+			{
+				std::this_thread::sleep_for(std::chrono::seconds(1));
+				const uint64 beat = sHeartbeat.load();
+				const uint64 frame = LatteGPUState.frameCounter;
+				beatStall = beat == lastBeat ? beatStall + 1 : 0;
+				frameStall = frame == lastFrame && frame != 0 ? frameStall + 1 : 0; // after the first frame
+				lastBeat = beat;
+				lastFrame = frame;
+				sinceDump++;
+				if (std::max(beatStall, frameStall) < 15)
+				{
+					sinceDump = 60; // a new hang dumps at once
+					continue;
+				}
+				if (dumps >= 3 || sinceDump < 60)
+					continue;
+				snprintf(reason, sizeof(reason), "hang at %llu s: no heartbeat for %d s, no TV frame for %d s (frame %llu)",
+					(unsigned long long)seconds, beatStall, frameStall, (unsigned long long)frame);
+				snprintf(line, sizeof(line), "%s, stacks in hang.log", reason);
+				ps4_boot_trace(line);
+				ps4_dump_thread_stacks(path.c_str(), reason);
+				dumps++;
+				sinceDump = 0;
+			}
+		}).detach();
+	}
+
+	void LoadSystemModules()
+	{
+		// calling into a system library whose module isn't loaded kills the app silently
+		const std::pair<const char*, uint32> modules[] = {
+			{"SystemService", 0x80000010}, {"UserService", 0x80000011}, {"VideoOut", 0x80000022},
+			{"AudioOut", 0x80000001}, {"Pad", 0x80000024}, {"Net", 0x8000001C}};
+		for (const auto& [name, id] : modules)
+		{
+			const int result = (int)sceSysmoduleLoadModuleInternal((OrbisSysModuleInternal)id);
+			if (result != 0)
+				ps4_boot_trace(fmt::format("loading system module {} failed ({:#x})", name, (uint32)result).c_str());
+		}
+	}
+
+	bool CreateDefaultMLCFiles(const fs::path& mlc)
+	{
+		std::error_code ec;
+		const fs::path directories[] = {
+			mlc, mlc / "sys", mlc / "usr", mlc / "usr/title/00050000", mlc / "usr/title/0005000c",
+			mlc / "usr/title/0005000e", mlc / "usr/save/00050010/1004a000/user/common/db",
+			mlc / "usr/save/00050010/1004a100/user/common/db", mlc / "usr/save/00050010/1004a200/user/common/db",
+			mlc / "sys/title/0005001b/1005c000/content"};
+		for (auto& path : directories)
+		{
+			fs::create_directories(path, ec);
+			if (!fs::is_directory(path, ec))
+				return false;
+		}
+		const fs::path langDir = mlc / "sys/title/0005001b/1005c000/content";
+		if (!fs::exists(langDir / "language.txt", ec))
+		{
+			std::ofstream file(langDir / "language.txt");
+			for (const char* lang : {"ja", "en", "fr", "de", "it", "es", "zh", "ko", "nl", "pt", "ru", "zh"})
+				file << fmt::format(R"("{}",)", lang) << "\n";
+		}
+		if (!fs::exists(langDir / "country.txt", ec))
+		{
+			std::ofstream file(langDir / "country.txt");
+			for (size_t i = 0; i < NCrypto::GetCountryCount(); i++)
+			{
+				const char* code = NCrypto::GetCountryAsString((sint32)i);
+				file << (boost::iequals(code, "NN") ? std::string("NULL,") : fmt::format(R"("{}",)", code)) << "\n";
+			}
+		}
+		return true;
+	}
+
+	// The Wii U's Mii parts (FFLRes*.dat in system title 0005001B10056000): games link the Mii
+	// library statically, and without its resource NSMBU crashes and Nintendo Land's Miis have no
+	// heads. Where they're missing, Crema writes its own (CremaMii.cpp), and replaces older ones it
+	// wrote (the blank placeholder of v01.20/21, an older version of its parts); with the setting
+	// off it removes them. A dump of the Wii U's is never touched.
+	void SetupMiiResources(const fs::path& mlc, bool cremaMiis)
+	{
+		const fs::path dir = mlc / "sys/title/0005001b/10056000/content";
+		std::vector<uint8> parts; // built on first use
+		std::error_code ec;
+		for (const char* name : {"FFLResHigh.dat", "FFLResMiddle.dat", "FFLResHighLG.dat", "FFLResMiddleLG.dat"})
+		{
+			const fs::path path = dir / name;
+			std::vector<uint8> current;
+			const bool exists = fs::exists(path, ec);
+			if (exists)
+			{
+				std::ifstream file(path, std::ios::binary);
+				current.assign(std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>());
+			}
+			const bool ours = exists && CremaMii::IsCremaFile(current);
+			if (cremaMiis && (!exists || (ours && !CremaMii::IsCurrent(current))))
+			{
+				if (parts.empty())
+					parts = CremaMii::BuildPartsResource();
+				fs::create_directories(dir, ec);
+				std::ofstream file(path, std::ios::binary);
+				file.write((const char*)parts.data(), (std::streamsize)parts.size());
+				Trace(fmt::format("Mii parts: wrote Crema's {} ({} bytes)", name, parts.size()));
+			}
+			else if (!cremaMiis && ours && fs::remove(path, ec))
+				Trace(fmt::format("Mii parts: removed Crema's {}", name));
+		}
+	}
+
+	bool WritePNG(const fs::path& path, const std::vector<uint8>& rgb, int width, int height)
+	{
+		if (rgb.size() < (size_t)width * height * 3)
+			return false;
+		FILE* file = fopen(_pathToUtf8(path).c_str(), "wb");
+		if (!file)
+			return false;
+		png_structp png = png_create_write_struct(PNG_LIBPNG_VER_STRING, nullptr, nullptr, nullptr);
+		png_infop info = png ? png_create_info_struct(png) : nullptr;
+		bool ok = false;
+		if (png && info && setjmp(png_jmpbuf(png)) == 0)
+		{
+			png_init_io(png, file);
+			png_set_IHDR(png, info, width, height, 8, PNG_COLOR_TYPE_RGB, PNG_INTERLACE_NONE, PNG_COMPRESSION_TYPE_DEFAULT, PNG_FILTER_TYPE_DEFAULT);
+			png_set_compression_level(png, 3);
+			png_write_info(png, info);
+			for (int y = 0; y < height; y++)
+				png_write_row(png, rgb.data() + (size_t)y * width * 3);
+			png_write_end(png, nullptr);
+			ok = true;
+		}
+		png_destroy_write_struct(&png, &info);
+		fclose(file);
+		return ok;
+	}
+
+	bool IsLaunchable(const fs::path& path)
+	{
+		std::string ext = _pathToUtf8(path.extension());
+		boost::algorithm::to_lower(ext);
+		return ext == ".rpx" || ext == ".elf" || ext == ".wua" || ext == ".wuhb" || ext == ".wud" || ext == ".wux" || ext == ".iso";
+	}
+
+	// L1 held while the app starts: the menu instead of the default game.
+	bool MenuButtonHeld()
+	{
+		OrbisPadData data{};
+		return g_crema_pad_handle >= 0 && scePadReadState(g_crema_pad_handle, &data) == 0 && data.connected &&
+			(data.buttons & ORBIS_PAD_BUTTON_L1);
+	}
+
+	std::string AppVersion()
+	{
+		std::ifstream file(kAppRoot / "version.txt");
+		std::string version;
+		std::getline(file, version);
+		boost::algorithm::trim(version);
+		return version;
+	}
+
+	fs::path FindFirstGame()
+	{
+		std::error_code ec;
+		std::vector<fs::path> found;
+		for (auto it = fs::recursive_directory_iterator(kDataRoot / "games", ec); !ec && it != fs::recursive_directory_iterator(); it.increment(ec))
+		{
+			if (it->is_regular_file(ec) && (IsLaunchable(it->path()) || it->path().filename() == "title.tmd"))
+				found.push_back(it->path());
+		}
+		std::sort(found.begin(), found.end());
+		return found.empty() ? fs::path() : found.front();
+	}
+
+	// Cemu's frontend callbacks: when the game ends its process (it quit, or gave up with an error),
+	// the app restarts into the launcher, as the Wii U returns to its menu.
+	class PS4SystemImplementation : public CafeSystem::SystemImplementation
+	{
+	public:
+		void CafeRecreateCanvas() override {}
+		void CafePPCProcessExit() override
+		{
+			Trace(fmt::format("the game ended (exit status {}): back to the launcher", CafeSystem::GetForegroundTitleReturnStatus().value_or(-1)));
+			std::error_code ec;
+			fs::remove(kDataRoot / "launch.txt", ec);
+			sceSystemServiceLoadExec("/app0/eboot.bin", nullptr);
+		}
+	} sSystemImplementation;
+
+	// What to boot: launch.txt (written by the launcher or by hand) starts that game once; else
+	// the default game (unless L1 is held); else the launcher, which writes launch.txt and
+	// restarts the app (the menu and the emulator never share a process).
+	fs::path PickGame()
+	{
+		const fs::path launchFile = kDataRoot / "launch.txt";
+		std::error_code ec;
+		if (fs::exists(launchFile, ec))
+		{
+			std::string line;
+			{
+				std::ifstream launch(launchFile);
+				std::getline(launch, line);
+			}
+			fs::remove(launchFile, ec);
+			boost::algorithm::trim(line);
+			if (!line.empty())
+				return _utf8ToPath(line);
+		}
+		const std::string defaultGame = CremaLauncher::DefaultGame(_pathToUtf8(kDataRoot));
+		if (!defaultGame.empty() && fs::exists(_utf8ToPath(defaultGame), ec))
+		{
+			if (!MenuButtonHeld())
+			{
+				Trace("default game: " + defaultGame);
+				return _utf8ToPath(defaultGame);
+			}
+			Trace("default game skipped (L1 held): the launcher");
+		}
+		const std::string picked = CremaLauncher::Run(_pathToUtf8(kDataRoot), _pathToUtf8(kAppRoot), AppVersion());
+		if (picked.empty())
+		{
+			Trace("launcher unavailable: starting the first game");
+			return FindFirstGame();
+		}
+		{
+			std::ofstream launch(launchFile, std::ios::trunc);
+			launch << picked << "\n";
+		}
+		Trace("launcher: restarting into " + picked);
+		const int result = sceSystemServiceLoadExec("/app0/eboot.bin", nullptr);
+		// still here: the restart failed, so the game starts in this process
+		Trace(fmt::format("launcher: restart failed ({:#x}), starting the game here", (uint32)result));
+		fs::remove(launchFile, ec);
+		return _utf8ToPath(picked);
+	}
+
+	// MainWindow::FileLoad without the dialogs
+	bool PrepareTitle(const fs::path& launchPath)
+	{
+		TitleInfo launchTitle{launchPath};
+		if (launchTitle.IsValid())
+		{
+			CafeTitleList::AddTitleFromPath(launchPath);
+			TitleId baseTitleId;
+			if (!CafeTitleList::FindBaseTitleId(launchTitle.GetAppTitleId(), baseTitleId))
+			{
+				Trace("the base files of this title were not found");
+				return false;
+			}
+			const auto r = CafeSystem::PrepareForegroundTitle(baseTitleId);
+			if (r != CafeSystem::PREPARE_STATUS_CODE::SUCCESS)
+			{
+				Trace(fmt::format("preparing the title failed ({})", (int)r));
+				return false;
+			}
+			return true;
+		}
+		const CafeTitleFileType fileType = DetermineCafeSystemFileType(launchPath);
+		if (fileType == CafeTitleFileType::RPX || fileType == CafeTitleFileType::ELF)
+		{
+			if (CafeSystem::PrepareForegroundTitleFromStandaloneRPX(launchPath) != CafeSystem::PREPARE_STATUS_CODE::SUCCESS)
+			{
+				Trace("preparing the executable failed");
+				return false;
+			}
+			return true;
+		}
+		Trace(fmt::format("not a launchable title (reason {})", (int)launchTitle.GetInvalidReason()));
+		return false;
+	}
+
+	void Run()
+	{
+		LoadSystemModules();
+		Trace("CemuPS4 starting");
+
+		std::error_code ec;
+		fs::create_directories(kDataRoot / "games", ec);
+		std::set<fs::path> failedWriteAccess;
+		ActiveSettings::SetPaths(false, kAppRoot / "eboot.bin", kDataRoot, kDataRoot, kDataRoot / "cache", kAppRoot, failedWriteAccess);
+		for (auto& path : failedWriteAccess)
+			Trace(fmt::format("cannot write to {}", _pathToUtf8(path)));
+		fs::create_directories(ActiveSettings::GetConfigPath("controllerProfiles"), ec);
+
+		GetConfigHandle().SetFilename(ActiveSettings::GetConfigPath("settings.xml").generic_wstring());
+		const bool firstStart = !fs::exists(ActiveSettings::GetConfigPath("settings.xml"), ec);
+		NetworkConfig::LoadOnce();
+		if (!firstStart)
+			GetConfigHandle().Load();
+		else
+		{
+			GetConfig().graphic_api = GraphicAPI::kVulkan;
+			GetConfigHandle().Save();
+		}
+		if (!CreateDefaultMLCFiles(ActiveSettings::GetMlcPath()))
+			Trace(fmt::format("cannot create the mlc folders in {}", _pathToUtf8(ActiveSettings::GetMlcPath())));
+		ActiveSettings::Init();
+		LatteOverlay_init();
+		Trace("common init");
+		CemuCommonInit();
+
+		// first start: the DualShock 4 becomes the Wii U GamePad (controllerProfiles/controller0.xml)
+		auto& inputManager = InputManager::instance();
+		if (!inputManager.get_controller(0))
+		{
+			try
+			{
+				auto pad = ControllerFactory::CreateController(InputAPI::PS4Pad, "0", "DualShock 4");
+				auto gamepad = inputManager.set_controller(0, EmulatedController::Type::VPAD, pad);
+				if (gamepad)
+				{
+					gamepad->set_default_mapping(pad);
+					inputManager.save(0);
+					Trace("DualShock 4 mapped to the Wii U GamePad");
+				}
+			}
+			catch (const std::exception& ex)
+			{
+				Trace(fmt::format("controller setup failed: {}", ex.what()));
+			}
+		}
+		CremaSettings::Load(_pathToUtf8(kDataRoot));
+
+		sWindowInfo.app_active = true;
+		sWindowInfo.width = sWindowInfo.phys_width = kWidth;
+		sWindowInfo.height = sWindowInfo.phys_height = kHeight;
+		sWindowInfo.dpi_scale = 1.0;
+		sWindowInfo.pad_open = false;
+		sWindowInfo.is_fullscreen = true;
+
+		if (!InitializeGlobalVulkan())
+		{
+			Trace("Vulkan (RADV) is not available");
+			return;
+		}
+
+		const fs::path game = PickGame();
+		if (game.empty())
+		{
+			Trace(fmt::format("no game: put one in {} or its path in {}", _pathToUtf8(kDataRoot / "games"), _pathToUtf8(kDataRoot / "launch.txt")));
+			return;
+		}
+		Trace(fmt::format("game: {}", _pathToUtf8(game)));
+		if (!PrepareTitle(game))
+			return;
+		Trace(fmt::format("title prepared: {}", CafeSystem::GetForegroundTitleName()));
+		// Crema's settings for this title (crema.ini) over Cemu's config and the game's profile
+		const uint64 titleId = CafeSystem::GetForegroundTitleId();
+		const std::string gameId = titleId ? fmt::format("{:016x}", titleId) : std::string();
+		CremaSettings::Apply(gameId);
+		SetupMiiResources(ActiveSettings::GetMlcPath(), CremaSettings::Get("mii_data", gameId) != "off");
+		PS4PauseMenu::LoadGameControls(gameId);
+		PS4PauseMenu::Install(gameId, _pathToUtf8(game));
+		sPerfLog = CremaSettings::On("perf_log", gameId);
+		sFreezeReports = CremaSettings::On("freeze_reports", gameId);
+		sTvScreenshots = CremaSettings::On("tv_screenshots", gameId);
+		// RADV's per-draw trace markers and the PS4 winsys's flight recorder (port/mesa/ac_ps4_drm.c:
+		// /data/DolphinPS4/flight), read when the device is created (after this)
+		if (CremaSettings::On("gpu_trace", gameId))
+		{
+			setenv("RADV_PS4_TRACE", "1", 1);
+			Trace("GPU fault recorder on");
+		}
+		if (auto gamepad = inputManager.get_controller(0))
+		{
+			const bool motion = CremaSettings::On("motion", gameId);
+			for (const auto& controller : gamepad->get_controllers())
+			{
+				if (controller->api() == InputAPI::PS4Pad && controller->has_motion())
+					controller->set_use_motion(motion);
+			}
+		}
+
+		try
+		{
+			g_renderer = std::make_unique<VulkanRenderer>();
+			VulkanRenderer::GetInstance()->InitializeSurface({kWidth, kHeight}, true);
+		}
+		catch (const std::exception& ex)
+		{
+			Trace(fmt::format("Vulkan renderer: {}", ex.what()));
+			return;
+		}
+		Trace("renderer ready, launching");
+		CafeSystem::SetImplementation(&sSystemImplementation);
+		CafeSystem::LaunchForegroundTitle();
+		Trace("launched");
+
+		// The emulator runs on its own threads; the main thread reports progress and, per Crema's
+		// Diagnostics settings, the load (perf log), freezes (hang.log) and TV screenshots (5, 15
+		// and 30 s after launch, then tv-latest.png every minute; each costs a short stutter).
+		fs::create_directories(kDataRoot / "screenshots", ec);
+		if (sFreezeReports)
+			StartHangWatchdog();
+		for (uint64 seconds = 1;; seconds++)
+		{
+			std::this_thread::sleep_for(std::chrono::seconds(1));
+			sHeartbeat.store(seconds);
+			if (seconds % 5 == 0 && sPerfLog)
+				LogPerformance();
+			if (seconds % 10 == 0)
+				Trace(fmt::format("alive {} s", seconds));
+			if (sTvScreenshots && (seconds == 5 || seconds == 15 || seconds == 30 || seconds % 60 == 0))
+			{
+				const std::string name = seconds % 60 == 0 ? "tv-latest.png" : fmt::format("tv-{:03}s.png", seconds);
+				g_renderer->RequestScreenshot([name](const std::vector<uint8>& rgb, int width, int height, bool mainWindow) -> std::optional<std::string> {
+					if (!mainWindow)
+						return std::nullopt;
+					const fs::path path = kDataRoot / "screenshots" / name;
+					Trace(fmt::format("screenshot {} ({}x{}): {}", name, width, height, WritePNG(path, rgb, width, height) ? "saved" : "failed"));
+					return std::nullopt;
+				});
+			}
+		}
+	}
+}
+
+void WindowSystem::Create()
+{
+	SetThreadName("cemu");
+	Run();
+	// nothing more to do (an error was logged): keep the process so the logs can be read
+	for (;;)
+		std::this_thread::sleep_for(std::chrono::seconds(60));
+}
