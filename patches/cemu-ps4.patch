+}
+
+const Setting* Find(const std::string& key)
+{
+	for (const Setting& setting : SETTINGS)
+	{
+		if (key == setting.key)
+			return &setting;
+	}
+	return nullptr;
+}
+
+void Load(const std::string& dataDir)
+{
+	std::lock_guard lock(s_mutex);
+	s_path = dataDir + "/crema.ini";
+	s_sections.clear();
+	std::ifstream file(s_path);
+	std::string line, section = "global";
+	while (std::getline(file, line))
+	{
+		line = Trim(line);
+		if (line.empty() || line[0] == '#' || line[0] == ';')
+			continue;
+		if (line.front() == '[' && line.back() == ']')
+		{
+			section = line.substr(1, line.size() - 2);
+			continue;
+		}
+		const size_t eq = line.find('=');
+		if (eq != std::string::npos)
+			s_sections[section][Trim(line.substr(0, eq))] = Trim(line.substr(eq + 1));
+	}
+	LoadRecommendedLocked(dataDir);
+}
+
+void Save()
+{
+	std::lock_guard lock(s_mutex);
+	if (s_path.empty())
+		return;
+	// Written next to the old file and renamed over it: a power cut leaves one or the other.
+	const std::string temp = s_path + ".new";
+	{
+		std::ofstream file(temp, std::ios::trunc);
+		file << "# Crema settings, written by the launcher and the pause menu.\n"
+				"# [global] applies to every game; a [title ID] section with custom=on overrides it.\n";
+		auto write = [&](const std::string& name, const std::map<std::string, std::string>& values) {
+			file << "\n[" << name << "]\n";
+			for (const auto& [key, value] : values)
+				file << key << "=" << value << "\n";
+		};
+		if (s_sections.count("global"))
+			write("global", s_sections["global"]);
+		for (const auto& [name, values] : s_sections)
+		{
+			if (name != "global")
+				write(name, values);
+		}
+	}
+	std::rename(temp.c_str(), s_path.c_str());
+}
+
+std::string Get(const std::string& key, const std::string& gameId)
+{
+	std::lock_guard lock(s_mutex);
+	return GetLocked(key, gameId);
+}
+
+bool On(const std::string& key, const std::string& gameId)
+{
+	return Get(key, gameId) == "on";
+}
+
+void Set(const std::string& key, const std::string& value, const std::string& gameId)
+{
+	{
+		std::lock_guard lock(s_mutex);
+		s_sections[gameId.empty() ? "global" : gameId][key] = value;
+	}
+	Save();
+}
+
+std::vector<std::pair<std::string, std::string>> GlobalValues()
+{
+	std::lock_guard lock(s_mutex);
+	std::vector<std::pair<std::string, std::string>> values;
+	auto global = s_sections.find("global");
+	if (global != s_sections.end())
+		values.assign(global->second.begin(), global->second.end());
+	return values;
+}
+
+bool IsCustom(const std::string& gameId)
+{
+	std::lock_guard lock(s_mutex);
+	auto game = s_sections.find(gameId);
+	return game != s_sections.end() && game->second.count("custom") && game->second.at("custom") == "on";
+}
+
+void SetCustom(const std::string& gameId, bool custom)
+{
+	if (gameId.empty())
+		return;
+	{
+		std::lock_guard lock(s_mutex);
+		auto& section = s_sections[gameId];
+		if (custom && section.size() <= 1)
+		{
+			// First time: start from what the game uses now (its recommended settings included).
+			for (const Setting& setting : SETTINGS)
+				section[setting.key] = GetLocked(setting.key, gameId);
+		}
+		section["custom"] = custom ? "on" : "off";
+	}
+	Save();
+}
+
+void ResetGlobal(const std::string& key)
+{
+	{
+		std::lock_guard lock(s_mutex);
+		auto global = s_sections.find("global");
+		if (global != s_sections.end())
+			global->second.erase(key);
+	}
+	Save();
+}
+
+void ResetGame(const std::string& gameId)
+{
+	{
+		std::lock_guard lock(s_mutex);
+		s_sections.erase(gameId);
+	}
+	Save();
+}
+
+void ResetAll()
+{
+	{
+		std::lock_guard lock(s_mutex);
+		s_sections.clear();
+	}
+	Save();
+}
+
+bool GetRecommendation(const std::string& gameId, Recommendation* recommendation)
+{
+	std::string id = gameId;
+	std::transform(id.begin(), id.end(), id.begin(), [](unsigned char c) { return (char)std::tolower(c); });
+	std::lock_guard lock(s_mutex);
+	auto it = s_recommended.find(id);
+	if (it == s_recommended.end())
+		return false;
+	*recommendation = it->second;
+	return true;
+}
+
+uint64_t RecommendedRevision()
+{
+	std::lock_guard lock(s_mutex);
+	return s_recommendedRevision;
+}
+
+const char* RecommendedUrl()
+{
+	return "https://raw.githubusercontent.com/iHaiDeeZ/Crema/main/game-settings.ini";
+}
+
+bool InstallRecommended(const std::string& text, std::string* message)
+{
+	std::map<std::string, Recommendation> games;
+	const uint64_t revision = ParseRecommended(text, &games);
+	std::lock_guard lock(s_mutex);
+	if (games.empty() || revision == 0)
+	{
+		*message = "not a game-settings.ini (no games or no revision)";
+		return false;
+	}
+	if (revision <= s_recommendedRevision)
+	{
+		*message = "revision " + std::to_string(revision) + ", already in use";
+		return true;
+	}
+	if (s_recommendedPath.empty())
+	{
+		*message = "settings not loaded";
+		return false;
+	}
+	const std::string temp = s_recommendedPath + ".new";
+	{
+		std::ofstream file(temp, std::ios::binary | std::ios::trunc);
+		file << text;
+		if (!file)
+		{
+			*message = "can't write " + temp;
+			return false;
+		}
+	}
+	std::rename(temp.c_str(), s_recommendedPath.c_str());
+	*message = "revision " + std::to_string(revision) + " (was " + std::to_string(s_recommendedRevision) + "), " +
+		std::to_string(games.size()) + " games";
+	s_recommended = std::move(games);
+	s_recommendedRevision = revision;
+	return true;
+}
+
+std::string LabelOf(const Setting& setting, const std::string& value)
+{
+	for (const Choice& choice : setting.choices)
+	{
+		if (value == choice.value)
+			return choice.label;
+	}
+	return value;
+}
+
+std::string Step(const Setting& setting, const std::string& value, int direction)
+{
+	const int count = (int)setting.choices.size();
+	int index = 0;
+	for (int i = 0; i < count; i++)
+	{
+		if (value == setting.choices[i].value)
+			index = i;
+	}
+	index = (index + direction % count + count) % count;
+	return setting.choices[index].value;
+}
+
+extern "C" void ps4_netfs_mount(const char* name, const char* url, const char* user, const char* password);
+
+void MountNetworkLibrary()
+{
+	const std::string type = Get("net_library");
+	// "\\PC\Games", "smb://PC/Games" and "PC/Games": the same
+	std::string address = Get("net_address");
+	std::replace(address.begin(), address.end(), '\\', '/');
+	for (const char* scheme : {"smb://", "nfs://"})
+		if (address.rfind(scheme, 0) == 0)
+			address.erase(0, strlen(scheme));
+	while (!address.empty() && address.front() == '/')
+		address.erase(0, 1);
+	while (!address.empty() && address.back() == '/')
+		address.pop_back();
+	const bool on = (type == "smb" || type == "nfs") && !address.empty();
+	const std::string url = on ? type + "://" + address : "";
+	ps4_netfs_mount("library", url.c_str(), Get("net_user").c_str(), Get("net_password").c_str());
+}
+
+std::string NetworkLibraryFolder()
+{
+	const std::string type = Get("net_library");
+	return (type == "smb" || type == "nfs") && !Get("net_address").empty() ? "/net/library" : "";
+}
+
+void Apply(const std::string& gameId)
+{
+	auto get = [&](const char* key) { return Get(key, gameId); };
+	auto& config = GetConfig();
+
+	if (g_current_game_profile)
+	{
+		const std::string cpu = get("cpu_mode");
+		const std::string quantum = get("thread_quantum");
+		g_current_game_profile->SetCremaOverrides(
+			cpu == "single" ? std::optional<CPUMode>(CPUMode::SinglecoreRecompiler) :
+			cpu == "multi" ? std::optional<CPUMode>(CPUMode::MulticoreRecompiler) : std::optional<CPUMode>(),
+			quantum == "default" ? std::optional<uint32>() : std::optional<uint32>((uint32)std::stoul(quantum)),
+			get("tv_shows") == "gamepad");
+	}
+	config.async_compile = get("shader_compile") != "sync";
+	config.vsync = get("vsync") == "on" ? 1 : 0; // Cemu's VSync: FIFO, else Immediate (SwapchainInfoVk.h)
+	// Cemu's "Full sync at GX2DrawDone" and "Accurate barriers"
+	const bool accurate = get("gpu_accuracy") != "fast";
+	config.gx2drawdone_sync = accurate;
+	config.vk_accurate_barriers = accurate;
+	g_crema_cl_shifts = get("cl_shifts") == "on";
+	g_crema_fast_compares = get("compare_results") != "exact";
+	coreinit::g_crema_thread_fairness = get("thread_fairness") != "off";
+	coreinit::g_crema_core_balancing = get("core_balancing") == "on";
+	g_crema_native_rects = get("rect_draws") != "cemu";
+	g_crema_native_quads = get("quad_draws") == "native";
+	// the GPU driver's own debug switches (read when the Vulkan instance and shader compiler start,
+	// after this); its pipeline cache is off with them, or cached shaders would come back
+	{
+		const std::string checks = get("driver_debug");
+		std::string radv, aco;
+		if (checks == "compression" || checks == "all")
+			radv += "nohiz,nofastclears,nodcc,";
+		if (checks == "memory" || checks == "all")
+			radv += "zerovram,";
+		if (checks == "shaders" || checks == "all")
+			aco = "noopt,nosched";
+		if (checks != "off" && !checks.empty())
+			radv += "nocache";
+		if (radv.empty())
+			unsetenv("RADV_DEBUG");
+		else
+			setenv("RADV_DEBUG", radv.c_str(), 1);
+		if (aco.empty())
+			unsetenv("ACO_DEBUG");
+		else
+			setenv("ACO_DEBUG", aco.c_str(), 1);
+	}
+	// the online service of the account in use (Cemu: per account): Pretendo (its servers, or a
+	// private one through the proxy: PS4WindowSystem.cpp), or none. One world for every game.
+	config.SetAccountSelectedService(ActiveSettings::GetPersistentId(), Get("online") != "off" ? NetworkService::Pretendo : NetworkService::Offline);
+	const std::string upscale = get("upscale_filter");
+	config.upscale_filter = upscale == "linear" ? kLinearFilter : upscale == "hermite" ? kBicubicHermiteFilter :
+		upscale == "nearest" ? kNearestNeighborFilter : kBicubicFilter;
+	config.fullscreen_scaling = get("scaling") == "stretch" ? kStretch : kKeepAspectRatio;
+	config.overlay.position = get("show_fps") == "on" ? ScreenPosition::kTopLeft : ScreenPosition::kDisabled;
+	config.overlay.fps = true;
+
+	static const std::map<std::string, CafeConsoleLanguage> LANGUAGES = {
+		{"ja", CafeConsoleLanguage::JA}, {"en", CafeConsoleLanguage::EN}, {"fr", CafeConsoleLanguage::FR},
+		{"de", CafeConsoleLanguage::DE}, {"it", CafeConsoleLanguage::IT}, {"es", CafeConsoleLanguage::ES},
+		{"zh", CafeConsoleLanguage::ZH}, {"ko", CafeConsoleLanguage::KO}, {"nl", CafeConsoleLanguage::NL},
+		{"pt", CafeConsoleLanguage::PT}, {"ru", CafeConsoleLanguage::RU}};
+	const auto language = LANGUAGES.find(get("language"));
+	config.console_language = language != LANGUAGES.end() ? language->second : CafeConsoleLanguage::EN;
+
+	// Sound through the PS4's AudioOut (audio/PS4AudioAPI.cpp): the TV, and the GamePad's speaker
+	// as a second port the PS4 mixes in.
+	const sint32 volume = std::clamp(std::atoi(get("game_volume").c_str()), 0, 100);
+	config.audio_api = IAudioAPI::PS4AudioOut;
+	config.tv_device = L"default";
+	config.tv_channels = kStereo;
+	config.tv_volume = volume;
+	config.pad_device = get("gamepad_audio") == "on" ? L"default" : L"";
+	config.pad_channels = kStereo;
+	config.pad_volume = volume;
+	config.audio_delay = std::clamp(std::atoi(get("audio_buffer").c_str()), 1, 8);
+
+	// File access (bit 0), the game's own messages (bit 17)
+	const uint64 logFlags = get("file_log") == "on" ? (1ull << 0) | (1ull << 17) : 0;
+	config.log_flag = logFlags;
+	cemuLog_setActiveLoggingFlags(logFlags);
+
+	g_crema_touchpad_buttons = get("touchpad") == "buttons" ? 1 : 0;
+	g_crema_touch_pointer = get("touch_pointer") == "on" ? 1 : 0;
+	Recommendation recommendation;
+	const bool recommended = !gameId.empty() && !IsCustom(gameId) && Get("recommended") != "off" &&
+		GetRecommendation(gameId, &recommendation) && !recommendation.values.empty();
+	cemuLog_log(LogType::Force, "Crema settings for {}: cpu {}, quantum {}, shaders {}, graphics {}, rects {}, quads {}, driver checks {}, TV shows {}, touchpad {}, motion {}{}",
+		gameId.empty() ? "(no title)" : gameId, get("cpu_mode"), get("thread_quantum"), get("shader_compile"),
+		get("gpu_accuracy"), get("rect_draws"), get("quad_draws"), get("driver_debug"), get("tv_shows"), get("touchpad"), get("motion"),
+		recommended ? fmt::format(" (recommended settings, revision {})", RecommendedRevision()) : std::string());
+}
+} // namespace CremaSettings
diff --git a/src/gui/ps4/launcher/CremaSettings.h b/src/gui/ps4/launcher/CremaSettings.h
new file mode 100644
index 0000000..8556ac7
--- /dev/null
+++ b/src/gui/ps4/launcher/CremaSettings.h
@@ -0,0 +1,93 @@
+// Crema settings (from DolphinPS4's PS4Settings), shared by the launcher and the game process.
+// The user's choices are kept in /data/Crema/crema.ini: a [global] section and one section per
+// title ID (16 hex digits) for games set to their own settings ("custom=on"). A setting never
+// changed uses its default below.
+//
+// When a game starts (PS4WindowSystem.cpp), the effective values are applied in memory to Cemu's
+// config and the game's profile (Apply), so crema.ini always wins over settings.xml.
+//
+// Recommended settings: game-settings.ini (the repository's, carried in the package as
+// /app0/game-settings.ini, and the newest copy from GitHub in data_dir/game-settings.ini - the one
+// with the higher revision is used) holds the settings found best for each tested game. With
+// Recommended Settings on, a game that isn't set to its own settings uses them over the global
+// values: the default < global < the game's recommended < the game's own (custom) settings.
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace CremaSettings
+{
+struct Choice
+{
+	const char* value; // stored in crema.ini
+	const char* label; // shown in the menus
+};
+
+struct Setting
+{
+	const char* key;
+	const char* label;
+	const char* category;
+	std::vector<Choice> choices;
+	const char* fallback; // the default
+	bool live;            // takes effect while a game runs (else: next game start)
+	const char* help;
+};
+
+const std::vector<Setting>& All();
+const std::vector<const char*>& Categories();
+const Setting* Find(const std::string& key);
+
+void Load(const std::string& data_dir);
+void Save();
+
+// Effective value: the game's own (custom games), else global, else the default.
+std::string Get(const std::string& key, const std::string& game_id = {});
+bool On(const std::string& key, const std::string& game_id = {});
+// Stores a value globally (game_id empty) or for a custom game.
+void Set(const std::string& key, const std::string& value, const std::string& game_id = {});
+// The user's global choices (only what was changed).
+std::vector<std::pair<std::string, std::string>> GlobalValues();
+bool IsCustom(const std::string& game_id);
+// Custom on: the game starts with a copy of the effective global values.
+void SetCustom(const std::string& game_id, bool custom);
+
+void ResetGlobal(const std::string& key);
+void ResetGame(const std::string& game_id);
+void ResetAll();
+
+// Label of a value for display, and the next / previous choice (wrapping).
+std::string LabelOf(const Setting& setting, const std::string& value);
+std::string Step(const Setting& setting, const std::string& value, int direction);
+
+// The network library (Settings > Online): its share at /net/library (port/ps4_netfs.cpp), or
+// none when it's off. Called after Load and when its settings change.
+void MountNetworkLibrary();
+// "/net/library" when the network library is on, else empty.
+std::string NetworkLibraryFolder();
+
+// Game process: applies the settings of the game being started (title ID as 16 hex digits)
+// to Cemu's config and game profile, in memory.
+void Apply(const std::string& game_id);
+
+// A tested game in game-settings.ini: how it runs and the settings it starts with.
+struct Recommendation
+{
+	std::string name;   // the game's name
+	std::string status; // Playable, Ingame, Intro, Loadable, Nothing (the README's compatibility list)
+	std::string fps;    // e.g. "29-30 (a 30 FPS game)"
+	std::string note;   // one line on what it needs
+	std::vector<std::pair<std::string, std::string>> values; // crema.ini keys, valid values only
+};
+// The game's entry (title ID as 16 hex digits); false when it has none.
+bool GetRecommendation(const std::string& game_id, Recommendation* recommendation);
+// The revision of the game-settings.ini in use (its [crema] revision=), 0 when there's none.
+uint64_t RecommendedRevision();
+// The repository's game-settings.ini on GitHub (raw).
+const char* RecommendedUrl();
+// A downloaded game-settings.ini: saved as data_dir/game-settings.ini and used at once when its
+// revision is higher than the one in use. message: what happened, for the log.
+bool InstallRecommended(const std::string& text, std::string* message);
+} // namespace CremaSettings
diff --git a/src/gui/ps4/launcher/CremaUpdater.cpp b/src/gui/ps4/launcher/CremaUpdater.cpp
new file mode 100644
index 0000000..f4b0838
--- /dev/null
+++ b/src/gui/ps4/launcher/CremaUpdater.cpp
@@ -0,0 +1,236 @@
+#include "gui/ps4/launcher/CremaUpdater.h"
+#include "gui/ps4/launcher/CremaHttp.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <vector>
+
+#include <dirent.h>
+#include <unistd.h>
+
+#include <openssl/evp.h>
+#include <rapidjson/document.h>
+
+extern "C" void ps4_boot_trace(const char* line); // port/ps4_crashlog.cpp
+
+namespace CremaUpdater
+{
+namespace
+{
+	void Log(const std::string& text)
+	{
+		ps4_boot_trace(("update: " + text).c_str());
+	}
+
+	std::string Lower(std::string text)
+	{
+		for (char& c : text)
+			c = (char)std::tolower((unsigned char)c);
+		return text;
+	}
+
+	std::string Text(const rapidjson::Value& object, const char* key)
+	{
+		const auto it = object.FindMember(key);
+		return it != object.MemberEnd() && it->value.IsString() ? std::string(it->value.GetString(), it->value.GetStringLength()) :
+			std::string();
+	}
+
+	// "<prefix>-v02.17.pkg" -> "02.17", else empty
+	std::string VersionOf(const std::string& name, const std::string& prefix)
+	{
+		const std::string start = prefix + "-v", end = ".pkg";
+		if (name.size() <= start.size() + end.size() || name.compare(0, start.size(), start) != 0 ||
+			Lower(name.substr(name.size() - end.size())) != end)
+			return {};
+		const std::string version = name.substr(start.size(), name.size() - start.size() - end.size());
+		return std::all_of(version.begin(), version.end(), [](char c) { return std::isdigit((unsigned char)c) || c == '.'; }) ? version :
+			std::string();
+	}
+} // namespace
+
+std::string PackagePrefix(const std::string& assetsDir)
+{
+	std::ifstream file(assetsDir + "/version.txt");
+	std::string line;
+	std::getline(file, line); // the version
+	std::getline(file, line); // "lab" for Crema Lab
+	return line.rfind("lab", 0) == 0 ? "Crema-Lab" : "Crema";
+}
+
+Release CheckLatest(const std::string& caFile, const std::string& prefix)
+{
+	Release release;
+	CremaHttp http(caFile);
+	http.SetHeaders({"Accept: application/vnd.github+json", "X-GitHub-Api-Version: 2022-11-28"});
+	std::string body, error;
+	const std::string url = std::string("https://api.github.com/repos/") + REPOSITORY + "/releases?per_page=30";
+	if (!http.Get(url, &body, &error, 4 * 1024 * 1024))
+	{
+		release.error = error.find("HTTP 404") == 0 ? "no releases on GitHub yet" : error;
+		Log("check failed: " + release.error);
+		return release;
+	}
+	rapidjson::Document json;
+	json.Parse(body.data(), body.size());
+	if (json.HasParseError() || !json.IsArray())
+	{
+		release.error = "unexpected answer from GitHub";
+		Log("check failed: " + release.error);
+		return release;
+	}
+	// the newest version that has this app's package (drafts aside)
+	for (const auto& entry : json.GetArray())
+	{
+		if (!entry.IsObject())
+			continue;
+		const auto draft = entry.FindMember("draft");
+		if (draft != entry.MemberEnd() && draft->value.IsBool() && draft->value.GetBool())
+			continue;
+		const auto assets = entry.FindMember("assets");
+		if (assets == entry.MemberEnd() || !assets->value.IsArray())
+			continue;
+		for (const auto& asset : assets->value.GetArray())
+		{
+			if (!asset.IsObject())
+				continue;
+			const std::string name = Text(asset, "name");
+			const std::string version = VersionOf(name, prefix);
+			if (version.empty() || (!release.version.empty() && CompareVersions(version, release.version) <= 0))
+				continue;
+			const auto size = asset.FindMember("size");
+			const std::string digest = Text(asset, "digest");
+			release.version = version;
+			release.title = Text(entry, "name");
+			release.package = name;
+			release.url = Text(asset, "browser_download_url");
+			release.size = size != asset.MemberEnd() && size->value.IsNumber() ? (uint64_t)size->value.GetDouble() : 0;
+			release.sha256 = digest.compare(0, 7, "sha256:") == 0 ? Lower(digest.substr(7)) : "";
+		}
+	}
+	if (release.version.empty() || release.url.empty())
+		release.error = "no " + prefix + " package on GitHub yet";
+	else if (release.sha256.size() != 64)
+		release.error = "the latest package has no checksum"; // it couldn't be checked: not offered
+	else
+		release.ok = true;
+	Log("latest " + prefix + " release " + (release.version.empty() ? "-" : release.version) + " (" + release.package + ", " +
+		std::to_string(release.size) + " bytes)" + (release.ok ? "" : ": " + release.error));
+	return release;
+}
+
+int CompareVersions(const std::string& a, const std::string& b)
+{
+	auto parts = [](const std::string& text) {
+		std::vector<long> numbers;
+		size_t i = 0;
+		while (i < text.size())
+		{
+			if (std::isdigit((unsigned char)text[i]))
+			{
+				char* end = nullptr;
+				numbers.push_back(std::strtol(text.c_str() + i, &end, 10));
+				i = (size_t)(end - text.c_str());
+			}
+			else
+			{
+				i++;
+			}
+		}
+		return numbers;
+	};
+	const std::vector<long> x = parts(a), y = parts(b);
+	for (size_t i = 0; i < std::max(x.size(), y.size()); i++)
+	{
+		const long p = i < x.size() ? x[i] : 0, q = i < y.size() ? y[i] : 0;
+		if (p != q)
+			return p < q ? -1 : 1;
+	}
+	return 0;
+}
+
+bool Download(const Release& release, const std::string& path, const std::string& caFile,
+	const std::function<bool(uint64_t, uint64_t)>& progress, std::string* error)
+{
+	const std::string part = path + ".part";
+	FILE* file = fopen(part.c_str(), "wb");
+	if (!file)
+	{
+		*error = "can't write " + part;
+		return false;
+	}
+	EVP_MD_CTX* sha = EVP_MD_CTX_new();
+	EVP_DigestInit_ex(sha, EVP_sha256(), nullptr);
+	uint64_t written = 0;
+	bool writeFailed = false;
+	CremaHttp http(caFile, [&](uint64_t done, uint64_t total) { return progress(done, total ? total : release.size); });
+	const bool got = http.Get(release.url, [&](const char* data, size_t size) {
+		if (fwrite(data, 1, size, file) != size)
+		{
+			writeFailed = true;
+			return false;
+		}
+		EVP_DigestUpdate(sha, data, size);
+		written += size;
+		return true;
+	}, error);
+	fclose(file);
+	unsigned char digest[EVP_MAX_MD_SIZE];
+	unsigned int length = 0;
+	EVP_DigestFinal_ex(sha, digest, &length);
+	EVP_MD_CTX_free(sha);
+	std::string hex;
+	for (unsigned int i = 0; i < length; i++)
+	{
+		static const char digits[] = "0123456789abcdef";
+		hex += digits[digest[i] >> 4];
+		hex += digits[digest[i] & 15];
+	}
+	if (writeFailed)
+		*error = "couldn't write the package (is the PS4's storage full?)";
+	else if (got && written != release.size)
+		*error = "the download is incomplete";
+	else if (got && hex != release.sha256)
+		*error = "the download doesn't match GitHub's checksum";
+	if (!got || writeFailed || hex != release.sha256 || written != release.size)
+	{
+		std::remove(part.c_str());
+		Log("download failed: " + *error);
+		return false;
+	}
+	std::remove(path.c_str());
+	if (std::rename(part.c_str(), path.c_str()) != 0)
+	{
+		*error = "can't rename " + part;
+		std::remove(part.c_str());
+		return false;
+	}
+	Log("downloaded " + path + " (" + std::to_string(written) + " bytes, checksum OK)");
+	return true;
+}
+
+void RemoveOld(const std::string& prefix, const std::string& running)
+{
+	DIR* dir = opendir("/data/pkg");
+	if (!dir)
+		return;
+	std::vector<std::string> remove;
+	while (dirent* entry = readdir(dir))
+	{
+		std::string name = entry->d_name;
+		const bool partial = name.size() > 5 && name.compare(name.size() - 5, 5, ".part") == 0;
+		const std::string version = VersionOf(partial ? name.substr(0, name.size() - 5) : name, prefix);
+		if (!version.empty() && (partial || CompareVersions(version, running) <= 0))
+			remove.push_back(name);
+	}
+	closedir(dir);
+	for (const std::string& name : remove)
+	{
+		unlink(("/data/pkg/" + name).c_str());
+		Log("removed /data/pkg/" + name);
+	}
+}
+} // namespace CremaUpdater
diff --git a/src/gui/ps4/launcher/CremaUpdater.h b/src/gui/ps4/launcher/CremaUpdater.h
new file mode 100644
index 0000000..132ae41
--- /dev/null
+++ b/src/gui/ps4/launcher/CremaUpdater.h
@@ -0,0 +1,49 @@
+// Updates from Crema's GitHub releases (as DolphinPS4's PS4Updater): the newest release with a
+// package for this app (Crema-v<version>.pkg, or Crema-Lab-v<version>.pkg for Crema Lab) is
+// compared with the running version, and its package downloaded - the connection's certificate
+// checked, the file checked against the SHA-256 GitHub publishes for it - into /data/pkg, for the
+// PS4's package installer. The running app can't install over itself (DolphinPS4: the system's
+// overwrite call uninstalls the running app, and a downloaded program started from /data didn't
+// start on 13.52), so the user installs it with Crema closed.
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <functional>
+#include <string>
+
+namespace CremaUpdater
+{
+// The GitHub repository the releases come from.
+constexpr const char* REPOSITORY = "iHaiDeeZ/Crema";
+
+struct Release
+{
+	bool ok = false;
+	std::string error;
+	std::string version; // "02.17" (the tag without its "v")
+	std::string title;   // the release's name
+	std::string package; // file name of the .pkg asset
+	std::string url;     // its download address
+	uint64_t size = 0;
+	std::string sha256;  // lower-case hex
+};
+
+// "Crema" or "Crema-Lab": the packages' names (/app0/version.txt's second line says "lab").
+std::string PackagePrefix(const std::string& assetsDir);
+
+// The newest release that has a package for this app.
+Release CheckLatest(const std::string& caFile, const std::string& prefix);
+
+// <0 if a is older than b, 0 if equal, >0 if newer ("02.99" < "03.00" < "03.10").
+int CompareVersions(const std::string& a, const std::string& b);
+
+// Downloads the release's package to path (through path + ".part"), checking its size and
+// SHA-256. progress(done, total) may return false to cancel. False with *error set.
+bool Download(const Release& release, const std::string& path, const std::string& caFile,
+	const std::function<bool(uint64_t, uint64_t)>& progress, std::string* error);
+
+// Packages this updater left in /data/pkg (<prefix>-v<version>.pkg, and unfinished .part files)
+// for the running version or older: installed, no longer needed. Newer ones stay.
+void RemoveOld(const std::string& prefix, const std::string& running);
+} // namespace CremaUpdater
