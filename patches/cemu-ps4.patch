+	auto regA = _regF64(first->op_fpr_compare.regA);
+	auto regB = _regF64(first->op_fpr_compare.regB);
+	bool needOrdered = false;
+	for (size_t k = 0; k < count; k++)
+	{
+		auto regR = _reg8(first[k].op_fpr_compare.regR);
+		x64GenContext->emitter->XOR_dd(_reg32_from_reg8(regR), _reg32_from_reg8(regR));
+		const IMLCondition cond = first[k].op_fpr_compare.cond;
+		if (cond == IMLCondition::UNORDERED_LT || cond == IMLCondition::UNORDERED_EQ)
