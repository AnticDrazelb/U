+	void Menu::DrawBackground()
+	{
+		ImDrawList* dl = ImGui::GetBackgroundDrawList();
+		const Theme& theme = CurrentTheme();
+		if (m_wallpaper)
+		{
+			dl->AddImage(m_wallpaper, ImVec2(0, 0), ImVec2(W, H));
+			dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(W, H * 0.5f), IM_COL32(0, 0, 0, 90), IM_COL32(0, 0, 0, 90),
+				IM_COL32(0, 0, 0, 0), IM_COL32(0, 0, 0, 0));
+			dl->AddRectFilledMultiColor(ImVec2(0, H * 0.5f), ImVec2(W, H), IM_COL32(0, 0, 0, 0), IM_COL32(0, 0, 0, 0),
+				IM_COL32(0, 0, 0, 110), IM_COL32(0, 0, 0, 110));
+			return;
+		}
+		const ImU32 top = Rgba(theme.top), bottom = Rgba(theme.bottom);
+		dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(W, H), top, top, bottom, bottom);
+
+		// Waves: translucent ribbons drifting across the middle of the screen.
+		struct Wave
+		{
+			float base, amplitude, wavelength, speed, phase, thickness, alpha;
+		};
+		constexpr Wave waves[] = {
+			{640, 60, 1300, 0.35f, 0.0f, 110, 0.10f}, {660, 45, 900, -0.25f, 1.7f, 70, 0.12f},
+			{620, 80, 1700, 0.18f, 3.1f, 160, 0.07f}, {680, 30, 700, 0.45f, 4.4f, 40, 0.14f},
+			{650, 55, 1100, -0.32f, 5.2f, 90, 0.09f},
+		};
+		constexpr float step = 24.0f;
+		for (const Wave& wave : waves)
+		{
+			const float k = 2.0f * 3.14159265f / wave.wavelength;
+			ImVec2 prevTop, prevBottom;
+			std::vector<ImVec2> edge;
+			for (float x = -step; x <= W + step; x += step)
+			{
+				const float t = m_time * wave.speed;
+				const float y = wave.base + wave.amplitude * std::sin(x * k + t + wave.phase) +
+					wave.amplitude * 0.35f * std::sin(x * k * 2.3f - t * 1.7f + wave.phase);
+				const float thick = wave.thickness * (0.65f + 0.35f * std::sin(x * k * 0.6f + m_time * 0.4f + wave.phase));
+				const ImVec2 pTop(x, y), pBottom(x, y + thick);
+				if (x > -step)
+				{
+					QuadMultiColor(dl, prevTop, pTop, pBottom, prevBottom, Rgba(theme.wave, wave.alpha),
+						Rgba(theme.wave, wave.alpha), Rgba(theme.wave, 0.0f), Rgba(theme.wave, 0.0f));
+				}
+				edge.push_back(pTop);
+				prevTop = pTop;
+				prevBottom = pBottom;
+			}
+			dl->AddPolyline(edge.data(), (int)edge.size(), Rgba(theme.wave, wave.alpha * 2.2f), ImDrawFlags_None, 2.0f);
+		}
+	}
+
+	void Menu::DrawCategoryIcon(ImDrawList* dl, Category category, ImVec2 c, float s, ImU32 color)
+	{
+		const float r = s * 0.5f;
+		switch (category)
+		{
+		case Category::Settings:
+		{
+			// Gear: a ring with eight teeth.
+			for (int i = 0; i < 8; i++)
+			{
+				const float a = i * 3.14159265f / 4.0f;
+				const ImVec2 d(std::cos(a), std::sin(a));
+				const ImVec2 n(-d.y, d.x);
+				const float w = r * 0.16f;
+				dl->AddQuadFilled(ImVec2(c.x + d.x * r * 0.62f + n.x * w, c.y + d.y * r * 0.62f + n.y * w),
+					ImVec2(c.x + d.x * r * 0.95f + n.x * w, c.y + d.y * r * 0.95f + n.y * w),
+					ImVec2(c.x + d.x * r * 0.95f - n.x * w, c.y + d.y * r * 0.95f - n.y * w),
+					ImVec2(c.x + d.x * r * 0.62f - n.x * w, c.y + d.y * r * 0.62f - n.y * w), color);
+			}
+			dl->AddCircle(c, r * 0.55f, color, 40, r * 0.22f);
+			break;
+		}
+		case Category::Games:
+		{
+			// A Wii U GamePad: the body, its screen, the sticks.
+			const ImVec2 a(c.x - r * 0.95f, c.y - r * 0.5f), b(c.x + r * 0.95f, c.y + r * 0.5f);
+			dl->AddRect(a, b, color, r * 0.3f, 0, r * 0.12f);
+			dl->AddRectFilled(ImVec2(c.x - r * 0.45f, c.y - r * 0.3f), ImVec2(c.x + r * 0.45f, c.y + r * 0.3f), color, r * 0.06f);
+			dl->AddCircleFilled(ImVec2(c.x - r * 0.7f, c.y - r * 0.12f), r * 0.1f, color, 16);
+			dl->AddCircleFilled(ImVec2(c.x + r * 0.7f, c.y - r * 0.12f), r * 0.1f, color, 16);
+			break;
+		}
+		case Category::Themes:
+		{
+			// A palette with paint dots.
+			dl->AddCircleFilled(c, r * 0.9f, color, 48);
+			const ImU32 hole = IM_COL32(0, 0, 0, 120);
+			const float dots[][2] = {{-0.45f, -0.3f}, {0.0f, -0.55f}, {0.45f, -0.3f}, {0.5f, 0.2f}};
+			for (const auto& d : dots)
+				dl->AddCircleFilled(ImVec2(c.x + d[0] * r, c.y + d[1] * r), r * 0.14f, hole, 20);
+			dl->AddCircleFilled(ImVec2(c.x - r * 0.25f, c.y + r * 0.38f), r * 0.2f, hole, 24);
+			break;
+		}
+		}
+	}
+
+	// A game's square tile: its icon (or box art), else its initials on the theme's colour.
+	void Menu::DrawGameTile(ImDrawList* dl, const Game& game, ImVec2 min, ImVec2 max, float alpha, float rounding)
+	{
+		const Theme& theme = CurrentTheme();
+		if (game.cover)
+		{
+			dl->AddImageRounded(game.cover, min, max, ImVec2(0, 0), ImVec2(1, 1), IM_COL32(255, 255, 255, (int)(alpha * 255)), rounding);
+			return;
+		}
+		dl->AddRectFilledMultiColor(min, max, Rgba(theme.wave, alpha * 0.9f), Rgba(theme.wave, alpha * 0.9f),
+			Rgba(theme.bottom, alpha), Rgba(theme.bottom, alpha));
+		const float size = std::max(18.0f, (max.y - min.y) * 0.12f);
+		dl->AddText(m_bold, size, ImVec2(min.x + 12, max.y - size * 2.6f), Rgba(0xFFFFFF, alpha), game.title.c_str(), nullptr,
+			max.x - min.x - 24);
+	}
+
+	void Menu::DrawItem(ImDrawList* dl, const Item& item, float y, bool selected, float alpha)
+	{
+		const Theme& theme = CurrentTheme();
+		const float x = 470.0f; // under the selected category icon
+		const float iconH = selected ? 96.0f : 72.0f;
+		const float iconW = iconH * 3.0f;
+		const ImVec2 iconMin(x - iconW * 0.5f, y - iconH * 0.5f);
+		const ImVec2 iconMax(x + iconW * 0.5f, y + iconH * 0.5f);
+		const ImU32 text = Rgba(theme.text, alpha);
+
+		if (item.game >= 0)
+		{
+			// The icon, square, centred where the banner would be.
+			const Game& game = m_games[item.game];
+			const float ch = selected ? 140.0f : 104.0f;
+			const float cw = ch * std::clamp(game.coverAspect, 0.6f, 1.0f);
+			const ImVec2 cmin(x - cw * 0.5f, y - ch * 0.5f), cmax(x + cw * 0.5f, y + ch * 0.5f);
+			dl->AddRectFilled(ImVec2(cmin.x + 4, cmin.y + 6), ImVec2(cmax.x + 4, cmax.y + 6),
+				IM_COL32(0, 0, 0, (int)(alpha * 90)), 12.0f);
+			DrawGameTile(dl, game, cmin, cmax, alpha, 12.0f);
+			if (selected)
+				dl->AddRect(cmin, cmax, Rgba(theme.text, alpha * 0.9f), 12.0f, 0, 3.0f);
+		}
+		else if (item.theme != -1)
+		{
+			// Theme swatch.
+			if (item.theme >= 0)
+			{
+				const Theme& t = THEMES[item.theme];
+				dl->AddRectFilledMultiColor(iconMin, iconMax, Rgba(t.top, alpha), Rgba(t.top, alpha), Rgba(t.bottom, alpha),
+					Rgba(t.bottom, alpha));
+				dl->AddLine(ImVec2(iconMin.x + 10, y + 6), ImVec2(iconMax.x - 10, y - 8), Rgba(t.wave, alpha), 4.0f);
+			}
+			else
+			{
+				dl->AddRectFilled(iconMin, iconMax, Rgba(0x404650, alpha), 8.0f);
+				Text(dl, m_bold, 26, ImVec2(x - 40, y - 15), Rgba(0xFFFFFF, alpha), "PNG", false);
+			}
+			dl->AddRect(iconMin, iconMax, Rgba(theme.text, alpha * (selected ? 0.9f : 0.4f)), 6.0f, 0, selected ? 3.0f : 1.5f);
+		}
+		else
+		{
+			// Settings: a small round icon.
+			dl->AddCircle(ImVec2(x, y), iconH * 0.32f, text, 32, 4.0f);
+			dl->AddCircleFilled(ImVec2(x, y), iconH * 0.12f, text, 20);
+		}
+
+		const float tx = x + iconW * 0.5f + 36.0f;
+		const float titleSize = selected ? 46.0f : 36.0f;
+		Text(dl, m_bold, titleSize, ImVec2(tx, y - titleSize * 0.62f), text, item.label);
+		float sx = tx;
+		const float subY = y + titleSize * 0.42f;
+		if (item.game >= 0)
+		{
+			// Platform tag: blue Wii U, grey Homebrew.
+			const Game& game = m_games[item.game];
+			const char* tag = game.homebrew ? "HOMEBREW" : "Wii U";
+			const float tagSize = 22.0f;
+			const float tw = TextWidth(m_bold, tagSize, tag);
+			const ImU32 bg = game.homebrew ? Rgba(0x5A6270, alpha) : Rgba(0x1CA7EC, alpha);
+			dl->AddRectFilled(ImVec2(sx, subY + 2), ImVec2(sx + tw + 24, subY + 32), bg, 15.0f);
+			Text(dl, m_bold, tagSize, ImVec2(sx + 12, subY + 4), Rgba(0xFFFFFF, alpha), tag, false);
+			sx += tw + 40;
+		}
+		if (!item.detail.empty())
+			Text(dl, m_font, 26.0f, ImVec2(sx, subY + 1), Rgba(theme.text, alpha * 0.75f), item.detail);
+	}
