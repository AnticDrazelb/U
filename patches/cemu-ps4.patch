+	void Menu::DrawHints(ImDrawList* dl)
+	{
+		const Theme& theme = CurrentTheme();
+		const ImU32 text = Rgba(theme.text, 0.85f);
+		float x = W - 120;
+		const float y = H - 80;
+		auto hint = [&](const char* label, const char* glyph) {
+			const float tw = TextWidth(m_font, 28, label);
+			x -= tw;
+			Text(dl, m_font, 28, ImVec2(x, y - 17), text, label);
+			x -= PS4Glyphs::Width(glyph, 36) + 12;
+			PS4Glyphs::Draw(dl, m_bold, glyph, x, y, 36, 0.9f);
+			x -= 44;
+		};
+		if (m_panel.open)
+		{
+			hint("Back", "Circle");
+			if (!m_panel.options.empty())
+				hint("Select", "Cross");
+			if (!m_panel.rows.empty())
+				hint("Change", "Cross");
+		}
+		else
+		{
+			const auto& items = m_items[m_category];
+			const bool game = !items.empty() && items[m_selected[m_category]].game >= 0;
+			if (m_category == (int)Category::Games)
+				hint("Refresh", "Square");
+			if (game)
+				hint("Options", "Triangle");
+			hint(game ? "Play" : "Select", "Cross");
+		}
+	}
+
+	void Menu::Draw(float dt)
+	{
+		if (Library())
+			DrawLibraryBackground();
+		else
+			DrawBackground();
+		ImDrawList* dl = ImGui::GetForegroundDrawList();
+		const Theme& theme = CurrentTheme();
+
+		Approach(m_categoryPos, (float)m_category, 12.0f, dt);
+		for (int c = 0; c < CATEGORY_COUNT; c++)
+			Approach(m_itemPos[c], (float)m_selected[c], 14.0f, dt);
+
+		if (Library())
+		{
+			DrawLibrary(dl, dt);
+		}
+		else
+		{
+			// Categories: the selected one sits at x = 470, the others spaced to the left and right.
+			const float rowY = 250.0f;
+			const float spacing = 240.0f;
+			for (int c = 0; c < CATEGORY_COUNT; c++)
+			{
+				const float offset = (float)c - m_categoryPos;
+				const float x = 470.0f + offset * spacing;
+				const float focus = std::max(0.0f, 1.0f - std::abs(offset));
+				const float size = 92.0f + 34.0f * focus;
+				const float alpha = 0.55f + 0.45f * focus;
+				DrawCategoryIcon(dl, (Category)c, ImVec2(x, rowY), size, Rgba(theme.text, alpha));
+				if (focus > 0.05f)
+				{
+					const float tw = TextWidth(m_font, 32, CATEGORY_NAMES[c]);
+					Text(dl, m_font, 32, ImVec2(x - tw * 0.5f, rowY + 76), Rgba(theme.text, focus), CATEGORY_NAMES[c]);
+				}
+			}
+
+			// Items of the selected category (blended into the neighbour while switching).
+			const int c = m_category;
+			const float switchAlpha = std::max(0.0f, 1.0f - std::abs(m_categoryPos - c) * 2.0f);
+			const auto& items = m_items[c];
+			for (int i = 0; i < (int)items.size(); i++)
+			{
+				const float rel = (float)i - m_itemPos[c];
+				float y;
+				float alpha;
+				if (rel >= -0.5f)
+				{
+					y = 470.0f + rel * 120.0f + (rel > 0.5f ? 40.0f : rel * 80.0f);
+					alpha = rel < 0.5f ? 1.0f : std::max(0.0f, 0.85f - (rel - 1.0f) * 0.12f);
+				}
+				else
+				{
+					y = 120.0f + (rel + 1.0f) * 100.0f;
+					alpha = std::max(0.0f, 0.55f + (rel + 1.0f) * 0.2f);
+				}
+				if (y < -80.0f || y > H + 80.0f || alpha <= 0.01f)
+					continue;
+				DrawItem(dl, items[i], y, i == m_selected[c], alpha * switchAlpha);
+			}
+
+			if (m_prefs.clock)
+			{
+				const std::time_t now = std::time(nullptr);
+				std::tm local = {};
+				localtime_r(&now, &local);
+				char clock[32];
+				std::strftime(clock, sizeof(clock), "%H:%M", &local);
+				const float tw = TextWidth(m_bold, 40, clock);
+				Text(dl, m_bold, 40, ImVec2(W - 110 - tw, 70), Rgba(theme.text, 0.95f), clock);
+			}
+			if (m_logo)
+				dl->AddImage(m_logo, ImVec2(70, 50), ImVec2(150, 130), ImVec2(0, 0), ImVec2(1, 1), IM_COL32(255, 255, 255, 230));
+		}
+
+		DrawSidePanel(dl, dt);
+		if (Library() && m_panel.slide < 0.5f)
+			DrawLibraryHints(dl);
+		else
+			DrawHints(dl);
+
+		// Fades: in at start, out when a game launches.
+		if (m_launch >= 0)
+		{
+			m_launchTime += dt;
+			m_fade = std::min(1.0f, m_launchTime / 0.7f);
+		}
+		else
+		{
+			Approach(m_fade, 0.0f, 6.0f, dt);
+		}
+		if (m_fade > 0.005f)
+			dl->AddRectFilled(ImVec2(0, 0), ImVec2(W, H), IM_COL32(0, 0, 0, (int)(m_fade * 255)));
+		DrawIntro(dl, dt);
+	}
+
+	// The intro: the console drops in with a bounce and wiggles, the coffee appears on its screen
+	// with the chime (sounds/intro.wav), steam rises, "Crema" comes up under it, then everything
+	// dissolves into the menu. The console and the coffee are separate pictures
+	// (launcher/intro-console.png, intro-coffee.png) so they move on their own.
+	void Menu::DrawIntro(ImDrawList* dl, float dt)
+	{
+		if (!m_intro)
+			return;
+		if (!m_introConsole)
+		{
+			m_intro = false; // the pictures are missing: no intro
+			return;
+		}
+		m_introTime += dt;
+		const float t = m_introTime;
+		constexpr float DROP = 0.55f, WIGGLE_END = 1.25f, COFFEE = 1.3f, OUT_START = 2.6f, END = 3.2f;
+		if (t >= END)
+		{
+			m_intro = false;
+			return;
+		}
+		static bool s_chimed = false;
+		if (t >= COFFEE && !s_chimed)
+		{
+			s_chimed = true;
+			Play("intro");
+		}
+		auto clamp01 = [](float v) { return std::clamp(v, 0.0f, 1.0f); };
+		auto smooth = [](float v) { return v * v * (3.0f - 2.0f * v); };
+		auto alpha = [](float a) { return (int)(std::clamp(a, 0.0f, 1.0f) * 255.0f); };
+		// ease out with a little overshoot ("back")
+		auto back = [](float v) {
+			const float s = 1.9f;
+			v -= 1.0f;
+			return v * v * ((s + 1.0f) * v + s) + 1.0f;
+		};
+		const float out = smooth(clamp01((t - OUT_START) / (END - OUT_START)));
+		const float vis = 1.0f - out;
+
+		// Night sky.
+		dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(W, H), IM_COL32(16, 12, 40, alpha(vis)), IM_COL32(16, 12, 40, alpha(vis)),
+			IM_COL32(4, 3, 12, alpha(vis)), IM_COL32(4, 3, 12, alpha(vis)));
+		static const int PALETTE[4][3] = {{150, 90, 255}, {255, 90, 190}, {70, 200, 255}, {255, 255, 255}};
+		auto hash = [](int i, float k) { return std::abs(std::fmod(std::sin(i * k) * 43758.5453f, 1.0f)); };
+		auto light = [&](float x, float y, float radius, const int* rgb, float a) {
+			if (a <= 0.004f || !m_glow)
+				return;
+			dl->AddImage(m_glow, ImVec2(x - radius, y - radius), ImVec2(x + radius, y + radius), ImVec2(0, 0), ImVec2(1, 1),
+				IM_COL32(rgb[0], rgb[1], rgb[2], alpha(a)));
+		};
+
+		const ImVec2 centre(W * 0.5f, H * 0.42f);
+		// The console: falls in from above (scale and position with a bounce), then wiggles.
+		const float drop = clamp01(t / DROP);
+		const float scale = (0.55f + 0.45f * back(drop)) * (1.0f + 0.10f * out);
+		float angle = -0.14f * (1.0f - drop);
+		ImVec2 pos(centre.x, centre.y - (1.0f - back(drop)) * H * 0.55f);
+		if (t > DROP * 0.8f && t < WIGGLE_END + 0.3f)
+		{
+			// a shake that dies out: rotation and a little sideways jitter
+			const float w = t - DROP * 0.8f;
+			const float decay = std::exp(-w * 4.5f);
+			angle += 0.10f * std::sin(w * 34.0f) * decay;
+			pos.x += 14.0f * std::sin(w * 41.0f + 1.3f) * decay;
+		}
+		// Nebula glow around it.
+		const float neb = clamp01((t - 0.1f) / 0.5f) * vis;
+		for (int i = 0; i < 18; i++)
+		{
+			const float ang = i * 2.39996f + t * (i % 2 ? 0.35f : -0.28f);
+			const float dist = (80.0f + 200.0f * hash(i, 12.9898f)) * (1.0f + 1.2f * out);
+			light(pos.x + std::cos(ang) * dist * 1.4f, pos.y + std::sin(ang) * dist * 0.75f, 140.0f + 170.0f * hash(i, 78.233f),
+				PALETTE[i % 3], 0.12f * neb);
+		}
+		const float cw = 900.0f * scale, ch = cw / m_introConsoleAspect;
+		RotatedImage(dl, m_introConsole, pos, cw, ch, angle, IM_COL32(255, 255, 255, alpha(clamp01(t / 0.25f) * vis)));
+
+		// The coffee: pops onto the console's screen (the picture's middle) with sparkles and steam.
+		if (m_introCoffee && t >= COFFEE)
+		{
+			const float q = clamp01((t - COFFEE) / 0.45f);
+			const float s = scale * (0.4f + 0.6f * back(q));
+			const float kw = 900.0f * s, kh = kw / m_introCoffeeAspect;
+			RotatedImage(dl, m_introCoffee, pos, kw, kh, angle, IM_COL32(255, 255, 255, alpha(q * vis)));
+			for (int i = 0; i < 70; i++)
+			{
+				const float a = hash(i, 21.7f) * 6.2832f;
+				const float r = (60.0f + 380.0f * hash(i, 4.4f)) * (1.0f - (1.0f - q) * (1.0f - q));
+				light(pos.x + std::cos(a) * r, pos.y + std::sin(a) * r * 0.6f, 3.0f + 5.0f * hash(i, 6.6f), PALETTE[(i + 1) % 4],
+					(1.0f - q) * 0.9f * vis);
+			}
+		}
+
+		// The title rises into place under the console.
+		const float tq = smooth(clamp01((t - 1.75f) / 0.45f));
+		if (m_introTitle)
+		{
+			const float tw = 560.0f, th = tw / m_introTitleAspect;
+			const ImVec2 at(W * 0.5f - tw / 2, H * 0.77f + 24.0f * (1.0f - tq));
+			dl->AddImage(m_introTitle, at, ImVec2(at.x + tw, at.y + th), ImVec2(0, 0), ImVec2(1, 1), IM_COL32(255, 255, 255, alpha(tq * vis)));
+		}
+		else
+		{
+			const float size = 96.0f;
+			const float tw = m_bold->CalcTextSizeA(size, FLT_MAX, 0.0f, "Crema").x;
+			dl->AddText(m_bold, size, ImVec2(W * 0.5f - tw / 2, H * 0.77f + 24.0f * (1.0f - tq)), IM_COL32(245, 228, 200, alpha(tq * vis)), "Crema");
+		}
+	}
+
+	// ---------------------------------------------------------------------------------------------
+	// The Library style: the theme's gradient over a glossy floor, tabs on top (L1 / R1), the games
+	// as a row of covers with the selected one in front, and the settings as lists.
+
+	void Menu::DrawLibraryBackground()
+	{
+		ImDrawList* dl = ImGui::GetBackgroundDrawList();
+		const Theme& theme = CurrentTheme();
+		if (m_wallpaper)
+		{
+			dl->AddImage(m_wallpaper, ImVec2(0, 0), ImVec2(W, H));
+			dl->AddRectFilled(ImVec2(0, 0), ImVec2(W, H), IM_COL32(0, 0, 0, 110));
+			return;
+		}
+		const ImU32 top = Rgba(theme.top), bottom = Rgba(theme.bottom);
+		const float horizon = 600.0f;
+		dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(W, horizon), bottom, bottom, top, top);
+		dl->AddRectFilledMultiColor(ImVec2(0, horizon), ImVec2(W, H), top, top, bottom, bottom);
+		// Light ribbons drifting slowly across the sky, very faint.
+		for (int r = 0; r < 3; r++)
+		{
+			const float base = 210.0f + r * 95.0f, amplitude = 50.0f + r * 18.0f;
+			const float k = 2.0f * 3.14159265f / (1500.0f + r * 400.0f);
+			const float speed = (r % 2 == 0 ? 0.12f : -0.09f), phase = r * 2.1f;
+			constexpr float STEP = 32.0f;
+			ImVec2 prevTop, prevBottom;
+			for (float x = -STEP; x <= W + STEP; x += STEP)
+			{
+				const float y = base + amplitude * std::sin(x * k + m_time * speed + phase);
+				const float thick = 70.0f + 40.0f * std::sin(x * k * 0.7f + m_time * 0.2f + phase);
+				const ImVec2 pTop(x, y), pBottom(x, y + thick);
+				if (x > -STEP)
+				{
+					const float mid = 1.0f - std::min(1.0f, std::abs(x - W * 0.5f) / (W * 0.62f));
+					const float a = 0.055f * mid;
+					QuadMultiColor(dl, prevTop, pTop, pBottom, prevBottom, Rgba(theme.wave, 0.0f), Rgba(theme.wave, 0.0f),
+						Rgba(theme.wave, a), Rgba(theme.wave, a));
+				}
+				prevTop = pTop;
+				prevBottom = pBottom;
+			}
+		}
+
+		// The floor: glossy, lit from the horizon, with a pool of light under the covers.
+		dl->AddRectFilledMultiColor(ImVec2(0, horizon), ImVec2(W, H), Rgba(theme.wave, 0.10f), Rgba(theme.wave, 0.10f),
+			Rgba(theme.wave, 0.0f), Rgba(theme.wave, 0.0f));
+		for (int i = 0; i < 8; i++)
+			EllipseFilled(dl, ImVec2(W * 0.5f, 728.0f), ImVec2(160.0f + i * 70.0f, 26.0f + i * 9.0f), Rgba(theme.wave, 0.028f), 64);
+		for (int i = 0; i < 6; i++)
+			EllipseFilled(dl, ImVec2(W * 0.5f, horizon), ImVec2(300.0f + i * 140.0f, 110.0f + i * 40.0f), Rgba(theme.wave, 0.022f), 64);
+		// The horizon: a thin line of light, fading out towards the edges.
+		{
+			const ImU32 clear = Rgba(theme.wave, 0.0f), bright = Rgba(theme.wave, 0.55f);
+			QuadMultiColor(dl, ImVec2(0, horizon - 1), ImVec2(W * 0.5f, horizon - 1), ImVec2(W * 0.5f, horizon + 1),
+				ImVec2(0, horizon + 1), clear, bright, bright, clear);
+			QuadMultiColor(dl, ImVec2(W * 0.5f, horizon - 1), ImVec2(W, horizon - 1), ImVec2(W, horizon + 1),
+				ImVec2(W * 0.5f, horizon + 1), bright, clear, clear, bright);
+			const ImU32 haze = Rgba(theme.wave, 0.12f);
+			QuadMultiColor(dl, ImVec2(W * 0.15f, horizon - 18), ImVec2(W * 0.5f, horizon - 18), ImVec2(W * 0.5f, horizon),
+				ImVec2(W * 0.15f, horizon), clear, clear, haze, clear);
+			QuadMultiColor(dl, ImVec2(W * 0.5f, horizon - 18), ImVec2(W * 0.85f, horizon - 18), ImVec2(W * 0.85f, horizon),
+				ImVec2(W * 0.5f, horizon), clear, clear, clear, haze);
+		}
+
+		// Specks of light rising slowly and twinkling (fixed positions from a hash, so no state).
+		for (int i = 0; i < 46; i++)
+		{
+			const float h1 = std::fmod(std::sin(i * 12.9898f) * 43758.5453f, 1.0f);
+			const float h2 = std::fmod(std::sin(i * 78.233f) * 12345.6789f, 1.0f);
+			const float fx = std::abs(h1), fy = std::abs(h2);
+			const float speed = 8.0f + fx * 14.0f;
+			const float y = H - std::fmod(fy * H + m_time * speed, H + 40.0f);
+			const float x = fx * W + std::sin(m_time * 0.3f + i) * 18.0f;
+			const float twinkle = 0.5f + 0.5f * std::sin(m_time * (0.8f + fy) + i * 1.7f);
+			const float radius = 1.5f + fy * 3.0f;
+			const float a = (0.10f + 0.25f * twinkle) * std::clamp(y / H * 1.4f, 0.0f, 1.0f);
+			dl->AddCircleFilled(ImVec2(x, y), radius * 3.0f, Rgba(theme.wave, a * 0.18f), 16);
+			dl->AddCircleFilled(ImVec2(x, y), radius, Rgba(0xFFFFFF, a), 12);
+		}
+	}
+
+	// A cover (the icon, or box art) on the quad a-b-c-d (top left, top right, bottom right,
+	// bottom left), with its reflection on the floor. focus: 2 = the selected game, 1 = the others.
+	void Menu::DrawCover(ImDrawList* dl, const Game& game, ImVec2 a, ImVec2 b, ImVec2 c, ImVec2 d, float alpha, int focus)
+	{
+		const Theme& theme = CurrentTheme();
+		const int a255 = (int)(std::clamp(alpha, 0.0f, 1.0f) * 255.0f);
+		const ImU32 white = IM_COL32(255, 255, 255, a255);
+		const float h = d.y - a.y;
+		// Shadow.
+		dl->AddQuadFilled(ImVec2(a.x + 8, a.y + 12), ImVec2(b.x + 8, b.y + 12), ImVec2(c.x + 8, c.y + 12), ImVec2(d.x + 8, d.y + 12),
+			IM_COL32(0, 0, 0, a255 * 45 / 100));
+		if (focus == 2)
+		{
+			// Glow around the selected cover.
+			for (int i = 6; i >= 1; i--)
+			{
+				const float g = i * 4.0f;
+				dl->AddQuad(ImVec2(a.x - g, a.y - g), ImVec2(b.x + g, b.y - g), ImVec2(c.x + g, c.y + g), ImVec2(d.x - g, d.y + g),
+					Rgba(theme.wave, alpha * 0.07f * (7 - i)), 5.0f);
+			}
+		}
+		if (game.cover)
+		{
+			dl->AddImageQuad(game.cover, a, b, c, d, ImVec2(0, 0), ImVec2(1, 0), ImVec2(1, 1), ImVec2(0, 1), white);
+			// Reflection: the cover upside down under it, fading out.
+			const float r = 0.30f;
+			const ImVec2 ra(d.x, d.y + 6), rb(c.x, c.y + 6);
+			const ImVec2 rc(c.x, c.y + 6 + (c.y - b.y) * r), rd(d.x, d.y + 6 + (d.y - a.y) * r);
+			ImageQuadColors(dl, game.cover, ra, rb, rc, rd, ImVec2(0, 1), ImVec2(1, 1), ImVec2(1, 1 - r), ImVec2(0, 1 - r),
+				IM_COL32(255, 255, 255, a255 * 28 / 100), IM_COL32(255, 255, 255, a255 * 28 / 100), IM_COL32(255, 255, 255, 0),
+				IM_COL32(255, 255, 255, 0));
+		}
+		else
+		{
+			const ImU32 tileTop = Rgba(theme.wave, alpha * 0.9f), tileBottom = Rgba(theme.bottom, alpha);
+			QuadMultiColor(dl, a, b, c, d, tileTop, tileTop, tileBottom, tileBottom);
+			const float size = std::max(18.0f, h * 0.075f);
+			dl->AddText(m_bold, size, ImVec2(a.x + 14, a.y + h * 0.66f), white, game.title.c_str(), nullptr, b.x - a.x - 28);
+		}
+		// Frame: bright for the selected game.
+		if (focus == 2)
+		{
+			dl->AddQuad(a, b, c, d, Rgba(theme.wave, alpha), 5.0f);
+			dl->AddQuad(ImVec2(a.x + 4, a.y + 4), ImVec2(b.x - 4, b.y + 4), ImVec2(c.x - 4, c.y - 4), ImVec2(d.x + 4, d.y - 4),
+				Rgba(0xFFFFFF, alpha * 0.55f), 1.5f);
+		}
+		else
+		{
+			dl->AddQuad(a, b, c, d, Rgba(0xDDE6F0, alpha * 0.45f), 3.0f);
+		}
+	}
+
+	void Menu::DrawLibrary(ImDrawList* dl, float dt)
+	{
+		const Theme& theme = CurrentTheme();
+		const int tab = LibraryTab();
+		Approach(m_tabPos, (float)tab, 14.0f, dt);
+		if (m_sortShown > 0.0f)
+			m_sortShown -= dt;
+
+		// Top bar: the logo, the tabs between L1 and R1, the clock.
+		if (m_logo)
+			dl->AddImage(m_logo, ImVec2(66, 40), ImVec2(140, 114), ImVec2(0, 0), ImVec2(1, 1), IM_COL32(255, 255, 255, 235));
+		{
+			float x = 156.0f;
+			for (const char ch : std::string("CREMA"))
+			{
+				const std::string letter(1, ch);
+				Text(dl, m_bold, 30, ImVec2(x, 62), Rgba(theme.text, 0.95f), letter);
+				x += TextWidth(m_bold, 30, letter) + 7.0f;
+			}
+		}
+		constexpr float TAB_FONT = 28.0f, TAB_PAD = 34.0f, BAR_Y = 52.0f, BAR_H = 58.0f;
+		float tabX[TAB_COUNT], tabW[TAB_COUNT], total = 0.0f;
+		for (int i = 0; i < TAB_COUNT; i++)
+		{
+			tabW[i] = TextWidth(m_bold, TAB_FONT, TAB_NAMES[i]) + TAB_PAD * 2;
+			total += tabW[i];
+		}
+		const float barX = W * 0.5f - total * 0.5f;
+		{
+			float x = barX;
+			for (int i = 0; i < TAB_COUNT; i++)
+			{
+				tabX[i] = x;
+				x += tabW[i];
+			}
+		}
+		dl->AddRectFilled(ImVec2(barX - 8, BAR_Y - 6), ImVec2(barX + total + 8, BAR_Y + BAR_H + 6), Rgba(0x000000, 0.28f), 16.0f);
+		dl->AddRect(ImVec2(barX - 8, BAR_Y - 6), ImVec2(barX + total + 8, BAR_Y + BAR_H + 6), Rgba(theme.text, 0.14f), 16.0f, 0, 1.5f);
+		{
+			// The highlight slides between the tabs.
+			const int i0 = std::clamp((int)std::floor(m_tabPos), 0, TAB_COUNT - 1);
+			const int i1 = std::min(i0 + 1, TAB_COUNT - 1);
+			const float f = std::clamp(m_tabPos - i0, 0.0f, 1.0f);
+			const float hx = tabX[i0] + (tabX[i1] - tabX[i0]) * f;
+			const float hw = tabW[i0] + (tabW[i1] - tabW[i0]) * f;
+			const ImVec2 h0(hx + 2, BAR_Y), h1(hx + hw - 2, BAR_Y + BAR_H);
+			dl->AddRectFilledMultiColor(h0, h1, Rgba(theme.wave, 0.55f), Rgba(theme.wave, 0.55f), Rgba(theme.wave, 0.30f),
+				Rgba(theme.wave, 0.30f));
+			dl->AddRect(h0, h1, Rgba(theme.wave, 0.95f), 12.0f, 0, 2.0f);
+		}
+		for (int i = 0; i < TAB_COUNT; i++)
+		{
+			const bool sel = i == tab;
+			Text(dl, sel ? m_bold : m_font, TAB_FONT, ImVec2(tabX[i] + TAB_PAD, BAR_Y + 12), Rgba(theme.text, sel ? 1.0f : 0.72f),
+				TAB_NAMES[i], sel);
+		}
+		PS4Glyphs::Draw(dl, m_bold, "L1", barX - 8 - 30 - PS4Glyphs::Width("L1", 40), BAR_Y + BAR_H * 0.5f, 40, 0.9f);
+		PS4Glyphs::Draw(dl, m_bold, "R1", barX + total + 8 + 30, BAR_Y + BAR_H * 0.5f, 40, 0.9f);
+		if (m_prefs.clock)
+		{
+			const std::time_t now = std::time(nullptr);
+			std::tm local = {};
+			localtime_r(&now, &local);
+			char clock[32];
+			std::strftime(clock, sizeof(clock), "%H:%M", &local);
+			const float tw = TextWidth(m_bold, 36, clock);
+			Text(dl, m_bold, 36, ImVec2(W - 90 - tw, 62), Rgba(theme.text, 0.95f), clock);
+		}
+
+		// The tab's page; it fades in while the highlight moves.
+		const float alpha = std::clamp(1.0f - std::abs(m_tabPos - tab) * 1.6f, 0.0f, 1.0f);
+		if (TABS[tab] == Category::Games)
+			DrawLibraryGames(dl, alpha);
+		else
+			DrawLibraryList(dl, alpha);
+	}
+
+	void Menu::DrawLibraryGames(ImDrawList* dl, float alpha)
+	{
+		const Theme& theme = CurrentTheme();
+		const int c = (int)Category::Games;
+		const auto& items = m_items[c];
+		const int count = (int)items.size();
+		const bool any = count > 0 && items[0].game >= 0;
+		Text(dl, m_bold, 50, ImVec2(90, 150), Rgba(theme.text, alpha), "Your games");
+		std::string sub = any ? std::to_string(count) + (count == 1 ? " game" : " games") : "No games yet";
+		if (any)
+			sub += "  -  " + SortName();
+		Text(dl, m_bold, 26, ImVec2(92, 214), Rgba(theme.wave, alpha * (m_sortShown > 0.0f ? 1.0f : 0.85f)), sub, false);
+		if (!any)
+		{
+			const std::string line1 = "Copy your games to " + GamesFolder();
+			const std::string line2 = "then press Square to look again (or pick a folder in Settings).";
+			Text(dl, m_bold, 36, ImVec2(W * 0.5f - TextWidth(m_bold, 36, line1) * 0.5f, 470), Rgba(theme.text, alpha), line1);
+			Text(dl, m_font, 28, ImVec2(W * 0.5f - TextWidth(m_font, 28, line2) * 0.5f, 530), Rgba(theme.text, alpha * 0.75f), line2);
+			return;
+		}
+
+		// The row: neighbours smaller and turned slightly towards the middle, farther ones behind.
+		const float pos = m_itemPos[c];
+		const int selected = m_selected[c];
+		constexpr float BASE_H = 400.0f, FLOOR_Y = 720.0f;
+		std::vector<std::pair<float, int>> order;
+		for (int i = 0; i < count; i++)
+		{
+			const float d = (float)i - pos;
+			if (std::abs(d) < 6.5f)
+				order.push_back({std::abs(d), i});
+		}
+		std::sort(order.begin(), order.end(), [](const auto& x, const auto& y) { return x.first > y.first; });
+		float selectedTop = FLOOR_Y - BASE_H;
+		for (const auto& [ad, i] : order)
+		{
+			const Game& game = m_games[items[i].game];
+			const float d = (float)i - pos;
+			const float nearness = std::min(ad, 1.0f), far = std::max(0.0f, ad - 1.0f);
+			const float scale = 1.0f - 0.24f * nearness - 0.05f * far;
+			const float h = BASE_H * scale;
+			const float aspect = game.cover ? std::clamp(game.coverAspect, 0.55f, 1.0f) : 0.8f;
+			const float w = h * aspect;
+			const float side = d < 0.0f ? -1.0f : 1.0f;
+			const float cx = W * 0.5f + side * (nearness * 360.0f + far * 260.0f);
+			const float bottom = FLOOR_Y - 14.0f * nearness;
+			// The outer edge a little shorter: the cover faces the middle.
+			const float tilt = h * 0.045f * nearness;
+			ImVec2 a(cx - w * 0.5f, bottom - h), b(cx + w * 0.5f, bottom - h);
+			ImVec2 cc(cx + w * 0.5f, bottom), dd(cx - w * 0.5f, bottom);
+			if (side > 0)
+			{
+				b.y += tilt;
+				cc.y -= tilt;
+			}
+			else
+			{
+				a.y += tilt;
+				dd.y -= tilt;
+			}
+			const float fade = std::clamp((6.0f - ad) / 1.5f, 0.0f, 1.0f);
+			const float dim = 1.0f - 0.22f * nearness;
+			DrawCover(dl, game, a, b, cc, dd, alpha * fade * dim, i == selected && ad < 0.5f ? 2 : 1);
+			if (i == selected)
+				selectedTop = a.y;
+		}
+
+		// Triangle above the selected cover (its options), its title, platform, last played, Play.
+		const float pulse = 0.65f + 0.35f * std::sin(m_time * 3.0f);
+		const float gw = PS4Glyphs::Width("Triangle", 40);
+		PS4Glyphs::Draw(dl, m_bold, "Triangle", W * 0.5f - gw * 0.5f, selectedTop - 44, 40, alpha * pulse);
+		const Game& game = m_games[items[selected].game];
+		const float titleSize = TextWidth(m_bold, 46, game.title) > W - 200 ? 36.0f : 46.0f;
+		const float tw = TextWidth(m_bold, titleSize, game.title);
+		Text(dl, m_bold, titleSize, ImVec2(W * 0.5f - tw * 0.5f, 800), Rgba(theme.text, alpha), game.title);
+		std::string info = std::string(game.homebrew ? "Homebrew" : "Wii U") + "  -  " + PlayedText(Played(game.path));
+		if (!game.region.empty())
+			info += "  -  " + game.region;
+		if (!m_prefs.defaultGame.empty() && game.path == m_prefs.defaultGame)
+			info += "  -  Starts when Crema opens";
+		const float iw = TextWidth(m_font, 26, info);
+		Text(dl, m_font, 26, ImVec2(W * 0.5f - iw * 0.5f, 860), Rgba(theme.text, alpha * 0.72f), info);
+		const float bw = 210.0f, bh = 62.0f, by = 908.0f;
+		const ImVec2 b0(W * 0.5f - bw * 0.5f, by), b1(W * 0.5f + bw * 0.5f, by + bh);
+		dl->AddRectFilled(b0, b1, Rgba(theme.wave, alpha * 0.18f), 14.0f);
+		dl->AddRect(b0, b1, Rgba(theme.wave, alpha * 0.95f), 14.0f, 0, 2.5f);
+		const float cw = PS4Glyphs::Width("Cross", 38);
+		const float pw = TextWidth(m_bold, 32, "Play");
+		const float px = W * 0.5f - (cw + 14 + pw) * 0.5f;
+		PS4Glyphs::Draw(dl, m_bold, "Cross", px, by + bh * 0.5f, 38, alpha);
+		Text(dl, m_bold, 32, ImVec2(px + cw + 14, by + 12), Rgba(theme.text, alpha), "Play");
+	}
+
+	// Settings and Themes: a list of rows, scrolling with the selection.
+	void Menu::DrawLibraryList(ImDrawList* dl, float alpha)
+	{
+		const Theme& theme = CurrentTheme();
+		const int c = m_category;
+		const auto& items = m_items[c];
+		const bool themes = c == (int)Category::Themes;
+		Text(dl, m_bold, 50, ImVec2(90, 150), Rgba(theme.text, alpha), themes ? "Themes" : "Settings");
+		Text(dl, m_bold, 26, ImVec2(92, 214), Rgba(theme.wave, alpha * 0.85f),
+			themes ? "Colours and wallpapers (PNG in " + m_dataDir + "/themes)" : "Emulation, display, controls and the menus", false);
+		constexpr float X = 90.0f, ROW_H = 84.0f, TOP = 280.0f, BOTTOM = 960.0f;
+		const float right = W - 90.0f;
+		const float visible = (BOTTOM - TOP) / ROW_H;
+		const float scroll = std::clamp(m_itemPos[c] - visible * 0.5f + 0.5f, 0.0f, std::max(0.0f, (float)items.size() - visible));
+		dl->PushClipRect(ImVec2(0, TOP - 20), ImVec2(W, BOTTOM + 10), true);
+		for (int i = 0; i < (int)items.size(); i++)
+		{
+			const Item& item = items[i];
+			const float y = TOP + ((float)i - scroll) * ROW_H;
+			if (y < TOP - ROW_H || y > BOTTOM)
+				continue;
+			const bool sel = i == m_selected[c];
+			const ImVec2 r0(X, y), r1(right, y + ROW_H - 12);
+			if (sel)
+			{
+				dl->AddRectFilled(r0, r1, Rgba(theme.wave, alpha * 0.20f), 14.0f);
+				dl->AddRect(r0, r1, Rgba(theme.wave, alpha), 14.0f, 0, 2.5f);
+			}
+			else
+			{
+				dl->AddRectFilled(r0, r1, Rgba(0x000000, alpha * 0.22f), 14.0f);
+			}
+			float tx = X + 34;
+			if (item.theme != -1)
+			{
+				// Swatch.
+				const ImVec2 s0(X + 24, y + 12), s1(X + 144, y + ROW_H - 24);
+				if (item.theme >= 0)
+				{
+					const Theme& t = THEMES[item.theme];
+					dl->AddRectFilledMultiColor(s0, s1, Rgba(t.top, alpha), Rgba(t.top, alpha), Rgba(t.bottom, alpha), Rgba(t.bottom, alpha));
+					dl->AddLine(ImVec2(s0.x + 10, s1.y - 14), ImVec2(s1.x - 10, s0.y + 14), Rgba(t.wave, alpha), 4.0f);
+				}
+				else
+				{
+					dl->AddRectFilled(s0, s1, Rgba(0x404650, alpha), 6.0f);
+					Text(dl, m_bold, 22, ImVec2(s0.x + 34, s0.y + 12), Rgba(0xFFFFFF, alpha), "PNG", false);
+				}
+				dl->AddRect(s0, s1, Rgba(theme.text, alpha * 0.4f), 6.0f, 0, 1.5f);
+				tx = X + 170;
+			}
+			Text(dl, sel ? m_bold : m_font, 32, ImVec2(tx, y + 18), Rgba(theme.text, alpha), item.label);
+			const float dw = TextWidth(m_font, 26, item.detail);
+			Text(dl, m_font, 26, ImVec2(right - 34 - dw, y + 22), Rgba(theme.text, alpha * 0.7f), item.detail);
+		}
+		dl->PopClipRect();
+	}
+
+	void Menu::DrawLibraryHints(ImDrawList* dl)
+	{
+		const Theme& theme = CurrentTheme();
+		const float y = H - 62.0f;
+		const ImU32 text = Rgba(theme.text, 0.85f);
+		dl->AddLine(ImVec2(70, y - 46), ImVec2(W - 70, y - 46), Rgba(theme.text, 0.10f), 1.5f);
+		float x = 90.0f;
+		auto left = [&](const char* glyph, const std::string& label) {
+			x += PS4Glyphs::Draw(dl, m_bold, glyph, x, y, 36, 0.9f) + 12;
+			Text(dl, m_font, 28, ImVec2(x, y - 17), text, label);
+			x += TextWidth(m_font, 28, label) + 44;
+		};
+		const bool games = m_category == (int)Category::Games;
+		const auto& items = m_items[m_category];
+		const bool hasGame = games && !items.empty() && items[0].game >= 0;
+		left("D-Pad", "Browse");
+		left("Cross", games ? "Play" : "Select");
+		if (hasGame)
+		{
+			char counter[32];
+			snprintf(counter, sizeof(counter), "%02d / %02d", m_selected[m_category] + 1, (int)items.size());
+			const float cw = TextWidth(m_bold, 28, counter);
+			Text(dl, m_bold, 28, ImVec2(W * 0.5f - cw * 0.5f, y - 17), Rgba(theme.text, 0.7f), counter);
+		}
+		float rx = W - 90.0f;
+		auto right = [&](const char* glyph, const std::string& label) {
+			const float lw = TextWidth(m_font, 28, label);
+			rx -= lw;
+			Text(dl, m_font, 28, ImVec2(rx, y - 17), text, label);
+			const float gw = PS4Glyphs::Width(glyph, 36);
+			rx -= gw + 12;
+			PS4Glyphs::Draw(dl, m_bold, glyph, rx, y, 36, 0.9f);
+			rx -= 44;
+		};
+		if (games)
+		{
+			right("Options", "Sort");
+			right("Square", "Refresh");
+			if (hasGame)
+				right("Triangle", "Options");
+		}
+	}
+
+	std::string Menu::Run()
+	{
+		s_log = fopen((m_dataDir + "/launcher.log").c_str(), "w");
+		CremaSettings::Load(m_dataDir);
+		int user = 0;
+		sceUserServiceInitialize(nullptr);
+		sceUserServiceGetInitialUser(&user);
+		m_user = user;
+
+		IMGUI_CHECKVERSION();
+		ImGuiContext* context = ImGui::CreateContext();
+		ImGui::SetCurrentContext(context);
+		ImGuiIO& io = ImGui::GetIO();
+		io.IniFilename = nullptr;
+		io.LogFilename = nullptr;
+		io.DisplaySize = ImVec2(W, H);
+		if (!m_display.Initialize())
+		{
+			ImGui::DestroyContext(context);
+			return {};
+		}
+		// The menus' language (CremaSettings "language"), before the fonts (their characters).
+		bool languageChosen = false;
+		for (const auto& [key, value] : CremaSettings::GlobalValues())
+			languageChosen = languageChosen || key == "language";
+		std::string suggested = CremaSettings::Get("language");
+		if (!languageChosen)
+		{
+			// PS4 system languages: 0 Japanese, 1 English, 2 French, 3 Spanish, 4 German, 5 Italian,
+			// 6 Dutch, 7 Portuguese, 8 Russian, 9 Korean, 10/11 Chinese, 16 Polish, 17 Portuguese
+			// (Brazil), 18 English (UK), 19 Turkish, 20 Spanish (Latin America), 22 French (Canada).
+			int32_t system = 1;
+			sceSystemServiceParamGetInt(ORBIS_SYSTEM_SERVICE_PARAM_ID_LANG, &system);
+			suggested = system == 0 ? "ja" : system == 2 || system == 22 ? "fr" : system == 3 || system == 20 ? "es" :
+				system == 4 ? "de" : system == 5 ? "it" : system == 6 ? "nl" : system == 7 || system == 17 ? "pt" :
+				system == 8 ? "ru" : system == 9 ? "ko" : system == 10 || system == 11 ? "zh" : system == 16 ? "pl" :
+				system == 19 ? "tr" : "en";
+		}
+		PS4Lang::Load(m_assetsDir, suggested);
+		m_audio.Start();
+		m_input.Open(user);
+		LoadAssets();
+		LoadSources();
+		BuildGames(ScanAllGames());
+		LoadPlayed();
+		ApplyPreferences();
+		BuildItems();
+		// Start on the game played last.
+		auto& games = m_items[(int)Category::Games];
+		for (size_t i = 0; i < games.size(); i++)
+		{
+			if (games[i].game >= 0 && m_games[games[i].game].path == m_prefs.lastGame)
+			{
+				m_selected[(int)Category::Games] = (int)i;
+				m_itemPos[(int)Category::Games] = (float)i;
+			}
+		}
+		m_tabPos = (float)LibraryTab();
+		// The first start: the language list, then the menu style.
+		if (!languageChosen)
+		{
+			OpenSettingPanel(SET_LANGUAGE);
+			m_firstLanguage = true;
+			Log("first start: language list, suggested " + suggested);
+		}
+		else if (m_prefs.style.empty())
+		{
+			OpenSettingPanel(SET_STYLE);
+			m_panel.title = "Choose a Menu Style";
+			m_firstStyle = true;
+		}
+		else
+		{
+			// A game stopped (crashed, or ended itself with an error): why, from the game process
+			// (PS4WindowSystem.cpp: last-stop.txt, its first line the title), shown once, no intro.
+			const std::string notePath = m_dataDir + "/last-stop.txt";
+			const std::string note = ReadFile(notePath);
+			if (!note.empty())
+			{
+				std::vector<std::string> lines;
+				size_t start = 0;
+				while (start < note.size())
+				{
+					const size_t end = note.find('\n', start);
+					lines.push_back(note.substr(start, end == std::string::npos ? std::string::npos : end - start));
+					start = end == std::string::npos ? note.size() : end + 1;
+				}
+				m_panel = SidePanel{};
+				m_panel.open = true;
+				m_panel.title = lines.front();
+				m_panel.lines.assign(lines.begin() + 1, lines.end());
+				m_intro = false;
+				Log("game stopped: " + (lines.size() > 1 ? lines[1] : std::string()));
+				std::error_code ec;
+				fs::remove(notePath, ec);
+			}
+		}
+		Log("menu: " + std::to_string(m_games.size()) + " games, " + std::to_string(m_wallpapers.size()) + " wallpapers");
+		// Updates: packages already installed go from /data/pkg; then GitHub is asked (Settings >
+		// Automatic Updates).
+		m_updatePrefix = CremaUpdater::PackagePrefix(m_assetsDir);
+		CremaUpdater::RemoveOld(m_updatePrefix, m_version);
+		if (m_prefs.autoUpdate)
+			StartUpdateCheck(false);
+		// the newest recommended settings (game-settings.ini) from GitHub
+		m_recommendedThread = std::thread([this] {
+			CremaHttp http(m_assetsDir + "/xmb/cacert.pem");
+			std::string text, error;
+			if (!http.Get(CremaSettings::RecommendedUrl(), &text, &error, 1024 * 1024))
+			{
+				Log("recommended settings: not downloaded (" + error + "), revision " + std::to_string(CremaSettings::RecommendedRevision()) + " in use");
+				return;
+			}
+			std::string message;
+			CremaSettings::InstallRecommended(text, &message);
+			Log("recommended settings: " + message);
+		});
+		// Cemu's community graphic packs, the first time (then the games' Check for Updates).
+		if (CremaGraphicPacks::InstalledVersion(PacksFolder()).empty())
+		{
+			Log("graphic packs: none installed, downloading them in the background");
+			StartPackDownload();
+		}
+		// Covers missing for any game are fetched in the background every time the launcher opens.
+		for (const Game& game : m_games)
+		{
+			if (!game.boxArt && game.product.size() == 6)
+			{
+				Log("covers: downloading the missing ones in the background");
+				StartCoverDownload();
+				break;
+			}
+		}
+
+		auto last = Clock::now();
+		std::string result;
+		// heartbeat: every 5 s for the first minute, then every 30 s (frames drawn, the pad's state)
+		float beatTime = 0.0f, nextBeat = 5.0f;
+		uint32_t beatFrames = 0;
+		for (;;)
+		{
+			const auto frameStart = Clock::now();
+			const auto now = frameStart;
+			const float dt = std::clamp(std::chrono::duration<float>(now - last).count(), 0.0f, 0.1f);
+			last = now;
+			m_time += dt;
+			io.DeltaTime = dt > 0.0f ? dt : 1.0f / 60.0f;
+
+			if (m_intro)
+			{
+				// Any button: straight to the dissolve.
+				if (m_input.Poll(dt) != 0)
+					m_introTime = std::max(m_introTime, 2.6f);
+			}
+			else if (m_keyboard)
+			{
+				// the PS4's keyboard has the controller
+				m_input.Poll(dt);
+				UpdateKeyboard();
+			}
+			else
+			{
+				HandleInput(m_input.Poll(dt));
+			}
+			auto mark = Clock::now();
+			float steps[6] = {};
+			auto step = [&](int i) {
+				const auto t = Clock::now();
+				steps[i] = std::chrono::duration<float>(t - mark).count();
+				mark = t;
+			};
+			step(0);
+			UpdateCoverDownload();
+			step(1);
+			UpdateNetworkCheck();
+			step(2);
+			UpdateUpdater();
+			UpdatePackDownload();
+			step(3);
+
+			m_display.BeginFrame();
+			ImGui::NewFrame();
+			Draw(dt);
+			ImGui::Render();
+			step(4);
+			m_display.EndFrame();
+			step(5);
+
+			const float frame = std::chrono::duration<float>(Clock::now() - frameStart).count();
+			if (frame >= 1.0f)
+				Log(fmt::format("slow frame: {:.1f} s (input {:.1f}, covers {:.1f}, network {:.1f}, updates {:.1f}, draw {:.1f}, present {:.1f})",
+					frame, steps[0], steps[1], steps[2], steps[3], steps[4], steps[5]));
+			beatFrames++;
+			beatTime += frame;
+			if (beatTime >= nextBeat)
+			{
+				Log(fmt::format("alive at {:.0f} s: {} frames since the last line, {}{}{}", beatTime, beatFrames, m_input.Status(),
+					m_panel.open ? ", panel " + m_panel.title : std::string(), m_keyboard ? ", keyboard open" : ""));
+				nextBeat = beatTime < 60.0f ? beatTime + 5.0f : beatTime + 30.0f;
+				beatFrames = 0;
+			}
+
+			if (m_launch >= 0 && m_launchTime >= 0.75f)
+			{
+				result = m_games[m_launch].path;
+				break;
+			}
+		}
+		m_coverCancel = true;
+		if (m_coverThread.joinable())
+			m_coverThread.join();
+		m_packCancel = true;
+		if (m_packThread.joinable())
+			m_packThread.join();
+		if (m_netCheck.joinable())
+			m_netCheck.join();
+		m_updateCancel = true;
+		if (m_updateThread.joinable())
+			m_updateThread.join();
+		if (m_recommendedThread.joinable())
+			m_recommendedThread.join();
+		m_audio.Stop();
+		m_display.Shutdown();
+		ImGui::DestroyContext(context);
+		if (s_log)
+			fclose(s_log);
+		s_log = nullptr;
+		return result;
+	}
+} // namespace
+
+std::string Run(const std::string& dataDir, const std::string& assetsDir, const std::string& version)
+{
+	Menu menu(dataDir, assetsDir, version);
+	return menu.Run();
+}
+
+std::string DefaultGame(const std::string& dataDir)
+{
+	Preferences prefs;
+	prefs.Load(dataDir + "/launcher.ini");
+	return prefs.defaultGame;
+}
+} // namespace CremaLauncher
