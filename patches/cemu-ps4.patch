+
+	void Menu::OpenSettingPanel(int setting)
+	{
+		m_panel = {};
+		m_panel.open = true;
+		m_panel.setting = setting;
+		switch (setting)
+		{
+		case SET_SOUNDS:
+			m_panel.title = "Sound Effects";
+			m_panel.options = {"On", "Off"};
+			m_panel.selected = m_prefs.sounds ? 0 : 1;
+			break;
+		case SET_VOLUME:
+			m_panel.title = "Volume";
+			for (int v = 100; v >= 0; v -= 10)
+				m_panel.options.push_back(std::to_string(v));
+			m_panel.selected = (100 - m_prefs.volume) / 10;
+			break;
+		case SET_LANGUAGE:
+		{
+			m_panel.title = "Language";
+			const auto& languages = PS4Lang::All();
+			for (size_t i = 0; i < languages.size(); i++)
+			{
+				m_panel.options.push_back(languages[i].name);
+				if (std::string(languages[i].code) == PS4Lang::Current().code)
+					m_panel.selected = (int)i;
+			}
+			break;
+		}
+		case SET_STYLE:
+			m_panel.title = "Menu Style";
+			m_panel.options = {"Library", "XMB"};
+			m_panel.selected = Library() ? 0 : 1;
+			m_panel.lines = {"", "Library: your games in a row,", "tabs switched with L1 / R1.", "",
+				"XMB: the PSP-style columns."};
+			break;
+		case SET_CLOCK:
+			m_panel.title = "Clock";
+			m_panel.options = {"On", "Off"};
+			m_panel.selected = m_prefs.clock ? 0 : 1;
+			break;
+		case SET_GAMES_DIR:
+			OpenFolderBrowser(GamesFolder());
+			return;
+		case SET_COVERS:
+			m_panel.title = "Download Covers";
+			if (!m_coverThread.joinable())
+			{
+				// covers that failed or were removed: look again
+				StartCoverDownload();
+			}
+			m_panel.lines = {"", "Connecting to GameTDB..."};
+			break;
+		case SET_RESET_ALL:
+			m_panel.title = "Reset All Settings";
+			m_panel.options = {"Cancel", "Reset everything"};
+			m_panel.lines = {"", "All games, global and per game,", "go back to the default settings."};
+			break;
+		case SET_ABOUT:
+			m_panel.title = "About";
+			m_panel.lines = {"Crema",
+				"Wii U emulator for PS4, based on Cemu",
+				"Ported to PS4 by ShiroKlein",
+				"Version " + m_version,
+				"",
+				"Games: " + GamesFolder(),
+				"Wallpapers (PNG): " + m_dataDir + "/themes",
+				"Sounds (WAV): " + m_dataDir + "/themes/sounds",
+				"Box art (PNG): " + m_dataDir + "/covers/<ID>.png",
+				"",
+				"Cemu is free software (MPL 2.0).",
+				"Menus from Dolphin for PS4 (GPLv2+).",
+				"Fonts: Nunito, Noto Sans (SIL Open Font License)."};
+			break;
+		default:
+			if (setting >= SET_GROUP && setting < SET_GROUP + (int)CremaSettings::Categories().size())
+			{
+				OpenSettingsList(CremaSettings::Categories()[setting - SET_GROUP], {});
+				return;
+			}
+			m_panel.open = false;
+		}
+	}
+
+	// A settings list: one category of the global settings, or every setting of one game (with
+	// "Apply To" first: all games = the game follows the global settings, this game = its own).
+	void Menu::OpenSettingsList(const std::string& category, const std::string& gameId)
+	{
+		m_panel = {};
+		m_panel.open = true;
+		m_panel.category = category;
+		m_panel.gameId = gameId;
+		m_panel.title = category.empty() ? "Game Settings" : category;
+		BuildSettingRows();
+		m_panel.selected = 0;
+		MoveSettingRow(0);
+	}
+
+	void Menu::BuildSettingRows()
+	{
+		std::vector<SettingRow> rows;
+		const std::string& game = m_panel.gameId;
+		if (!game.empty())
+			rows.push_back({"Apply To", CremaSettings::IsCustom(game) ? "This Game" : "All Games", "", false, true});
+		for (const char* category : CremaSettings::Categories())
+		{
+			if (!m_panel.category.empty() && m_panel.category != category)
+				continue;
+			if (m_panel.category.empty())
+				rows.push_back({category, "", "", true});
+			for (const CremaSettings::Setting& setting : CremaSettings::All())
+			{
+				if (std::string(setting.category) != category)
+					continue;
+				// the menus' language is per console, not per game
+				if (!game.empty() && std::string(setting.key) == "language")
+					continue;
+				rows.push_back({setting.label, CremaSettings::LabelOf(setting, CremaSettings::Get(setting.key, game)),
+					setting.key, false, false, !setting.live});
+			}
+		}
+		rows.push_back({"", "", "", true});
+		rows.push_back({game.empty() ? "Reset to Defaults" : "Reset This Game", "", "__reset__"});
+		m_panel.rows = std::move(rows);
+	}
+
+	// Moves the selection by direction (0: onto the nearest selectable row), skipping headers.
+	void Menu::MoveSettingRow(int direction)
+	{
+		const int count = (int)m_panel.rows.size();
+		int row = std::clamp(m_panel.selected + direction, 0, std::max(0, count - 1));
+		const int step = direction < 0 ? -1 : 1;
+		while (row >= 0 && row < count && m_panel.rows[row].header)
+			row += step;
+		if (row >= 0 && row < count)
+			m_panel.selected = row;
+	}
+
+	void Menu::ChangeSettingRow(int direction)
+	{
+		if (m_panel.selected < 0 || m_panel.selected >= (int)m_panel.rows.size())
+			return;
+		const SettingRow& row = m_panel.rows[m_panel.selected];
+		const std::string& game = m_panel.gameId;
+		if (m_panel.setting == SET_GAMES_DIR)
+		{
+			if (direction <= 0)
+				return; // Cross only
+			if (row.key.rfind("dir:", 0) == 0)
+			{
+				OpenFolderBrowser(row.key.substr(4));
+			}
+			else if (row.key == "usedir")
+			{
+				m_prefs.gamesDir = m_browseDir == m_dataDir + "/games" ? "" : m_browseDir;
+				m_prefs.Save(m_dataDir + "/launcher.ini");
+				m_panel.open = false;
+				RefreshGames();
+				Play("confirm");
+			}
+			return;
+		}
+		if (row.scope)
+		{
+			CremaSettings::SetCustom(game, !CremaSettings::IsCustom(game));
+		}
+		else if (row.key == "__reset__")
+		{
+			// A game: it follows the global settings again. A category: its values go back to the
+			// defaults.
+			if (direction <= 0)
+				return;
+			if (!game.empty())
+			{
+				CremaSettings::ResetGame(game);
+			}
+			else
+			{
+				for (const CremaSettings::Setting& setting : CremaSettings::All())
+				{
+					if (m_panel.category == setting.category)
+						CremaSettings::ResetGlobal(setting.key);
+				}
+			}
+		}
+		else if (!row.key.empty())
+		{
+			const CremaSettings::Setting* setting = CremaSettings::Find(row.key);
+			if (!setting)
+				return;
+			// A game following the global settings: changing one of its values makes it custom.
+			if (!game.empty() && !CremaSettings::IsCustom(game))
+				CremaSettings::SetCustom(game, true);
+			CremaSettings::Set(row.key, CremaSettings::Step(*setting, CremaSettings::Get(row.key, game), direction), game);
+			if (row.key == "language")
+				SetLanguage(CremaSettings::Get("language"));
+		}
+		BuildSettingRows();
+	}
+
+	void Menu::ApplySettingOption(int setting, int option)
+	{
+		switch (setting)
+		{
+		case SET_SOUNDS:
+			m_prefs.sounds = option == 0;
+			break;
+		case SET_VOLUME:
+			m_prefs.volume = 100 - option * 10;
+			break;
+		case SET_CLOCK:
+			m_prefs.clock = option == 0;
+			break;
+		case SET_LANGUAGE:
+			if (option >= 0 && option < (int)PS4Lang::All().size())
+				SetLanguage(PS4Lang::All()[option].code);
+			if (m_firstLanguage)
+			{
+				// the first start: then the menu style
+				m_firstLanguage = false;
+				if (m_prefs.style.empty())
+				{
+					ApplyPreferences();
+					BuildItems();
+					OpenSettingPanel(SET_STYLE);
+					m_panel.title = "Choose a Menu Style";
+					m_firstStyle = true;
+					return;
+				}
+			}
+			break;
+		case SET_STYLE:
+			m_prefs.style = option == 0 ? "library" : "xmb";
+			m_firstStyle = false;
+			m_tabPos = (float)LibraryTab();
+			Log("menu style: " + m_prefs.style);
+			break;
+		case SET_RESET_ALL:
+			if (option == 1)
+				CremaSettings::ResetAll();
+			return;
+		default:
+			return;
+		}
+		ApplyPreferences();
+		BuildItems();
+	}
+
+	void Menu::HandleInput(uint32_t pressed)
+	{
+		if (m_launch >= 0 || pressed == 0)
+			return;
+
+		if (m_panel.open)
+		{
+			if (pressed & BTN_CIRCLE)
+			{
+				// The first start's lists closed without a choice: the highlighted one.
+				if ((m_firstLanguage && m_panel.setting == SET_LANGUAGE) || (m_firstStyle && m_panel.setting == SET_STYLE))
+				{
+					ApplySettingOption(m_panel.setting, m_panel.selected);
+					if (m_panel.setting == SET_STYLE && m_firstStyle)
+						return; // the menu style list opened next
+				}
+				m_panel.open = false;
+				Play("back");
+				return;
+			}
+			if (!m_panel.rows.empty())
+			{
+				// Settings list: Up/Down pick, Left/Right (or Cross) change the value.
+				if (pressed & BTN_UP)
+				{
+					MoveSettingRow(-1);
+					Play("move");
+				}
+				if (pressed & BTN_DOWN)
+				{
+					MoveSettingRow(1);
+					Play("move");
+				}
+				if (pressed & (BTN_LEFT | BTN_RIGHT | BTN_CROSS))
+				{
+					ChangeSettingRow((pressed & BTN_LEFT) ? -1 : 1);
+					Play("category");
+				}
+				return;
+			}
+			if (m_panel.options.empty())
+			{
+				if (pressed & BTN_CROSS)
+				{
+					m_panel.open = false;
+					Play("back");
+				}
+				return;
+			}
+			const int count = (int)m_panel.options.size();
+			if ((pressed & BTN_UP) && m_panel.selected > 0)
+			{
+				m_panel.selected--;
+				Play("move");
+			}
+			if ((pressed & BTN_DOWN) && m_panel.selected < count - 1)
+			{
+				m_panel.selected++;
+				Play("move");
+			}
+			if (pressed & BTN_CROSS)
+			{
+				if (m_panel.setting >= 0)
+				{
+					const int setting = m_panel.setting;
+					const bool firstLanguage = m_firstLanguage;
+					ApplySettingOption(setting, m_panel.selected);
+					if (setting == SET_LANGUAGE && firstLanguage && m_firstStyle)
+					{
+						Play("confirm");
+						return; // the menu style list is open now
+					}
+				}
+				else if (m_panel.title == "Game")
+				{
+					const Item& item = m_items[m_category][m_selected[m_category]];
+					const Game& game = m_games[item.game];
+					const std::string& choice = m_panel.options[m_panel.selected];
+					if (choice == "Start")
+					{
+						m_panel.open = false;
+						ActivateItem(item);
+						return;
+					}
+					if (choice == "Game Settings")
+					{
+						OpenSettingsList({}, game.id);
+						Play("confirm");
+						return;
+					}
+					if (choice == "Information")
+					{
+						m_panel.title = "Information";
+						m_panel.options.clear();
+						m_panel.lines = {game.title, "", game.homebrew ? "Homebrew" : "Title ID: " + game.id};
+						if (!game.homebrew)
+						{
+							m_panel.lines.push_back("Version: v" + std::to_string(game.version));
+							if (!game.region.empty())
+								m_panel.lines.push_back("Region: " + game.region);
+							if (!game.product.empty())
+								m_panel.lines.push_back("Product code: " + game.product);
+						}
+						m_panel.lines.push_back("Format: " + game.format);
+						m_panel.lines.push_back("File: " + fs::path(game.path).filename().string());
+						Play("confirm");
+						return;
+					}
+					// Set / Remove as Default Game: one default game; the same game again removes it.
+					const bool remove = m_prefs.defaultGame == game.path;
+					m_prefs.defaultGame = remove ? "" : game.path;
+					m_prefs.Save(m_dataDir + "/launcher.ini");
+					Log(remove ? "default game removed" : "default game: " + game.path);
+					BuildItems();
+					m_panel.title = remove ? "Remove Default Game" : "Set as Default Game";
+					m_panel.options.clear();
+					if (remove)
+						m_panel.lines = {"", "No game starts by itself anymore."};
+					else
+						m_panel.lines = {"", game.title, "", "starts when Crema opens.", "", "Hold L1 while Crema starts",
+							"to open the menu instead."};
+					Play("confirm");
+					return;
+				}
+				m_panel.open = false;
+				Play("confirm");
+			}
+			return;
+		}
+
+		auto& items = m_items[m_category];
+		int& selected = m_selected[m_category];
+		const int count = (int)items.size();
+		const bool games = m_category == (int)Category::Games;
+		// XMB: Left / Right switch the columns, Up / Down the items, L1 / R1 jump five.
+		// Library: L1 / R1 switch the tabs; the games scroll sideways, the other tabs up and down.
+		int prevCategory = m_category > 0 ? m_category - 1 : -1;
+		int nextCategory = m_category < CATEGORY_COUNT - 1 ? m_category + 1 : -1;
+		uint32_t prevTab = BTN_LEFT, nextTab = BTN_RIGHT, prevItem = BTN_UP, nextItem = BTN_DOWN;
+		uint32_t prevPage = BTN_L1, nextPage = BTN_R1;
+		if (Library())
+		{
+			const int tab = LibraryTab();
+			prevCategory = tab > 0 ? (int)TABS[tab - 1] : -1;
+			nextCategory = tab < TAB_COUNT - 1 ? (int)TABS[tab + 1] : -1;
+			prevTab = BTN_L1;
+			nextTab = BTN_R1;
+			prevItem = games ? BTN_LEFT : BTN_UP;
+			nextItem = games ? BTN_RIGHT : BTN_DOWN;
+			prevPage = nextPage = 0;
+		}
+		if ((pressed & prevTab) && prevCategory >= 0)
+		{
+			m_category = prevCategory;
+			Play("category");
+		}
+		else if ((pressed & nextTab) && nextCategory >= 0)
+		{
+			m_category = nextCategory;
+			Play("category");
+		}
+		else if ((pressed & prevItem) && selected > 0)
+		{
+			selected--;
+			Play("move");
+		}
+		else if ((pressed & nextItem) && selected < count - 1)
+		{
+			selected++;
+			Play("move");
+		}
+		else if ((pressed & prevPage) && selected > 0)
+		{
+			selected = std::max(0, selected - 5);
+			Play("move");
+		}
+		else if ((pressed & nextPage) && selected < count - 1)
+		{
+			selected = std::min(count - 1, selected + 5);
+			Play("move");
+		}
+		else if (pressed & BTN_CROSS)
+		{
+			if (!items.empty())
+				ActivateItem(items[selected]);
+		}
+		else if ((pressed & BTN_SQUARE) && games)
+		{
+			RefreshGames();
+			Play("confirm");
+		}
+		else if ((pressed & BTN_OPTIONS) && games && Library())
+		{
+			// The next game order; the selected game stays selected.
+			size_t sort = 0;
+			while (sort < std::size(SORT_NAMES) && m_prefs.sort != SORT_NAMES[sort][0])
+				sort++;
+			m_prefs.sort = SORT_NAMES[(sort + 1) % std::size(SORT_NAMES)][0];
+			m_prefs.Save(m_dataDir + "/launcher.ini");
+			const int game = items.empty() ? -1 : items[selected].game;
+			BuildItems();
+			const auto& sorted = m_items[m_category];
+			for (size_t i = 0; i < sorted.size(); i++)
+			{
+				if (game >= 0 && sorted[i].game == game)
+					m_selected[m_category] = (int)i;
+			}
+			m_itemPos[m_category] = (float)m_selected[m_category];
+			m_sortShown = 2.5f;
+			Play("category");
+		}
+		else if (pressed & BTN_TRIANGLE)
+		{
+			if (!items.empty() && items[selected].game >= 0)
+			{
+				const Game& game = m_games[items[selected].game];
+				m_panel = {};
+				m_panel.open = true;
+				m_panel.title = "Game";
+				m_panel.options = {"Start"};
+				if (!game.homebrew)
+					m_panel.options.push_back("Game Settings");
+				m_panel.options.push_back("Information");
+				m_panel.options.push_back(m_prefs.defaultGame == game.path ? "Remove Default Game" : "Set as Default Game");
+				Play("menu");
+			}
+		}
+		else if (pressed & BTN_CIRCLE)
+		{
+			Play("back");
+		}
+	}
+
+	// Cross on an item (both styles).
+	void Menu::ActivateItem(const Item& item)
+	{
+		if (item.game >= 0)
+		{
+			m_launch = item.game;
+			m_launchTime = 0.0f;
+			m_prefs.lastGame = m_games[item.game].path;
+			m_prefs.Save(m_dataDir + "/launcher.ini");
+			m_played[m_games[item.game].path] = (int64_t)std::time(nullptr);
+			SavePlayed();
+			Play("launch");
+		}
+		else if (item.setting >= 0)
+		{
+			OpenSettingPanel(item.setting);
+			Play("menu");
+		}
+		else if (item.theme != -1)
+		{
+			if (item.theme >= 0)
+			{
+				m_prefs.theme = THEMES[item.theme].name;
+				m_prefs.wallpaper.clear();
+			}
+			else
+			{
+				m_prefs.wallpaper = m_wallpapers[-2 - item.theme];
+			}
+			ApplyPreferences();
+			BuildItems();
+			Play("confirm");
+		}
+		else
+		{
+			Play("error");
+		}
+	}
+
+	int Menu::LibraryTab() const
+	{
+		for (int i = 0; i < TAB_COUNT; i++)
+		{
+			if ((int)TABS[i] == m_category)
+				return i;
+		}
+		return 0;
+	}
+
+	std::string Menu::SortName() const
+	{
+		for (const auto& [key, name] : SORT_NAMES)
+		{
+			if (m_prefs.sort == key)
+				return name;
+		}
+		return SORT_NAMES[0][1];
+	}
+
+	// data_dir/played.ini: "<Unix time> <game path>" per line.
+	void Menu::LoadPlayed()
+	{
+		std::ifstream file(m_dataDir + "/played.ini");
+		std::string line;
+		while (std::getline(file, line))
+		{
+			while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+				line.pop_back();
+			const size_t space = line.find(' ');
+			if (space != std::string::npos && space > 0)
+				m_played[line.substr(space + 1)] = std::atoll(line.c_str());
+		}
+	}
+
+	void Menu::SavePlayed() const
+	{
+		std::ofstream file(m_dataDir + "/played.ini", std::ios::trunc);
+		for (const auto& [path, when] : m_played)
+			file << when << ' ' << path << '\n';
+	}
+
+	void Menu::Text(ImDrawList* dl, ImFont* font, float size, ImVec2 pos, ImU32 color, const std::string& text, bool shadow)
+	{
+		// Every text is drawn in the chosen language (PS4Lang); TextWidth measures the same text.
+		const char* shown = PS4Lang::T(text).c_str();
+		if (shadow)
+		{
+			const ImU32 shade = IM_COL32(0, 0, 0, (color >> IM_COL32_A_SHIFT) * 90 / 255);
+			dl->AddText(font, size, ImVec2(pos.x + 2, pos.y + 2), shade, shown);
+		}
+		dl->AddText(font, size, pos, color, shown);
+	}
+
+	// Line breaks for a width: at the last space that fits, or between any two characters when a
+	// line has no space (Japanese and Chinese are written without them).
+	std::string Menu::WrapText(ImFont* font, float size, const std::string& text, float width)
+	{
+		std::string out;
+		std::string line;
+		size_t lastSpace = std::string::npos;
+		auto widthOf = [&](const std::string& t) { return font->CalcTextSizeA(size, FLT_MAX, 0.0f, t.c_str()).x; };
+		for (size_t i = 0; i < text.size();)
+		{
+			const unsigned char lead = (unsigned char)text[i];
+			const size_t length = lead < 0x80 ? 1 : (lead >> 5) == 6 ? 2 : (lead >> 4) == 14 ? 3 : 4;
+			const std::string ch = text.substr(i, length);
+			i += length;
+			if (ch == "\n")
+			{
+				out += line + "\n";
+				line.clear();
+				lastSpace = std::string::npos;
+				continue;
+			}
+			if (widthOf(line + ch) > width && !line.empty())
+			{
+				if (ch == " ")
+				{
+					out += line + "\n";
+					line.clear();
+					lastSpace = std::string::npos;
+					continue;
+				}
+				if (lastSpace != std::string::npos)
+				{
+					out += line.substr(0, lastSpace) + "\n";
+					line = line.substr(lastSpace + 1);
+				}
+				else
+				{
+					out += line + "\n";
+					line.clear();
+				}
+				lastSpace = std::string::npos;
+			}
+			if (ch == " ")
+				lastSpace = line.size();
+			line += ch;
+		}
+		return out + line;
+	}
+
+	float Menu::TextWidth(ImFont* font, float size, const std::string& text)
+	{
+		return font->CalcTextSizeA(size, FLT_MAX, 0.0f, PS4Lang::T(text).c_str()).x;
+	}
