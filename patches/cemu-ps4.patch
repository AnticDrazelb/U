+#ifdef __ORBIS__
+// PS4: fatal signals are handled by the port's crash log (port/ps4_crashlog.cpp: registers and a
+// stack scan with ELF-relative addresses in /data/Crema/crash.log); there is no execinfo.
+#include "ExceptionHandler.h"
+void ExceptionHandler_Init()
+{
+}
+
+#include "Cafe/HW/Espresso/PPCState.h"
+#include "Cafe/HW/MMU/MMU.h"
+#include "Cafe/OS/libs/coreinit/coreinit_Thread.h"
+#include <unistd.h>
+
+// Called by the port's crash handler while it writes crash.log (fd): the crashed thread's PPC
+// registers and the return addresses on its guest stack. No locks and no allocation: the full
+// report below (ps4_crash_guest_info) can deadlock on a lock another thread held at the crash.
+extern "C" void ps4_crash_guest_regs(int fd)
+{
+	char line[200];
+	auto out = [&](int n) {
+		if (n > 0)
+			write(fd, line, std::min<size_t>((size_t)n, sizeof(line) - 1));
+	};
+	PPCInterpreter_t* hCPU = PPCInterpreter_getCurrentInstance();
+	if (!hCPU)
+	{
+		out(snprintf(line, sizeof(line), "guest: no PPC thread on this host thread\n"));
+		return;
+	}
+	out(snprintf(line, sizeof(line), "guest: IP %08x LR %08x (the IP is only updated at calls into the OS)\n", hCPU->instructionPointer, hCPU->spr.LR));
+	for (int i = 0; i < 32; i += 8)
+		out(snprintf(line, sizeof(line), "guest: r%-2d %08x %08x %08x %08x %08x %08x %08x %08x\n", i, hCPU->gpr[i], hCPU->gpr[i + 1],
+			hCPU->gpr[i + 2], hCPU->gpr[i + 3], hCPU->gpr[i + 4], hCPU->gpr[i + 5], hCPU->gpr[i + 6], hCPU->gpr[i + 7]));
+	// the back chain from r1: each frame's first word is the caller's frame, its second the
+	// return address
+	int n = snprintf(line, sizeof(line), "guest: return addresses");
+	uint32 sp = hCPU->gpr[1];
+	for (int i = 0; i < 16 && sp >= 0x01000000 && sp < 0xF0000000 && (sp & 3) == 0 && n < 180; i++)
+	{
+		const uint32 next = memory_readU32(sp);
+		if (next <= sp || next >= 0xF0000000)
+			break;
+		n += snprintf(line + n, sizeof(line) - n, " %08x", memory_readU32(next + 4));
+		sp = next;
+	}
+	n += snprintf(line + n, sizeof(line) - n, "\n");
+	out(n);
+	// the game's code around LR (where the crashed function last called out) and its callers'
+	// return addresses, to disassemble offline (llvm-objdump --triple=powerpc), as the game's
+	// files may be encrypted on the console only
+	uint32 addresses[4] = {hCPU->spr.LR, 0, 0, 0};
+	sp = hCPU->gpr[1];
+	for (int i = 1; i < 4 && sp >= 0x01000000 && sp < 0xF0000000 && (sp & 3) == 0; i++)
+	{
+		const uint32 next = memory_readU32(sp);
+		if (next <= sp || next >= 0xF0000000)
+			break;
+		addresses[i] = memory_readU32(next + 4);
+		sp = next;
+	}
+	for (uint32 address : addresses)
+	{
+		if (address < 0x01000000 || address >= 0x10000000 || (address & 3))
+			continue;
+		const uint32 start = address - 0x40;
+		for (uint32 at = start; at < address + 0xC0; at += 0x20)
+			out(snprintf(line, sizeof(line), "guest code %08x: %08x %08x %08x %08x %08x %08x %08x %08x\n", at, memory_readU32(at),
+				memory_readU32(at + 4), memory_readU32(at + 8), memory_readU32(at + 12), memory_readU32(at + 16), memory_readU32(at + 20),
+				memory_readU32(at + 24), memory_readU32(at + 28)));
+	}
+}
