+		{kButton10, "R1", "R1"}, {kButton11, "Pad N", "D-Pad Up"}, {kButton12, "Pad S", "D-Pad Down"},
+		{kButton13, "Pad W", "D-Pad Left"}, {kButton14, "Pad E", "D-Pad Right"}, {kTriggerXP, "L2 Click", "L2"},
