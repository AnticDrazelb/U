+extern "C" void ps4_jit_dump_function(int fd, uint32 ppcStart, uint64 x86Start, uint32 samples)
+{
+	const uint32 count = s_cremaJitNext.load(std::memory_order_acquire);
+	const uint32 total = std::min(count, kCremaJitRanges);
+	for (uint32 i = 0; i < total; i++)
+	{
+		const CremaJitRange& r = s_cremaJitRanges[(count - 1 - i) % kCremaJitRanges];
+		if (r.x86Start.load(std::memory_order_acquire) != x86Start || r.ppcStart.load(std::memory_order_relaxed) != ppcStart)
+			continue;
+		const uint32 ppcSize = std::min<uint32>(r.ppcSize.load(std::memory_order_relaxed), 0x10000);
+		const uint32 x86Size = std::min<uint32>(r.x86Size.load(std::memory_order_relaxed), 0x40000);
+		if (!memory_isAddressRangeAccessible(ppcStart, ppcSize))
+			return;
+		const uint32 header[5] = {0x434e4648, ppcStart, ppcSize, x86Size, samples}; // "HFNC"
+		write(fd, header, sizeof(header));
+		write(fd, &x86Start, sizeof(x86Start));
+		write(fd, memory_base + ppcStart, ppcSize);
+		static uint8 copy[0x40000];
+		memcpy(copy, (const void*)x86Start, x86Size);
+		write(fd, copy, x86Size);
+		return;
+	}
