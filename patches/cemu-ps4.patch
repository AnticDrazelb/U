+	// A game's graphic packs: settings rows (CremaGraphicPacks::Rows), changed with Left / Right / Cross.
+	void Menu::OpenGamePacks(std::string gameId, std::string title)
+	{
+		m_panel = {};
+		m_panel.open = true;
+		m_panel.setting = SET_GAME_PACKS;
+		m_panel.gameId = gameId;
+		m_panel.title = "Graphic Packs";
+		m_packTitle = title;
+		const std::string installed = CremaGraphicPacks::InstalledVersion(PacksFolder());
+		if (installed.empty() || m_packThread.joinable())
+		{
+			// not here yet (the first time): downloaded now, then the list (UpdatePackDownload)
+			StartPackDownload();
+			m_panel.lines = {"", title, "", "Getting Cemu's community graphic packs..."};
+			return;
+		}
+		for (const CremaGraphicPacks::Row& pack : CremaGraphicPacks::Rows(gameId))
+		{
+			SettingRow row{pack.label, pack.value, pack.key, pack.header};
+			row.help = pack.help;
+			row.note = pack.value == "On";
+			m_panel.rows.push_back(row);
+		}
+		if (m_panel.rows.empty())
+			m_panel.rows.push_back({"No graphic packs for this game in " + installed, "", "", true});
+		m_panel.rows.push_back({"", "", "", true});
+		SettingRow update{"Check for Updates", installed, "__packs_update__"};
+		update.help = (m_packNote.empty() ? std::string() : m_packNote + " ") +
+			"Cross: download the newest community graphic packs (github.com/cemu-project/cemu_graphic_packs).";
+		m_panel.rows.push_back(update);
+		MoveSettingRow(0);
+	}
