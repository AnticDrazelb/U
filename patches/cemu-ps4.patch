+		{kTriggerYP, "R2 Click", "R2"}, {kAxisYN, "Left Y-", "Left Stick Up"}, {kAxisYP, "Left Y+", "Left Stick Down"},
+		{kAxisXN, "Left X-", "Left Stick Left"}, {kAxisXP, "Left X+", "Left Stick Right"},
