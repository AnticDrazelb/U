diff --git a/src/gui/ps4/launcher/CremaCovers.cpp b/src/gui/ps4/launcher/CremaCovers.cpp
new file mode 100644
index 0000000..3dbd2af
--- /dev/null
+++ b/src/gui/ps4/launcher/CremaCovers.cpp
@@ -0,0 +1,226 @@
+#include "gui/ps4/launcher/CremaCovers.h"
+
+#include <cstdio>
+#include <sys/stat.h>
+
+#include <curl/curl.h>
+#include <orbis/Net.h>
+#include <orbis/Sysmodule.h>
+
+extern "C" void ps4_boot_trace(const char* line); // port/ps4_crashlog.cpp
+
+namespace CremaCovers
+{
+namespace
+{
+	constexpr const char* HOST = "art.gametdb.com";
+
+	void Log(const std::string& text)
+	{
+		ps4_boot_trace(("covers: " + text).c_str());
+	}
+
+	bool Exists(const std::string& path)
+	{
+		struct stat st;
+		return stat(path.c_str(), &st) == 0 && st.st_size > 0;
+	}
+
+	// The PS4's network: libSceNet and its resolver (the C library's getaddrinfo has no DNS
+	// configuration on the PS4). Returns the host's address as text, or empty.
+	std::string ResolveHost(const char* HOST, std::string* error)
+	{
+		static bool s_net = false;
+		static int s_pool = -1;
+		if (!s_net)
+		{
+			sceSysmoduleLoadModuleInternal(ORBIS_SYSMODULE_INTERNAL_NET);
+			const int init = sceNetInit();
+			s_pool = sceNetPoolCreate("crema-covers", 64 * 1024, 0);
+			Log(fmt::format("network: init {:#x}, pool {:#x}", (unsigned)init, (unsigned)s_pool));
+			s_net = true;
+		}
+		const OrbisNetId resolver = sceNetResolverCreate("crema-covers", s_pool, 0);
+		if (resolver < 0)
+		{
+			*error = "the PS4 network is not available";
+			return {};
+		}
+		OrbisNetInAddr address = {};
+		const int result = sceNetResolverStartNtoa(resolver, HOST, &address, 5 * 1000 * 1000, 2, 0);
+		sceNetResolverDestroy(resolver);
+		if (result < 0)
+		{
+			*error = fmt::format("could not look up {} ({:#x}): is the PS4 online?", HOST, (unsigned)result);
+			return {};
+		}
+		const uint32_t a = address.s_addr; // network byte order
+		return fmt::format("{}.{}.{}.{}", a & 0xFF, (a >> 8) & 0xFF, (a >> 16) & 0xFF, (a >> 24) & 0xFF);
+	}
+
+	size_t Append(char* data, size_t size, size_t count, void* user)
+	{
+		static_cast<std::string*>(user)->append(data, size * count);
+		return size * count;
+	}
+
+	// GET url into body; returns the HTTP status (0: no answer).
+	long Fetch(CURL* curl, const std::string& url, std::string* body, std::string* error)
+	{
+		body->clear();
+		char detail[CURL_ERROR_SIZE] = {};
+		curl_easy_setopt(curl, CURLOPT_ERRORBUFFER, detail);
+		curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
+		curl_easy_setopt(curl, CURLOPT_WRITEDATA, body);
+		CURLcode code = curl_easy_perform(curl);
+		if (code == CURLE_PEER_FAILED_VERIFICATION || code == CURLE_SSL_CACERT_BADFILE || code == CURLE_SSL_CERTPROBLEM)
+		{
+			// The PS4's TLS setup can reject GameTDB's certificate chain. Covers are public pictures
+			// (checked to be JPEGs before they are saved): fetch them without the check.
+			static bool s_logged = false;
+			if (!s_logged)
+			{
+				Log(std::string("certificate check failed (") + detail + "), downloading without it");
+				s_logged = true;
+			}
+			curl_easy_setopt(curl, CURLOPT_SSL_VERIFYPEER, 0L);
+			curl_easy_setopt(curl, CURLOPT_SSL_VERIFYHOST, 0L);
+			body->clear();
+			code = curl_easy_perform(curl);
+		}
+		if (code != CURLE_OK)
+		{
+			*error = std::string(curl_easy_strerror(code)) + (detail[0] ? std::string(": ") + detail : "");
+			return 0;
+		}
+		long status = 0;
+		curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &status);
+		return status;
+	}
+
+	// GameTDB's regions for an ID's region letter (4th character), most likely first.
+	std::vector<const char*> Regions(const std::string& id)
+	{
+		const char region = id.size() >= 4 ? id[3] : 'E';
+		switch (region)
+		{
+		case 'E':
+		case 'N':
+			return {"US", "EN"};
+		case 'J':
+			return {"JA", "US"};
+		case 'K':
+		case 'Q':
+		case 'T':
+			return {"KO", "US"};
+		case 'D':
+			return {"DE", "EN", "US"};
+		case 'F':
+			return {"FR", "EN", "US"};
+		case 'S':
+			return {"ES", "EN", "US"};
+		case 'I':
+			return {"IT", "EN", "US"};
+		case 'H':
+			return {"NL", "EN", "US"};
+		case 'R':
+			return {"RU", "EN", "US"};
+		default: // P, X, Y, ...: PAL
+			return {"EN", "US"};
+		}
+	}
+} // namespace
+
+std::string Resolve(const std::string& host, std::string* error)
+{
+	return ResolveHost(host.c_str(), error);
+}
+
+Result Download(const std::vector<std::string>& ids, const std::string& coversDir, const std::string& caFile,
+	const std::function<void(int, int, const std::string&)>& progress, const std::atomic<bool>& cancel)
+{
+	Result result;
+	mkdir(coversDir.c_str(), 0777);
+
+	std::vector<std::string> missing;
+	for (const std::string& id : ids)
+	{
+		if (id.size() != 6)
+			continue;
+		if (Exists(coversDir + "/" + id + ".png") || Exists(coversDir + "/" + id + ".jpg"))
+			result.already++;
+		else
+			missing.push_back(id);
+	}
+	if (missing.empty())
+		return result;
+
+	const std::string address = ResolveHost(HOST, &result.error);
+	if (address.empty())
+	{
+		result.failed = (int)missing.size();
+		Log(result.error);
+		return result;
+	}
+	Log(std::string(HOST) + " is " + address);
+
+	curl_global_init(CURL_GLOBAL_DEFAULT);
+	CURL* curl = curl_easy_init();
+	const std::string resolve = std::string(HOST) + ":443:" + address;
+	curl_slist* resolves = curl_slist_append(nullptr, resolve.c_str());
+	curl_easy_setopt(curl, CURLOPT_RESOLVE, resolves);
+	curl_easy_setopt(curl, CURLOPT_CAINFO, caFile.c_str());
+	curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);
+	curl_easy_setopt(curl, CURLOPT_TIMEOUT, 20L);
+	curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT, 10L);
+	curl_easy_setopt(curl, CURLOPT_USERAGENT, "Crema-PS4");
+	curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, Append);
+	curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);
+
+	for (size_t i = 0; i < missing.size() && !cancel; i++)
+	{
+		const std::string& id = missing[i];
+		progress((int)i, (int)missing.size(), id);
+		bool saved = false, answered = false;
+		std::string body, error;
+		for (const char* region : Regions(id))
+		{
+			const std::string url = "https://" + std::string(HOST) + "/wiiu/cover/" + region + "/" + id + ".jpg";
+			const long status = Fetch(curl, url, &body, &error);
+			if (status == 0)
+				break; // network trouble: don't try the other regions
+			answered = true;
+			if (status == 200 && body.size() > 4 && (uint8_t)body[0] == 0xFF && (uint8_t)body[1] == 0xD8)
+			{
+				const std::string path = coversDir + "/" + id + ".jpg";
+				if (FILE* file = fopen(path.c_str(), "wb"))
+				{
+					fwrite(body.data(), 1, body.size(), file);
+					fclose(file);
+					saved = true;
+				}
+				break;
+			}
+		}
+		if (saved)
+		{
+			result.downloaded++;
+		}
+		else if (answered)
+		{
+			result.notFound++;
+			Log("no cover for " + id);
+		}
+		else
+		{
+			result.failed++;
+			result.error = error;
+			Log("download failed for " + id + ": " + error);
+		}
+	}
+	progress((int)missing.size(), (int)missing.size(), {});
+	curl_slist_free_all(resolves);
+	curl_easy_cleanup(curl);
+	return result;
+}
+} // namespace CremaCovers
diff --git a/src/gui/ps4/launcher/CremaCovers.h b/src/gui/ps4/launcher/CremaCovers.h
new file mode 100644
index 0000000..3bacd01
--- /dev/null
+++ b/src/gui/ps4/launcher/CremaCovers.h
@@ -0,0 +1,30 @@
+// Box art for the launcher (from DolphinPS4's PS4Covers), downloaded from GameTDB for the games
+// the user has, into /data/Crema/covers/<ID>.jpg. IDs are GameTDB's Wii U ones: the product code
+// from meta.xml and the company code (ARDE01 = Super Mario 3D World, USA). A <ID>.png the user puts
+// there is used instead.
+#pragma once
+
+#include <atomic>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace CremaCovers
+{
+struct Result
+{
+	int downloaded = 0;
+	int already = 0;   // a cover was there already
+	int notFound = 0;  // GameTDB has none for the ID
+	int failed = 0;
+	std::string error; // why the last download failed (network, ...)
+};
+
+// A host's IPv4 address as text through the PS4's resolver (for CURLOPT_RESOLVE), or empty with
+// the reason in error.
+std::string Resolve(const std::string& host, std::string* error);
+
+// Downloads the missing covers. progress(done, total, id) is called before each game.
+Result Download(const std::vector<std::string>& ids, const std::string& coversDir, const std::string& caFile,
+	const std::function<void(int, int, const std::string&)>& progress, const std::atomic<bool>& cancel);
+} // namespace CremaCovers
diff --git a/src/gui/ps4/launcher/CremaGraphicPacks.cpp b/src/gui/ps4/launcher/CremaGraphicPacks.cpp
new file mode 100644
index 0000000..328deb2
--- /dev/null
+++ b/src/gui/ps4/launcher/CremaGraphicPacks.cpp
@@ -0,0 +1,367 @@
+#include "gui/ps4/launcher/CremaGraphicPacks.h"
+#include "gui/ps4/launcher/CremaCovers.h"
+#include "gui/ps4/launcher/CremaHttp.h"
+
+#include "Cafe/GraphicPack/GraphicPack2.h"
+#include "config/CemuConfig.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <set>
+
+#include <curl/curl.h>
+#include <rapidjson/document.h>
+#include <zip.h>
+
+extern "C" void ps4_boot_trace(const char* line); // port/ps4_crashlog.cpp
+
+namespace CremaGraphicPacks
+{
+namespace
+{
+	constexpr const char* RELEASE_URL = "https://api.github.com/repos/cemu-project/cemu_graphic_packs/releases/latest";
+
+	void Log(const std::string& text)
+	{
+		ps4_boot_trace(("graphic packs: " + text).c_str());
+	}
+
+	// "Downloading: 1.5 of 9.0 MB" every 256 KiB of the zip (the release information is a few KiB)
+	struct Progress
+	{
+		const std::function<void(const std::string&)>* status;
+		const std::atomic<bool>* cancel;
+		uint64_t shown = ~0ull;
+
+		bool operator()(uint64_t now, uint64_t total)
+		{
+			if (*cancel)
+				return false;
+			if (now > 1024 * 1024 && now / (256 * 1024) != shown)
+			{
+				shown = now / (256 * 1024);
+				(*status)(total > 0 ? fmt::format("Downloading: {:.1f} of {:.1f} MB", now / 1048576.0, total / 1048576.0) :
+					fmt::format("Downloading: {:.1f} MB", now / 1048576.0));
+			}
+			return true;
+		}
+	};
+
+	// Replaces folder's contents with the zip's files; returns how many were written.
+	int Extract(const std::string& data, const std::string& folder, std::string* error)
+	{
+		zip_error_t zerror;
+		zip_error_init(&zerror);
+		zip_source_t* source = zip_source_buffer_create(data.data(), data.size(), 0, &zerror);
+		zip_t* zip = source ? zip_open_from_source(source, ZIP_RDONLY, &zerror) : nullptr;
+		if (!zip)
+		{
+			*error = std::string("not a zip file: ") + zip_error_strerror(&zerror);
+			if (source)
+				zip_source_free(source);
+			zip_error_fini(&zerror);
+			return -1;
+		}
+		std::error_code ec;
+		fs::create_directories(_utf8ToPath(folder), ec);
+		for (const auto& entry : fs::directory_iterator(_utf8ToPath(folder), ec))
+			fs::remove_all(entry.path(), ec);
+		int files = 0;
+		std::vector<char> buffer;
+		const zip_int64_t count = zip_get_num_entries(zip, 0);
+		for (zip_int64_t i = 0; i < count; i++)
+		{
+			zip_stat_t stat;
+			zip_stat_init(&stat);
+			if (zip_stat_index(zip, i, 0, &stat) != 0 || !stat.name || !stat.name[0])
+				continue;
+			const std::string name = stat.name;
+			if (name[0] == '/' || name.find("..") != std::string::npos || name.find('\\') != std::string::npos)
+				continue; // outside the folder
+			const fs::path path = _utf8ToPath(folder + "/" + name);
+			if (name.back() == '/')
+			{
+				fs::create_directories(path, ec);
+				continue;
+			}
+			if (stat.size > 64 * 1024 * 1024)
+				continue;
+			fs::create_directories(path.parent_path(), ec);
+			zip_file_t* file = zip_fopen_index(zip, i, 0);
+			if (!file)
+				continue;
+			buffer.resize((size_t)stat.size);
+			const bool read = zip_fread(file, buffer.data(), stat.size) == (zip_int64_t)stat.size;
+			zip_fclose(file);
+			if (!read)
+				continue;
+			if (FILE* out = fopen(_pathToUtf8(path).c_str(), "wb"))
+			{
+				fwrite(buffer.data(), 1, buffer.size(), out);
+				fclose(out);
+				files++;
+			}
+		}
+		zip_discard(zip);
+		zip_error_fini(&zerror);
+		return files;
+	}
+
+	bool ForTitle(const GraphicPack2& pack, uint64 titleId)
+	{
+		const auto& ids = pack.GetTitleIds();
+		return std::find(ids.begin(), ids.end(), titleId) != ids.end();
+	}
+
+	std::vector<std::shared_ptr<GraphicPack2>> PacksOf(const std::string& titleId)
+	{
+		std::vector<std::shared_ptr<GraphicPack2>> packs;
+		uint64 id = 0;
+		if (titleId.size() != 16 || sscanf(titleId.c_str(), "%llx", (unsigned long long*)&id) != 1)
+			return packs;
+		for (const auto& pack : GraphicPack2::GetGraphicPacks())
+		{
+			if (ForTitle(*pack, id))
+				packs.push_back(pack);
+		}
+		std::sort(packs.begin(), packs.end(), [](const auto& a, const auto& b) { return a->GetVirtualPath() < b->GetVirtualPath(); });
+		return packs;
+	}
+
+	std::shared_ptr<GraphicPack2> PackAt(const std::string& index)
+	{
+		const auto& packs = GraphicPack2::GetGraphicPacks();
+		const size_t i = (size_t)std::strtoul(index.c_str(), nullptr, 10);
+		return i < packs.size() ? packs[i] : nullptr;
+	}
+
+	size_t IndexOf(const std::shared_ptr<GraphicPack2>& pack)
+	{
+		const auto& packs = GraphicPack2::GetGraphicPacks();
+		return (size_t)(std::find(packs.begin(), packs.end(), pack) - packs.begin());
+	}
+
+	std::string OneLine(std::string text)
+	{
+		for (char& c : text)
+		{
+			if (c == '\n' || c == '\r' || c == '\t')
+				c = ' ';
+		}
+		return text;
+	}
+
+	// Cemu's GraphicPacksWindow2::SaveStateToConfig
+	void Save()
+	{
+		auto& data = GetConfigHandle().data();
+		data.graphic_pack_entries.clear();
+		for (const auto& pack : GraphicPack2::GetGraphicPacks())
+		{
+			const fs::path name = _utf8ToPath(pack->GetNormalizedPathString());
+			if (pack->IsEnabled())
+			{
+				auto& entry = data.graphic_pack_entries[name];
+				for (const auto& preset : pack->GetActivePresets())
+					entry.try_emplace(preset->category, preset->name);
+			}
+			else if (pack->IsDefaultEnabled())
+			{
+				data.graphic_pack_entries[name].try_emplace("_disabled", "false");
+			}
+		}
+		GetConfigHandle().Save();
+	}
+} // namespace
+
+std::string InstalledVersion(const std::string& folder)
+{
+	std::string version;
+	if (FILE* file = fopen((folder + "/version.txt").c_str(), "rb"))
+	{
+		char line[128] = {};
+		if (fgets(line, sizeof(line), file))
+			version = line;
+		fclose(file);
+	}
+	while (!version.empty() && (version.back() == '\n' || version.back() == '\r' || version.back() == ' '))
+		version.pop_back();
+	return version;
+}
+
+DownloadResult Download(const std::string& folder, const std::string& caFile,
+	const std::function<void(const std::string&)>& status, const std::atomic<bool>& cancel)
+{
+	DownloadResult result;
+	curl_global_init(CURL_GLOBAL_DEFAULT);
+	Progress progress{&status, &cancel};
+	CremaHttp http(caFile, progress);
+	status("Asking GitHub for the latest release...");
+	std::string body;
+	if (!http.Get(RELEASE_URL, &body, &result.error))
+	{
+		Log("release information: " + result.error);
+		return result;
+	}
+	rapidjson::Document json;
+	json.Parse(body.data(), body.size());
+	const char* url = nullptr;
+	if (!json.HasParseError() && json.IsObject() && json.HasMember("name") && json["name"].IsString() &&
+		json.HasMember("assets") && json["assets"].IsArray() && json["assets"].Size() > 0)
+	{
+		result.version = json["name"].GetString();
+		const auto& asset = json["assets"][0];
+		if (asset.IsObject() && asset.HasMember("browser_download_url") && asset["browser_download_url"].IsString())
+			url = asset["browser_download_url"].GetString();
+	}
+	if (!url || result.version.empty())
+	{
+		result.error = "GitHub's answer has no release";
+		Log(result.error);
+		return result;
+	}
+	if (InstalledVersion(folder) == result.version)
+	{
+		result.upToDate = true;
+		Log(result.version + " is installed already");
+		return result;
+	}
+	const std::string zipUrl = url;
+	status("Downloading " + result.version + "...");
+	std::string data;
+	if (!http.Get(zipUrl, &data, &result.error))
+	{
+		if (cancel)
+			result.error = "cancelled";
+		Log("download: " + result.error);
+		return result;
+	}
+	status(fmt::format("Extracting {:.1f} MB...", data.size() / 1048576.0));
+	result.files = Extract(data, folder, &result.error);
+	if (result.files <= 0)
+	{
+		if (result.error.empty())
+			result.error = "the zip file had no files";
+		Log("extract: " + result.error);
+		return result;
+	}
+	if (FILE* file = fopen((folder + "/version.txt").c_str(), "wb"))
+	{
+		fputs(result.version.c_str(), file);
+		fclose(file);
+	}
+	result.installed = true;
+	Log(fmt::format("{} installed: {} files, {:.1f} MB", result.version, result.files, data.size() / 1048576.0));
+	return result;
+}
+
+void Reload()
+{
+	GraphicPack2::ClearGraphicPacks();
+	GraphicPack2::LoadAll();
+}
+
+int PackCount(const std::string& titleId)
+{
+	return (int)PacksOf(titleId).size();
+}
+
+std::vector<Row> Rows(const std::string& titleId)
+{
+	std::vector<Row> rows;
+	std::string group = "\x01";
+	for (const auto& pack : PacksOf(titleId))
+	{
+		// grouped by the folders of the pack's place in Cemu's tree (Graphics, Mods, Enhancements, ...)
+		const std::string& path = pack->GetVirtualPath();
+		const size_t slash = path.rfind('/');
+		const std::string folder = slash == std::string::npos ? std::string() : path.substr(0, slash);
+		if (folder != group)
+		{
+			group = folder;
+			Row header;
+			header.label = folder.empty() ? "Graphic Packs" : folder;
+			header.header = true;
+			rows.push_back(header);
+		}
+		const std::string index = std::to_string(IndexOf(pack));
+		Row row;
+		row.label = slash == std::string::npos ? path : path.substr(slash + 1);
+		row.value = pack->IsEnabled() ? "On" : "Off";
+		row.key = "pack:" + index;
+		row.help = OneLine(pack->GetDescription());
+		if (row.help.empty())
+			row.help = "Cross: on or off. Takes effect at the next game start.";
+		rows.push_back(row);
+		if (!pack->IsEnabled())
+			continue;
+		std::vector<std::string> order;
+		const auto categories = pack->GetCategorizedPresets(order);
+		for (const std::string& category : order)
+		{
+			const auto it = categories.find(category);
+			if (it == categories.end())
+				continue;
+			const bool visible = std::any_of(it->second.begin(), it->second.end(), [](const auto& p) { return p->visible; });
+			if (!visible)
+				continue;
+			Row preset;
+			preset.label = "      " + (category.empty() ? std::string("Preset") : category);
+			preset.value = pack->GetActivePreset(category);
+			preset.key = "preset:" + index + ":" + category;
+			preset.help = "Left / Right: " + (category.empty() ? std::string("the preset") : category) + " of " + row.label + ". Takes effect at the next game start.";
+			rows.push_back(preset);
+		}
+	}
+	return rows;
+}
+
+void Change(const std::string& key, int direction)
+{
+	if (key.rfind("pack:", 0) == 0)
+	{
+		const auto pack = PackAt(key.substr(5));
+		if (!pack)
+			return;
+		pack->SetEnabled(!pack->IsEnabled());
+		if (pack->IsEnabled())
+		{
+			pack->UpdatePresetVisibility();
+			pack->ValidatePresetSelections();
+		}
+		Log(fmt::format("{}: {}", pack->GetVirtualPath(), pack->IsEnabled() ? "on" : "off"));
+		Save();
+		return;
+	}
+	if (key.rfind("preset:", 0) == 0)
+	{
+		const size_t colon = key.find(':', 7);
+		if (colon == std::string::npos)
+			return;
+		const auto pack = PackAt(key.substr(7, colon - 7));
+		const std::string category = key.substr(colon + 1);
+		if (!pack)
+			return;
+		std::vector<GraphicPack2::PresetPtr> presets;
+		for (const auto& preset : pack->GetPresets())
+		{
+			if (preset->category == category && preset->visible)
+				presets.push_back(preset);
+		}
+		if (presets.empty())
+			return;
+		const std::string active = pack->GetActivePreset(category);
+		int at = 0;
+		for (size_t i = 0; i < presets.size(); i++)
+		{
+			if (presets[i]->name == active)
+				at = (int)i;
+		}
+		const int count = (int)presets.size();
+		at = ((at + (direction < 0 ? -1 : 1)) % count + count) % count;
+		pack->SetActivePreset(category, presets[at]->name);
+		Log(fmt::format("{}: {} = {}", pack->GetVirtualPath(), category.empty() ? "preset" : category, presets[at]->name));
+		Save();
+	}
+}
+} // namespace CremaGraphicPacks
diff --git a/src/gui/ps4/launcher/CremaGraphicPacks.h b/src/gui/ps4/launcher/CremaGraphicPacks.h
new file mode 100644
index 0000000..b972bf8
--- /dev/null
+++ b/src/gui/ps4/launcher/CremaGraphicPacks.h
@@ -0,0 +1,47 @@
+// Cemu's community graphic packs (github.com/cemu-project/cemu_graphic_packs) for the launcher:
+// the latest release downloaded into Cemu's graphicPacks/downloadedGraphicPacks folder (as Cemu's
+// "Download latest community graphic packs"), and each game's packs turned on and off with their
+// presets (resolution, frame rate, ...). The choices go to Cemu's settings.xml, as Cemu's Graphic
+// Packs window saves them, and apply at the next game start.
+#pragma once
+
+#include <atomic>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace CremaGraphicPacks
+{
+struct DownloadResult
+{
+	bool installed = false; // a new release was extracted
+	bool upToDate = false;  // the installed release is the latest
+	std::string version;    // the release's name (Github...)
+	int files = 0;
+	std::string error;
+};
+
+// The installed release's name, or empty.
+std::string InstalledVersion(const std::string& folder);
+
+// Downloads and extracts the latest release into folder (its old contents are replaced) unless it
+// is installed already. status(text) reports the progress.
+DownloadResult Download(const std::string& folder, const std::string& caFile,
+	const std::function<void(const std::string&)>& status, const std::atomic<bool>& cancel);
+
+// Loads the graphic packs again (after a download).
+void Reload();
+
+// A game's packs as settings rows: a header per group, a row per pack (On / Off) and, for a pack
+// that is on, a row per preset category. Keys go back to Change.
+struct Row
+{
+	std::string label, value, key, help;
+	bool header = false;
+};
+std::vector<Row> Rows(const std::string& titleId);
+int PackCount(const std::string& titleId);
+
+// Left (-1) / Right or Cross (+1) on a row: a pack on or off, or the next preset; saved at once.
+void Change(const std::string& key, int direction);
+} // namespace CremaGraphicPacks
diff --git a/src/gui/ps4/launcher/CremaHttp.h b/src/gui/ps4/launcher/CremaHttp.h
new file mode 100644
index 0000000..a6d4cc6
--- /dev/null
+++ b/src/gui/ps4/launcher/CremaHttp.h
@@ -0,0 +1,171 @@
+// HTTPS for the launcher (graphic packs, updates) through the PS4's resolver: each host is looked
+// up before its first request (and redirects are followed here, since the PS4's C library can't
+// resolve them), certificates checked against Crema's CA list. Nothing is downloaded without it.
+#pragma once
+
+#include "gui/ps4/launcher/CremaCovers.h"
+
+#include <cstdint>
+#include <functional>
+#include <set>
+#include <string>
+#include <vector>
+
+#include <curl/curl.h>
+
+class CremaHttp
+{
+public:
+	// a piece of the body; false stops the download
+	using Sink = std::function<bool(const char* data, size_t size)>;
+	// bytes so far and in all (0: not known yet); false stops the download
+	using Progress = std::function<bool(uint64_t done, uint64_t total)>;
+
+	explicit CremaHttp(const std::string& caFile, Progress progress = {}) : m_progress(std::move(progress))
+	{
+		m_curl = curl_easy_init();
+		curl_easy_setopt(m_curl, CURLOPT_CAINFO, caFile.c_str());
+		curl_easy_setopt(m_curl, CURLOPT_USERAGENT, "Crema-PS4");
+		curl_easy_setopt(m_curl, CURLOPT_WRITEFUNCTION, OnData);
+		curl_easy_setopt(m_curl, CURLOPT_WRITEDATA, this);
+		curl_easy_setopt(m_curl, CURLOPT_NOSIGNAL, 1L);
+		curl_easy_setopt(m_curl, CURLOPT_CONNECTTIMEOUT, 15L);
+		curl_easy_setopt(m_curl, CURLOPT_LOW_SPEED_LIMIT, 1L); // gives up after 30 s without data
+		curl_easy_setopt(m_curl, CURLOPT_LOW_SPEED_TIME, 30L);
+		curl_easy_setopt(m_curl, CURLOPT_XFERINFOFUNCTION, OnProgress);
+		curl_easy_setopt(m_curl, CURLOPT_XFERINFODATA, this);
+		curl_easy_setopt(m_curl, CURLOPT_NOPROGRESS, 0L);
+	}
+
+	~CremaHttp()
+	{
+		curl_easy_cleanup(m_curl);
+		curl_slist_free_all(m_resolves);
+		curl_slist_free_all(m_headers);
+	}
+
+	CremaHttp(const CremaHttp&) = delete;
+	CremaHttp& operator=(const CremaHttp&) = delete;
+
+	// Header lines sent with every request ("Accept: application/vnd.github+json").
+	void SetHeaders(const std::vector<std::string>& headers)
+	{
+		curl_slist_free_all(m_headers);
+		m_headers = nullptr;
+		for (const std::string& header : headers)
+			m_headers = curl_slist_append(m_headers, header.c_str());
+		curl_easy_setopt(m_curl, CURLOPT_HTTPHEADER, m_headers);
+	}
+
+	// GET url (following up to 8 redirects), the body to sink; false with the reason in error
+	bool Get(std::string url, const Sink& sink, std::string* error)
+	{
+		for (int hop = 0; hop < 8; hop++)
+		{
+			if (!AddHost(url, error))
+				return false;
+			char detail[CURL_ERROR_SIZE] = {};
+			m_sink = &sink;
+			m_stopped = false;
+			curl_easy_setopt(m_curl, CURLOPT_ERRORBUFFER, detail);
+			curl_easy_setopt(m_curl, CURLOPT_URL, url.c_str());
+			const CURLcode code = curl_easy_perform(m_curl);
+			m_sink = nullptr;
+			if (code != CURLE_OK)
+			{
+				*error = m_stopped ? "stopped" : std::string(curl_easy_strerror(code)) + (detail[0] ? std::string(": ") + detail : "");
+				return false;
+			}
+			long status = 0;
+			curl_easy_getinfo(m_curl, CURLINFO_RESPONSE_CODE, &status);
+			if (status >= 300 && status < 400)
+			{
+				char* next = nullptr;
+				curl_easy_getinfo(m_curl, CURLINFO_REDIRECT_URL, &next);
+				if (!next)
+				{
+					*error = "redirect without an address (HTTP " + std::to_string(status) + ")";
+					return false;
+				}
+				url = next;
+				continue;
+			}
+			if (status != 200)
+			{
+				*error = "HTTP " + std::to_string(status) + " from " + url.substr(0, url.find('?'));
+				return false;
+			}
+			return true;
+		}
+		*error = "too many redirects";
+		return false;
+	}
+
+	// GET url into body (up to limit bytes)
+	bool Get(const std::string& url, std::string* body, std::string* error, size_t limit = 256u * 1024 * 1024)
+	{
+		const Sink sink = [body, limit](const char* data, size_t size) {
+			body->append(data, size);
+			return body->size() <= limit;
+		};
+		body->clear();
+		return Get(url, sink, error);
+	}
+
+private:
+	// a redirect's own body is skipped
+	static size_t OnData(char* data, size_t size, size_t count, void* user)
+	{
+		auto* self = static_cast<CremaHttp*>(user);
+		long status = 0;
+		curl_easy_getinfo(self->m_curl, CURLINFO_RESPONSE_CODE, &status);
+		if (status != 200)
+			return size * count;
+		if (self->m_sink && !(*self->m_sink)(data, size * count))
+		{
+			self->m_stopped = true;
+			return 0;
+		}
+		return size * count;
+	}
+
+	static int OnProgress(void* user, curl_off_t total, curl_off_t now, curl_off_t, curl_off_t)
+	{
+		auto* self = static_cast<CremaHttp*>(user);
+		if (self->m_progress && !self->m_progress((uint64_t)now, (uint64_t)total))
+		{
+			self->m_stopped = true;
+			return 1;
+		}
+		return 0;
+	}
+
+	bool AddHost(const std::string& url, std::string* error)
+	{
+		const size_t start = url.find("://");
+		if (start == std::string::npos || url.compare(0, start, "https") != 0)
+		{
+			*error = "not an https address: " + url;
+			return false;
+		}
+		const size_t end = url.find_first_of("/:?", start + 3);
+		const std::string host = url.substr(start + 3, end == std::string::npos ? std::string::npos : end - start - 3);
+		if (m_hosts.count(host))
+			return true;
+		const std::string address = CremaCovers::Resolve(host, error);
+		if (address.empty())
+			return false;
+		m_hosts.insert(host);
+		m_resolves = curl_slist_append(m_resolves, (host + ":443:" + address).c_str());
+		curl_easy_setopt(m_curl, CURLOPT_RESOLVE, m_resolves);
+		return true;
+	}
+
+	CURL* m_curl = nullptr;
+	curl_slist* m_resolves = nullptr;
+	curl_slist* m_headers = nullptr;
+	std::set<std::string> m_hosts;
+	Progress m_progress;
+	const Sink* m_sink = nullptr;
+	bool m_stopped = false;
+};
