+// Crema's own Mii parts: a resource in the format of the Wii U's Mii parts (FFLRes*.dat in system
+// title 0005001B10056000) built from simple shapes and textures drawn here, so that games show Miis
+// on consoles without a dump of the Wii U's. Holds no Nintendo data.
+#pragma once
+
+#include <vector>
+
+namespace CremaMii
+{
+	// FFLResHigh.dat / FFLResMiddle.dat (and their LG variants: same content)
+	std::vector<uint8> BuildPartsResource();
+	// A file Crema wrote (these parts, or the blank placeholder of v01.20/21), which it may replace
+	// or remove; never a dump of the Wii U's.
+	bool IsCremaFile(const std::vector<uint8>& data);
+	// Whether the file is the current version of Crema's parts.
+	bool IsCurrent(const std::vector<uint8>& data);
+} // namespace CremaMii
diff --git a/src/gui/ps4/CremaOnline.cpp b/src/gui/ps4/CremaOnline.cpp
new file mode 100644
index 0000000..fda02d9
--- /dev/null
+++ b/src/gui/ps4/CremaOnline.cpp
@@ -0,0 +1,352 @@
+#include "gui/ps4/CremaOnline.h"
+
+#include "config/CemuConfig.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <vector>
+
+namespace CremaOnline
+{
+namespace
+{
+	namespace stdfs = std::filesystem;
+
+	const char* kCertsDir = "sys/title/0005001b/10054000/content";
+	const char* kActDir = "usr/save/system/act";
+	const char* kConsoleFiles[] = {"otp.bin", "seeprom.bin"};
+
+	const char* kReadmePretendo =
+		"Crema online: Pretendo Network (the public servers)\n"
+		"\n"
+		"Put your own Wii U's online files here (Dumpling dumps them on your Wii U):\n"
+		"  otp.bin\n"
+		"  seeprom.bin\n"
+		"  mlc01/sys/title/0005001b/10054000/content/ccerts/   (the console's certificates)\n"
+		"  mlc01/sys/title/0005001b/10054000/content/scerts/\n"
+		"  mlc01/usr/save/system/act/80000001/account.dat     (your account, linked to a Pretendo Network ID)\n"
+		"\n"
+		"Then in Crema: Settings > Online > Online: Pretendo.\n"
+		"When a game starts, Crema puts these files in place; with Online: Off (or the private\n"
+		"server) your other files come back.\n";
+
+	const char* kReadmePrivate =
+		"Crema online: Private Server (your own Pretendo server, for example pretendo-docker)\n"
+		"\n"
+		"Put the files for your server here, in the same layout as the Pretendo folder:\n"
+		"  otp.bin\n"
+		"  seeprom.bin\n"
+		"  mlc01/sys/title/0005001b/10054000/content/ccerts/\n"
+		"  mlc01/sys/title/0005001b/10054000/content/scerts/\n"
+		"  mlc01/usr/save/system/act/<account id>/account.dat  (an account made on your server)\n"
+		"\n"
+		"Then in Crema: Settings > Online > Online: Private Server, and Server Address: your\n"
+		"server's proxy, for example 192.168.0.10:8888. Crema sends its online requests through it.\n"
+		"When a game starts, Crema puts these files in place; with Online: Off (or Pretendo) your\n"
+		"other files come back.\n";
+
+	struct Paths
+	{
+		stdfs::path data;
+		stdfs::path mlc;
+	};
+
+	// what online/active.txt says is staged
+	struct State
+	{
+		std::string world = "off";
+		uint32 offlinePid = 0;          // the account selected before the world's
+		std::vector<std::string> files; // "data:otp.bin", "mlc:usr/save/..."
+	};
+
+	bool IsFile(const stdfs::path& path)
+	{
+		std::error_code ec;
+		return stdfs::is_regular_file(path, ec);
+	}
+
+	uintmax_t SizeOf(const stdfs::path& path)
+	{
+		std::error_code ec;
+		const uintmax_t size = stdfs::file_size(path, ec);
+		return ec ? 0 : size;
+	}
+
+	stdfs::file_time_type TimeOf(const stdfs::path& path)
+	{
+		std::error_code ec;
+		const auto time = stdfs::last_write_time(path, ec);
+		return ec ? stdfs::file_time_type::min() : time;
+	}
+
+	// Written next to the target and renamed over it.
+	bool CopyFile(const stdfs::path& from, const stdfs::path& to)
+	{
+		std::error_code ec;
+		stdfs::create_directories(to.parent_path(), ec);
+		FILE* in = fopen(from.c_str(), "rb");
+		if (!in)
+			return false;
+		const stdfs::path temp = to.string() + ".crema-new";
+		FILE* out = fopen(temp.c_str(), "wb");
+		if (!out)
+		{
+			fclose(in);
+			return false;
+		}
+		char buffer[16384];
+		bool ok = true;
+		size_t n;
+		while ((n = fread(buffer, 1, sizeof(buffer), in)) > 0)
+		{
+			if (fwrite(buffer, 1, n, out) != n)
+			{
+				ok = false;
+				break;
+			}
+		}
+		if (ferror(in))
+			ok = false;
+		fclose(in);
+		if (fclose(out) != 0)
+			ok = false;
+		if (ok)
+			stdfs::rename(temp, to, ec);
+		if (!ok || ec)
+		{
+			stdfs::remove(temp, ec);
+			return false;
+		}
+		return true;
+	}
+
+	void CopyTree(const stdfs::path& from, const stdfs::path& to)
+	{
+		std::error_code ec;
+		for (auto it = stdfs::recursive_directory_iterator(from, ec); !ec && it != stdfs::recursive_directory_iterator(); it.increment(ec))
+		{
+			if (it->is_regular_file(ec))
+				CopyFile(it->path(), to / it->path().lexically_relative(from)); // (stdfs::relative needs realpath)
+		}
+	}
+
+	stdfs::path WorldPath(const Paths& paths, const std::string& world)
+	{
+		return paths.data / "online" / world;
+	}
+
+	// an entry's file in place, in a world's folder, and its backup
+	stdfs::path Live(const Paths& paths, const std::string& entry)
+	{
+		return entry.rfind("data:", 0) == 0 ? paths.data / entry.substr(5) : paths.mlc / entry.substr(4);
+	}
+
+	stdfs::path InWorld(const Paths& paths, const std::string& world, const std::string& entry)
+	{
+		return entry.rfind("data:", 0) == 0 ? WorldPath(paths, world) / entry.substr(5) : WorldPath(paths, world) / "mlc01" / entry.substr(4);
+	}
+
+	stdfs::path Backup(const Paths& paths, const std::string& entry)
+	{
+		return paths.data / "online" / "backup" / (entry.rfind("data:", 0) == 0 ? "data" : "mlc") / entry.substr(entry.find(':') + 1);
+	}
+
+	std::vector<std::string> WorldEntries(const Paths& paths, const std::string& world)
+	{
+		std::vector<std::string> entries;
+		const stdfs::path folder = WorldPath(paths, world);
+		for (const char* name : kConsoleFiles)
+		{
+			if (IsFile(folder / name))
+				entries.push_back(std::string("data:") + name);
+		}
+		std::error_code ec;
+		const stdfs::path mlc = folder / "mlc01";
+		for (auto it = stdfs::recursive_directory_iterator(mlc, ec); !ec && it != stdfs::recursive_directory_iterator(); it.increment(ec))
+		{
+			const std::string name = it->path().filename().string();
+			if (!it->is_regular_file(ec) || (name.size() > 10 && name.compare(name.size() - 10, 10, ".crema-new") == 0))
+				continue;
+			entries.push_back("mlc:" + it->path().lexically_relative(mlc).generic_string());
+		}
+		std::sort(entries.begin(), entries.end());
+		return entries;
+	}
+
+	State ReadState(const Paths& paths)
+	{
+		State state;
+		std::ifstream file(paths.data / "online" / "active.txt");
+		std::string line;
+		while (std::getline(file, line))
+		{
+			if (line.rfind("world=", 0) == 0)
+				state.world = line.substr(6);
+			else if (line.rfind("offline_pid=", 0) == 0)
+				state.offlinePid = (uint32)strtoul(line.c_str() + 12, nullptr, 16);
+			else if (line.rfind("file=", 0) == 0)
+				state.files.push_back(line.substr(5));
+		}
+		std::sort(state.files.begin(), state.files.end());
+		return state;
+	}
+
+	void WriteState(const Paths& paths, const State& state)
+	{
+		const stdfs::path path = paths.data / "online" / "active.txt";
+		{
+			std::ofstream file(path.string() + ".new", std::ios::trunc);
+			file << "# Crema: the online world whose files are in place (see README.txt in each folder)\n";
+			file << "world=" << state.world << "\n";
+			if (state.offlinePid)
+				file << "offline_pid=" << fmt::format("{:08x}", state.offlinePid) << "\n";
+			for (const std::string& entry : state.files)
+				file << "file=" << entry << "\n";
+		}
+		std::error_code ec;
+		stdfs::rename(path.string() + ".new", path, ec);
+	}
+} // namespace
+
+std::string WorldFolder(const std::string& dataDir, const std::string& world)
+{
+	return dataDir + "/online/" + world;
+}
+
+void CreateFolders(const std::string& dataDir, const std::string& mlcDir)
+{
+	const Paths paths{dataDir, mlcDir};
+	for (const char* world : {"pretendo", "private"})
+	{
+		const stdfs::path folder = WorldPath(paths, world);
+		std::error_code ec;
+		const bool fresh = !stdfs::exists(folder, ec);
+		stdfs::create_directories(folder / "mlc01", ec);
+		if (!IsFile(folder / "README.txt"))
+		{
+			std::ofstream readme(folder / "README.txt");
+			readme << (std::string(world) == "pretendo" ? kReadmePretendo : kReadmePrivate);
+		}
+		// Crema 1.36: the Wii U's files went straight into place, for Pretendo
+		if (fresh && std::string(world) == "pretendo" && !IsFile(paths.data / "online" / "active.txt"))
+		{
+			for (const char* name : kConsoleFiles)
+			{
+				if (IsFile(paths.data / name))
+					CopyFile(paths.data / name, folder / name);
+			}
+			for (const char* certs : {"ccerts", "scerts"})
+				CopyTree(paths.mlc / kCertsDir / certs, folder / "mlc01" / kCertsDir / certs);
+		}
+	}
+}
+
+Status Check(const std::string& dataDir, const std::string& world)
+{
+	Status status;
+	const stdfs::path folder = WorldFolder(dataDir, world);
+	status.otp = SizeOf(folder / "otp.bin") == 1024;
+	status.seeprom = SizeOf(folder / "seeprom.bin") == 512;
+	std::error_code ec;
+	status.certs = stdfs::exists(folder / "mlc01" / kCertsDir / "ccerts", ec);
+	std::vector<std::string> accounts;
+	for (auto it = stdfs::directory_iterator(folder / "mlc01" / kActDir, ec); !ec && it != stdfs::directory_iterator(); it.increment(ec))
+	{
+		const std::string name = it->path().filename().string();
+		if (name.size() == 8 && name.find_first_not_of("0123456789abcdefABCDEF") == std::string::npos && IsFile(it->path() / "account.dat"))
+			accounts.push_back(name);
+	}
+	std::sort(accounts.begin(), accounts.end());
+	if (!accounts.empty())
+		status.account = accounts.front();
+	return status;
+}
+
+std::string Stage(const std::string& dataDir, const std::string& mlcDir, const std::string& requested)
+{
+	const Paths paths{dataDir, mlcDir};
+	const std::string world = requested == "pretendo" || requested == "private" ? requested : "off";
+	const State state = ReadState(paths);
+	const std::vector<std::string> wanted = world == "off" ? std::vector<std::string>() : WorldEntries(paths, world);
+	const auto stagedAt = TimeOf(paths.data / "online" / "active.txt");
+
+	// already in place, and the world's files not changed since
+	if (state.world == world)
+	{
+		bool same = state.files == wanted;
+		for (size_t i = 0; same && i < wanted.size(); i++)
+			same = IsFile(Live(paths, wanted[i])) && TimeOf(InWorld(paths, world, wanted[i])) <= stagedAt;
+		if (same)
+			return fmt::format("online: {}, {} files in place", world, wanted.size());
+	}
+
+	// the staged world's files go back to its folder if the game changed them (the account),
+	// and the files they replaced come back
+	int restored = 0;
+	if (state.world != "off")
+	{
+		for (const std::string& entry : state.files)
+		{
+			const stdfs::path live = Live(paths, entry);
+			const stdfs::path inWorld = InWorld(paths, state.world, entry);
+			const stdfs::path backup = Backup(paths, entry);
+			if (IsFile(live) && IsFile(inWorld) && TimeOf(live) > stagedAt && TimeOf(inWorld) <= stagedAt)
+				CopyFile(live, inWorld);
+			std::error_code ec;
+			if (IsFile(backup))
+			{
+				if (CopyFile(backup, live))
+					stdfs::remove(backup, ec);
+			}
+			else
+			{
+				stdfs::remove(live, ec);
+			}
+			restored++;
+		}
+		if (state.offlinePid)
+			GetConfig().account.m_persistent_id = state.offlinePid;
+	}
+
+	State next;
+	next.world = world;
+	int staged = 0;
+	std::string account;
+	if (world != "off")
+	{
+		next.offlinePid = GetConfig().account.m_persistent_id.GetValue();
+		for (const std::string& entry : wanted)
+		{
+			const stdfs::path live = Live(paths, entry);
+			if (IsFile(live))
+				CopyFile(live, Backup(paths, entry));
+			if (CopyFile(InWorld(paths, world, entry), live))
+			{
+				next.files.push_back(entry);
+				staged++;
+			}
+		}
+		account = Check(dataDir, world).account;
+		if (!account.empty())
+			GetConfig().account.m_persistent_id = (uint32)strtoul(account.c_str(), nullptr, 16);
+	}
+	GetConfigHandle().Save();
+	WriteState(paths, next);
+	return fmt::format("online: {} -> {}: {} files put back, {} staged{}", state.world, world, restored, staged,
+		account.empty() ? std::string() : ", account " + account);
+}
+
+std::string ProxyUrl(const std::string& address)
+{
+	const size_t first = address.find_first_not_of(" \t");
+	if (first == std::string::npos)
+		return {};
+	const std::string trimmed = address.substr(first, address.find_last_not_of(" \t") - first + 1);
+	if (trimmed.rfind("http://", 0) == 0 || trimmed.rfind("https://", 0) == 0)
+		return trimmed;
+	return "http://" + trimmed;
+}
+} // namespace CremaOnline
diff --git a/src/gui/ps4/CremaOnline.h b/src/gui/ps4/CremaOnline.h
new file mode 100644
index 0000000..e00d2d5
--- /dev/null
+++ b/src/gui/ps4/CremaOnline.h
@@ -0,0 +1,41 @@
+// Crema's two online worlds: Pretendo Network's public servers, and a private server (your own
+// Pretendo server, e.g. pretendo-docker, reached through its proxy). Each world keeps its own
+// console and account files in /data/Crema/online/<world>/:
+//   otp.bin, seeprom.bin                                   -> /data/Crema
+//   mlc01/sys/title/0005001b/10054000/content/(ccerts, scerts), mlc01/usr/save/system/act/<id>/...
+//                                                          -> the mlc01 folder in use
+// At start (before Cemu reads them) the chosen world's files are put in place; the files they
+// replace are kept in online/backup and put back when the world changes (Online: Off restores the
+// offline files). online/active.txt lists what is staged.
+#pragma once
+
+#include <string>
+
+namespace CremaOnline
+{
+// "pretendo" / "private": the world folders' paths
+std::string WorldFolder(const std::string& dataDir, const std::string& world);
+
+// Creates online/pretendo and online/private with their README.txt. The first time, otp.bin,
+// seeprom.bin and the console certificates already in place (Crema 1.36's layout) are copied
+// into the Pretendo folder.
+void CreateFolders(const std::string& dataDir, const std::string& mlcDir);
+
+// What a world folder has
+struct Status
+{
+	bool otp = false;     // otp.bin, 1024 bytes
+	bool seeprom = false; // seeprom.bin, 512 bytes
+	bool certs = false;   // mlc01/sys/title/0005001b/10054000/content/ccerts
+	std::string account;  // the account's persistent ID (mlc01/usr/save/system/act/<id>/account.dat)
+	int Missing() const { return !otp + !seeprom + !certs + account.empty(); }
+};
+Status Check(const std::string& dataDir, const std::string& world);
+
+// Game process, before Cemu reads the console files and accounts: puts the world's files in place
+// ("off": the offline ones) and selects its account. Returns a line for the boot trace.
+std::string Stage(const std::string& dataDir, const std::string& mlcDir, const std::string& world);
+
+// The proxy for the private server's address ("192.168.0.10:8888" -> "http://192.168.0.10:8888")
+std::string ProxyUrl(const std::string& address);
+} // namespace CremaOnline
