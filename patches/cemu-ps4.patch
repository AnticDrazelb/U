+	// the controls page's rows: Player, Controller, Apply To (a game only), the bindings, Reset to
+	// Default
+	enum ControlRowKind
+	{
+		CTL_PLAYER,
+		CTL_KIND,
+		CTL_ORIENT, // a Wii Remote alone: sideways or upright
+		CTL_SCOPE,
+		CTL_BINDING,
+		CTL_BLOW, // the GamePad's microphone (player 1)
+		CTL_RESET,
+	};
+	struct ControlRow
+	{
+		ControlRowKind kind;
+		int binding;
+	};
+
+	bool sControls = false; // the controls page is open
+	int sControlsSelected = 0;
+	float sControlsScroll = 0.0f;
+	int sPlayer = 0; // the player the page shows
+	bool sCapture = false, sCaptureReleased = false;
+	double sCaptureStart = 0.0;
+	int sCaptureBinding = 0;
+	bool sCaptureBlow = false;          // the capture is for the blow combination
+	std::vector<uint64> sBlowPressed;   // the controls held during it
+	double sBlowMessageUntil = 0.0;     // "two or more" shown until
+
+	EmulatedControllerPtr PlayerController(int player)
+	{
+		return InputManager::instance().get_controller(player);
+	}
+
+	int KindOf(const EmulatedControllerPtr& controller)
+	{
+		if (!controller)
+			return KIND_PRO;
+		switch (controller->type())
+		{
+		case EmulatedController::Type::VPAD: return KIND_GAMEPAD;
+		case EmulatedController::Type::Classic: return KIND_CLASSIC;
+		case EmulatedController::Type::Wiimote:
+			return std::static_pointer_cast<WiimoteController>(controller)->get_device_type() == kWAPDevFreestyle ? KIND_NUNCHUK : KIND_WIIMOTE;
+		default: return KIND_PRO;
+		}
+	}
+
+	std::shared_ptr<ControllerBase> Pad(const EmulatedControllerPtr& controller)
+	{
+		for (const auto& c : controller->get_controllers())
+			if (c->api() == InputAPI::PS4Pad)
+				return c;
+		return nullptr;
+	}
+
+	// A Wii Remote points while a finger is on the touchpad; the GamePad's screen is touched by a click.
+	void ApplyPointerMode(int player)
+	{
+		auto controller = PlayerController(player);
+		auto pad = controller ? std::dynamic_pointer_cast<PS4PadController>(Pad(controller)) : nullptr;
+		if (pad)
+			pad->set_hover_pointer(controller->type() == EmulatedController::Type::Wiimote);
+	}
+
+	// the game's own layouts: controllerProfiles/crema-<title ID> (player 1), crema-<title ID>-p2 ...
+	std::string GameLayoutName(int player)
+	{
+		return player == 0 ? "crema-" + sGameId : fmt::format("crema-{}-p{}", sGameId, player + 1);
+	}
+
+	bool HasGameLayout(int player)
+	{
+		std::error_code ec;
+		return !sGameId.empty() && fs::exists(ActiveSettings::GetConfigPath("controllerProfiles/{}.xml", GameLayoutName(player)), ec);
+	}
+
+	std::vector<ControlRow> ControlRows()
+	{
+		std::vector<ControlRow> rows = {{CTL_PLAYER, 0}, {CTL_KIND, 0}};
+		if (KindOf(PlayerController(sPlayer)) == KIND_WIIMOTE)
+			rows.push_back({CTL_ORIENT, 0});
+		if (!sGameId.empty())
+			rows.push_back({CTL_SCOPE, 0});
+		const int count = (int)BindingsOf(KindOf(PlayerController(sPlayer))).size();
+		for (int i = 0; i < count; i++)
+			rows.push_back({CTL_BINDING, i});
+		if (KindOf(PlayerController(sPlayer)) == KIND_GAMEPAD)
+			rows.push_back({CTL_BLOW, 0});
+		rows.push_back({CTL_RESET, 0});
+		return rows;
+	}
+
+	// the DualShock 4 control an input is on, or null (none, or another controller)
+	const PadInput* BoundInput(const EmulatedControllerPtr& controller, uint64 mapping)
+	{
+		const auto pad = controller->get_mapping_controller(mapping);
+		if (!pad || pad->api() != InputAPI::PS4Pad)
+			return nullptr;
+		const std::string name = controller->get_mapping_name(mapping);
+		for (const PadInput& input : kPadInputs)
+			if (pad->get_button_name(input.button) == name)
+				return &input;
+		return nullptr;
+	}
+
+	const StickChoice* BoundStick(const EmulatedControllerPtr& controller, uint64 up)
+	{
+		for (const StickChoice& stick : kSticks)
+		{
+			const uint64 parts[4] = {stick.up, stick.down, stick.left, stick.right};
+			bool all = true;
+			for (int i = 0; i < 4; i++)
+			{
+				const PadInput* input = BoundInput(controller, up + i);
+				all = all && input && input->button == parts[i];
+			}
+			if (all)
+				return &stick;
+		}
+		return nullptr;
+	}
+
+	// The layout in use is saved where it came from: the game's own, or the one for all games.
+	void SaveLayout(int player)
+	{
+		if (HasGameLayout(player))
+			InputManager::instance().save(player, GameLayoutName(player));
+		else
+			InputManager::instance().save(player);
+	}
+
+	// This Game: the game gets its own layout, starting from the current one. All Games: it's
+	// removed and the layout for all games is loaded again.
+	void ToggleScope(int player)
+	{
+		std::error_code ec;
+		if (HasGameLayout(player))
+		{
+			fs::remove(ActiveSettings::GetConfigPath("controllerProfiles/{}.xml", GameLayoutName(player)), ec);
+			InputManager::instance().load(player);
+			ApplyPointerMode(player);
+			ps4_boot_trace(fmt::format("in-game menu: player {} controls for all games", player + 1).c_str());
+		}
+		else
+		{
+			InputManager::instance().save(player, GameLayoutName(player));
+			ps4_boot_trace(fmt::format("in-game menu: player {} controls for this game", player + 1).c_str());
+		}
+	}
+
+	// The player's controller becomes a `kind` on their DualShock 4, with its default layout.
+	void SetKind(int player, int kind)
+	{
+		static const EmulatedController::Type kTypes[KIND_COUNT] = {EmulatedController::Type::VPAD, EmulatedController::Type::Pro,
+			EmulatedController::Type::Classic, EmulatedController::Type::Wiimote, EmulatedController::Type::Wiimote};
+		auto& input = InputManager::instance();
+		auto old = PlayerController(player);
+		std::shared_ptr<ControllerBase> pad = old ? Pad(old) : nullptr;
+		if (!pad)
+			pad = ControllerFactory::CreateController(InputAPI::PS4Pad, std::to_string(player), "DualShock 4");
+		auto controller = input.set_controller(player, kTypes[kind], pad);
+		if (!controller)
+			return;
+		if (kind == KIND_WIIMOTE || kind == KIND_NUNCHUK)
+		{
+			auto wiimote = std::static_pointer_cast<WiimoteController>(controller);
+			wiimote->set_device_type(kind == KIND_NUNCHUK ? kWAPDevFreestyle : kWAPDevCore);
+			wiimote->set_sideways(kind == KIND_WIIMOTE); // alone: sideways first (Orientation changes it)
+		}
+		controller->clear_mappings();
+		controller->set_default_mapping(pad);
+		ApplyPointerMode(player);
+		SaveLayout(player);
+		ps4_boot_trace(fmt::format("in-game menu: player {} uses a {}", player + 1, kKindNames[kind]).c_str());
+	}
+
+	// Orientation (a Wii Remote alone): sideways or upright, with that orientation's default layout
+	void ToggleOrientation(int player)
+	{
+		auto controller = PlayerController(player);
+		if (!controller || KindOf(controller) != KIND_WIIMOTE)
+			return;
+		auto wiimote = std::static_pointer_cast<WiimoteController>(controller);
+		std::shared_ptr<ControllerBase> pad = Pad(controller);
+		wiimote->set_sideways(!wiimote->is_sideways());
+		if (pad)
+		{
+			controller->clear_mappings();
+			controller->set_default_mapping(pad);
+		}
+		SaveLayout(player);
+		ps4_boot_trace(fmt::format("in-game menu: player {} holds the Wii Remote {}", player + 1,
+			wiimote->is_sideways() ? "sideways" : "upright").c_str());
+	}
+
+	// Left/Right: the next controller type (the GamePad for player 1 only: Cemu has two at most,
+	// and games expect it first).
+	void StepKind(int player, int direction)
+	{
+		const int first = player == 0 ? KIND_GAMEPAD : KIND_PRO;
+		const int count = KIND_COUNT - first;
+		const int current = std::max(KindOf(PlayerController(player)), first) - first;
+		SetKind(player, first + ((current + direction) % count + count) % count);
+	}
+
+	void ResetLayout(int player)
+	{
+		auto controller = PlayerController(player);
+		auto pad = controller ? Pad(controller) : nullptr;
+		if (!pad)
+			return;
+		controller->clear_mappings();
+		controller->set_default_mapping(pad);
+		SaveLayout(player);
+		if (KindOf(controller) == KIND_GAMEPAD)
+			SetBlowCombo(kBlowDefault);
+	}
+
+	void SetStick(int player, int binding, int direction)
+	{
+		auto controller = PlayerController(player);
+		auto pad = controller ? Pad(controller) : nullptr;
+		if (!pad)
+			return;
+		const uint64 up = BindingsOf(KindOf(controller))[binding].mapping;
+		const StickChoice* current = BoundStick(controller, up);
+		const int count = (int)std::size(kSticks);
+		int index = current ? (int)(current - kSticks) : 0;
+		index = ((index + direction) % count + count) % count;
+		const StickChoice& stick = kSticks[index];
+		const uint64 parts[4] = {stick.up, stick.down, stick.left, stick.right};
+		for (int i = 0; i < 4; i++)
+			controller->set_mapping(up + i, pad, parts[i]);
+		SaveLayout(player);
+	}
+
+	// whether the player's DualShock 4 is there (a signed-in user with a pad)
+	bool PadConnected(int player)
+	{
+		auto controller = PlayerController(player);
+		auto pad = controller ? Pad(controller) : nullptr;
+		return pad && pad->is_connected();
+	}
+
+	// PS4Controls::IsAtRest / Capture: no button, trigger or stick in use; else the control pressed
+	bool IsAtRest(const OrbisPadData& now)
+	{
+		auto centred = [](uint8 v) { return v > 78 && v < 178; };
+		return now.buttons == 0 && now.analogButtons.l2 < 40 && now.analogButtons.r2 < 40 && centred(now.leftStick.x) &&
+			   centred(now.leftStick.y) && centred(now.rightStick.x) && centred(now.rightStick.y);
+	}
+
+	// every control in use (Capture: the first)
+	std::vector<uint64> CaptureAll(const OrbisPadData& now)
+	{
+		std::vector<uint64> held;
+		if ((now.buttons & ORBIS_PAD_BUTTON_L2) || now.analogButtons.l2 > 180)
+			held.push_back(kTriggerXP);
+		if ((now.buttons & ORBIS_PAD_BUTTON_R2) || now.analogButtons.r2 > 180)
+			held.push_back(kTriggerYP);
+		const std::pair<uint32, uint64> buttons[] = {
+			{ORBIS_PAD_BUTTON_CROSS, kButton0}, {ORBIS_PAD_BUTTON_CIRCLE, kButton1}, {ORBIS_PAD_BUTTON_SQUARE, kButton2},
+			{ORBIS_PAD_BUTTON_TRIANGLE, kButton3}, {ORBIS_PAD_BUTTON_L1, kButton9}, {ORBIS_PAD_BUTTON_R1, kButton10},
+			{ORBIS_PAD_BUTTON_L3, kButton7}, {ORBIS_PAD_BUTTON_R3, kButton8}, {ORBIS_PAD_BUTTON_OPTIONS, kButton6},
+			{ORBIS_PAD_BUTTON_UP, kButton11}, {ORBIS_PAD_BUTTON_DOWN, kButton12}, {ORBIS_PAD_BUTTON_LEFT, kButton13},
+			{ORBIS_PAD_BUTTON_RIGHT, kButton14}};
+		for (const auto& [bit, button] : buttons)
+			if (now.buttons & bit)
+				held.push_back(button);
+		if (now.buttons & ORBIS_PAD_BUTTON_TOUCH_PAD) // the touchpad's left or right half
+			held.push_back(now.touch.fingers > 0 && now.touch.touch[0].x >= 960 ? kButton5 : kButton4);
+		if (now.leftStick.x < 40)
+			held.push_back(kAxisXN);
+		if (now.leftStick.x > 215)
+			held.push_back(kAxisXP);
+		if (now.leftStick.y < 40)
+			held.push_back(kAxisYN);
+		if (now.leftStick.y > 215)
+			held.push_back(kAxisYP);
+		if (now.rightStick.x < 40)
+			held.push_back(kRotationXN);
+		if (now.rightStick.x > 215)
+			held.push_back(kRotationXP);
+		if (now.rightStick.y < 40)
+			held.push_back(kRotationYN);
+		if (now.rightStick.y > 215)
+			held.push_back(kRotationYP);
+		return held;
+	}
+
+	std::optional<uint64> Capture(const OrbisPadData& now)
+	{
+		const auto held = CaptureAll(now);
+		if (held.empty())
+			return std::nullopt;
+		return held.front();
+	}
+
+	// A capture in progress: waits until the pad is at rest, then takes the next press (5 s
+	// without one cancels). True while it has the pad.
+	bool UpdateCapture(const OrbisPadData& data, bool read, double now)
+	{
+		if (!sCapture)
+			return false;
+		if (!read)
+			return true;
+		if (!sCaptureReleased)
+		{
+			sCaptureReleased = IsAtRest(data);
+			return true;
+		}
+		if (sCaptureBlow)
+		{
+			// the controls held together, taken when all are let go: two or more
+			for (uint64 button : CaptureAll(data))
+				if (std::find(sBlowPressed.begin(), sBlowPressed.end(), button) == sBlowPressed.end())
+					sBlowPressed.push_back(button);
+			if (sBlowPressed.empty())
+			{
+				if (now - sCaptureStart > 5.0)
+					sCapture = false;
+				return true;
+			}
+			if (!IsAtRest(data))
+				return true;
+			if (sBlowPressed.size() >= 2)
+			{
+				std::vector<uint32> combo;
+				for (uint64 button : sBlowPressed)
+					if (combo.size() < std::size(g_crema_blow_buttons))
+						combo.push_back((uint32)button);
+				SetBlowCombo(combo);
+			}
+			else
+			{
+				sBlowMessageUntil = now + 3.0;
+			}
+			sCapture = false;
+			return true;
+		}
+		if (now - sCaptureStart > 5.0)
+		{
+			sCapture = false;
+			return true;
+		}
+		const auto button = Capture(data);
+		if (!button)
+			return true;
+		auto controller = PlayerController(sPlayer);
+		auto pad = controller ? Pad(controller) : nullptr;
+		if (pad)
+		{
+			controller->set_mapping(BindingsOf(KindOf(controller))[sCaptureBinding].mapping, pad, *button);
+			SaveLayout(sPlayer);
+		}
+		sCapture = false;
+		return true;
+	}
+
+	std::string ValueOf(int row)
+	{
+		switch (row)
+		{
+		case ROW_TV: return LatteGPUState.isDRCPrimary ? "GamePad Screen" : "TV Screen";
+		case ROW_POINTER: return g_crema_touch_pointer ? "On" : "Off";
+		case ROW_TOUCHPAD: return g_crema_touchpad_buttons ? "Minus / HOME" : "GamePad Touch Screen";
+		case ROW_MOTION: return MotionOn() ? "On" : "Off";
+		case ROW_CONTROLS: return HasGameLayout(0) ? "This Game" : "All Games";
+		case ROW_VOLUME: return std::to_string(Volume());
+		case ROW_FPS: return GetConfig().overlay.position != ScreenPosition::kDisabled ? "On" : "Off";
+		default: return {};
+		}
+	}
+
+	const char* LabelOf(int row)
+	{
+		static const char* const LABELS[ROW_COUNT] = {"Resume", "TV Shows", "Touch Pointer", "Touchpad", "Motion Controls",
+			"Controls", "Game Volume", "FPS Counter", "Restart Game", "Quit to Launcher"};
+		return LABELS[row];
+	}
+
+	// Restarts the app: into this game again (launch.txt) or into the launcher.
+	void RestartApp(bool sameGame)
+	{
+		const fs::path launch = ActiveSettings::GetUserDataPath("launch.txt");
+		std::error_code ec;
+		if (sameGame && !sLaunchPath.empty())
+		{
+			std::ofstream file(launch, std::ios::trunc);
+			file << sLaunchPath << "\n";
+		}
+		else
+		{
+			fs::remove(launch, ec);
+		}
+		ps4_boot_trace(sameGame ? "in-game menu: restarting the game" : "in-game menu: back to the launcher");
+		sceSystemServiceLoadExec("/app0/eboot.bin", nullptr);
+	}
+
+	// Left/Right (direction -1 / 1) or Cross (1) on a row.
+	void Change(int row, int direction)
+	{
+		switch (row)
+		{
+		case ROW_RESUME:
+			if (direction > 0)
+				sOpen = false;
+			break;
+		case ROW_TV:
+			LatteGPUState.isDRCPrimary = !LatteGPUState.isDRCPrimary;
+			Save("tv_shows", LatteGPUState.isDRCPrimary ? "gamepad" : "tv");
+			break;
+		case ROW_POINTER:
+			g_crema_touch_pointer = !g_crema_touch_pointer;
+			Save("touch_pointer", g_crema_touch_pointer ? "on" : "off");
+			break;
+		case ROW_TOUCHPAD:
+			g_crema_touchpad_buttons = !g_crema_touchpad_buttons;
+			Save("touchpad", g_crema_touchpad_buttons ? "buttons" : "touch");
+			break;
+		case ROW_MOTION:
+		{
+			const bool on = !MotionOn();
+			SetMotion(on);
+			Save("motion", on ? "on" : "off");
+			break;
+		}
+		case ROW_CONTROLS:
+			if (direction > 0)
+			{
+				sControls = true;
+				sControlsSelected = 0;
+				sControlsScroll = 0.0f;
+			}
+			break;
+		case ROW_VOLUME:
+		{
+			const int volume = std::clamp(Volume() + (direction < 0 ? -10 : 10), 0, 100);
+			SetVolume(volume);
+			Save("game_volume", std::to_string(volume));
+			break;
+		}
+		case ROW_FPS:
+		{
+			auto& overlay = GetConfig().overlay;
+			overlay.position = overlay.position == ScreenPosition::kDisabled ? ScreenPosition::kTopLeft : ScreenPosition::kDisabled;
+			overlay.fps = true;
+			Save("show_fps", overlay.position != ScreenPosition::kDisabled ? "on" : "off");
+			break;
+		}
+		case ROW_RESTART:
+			if (direction > 0)
+				RestartApp(true);
+			break;
+		case ROW_QUIT:
+			if (direction > 0)
+				RestartApp(false);
+			break;
+		}
+	}
+
+	enum : uint32
+	{
+		B_UP = 1,
+		B_DOWN = 2,
+		B_LEFT = 4,
+		B_RIGHT = 8,
+		B_CROSS = 16,
+		B_CIRCLE = 32,
+	};
+
+	void ControlsInput(uint32 pressed, double now)
+	{
+		auto rows = ControlRows();
+		int count = (int)rows.size();
+		if (pressed & B_UP)
+			sControlsSelected = (sControlsSelected + count - 1) % count;
+		if (pressed & B_DOWN)
+			sControlsSelected = (sControlsSelected + 1) % count;
+		sControlsSelected = std::clamp(sControlsSelected, 0, count - 1);
+		const ControlRow row = rows[sControlsSelected];
+		const auto& bindings = BindingsOf(KindOf(PlayerController(sPlayer)));
+		const bool stick = row.kind == CTL_BINDING && bindings[row.binding].stickGroup;
+		const int direction = (pressed & B_LEFT) ? -1 : 1;
+		if (pressed & (B_LEFT | B_RIGHT | B_CROSS))
+		{
+			if (row.kind == CTL_PLAYER)
+				sPlayer = ((sPlayer + direction) % kPlayers + kPlayers) % kPlayers;
+			else if (row.kind == CTL_KIND)
+				StepKind(sPlayer, direction);
+			else if (row.kind == CTL_ORIENT)
+				ToggleOrientation(sPlayer);
+			else if (row.kind == CTL_SCOPE)
+				ToggleScope(sPlayer);
+			else if (stick)
+				SetStick(sPlayer, row.binding, direction);
+			else if (row.kind == CTL_RESET && (pressed & B_CROSS))
+				ResetLayout(sPlayer);
+			else if (row.kind == CTL_BINDING && (pressed & B_CROSS))
+			{
+				sCapture = true;
+				sCaptureBlow = false;
+				sCaptureReleased = false;
+				sCaptureStart = now;
+				sCaptureBinding = row.binding;
+			}
+			else if (row.kind == CTL_BLOW && (pressed & B_CROSS))
+			{
+				sCapture = true;
+				sCaptureBlow = true;
+				sBlowPressed.clear();
+				sBlowMessageUntil = 0.0;
+				sCaptureReleased = false;
+				sCaptureStart = now;
+			}
+			else if (row.kind == CTL_BLOW)
+				SetBlowCombo(BlowCombo().empty() ? kBlowDefault : std::vector<uint32>()); // Left/Right: off, or L2 + R2
+			// a new player or controller type has other rows
+			sControlsSelected = std::clamp(sControlsSelected, 0, (int)ControlRows().size() - 1);
+		}
+		if (pressed & B_CIRCLE)
+			sControls = false;
+	}
+
+	// the controls page, in the panel from x0 to W
+	void DrawControls(ImDrawList* dl, ImFont* title, ImFont* font, ImFont* small, float x0, float W, float H, float a, float dt)
+	{
+		constexpr uint32 ACCENT = 0x9B7BFF, TEXT = 0xFFFFFF, WARN = 0xFFC870;
+		const auto controller = PlayerController(sPlayer);
+		const int kind = KindOf(controller);
+		const auto& bindings = BindingsOf(kind);
+		dl->AddText(title, 44.0f, ImVec2(x0 + 50, 90), Rgba(TEXT, a), "Controls");
+		const std::string subtitle = fmt::format("Player {}: {}", sPlayer + 1, kKindNames[kind]);
+		dl->AddText(small, 24.0f, ImVec2(x0 + 52, 148), Rgba(ACCENT, a), subtitle.c_str());
+		const auto rows = ControlRows();
+		constexpr float ROW_H = 54.0f, TOP = 210.0f;
+		const float bottom = H - 150.0f;
+		// keep the selection in view
+		const float selY = sControlsSelected * ROW_H;
+		float target = sControlsScroll;
+		if (selY - target < ROW_H)
+			target = std::max(0.0f, selY - ROW_H);
+		if (selY - target > bottom - TOP - 2 * ROW_H)
+			target = selY - (bottom - TOP - 2 * ROW_H);
+		sControlsScroll += (target - sControlsScroll) * (1.0f - std::exp(-18.0f * dt));
+		dl->PushClipRect(ImVec2(x0, TOP - 10), ImVec2(W, bottom), true);
+		for (int i = 0; i < (int)rows.size(); i++)
+		{
+			const ControlRow& row = rows[i];
+			const float y = TOP + i * ROW_H - sControlsScroll + (row.kind == CTL_RESET ? 14.0f : 0.0f);
+			if (row.kind == CTL_RESET)
+				dl->AddLine(ImVec2(x0 + 50, y - 10), ImVec2(W - 50, y - 10), Rgba(ACCENT, 0.35f * a), 1.5f);
+			const bool sel = i == sControlsSelected;
+			if (sel)
+				dl->AddRectFilled(ImVec2(x0 + 30, y - 4), ImVec2(W - 30, y + 46), Rgba(ACCENT, 0.30f * a), 10.0f);
+			const char* label = row.kind == CTL_PLAYER ? "Player" : row.kind == CTL_KIND ? "Controller" :
+				row.kind == CTL_ORIENT ? "Orientation" : row.kind == CTL_SCOPE ? "Apply To" :
+				row.kind == CTL_RESET ? "Reset to Default" : row.kind == CTL_BLOW ? "Blow (Mic)" : bindings[row.binding].label;
+			dl->AddText(font, 30.0f, ImVec2(x0 + 60, y + 4), Rgba(TEXT, a), label);
+			std::string glyph, value;
+			uint32 colour = TEXT;
+			if (row.kind == CTL_PLAYER)
+			{
+				const bool connected = PadConnected(sPlayer);
+				value = fmt::format("{}{}", sPlayer + 1, connected ? "" : "  (no controller)");
+				colour = connected ? TEXT : WARN;
+			}
+			else if (row.kind == CTL_KIND)
+				value = kKindNames[kind];
+			else if (row.kind == CTL_ORIENT)
+				value = controller && std::static_pointer_cast<WiimoteController>(controller)->is_sideways() ? "Sideways" : "Upright";
+			else if (row.kind == CTL_SCOPE)
+				value = HasGameLayout(sPlayer) ? "This Game" : "All Games";
+			else if (row.kind == CTL_BINDING && sCapture && !sCaptureBlow && row.binding == sCaptureBinding)
+			{
+				value = "Press a button...";
+				colour = ACCENT;
+			}
+			else if (row.kind == CTL_BLOW && sCapture && sCaptureBlow)
+			{
+				value = "Hold them together...";
+				colour = ACCENT;
+			}
+			else if (row.kind == CTL_BLOW)
+			{
+				for (uint32 button : BlowCombo())
+				{
+					const char* text = "?";
+					for (const PadInput& input : kPadInputs)
+						if (input.button == button)
+							text = input.text;
+					value += (value.empty() ? "" : " + ") + std::string(text);
+				}
+				if (value.empty())
+					value = "Off";
+			}
+			else if (row.kind == CTL_BINDING && controller && bindings[row.binding].stickGroup)
+			{
+				const StickChoice* stick = BoundStick(controller, bindings[row.binding].mapping);
+				glyph = stick ? stick->name : "";
+				value = stick ? stick->name : "Custom";
+			}
+			else if (row.kind == CTL_BINDING && controller)
+			{
+				const PadInput* input = BoundInput(controller, bindings[row.binding].mapping);
+				glyph = input ? input->glyph : "";
+				value = input ? input->text : "None";
+			}
+			constexpr float GLYPH_H = 36.0f;
+			const float gw = glyph.empty() ? 0.0f : PS4Glyphs::Width(glyph, GLYPH_H);
+			if (gw > 0.0f)
+				PS4Glyphs::Draw(dl, font, glyph, W - 70 - gw, y + 21, GLYPH_H, a);
+			else if (!value.empty())
+			{
+				const float tw = font->CalcTextSizeA(26.0f, FLT_MAX, 0.0f, value.c_str()).x;
+				dl->AddText(font, 26.0f, ImVec2(W - 70 - tw, y + 8), Rgba(colour, 0.85f * a), value.c_str());
+			}
+		}
+		dl->PopClipRect();
+		const ControlRow& row = rows[std::clamp(sControlsSelected, 0, (int)rows.size() - 1)];
+		std::string help;
+		if (sCapture && sCaptureBlow)
+			help = "Hold two or more DualShock 4 buttons together, then let go.  (5 s: cancel)";
+		else if (sCapture)
+			help = std::string("Press the DualShock 4 button for ") + bindings[sCaptureBinding].label + "...  (5 s: cancel)";
+		else if (row.kind == CTL_BLOW && Now() < sBlowMessageUntil)
+			help = "Blowing needs two or more buttons held together: nothing changed.";
+		else if (row.kind == CTL_BLOW)
+			help = "Blowing into the GamePad's microphone while these are held together (their own actions wait). Cross: new buttons. Left/Right: Off / L2 + R2.";
+		else if (row.kind == CTL_PLAYER)
+			help = "Left/Right: the player to set up. Players 2-4: a second PS4 user signs in with their DualShock 4.";
+		else if (row.kind == CTL_KIND)
+			help = kind == KIND_WIIMOTE ? "Left/Right: the controller. Orientation (below): sideways or upright; touchpad: pointer." :
+				kind == KIND_NUNCHUK ? "Left/Right: the controller. Held upright: left stick = Nunchuk; touchpad: pointer." :
+				"Left/Right: the controller the game sees for this player.";
+		else if (row.kind == CTL_ORIENT)
+			help = "Sideways: D-pad on the left, 1 and 2 on Square and Cross (NES-style games). Upright: pointing at the TV. Buttons and tilt follow.";
+		else if (row.kind == CTL_SCOPE)
+			help = "This Game: a layout for this game only. All Games: the normal layout.";
+		else if (row.kind == CTL_RESET)
+			help = "Back to the default layout.";
+		else
+			help = "Cross: press a new button for it. Sticks: Left/Right to choose.";
+		dl->AddText(small, 24.0f, ImVec2(x0 + 50, H - 110), Rgba(TEXT, 0.7f * a), help.c_str());
+		dl->AddText(small, 24.0f, ImVec2(x0 + 50, H - 76), Rgba(TEXT, 0.5f * a), "Circle: back");
+	}
+
+	void Frame(sint32 imageX, sint32 imageY, sint32 imageWidth, sint32 imageHeight)
+	{
+		OrbisPadData data{};
+		const bool read = g_crema_pad_handle >= 0 && scePadReadState(g_crema_pad_handle, &data) == 0 && data.connected;
+		const uint32 b = read ? data.buttons : 0;
+		// L3 + R3: open, or close
+		const bool combo = (b & ORBIS_PAD_BUTTON_L3) && (b & ORBIS_PAD_BUTTON_R3);
+		if (combo && !sComboHeld && !sCapture)
+		{
+			sOpen = !sOpen;
+			sSelected = 0;
+			sControls = false;
+			ps4_boot_trace(sOpen ? "in-game menu: open" : "in-game menu: closed");
+		}
+		sComboHeld = combo;
+		const double now = Now();
+		const float dt = (float)std::clamp(now - sLastTime, 0.0, 0.1);
+		sLastTime = now;
+		sSlide += ((sOpen ? 1.0f : 0.0f) - sSlide) * (1.0f - std::exp(-16.0f * dt));
+		g_crema_menu_open = sOpen ? 1 : 0;
+		if (!sOpen && sSlide < 0.01f)
+		{
+			sHeld = 0;
+			return;
+		}
+
+		uint32 held = 0;
+		if (read)
+		{
+			if ((b & ORBIS_PAD_BUTTON_UP) || data.leftStick.y < 50)
+				held |= B_UP;
+			if ((b & ORBIS_PAD_BUTTON_DOWN) || data.leftStick.y > 205)
+				held |= B_DOWN;
+			if ((b & ORBIS_PAD_BUTTON_LEFT) || data.leftStick.x < 50)
+				held |= B_LEFT;
+			if ((b & ORBIS_PAD_BUTTON_RIGHT) || data.leftStick.x > 205)
+				held |= B_RIGHT;
+			if (b & ORBIS_PAD_BUTTON_CROSS)
+				held |= B_CROSS;
+			if (b & ORBIS_PAD_BUTTON_CIRCLE)
+				held |= B_CIRCLE;
+		}
+		uint32 pressed = held & ~sHeld;
+		constexpr uint32 directions = B_UP | B_DOWN | B_LEFT | B_RIGHT;
+		if ((held & directions) && (held & directions) == (sHeld & directions))
+		{
+			if (now >= sRepeat)
+			{
+				pressed |= held & directions;
+				sRepeat = now + 0.08;
+			}
+		}
+		else
+		{
+			sRepeat = now + 0.35;
+		}
+		sHeld = held;
+		const bool capturing = sOpen && UpdateCapture(data, read, now);
+		if (sOpen && !combo && !capturing && sControls)
+			ControlsInput(pressed, now);
+		else if (sOpen && !combo && !capturing)
+		{
+			if (pressed & B_UP)
+				sSelected = (sSelected + ROW_COUNT - 1) % ROW_COUNT;
+			if (pressed & B_DOWN)
+				sSelected = (sSelected + 1) % ROW_COUNT;
+			if (pressed & (B_LEFT | B_RIGHT))
+			{
+				if (sSelected != ROW_RESUME && sSelected != ROW_CONTROLS && sSelected != ROW_RESTART && sSelected != ROW_QUIT)
+					Change(sSelected, (pressed & B_LEFT) ? -1 : 1);
+			}
+			if (pressed & B_CROSS)
+				Change(sSelected, 1);
+			if (pressed & B_CIRCLE)
+				sOpen = false;
+		}
+
+		ImFont* title = ImGui_GetFont(44.0f);
+		ImFont* font = ImGui_GetFont(32.0f);
+		ImFont* small = ImGui_GetFont(24.0f);
+		if (!title || !font || !small)
+			return; // the fonts are made for the next frame
+		ImDrawList* dl = ImGui::GetForegroundDrawList();
+		const float W = (float)(imageX * 2 + imageWidth), H = (float)(imageY * 2 + imageHeight);
+		const float a = sSlide;
+		constexpr uint32 ACCENT = 0x9B7BFF, TEXT = 0xFFFFFF;
+		dl->AddRectFilled(ImVec2(0, 0), ImVec2(W, H), Rgba(0x000000, 0.45f * a));
+		const float width = 780.0f, x0 = W - width * a;
+		dl->AddRectFilled(ImVec2(x0, 0), ImVec2(W, H), Rgba(0x0B0A1A, 0.92f * a));
+		dl->AddLine(ImVec2(x0, 0), ImVec2(x0, H), Rgba(ACCENT, 0.9f * a), 2.0f);
+		if (sControls)
+		{
+			DrawControls(dl, title, font, small, x0, W, H, a, dt);
+			return;
+		}
+		dl->AddText(title, 44.0f, ImVec2(x0 + 50, 90), Rgba(TEXT, a), "Crema");
+		const std::string name = CafeSystem::GetForegroundTitleName();
+		dl->AddText(small, 24.0f, ImVec2(x0 + 52, 148), Rgba(ACCENT, a), name.c_str());
+		float y = 230.0f;
+		for (int row = 0; row < ROW_COUNT; row++, y += 64.0f)
+		{
+			if (row == ROW_RESTART)
+			{
+				dl->AddLine(ImVec2(x0 + 50, y - 8), ImVec2(W - 50, y - 8), Rgba(ACCENT, 0.35f * a), 1.5f);
+				y += 14.0f;
+			}
+			const bool sel = row == sSelected;
+			if (sel)
+				dl->AddRectFilled(ImVec2(x0 + 30, y - 6), ImVec2(W - 30, y + 52), Rgba(ACCENT, 0.30f * a), 10.0f);
+			dl->AddText(font, 32.0f, ImVec2(x0 + 60, y + 4), Rgba(TEXT, a), LabelOf(row));
+			const std::string value = ValueOf(row);
+			if (!value.empty())
+			{
+				const float tw = font->CalcTextSizeA(28.0f, FLT_MAX, 0.0f, value.c_str()).x;
+				dl->AddText(font, 28.0f, ImVec2(W - 70 - tw, y + 8), Rgba(TEXT, 0.85f * a), value.c_str());
+			}
+		}
+		dl->AddText(small, 24.0f, ImVec2(x0 + 50, H - 110), Rgba(TEXT, 0.7f * a),
+			"Cross: select    Left / Right: change    Circle or L3 + R3: back");
+		dl->AddText(small, 24.0f, ImVec2(x0 + 50, H - 76), Rgba(TEXT, 0.5f * a),
+			"The game keeps running while this menu is open.");
+	}
+} // namespace
