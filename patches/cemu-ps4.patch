+// The port's crash handler (port/ps4_crashlog.cpp), once crash.log is written: the note for the
+// launcher (only write(), as in a signal handler), then back into the launcher. Before a game
+// started (the launcher itself) there's no note and no restart.
+extern "C" void ps4_crash_note()
+{
+	if (sStopInfo[0])
+		WriteStopNote("The game crashed.", nullptr);
+}
+
+extern "C" void ps4_crash_restart()
+{
+	if (sStopInfo[0])
+		sceSystemServiceLoadExec("/app0/eboot.bin", nullptr);
+}
