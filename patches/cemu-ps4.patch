+	if (s_cremaTicksPerTsc && ActiveSettings::GetTimerShiftFactor() == 3)
+	{
+		const uint64 elapsed = __rdtsc() - s_cremaTscBase;
+		return (uint64)(((unsigned __int128)elapsed * s_cremaTicksPerTsc) >> 32);
