+	void Menu::DrawSidePanel(ImDrawList* dl, float dt)
+	{
+		Approach(m_panel.slide, m_panel.open ? 1.0f : 0.0f, 16.0f, dt);
+		if (m_panel.slide < 0.01f)
+			return;
+		const Theme& theme = CurrentTheme();
+		const float width = m_panel.rows.empty() ? 620.0f : 860.0f;
+		const float x0 = W - width * m_panel.slide;
+		const bool light = theme.text != 0xFFFFFF;
+		dl->AddRectFilled(ImVec2(x0, 0), ImVec2(W, H), light ? Rgba(0xFFFFFF, 0.85f * m_panel.slide) : Rgba(0x000000, 0.72f * m_panel.slide));
+		dl->AddLine(ImVec2(x0, 0), ImVec2(x0, H), Rgba(theme.wave, 0.8f * m_panel.slide), 2.0f);
+		const ImU32 text = Rgba(theme.text, m_panel.slide);
+		Text(dl, m_bold, 40, ImVec2(x0 + 50, 140), text, m_panel.title);
+		float y = 230;
+		if (!m_panel.options.empty())
+		{
+			for (size_t i = 0; i < m_panel.options.size(); i++, y += 62)
+			{
+				const bool sel = (int)i == m_panel.selected;
+				if (sel)
+					dl->AddRectFilled(ImVec2(x0 + 30, y - 6), ImVec2(W - 30, y + 52), Rgba(theme.wave, 0.30f * m_panel.slide), 10.0f);
+				Text(dl, sel ? m_bold : m_font, 34, ImVec2(x0 + 60, y), text, m_panel.options[i]);
+			}
+		}
+		for (const std::string& line : m_panel.lines)
+		{
+			Text(dl, m_font, 28, ImVec2(x0 + 50, y), text, line);
+			y += 42;
+		}
+		if (!m_panel.rows.empty())
+		{
+			// Settings list, scrolling with the selection; the setting's help text below it.
+			const float rowH = 58.0f, top = 220.0f, bottom = H - 200.0f;
+			const float visible = (bottom - top) / rowH;
+			const float target = std::clamp((float)m_panel.selected - visible * 0.5f + 1.0f, 0.0f,
+				std::max(0.0f, (float)m_panel.rows.size() - visible));
+			Approach(m_panel.scroll, target, 16.0f, dt);
+			dl->PushClipRect(ImVec2(x0, top - 8), ImVec2(W, bottom + 8), true);
+			for (size_t i = 0; i < m_panel.rows.size(); i++)
+			{
+				const SettingRow& row = m_panel.rows[i];
+				const float ry = top + ((float)i - m_panel.scroll) * rowH;
+				if (ry < top - rowH || ry > bottom)
+					continue;
+				if (row.header)
+				{
+					Text(dl, m_bold, 26, ImVec2(x0 + 50, ry + 14), Rgba(theme.wave, m_panel.slide), row.label, false);
+					dl->AddLine(ImVec2(x0 + 50, ry + 50), ImVec2(W - 50, ry + 50), Rgba(theme.wave, 0.35f * m_panel.slide), 1.5f);
+					continue;
+				}
+				const bool sel = (int)i == m_panel.selected;
+				if (sel)
+					dl->AddRectFilled(ImVec2(x0 + 30, ry - 4), ImVec2(W - 30, ry + 50), Rgba(theme.wave, 0.30f * m_panel.slide), 10.0f);
+				// long names (graphic packs and their presets) end in ... before the value
+				const float tw = TextWidth(m_font, 28, row.value);
+				ImFont* labelFont = sel ? m_bold : m_font;
+				const float labelSize = sel ? 32.0f : 30.0f;
+				const float room = W - 70 - tw - 30 - (x0 + 60);
+				std::string label = row.label;
+				if (TextWidth(labelFont, labelSize, label) > room)
+				{
+					while (!label.empty() && TextWidth(labelFont, labelSize, label + "...") > room)
+					{
+						label.pop_back();
+						while (!label.empty() && ((unsigned char)label.back() & 0xC0) == 0x80)
+							label.pop_back(); // a whole UTF-8 character
+					}
+					label += "...";
+				}
+				Text(dl, labelFont, labelSize, ImVec2(x0 + 60, ry + 4), text, label);
+				const ImU32 colour = row.note ? Rgba(0xFFC870, m_panel.slide) : text;
+				Text(dl, m_font, 28, ImVec2(W - 70 - tw, ry + 7), colour, row.value);
+			}
+			dl->PopClipRect();
+			if (m_panel.selected >= 0 && m_panel.selected < (int)m_panel.rows.size())
+			{
+				const SettingRow& row = m_panel.rows[m_panel.selected];
+				std::string help;
+				if (row.key.rfind("dir:", 0) == 0)
+					help = "Cross: open this folder.";
+				else if (row.key == "usedir")
+					help = "Cross: look for games in this folder.";
+				else if (row.scope)
+					help = "All Games: this game follows the global settings. This Game: its own.";
+				else if (!row.help.empty())
+					help = row.help;
+				else if (const CremaSettings::Setting* setting = CremaSettings::Find(row.key))
+					help = std::string(setting->help) + (setting->live ? "" : " (Next game start.)");
+				const std::string wrapped = WrapText(m_font, 25, PS4Lang::T(help), width - 100);
+				dl->AddText(m_font, 25, ImVec2(x0 + 50, bottom + 24), Rgba(theme.text, 0.8f * m_panel.slide), wrapped.c_str());
+			}
+		}
+	}
