+// The Crema launcher, ported from DolphinPS4's PS4XMB (cover-flow Library and PSP-style XMB, side
+// panels, themes, wallpapers, sounds, languages). Kept from it: the menus, the game library, the
+// settings lists (CremaSettings, global or per game), themes and wallpapers, the game folder
+// browser, "played" times, the default game. Left out (no Wii U equivalent): memory cards, cheats,
+// Riivolution, the game settings center and the updater.
+#include "gui/ps4/launcher/Launcher.h"
+
+#include "gui/ps4/launcher/CremaCovers.h"
+#include "gui/ps4/launcher/CremaSettings.h"
+#include "gui/ps4/launcher/LauncherDisplay.h"
+#include "gui/ps4/launcher/PS4Glyphs.h"
+#include "gui/ps4/launcher/PS4Lang.h"
+
+#include "Cafe/Filesystem/fsc.h"
+#include "Cafe/TitleList/TitleInfo.h"
+
+#include <imgui.h>
+#include <imgui_internal.h>
+#include <png.h>
+#include <turbojpeg.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <ctime>
+#include <fstream>
+#include <map>
+#include <thread>
+
+#include <orbis/AudioOut.h>
+#include <orbis/Pad.h>
+#include <orbis/SystemService.h>
+#include <orbis/UserService.h>
+
+extern "C" void ps4_boot_trace(const char* line); // port/ps4_crashlog.cpp
+extern "C" int g_crema_pad_handle;                // input/api/PS4/PS4PadController.cpp
+
+namespace CremaLauncher
+{
+namespace
+{
+	using Clock = std::chrono::steady_clock;
+	constexpr float W = (float)Display::WIDTH;
+	constexpr float H = (float)Display::HEIGHT;
+
+	// The launcher's own log (/data/CemuPS4/launcher.log): log.txt and the boot trace start over
+	// when the app restarts into a game.
+	FILE* s_log = nullptr;
+
+	void Log(const std::string& text)
+	{
+		ps4_boot_trace(("launcher: " + text).c_str());
+		if (s_log)
+		{
+			fprintf(s_log, "%s\n", text.c_str());
+			fflush(s_log);
+		}
+	}
+
+	std::string ReadFile(const std::string& path)
+	{
+		std::ifstream file(path, std::ios::binary);
+		return std::string(std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>());
+	}
+
+	ImU32 Rgba(uint32_t rgb, float alpha = 1.0f)
+	{
+		return IM_COL32((rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, rgb & 0xFF, (int)(std::clamp(alpha, 0.0f, 1.0f) * 255.0f));
+	}
+
+	// A quad with a colour per corner (ImGui has the rectangle version only).
+	void QuadMultiColor(ImDrawList* dl, ImVec2 a, ImVec2 b, ImVec2 c, ImVec2 d, ImU32 ca, ImU32 cb, ImU32 cc, ImU32 cd)
+	{
+		const ImVec2 uv = dl->_Data->TexUvWhitePixel;
+		dl->PrimReserve(6, 4);
+		const ImDrawIdx idx = (ImDrawIdx)dl->_VtxCurrentIdx;
+		dl->PrimWriteIdx(idx);
+		dl->PrimWriteIdx((ImDrawIdx)(idx + 1));
+		dl->PrimWriteIdx((ImDrawIdx)(idx + 2));
+		dl->PrimWriteIdx(idx);
+		dl->PrimWriteIdx((ImDrawIdx)(idx + 2));
+		dl->PrimWriteIdx((ImDrawIdx)(idx + 3));
+		dl->PrimWriteVtx(a, uv, ca);
+		dl->PrimWriteVtx(b, uv, cb);
+		dl->PrimWriteVtx(c, uv, cc);
+		dl->PrimWriteVtx(d, uv, cd);
+	}
+
+	// A textured quad with a colour per corner (the Library's cover reflections fade out).
+	void ImageQuadColors(ImDrawList* dl, ImTextureID texture, ImVec2 a, ImVec2 b, ImVec2 c, ImVec2 d, ImVec2 uvA,
+		ImVec2 uvB, ImVec2 uvC, ImVec2 uvD, ImU32 ca, ImU32 cb, ImU32 cc, ImU32 cd)
+	{
+		dl->PushTextureID(texture);
+		dl->PrimReserve(6, 4);
+		const ImDrawIdx idx = (ImDrawIdx)dl->_VtxCurrentIdx;
+		dl->PrimWriteIdx(idx);
+		dl->PrimWriteIdx((ImDrawIdx)(idx + 1));
+		dl->PrimWriteIdx((ImDrawIdx)(idx + 2));
+		dl->PrimWriteIdx(idx);
+		dl->PrimWriteIdx((ImDrawIdx)(idx + 2));
+		dl->PrimWriteIdx((ImDrawIdx)(idx + 3));
+		dl->PrimWriteVtx(a, uvA, ca);
+		dl->PrimWriteVtx(b, uvB, cb);
+		dl->PrimWriteVtx(c, uvC, cc);
+		dl->PrimWriteVtx(d, uvD, cd);
+		dl->PopTextureID();
+	}
+
+	// ImDrawList::AddEllipseFilled (ImGui 1.90+).
+	void EllipseFilled(ImDrawList* dl, ImVec2 c, ImVec2 r, ImU32 color, int segments)
+	{
+		for (int i = 0; i < segments; i++)
+		{
+			const float a = i * 6.2831853f / segments;
+			dl->PathLineTo(ImVec2(c.x + std::cos(a) * r.x, c.y + std::sin(a) * r.y));
+		}
+		dl->PathFillConvex(color);
+	}
+
+	// An image rotated by `angle` around its centre `c`, w x h.
+	void RotatedImage(ImDrawList* dl, ImTextureID texture, ImVec2 c, float w, float h, float angle, ImU32 color)
+	{
+		const float cs = std::cos(angle), sn = std::sin(angle);
+		auto corner = [&](float x, float y) { return ImVec2(c.x + x * cs - y * sn, c.y + x * sn + y * cs); };
+		dl->AddImageQuad(texture, corner(-w / 2, -h / 2), corner(w / 2, -h / 2), corner(w / 2, h / 2), corner(-w / 2, h / 2),
+			ImVec2(0, 0), ImVec2(1, 0), ImVec2(1, 1), ImVec2(0, 1), color);
+	}
+
+	// "Played today", "Played 3 days ago", ...
+	std::string PlayedText(int64_t when)
+	{
+		if (when <= 0)
+			return "Not played yet";
+		const std::time_t now = std::time(nullptr), then = (std::time_t)when;
+		std::tm today = {}, day = {};
+		localtime_r(&now, &today);
+		localtime_r(&then, &day);
+		today.tm_hour = day.tm_hour = 12;
+		today.tm_min = day.tm_min = today.tm_sec = day.tm_sec = 0;
+		const long days = std::lround(std::difftime(std::mktime(&today), std::mktime(&day)) / 86400.0);
+		if (days <= 0)
+			return "Played today";
+		if (days == 1)
+			return "Played yesterday";
+		if (days < 7)
+			return "Played " + std::to_string(days) + " days ago";
+		char text[48];
+		std::strftime(text, sizeof(text), "Played %b %e, %Y", &day);
+		return text;
+	}
+
+	// Moves `value` towards `target` (frame-rate independent exponential smoothing).
+	void Approach(float& value, float target, float rate, float dt)
+	{
+		value += (target - value) * (1.0f - std::exp(-rate * dt));
+	}
+
+	// PNG -> RGBA8 (libpng's simplified API).
+	bool DecodePng(const std::string& data, std::vector<uint8>& rgba, uint32_t& width, uint32_t& height)
+	{
+		png_image image = {};
+		image.version = PNG_IMAGE_VERSION;
+		if (!png_image_begin_read_from_memory(&image, data.data(), data.size()))
+			return false;
+		image.format = PNG_FORMAT_RGBA;
+		rgba.resize(PNG_IMAGE_SIZE(image));
+		if (!png_image_finish_read(&image, nullptr, rgba.data(), 0, nullptr))
+		{
+			png_image_free(&image);
+			return false;
+		}
+		width = image.width;
+		height = image.height;
+		return true;
+	}
+
+	// JPEG (GameTDB's Wii U covers) -> RGBA8 (libjpeg-turbo).
+	bool DecodeJpeg(const std::string& data, std::vector<uint8>& rgba, uint32_t& width, uint32_t& height)
+	{
+		tjhandle decoder = tjInitDecompress();
+		if (!decoder)
+			return false;
+		int w = 0, h = 0, subsampling = 0, colorspace = 0;
+		bool ok = tjDecompressHeader3(decoder, (const unsigned char*)data.data(), (unsigned long)data.size(), &w, &h,
+					  &subsampling, &colorspace) == 0 && w > 0 && h > 0 && w <= 4096 && h <= 4096;
+		if (ok)
+		{
+			rgba.resize((size_t)w * h * 4);
+			ok = tjDecompress2(decoder, (const unsigned char*)data.data(), (unsigned long)data.size(), rgba.data(), w, 0, h,
+					 TJPF_RGBA, 0) == 0;
+			width = (uint32_t)w;
+			height = (uint32_t)h;
+		}
+		tjDestroy(decoder);
+		return ok;
+	}
+
+	// TGA (the Wii U's meta/iconTex.tga: 24 or 32 bit, plain or RLE) -> RGBA8.
+	bool DecodeTga(const std::vector<uint8>& data, std::vector<uint8>& rgba, uint32_t& width, uint32_t& height)
+	{
+		if (data.size() < 18)
+			return false;
+		const uint8 type = data[2], bpp = data[16], descriptor = data[17];
+		width = data[12] | (data[13] << 8);
+		height = data[14] | (data[15] << 8);
+		const uint32_t bytes = bpp / 8;
+		if ((type != 2 && type != 10) || (bytes != 3 && bytes != 4) || width == 0 || height == 0 || width > 1024 || height > 1024)
+			return false;
+		const size_t pixels = (size_t)width * height;
+		std::vector<uint8> raw(pixels * bytes);
+		size_t at = 18 + data[0];
+		if (type == 2)
+		{
+			if (at + raw.size() > data.size())
+				return false;
+			std::copy(data.begin() + at, data.begin() + at + raw.size(), raw.begin());
+		}
+		else
+		{
+			for (size_t out = 0; out < raw.size() && at < data.size();)
+			{
+				const uint8 header = data[at++];
+				const size_t count = (header & 0x7F) + 1;
+				if (header & 0x80)
+				{
+					if (at + bytes > data.size())
+						return false;
+					for (size_t i = 0; i < count && out < raw.size(); i++, out += bytes)
+						std::copy(data.begin() + at, data.begin() + at + bytes, raw.begin() + out);
+					at += bytes;
+				}
+				else
+				{
+					const size_t length = std::min(count * bytes, raw.size() - out);
+					if (at + length > data.size())
+						return false;
+					std::copy(data.begin() + at, data.begin() + at + length, raw.begin() + out);
+					at += length;
+					out += length;
+				}
+			}
+		}
+		rgba.resize(pixels * 4);
+		const bool topDown = descriptor & 0x20;
+		for (uint32_t y = 0; y < height; y++)
+		{
+			const uint32_t srcY = topDown ? y : height - 1 - y;
+			for (uint32_t x = 0; x < width; x++)
+			{
+				const uint8* s = &raw[((size_t)srcY * width + x) * bytes];
+				uint8* d = &rgba[((size_t)y * width + x) * 4];
+				d[0] = s[2];
+				d[1] = s[1];
+				d[2] = s[0];
+				d[3] = bytes == 4 ? s[3] : 255;
+			}
+		}
+		return true;
+	}
+
+	// ---------------------------------------------------------------------------------------------
+	// Sounds: 16-bit PCM WAV files mixed into one 48 kHz stereo AudioOut port.
+
+	struct Sound
+	{
+		std::vector<int16_t> frames; // interleaved stereo, 48 kHz
+	};
+
+	std::unique_ptr<Sound> LoadWav(const std::string& path)
+	{
+		const std::string data = ReadFile(path);
+		if (data.size() < 44 || data.compare(0, 4, "RIFF") != 0 || data.compare(8, 4, "WAVE") != 0)
+			return nullptr;
+		int channels = 0, rate = 0, bits = 0;
+		const char* samples = nullptr;
+		size_t sampleBytes = 0;
+		for (size_t at = 12; at + 8 <= data.size();)
+		{
+			uint32_t size;
+			std::memcpy(&size, data.data() + at + 4, 4);
+			const std::string id = data.substr(at, 4);
+			if (id == "fmt " && size >= 16)
+			{
+				uint16_t format, ch, bps;
+				uint32_t sr;
+				std::memcpy(&format, data.data() + at + 8, 2);
+				std::memcpy(&ch, data.data() + at + 10, 2);
+				std::memcpy(&sr, data.data() + at + 12, 4);
+				std::memcpy(&bps, data.data() + at + 22, 2);
+				if (format != 1)
+					return nullptr;
+				channels = ch;
+				rate = (int)sr;
+				bits = bps;
+			}
+			else if (id == "data")
+			{
+				samples = data.data() + at + 8;
+				sampleBytes = std::min<size_t>(size, data.size() - at - 8);
+			}
+			at += 8 + size + (size & 1);
+		}
+		if (!samples || bits != 16 || (channels != 1 && channels != 2) || rate <= 0)
+			return nullptr;
+		const size_t inFrames = sampleBytes / (2 * channels);
+		auto sound = std::make_unique<Sound>();
+		const double step = (double)rate / 48000.0;
+		const size_t outFrames = (size_t)(inFrames / step);
+		sound->frames.resize(outFrames * 2);
+		for (size_t i = 0; i < outFrames; i++)
+		{
+			const size_t src = std::min(inFrames - 1, (size_t)(i * step));
+			int16_t l, r;
+			std::memcpy(&l, samples + src * 2 * channels, 2);
+			if (channels == 2)
+				std::memcpy(&r, samples + src * 4 + 2, 2);
+			else
+				r = l;
+			sound->frames[i * 2] = l;
+			sound->frames[i * 2 + 1] = r;
+		}
+		return sound;
+	}
+
+	class Audio
+	{
+	public:
+		void Start()
+		{
+			const int init = sceAudioOutInit();
+			// The system user: any user hears the main port.
+			m_port = sceAudioOutOpen(0xFF, ORBIS_AUDIO_OUT_PORT_TYPE_MAIN, 0, FRAMES, 48000, ORBIS_AUDIO_OUT_PARAM_FORMAT_S16_STEREO);
+			Log(fmt::format("audio: init {:#x}, port {:#x}", (unsigned)init, (unsigned)m_port));
+			if (m_port < 0)
+				return;
+			int32_t levels[2] = {32768, 32768}; // 0 dB on front left and right
+			sceAudioOutSetVolume(m_port, 0x3, levels);
+			m_thread = std::thread([this] { Loop(); });
+		}
+		void Stop()
+		{
+			m_stop = true;
+			if (m_thread.joinable())
+				m_thread.join();
+			if (m_port >= 0)
+				sceAudioOutClose(m_port);
+			m_port = -1;
+		}
+		void Play(const Sound* sound)
+		{
+			if (!sound || !m_enabled)
+				return;
+			std::lock_guard lock(m_mutex);
+			m_voices.push_back({sound, 0});
+		}
+		void SetEnabled(bool enabled) { m_enabled = enabled; }
+		void SetVolume(int percent) { m_volume = std::clamp(percent, 0, 100); }
+
+	private:
+		static constexpr uint32_t FRAMES = 256;
+		struct Voice
+		{
+			const Sound* sound;
+			size_t position; // in frames
+		};
+		void Loop()
+		{
+			std::vector<int16_t> buffer(FRAMES * 2);
+			std::vector<int32_t> mix(FRAMES * 2);
+			while (!m_stop)
+			{
+				std::fill(mix.begin(), mix.end(), 0);
+				{
+					std::lock_guard lock(m_mutex);
+					for (Voice& voice : m_voices)
+					{
+						const size_t total = voice.sound->frames.size() / 2;
+						for (uint32_t i = 0; i < FRAMES && voice.position < total; i++, voice.position++)
+						{
+							mix[i * 2] += voice.sound->frames[voice.position * 2];
+							mix[i * 2 + 1] += voice.sound->frames[voice.position * 2 + 1];
+						}
+					}
+					std::erase_if(m_voices, [](const Voice& v) { return v.position >= v.sound->frames.size() / 2; });
+				}
+				const int volume = m_volume;
+				for (size_t i = 0; i < mix.size(); i++)
+					buffer[i] = (int16_t)std::clamp(mix[i] * volume / 100, -32768, 32767);
+				sceAudioOutOutput(m_port, buffer.data());
+			}
+		}
+		int m_port = -1;
+		std::thread m_thread;
+		std::atomic<bool> m_stop{false};
+		std::atomic<bool> m_enabled{true};
+		std::atomic<int> m_volume{80};
+		std::mutex m_mutex;
+		std::vector<Voice> m_voices;
+	};
+
+	// ---------------------------------------------------------------------------------------------
+	// Pad: buttons with edge detection and auto-repeat for the directions (D-pad or left stick).
+
+	enum Button : uint32_t
+	{
+		BTN_UP = 1 << 0,
+		BTN_DOWN = 1 << 1,
+		BTN_LEFT = 1 << 2,
+		BTN_RIGHT = 1 << 3,
+		BTN_CROSS = 1 << 4,
+		BTN_CIRCLE = 1 << 5,
+		BTN_TRIANGLE = 1 << 6,
+		BTN_SQUARE = 1 << 7,
+		BTN_L1 = 1 << 8,
+		BTN_R1 = 1 << 9,
+		BTN_OPTIONS = 1 << 10,
+	};
+
+	class Input
+	{
+	public:
+		void Open(int user)
+		{
+			// Cemu's DualShock 4 provider has the user's pad open already (it opens once).
+			m_pad = g_crema_pad_handle;
+			if (m_pad < 0)
+			{
+				scePadInit();
+				m_pad = scePadOpen(user, 0, 0, nullptr);
+			}
+			if (m_pad < 0)
+				Log("no pad");
+		}
+		// Buttons that went down this frame (directions repeat while held).
+		uint32_t Poll(float dt)
+		{
+			uint32_t held = 0;
+			if (m_pad >= 0)
+			{
+				OrbisPadData data = {};
+				if (scePadReadState(m_pad, &data) == 0 && data.connected)
+				{
+					const uint32_t b = data.buttons;
+					if ((b & ORBIS_PAD_BUTTON_UP) || data.leftStick.y < 50)
+						held |= BTN_UP;
+					if ((b & ORBIS_PAD_BUTTON_DOWN) || data.leftStick.y > 205)
+						held |= BTN_DOWN;
+					if ((b & ORBIS_PAD_BUTTON_LEFT) || data.leftStick.x < 50)
+						held |= BTN_LEFT;
+					if ((b & ORBIS_PAD_BUTTON_RIGHT) || data.leftStick.x > 205)
+						held |= BTN_RIGHT;
+					if (b & ORBIS_PAD_BUTTON_CROSS)
+						held |= BTN_CROSS;
+					if (b & ORBIS_PAD_BUTTON_CIRCLE)
+						held |= BTN_CIRCLE;
+					if (b & ORBIS_PAD_BUTTON_TRIANGLE)
+						held |= BTN_TRIANGLE;
+					if (b & ORBIS_PAD_BUTTON_SQUARE)
+						held |= BTN_SQUARE;
+					if (b & ORBIS_PAD_BUTTON_L1)
+						held |= BTN_L1;
+					if (b & ORBIS_PAD_BUTTON_R1)
+						held |= BTN_R1;
+					if (b & ORBIS_PAD_BUTTON_OPTIONS)
+						held |= BTN_OPTIONS;
+				}
+			}
+			uint32_t pressed = held & ~m_held;
+			constexpr uint32_t directions = BTN_UP | BTN_DOWN | BTN_LEFT | BTN_RIGHT;
+			if ((held & directions) && (held & directions) == (m_held & directions))
+			{
+				m_repeat -= dt;
+				if (m_repeat <= 0.0f)
+				{
+					pressed |= held & directions;
+					m_repeat = 0.075f;
+				}
+			}
+			else
+			{
+				m_repeat = 0.35f;
+			}
+			m_held = held;
+			return pressed;
+		}
+
+	private:
+		int m_pad = -1;
+		uint32_t m_held = 0;
+		float m_repeat = 0.35f;
+	};
