+	// The GamePad microphone's blow (Captain Toad, ...) on two or more DualShock 4 controls held
+	// together (VPADController.cpp); crema.ini blow_combo: the controls' ids joined by '+', or off.
+	// Default: L2 + R2.
+	constexpr uint32 kBlowNone = 0xFFFFFFFF;
+	const std::vector<uint32> kBlowDefault = {(uint32)kTriggerXP, (uint32)kTriggerYP};
+
+	std::vector<uint32> BlowCombo()
+	{
+		std::vector<uint32> combo;
+		for (auto& button : g_crema_blow_buttons)
+		{
+			const uint32 value = button.load();
+			if (value != kBlowNone)
+				combo.push_back(value);
+		}
+		return combo;
+	}
+
+	void UseBlowCombo(const std::vector<uint32>& combo)
+	{
+		for (size_t i = 0; i < std::size(g_crema_blow_buttons); i++)
+			g_crema_blow_buttons[i].store(i < combo.size() && combo.size() >= 2 ? combo[i] : kBlowNone);
+	}
+
+	void SetBlowCombo(const std::vector<uint32>& combo)
+	{
+		UseBlowCombo(combo);
+		std::string text;
+		for (uint32 button : BlowCombo())
+			text += (text.empty() ? "" : "+") + std::to_string(button);
+		CremaSettings::Set("blow_combo", text.empty() ? "off" : text);
+		ps4_boot_trace(fmt::format("in-game menu: blow on {}", text.empty() ? "nothing" : text).c_str());
+	}
+
+	void LoadBlowCombo()
+	{
+		const std::string text = CremaSettings::Get("blow_combo");
+		if (text.empty())
+		{
+			UseBlowCombo(kBlowDefault);
+			return;
+		}
+		std::vector<uint32> combo;
+		size_t start = 0;
+		while (start < text.size() && combo.size() < std::size(g_crema_blow_buttons))
+		{
+			const size_t end = text.find('+', start);
+			const std::string part = text.substr(start, end == std::string::npos ? std::string::npos : end - start);
+			if (!part.empty() && part.find_first_not_of("0123456789") == std::string::npos)
+				combo.push_back((uint32)std::stoul(part));
+			if (end == std::string::npos)
+				break;
+			start = end + 1;
+		}
+		UseBlowCombo(combo); // "off" or fewer than two: none
+	}
