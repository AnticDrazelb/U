+	// What to boot: launch.txt (written by the launcher or by hand) starts that game once; else
+	// the default game (unless L1 is held); else the launcher, which writes launch.txt and
+	// restarts the app (the menu and the emulator never share a process).
+	fs::path PickGame()
+	{
+		const fs::path launchFile = kDataRoot / "launch.txt";
+		std::error_code ec;
+		if (fs::exists(launchFile, ec))
+		{
+			std::string line;
+			{
+				std::ifstream launch(launchFile);
+				std::getline(launch, line);
+			}
+			fs::remove(launchFile, ec);
+			boost::algorithm::trim(line);
+			if (!line.empty())
+				return _utf8ToPath(line);
+		}
+		const std::string defaultGame = CremaLauncher::DefaultGame(_pathToUtf8(kDataRoot));
+		if (!defaultGame.empty() && fs::exists(_utf8ToPath(defaultGame), ec))
+		{
+			if (!MenuButtonHeld())
+			{
+				Trace("default game: " + defaultGame);
+				return _utf8ToPath(defaultGame);
+			}
+			Trace("default game skipped (L1 held): the launcher");
+		}
+		const std::string picked = CremaLauncher::Run(_pathToUtf8(kDataRoot), _pathToUtf8(kAppRoot), AppVersion());
+		if (picked.empty())
+		{
+			Trace("launcher unavailable: starting the first game");
+			return FindFirstGame();
+		}
+		{
+			std::ofstream launch(launchFile, std::ios::trunc);
+			launch << picked << "\n";
+		}
+		Trace("launcher: restarting into " + picked);
+		const int result = sceSystemServiceLoadExec("/app0/eboot.bin", nullptr);
+		// still here: the restart failed, so the game starts in this process
+		Trace(fmt::format("launcher: restart failed ({:#x}), starting the game here", (uint32)result));
+		fs::remove(launchFile, ec);
+		return _utf8ToPath(picked);
+	}
+
+	// MainWindow::FileLoad without the dialogs
+	// the update and DLC the launcher found next to this game (data_dir/title-extras.txt: "<game>\t<title>"),
+	// added to Cemu's title list so they mount as if installed
+	void AddTitleExtras(const fs::path& launchPath)
+	{
+		std::ifstream file(kDataRoot / "title-extras.txt");
+		const std::string game = _pathToUtf8(launchPath);
+		std::string line;
+		while (std::getline(file, line))
+		{
+			const size_t tab = line.find('\t');
+			if (tab == std::string::npos || line.compare(0, tab, game) != 0 || tab != game.size())
+				continue;
+			const std::string extra = line.substr(tab + 1);
+			Trace("title: with " + extra);
+			CafeTitleList::AddTitleFromPath(_utf8ToPath(extra));
+		}
+	}
+
+	bool PrepareTitle(const fs::path& launchPath)
+	{
+		TitleInfo launchTitle{launchPath};
+		if (launchTitle.IsValid())
+		{
+			CafeTitleList::AddTitleFromPath(launchPath);
+			AddTitleExtras(launchPath);
+			TitleId baseTitleId;
+			if (!CafeTitleList::FindBaseTitleId(launchTitle.GetAppTitleId(), baseTitleId))
+			{
+				Trace("the base files of this title were not found");
+				return false;
+			}
+			const auto r = CafeSystem::PrepareForegroundTitle(baseTitleId);
+			if (r != CafeSystem::PREPARE_STATUS_CODE::SUCCESS)
+			{
+				Trace(fmt::format("preparing the title failed ({})", (int)r));
+				return false;
+			}
+			return true;
+		}
+		const CafeTitleFileType fileType = DetermineCafeSystemFileType(launchPath);
+		if (fileType == CafeTitleFileType::RPX || fileType == CafeTitleFileType::ELF)
+		{
+			if (CafeSystem::PrepareForegroundTitleFromStandaloneRPX(launchPath) != CafeSystem::PREPARE_STATUS_CODE::SUCCESS)
+			{
+				Trace("preparing the executable failed");
+				return false;
+			}
+			return true;
+		}
+		Trace(fmt::format("not a launchable title (reason {})", (int)launchTitle.GetInvalidReason()));
+		return false;
+	}
+
+	// The old folder from before the app was renamed (/data/CemuPS4) when the new one already
+	// existed, so it wasn't simply renamed (port/ps4_crashlog.cpp): what isn't in the new one yet
+	// is moved over, entry by entry.
+	void MergeOldDataFolder()
+	{
+		const fs::path old = "/data/CemuPS4";
+		std::error_code ec;
+		if (!fs::is_directory(old, ec))
+			return;
+		int moved = 0;
+		for (const auto& entry : fs::directory_iterator(old, ec))
+		{
+			const fs::path target = kDataRoot / entry.path().filename();
+			if (fs::exists(target, ec))
+			{
+				// a folder in both (games, mlc01, ...): what's only in the old one
+				if (entry.is_directory(ec) && fs::is_directory(target, ec))
+					for (const auto& inner : fs::directory_iterator(entry.path(), ec))
+						if (!fs::exists(target / inner.path().filename(), ec))
+						{
+							fs::rename(inner.path(), target / inner.path().filename(), ec);
+							moved += ec ? 0 : 1;
+						}
+				continue;
+			}
+			fs::rename(entry.path(), target, ec);
+			moved += ec ? 0 : 1;
+		}
+		// paths kept in files (last and default game, games folder, ...) to the new place
+		for (const char* name : {"launcher.ini", "launch.txt", "played.ini", "settings.xml"})
+		{
+			const fs::path path = kDataRoot / name;
+			std::string text;
+			{
+				std::ifstream in(path, std::ios::binary);
+				text.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+			}
+			if (text.find("/data/CemuPS4") == std::string::npos)
+				continue;
+			boost::replace_all(text, "/data/CemuPS4", _pathToUtf8(kDataRoot));
+			std::ofstream(path, std::ios::binary | std::ios::trunc) << text;
+		}
+		Trace(fmt::format("moved {} entries from /data/CemuPS4 into {}", moved, _pathToUtf8(kDataRoot)));
+	}
+
+	void Run()
+	{
+		LoadSystemModules();
+		Trace("Crema starting");
+		{
+			// how many files the app may have open (1.67: a freeze when opening files began to fail)
+			struct rlimit files;
+			if (getrlimit(RLIMIT_NOFILE, &files) == 0)
+				Trace(fmt::format("open file limit: {} (hard {})", (long long)files.rlim_cur, (long long)files.rlim_max));
+			// the real one: duplicate a descriptor until the system refuses (1.71 hit EMFILE at ~268)
+			const int probe = open("/app0/eboot.bin", O_RDONLY);
+			if (probe >= 0)
+			{
+				std::vector<int> extra;
+				for (int i = 0; i < 4096; i++)
+				{
+					const int fd = dup(probe);
+					if (fd < 0)
+						break;
+					extra.push_back(fd);
+				}
+				const int err = errno;
+				int highest = probe;
+				for (int fd : extra)
+					highest = std::max(highest, fd);
+				Trace(fmt::format("open file probe: {} more descriptors before errno {} (highest {})", extra.size(), err, highest));
+				for (int fd : extra)
+					close(fd);
+				close(probe);
+			}
+		}
+		MergeOldDataFolder();
+
+		std::error_code ec;
+		fs::create_directories(kDataRoot / "games", ec);
+		std::set<fs::path> failedWriteAccess;
+		ActiveSettings::SetPaths(false, kAppRoot / "eboot.bin", kDataRoot, kDataRoot, kDataRoot / "cache", kAppRoot, failedWriteAccess);
+		for (auto& path : failedWriteAccess)
+			Trace(fmt::format("cannot write to {}", _pathToUtf8(path)));
+		fs::create_directories(ActiveSettings::GetConfigPath("controllerProfiles"), ec);
+
+		GetConfigHandle().SetFilename(ActiveSettings::GetConfigPath("settings.xml").generic_wstring());
+		const bool firstStart = !fs::exists(ActiveSettings::GetConfigPath("settings.xml"), ec);
+		NetworkConfig::LoadOnce();
+		if (!firstStart)
+			GetConfigHandle().Load();
+		else
+		{
+			GetConfig().graphic_api = GraphicAPI::kVulkan;
+			GetConfigHandle().Save();
+		}
+		// the online world's console files and account in place before Cemu reads them
+		// (CremaOnline.h): Pretendo's, the private server's, or the offline ones
+		CremaSettings::Load(_pathToUtf8(kDataRoot));
+		CremaSettings::MountNetworkLibrary();
+		CremaOnline::CreateFolders(_pathToUtf8(kDataRoot), _pathToUtf8(ActiveSettings::GetMlcPath()));
+		Trace(CremaOnline::Stage(_pathToUtf8(kDataRoot), _pathToUtf8(ActiveSettings::GetMlcPath()), CremaSettings::Get("online")));
+		if (!CreateDefaultMLCFiles(ActiveSettings::GetMlcPath()))
+			Trace(fmt::format("cannot create the mlc folders in {}", _pathToUtf8(ActiveSettings::GetMlcPath())));
+		ActiveSettings::Init();
+		LatteOverlay_init();
+		Trace("common init");
+		CemuCommonInit();
+
+		// first start: the DualShock 4 becomes the Wii U GamePad (controllerProfiles/controller0.xml)
+		auto& inputManager = InputManager::instance();
+		if (!inputManager.get_controller(0))
+		{
+			try
+			{
+				auto pad = ControllerFactory::CreateController(InputAPI::PS4Pad, "0", "DualShock 4");
+				auto gamepad = inputManager.set_controller(0, EmulatedController::Type::VPAD, pad);
+				if (gamepad)
+				{
+					gamepad->set_default_mapping(pad);
+					inputManager.save(0);
+					Trace("DualShock 4 mapped to the Wii U GamePad");
+				}
+			}
+			catch (const std::exception& ex)
+			{
+				Trace(fmt::format("controller setup failed: {}", ex.what()));
+			}
+		}
+		PS4PauseMenu::SetupPlayers(); // players 2-4 (local multiplayer)
+		CremaSettings::Load(_pathToUtf8(kDataRoot));
+		CremaSettings::MountNetworkLibrary();
+		// the private server: Cemu's online requests go through its proxy (pretendo-docker's
+		// mitmproxy sends Pretendo's names to the server); Cemu's config was loaded again above
+		const std::string onlineWorld = CremaSettings::Get("online");
+		GetConfig().proxy_server = onlineWorld == "private" ? CremaOnline::ProxyUrl(CremaSettings::Get("online_server")) : std::string();
+		if (!GetConfig().proxy_server.GetValue().empty())
+		{
+			// and the games' own web requests (nlibcurl: libcurl reads these when a request has no proxy)
+			setenv("http_proxy", GetConfig().proxy_server.GetValue().c_str(), 1);
+			setenv("https_proxy", GetConfig().proxy_server.GetValue().c_str(), 1);
+		}
+
+		sWindowInfo.app_active = true;
+		sWindowInfo.width = sWindowInfo.phys_width = kWidth;
+		sWindowInfo.height = sWindowInfo.phys_height = kHeight;
+		sWindowInfo.dpi_scale = 1.0;
+		sWindowInfo.pad_open = false;
+		sWindowInfo.is_fullscreen = true;
+
+		if (!InitializeGlobalVulkan())
+		{
+			Trace("Vulkan (RADV) is not available");
+			return;
+		}
+
+		const fs::path game = PickGame();
+		if (game.empty())
+		{
+			Trace(fmt::format("no game: put one in {} or its path in {}", _pathToUtf8(kDataRoot / "games"), _pathToUtf8(kDataRoot / "launch.txt")));
+			return;
+		}
+		Trace(fmt::format("game: {}", _pathToUtf8(game)));
+		if (!PrepareTitle(game))
+			return;
+		Trace(fmt::format("title prepared: {}", CafeSystem::GetForegroundTitleName()));
+		// Crema's settings for this title (crema.ini) over Cemu's config and the game's profile
+		const uint64 titleId = CafeSystem::GetForegroundTitleId();
+		const std::string gameId = titleId ? fmt::format("{:016x}", titleId) : std::string();
+		CremaSettings::Apply(gameId);
+		SetupMiiResources(ActiveSettings::GetMlcPath(), CremaSettings::Get("mii_data", gameId) != "off");
+		if (onlineWorld != "off")
+		{
+			// what online play needs: the world's console files and account (CremaOnline.h)
+			std::error_code ec;
+			const bool account = Account::GetAccount(ActiveSettings::GetPersistentId()).IsValidOnlineAccount();
+			Trace(fmt::format("online: {}{}; account {:08x}; otp.bin {}, seeprom.bin {}, certificates and keys {}, account {}: {}",
+				onlineWorld == "private" ? "private server" : "Pretendo",
+				onlineWorld == "private" ? fmt::format(" through {}", GetConfig().proxy_server.GetValue().empty() ? std::string("(no Server Address)") : GetConfig().proxy_server.GetValue()) : std::string(),
+				ActiveSettings::GetPersistentId(),
+				fs::exists(kDataRoot / "otp.bin", ec) ? "found" : "missing", fs::exists(kDataRoot / "seeprom.bin", ec) ? "found" : "missing",
+				ActiveSettings::HasRequiredOnlineFiles() ? "ok" : "missing", account ? "linked" : "not an online account",
+				ActiveSettings::IsOnlineEnabled() ? "online" : "offline"));
+		}
+		snprintf(sStopInfo, sizeof(sStopInfo), "%s", StopInfoText(CafeSystem::GetForegroundTitleName(), titleId).c_str());
+		PS4PauseMenu::LoadGameControls(gameId);
+		PS4PauseMenu::Install(gameId, _pathToUtf8(game));
+		sPerfLog = CremaSettings::On("perf_log", gameId);
+		sFreezeReports = CremaSettings::On("freeze_reports", gameId);
+		sTvScreenshots = CremaSettings::On("tv_screenshots", gameId);
+		// RADV's per-draw trace markers and the PS4 winsys's flight recorder (port/mesa/ac_ps4_drm.c:
+		// /data/DolphinPS4/flight), read when the device is created (after this)
+		if (CremaSettings::On("profiler", gameId))
+		{
+			ps4_tsc_probe();
+			ps4_sampler_start();
+			// what each Wii U thread does (running, waiting for its core or on what), every 30 s,
+			// and the time each core spends in OS calls (PPCInterpreterHLE.cpp)
+			g_crema_hle_timing = true;
+			std::thread([] {
+				SetThreadName("census");
+				auto next = std::chrono::steady_clock::now() + std::chrono::seconds(30);
+				for (;;)
+				{
+					std::this_thread::sleep_for(std::chrono::milliseconds(2));
+					coreinit::CremaThreadCensusSample();
+					if (std::chrono::steady_clock::now() < next)
+						continue;
+					next += std::chrono::seconds(30);
+					for (const std::string& line : coreinit::CremaThreadCensusReport())
+						Trace(line);
+				}
+			}).detach();
+		}
+		if (CremaSettings::On("gpu_trace", gameId))
+		{
+			setenv("RADV_PS4_TRACE", "1", 1);
+			Trace("GPU fault recorder on");
+		}
+		if (auto gamepad = inputManager.get_controller(0))
+		{
+			const bool motion = CremaSettings::On("motion", gameId);
+			for (const auto& controller : gamepad->get_controllers())
+			{
+				if (controller->api() == InputAPI::PS4Pad && controller->has_motion())
+					controller->set_use_motion(motion);
+			}
+		}
+
+		try
+		{
+			g_renderer = std::make_unique<VulkanRenderer>();
+			VulkanRenderer::GetInstance()->InitializeSurface({kWidth, kHeight}, true);
+		}
+		catch (const std::exception& ex)
+		{
+			Trace(fmt::format("Vulkan renderer: {}", ex.what()));
+			return;
+		}
+		Trace("renderer ready, launching");
+		CafeSystem::SetImplementation(&sSystemImplementation);
+		CafeSystem::LaunchForegroundTitle();
+		Trace("launched");
+		// the game's cheats that are on (data_dir/cheats/<title ID>.txt; Triangle > Cheats)
+		CremaCheats::Start(_pathToUtf8(kDataRoot), fmt::format("{:016x}", CafeSystem::GetForegroundTitleId()));
+
+		// The emulator runs on its own threads; the main thread reports progress and, per Crema's
+		// Diagnostics settings, the load (perf log), freezes (hang.log) and TV screenshots (5, 15
+		// and 30 s after launch, then tv-latest.png every minute; each costs a short stutter).
+		fs::create_directories(kDataRoot / "screenshots", ec);
+		if (sFreezeReports)
+			StartHangWatchdog();
+		scePthreadSetprio(scePthreadSelf(), 450); // the heartbeat and performance lines (sleeps)
+		for (uint64 seconds = 1;; seconds++)
+		{
+			std::this_thread::sleep_for(std::chrono::seconds(1));
+			sHeartbeat.store(seconds);
+			if (seconds % 5 == 0 && sPerfLog)
+				LogPerformance();
+			if (seconds % 10 == 0)
+				Trace(fmt::format("alive {} s", seconds));
+			if (sTvScreenshots && (seconds == 5 || seconds == 15 || seconds == 30 || seconds % 60 == 0))
+			{
+				const std::string name = seconds % 60 == 0 ? "tv-latest.png" : fmt::format("tv-{:03}s.png", seconds);
+				g_renderer->RequestScreenshot([name](const std::vector<uint8>& rgb, int width, int height, bool mainWindow) -> std::optional<std::string> {
+					if (!mainWindow)
+						return std::nullopt;
+					const fs::path path = kDataRoot / "screenshots" / name;
+					Trace(fmt::format("screenshot {} ({}x{}): {}", name, width, height, WritePNG(path, rgb, width, height) ? "saved" : "failed"));
+					return std::nullopt;
+				});
+			}
+		}
+	}
+}
+
+void WindowSystem::Create()
+{
+	SetThreadName("cemu");
+	Run();
+	// nothing more to do (an error was logged): keep the process so the logs can be read
+	for (;;)
+		std::this_thread::sleep_for(std::chrono::seconds(60));
+}
