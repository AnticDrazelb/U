+	// When a game stops (it crashed, or ended itself with an error), the app restarts into the
+	// launcher, which shows why: data_dir/last-stop.txt, its first line the panel's title, then
+	// the lines shown (Launcher.cpp reads and removes it). The game's details and whether it has its
+	// update and DLC are prepared at game start, so the crash handler only has to write them.
+	char sStopInfo[1024] = {};
+
+	std::string StopInfoText(const std::string& name, uint64 titleId)
+	{
+		std::error_code ec;
+		const std::string low = fmt::format("{:08x}", (uint32)titleId);
+		const fs::path titles = ActiveSettings::GetMlcPath() / "usr/title";
+		const bool update = fs::exists(titles / "0005000e" / low, ec);
+		const bool dlc = fs::exists(titles / "0005000c" / low, ec);
+		std::string text = name + "\n\n";
+		text += update ? fmt::format("Update: installed (v{})\n", CafeSystem::GetForegroundTitleVersion()) : "Update: not installed\n";
+		text += dlc ? "DLC: installed\n" : "DLC: not installed\n";
+		if (!update)
+			text += "\nGames often need their latest update.\nPut it in mlc01/usr/title/0005000e/" + low + "\n";
+		text += "\nDetails are in crash.log and log.txt.\n";
+		return text;
+	}
+
+	void WriteStopNote(const char* headline, const char* detail)
+	{
+		const int fd = open((kDataRoot / "last-stop.txt").c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0666);
+		if (fd < 0)
+		{
+			char line[96];
+			snprintf(line, sizeof(line), "stop note: last-stop.txt cannot be opened (errno %d)", errno);
+			ps4_boot_trace(line);
+			return;
+		}
+		auto put = [fd](const char* text) {
+			if (text)
+				write(fd, text, strlen(text));
+		};
+		put("Game Stopped\n");
+		put(headline);
+		put("\n");
+		if (detail && *detail)
+		{
+			put(detail);
+			put("\n");
+		}
+		put("\n");
+		put(sStopInfo);
+		close(fd);
+	}
