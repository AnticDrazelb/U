diff --git a/src/gui/ps4/CremaCheats.cpp b/src/gui/ps4/CremaCheats.cpp
new file mode 100644
index 0000000..cecb9b2
--- /dev/null
+++ b/src/gui/ps4/CremaCheats.cpp
@@ -0,0 +1,464 @@
+#include "gui/ps4/CremaCheats.h"
+
+#include "Cafe/HW/MMU/MMU.h"
+#include "Cafe/HW/Espresso/Recompiler/PPCRecompiler.h"
+
+#include <atomic>
+#include <cctype>
+#include <chrono>
+#include <cmath>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <thread>
+
+#include <sys/stat.h>
+
+extern "C" void ps4_boot_trace(const char* line); // port/ps4_crashlog.cpp
+
+namespace CremaCheats
+{
+namespace
+{
+	void Log(const std::string& text)
+	{
+		ps4_boot_trace(("cheats: " + text).c_str());
+	}
+
+	std::string Trim(std::string text)
+	{
+		while (!text.empty() && (text.back() == '\r' || text.back() == ' ' || text.back() == '\t'))
+			text.pop_back();
+		size_t start = 0;
+		while (start < text.size() && (text[start] == ' ' || text[start] == '\t'))
+			start++;
+		return text.substr(start);
+	}
+
+	// --- the code handler (Cafe code types, CosmoCortney's documentation) ----------------------
+	//
+	// A line is two words, AAAAAAAA BBBBBBBB, with A = CC P S xxxx: CC the code type, P 1 when it
+	// works on the loaded pointer, S the size (0: 8 bits, 1: 16, 2: 32).
+
+	constexpr uint32 kTerminator = 0xD0000000, kTerminatorB = 0xDEADCAFE; // end of a condition / pointer code
+	constexpr uint32 kTimerEnd = 0xD2000000, kTimerEndB = 0xCAFEBABE;     // end of a time-dependent code
+
+	struct Machine
+	{
+		uint32 pointer = 0;
+		bool pointerValid = false;
+		uint32 ints[8]{};
+		float floats[8]{};
+		uint64 timer = 0; // executions (the Wii U's handler: ~120 a second)
+		bool warnedAsm = false;
+	};
+
+	bool Accessible(uint32 address, uint32 size)
+	{
+		return size && address + size > address && memory_isAddressRangeAccessible(address, size);
+	}
+
+	bool Read(uint32 address, int size, uint32& value)
+	{
+		const uint32 bytes = size == 0 ? 1 : size == 1 ? 2 : 4;
+		if (!Accessible(address, bytes))
+			return false;
+		value = size == 0 ? memory_readU8(address) : size == 1 ? memory_readU16(address) : memory_readU32(address);
+		return true;
+	}
+
+	// a write to game code (below 0x10000000) throws its recompiled copy away, so the change runs
+	void Write(uint32 address, int size, uint32 value)
+	{
+		const uint32 bytes = size == 0 ? 1 : size == 1 ? 2 : 4;
+		if (!Accessible(address, bytes))
+			return;
+		uint32 old = 0;
+		Read(address, size, old);
+		if (old == (size == 0 ? (value & 0xFF) : size == 1 ? (value & 0xFFFF) : value))
+			return;
+		if (size == 0)
+			memory_writeU8(address, (uint8)value);
+		else if (size == 1)
+			memory_writeU16(address, (uint16)value);
+		else
+			memory_writeU32(address, value);
+		if (address < 0x10000000)
+			PPCRecompiler_invalidateRange(address & ~3u, (address + bytes + 3) & ~3u);
+	}
+
+	size_t SkipTo(const std::vector<uint32>& w, size_t i, uint32 a, uint32 b)
+	{
+		for (size_t j = i; j + 1 < w.size(); j += 2)
+			if (w[j] == a && w[j + 1] == b)
+				return j + 2;
+		return w.size();
+	}
+
+	bool Compare(uint32 type, uint32 value, uint32 v, uint32 v2)
+	{
+		switch (type)
+		{
+		case 0x03: return value == v;
+		case 0x04: return value != v;
+		case 0x05: return value > v;
+		case 0x06: return value < v;
+		case 0x07: return value >= v;
+		case 0x08: return value <= v;
+		case 0x09: return (value & v) == v; // has all of v's bits
+		case 0x0A: return (value & v) != 0; // has one of v's bits
+		case 0x0B: return value > v && value < v2;
+		}
+		return false;
+	}
+
+	void Run(const std::vector<uint32>& w, Machine& m, bool& corruptorDone)
+	{
+		m.pointerValid = false;
+		size_t i = 0;
+		while (i + 1 < w.size())
+		{
+			const uint32 a = w[i], b = w[i + 1];
+			const uint32 type = a >> 24, viaPointer = (a >> 20) & 0xF;
+			const int size = std::min<int>((a >> 16) & 0xF, 2);
+			// a pointer code whose pointer is out of its range: skipped to its terminator
+			if (viaPointer && !m.pointerValid && type != 0x30 && type != 0xD0)
+			{
+				i = SkipTo(w, i, kTerminator, kTerminatorB);
+				continue;
+			}
+			auto address = [&](uint32 offset, bool signedOffset) {
+				return viaPointer ? m.pointer + (signedOffset ? (uint32)(sint32)offset : offset) : offset;
+			};
+			switch (type)
+			{
+			case 0x00: // RAM write: "00000000 LLLLLLLL / VVVVVVVV 00000000", or "001SKKKK VVVVVVVV"
+				if (viaPointer)
+				{
+					Write(m.pointer + (a & 0xFFFF), size, b);
+					i += 2;
+				}
+				else
+				{
+					if (i + 2 < w.size())
+						Write(b, size, w[i + 2]);
+					i += 4;
+				}
+				break;
+			case 0x01: // string write: "01P0NNNN LLLLLLLL", then the bytes, the last line ending in FF
+			{
+				const uint32 count = a & 0xFFFF;
+				const size_t lines = count / 8 + 1;
+				uint32 to = address(b, true);
+				const uint8* bytes = nullptr;
+				std::vector<uint8> data;
+				for (size_t k = 0; k < lines * 2 && i + 2 + k < w.size(); k++)
+					for (int s = 24; s >= 0; s -= 8)
+						data.push_back((uint8)(w[i + 2 + k] >> s));
+				bytes = data.data();
+				if (data.size() >= count && Accessible(to, count))
+				{
+					bool changed = false;
+					for (uint32 k = 0; k < count; k++)
+						changed |= memory_readU8(to + k) != bytes[k];
+					if (changed)
+					{
+						for (uint32 k = 0; k < count; k++)
+							memory_writeU8(to + k, bytes[k]);
+						if (to < 0x10000000)
+							PPCRecompiler_invalidateRange(to & ~3u, (to + count + 3) & ~3u);
+					}
+				}
+				i += 2 + lines * 2;
+				break;
+			}
+			case 0x02: // skip write: "02PSNNNN LLLLLLLL / V YYYYYYYY / I 00000000"
+			{
+				if (i + 5 >= w.size())
+					return;
+				const uint32 count = a & 0xFFFF;
+				uint32 to = address(b, true), value = w[i + 2];
+				const sint32 step = (sint32)w[i + 3], increment = (sint32)w[i + 4];
+				for (uint32 k = 0; k < count && k < 0x10000; k++)
+				{
+					Write(to, size, value);
+					to += step;
+					value += increment;
+				}
+				i += 6;
+				break;
+			}
+			case 0x03: case 0x04: case 0x05: case 0x06: case 0x07: case 0x08: case 0x09: case 0x0A: case 0x0B:
+			{
+				// "TTPS0000 LLLLLLLL / V [W]": the codes up to the next terminator run only if true
+				if (i + 3 >= w.size())
+					return;
+				uint32 value = 0;
+				const bool ok = Read(address(b, true), size, value) && Compare(type, value, w[i + 2], w[i + 3]);
+				i = ok ? i + 4 : SkipTo(w, i + 4, kTerminator, kTerminatorB);
+				break;
+			}
+			case 0x0C: // "0C000000 NNNNNNNN": up to D2000000 CAFEBABE only while the timer is below N
+				i = m.timer < b ? i + 2 : SkipTo(w, i + 2, kTimerEnd, kTimerEndB);
+				break;
+			case 0x0D: // "0D00VVVV LLLLLLLL": the timer back to 0 when the 16 bits at L equal V
+			{
+				uint32 value = 0;
+				if (Read(b, 1, value) && value == (a & 0xFFFF))
+					m.timer = 0;
+				i += 2;
+				break;
+			}
+			case 0x10: case 0x11: // load / store integer: "1xPS000R LLLLLLLL"
+			{
+				const int r = a & 7;
+				const uint32 at = address(b, true);
+				if (type == 0x10)
+					Read(at, size, m.ints[r]);
+				else
+					Write(at, size, m.ints[r]);
+				i += 2;
+				break;
+			}
+			case 0x12: case 0x13: // load / store float: "1xP0000R LLLLLLLL"
+			{
+				const int r = a & 7;
+				const uint32 at = address(b, true);
+				if (Accessible(at, 4))
+				{
+					if (type == 0x12)
+						m.floats[r] = memory_readFloat(at);
+					else
+					{
+						uint32 bits;
+						std::memcpy(&bits, &m.floats[r], 4);
+						Write(at, 2, bits);
+					}
+				}
+				i += 2;
+				break;
+			}
+			case 0x14: // integer operations: "140T0R0Q 00000000" (registers) / "140T0R00 VVVVVVVV" (a value)
+			case 0x15: // float operations, the same; T 8: float R to integer register Q
+			{
+				const uint32 op = (a >> 16) & 0xF;
+				const int r = (a >> 8) & 7, q = a & 7;
+				if (type == 0x14)
+				{
+					uint32& x = m.ints[r];
+					const uint32 y = op < 4 ? m.ints[q] : b;
+					switch (op & 3)
+					{
+					case 0: x += y; break;
+					case 1: x -= y; break;
+					case 2: x *= y; break; // (the documentation's labels for 6 and 7 are swapped; its formulas are followed)
+					case 3: if (y) x /= y; break;
+					}
+				}
+				else if (op == 8)
+				{
+					m.ints[q] = (uint32)(sint32)m.floats[r];
+				}
+				else
+				{
+					float& x = m.floats[r];
+					float y = m.floats[q];
+					if (op >= 4)
+						std::memcpy(&y, &b, 4);
+					switch (op & 3)
+					{
+					case 0: x += y; break;
+					case 1: x -= y; break;
+					case 2: x *= y; break;
+					case 3: if (y != 0.0f) x /= y; break;
+					}
+				}
+				i += 2;
+				break;
+			}
+			case 0x20: // fill: "20P00000 VVVVVVVV / LLLLLLLL MMMMMMMM" (32-bit writes from L to L + M)
+			{
+				if (i + 3 >= w.size())
+					return;
+				const uint32 from = address(w[i + 2], true), span = std::min<uint32>(w[i + 3], 0x100000);
+				for (uint32 k = 0; k <= span; k += 4)
+					Write(from + k, 2, b);
+				i += 4;
+				break;
+			}
+			case 0x30: // load pointer: "30P00000 LLLLLLLL / RANGE_ST RANGE_EN" (P: the pointer's own target)
+			{
+				if (i + 3 >= w.size())
+					return;
+				uint32 target = 0;
+				const uint32 from = viaPointer ? m.pointer : b;
+				const bool ok = (!viaPointer || m.pointerValid) && Read(from, 2, target) && target >= w[i + 2] && target < w[i + 3];
+				m.pointer = target;
+				m.pointerValid = ok;
+				i = ok ? i + 4 : SkipTo(w, i + 4, kTerminator, kTerminatorB);
+				break;
+			}
+			case 0x31: // "31000000 QQQQQQQQ": a signed offset added to the pointer
+				m.pointer += b;
+				i += 2;
+				break;
+			case 0xC0: // execute PowerPC code: not possible from here (it'd have to run on a Wii U core)
+				if (!m.warnedAsm)
+				{
+					Log("a C0 code (PowerPC code) is skipped: not supported");
+					m.warnedAsm = true;
+				}
+				i += 2 + (a & 0xFFFF) * 2;
+				break;
+			case 0xC1: // Cafe OS syscall: not supported
+				i += 2;
+				break;
+			case 0xF0: // corruptor: "F0000000 LLLLLLLL / MMMMMMMM VVVVVVVV / WWWWWWWW 00000000" (once)
+			{
+				if (i + 5 >= w.size())
+					return;
+				if (!corruptorDone)
+				{
+					const uint32 from = b & ~3u, to = std::min<uint32>(w[i + 2], from + 0x8000000);
+					size_t replaced = 0;
+					for (uint32 at = from; at + 4 <= to; at += 4)
+						if (Accessible(at, 4) && memory_readU32(at) == w[i + 3])
+						{
+							Write(at, 2, w[i + 4]);
+							replaced++;
+						}
+					corruptorDone = true;
+					Log(fmt::format("corruptor: {} values replaced", replaced));
+				}
+				i += 6;
+				break;
+			}
+			default: // D0 / D1 / D2 markers, or an unknown line
+				i += 2;
+				break;
+			}
+		}
+	}
+
+	std::atomic<bool> s_running{false};
+} // namespace
+
+std::string FilePath(const std::string& dataDir, const std::string& titleId)
+{
+	return dataDir + "/cheats/" + titleId + ".txt";
+}
+
+std::vector<Cheat> Load(const std::string& dataDir, const std::string& titleId)
+{
+	std::vector<Cheat> cheats;
+	std::ifstream file(FilePath(dataDir, titleId));
+	std::string line;
+	while (std::getline(file, line))
+	{
+		line = Trim(line);
+		if (line.empty() || line[0] == '#')
+			continue;
+		if (line[0] == '+' || line[0] == '-')
+		{
+			cheats.push_back({Trim(line.substr(1)), line[0] == '+', {}});
+			continue;
+		}
+		if (cheats.empty())
+			continue;
+		std::string error;
+		const std::vector<uint32> words = ParseCode(line, &error);
+		cheats.back().words.insert(cheats.back().words.end(), words.begin(), words.end());
+	}
+	return cheats;
+}
+
+bool Save(const std::string& dataDir, const std::string& titleId, const std::vector<Cheat>& cheats)
+{
+	mkdir((dataDir + "/cheats").c_str(), 0777);
+	const std::string path = FilePath(dataDir, titleId);
+	std::ofstream file(path + ".part", std::ios::trunc);
+	if (!file)
+		return false;
+	file << "# Crema cheats (Cafe codes). \"+Name\" starts a cheat that is on, \"-Name\" one that is off;\n"
+		 << "# its code follows, two groups of 8 hex digits per line.\n";
+	for (const Cheat& cheat : cheats)
+	{
+		file << (cheat.on ? "+" : "-") << cheat.name << "\n";
+		for (size_t k = 0; k + 1 < cheat.words.size(); k += 2)
+			file << fmt::format("{:08X} {:08X}\n", cheat.words[k], cheat.words[k + 1]);
+	}
+	file.close();
+	return std::rename((path + ".part").c_str(), path.c_str()) == 0;
+}
+
+std::vector<uint32> ParseCode(const std::string& text, std::string* error)
+{
+	std::string digits;
+	for (char c : text)
+	{
+		if (std::isxdigit((unsigned char)c))
+			digits += (char)std::toupper((unsigned char)c);
+		else if (c != ' ' && c != '\t' && c != '\r' && c != '\n' && c != '-' && c != ':')
+		{
+			if (error)
+				*error = std::string("not a hex digit: ") + c;
+			return {};
+		}
+	}
+	if (digits.empty() || digits.size() % 16 != 0)
+	{
+		if (error)
+			*error = fmt::format("{} hex digits: a code is whole lines of 16 (two groups of 8)", digits.size());
+		return {};
+	}
+	std::vector<uint32> words;
+	for (size_t k = 0; k < digits.size(); k += 8)
+		words.push_back((uint32)std::stoul(digits.substr(k, 8), nullptr, 16));
+	return words;
+}
+
+void Start(const std::string& dataDir, const std::string& titleId)
+{
+	if (s_running.exchange(true))
+		return;
+	std::thread([dataDir, titleId] {
+		const std::string path = FilePath(dataDir, titleId);
+		std::vector<Cheat> cheats;
+		std::vector<bool> corruptorDone;
+		Machine machine;
+		time_t loadedTime = -1;
+		auto nextCheck = std::chrono::steady_clock::now();
+		for (;;)
+		{
+			const auto now = std::chrono::steady_clock::now();
+			if (now >= nextCheck)
+			{
+				// the file again when it changed (the launcher, or FTP)
+				nextCheck = now + std::chrono::seconds(1);
+				struct stat info;
+				const time_t modified = stat(path.c_str(), &info) == 0 ? info.st_mtime : 0;
+				if (modified != loadedTime)
+				{
+					loadedTime = modified;
+					cheats = Load(dataDir, titleId);
+					corruptorDone.assign(cheats.size(), false);
+					size_t on = 0;
+					for (const Cheat& cheat : cheats)
+						on += cheat.on;
+					Log(fmt::format("{} cheats for {}, {} on", cheats.size(), titleId, on));
+				}
+			}
+			for (size_t k = 0; k < cheats.size(); k++)
+			{
+				if (!cheats[k].on)
+					continue;
+				bool done = corruptorDone[k];
+				Run(cheats[k].words, machine, done);
+				corruptorDone[k] = done;
+			}
+			machine.timer++;
+			std::this_thread::sleep_for(std::chrono::microseconds(8333)); // ~120 a second
+		}
+	}).detach();
+}
+} // namespace CremaCheats
