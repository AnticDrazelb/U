+	// Triangle > Cheats: each cheat On / Off (Cross), Add a Cheat (its name, then its code), Remove
+	void Menu::ShowCheats(const Game& game)
+	{
+		if (m_cheatsGame != game.id)
+		{
+			m_cheats = CremaCheats::Load(m_dataDir, game.id);
+			m_cheatsGame = game.id;
+			m_cheatsRemove = false;
+		}
+		m_cheatsTitle = game.title;
+		m_panel.open = true;
+		m_panel.title = "Cheats";
+		m_panel.options.clear();
+		size_t on = 0;
+		for (const CremaCheats::Cheat& cheat : m_cheats)
+		{
+			m_panel.options.push_back((cheat.on ? "ON   " : "OFF  ") + cheat.name);
+			on += cheat.on;
+		}
+		m_panel.options.push_back("Add a Cheat");
+		if (!m_cheats.empty())
+			m_panel.options.push_back(m_cheatsRemove ? "Cancel Remove" : "Remove a Cheat");
+		m_panel.options.push_back("Done");
+		m_panel.lines = {game.title, "", m_cheatsRemove ? "Cross on a cheat removes it." :
+			fmt::format("{} cheats, {} on. Cross: on / off.", m_cheats.size(), on),
+			"Cafe codes (TCPGecko, GameHacking.org):", "they apply while the game runs.",
+			"File: cheats/" + game.id + ".txt"};
+	}
+
+	// Triangle > Update & DLC: Cross on a line takes the next choice (Auto, each one found, Off)
+	void Menu::ShowUpdateDlc(const Game& game)
+	{
+		m_panel.title = "Update & DLC";
+		m_panel.options = {"Update: " + SourceLabel(game, "update"), "DLC: " + SourceLabel(game, "dlc")};
+		if (game.copies.size() > 1)
+			m_panel.options.push_back(std::string("Game: ") + (game.path.rfind("/net/", 0) == 0 ? "network library" : "console") +
+				fmt::format(" ({} of {})", std::find(game.copies.begin(), game.copies.end(), game.path) - game.copies.begin() + 1, game.copies.size()));
+		m_panel.options.push_back("Done");
+		m_panel.lines = {game.title, "", "Found next to the game, in the games folder",
+			"or the network library. Auto: the newest.", "Cross: the next choice.",
+			"(An update installed in mlc01 is used too.)"};
+		if (game.copies.size() > 1)
+			m_panel.lines.push_back(fmt::format("This game is there {} times: Game picks the copy.", game.copies.size()));
+	}
+
+	// Box art: data_dir/covers/<ID>.png (the user's own) or <ID>.jpg (downloaded from GameTDB), by
+	// GameTDB ID (product code + company) or title ID. Shown instead of the icon.
+	void Menu::LoadBoxArt(Game& game)
+	{
+		if (game.boxArt)
+			return;
+		for (const std::string& name : {game.product, game.id})
+		{
+			if (name.empty())
+				continue;
+			for (const char* extension : {".png", ".jpg"})
+			{
+				const std::string data = ReadFile(m_dataDir + "/covers/" + name + extension);
+				if (data.empty())
+					continue;
+				std::vector<uint8> pixels;
+				uint32_t width = 0, height = 0;
+				const bool decoded = std::string(extension) == ".png" ? DecodePng(data, pixels, width, height) :
+					DecodeJpeg(data, pixels, width, height);
+				if (!decoded)
+				{
+					Log("not a picture: covers/" + name + extension);
+					continue;
+				}
+				game.cover = m_display.CreateTexture(pixels.data(), width, height);
+				game.coverAspect = (float)width / (float)height;
+				game.boxArt = game.cover != nullptr;
+				if (game.boxArt)
+					return;
+			}
+		}
+	}
+
+	void Menu::StartCoverDownload()
+	{
+		if (m_coverThread.joinable())
+			return; // already running
+		m_coverCancel = false;
+		m_coverDone = false;
+		{
+			std::lock_guard lock(m_coverMutex);
+			m_coverStatus = "Connecting to GameTDB...";
+		}
+		std::vector<std::string> ids;
+		for (const Game& game : m_games)
+		{
+			if (!game.boxArt)
+				ids.push_back(game.product);
+		}
+		m_coverThread = std::thread([this, ids] {
+			const CremaCovers::Result result = CremaCovers::Download(ids, m_dataDir + "/covers", m_assetsDir + "/xmb/cacert.pem",
+				[this](int done, int total, const std::string& id) {
+					std::lock_guard lock(m_coverMutex);
+					m_coverStatus = id.empty() ? "Finishing..." :
+						"Downloading " + std::to_string(done + 1) + " of " + std::to_string(total) + ": " + id;
+				},
+				m_coverCancel);
+			std::lock_guard lock(m_coverMutex);
+			m_coverResult = result;
+			m_coverDone = true;
+		});
+	}
+
+	// Shows the download's progress in its panel; at the end, shows the new covers.
+	void Menu::UpdateCoverDownload()
+	{
+		if (!m_coverThread.joinable())
+			return;
+		std::string status;
+		{
+			std::lock_guard lock(m_coverMutex);
+			status = m_coverStatus;
+		}
+		if (!m_coverDone)
+		{
+			if (m_panel.open && m_panel.setting == SET_COVERS)
+				m_panel.lines = {"", status, "", "Circle closes this; the download goes on."};
+			return;
+		}
+		m_coverThread.join();
+		const CremaCovers::Result result = m_coverResult;
+		for (Game& game : m_games)
+			LoadBoxArt(game);
+		Log(fmt::format("covers: {} downloaded, {} already there, {} not on GameTDB, {} failed {}", result.downloaded,
+			result.already, result.notFound, result.failed, result.error));
+		if (m_panel.open && m_panel.setting == SET_COVERS)
+		{
+			m_panel.lines = {"", "Downloaded: " + std::to_string(result.downloaded), "Already there: " + std::to_string(result.already),
+				"Not on GameTDB: " + std::to_string(result.notFound)};
+			if (result.failed > 0)
+			{
+				m_panel.lines.push_back("Failed: " + std::to_string(result.failed));
+				m_panel.lines.push_back(result.error);
+			}
+			m_panel.lines.push_back("");
+			m_panel.lines.push_back("Your own pictures: " + m_dataDir + "/covers/<ID>.png");
+			Play(result.failed > 0 ? "error" : "confirm");
+		}
+	}
+
+	void Menu::StartPackDownload()
+	{
+		if (m_packThread.joinable())
+			return; // already running
+		m_packCancel = false;
+		m_packDone = false;
+		{
+			std::lock_guard lock(m_packMutex);
+			m_packStatus = "Connecting to GitHub...";
+		}
+		m_packThread = std::thread([this] {
+			const CremaGraphicPacks::DownloadResult result = CremaGraphicPacks::Download(PacksFolder(),
+				m_assetsDir + "/xmb/cacert.pem",
+				[this](const std::string& status) {
+					std::lock_guard lock(m_packMutex);
+					m_packStatus = status;
+				},
+				m_packCancel);
+			std::lock_guard lock(m_packMutex);
+			m_packResult = result;
+			m_packDone = true;
+		});
+	}
+
+	// Shows the download's progress in its panel; at the end, loads the new packs.
+	void Menu::UpdatePackDownload()
+	{
+		if (!m_packThread.joinable())
+			return;
+		std::string status;
+		{
+			std::lock_guard lock(m_packMutex);
+			status = m_packStatus;
+		}
+		// a game's Graphic Packs list waiting for the download
+		const bool shown = m_panel.open && m_panel.setting == SET_GAME_PACKS && m_panel.rows.empty();
+		if (!m_packDone)
+		{
+			if (shown)
+				m_panel.lines = {"", m_packTitle, "", "Getting Cemu's community graphic packs...", status, "",
+					"Circle closes this; the download goes on."};
+			return;
+		}
+		m_packThread.join();
+		const CremaGraphicPacks::DownloadResult result = m_packResult;
+		if (result.installed)
+		{
+			CremaGraphicPacks::Reload();
+			m_packNote = "Updated to " + result.version + ".";
+		}
+		else if (result.upToDate)
+			m_packNote = "Up to date: " + result.version + ".";
+		else
+			m_packNote = "The download failed: " + result.error;
+		if (!shown)
+			return;
+		OpenGamePacks(m_panel.gameId, m_packTitle);
+		Play(result.installed || result.upToDate ? "confirm" : "error");
+	}
