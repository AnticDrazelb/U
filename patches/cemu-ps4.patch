+#pragma once
+
+#include "input/api/Controller.h"
+#include "input/api/ControllerProvider.h"
+#include "input/motion/MotionHandler.h"
+
+// The PS4's DualShock 4 (ScePad) of the initial user. Buttons use SDL's gamepad indices so the
+// emulated controllers' SDL default mappings apply: 0 cross, 1 circle, 2 square, 3 triangle,
+// 4 back (two-finger touchpad click, left half), 5 guide (two-finger touchpad click, right half),
+// 6 start (OPTIONS), 7/8 L3/R3, 9/10 L1/R1, 11-14 d-pad up/down/left/right.
+// A one-finger touchpad click is the GamePad touchscreen, mapped absolutely (the touchpad's
+// corners are the screen's corners): a position, which the GamePad turns into touches.
+// The gyro and accelerometer are the GamePad's motion sensors.
+class PS4PadControllerProvider : public ControllerProviderBase
+{
+	friend class PS4PadController;
+public:
+	PS4PadControllerProvider();
+
+	inline static InputAPI::Type kAPIType = InputAPI::PS4Pad;
+	InputAPI::Type api() const override { return kAPIType; }
+
+	std::vector<std::shared_ptr<ControllerBase>> get_controllers() override;
+
+private:
+	bool Read(struct OrbisPadData& data);
+
+	std::mutex m_mutex;
+	int m_handle = -1;
+	bool m_hasMotion = false;
+	float m_touchMaxX = 1919.0f, m_touchMaxY = 942.0f; // touchpad coordinate range
+};
+
+class PS4PadController : public Controller<PS4PadControllerProvider>
+{
+public:
+	PS4PadController();
+
+	std::string_view api_name() const override
+	{
+		static_assert(to_string(InputAPI::PS4Pad) == "PS4Pad");
+		return to_string(InputAPI::PS4Pad);
+	}
+	InputAPI::Type api() const override { return InputAPI::PS4Pad; }
+
+	bool is_connected() override;
+	std::string get_button_name(uint64 button) const override;
+
+	bool has_position() override;
+	glm::vec2 get_position() override;
+
+	bool has_motion() override { return m_provider && m_provider->m_hasMotion; }
+	MotionSample get_motion_sample() override;
+
+protected:
+	ControllerState raw_state() override;
+
+private:
+	bool ReadTouch(glm::vec2& position);
+
+	std::mutex m_motionMutex;
+	WiiUMotionHandler m_motionHandler;
+	MotionSample m_motionSample{};
+	uint64 m_motionTimestamp = 0; // of the last sensor reading, microseconds
+	uint64 m_motionReadings = 0;
+	std::chrono::steady_clock::time_point m_motionLogTime{};
+};
+
+// The finger on the touchpad, for the pointer over the game image (LatteRenderTarget.cpp): false
+// without a finger, else its position (0..1 on the screen) and whether it touches the screen.
+bool PS4Pad_GetTouchCursor(glm::vec2& position, bool& touching);
