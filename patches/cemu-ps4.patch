index 0000000..53ccb9f
--- /dev/null
+++ b/src/input/api/PS4/PS4PadController.cpp
@@ -0,0 +1,206 @@
+#include "input/api/PS4/PS4PadController.h"
+
+#include <orbis/Pad.h>
+#include <orbis/UserService.h>
+
+// Crema settings (gui/ps4/launcher/CremaSettings.cpp: Apply)
+extern "C" int g_crema_touchpad_buttons = 0; // 1: touchpad halves = Minus / HOME, no touch screen
+extern "C" int g_crema_touch_pointer = 1;    // the pointer over the picture
+// The DualShock 4's ScePad handle, for the launcher and the frontend (a user's pad opens once)
+extern "C" int g_crema_pad_handle = -1;
+// The in-game menu (gui/ps4/PS4PauseMenu.cpp) is open: the game gets no input
+extern "C" int g_crema_menu_open = 0;
+
+namespace
+{
+	// the latest finger on the touchpad, read by the renderer
+	std::mutex sCursorMutex;
+	bool sCursorFinger = false, sCursorTouching = false;
+	glm::vec2 sCursorPosition{};
+}
+
+bool PS4Pad_GetTouchCursor(glm::vec2& position, bool& touching)
+{
+	if (g_crema_touchpad_buttons || !g_crema_touch_pointer)
+		return false;
+	std::scoped_lock lock(sCursorMutex);
+	position = sCursorPosition;
+	touching = sCursorTouching;
+	return sCursorFinger;
+}
+
+PS4PadControllerProvider::PS4PadControllerProvider()
+{
+	// the UserService and Pad modules are loaded by the frontend before the InputManager exists
+	sceUserServiceInitialize(nullptr);
+	scePadInit();
+	int32_t user = -1;
+	if (sceUserServiceGetInitialUser(&user) != 0)
+	{
+		cemuLog_log(LogType::Force, "PS4Pad: no initial user");
+		return;
+	}
+	m_handle = scePadOpen(user, 0, 0, nullptr);
+	g_crema_pad_handle = m_handle;
+	if (m_handle < 0)
+	{
+		cemuLog_log(LogType::Force, "PS4Pad: scePadOpen failed: {:#x}", (uint32)m_handle);
+		return;
+	}
+	OrbisPadInformation info{};
+	if (scePadGetControllerInformation(m_handle, &info) == 0 && info.touchResolutionX > 1 && info.touchResolutionY > 1)
+	{
+		m_touchMaxX = (float)(info.touchResolutionX - 1);
+		m_touchMaxY = (float)(info.touchResolutionY - 1);
+	}
+	cemuLog_log(LogType::Force, "PS4Pad: touchpad {}x{}", m_touchMaxX + 1, m_touchMaxY + 1);
+	// the motion sensors are off until enabled (the header declares it without parameters)
+	const int32_t motion = reinterpret_cast<int32_t (*)(int32_t, bool)>(&scePadSetMotionSensorState)(m_handle, true);
+	m_hasMotion = motion == 0;
+	if (!m_hasMotion)
+		cemuLog_log(LogType::Force, "PS4Pad: scePadSetMotionSensorState failed: {:#x}", (uint32)motion);
+}
+
+std::vector<std::shared_ptr<ControllerBase>> PS4PadControllerProvider::get_controllers()
+{
+	if (m_handle < 0)
+		return {};
+	return {std::make_shared<PS4PadController>()};
+}
+
+bool PS4PadControllerProvider::Read(OrbisPadData& data)
+{
+	if (m_handle < 0)
+		return false;
+	std::scoped_lock lock(m_mutex);
+	// scePadReadState: the latest state (scePadRead returned nothing for half-second stretches
+	// in DolphinPS4)
+	return scePadReadState(m_handle, &data) == 0 && data.connected;
+}
+
+PS4PadController::PS4PadController()
+	: base_type("0", "DualShock 4")
+{
+}
+
+bool PS4PadController::is_connected()
+{
+	OrbisPadData data{};
+	return m_provider && m_provider->Read(data);
+}
+
+std::string PS4PadController::get_button_name(uint64 button) const
+{
+	static const char* const kNames[] = {"Cross", "Circle", "Square", "Triangle", "Touchpad 2 fingers left", "Touchpad 2 fingers right", "Options",
+										 "L3", "R3", "L1", "R1", "Up", "Down", "Left", "Right"};
+	if (button < std::size(kNames))
+		return kNames[button];
+	return base_type::get_button_name(button);
+}
+
+// Reads the touchpad: true while one finger clicks it (the GamePad screen is touched at
+// `position`). Also updates the cursor the GamePad inset shows.
+bool PS4PadController::ReadTouch(glm::vec2& position)
+{
+	OrbisPadData data{};
+	const bool read = !g_crema_touchpad_buttons && !g_crema_menu_open && m_provider && m_provider->Read(data);
+	const bool finger = read && data.touch.fingers > 0;
+	const bool touching = finger && data.touch.fingers == 1 && (data.buttons & ORBIS_PAD_BUTTON_TOUCH_PAD);
+	if (finger)
+	{
+		position.x = std::clamp((float)data.touch.touch[0].x / m_provider->m_touchMaxX, 0.0f, 1.0f);
+		position.y = std::clamp((float)data.touch.touch[0].y / m_provider->m_touchMaxY, 0.0f, 1.0f);
+	}
+	std::scoped_lock lock(sCursorMutex);
+	sCursorFinger = finger;
+	sCursorTouching = touching;
+	if (finger)
+		sCursorPosition = position;
+	return touching;
+}
+
+bool PS4PadController::has_position()
+{
+	glm::vec2 position;
+	return ReadTouch(position);
+}
+
+glm::vec2 PS4PadController::get_position()
+{
+	glm::vec2 position{};
+	ReadTouch(position);
+	return position;
+}
+
+// ScePad's sensors use SDL's axes (x right, y up, z towards the player; gyro in rad/s), with the
+// acceleration in g: converted like SDLControllerProvider's sensor events. ScePadData has the
+// acceleration before the angular velocity; OpenOrbis' OrbisPadData names those two fields the
+// other way round ("vel", then "acell"): a resting pad's "vel" is the 1 g of gravity.
+MotionSample PS4PadController::get_motion_sample()
+{
+	OrbisPadData data{};
+	if (!has_motion() || !m_provider->Read(data))
+		return {};
+	const vec_float3& acceleration = data.vel;
+	const vec_float3& angularVelocity = data.acell;
+	std::scoped_lock lock(m_motionMutex);
+	if (data.timestamp == m_motionTimestamp)
+		return m_motionSample;
+	const uint64 previous = m_motionTimestamp;
+	m_motionTimestamp = data.timestamp;
+	m_motionReadings++;
+	const auto now = std::chrono::steady_clock::now();
+	if (previous == 0 || now - m_motionLogTime >= std::chrono::seconds(10))
+	{
+		cemuLog_log(LogType::Force, "PS4Pad: motion {} readings, acceleration {:.2f} {:.2f} {:.2f} g, gyro {:.2f} {:.2f} {:.2f} rad/s",
+			m_motionReadings, acceleration.x, acceleration.y, acceleration.z, angularVelocity.x, angularVelocity.y, angularVelocity.z);
+		m_motionLogTime = now;
+	}
+	if (previous == 0)
+		return m_motionSample;
+	const float deltaTime = (float)(data.timestamp - previous) / 1000000.0f;
+	if (data.timestamp < previous || deltaTime > 0.5f)
+		return m_motionSample; // a gap: skip it rather than integrate it
+	m_motionHandler.processMotionSample(deltaTime, angularVelocity.x, -angularVelocity.y, -angularVelocity.z, -acceleration.x, acceleration.y, acceleration.z);
+	m_motionSample = m_motionHandler.getMotionSample();
+	return m_motionSample;
+}
+
+ControllerState PS4PadController::raw_state()
+{
+	ControllerState result{};
+	OrbisPadData data{};
+	if (g_crema_menu_open || !m_provider || !m_provider->Read(data))
+		return result;
+	const uint32 b = data.buttons;
+	const std::pair<uint32, uint32> buttons[] = {
+		{ORBIS_PAD_BUTTON_CROSS, 0}, {ORBIS_PAD_BUTTON_CIRCLE, 1}, {ORBIS_PAD_BUTTON_SQUARE, 2},
+		{ORBIS_PAD_BUTTON_TRIANGLE, 3}, {ORBIS_PAD_BUTTON_OPTIONS, 6}, {ORBIS_PAD_BUTTON_L3, 7},
+		{ORBIS_PAD_BUTTON_R3, 8}, {ORBIS_PAD_BUTTON_L1, 9}, {ORBIS_PAD_BUTTON_R1, 10},
+		{ORBIS_PAD_BUTTON_UP, 11}, {ORBIS_PAD_BUTTON_DOWN, 12}, {ORBIS_PAD_BUTTON_LEFT, 13},
+		{ORBIS_PAD_BUTTON_RIGHT, 14}};
+	for (const auto& [mask, index] : buttons)
+		if (b & mask)
+			result.buttons.SetButtonState(index, true);
+	// two-finger touchpad click: left half = back (Wii U minus), right half = guide (Wii U HOME);
+	// a one-finger click touches the GamePad screen (has_position). Crema's Touchpad setting
+	// "Minus / HOME": any click, by the first finger's half.
+	if ((b & ORBIS_PAD_BUTTON_TOUCH_PAD) && g_crema_touchpad_buttons)
+	{
+		const bool right = data.touch.fingers > 0 && data.touch.touch[0].x >= m_provider->m_touchMaxX / 2.0f;
+		result.buttons.SetButtonState(right ? 5 : 4, true);
+	}
+	else if ((b & ORBIS_PAD_BUTTON_TOUCH_PAD) && data.touch.fingers >= 2)
+	{
+		const float middle = ((float)data.touch.touch[0].x + (float)data.touch.touch[1].x) / 2.0f;
+		result.buttons.SetButtonState(middle >= m_provider->m_touchMaxX / 2.0f ? 5 : 4, true);
+	}
+	auto stick = [](uint8 v) { return std::clamp(((float)v - 128.0f) / 127.0f, -1.0f, 1.0f); };
+	result.axis.x = stick(data.leftStick.x);
+	result.axis.y = stick(data.leftStick.y);
+	result.rotation.x = stick(data.rightStick.x);
+	result.rotation.y = stick(data.rightStick.y);
+	result.trigger.x = (float)data.analogButtons.l2 / 255.0f;
+	result.trigger.y = (float)data.analogButtons.r2 / 255.0f;
+	return result;
+}
diff --git a/src/input/api/PS4/PS4PadController.h b/src/input/api/PS4/PS4PadController.h
