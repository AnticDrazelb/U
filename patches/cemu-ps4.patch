diff --git a/src/audio/PS4AudioAPI.cpp b/src/audio/PS4AudioAPI.cpp
new file mode 100644
index 0000000..545da66
--- /dev/null
+++ b/src/audio/PS4AudioAPI.cpp
@@ -0,0 +1,170 @@
+#include "PS4AudioAPI.h"
+#include "util/helpers/helpers.h"
+
+#include <orbis/AudioOut.h>
+#include <orbis/libkernel.h>
+
+namespace
+{
+	// any user hears the main port; the system user avoids depending on who is signed in
+	constexpr OrbisUserServiceUserId kSystemUser = 0xFF;
+	constexpr int32_t kVolumeMax = 32768; // SCE_AUDIO_VOLUME_0DB
+	constexpr int32_t kVolumeFlagLR = 0x3; // front left + front right
+	// libkernel declares it without parameters
+	using SetAffinityFn = int32_t (*)(OrbisPthread, uint64_t);
+
+	// Mixes `channels` interleaved channels down to stereo (5.1 / 7.1: centre and rears folded in).
+	void ToStereo(const sint16* in, uint32 channels, sint16* out)
+	{
+		if (channels == 2)
+		{
+			out[0] = in[0];
+			out[1] = in[1];
+			return;
+		}
+		if (channels == 1)
+		{
+			out[0] = out[1] = in[0];
+			return;
+		}
+		// FL FR C LFE BL BR (SL SR)
+		const int centre = in[2] * 7 / 10, rearL = in[4] * 7 / 10, rearR = in[5] * 7 / 10;
+		const int sideL = channels >= 8 ? in[6] * 7 / 10 : 0, sideR = channels >= 8 ? in[7] * 7 / 10 : 0;
+		out[0] = (sint16)std::clamp(in[0] + centre + rearL + sideL, -32768, 32767);
+		out[1] = (sint16)std::clamp(in[1] + centre + rearR + sideR, -32768, 32767);
+	}
+} // namespace
+
+PS4AudioAPI::PS4AudioAPI(uint32 samplerate, uint32 channels, uint32 samples_per_block, uint32 bits_per_sample)
+	: IAudioAPI(samplerate, channels, samples_per_block, bits_per_sample)
+{
+	if (bits_per_sample != 16)
+		throw std::runtime_error("PS4 audio: only 16-bit samples");
+	m_port = sceAudioOutOpen(kSystemUser, ORBIS_AUDIO_OUT_PORT_TYPE_MAIN, 0, kGrainFrames, samplerate,
+		ORBIS_AUDIO_OUT_PARAM_FORMAT_S16_STEREO);
+	if (m_port < 0)
+		throw std::runtime_error(fmt::format("sceAudioOutOpen failed: {:#x}", (uint32)m_port));
+	m_ring.resize((size_t)samples_per_block * channels * kBlockCount);
+	cemuLog_log(LogType::Force, "PS4 audio: port {:#x}, {} Hz, {} channels, {} samples per block", (uint32)m_port, samplerate,
+		channels, samples_per_block);
+}
+
+PS4AudioAPI::~PS4AudioAPI()
+{
+	Stop();
+	if (m_port >= 0)
+		sceAudioOutClose(m_port);
+}
+
+bool PS4AudioAPI::NeedAdditionalBlocks() const
+{
+	std::scoped_lock lock(m_mutex);
+	return m_count < (size_t)GetAudioDelay() * m_samplesPerBlock * m_channels;
+}
+
+bool PS4AudioAPI::FeedBlock(sint16* data)
+{
+	const size_t samples = (size_t)m_samplesPerBlock * m_channels;
+	std::scoped_lock lock(m_mutex);
+	if (m_count + samples > m_ring.size())
+		return false; // too many blocks queued: dropped
+	size_t writePos = (m_readPos + m_count) % m_ring.size();
+	for (size_t i = 0; i < samples; i++)
+	{
+		m_ring[writePos] = data[i];
+		writePos = writePos + 1 == m_ring.size() ? 0 : writePos + 1;
+	}
+	m_count += samples;
+	return true;
+}
+
+bool PS4AudioAPI::Play()
+{
+	if (m_running)
+		return true;
+	m_running = true;
+	m_thread = std::thread(&PS4AudioAPI::OutputLoop, this);
+	return true;
+}
+
+bool PS4AudioAPI::Stop()
+{
+	if (!m_running)
+		return true;
+	m_running = false;
+	if (m_thread.joinable())
+		m_thread.join();
+	return true;
+}
+
+void PS4AudioAPI::SetVolume(sint32 volume)
+{
+	IAudioAPI::SetVolume(volume);
+	if (m_port < 0)
+		return;
+	int32_t levels[2] = {kVolumeMax * volume / 100, kVolumeMax * volume / 100};
+	sceAudioOutSetVolume(m_port, kVolumeFlagLR, levels);
+}
+
+void PS4AudioAPI::OutputLoop()
+{
+	SetThreadName("PS4AudioOut");
+	// The device is created from an emulated CPU core's thread, whose core this thread would
+	// inherit (PS4 threads keep their creator's affinity): any of the app's cores, and a priority
+	// above the emulation's so a busy frame doesn't make the sound crackle.
+	const OrbisPthread self = scePthreadSelf();
+	((SetAffinityFn)&scePthreadSetaffinity)(self, 0x3F);
+	scePthreadSetprio(self, 400);
+
+	sint16 grains[2][kGrainFrames * 2];
+	size_t current = 0, underruns = 0;
+	std::vector<sint16> frame(m_channels);
+	while (m_running)
+	{
+		sint16* out = grains[current];
+		size_t frames = 0;
+		{
+			std::scoped_lock lock(m_mutex);
+			const size_t available = m_count / m_channels;
+			frames = std::min<size_t>(available, kGrainFrames);
+			for (size_t f = 0; f < frames; f++)
+			{
+				for (uint32 c = 0; c < m_channels; c++)
+				{
+					frame[c] = m_ring[m_readPos];
+					m_readPos = m_readPos + 1 == m_ring.size() ? 0 : m_readPos + 1;
+				}
+				ToStereo(frame.data(), m_channels, out + f * 2);
+			}
+			m_count -= frames * m_channels;
+		}
+		if (frames < kGrainFrames)
+		{
+			// the game hasn't produced enough (a slow frame): silence for the rest
+			std::fill(out + frames * 2, out + kGrainFrames * 2, 0);
+			if (++underruns % 500 == 1)
+				cemuLog_log(LogType::Force, "PS4 audio: underrun (x{})", underruns);
+		}
+		// blocks until the previous grain is playing: this paces the loop
+		sceAudioOutOutput(m_port, out);
+		current ^= 1;
+	}
+	sceAudioOutOutput(m_port, nullptr); // flush
+}
+
+std::vector<IAudioAPI::DeviceDescriptionPtr> PS4AudioAPI::GetDevices()
+{
+	return {std::make_shared<PS4DeviceDescription>()};
+}
+
+bool PS4AudioAPI::InitializeStatic()
+{
+	const int32_t result = sceAudioOutInit();
+	// already initialized (the launcher, another part of the app) is fine
+	if (result != 0 && result != (int32_t)0x8026000E)
+	{
+		cemuLog_log(LogType::Force, "sceAudioOutInit failed: {:#x}", (uint32)result);
+		return false;
+	}
+	return true;
+}
diff --git a/src/audio/PS4AudioAPI.h b/src/audio/PS4AudioAPI.h
new file mode 100644
index 0000000..0a576df
--- /dev/null
+++ b/src/audio/PS4AudioAPI.h
@@ -0,0 +1,50 @@
+#pragma once
+
+#include "IAudioAPI.h"
+
+#include <atomic>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+// PS4: sound through libSceAudioOut. The emulated sound hardware (snd_core) feeds blocks of
+// samples into a ring buffer; an output thread hands the PS4 grains of 256 frames
+// (sceAudioOutOutput blocks until the previous grain is playing, which paces it). Each device
+// (TV, GamePad) is its own AudioOut port; the PS4 mixes the ports.
+class PS4AudioAPI : public IAudioAPI
+{
+public:
+	class PS4DeviceDescription : public DeviceDescription
+	{
+	public:
+		PS4DeviceDescription() : DeviceDescription(L"PS4 audio out") {}
+		std::wstring GetIdentifier() const override { return L"default"; }
+	};
+
+	PS4AudioAPI(uint32 samplerate, uint32 channels, uint32 samples_per_block, uint32 bits_per_sample);
+	~PS4AudioAPI();
+
+	AudioAPI GetType() const override { return PS4AudioOut; }
+	bool NeedAdditionalBlocks() const override;
+	bool FeedBlock(sint16* data) override;
+	bool Play() override;
+	bool Stop() override;
+	void SetVolume(sint32 volume) override;
+
+	static std::vector<DeviceDescriptionPtr> GetDevices();
+	static bool InitializeStatic();
+
+private:
+	static constexpr uint32 kGrainFrames = 256; // sceAudioOutOutput's unit
+
+	void OutputLoop();
+
+	int m_port = -1;
+	std::thread m_thread;
+	std::atomic<bool> m_running{false};
+
+	// queued samples (interleaved, m_channels each): a ring of m_ring.size() samples
+	mutable std::mutex m_mutex;
+	std::vector<sint16> m_ring;
+	size_t m_readPos = 0, m_count = 0;
+};
