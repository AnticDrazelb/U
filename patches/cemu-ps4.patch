+
+namespace
+{
+	// any user hears the main port; the system user avoids depending on who is signed in
+	constexpr OrbisUserServiceUserId kSystemUser = 0xFF;
+	constexpr int32_t kVolumeMax = 32768; // SCE_AUDIO_VOLUME_0DB
+	constexpr int32_t kVolumeFlagLR = 0x3; // front left + front right
+	// libkernel declares it without parameters
+	using SetAffinityFn = int32_t (*)(OrbisPthread, uint64_t);
+
+	// Mixes `channels` interleaved channels down to stereo (5.1 / 7.1: centre and rears folded in).
+	void ToStereo(const sint16* in, uint32 channels, sint16* out)
+	{
+		if (channels == 2)
+		{
+			out[0] = in[0];
+			out[1] = in[1];
+			return;
+		}
+		if (channels == 1)
+		{
+			out[0] = out[1] = in[0];
+			return;
+		}
+		// FL FR C LFE BL BR (SL SR)
+		const int centre = in[2] * 7 / 10, rearL = in[4] * 7 / 10, rearR = in[5] * 7 / 10;
+		const int sideL = channels >= 8 ? in[6] * 7 / 10 : 0, sideR = channels >= 8 ? in[7] * 7 / 10 : 0;
+		out[0] = (sint16)std::clamp(in[0] + centre + rearL + sideL, -32768, 32767);
+		out[1] = (sint16)std::clamp(in[1] + centre + rearR + sideR, -32768, 32767);
+	}
+} // namespace
+
+PS4AudioAPI::PS4AudioAPI(uint32 samplerate, uint32 channels, uint32 samples_per_block, uint32 bits_per_sample)
+	: IAudioAPI(samplerate, channels, samples_per_block, bits_per_sample)
+{
+	if (bits_per_sample != 16)
+		throw std::runtime_error("PS4 audio: only 16-bit samples");
+	m_port = sceAudioOutOpen(kSystemUser, ORBIS_AUDIO_OUT_PORT_TYPE_MAIN, 0, kGrainFrames, samplerate,
+		ORBIS_AUDIO_OUT_PARAM_FORMAT_S16_STEREO);
+	if (m_port < 0)
+		throw std::runtime_error(fmt::format("sceAudioOutOpen failed: {:#x}", (uint32)m_port));
+	m_ring.resize((size_t)samples_per_block * channels * kBlockCount);
+	cemuLog_log(LogType::Force, "PS4 audio: port {:#x}, {} Hz, {} channels, {} samples per block", (uint32)m_port, samplerate,
+		channels, samples_per_block);
+}
+
+PS4AudioAPI::~PS4AudioAPI()
+{
