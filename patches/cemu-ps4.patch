diff --git a/src/Cafe/HW/Espresso/Interpreter/PPCInterpreterHLE.cpp b/src/Cafe/HW/Espresso/Interpreter/PPCInterpreterHLE.cpp
index cf7ba19..686efd3 100644
--- a/src/Cafe/HW/Espresso/Interpreter/PPCInterpreterHLE.cpp
+++ b/src/Cafe/HW/Espresso/Interpreter/PPCInterpreterHLE.cpp
@@ -22,6 +22,98 @@ HLECALL s_ppcHleTable[HLE_TABLE_CAPACITY]{};
 sint32 s_ppcHleTableWriteIndex = 0;
 std::mutex s_ppcHleTableMutex;
 
+#if defined(__ORBIS__)
+// Crema: the HLE functions' names, and (with the profiler on) the time each emulated core spends in
+// them: what a game thread does besides running its own code. A call during which the core switched
+// to another thread waited (OSWaitEvent, OSSleepTicks...): its time is kept apart as waiting.
+// CremaHLEReport() lists the busiest calls every 30 s with the thread census.
+#include <x86intrin.h>
+static std::string s_ppcHleNames[0x4000];
+std::atomic<bool> g_crema_hle_timing{false};
+volatile uint32 g_crema_core_switches[3] = {}; // coreinit_Thread.cpp: thread switches per core
+struct CremaHLEStat
+{
+	uint64 workTicks;
+	uint64 waitTicks;
+	uint32 calls;
+	uint32 waits;
+};
+static CremaHLEStat s_hleStats[3][0x4000];
+static uint64 s_hleWindowStart = 0;
+
+static inline void CremaCallHLE(PPCInterpreter_t* hCPU, uint32 funcIndex, HLECALL hleCall)
+{
+	const uint32 core = hCPU->spr.UPIR;
+	if (!g_crema_hle_timing.load(std::memory_order_relaxed) || core >= 3 || funcIndex >= 0x4000)
+	{
+		hleCall(hCPU);
+		return;
+	}
+	const uint32 switches = g_crema_core_switches[core];
+	const uint64 start = __rdtsc();
+	hleCall(hCPU);
+	const uint64 ticks = __rdtsc() - start;
+	CremaHLEStat& stat = s_hleStats[core][funcIndex];
+	stat.calls++;
+	if (g_crema_core_switches[core] != switches)
+	{
+		stat.waits++;
+		stat.waitTicks += ticks;
+	}
+	else
+	{
+		stat.workTicks += ticks;
+	}
+}
+
+std::vector<std::string> CremaHLEReport()
+{
+	std::vector<std::string> lines;
+	const uint64 now = __rdtsc();
+	const uint64 elapsed = now - s_hleWindowStart;
+	const bool first = s_hleWindowStart == 0;
+	s_hleWindowStart = now;
+	const sint32 count = std::min<sint32>(s_ppcHleTableWriteIndex, 0x4000);
+	extern uint64 _rdtscFrequency;
+	const double seconds = std::max(1e-3, (double)elapsed / (double)std::max<uint64>(_rdtscFrequency, 1));
+	for (uint32 core = 0; core < 3; core++)
+	{
+		struct Entry
+		{
+			sint32 index;
+			uint64 work, wait;
+			uint32 calls, waits;
+		};
+		std::vector<Entry> entries;
+		uint64 totalWork = 0;
+		for (sint32 i = 0; i < count; i++)
+		{
+			CremaHLEStat& stat = s_hleStats[core][i];
+			if (stat.calls)
+			{
+				entries.push_back({i, stat.workTicks, stat.waitTicks, stat.calls, stat.waits});
+				totalWork += stat.workTicks;
+			}
+			stat = {};
+		}
+		if (first || entries.empty())
+			continue;
+		auto name = [](sint32 i) { return s_ppcHleNames[i].empty() ? fmt::format("hle {}", i) : s_ppcHleNames[i]; };
+		std::sort(entries.begin(), entries.end(), [](const Entry& a, const Entry& b) { return a.work > b.work; });
+		std::string line = fmt::format("os calls core{}: {:.1f}% of the time working in them |", core, 100.0 * totalWork / elapsed);
+		for (size_t i = 0; i < entries.size() && i < 8; i++)
+			line += fmt::format(" {} {:.1f}% ({:.0f}/s)", name(entries[i].index), 100.0 * entries[i].work / elapsed, entries[i].calls / seconds);
+		lines.push_back(line);
+		std::sort(entries.begin(), entries.end(), [](const Entry& a, const Entry& b) { return a.wait > b.wait; });
+		line = fmt::format("os waits core{}: |", core);
+		for (size_t i = 0; i < entries.size() && i < 6 && entries[i].wait; i++)
+			line += fmt::format(" {} {:.1f}% ({:.0f}/s)", name(entries[i].index), 100.0 * entries[i].wait / elapsed, entries[i].waits / seconds);
+		lines.push_back(line);
+	}
+	return lines;
+}
+#endif
