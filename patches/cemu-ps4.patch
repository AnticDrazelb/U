 		// os lib function
 		auto hleCall = PPCInterpreter_getHLECall(hleFuncId);
 		cemu_assert(hleCall);
+#if defined(__ORBIS__)
+		CremaCallHLE(hCPU, hleFuncId, hleCall);
+#else
 		hleCall(hCPU);
+#endif
 	}
-}
\ No newline at end of file
