+	// Where the time goes, every 5 s: the GPU's busy share (GPU timestamps around each submission)
+	// and the busy share of each named thread above 10% (OSSched[core=N] = the emulated CPU cores,
+	// LatteThread = GPU command processing). A thread near 100% is what limits the frame rate.
+	void LogPerformance()
+	{
+		static uint64_t sPrevBusy = 0, sPrevSpan = 0;
+		uint64_t busy, span;
+		ac_ps4_get_gpu_busy(&busy, &span);
+		const uint64_t busyDelta = busy - sPrevBusy, spanDelta = span - sPrevSpan;
+		sPrevBusy = busy;
+		sPrevSpan = span;
+		char threads[640];
+		ps4_thread_busy_report(threads, sizeof(threads), 10);
+		// open file descriptors by kind (1.67: after 10 min of Tekken Tag Tournament 2 no file could
+		// be opened any more - its save and hang.log failed - and the game froze)
+		int files = 0, sockets = 0, pipes = 0, devices = 0, others = 0;
+		for (int fd = 0; fd < 4096; fd++)
+		{
+			struct stat info;
+			if (fstat(fd, &info) != 0)
+				continue;
+			if (S_ISREG(info.st_mode))
+				files++;
+			else if (S_ISSOCK(info.st_mode))
+				sockets++;
+			else if (S_ISFIFO(info.st_mode))
+				pipes++;
+			else if (S_ISCHR(info.st_mode))
+				devices++;
+			else
+				others++;
+		}
+		const int totalFds = files + sockets + pipes + devices + others;
+		Trace(fmt::format("perf: gpu {}% | {} | fds {} (files {}, sockets {}, pipes {}, devices {}, other {})",
+			spanDelta ? busyDelta * 100 / spanDelta : 0, threads, totalFds, files, sockets, pipes, devices, others));
+		Trace(LattePerformanceMonitor_cremaWaits());
+		Trace(CremaRecompilerStats());
+		// what they are: once the game runs (at 30 s), then at 220 and every 15 more (the PS4
+		// refuses new files at ~250)
+		static int sReportedAt = 0;
+		static int sPerfLines = 0; // one every 5 s
+		if (++sPerfLines == 6)
+		{
+			ps4_filestream_report(fmt::format("{} descriptors, 30 s", totalFds).c_str());
+		}
+		if (totalFds >= std::max(sReportedAt + 15, 220))
+		{
+			sReportedAt = totalFds;
+			ps4_filestream_report(fmt::format("{} descriptors", totalFds).c_str());
+		}
+	}
+
+	// Hang watchdog: when the main loop's heartbeat or the TV frames stop for 15 s, the stacks of
+	// all named threads (SetThreadName), with the lock each one waits on, go to hang.log (up to
+	// three dumps a minute apart). No Cemu log and no allocations here: a hang may hold their locks.
+	void StartHangWatchdog()
+	{
+		const std::string path = _pathToUtf8(kDataRoot / "hang.log");
+		std::error_code ec;
+		fs::remove(kDataRoot / "hang.log", ec);
+		std::thread([path] {
+			// above the busy threads (650): a freeze that keeps every core busy still gets its
+			// report (it sleeps almost always)
+			scePthreadSetprio(scePthreadSelf(), 450);
+			uint64 lastBeat = sHeartbeat.load(), lastFrame = LatteGPUState.frameCounter;
+			int beatStall = 0, frameStall = 0, dumps = 0, sinceDump = 60;
+			char reason[160], line[200];
+			for (uint64 seconds = 1;; seconds++)
+			{
+				std::this_thread::sleep_for(std::chrono::seconds(1));
+				const uint64 beat = sHeartbeat.load();
+				const uint64 frame = LatteGPUState.frameCounter;
+				beatStall = beat == lastBeat ? beatStall + 1 : 0;
+				// after the first frame, or (still none) 30 s after launch: a hang while the caches load
+				frameStall = frame == lastFrame && (frame != 0 || seconds > 30) ? frameStall + 1 : 0;
+				lastBeat = beat;
+				lastFrame = frame;
+				sinceDump++;
+				if (std::max(beatStall, frameStall) < 15)
+				{
+					sinceDump = 60; // a new hang dumps at once
+					continue;
+				}
+				if (dumps >= 3 || sinceDump < 60)
+					continue;
+				snprintf(reason, sizeof(reason), "hang at %llu s: no heartbeat for %d s, no TV frame for %d s (frame %llu)",
+					(unsigned long long)seconds, beatStall, frameStall, (unsigned long long)frame);
+				snprintf(line, sizeof(line), "%s, stacks in hang.log", reason);
+				ps4_boot_trace(line);
+				ps4_dump_thread_stacks(path.c_str(), reason);
+				dumps++;
+				sinceDump = 0;
+			}
+		}).detach();
+	}
