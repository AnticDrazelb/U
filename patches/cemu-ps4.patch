+extern "C" void ps4_open_files_report()
+{
+	std::set<int> streamFds;
+	{
+		std::lock_guard lock(s_openStreamsLock);
+		for (auto& [stream, entry] : s_openStreams)
+			streamFds.insert(entry.second);
+	}
+	// who opened the others and where (port/ps4_crashlog.cpp: every open() is recorded)
+	{
+		std::vector<unsigned char> skip(4096, 0);
+		for (int fd : streamFds)
+			if (fd >= 0 && fd < 4096)
+				skip[fd] = 1;
+		ps4_open_calls_report(skip.data());
+	}
+	struct Other
+	{
+		int fd;
+		FileKey key;
+		uint64_t size;
+	};
+	std::vector<Other> others;
+	std::map<FileKey, std::string> names;
+	for (int fd = 0; fd < 4096; fd++)
+	{
+		struct stat info;
+		if (streamFds.count(fd) || fstat(fd, &info) != 0 || !S_ISREG(info.st_mode))
+			continue;
+		const FileKey key{(uint64_t)info.st_dev, (uint64_t)info.st_ino};
+		others.push_back({fd, key, (uint64_t)info.st_size});
+		names.emplace(key, std::string());
+	}
+	size_t left = names.size();
+	for (const char* root : {"/data/Crema", "/app0"})
+		FindFiles(root, names, left, 0);
+	// by file (several descriptors may be the same file), most first
+	std::map<std::string, int> perFile;
+	for (auto& other : others)
+	{
+		const std::string& name = names[other.key];
+		perFile[name.empty() ? "? inode " + std::to_string(other.key.second) + ", " + std::to_string(other.size) + " bytes" : name]++;
+	}
+	std::vector<std::pair<int, std::string>> sorted;
+	for (auto& [file, count] : perFile)
+		sorted.emplace_back(count, file);
+	std::sort(sorted.rbegin(), sorted.rend());
+	char line[400];
+	snprintf(line, sizeof(line), "other open files: %zu descriptors, %zu files, %zu not found by name", others.size(), names.size(), left);
+	ps4_boot_trace(line);
+	for (size_t i = 0; i < sorted.size() && i < 16; i++)
+	{
+		snprintf(line, sizeof(line), "  %dx %s", sorted[i].first, sorted[i].second.c_str());
+		ps4_boot_trace(line);
+	}
+	// the newest (descriptors are given lowest first, so the latest leaks have the highest numbers)
+	for (size_t i = others.size() > 6 ? others.size() - 6 : 0; i < others.size(); i++)
+	{
+		const std::string& name = names[others[i].key];
+		snprintf(line, sizeof(line), "  newest: fd %d %s (%llu bytes)", others[i].fd, name.empty() ? "?" : name.c_str(),
+			(unsigned long long)others[i].size);
+		ps4_boot_trace(line);
+	}
+}
