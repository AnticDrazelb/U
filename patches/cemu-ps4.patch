+// crash.log: which recompiled function the host address is in, and (brief: not) that function's
+// x86 code around it and the game's code, to disassemble offline (scripts/guest-code.py). Brief
+// (hang reports): only that line, nothing for an address outside recompiled code.
+extern "C" void ps4_crash_jit_info(int fd, uint64 rip, int brief)
+{
+	char line[200];
+	auto out = [&](int n) {
+		if (n > 0)
+			write(fd, line, std::min<size_t>((size_t)n, sizeof(line) - 1));
+	};
+	const uint32 count = s_cremaJitNext.load(std::memory_order_acquire);
+	const uint32 total = std::min(count, kCremaJitRanges);
+	for (uint32 i = 0; i < total; i++)
+	{
+		const CremaJitRange& r = s_cremaJitRanges[(count - 1 - i) % kCremaJitRanges];
+		const uintptr_t start = r.x86Start.load(std::memory_order_acquire);
+		const uint32 size = r.x86Size.load(std::memory_order_relaxed);
+		if (start == 0 || rip < start || rip >= start + size)
+			continue;
+		const uint32 ppcStart = r.ppcStart.load(std::memory_order_relaxed);
+		const uint32 ppcSize = r.ppcSize.load(std::memory_order_relaxed);
+		const uint32 offset = (uint32)(rip - start);
+		out(snprintf(line, sizeof(line), "jit: host 0x%llx is +0x%x in the recompiled game function %08x-%08x (x86 size 0x%x)\n",
+			(unsigned long long)rip, offset, ppcStart, ppcStart + ppcSize, size));
+		if (brief)
+			return;
+		// x86 code: up to 0x600 bytes before the fault and 0x100 after
+		const uint32 from = offset > 0x600 ? (offset - 0x600) & ~0xFu : 0;
+		const uint32 to = std::min<uint32>(size, offset + 0x100);
+		for (uint32 at = from; at < to; at += 32)
+		{
+			int n = snprintf(line, sizeof(line), "jit code +%05x:", at);
+			for (uint32 b = at; b < std::min<uint32>(to, at + 32); b++)
+				n += snprintf(line + n, sizeof(line) - n, " %02x", ((const uint8*)start)[b]);
+			n += snprintf(line + n, sizeof(line) - n, "\n");
+			out(n);
+		}
+		// the game's code of the whole function (up to 2 KiB)
+		const uint32 ppcEnd = ppcStart + std::min<uint32>(ppcSize, 0x800);
+		for (uint32 at = ppcStart & ~0x1Fu; at < ppcEnd; at += 0x20)
+			out(snprintf(line, sizeof(line), "guest code %08x: %08x %08x %08x %08x %08x %08x %08x %08x\n", at, memory_readU32(at),
+				memory_readU32(at + 4), memory_readU32(at + 8), memory_readU32(at + 12), memory_readU32(at + 16), memory_readU32(at + 20),
+				memory_readU32(at + 24), memory_readU32(at + 28)));
+		return;
+	}
+	if (!brief)
+		out(snprintf(line, sizeof(line), "jit: host 0x%llx is not in a recompiled function (%u recorded)\n", (unsigned long long)rip, count));
