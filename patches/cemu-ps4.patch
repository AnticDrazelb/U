+// hang.log: every emulated (PPC) thread: name, state, where it stopped (saved IP and LR) and its
+// callers' return addresses, and what it waits on. Reads guest memory only, without locks (the
+// list may be changing; a hang report tolerates that).
+extern "C" void ps4_hang_guest_threads(int fd)
+{
+	char line[256];
+	auto out = [&](int n) {
+		if (n > 0)
+			write(fd, line, std::min<size_t>((size_t)n, sizeof(line) - 1));
+	};
+	const sint32 count = std::min<sint32>(activeThreadCount, 256);
+	out(snprintf(line, sizeof(line), "guest threads: %d\n", count));
+	for (sint32 i = 0; i < count; i++)
+	{
+		const MPTR threadPtr = activeThread[i];
+		if (threadPtr < 0x01000000 || threadPtr >= 0xF0000000)
+			continue;
+		OSThread_t* thread = (OSThread_t*)memory_getPointerFromVirtualOffset(threadPtr);
+		const char* state = "?";
+		if (thread->suspendCounter != 0)
+			state = "SUSPENDED";
+		else if (thread->state == OSThread_t::THREAD_STATE::STATE_READY)
+			state = "READY";
+		else if (thread->state == OSThread_t::THREAD_STATE::STATE_RUNNING)
+			state = "RUNNING";
+		else if (thread->state == OSThread_t::THREAD_STATE::STATE_WAITING)
+			state = "WAITING";
+		else if (thread->state == OSThread_t::THREAD_STATE::STATE_MORIBUND)
+			state = "MORIBUND";
+		else if (thread->state == OSThread_t::THREAD_STATE::STATE_NONE)
+			state = "NONE";
+		char name[48] = "?";
+		const MPTR namePtr = thread->threadName.GetMPTR();
+		if (namePtr >= 0x01000000 && namePtr < 0xF0000000)
+		{
+			const char* text = (const char*)memory_getPointerFromVirtualOffset(namePtr);
+			size_t n = 0;
+			for (; n + 1 < sizeof(name) && text[n] && text[n] >= ' ' && text[n] < 0x7F; n++)
+				name[n] = text[n];
+			name[n] = 0;
+		}
+		int n = snprintf(line, sizeof(line), "  %08x %-9s Aff %d Pri %2d IP %08x LR %08x wait queue %08x mutex %08x fast mutex %08x  %s\n",
+			threadPtr, state, (int)(uint8)thread->attr, (int)thread->effectivePriority, thread->context.srr0, _swapEndianU32(thread->context.lr),
+			thread->currentWaitQueue.GetMPTR(), thread->waitingForMutex.GetMPTR(), thread->waitingForFastMutex.GetMPTR(), name);
+		out(n);
+		// the back chain from the saved stack pointer
+		n = snprintf(line, sizeof(line), "      return addresses");
+		uint32 sp = _swapEndianU32(thread->context.gpr[1]);
+		for (int f = 0; f < 12 && sp >= 0x01000000 && sp < 0xF0000000 && (sp & 3) == 0 && n < 230; f++)
+		{
+			const uint32 next = memory_readU32(sp);
+			if (next <= sp || next >= 0xF0000000)
