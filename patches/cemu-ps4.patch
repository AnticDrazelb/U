+	void Menu::BuildGames(std::vector<LibraryEntry> library)
+	{
+		// updates and DLC by the low half of their title ID (the game's is the same)
+		std::map<uint32, std::vector<Game::Source>> updates, dlcs;
+		for (const LibraryEntry& entry : library)
+		{
+			if (entry.kind == 1)
+				updates[(uint32)entry.appId].push_back({entry.path, entry.version});
+			else if (entry.kind == 2)
+				dlcs[(uint32)entry.appId].push_back({entry.path, entry.version});
+		}
+		size_t attached = 0;
+		// the same game more than once: the console's copy first (faster than the network), then
+		// the network library's in scan order
+		std::stable_sort(library.begin(), library.end(), [](const LibraryEntry& a, const LibraryEntry& b) {
+			return (a.path.rfind("/net/", 0) != 0) > (b.path.rfind("/net/", 0) != 0);
+		});
+		std::map<uint64, std::vector<std::string>> copies;
+		for (const LibraryEntry& entry : library)
+			if (entry.kind == 0 && entry.appId)
+				copies[entry.appId].push_back(entry.path);
+		std::set<uint64> shown;
+		size_t duplicates = 0;
+		for (LibraryEntry& entry : library)
+		{
+			if (entry.kind != 0)
+				continue;
+			if (entry.appId)
+			{
+				const std::vector<std::string>& all = copies[entry.appId];
+				const std::string chosen = SourceChoice(fmt::format("{:016x}", entry.appId), "game");
+				const bool hasChoice = std::find(all.begin(), all.end(), chosen) != all.end();
+				// the chosen copy, else the first; the others are only in its list
+				if (hasChoice ? entry.path != chosen : entry.path != all.front())
+				{
+					duplicates++;
+					continue;
+				}
+				if (!shown.insert(entry.appId).second)
+					continue;
+			}
+			Game game;
+			game.appId = entry.appId;
+			if (entry.appId)
+				game.copies = copies[entry.appId];
+			if (entry.appId)
+			{
+				auto u = updates.find((uint32)entry.appId);
+				if (u != updates.end())
+				{
+					game.updates = u->second;
+					attached += u->second.size();
+				}
+				auto d = dlcs.find((uint32)entry.appId);
+				if (d != dlcs.end())
+				{
+					game.dlcs = d->second;
+					attached += d->second.size();
+				}
+				auto newest = [](const Game::Source& a, const Game::Source& b) { return a.version > b.version; };
+				std::stable_sort(game.updates.begin(), game.updates.end(), newest);
+				std::stable_sort(game.dlcs.begin(), game.dlcs.end(), newest);
+			}
+			game.path = entry.path;
+			game.id = entry.titleId;
+			game.title = entry.title;
+			game.product = entry.product;
+			game.region = entry.region;
+			game.format = entry.format;
+			game.version = entry.version;
+			game.homebrew = entry.titleId.empty();
+			if (!entry.icon.empty())
+			{
+				game.icon = m_display.CreateTexture(entry.icon.data(), entry.iconWidth, entry.iconHeight);
+				game.iconAspect = (float)entry.iconWidth / (float)entry.iconHeight;
+			}
+			game.cover = game.icon;
+			game.coverAspect = game.iconAspect;
+			LoadBoxArt(game);
+			m_games.push_back(std::move(game));
+		}
+		std::sort(m_games.begin(), m_games.end(), [](const Game& a, const Game& b) { return Lower(a.title) < Lower(b.title); });
+		Log(fmt::format("games: {} updates and DLC found next to their games, {} more copies of listed games", attached, duplicates));
+		WriteTitleExtras();
+	}
