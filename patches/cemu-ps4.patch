+// Cheats: Cafe codes, the Wii U's Gecko codes (CosmoCortney's code types, as TCPGecko / JGecko U and
+// GameHacking.org use them), per game in data_dir/cheats/<title ID>.txt. Typed in the launcher
+// (Triangle > Cheats), or the file copied there by FTP:
+//
+//   # comment
+//   +Infinite Hearts        a cheat that is on ("-" for off)
+//   00000000 15073BC3       its code: two groups of 8 hex digits per line
+//   00000050 00000000
+//
+// The game process runs the cheats that are on 120 times a second, as the Wii U's code handler does,
+// and reads the file again when it changes.
+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace CremaCheats
+{
+struct Cheat
+{
+	std::string name;
+	bool on = false;
+	std::vector<uint32> words; // the code, two words per line
+};
+
+std::string FilePath(const std::string& dataDir, const std::string& titleId);
+std::vector<Cheat> Load(const std::string& dataDir, const std::string& titleId);
+bool Save(const std::string& dataDir, const std::string& titleId, const std::vector<Cheat>& cheats);
+
+// "00000000 15073BC3 00000050 00000000" (any spacing, line breaks, dashes) -> the code; empty, with
+// the reason in error, unless it is whole lines of two 8-digit hex groups
+std::vector<uint32> ParseCode(const std::string& text, std::string* error);
+
+// Game process: runs the game's cheats that are on (titleId: 16 hex digits).
+void Start(const std::string& dataDir, const std::string& titleId);
+} // namespace CremaCheats
