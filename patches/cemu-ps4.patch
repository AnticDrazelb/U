+	// Square on the games, or a new Game Folder: the folder is read again.
+	// Deletes a file, or a folder with everything in it, as DolphinPS4's PS4RemoveAll (FileUtil.cpp):
+	// std::filesystem::remove_all fails on the PS4 with "function not implemented" (it uses
+	// unlinkat, which the OpenOrbis C library only stubs). Goes on past what it can't delete;
+	// counts what it removed, and false with the first failure's reason.
+	bool RemoveTree(const std::string& path, uintmax_t& count, std::string& error)
+	{
+		auto fail = [&] {
+			if (error.empty())
+				error = strerror(errno);
+			return false;
+		};
+		struct stat info;
+		if (lstat(path.c_str(), &info) != 0)
+			return errno == ENOENT || fail();
+		if (!S_ISDIR(info.st_mode))
+		{
+			if (unlink(path.c_str()) != 0)
+				return fail();
+			count++;
+			return true;
+		}
+		std::vector<std::string> names;
+		if (DIR* dir = opendir(path.c_str()))
+		{
+			while (const dirent* entry = readdir(dir))
+			{
+				const std::string name = entry->d_name;
+				if (name != "." && name != "..")
+					names.push_back(name);
+			}
+			closedir(dir);
+		}
+		bool ok = true;
+		for (const std::string& name : names)
+			ok = RemoveTree(path + "/" + name, count, error) && ok;
+		if (rmdir(path.c_str()) != 0)
+			return fail();
+		count++;
+		return ok;
+	}
+
+	// What deleting a game removes: its folder (title.tmd's, or the one holding code/<name>.rpx),
+	// or its file (.wua, .wud, .wux, .wuhb, .rpx, .elf). Empty: not strictly inside the games
+	// folder (files straight in it, or somewhere else), so nothing is deleted.
+	std::string Menu::DeleteTarget(const Game& game) const
+	{
+		const fs::path path = _utf8ToPath(game.path);
+		const std::string name = Lower(path.filename().string());
+		fs::path target = path;
+		if (name == "title.tmd")
+			target = path.parent_path();
+		else if (Lower(path.extension().string()) == ".rpx" && Lower(path.parent_path().filename().string()) == "code")
+			target = path.parent_path().parent_path();
+		const std::string games = _pathToUtf8(_utf8ToPath(GamesFolder()).lexically_normal());
+		const std::string candidate = _pathToUtf8(target.lexically_normal());
+		const std::string prefix = games.back() == '/' ? games : games + "/";
+		if (candidate.size() <= prefix.size() || candidate.compare(0, prefix.size(), prefix) != 0)
+			return {};
+		return candidate;
+	}
+
+	// Deletes the game (and its update and DLC in mlc01), refreshes the list; the lines to show.
+	std::vector<std::string> Menu::DeleteGame(const Game& game, bool withAddOns)
+	{
+		std::vector<std::string> lines = {game.title, ""};
+		const std::string target = DeleteTarget(game);
+		if (target.empty())
+		{
+			lines.push_back("Not deleted: it isn't in its own place in the games folder.");
+			return lines;
+		}
+		uintmax_t removed = 0;
+		std::string error;
+		const bool ok = RemoveTree(target, removed, error);
+		Log("delete: " + target + (ok ? " (" + std::to_string(removed) + " entries)" : " failed after " + std::to_string(removed) + " entries: " + error));
+		if (!ok)
+		{
+			lines.push_back("Couldn't delete it all: " + error);
+			RefreshGames();
+			return lines;
+		}
+		lines.push_back("Deleted.");
+		if (withAddOns && game.id.size() == 16)
+		{
+			const std::string titles = m_dataDir + "/mlc01/usr/title/";
+			const std::string low = game.id.substr(8);
+			for (const char* kind : {"0005000e", "0005000c"})
+			{
+				const std::string folder = titles + kind + "/" + low;
+				std::error_code ec2;
+				uintmax_t count = 0;
+				std::string error2;
+				if (fs::exists(folder, ec2) && RemoveTree(folder, count, error2))
+				{
+					Log("delete: " + folder);
+					lines.push_back(std::string(kind) == "0005000e" ? "Its update: deleted." : "Its DLC: deleted.");
+				}
+			}
+		}
+		lines.push_back("Saves are kept.");
+		if (m_prefs.defaultGame == game.path)
+		{
+			m_prefs.defaultGame.clear();
+			m_prefs.Save(m_dataDir + "/launcher.ini");
+		}
+		RefreshGames();
+		return lines;
+	}
+
+	void Menu::RefreshGames()
+	{
+		const int gamesIndex = (int)Category::Games;
+		std::string selectedPath;
+		const auto& items = m_items[gamesIndex];
+		if (!items.empty() && items[m_selected[gamesIndex]].game >= 0)
+			selectedPath = m_games[items[m_selected[gamesIndex]].game].path;
+		for (Game& game : m_games)
+		{
+			if (game.cover && game.cover != game.icon)
+				m_display.DestroyTexture(game.cover);
+			if (game.icon)
+				m_display.DestroyTexture(game.icon);
+		}
+		m_games.clear();
+		ps4_netfs_forget(); // the share is looked at again too
+		BuildGames(ScanAllGames());
+		BuildItems();
+		m_selected[gamesIndex] = 0;
+		m_itemPos[gamesIndex] = 0.0f;
+		const auto& refreshed = m_items[gamesIndex];
+		for (size_t i = 0; i < refreshed.size(); i++)
+		{
+			if (refreshed[i].game >= 0 && m_games[refreshed[i].game].path == selectedPath)
+			{
+				m_selected[gamesIndex] = (int)i;
+				m_itemPos[gamesIndex] = (float)i;
+			}
+		}
+		Log("games: " + std::to_string(m_games.size()) + " in " + GamesFolder());
+	}
+
+	// Game Folder: a folder browser. "" shows the places games can be (the console's storage and
+	// USB drives); a folder shows "Use This Folder", ".." and its subfolders.
+	void Menu::OpenFolderBrowser(const std::string& path)
+	{
+		const bool reopen = m_panel.open && m_panel.setting == SET_GAMES_DIR;
+		m_panel = {};
+		m_panel.open = true;
+		m_panel.setting = SET_GAMES_DIR;
+		m_panel.title = "Game Folder";
+		m_browseDir = path;
+		std::vector<SettingRow> rows;
+		std::error_code ec;
+		if (path.empty())
+		{
+			rows.push_back({"Places", "", "", true});
+			rows.push_back({"/", "Console root", "dir:/"});
+			rows.push_back({"/mnt", "Drives", "dir:/mnt"});
+			std::vector<std::string> places = {"/data", m_dataDir + "/games"};
+			for (int i = 0; i < 8; i++)
+				places.push_back("/mnt/usb" + std::to_string(i));
+			places.push_back("/mnt/ext0");
+			places.push_back("/mnt/ext1");
+			for (const std::string& place : places)
+			{
+				std::error_code placeError;
+				if (fs::is_directory(place, placeError))
+					rows.push_back({place, "", "dir:" + place});
+			}
+		}
+		else
+		{
+			rows.push_back({path, "", "", true});
+			std::vector<std::string> folders;
+			bool readable = false;
+			for (const auto& entry : fs::directory_iterator(path, ec))
+			{
+				readable = true;
+				const std::string name = entry.path().filename().string();
+				std::error_code typeError;
+				if (entry.is_directory(typeError) && (name.empty() || name[0] != '.'))
+					folders.push_back(name);
+			}
+			std::sort(folders.begin(), folders.end());
+			rows.push_back({"Use This Folder", "", "usedir"});
+			std::string parent = fs::path(path).parent_path().string();
+			if (parent.empty())
+				parent = "/";
+			const bool top = path == "/";
+			rows.push_back({"..", top ? "Places" : parent, top ? "dir:" : "dir:" + parent});
+			if (!readable && ec)
+				rows.push_back({"(this folder can't be opened: " + ec.message() + ")", "", "", true});
+			for (const std::string& folder : folders)
+			{
+				const std::string full = path == "/" ? "/" + folder : path + "/" + folder;
+				rows.push_back({folder + "/", "", "dir:" + full});
+			}
+		}
+		m_panel.rows = std::move(rows);
+		m_panel.selected = 0;
+		MoveSettingRow(0);
+		if (!reopen)
+			Play("menu");
+	}
