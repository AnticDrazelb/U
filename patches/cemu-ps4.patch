+	// A textured quad with a colour per corner (the Library's cover reflections fade out).
+	void ImageQuadColors(ImDrawList* dl, ImTextureID texture, ImVec2 a, ImVec2 b, ImVec2 c, ImVec2 d, ImVec2 uvA,
+		ImVec2 uvB, ImVec2 uvC, ImVec2 uvD, ImU32 ca, ImU32 cb, ImU32 cc, ImU32 cd)
+	{
+		dl->PushTextureID(texture);
+		dl->PrimReserve(6, 4);
+		const ImDrawIdx idx = (ImDrawIdx)dl->_VtxCurrentIdx;
+		dl->PrimWriteIdx(idx);
+		dl->PrimWriteIdx((ImDrawIdx)(idx + 1));
+		dl->PrimWriteIdx((ImDrawIdx)(idx + 2));
+		dl->PrimWriteIdx(idx);
+		dl->PrimWriteIdx((ImDrawIdx)(idx + 2));
