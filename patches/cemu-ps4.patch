+	void Menu::BuildGames(std::vector<LibraryEntry> library)
+	{
+		for (LibraryEntry& entry : library)
+		{
+			Game game;
+			game.path = entry.path;
+			game.id = entry.titleId;
+			game.title = entry.title;
+			game.product = entry.product;
+			game.region = entry.region;
+			game.format = entry.format;
+			game.version = entry.version;
+			game.homebrew = entry.titleId.empty();
+			if (!entry.icon.empty())
+			{
+				game.icon = m_display.CreateTexture(entry.icon.data(), entry.iconWidth, entry.iconHeight);
+				game.iconAspect = (float)entry.iconWidth / (float)entry.iconHeight;
+			}
+			game.cover = game.icon;
+			game.coverAspect = game.iconAspect;
+			LoadBoxArt(game);
+			m_games.push_back(std::move(game));
+		}
+		std::sort(m_games.begin(), m_games.end(), [](const Game& a, const Game& b) { return Lower(a.title) < Lower(b.title); });
+	}
+
+	// Box art: data_dir/covers/<ID>.png (the user's own) or <ID>.jpg (downloaded from GameTDB), by
+	// GameTDB ID (product code + company) or title ID. Shown instead of the icon.
+	void Menu::LoadBoxArt(Game& game)
+	{
+		if (game.boxArt)
+			return;
+		for (const std::string& name : {game.product, game.id})
+		{
+			if (name.empty())
+				continue;
+			for (const char* extension : {".png", ".jpg"})
+			{
+				const std::string data = ReadFile(m_dataDir + "/covers/" + name + extension);
+				if (data.empty())
+					continue;
+				std::vector<uint8> pixels;
+				uint32_t width = 0, height = 0;
+				const bool decoded = std::string(extension) == ".png" ? DecodePng(data, pixels, width, height) :
+					DecodeJpeg(data, pixels, width, height);
+				if (!decoded)
+				{
+					Log("not a picture: covers/" + name + extension);
+					continue;
+				}
+				game.cover = m_display.CreateTexture(pixels.data(), width, height);
+				game.coverAspect = (float)width / (float)height;
+				game.boxArt = game.cover != nullptr;
+				if (game.boxArt)
+					return;
+			}
+		}
+	}
+
+	void Menu::StartCoverDownload()
+	{
+		if (m_coverThread.joinable())
+			return; // already running
+		m_coverCancel = false;
+		m_coverDone = false;
+		{
+			std::lock_guard lock(m_coverMutex);
+			m_coverStatus = "Connecting to GameTDB...";
+		}
+		std::vector<std::string> ids;
+		for (const Game& game : m_games)
+		{
+			if (!game.boxArt)
+				ids.push_back(game.product);
+		}
+		m_coverThread = std::thread([this, ids] {
+			const CremaCovers::Result result = CremaCovers::Download(ids, m_dataDir + "/covers", m_assetsDir + "/xmb/cacert.pem",
+				[this](int done, int total, const std::string& id) {
+					std::lock_guard lock(m_coverMutex);
+					m_coverStatus = id.empty() ? "Finishing..." :
+						"Downloading " + std::to_string(done + 1) + " of " + std::to_string(total) + ": " + id;
+				},
+				m_coverCancel);
+			std::lock_guard lock(m_coverMutex);
+			m_coverResult = result;
+			m_coverDone = true;
+		});
+	}
+
+	// Shows the download's progress in its panel; at the end, shows the new covers.
+	void Menu::UpdateCoverDownload()
+	{
+		if (!m_coverThread.joinable())
+			return;
+		std::string status;
+		{
+			std::lock_guard lock(m_coverMutex);
+			status = m_coverStatus;
+		}
+		if (!m_coverDone)
+		{
+			if (m_panel.open && m_panel.setting == SET_COVERS)
+				m_panel.lines = {"", status, "", "Circle closes this; the download goes on."};
+			return;
+		}
+		m_coverThread.join();
+		const CremaCovers::Result result = m_coverResult;
+		for (Game& game : m_games)
+			LoadBoxArt(game);
+		Log(fmt::format("covers: {} downloaded, {} already there, {} not on GameTDB, {} failed {}", result.downloaded,
+			result.already, result.notFound, result.failed, result.error));
+		if (m_panel.open && m_panel.setting == SET_COVERS)
+		{
+			m_panel.lines = {"", "Downloaded: " + std::to_string(result.downloaded), "Already there: " + std::to_string(result.already),
+				"Not on GameTDB: " + std::to_string(result.notFound)};
+			if (result.failed > 0)
+			{
+				m_panel.lines.push_back("Failed: " + std::to_string(result.failed));
+				m_panel.lines.push_back(result.error);
+			}
+			m_panel.lines.push_back("");
+			m_panel.lines.push_back("Your own pictures: " + m_dataDir + "/covers/<ID>.png");
+			Play(result.failed > 0 ? "error" : "confirm");
+		}
+	}
+
+	void Menu::LoadAssets()
+	{
+		ImGuiIO& io = ImGui::GetIO();
+		const std::string fonts = m_assetsDir + "/xmb/fonts/";
+		// ImGui 1.89 bakes the glyphs into one atlas up front: Latin and Cyrillic from Nunito, and
+		// the Japanese / Chinese / Korean characters the translations use (from their files).
+		static ImVector<ImWchar> s_ranges;
+		static ImVector<ImWchar> s_cjkRanges;
+		if (s_ranges.empty())
+		{
+			ImFontGlyphRangesBuilder builder;
+			builder.AddRanges(io.Fonts->GetGlyphRangesDefault());
+			builder.AddRanges(io.Fonts->GetGlyphRangesCyrillic());
+			static const ImWchar extra[] = {0x0100, 0x017F, 0x2010, 0x205E, 0x2190, 0x21FF, 0};
+			builder.AddRanges(extra);
+			builder.BuildRanges(&s_ranges);
+			ImFontGlyphRangesBuilder cjk;
+			for (const char* code : {"ja", "zh", "ko"})
+				cjk.AddText(ReadFile(m_assetsDir + "/xmb/lang/" + code + ".ini").c_str());
+			for (const auto& language : PS4Lang::All())
+				cjk.AddText(language.name);
+			cjk.BuildRanges(&s_cjkRanges);
+		}
+		auto addFont = [&](const char* file, bool bold) {
+			ImFont* font = io.Fonts->AddFontFromFileTTF((fonts + file).c_str(), 40.0f, nullptr, s_ranges.Data);
+			if (!font)
+				return font;
+			for (const std::string& extra : PS4Lang::ExtraFonts(m_assetsDir, bold))
+			{
+				ImFontConfig config;
+				config.MergeMode = true;
+				io.Fonts->AddFontFromFileTTF(extra.c_str(), 40.0f, &config, s_cjkRanges.Data);
+			}
+			return font;
+		};
+		m_font = addFont("Nunito-Regular.ttf", false);
+		m_bold = addFont("Nunito-ExtraBold.ttf", true);
+		if (!m_font)
+			m_font = io.Fonts->AddFontDefault();
+		if (!m_bold)
+			m_bold = m_font;
+
+		for (const char* name : {"move", "category", "confirm", "back", "launch", "error", "menu", "intro"})
+		{
+			// A sound in data_dir/themes/sounds replaces the built-in one.
+			std::unique_ptr<Sound> sound = LoadWav(m_dataDir + "/themes/sounds/" + name + ".wav");
+			if (!sound)
+				sound = LoadWav(m_assetsDir + "/xmb/sounds/" + name + ".wav");
+			if (sound)
+				m_sounds[name] = std::move(sound);
+			else
+				Log(std::string("sound not loaded: ") + name);
+		}
+
+		const std::string art = m_assetsDir + "/launcher/";
+		m_logo = LoadPngTexture(art + "logo.png");
+		m_introConsole = LoadPngTexture(art + "intro-console.png", &m_introConsoleAspect);
+		m_introCoffee = LoadPngTexture(art + "intro-coffee.png", &m_introCoffeeAspect);
+		m_introTitle = LoadPngTexture(art + "intro-title.png", &m_introTitleAspect);
+		{
+			constexpr int SIZE = 64;
+			std::vector<uint8> pixels(SIZE * SIZE * 4);
+			for (int y = 0; y < SIZE; y++)
+			{
+				for (int x = 0; x < SIZE; x++)
+				{
+					const float dx = (x + 0.5f) / SIZE * 2.0f - 1.0f, dy = (y + 0.5f) / SIZE * 2.0f - 1.0f;
+					uint8* px = &pixels[(y * SIZE + x) * 4];
+					px[0] = px[1] = px[2] = 255;
+					px[3] = (uint8)(std::exp(-(dx * dx + dy * dy) * 4.0f) * 255.0f);
+				}
+			}
+			m_glow = m_display.CreateTexture(pixels.data(), SIZE, SIZE);
+		}
+
+		std::error_code error;
+		for (const auto& entry : fs::directory_iterator(m_dataDir + "/themes", error))
+		{
+			const std::string name = entry.path().filename().string();
+			const std::string lower = Lower(name);
+			if (lower.size() > 4 && lower.compare(lower.size() - 4, 4, ".png") == 0)
+				m_wallpapers.push_back(name);
+		}
+		std::sort(m_wallpapers.begin(), m_wallpapers.end());
+	}
+
+	// Square on the games, or a new Game Folder: the folder is read again.
+	void Menu::RefreshGames()
+	{
+		const int gamesIndex = (int)Category::Games;
+		std::string selectedPath;
+		const auto& items = m_items[gamesIndex];
+		if (!items.empty() && items[m_selected[gamesIndex]].game >= 0)
+			selectedPath = m_games[items[m_selected[gamesIndex]].game].path;
+		for (Game& game : m_games)
+		{
+			if (game.cover && game.cover != game.icon)
+				m_display.DestroyTexture(game.cover);
+			if (game.icon)
+				m_display.DestroyTexture(game.icon);
+		}
+		m_games.clear();
+		BuildGames(ScanLibrary(GamesFolder()));
+		BuildItems();
+		m_selected[gamesIndex] = 0;
+		m_itemPos[gamesIndex] = 0.0f;
+		const auto& refreshed = m_items[gamesIndex];
+		for (size_t i = 0; i < refreshed.size(); i++)
+		{
+			if (refreshed[i].game >= 0 && m_games[refreshed[i].game].path == selectedPath)
+			{
+				m_selected[gamesIndex] = (int)i;
+				m_itemPos[gamesIndex] = (float)i;
+			}
+		}
+		Log("games: " + std::to_string(m_games.size()) + " in " + GamesFolder());
+	}
+
+	// Game Folder: a folder browser. "" shows the places games can be (the console's storage and
+	// USB drives); a folder shows "Use This Folder", ".." and its subfolders.
+	void Menu::OpenFolderBrowser(const std::string& path)
+	{
+		const bool reopen = m_panel.open && m_panel.setting == SET_GAMES_DIR;
+		m_panel = {};
+		m_panel.open = true;
+		m_panel.setting = SET_GAMES_DIR;
+		m_panel.title = "Game Folder";
+		m_browseDir = path;
+		std::vector<SettingRow> rows;
+		std::error_code ec;
+		if (path.empty())
+		{
+			rows.push_back({"Places", "", "", true});
+			rows.push_back({"/", "Console root", "dir:/"});
+			rows.push_back({"/mnt", "Drives", "dir:/mnt"});
+			std::vector<std::string> places = {"/data", m_dataDir + "/games"};
+			for (int i = 0; i < 8; i++)
+				places.push_back("/mnt/usb" + std::to_string(i));
+			places.push_back("/mnt/ext0");
+			places.push_back("/mnt/ext1");
+			for (const std::string& place : places)
+			{
+				std::error_code placeError;
+				if (fs::is_directory(place, placeError))
+					rows.push_back({place, "", "dir:" + place});
+			}
+		}
+		else
+		{
+			rows.push_back({path, "", "", true});
+			std::vector<std::string> folders;
+			bool readable = false;
+			for (const auto& entry : fs::directory_iterator(path, ec))
+			{
+				readable = true;
+				const std::string name = entry.path().filename().string();
+				std::error_code typeError;
+				if (entry.is_directory(typeError) && (name.empty() || name[0] != '.'))
+					folders.push_back(name);
+			}
+			std::sort(folders.begin(), folders.end());
+			rows.push_back({"Use This Folder", "", "usedir"});
+			std::string parent = fs::path(path).parent_path().string();
+			if (parent.empty())
+				parent = "/";
+			const bool top = path == "/";
+			rows.push_back({"..", top ? "Places" : parent, top ? "dir:" : "dir:" + parent});
+			if (!readable && ec)
+				rows.push_back({"(this folder can't be opened: " + ec.message() + ")", "", "", true});
+			for (const std::string& folder : folders)
+			{
+				const std::string full = path == "/" ? "/" + folder : path + "/" + folder;
+				rows.push_back({folder + "/", "", "dir:" + full});
+			}
+		}
+		m_panel.rows = std::move(rows);
+		m_panel.selected = 0;
+		MoveSettingRow(0);
+		if (!reopen)
+			Play("menu");
+	}
+
+	ImTextureID Menu::LoadPngTexture(const std::string& path, float* aspect)
+	{
+		const std::string data = ReadFile(path);
+		if (data.empty())
+			return nullptr;
+		std::vector<uint8> pixels;
+		uint32_t width = 0, height = 0;
+		if (!DecodePng(data, pixels, width, height))
+		{
+			Log("not a PNG: " + path);
+			return nullptr;
+		}
+		if (aspect)
+			*aspect = (float)width / (float)height;
+		return m_display.CreateTexture(pixels.data(), width, height);
+	}
