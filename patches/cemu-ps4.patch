+void LoadGameControls(const std::string& gameId)
+{
+	sGameId = gameId;
+	LoadBlowCombo();
+	for (int player = 0; player < kPlayers; player++)
+	{
+		if (HasGameLayout(player) && InputManager::instance().load(player, GameLayoutName(player)))
+			ps4_boot_trace(fmt::format("controls: player {} uses this game's own layout", player + 1).c_str());
+		ApplyPointerMode(player);
+	}
+}
+
+void SetupPlayers()
+{
+	// players 2-4: a Pro Controller each on their DualShock 4 the first time (not connected until
+	// a second, third or fourth PS4 user signs in with a pad); then what the menu set
+	for (int player = 1; player < kPlayers; player++)
+	{
+		if (!PlayerController(player))
+			SetKind(player, KIND_PRO);
+		ApplyPointerMode(player);
+	}
+	ApplyPointerMode(0);
+}
+
+void Install(const std::string& gameId, const std::string& launchPath)
+{
+	sGameId = gameId;
+	sLaunchPath = launchPath;
+	g_crema_overlay = &Frame;
+}
+} // namespace PS4PauseMenu
