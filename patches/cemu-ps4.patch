+	// Cemu's frontend callbacks: when the game ends its process (it quit, or gave up with an error),
+	// the app restarts into the launcher, as the Wii U returns to its menu.
+	class PS4SystemImplementation : public CafeSystem::SystemImplementation
+	{
+	public:
+		void CafeRecreateCanvas() override {}
+		void CafePPCProcessExit() override
+		{
+			const sint32 status = CafeSystem::GetForegroundTitleReturnStatus().value_or(-1);
+			Trace(fmt::format("the game ended (exit status {}): back to the launcher", status));
+			if (status != 0)
+			{
+				const std::string headline = fmt::format("The game closed itself with an error ({}).", status);
+				const std::string detail = g_crema_last_panic.empty() ? std::string() : "Game error: " + g_crema_last_panic;
+				WriteStopNote(headline.c_str(), detail.c_str());
+			}
+			std::error_code ec;
+			fs::remove(kDataRoot / "launch.txt", ec);
+			sceSystemServiceLoadExec("/app0/eboot.bin", nullptr);
+		}
+	} sSystemImplementation;
+} // namespace
