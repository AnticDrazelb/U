+
 void PPCTimer_init()
 {
+#ifdef __ORBIS__
+	// PS4: the kernel knows the exact TSC frequency
+	_rdtscFrequency = sceKernelGetTscFrequency();
+	cemuLog_log(LogType::Force, "TSC frequency: {} Hz", _rdtscFrequency);
+#else
 	std::thread t(PPCTimer_initThread);
 	t.detach();
+#endif
 	_rdtscLastMeasure = __rdtsc();
+#if defined(__ORBIS__)
+	s_cremaTscBaseInit(_rdtscLastMeasure);
+#endif
 }
 
 uint64 _tickSummary = 0;
 
+#if defined(__ORBIS__)
+// (statics declared above PPCTimer_init)
+// Crema: the PS4's TSC is invariant and the same on every core, so the Wii U's time is one multiply
+// away from it: no lock, fence or 128-bit division. Cemu's version took a spinlock shared by the
+// three emulated cores on every mftb / OSGetTime, which Breath of the Wild calls constantly (~10%
+// of its main core). The CORE_CLOCK ticks per TSC tick as 32.32 fixed point (exact to 1 in 3e9).
+static uint64 s_cremaTscBase = 0;
+static uint64 s_cremaTicksPerTsc = 0;
+static void s_cremaTscBaseInit(uint64 tsc)
+{
+	s_cremaTscBase = tsc;
+	if (_rdtscFrequency)
+		s_cremaTicksPerTsc = (uint64)(((unsigned __int128)Espresso::CORE_CLOCK << 32) / _rdtscFrequency);
+}
+#endif
+
 void PPCTimer_start()
 {
 	_rdtscLastMeasure = __rdtsc();
 	_tickSummary = 0;
+#if defined(__ORBIS__)
+	s_cremaTscBase = _rdtscLastMeasure;
+#endif
 }
 
 uint64 PPCTimer_getRawTsc()
