+	void Menu::StartUpdateCheck(bool manual)
+	{
+		m_updateManual = m_updateManual || manual;
+		const UpdateState state = m_updateState;
+		if (m_updateThread.joinable() || state == UpdateState::Downloading || state == UpdateState::Finished)
+			return;
+		m_updateState = UpdateState::Checking;
+		m_updateThread = std::thread([this] {
+			const CremaUpdater::Release release = CremaUpdater::CheckLatest(m_assetsDir + "/xmb/cacert.pem", m_updatePrefix);
+			std::lock_guard lock(m_updateMutex);
+			m_updateRelease = release;
+			m_updateError = release.error;
+			if (!release.ok)
+				m_updateState = UpdateState::Failed;
+			else if (CremaUpdater::CompareVersions(release.version, m_version) > 0)
+				m_updateState = UpdateState::Available;
+			else
+				m_updateState = UpdateState::UpToDate;
+		});
+	}
+
+	void Menu::StartUpdateDownload()
+	{
+		if (m_updateThread.joinable())
+			m_updateThread.join();
+		m_updateCancel = false;
+		m_updateDone = 0;
+		m_updateTotal = m_updateRelease.size;
+		m_updateState = UpdateState::Downloading;
+		m_updateThread = std::thread([this] {
+			CremaUpdater::Release release;
+			{
+				std::lock_guard lock(m_updateMutex);
+				release = m_updateRelease;
+			}
+			// where the PS4's package installers look; the app can't install over itself
+			mkdir("/data/pkg", 0777);
+			const std::string path = "/data/pkg/" + m_updatePrefix + "-v" + release.version + ".pkg";
+			std::string error;
+			const bool ok = CremaUpdater::Download(release, path, m_assetsDir + "/xmb/cacert.pem",
+				[this](uint64_t done, uint64_t total) {
+					m_updateDone = done;
+					if (total)
+						m_updateTotal = total;
+					return !m_updateCancel;
+				},
+				&error);
+			std::lock_guard lock(m_updateMutex);
+			if (!ok)
+			{
+				m_updateError = m_updateCancel ? "" : error;
+				m_updateState = m_updateCancel ? UpdateState::Available : UpdateState::Failed;
+				Log("update: " + (m_updateCancel ? std::string("cancelled") : error));
+				return;
+			}
+			Log("update: " + path + " ready for the package installer");
+			m_updateReady = path;
+			m_updateState = UpdateState::Finished;
+		});
+	}
+
+	// The update panel shows the state: checking, the prompt, the download, the result.
+	void Menu::ShowUpdatePanel()
+	{
+		CremaUpdater::Release release;
+		std::string error, ready;
+		{
+			std::lock_guard lock(m_updateMutex);
+			release = m_updateRelease;
+			error = m_updateError;
+			ready = m_updateReady;
+		}
+		const std::string app = m_updatePrefix == "Crema-Lab" ? "Crema Lab" : "Crema";
+		const std::string latest = app + " v" + release.version;
+		std::vector<std::string> lines, options;
+		std::string title = "Updates";
+		switch (m_updateState.load())
+		{
+		case UpdateState::Idle:
+		case UpdateState::Checking:
+			lines = {"", "Looking for a new version on GitHub..."};
+			break;
+		case UpdateState::UpToDate:
+			lines = {"", "You have the latest version.", "", "Installed: v" + m_version};
+			break;
+		case UpdateState::Available:
+			title = "Update Available";
+			lines = {"", latest + " is available.", "You have v" + m_version + ".", "",
+				fmt::format("Download it ({:.0f} MB)?", release.size / 1048576.0)};
+			options = {"Yes", "No"};
+			break;
+		case UpdateState::Downloading:
+		{
+			title = "Downloading Update";
+			const uint64_t done = m_updateDone, total = std::max<uint64_t>(m_updateTotal, 1);
+			lines = {"", latest, fmt::format("{}%   {:.0f} of {:.0f} MB", (int)(done * 100 / total), done / 1048576.0, total / 1048576.0), "",
+				"Keep the app open until it's done."};
+			options = {"Cancel"};
+			break;
+		}
+		case UpdateState::Finished:
+			title = "Update Ready";
+			lines = {"", latest + " is downloaded and checked.", "",
+				"To install it, close " + app + ", then open",
+				"GoldHEN's Package Installer (or Debug Settings >",
+				"Game > Package Installer) and pick it.", "",
+				"Saved as " + ready,
+				"Games, saves and settings are kept."};
+			options = {"OK"};
+			break;
+		case UpdateState::Failed:
+			title = "Updates";
+			lines = {"", m_updatePrompted ? "The update didn't work:" : "Couldn't check for updates:", error};
+			options = {"OK"};
+			break;
+		}
+		const bool sameOptions = m_panel.open && m_panel.setting == SET_UPDATE && m_panel.options == options;
+		if (!(m_panel.open && m_panel.setting == SET_UPDATE))
+			m_panel = {};
+		m_panel.open = true;
+		m_panel.setting = SET_UPDATE;
+		m_panel.title = title;
+		m_panel.lines = lines;
+		m_panel.rows.clear();
+		if (!sameOptions)
+		{
+			m_panel.options = options;
+			m_panel.selected = 0;
+		}
+	}
+
+	void Menu::ChooseUpdateOption()
+	{
+		if (m_panel.selected < 0 || m_panel.selected >= (int)m_panel.options.size())
+			return;
+		const std::string choice = m_panel.options[m_panel.selected];
+		if (choice == "Yes")
+		{
+			StartUpdateDownload();
+			Play("confirm");
+		}
+		else if (choice == "Cancel")
+		{
+			m_updateCancel = true;
+			Play("back");
+		}
+		else
+		{
+			m_panel.open = false;
+			Play("back");
+		}
+	}
+
+	// every frame: the background check's and the download's news
+	void Menu::UpdateUpdater()
+	{
+		const UpdateState state = m_updateState;
+		const bool settled = state == UpdateState::UpToDate || state == UpdateState::Available ||
+			state == UpdateState::Failed || state == UpdateState::Finished;
+		if (settled && m_updateThread.joinable())
+			m_updateThread.join();
+		const bool shown = m_panel.open && m_panel.setting == SET_UPDATE;
+		// a new version found in the background: asked once, when nothing else is on screen
+		if (state == UpdateState::Available && !m_updatePrompted && !m_intro && m_launch < 0 && !m_firstLanguage &&
+			!m_firstStyle && !m_keyboard && (!m_panel.open || shown))
+		{
+			m_updatePrompted = true;
+			ShowUpdatePanel();
+			Play("menu");
+			return;
+		}
+		if (!shown)
+		{
+			// background results nobody asked to see stay in the log; a finished download is shown once
+			if (state == UpdateState::Finished && !m_updateReadyShown && !m_panel.open && m_launch < 0)
+			{
+				m_updateReadyShown = true;
+				ShowUpdatePanel();
+				Play("confirm");
+			}
+			return;
+		}
+		if (state == UpdateState::Available)
+			m_updatePrompted = true;
+		if (state == UpdateState::Finished && !m_updateReadyShown)
+		{
+			m_updateReadyShown = true;
+			Play("confirm");
+		}
+		ShowUpdatePanel();
+	}
+
+	// The PS4's keyboard over the menu; UpdateKeyboard (every frame) takes its text when it closes.
+	void Menu::OpenKeyboard(const std::string& title, const std::string& text, const std::string& key)
+	{
+		m_keyboardKey = key;
+		static bool s_loaded = false;
+		if (!s_loaded)
+		{
+			sceSysmoduleLoadModule(ORBIS_SYSMODULE_IME_DIALOG);
+			sceSysmoduleLoadModuleInternal(ORBIS_SYSMODULE_INTERNAL_COMMON_DIALOG);
+			sceCommonDialogInitialize();
+			s_loaded = true;
+		}
+		// the dialog works in UTF-16 (the PS4's wchar_t); the text buffer must outlive it
+		static char16_t s_title[64];
+		// a cheat's code: many lines of hex (16 digits each, with spaces)
+		const size_t maxLength = key == "cheat_code" ? 1800 : 120;
+		m_keyboardText.assign(text.begin(), text.end());
+		m_keyboardText.resize(maxLength + 8, u'\0');
+		size_t i = 0;
+		for (; i + 1 < std::size(s_title) && i < title.size(); i++)
+			s_title[i] = (char16_t)(unsigned char)title[i];
+		s_title[i] = u'\0';
+		OrbisImeDialogSetting setting = {};
+		setting.userId = (uint32_t)m_user;
+		setting.type = key == "net_user" || key == "net_password" || key.rfind("cheat_", 0) == 0 ? ORBIS_TYPE_BASIC_LATIN :
+			ORBIS_TYPE_TYPE_URL;
+		setting.enterLabel = ORBIS_BUTTON_LABEL_DEFAULT;
+		setting.maxTextLength = (uint32_t)maxLength;
+		setting.inputTextBuffer = reinterpret_cast<wchar_t*>(m_keyboardText.data());
+		setting.posx = 1920.0f / 2;
+		setting.posy = 1080.0f / 2;
+		setting.horizontalAlignment = ORBIS_H_CENTER;
+		setting.verticalAlignment = ORBIS_V_CENTER;
+		setting.title = reinterpret_cast<const wchar_t*>(s_title);
+		const int result = sceImeDialogInit(&setting, nullptr);
+		Log(fmt::format("keyboard: open {:#x}", (unsigned)result));
+		m_keyboard = result >= 0;
+	}
+
+	void Menu::UpdateKeyboard()
+	{
+		if (!m_keyboard)
+			return;
+		const OrbisDialogStatus status = sceImeDialogGetStatus();
+		if (status == ORBIS_DIALOG_STATUS_RUNNING)
+			return;
+		OrbisDialogResult result = {};
+		if (status == ORBIS_DIALOG_STATUS_STOPPED)
+			sceImeDialogGetResult(&result);
+		sceImeDialogTerm();
+		m_keyboard = false;
+		const bool cheat = m_keyboardKey.rfind("cheat_", 0) == 0;
+		if (status != ORBIS_DIALOG_STATUS_STOPPED || result.endstatus != ORBIS_DIALOG_OK)
+		{
+			if (cheat && m_panel.open && m_panel.title == "Cheats")
+				Play("back"); // the cheats list stays
+			return;
+		}
+		// ASCII (a shared folder, a password or a cheat may have spaces in it; an address doesn't)
+		const bool network = m_keyboardKey.rfind("net_", 0) == 0 || cheat;
+		std::string text;
+		for (char16_t c : m_keyboardText)
+		{
+			if (c == u'\0')
+				break;
+			if ((c > u' ' || (network && c == u' ')) && c < 0x7F)
+				text += (char)c;
+		}
+		if (m_keyboardKey != "net_password")
+			boost::algorithm::trim(text);
+		if (m_keyboardKey == "cheat_name")
+		{
+			// then its code
+			m_cheatName = text.empty() ? fmt::format("Cheat {}", m_cheats.size() + 1) : text;
+			OpenKeyboard("Code: " + m_cheatName, "", "cheat_code");
+			return;
+		}
+		if (m_keyboardKey == "cheat_code")
+		{
+			std::string error;
+			const std::vector<uint32> words = CremaCheats::ParseCode(text, &error);
+			for (const Game& game : m_games)
+			{
+				if (game.id != m_cheatsGame)
+					continue;
+				if (words.empty())
+				{
+					ShowCheats(game);
+					m_panel.lines = {game.title, "", "That code wasn't added:", error, "",
+						"Type it as in the cheat lists, for example", "00000000 15073BC3 00000050 00000000"};
+					Play("error");
+					return;
+				}
+				m_cheats.push_back({m_cheatName, true, words});
+				CremaCheats::Save(m_dataDir, game.id, m_cheats);
+				Log(fmt::format("cheats: added {} ({} lines) for {}", m_cheatName, words.size() / 2, game.id));
+				ShowCheats(game);
+				m_panel.selected = (int)m_cheats.size() - 1;
+				Play("confirm");
+				return;
+			}
+			return;
+		}
+		CremaSettings::Set(m_keyboardKey.empty() ? "online_server" : m_keyboardKey, text);
+		if (network)
+		{
+			CremaSettings::MountNetworkLibrary();
+			m_netStatus.clear();
+		}
+		BuildSettingRows();
+		Play("confirm");
+	}
+
+	// Moves the selection by direction (0: onto the nearest selectable row), skipping headers.
+	void Menu::MoveSettingRow(int direction)
+	{
+		const int count = (int)m_panel.rows.size();
+		int row = std::clamp(m_panel.selected + direction, 0, std::max(0, count - 1));
+		const int step = direction < 0 ? -1 : 1;
+		while (row >= 0 && row < count && m_panel.rows[row].header)
+			row += step;
+		if (row >= 0 && row < count)
+			m_panel.selected = row;
+	}
+
+	void Menu::ChangeSettingRow(int direction)
+	{
+		if (m_panel.selected < 0 || m_panel.selected >= (int)m_panel.rows.size())
+			return;
+		const SettingRow& row = m_panel.rows[m_panel.selected];
+		const std::string& game = m_panel.gameId;
+		if (m_panel.setting == SET_GAME_PACKS)
+		{
+			if (row.key == "__packs_update__")
+			{
+				if (direction <= 0)
+					return; // Cross only
+				m_panel.rows.clear();
+				m_panel.lines = {"", m_packTitle, "", "Asking GitHub for the latest release..."};
+				StartPackDownload();
+				return;
+			}
+			const std::string key = row.key;
+			const int selected = m_panel.selected;
+			CremaGraphicPacks::Change(key, direction);
+			const float scroll = m_panel.scroll, slide = m_panel.slide;
+			OpenGamePacks(game, m_packTitle);
+			m_panel.selected = std::min(selected, (int)m_panel.rows.size() - 1);
+			m_panel.scroll = scroll;
+			m_panel.slide = slide;
+			return;
+		}
+		if (m_panel.setting == SET_GAMES_DIR)
+		{
+			if (direction <= 0)
+				return; // Cross only
+			if (row.key.rfind("dir:", 0) == 0)
+			{
+				OpenFolderBrowser(row.key.substr(4));
+			}
+			else if (row.key == "usedir")
+			{
+				m_prefs.gamesDir = m_browseDir == m_dataDir + "/games" ? "" : m_browseDir;
+				m_prefs.Save(m_dataDir + "/launcher.ini");
+				m_panel.open = false;
+				RefreshGames();
+				Play("confirm");
+			}
+			return;
+		}
+		if (row.key == "__server__")
+		{
+			if (direction > 0)
+				OpenKeyboard("Server Address", CremaSettings::Get("online_server"));
+			return;
+		}
+		if (row.key == "__net_address__" || row.key == "__net_user__" || row.key == "__net_password__")
+		{
+			const std::string key = row.key == "__net_address__" ? "net_address" : row.key == "__net_user__" ? "net_user" : "net_password";
+			if (direction > 0)
+				OpenKeyboard(row.label, key == "net_password" ? "" : CremaSettings::Get(key), key);
+			return;
+		}
+		if (row.key == "__net_check__")
+		{
+			if (direction > 0)
+			{
+				StartNetworkCheck();
+				BuildSettingRows();
+			}
+			return;
+		}
+		if (row.key.rfind("__files__", 0) == 0)
+		{
+			BuildSettingRows(); // looks at the folders again
+			return;
+		}
+		if (row.scope)
+		{
+			CremaSettings::SetCustom(game, !CremaSettings::IsCustom(game));
+		}
+		else if (row.key == "__reset__")
+		{
+			// A game: it follows the global settings again. A category: its values go back to the
+			// defaults.
+			if (direction <= 0)
+				return;
+			if (!game.empty())
+			{
+				CremaSettings::ResetGame(game);
+			}
+			else
+			{
+				for (const CremaSettings::Setting& setting : CremaSettings::All())
+				{
+					if (m_panel.category == setting.category)
+						CremaSettings::ResetGlobal(setting.key);
+				}
+			}
+		}
+		else if (!row.key.empty())
+		{
+			const CremaSettings::Setting* setting = CremaSettings::Find(row.key);
+			if (!setting)
+				return;
+			// A game following the global settings: changing one of its values makes it custom.
+			if (!game.empty() && !CremaSettings::IsCustom(game))
+				CremaSettings::SetCustom(game, true);
+			CremaSettings::Set(row.key, CremaSettings::Step(*setting, CremaSettings::Get(row.key, game), direction), game);
+			if (row.key == "language")
+				SetLanguage(CremaSettings::Get("language"));
+			if (row.key == "net_library")
+			{
+				CremaSettings::MountNetworkLibrary();
+				m_netStatus.clear();
+			}
+		}
+		BuildSettingRows();
+	}
+
+	void Menu::ApplySettingOption(int setting, int option)
+	{
+		switch (setting)
+		{
+		case SET_SOUNDS:
+			m_prefs.sounds = option == 0;
+			break;
+		case SET_VOLUME:
+			m_prefs.volume = 100 - option * 10;
+			break;
+		case SET_CLOCK:
+			m_prefs.clock = option == 0;
+			break;
+		case SET_AUTO_UPDATE:
+			m_prefs.autoUpdate = option == 0;
+			break;
+		case SET_LANGUAGE:
+			if (option >= 0 && option < (int)PS4Lang::All().size())
+				SetLanguage(PS4Lang::All()[option].code);
+			if (m_firstLanguage)
+			{
+				// the first start: then the menu style
+				m_firstLanguage = false;
+				if (m_prefs.style.empty())
+				{
+					ApplyPreferences();
+					BuildItems();
+					OpenSettingPanel(SET_STYLE);
+					m_panel.title = "Choose a Menu Style";
+					m_firstStyle = true;
+					return;
+				}
+			}
+			break;
+		case SET_STYLE:
+			m_prefs.style = option == 0 ? "library" : "xmb";
+			m_firstStyle = false;
+			m_tabPos = (float)LibraryTab();
+			Log("menu style: " + m_prefs.style);
+			break;
+		case SET_RESET_ALL:
+			if (option == 1)
+				CremaSettings::ResetAll();
+			return;
+		default:
+			return;
+		}
+		ApplyPreferences();
+		BuildItems();
+	}
+
+	void Menu::HandleInput(uint32_t pressed)
+	{
+		if (m_launch >= 0 || pressed == 0)
+			return;
+
+		if (m_panel.open)
+		{
+			if (pressed & BTN_CIRCLE)
+			{
+				// The first start's lists closed without a choice: the highlighted one.
+				if ((m_firstLanguage && m_panel.setting == SET_LANGUAGE) || (m_firstStyle && m_panel.setting == SET_STYLE))
+				{
+					ApplySettingOption(m_panel.setting, m_panel.selected);
+					if (m_panel.setting == SET_STYLE && m_firstStyle)
+						return; // the menu style list opened next
+				}
+				m_panel.open = false;
+				Play("back");
+				return;
+			}
+			if (!m_panel.rows.empty())
+			{
+				// Settings list: Up/Down pick, Left/Right (or Cross) change the value.
+				if (pressed & BTN_UP)
+				{
+					MoveSettingRow(-1);
+					Play("move");
+				}
+				if (pressed & BTN_DOWN)
+				{
+					MoveSettingRow(1);
+					Play("move");
+				}
+				if (pressed & (BTN_LEFT | BTN_RIGHT | BTN_CROSS))
+				{
+					ChangeSettingRow((pressed & BTN_LEFT) ? -1 : 1);
+					Play("category");
+				}
+				return;
+			}
+			if (m_panel.options.empty())
+			{
+				if (pressed & BTN_CROSS)
+				{
+					m_panel.open = false;
+					Play("back");
+				}
+				return;
+			}
+			const int count = (int)m_panel.options.size();
+			if ((pressed & BTN_UP) && m_panel.selected > 0)
+			{
+				m_panel.selected--;
+				Play("move");
+			}
+			if ((pressed & BTN_DOWN) && m_panel.selected < count - 1)
+			{
+				m_panel.selected++;
+				Play("move");
+			}
+			if (pressed & BTN_CROSS)
+			{
+				if (m_panel.setting == SET_UPDATE)
+				{
+					ChooseUpdateOption();
+					return;
+				}
+				if (m_panel.setting >= 0)
+				{
+					const int setting = m_panel.setting;
+					const bool firstLanguage = m_firstLanguage;
+					ApplySettingOption(setting, m_panel.selected);
+					if (setting == SET_LANGUAGE && firstLanguage && m_firstStyle)
+					{
+						Play("confirm");
+						return; // the menu style list is open now
+					}
+				}
+				else if (m_panel.title == "Delete")
+				{
+					const Item& item = m_items[m_category][m_selected[m_category]];
+					const std::string choice = m_panel.options[m_panel.selected];
+					if (choice == "Cancel" || item.game < 0)
+					{
+						m_panel.open = false;
+						Play("back");
+						return;
+					}
+					const Game game = m_games[item.game];
+					const std::vector<std::string> result = DeleteGame(game, choice != "Delete Game");
+					m_panel.title = "Delete";
+					m_panel.options.clear();
+					m_panel.lines = result;
+					Play("confirm");
+					return;
+				}
+				else if (m_panel.title == "Cheats")
+				{
+					const Item& item = m_items[m_category][m_selected[m_category]];
+					const std::string choice = m_panel.options[m_panel.selected];
+					if (item.game < 0 || choice == "Done")
+					{
+						m_panel.open = false;
+						Play("back");
+						return;
+					}
+					const Game& game = m_games[item.game];
+					if (choice == "Add a Cheat")
+					{
+						m_cheatsRemove = false;
+						OpenKeyboard("Cheat Name", "", "cheat_name");
+						return;
+					}
+					if (choice == "Remove a Cheat" || choice == "Cancel Remove")
+						m_cheatsRemove = !m_cheatsRemove;
+					else if (m_panel.selected < (int)m_cheats.size())
+					{
+						if (m_cheatsRemove)
+						{
+							Log("cheats: removed " + m_cheats[m_panel.selected].name);
+							m_cheats.erase(m_cheats.begin() + m_panel.selected);
+							m_cheatsRemove = false;
+						}
+						else
+							m_cheats[m_panel.selected].on = !m_cheats[m_panel.selected].on;
+						CremaCheats::Save(m_dataDir, game.id, m_cheats);
+					}
+					const int selected = m_panel.selected;
+					ShowCheats(game);
+					m_panel.selected = std::min(selected, (int)m_panel.options.size() - 1);
+					Play("confirm");
+					return;
+				}
+				else if (m_panel.title == "Update & DLC")
+				{
+					const Item& item = m_items[m_category][m_selected[m_category]];
+					if (item.game < 0 || m_panel.options[m_panel.selected] == "Done")
+					{
+						m_panel.open = false;
+						Play("back");
+						return;
+					}
+					const Game& game = m_games[item.game];
+					if (m_panel.selected == 2)
+					{
+						// the next copy of the game; the list is built again with it
+						const auto at = std::find(game.copies.begin(), game.copies.end(), game.path) - game.copies.begin();
+						const std::string next = game.copies[(at + 1) % game.copies.size()];
+						const std::string id = game.id;
+						m_sources[id + ".game"] = next;
+						SaveSources();
+						Log(fmt::format("{} game: {}", id, next));
+						RefreshGames();
+						for (const Item& listed : m_items[(int)Category::Games])
+							if (listed.game >= 0 && m_games[listed.game].id == id)
+							{
+								ShowUpdateDlc(m_games[listed.game]);
+								m_panel.open = true;
+								m_panel.title = "Update & DLC";
+								m_panel.selected = 2;
+								break;
+							}
+						Play("confirm");
+						return;
+					}
+					const char* what = m_panel.selected == 0 ? "update" : "dlc";
+					const auto& list = m_panel.selected == 0 ? game.updates : game.dlcs;
+					if (!list.empty())
+					{
+						// Auto, then each one found, then Off
+						std::vector<std::string> choices = {"auto"};
+						for (const Game::Source& source : list)
+							choices.push_back(source.path);
+						choices.push_back("off");
+						const std::string current = SourceChoice(game, what);
+						size_t at = std::find(choices.begin(), choices.end(), current) - choices.begin();
+						const std::string next = choices[(at + 1) % choices.size()];
+						m_sources[game.id + "." + what] = next;
+						SaveSources();
+						WriteTitleExtras();
+						Log(fmt::format("{} {}: {}", game.id, what, next));
+					}
+					const int selected = m_panel.selected;
+					ShowUpdateDlc(game);
+					m_panel.selected = selected;
+					Play("confirm");
+					return;
+				}
+				else if (m_panel.title == "Game")
+				{
+					const Item& item = m_items[m_category][m_selected[m_category]];
+					const Game& game = m_games[item.game];
+					const std::string& choice = m_panel.options[m_panel.selected];
+					if (choice == "Cheats")
+					{
+						m_cheatsGame.clear(); // read the file again (it may have changed by FTP)
+						ShowCheats(game);
+						m_panel.selected = 0;
+						Play("confirm");
+						return;
+					}
+					if (choice == "Update & DLC")
+					{
+						ShowUpdateDlc(game);
+						m_panel.selected = 0;
+						Play("confirm");
+						return;
+					}
+					if (choice == "Start")
+					{
+						m_panel.open = false;
+						ActivateItem(item);
+						return;
+					}
+					if (choice == "Delete")
+					{
+						const std::string target = DeleteTarget(game);
+						m_panel.title = "Delete";
+						m_panel.selected = 0;
+						m_panel.lines = {game.title, ""};
+						if (target.empty())
+						{
+							m_panel.options.clear();
+							m_panel.lines.push_back("Its files are straight in the games folder:");
+							m_panel.lines.push_back("remove them over FTP.");
+						}
+						else
+						{
+							m_panel.lines.push_back(fs::is_directory(target) ? "Deletes its folder:" : "Deletes its file:");
+							m_panel.lines.push_back(fs::path(target).filename().string());
+							m_panel.lines.push_back("");
+							m_panel.lines.push_back("Saves are kept.");
+							m_panel.options = {"Cancel", "Delete Game"};
+							if (!game.homebrew)
+								m_panel.options.push_back("Delete Game, Update and DLC");
+						}
+						Play("confirm");
+						return;
+					}
+					if (choice == "Game Settings")
+					{
+						OpenSettingsList({}, game.id);
+						Play("confirm");
+						return;
+					}
+					if (choice == "Graphic Packs")
+					{
+						OpenGamePacks(game.id, game.title);
+						Play("confirm");
+						return;
+					}
+					if (choice == "Information")
+					{
+						m_panel.title = "Information";
+						m_panel.options.clear();
+						m_panel.lines = {game.title, "", game.homebrew ? "Homebrew" : "Title ID: " + game.id};
+						if (!game.homebrew)
+						{
+							m_panel.lines.push_back("Version: v" + std::to_string(game.version));
+							if (!game.region.empty())
+								m_panel.lines.push_back("Region: " + game.region);
+							if (!game.product.empty())
+								m_panel.lines.push_back("Product code: " + game.product);
+						}
+						m_panel.lines.push_back("Format: " + game.format);
+						m_panel.lines.push_back("File: " + fs::path(game.path).filename().string());
+						if (!game.homebrew && game.id.size() == 16)
+						{
+							// update and DLC in Cemu's place for them (mlc01/usr/title/0005000e|c/<low ID>)
+							std::error_code ec;
+							const std::string titles = m_dataDir + "/mlc01/usr/title/";
+							const std::string low = game.id.substr(8);
+							const bool updateInMlc = fs::exists(titles + "0005000e/" + low, ec), dlcInMlc = fs::exists(titles + "0005000c/" + low, ec);
+							m_panel.lines.push_back("Update: " + (game.updates.empty() ? std::string(updateInMlc ? "installed (mlc01)" : "not found") :
+								SourceLabel(game, "update") + (updateInMlc ? " (+ mlc01)" : "")));
+							m_panel.lines.push_back("DLC: " + (game.dlcs.empty() ? std::string(dlcInMlc ? "installed (mlc01)" : "not found") :
+								SourceLabel(game, "dlc") + (dlcInMlc ? " (+ mlc01)" : "")));
+							// game-settings.ini: tested on the PS4
+							CremaSettings::Recommendation tested;
+							if (CremaSettings::GetRecommendation(game.id, &tested))
+							{
+								m_panel.lines.push_back("");
+								m_panel.lines.push_back("Tested: " + (tested.status.empty() ? std::string("yes") : tested.status) +
+									(tested.fps.empty() ? std::string() : ", " + tested.fps + " FPS"));
+								if (!tested.note.empty())
+									m_panel.lines.push_back(tested.note);
+								std::string values;
+								for (const auto& [key, value] : tested.values)
+								{
+									if (const CremaSettings::Setting* setting = CremaSettings::Find(key))
+										values += (values.empty() ? "" : ", ") + std::string(setting->label) + " " + CremaSettings::LabelOf(*setting, value);
+								}
+								if (!values.empty())
+									m_panel.lines.push_back(std::string(CremaSettings::IsCustom(game.id) ? "Recommended (not used: own settings): " :
+										CremaSettings::Get("recommended") == "off" ? "Recommended (off): " : "Recommended: ") + values);
+							}
+						}
+						Play("confirm");
+						return;
+					}
+					// Set / Remove as Default Game: one default game; the same game again removes it.
+					const bool remove = m_prefs.defaultGame == game.path;
+					m_prefs.defaultGame = remove ? "" : game.path;
+					m_prefs.Save(m_dataDir + "/launcher.ini");
+					Log(remove ? "default game removed" : "default game: " + game.path);
+					BuildItems();
+					m_panel.title = remove ? "Remove Default Game" : "Set as Default Game";
+					m_panel.options.clear();
+					if (remove)
+						m_panel.lines = {"", "No game starts by itself anymore."};
+					else
+						m_panel.lines = {"", game.title, "", "starts when Crema opens.", "", "Hold L1 while Crema starts",
+							"to open the menu instead."};
+					Play("confirm");
+					return;
+				}
+				m_panel.open = false;
+				Play("confirm");
+			}
+			return;
+		}
+
+		auto& items = m_items[m_category];
+		int& selected = m_selected[m_category];
+		const int count = (int)items.size();
+		const bool games = m_category == (int)Category::Games;
+		// XMB: Left / Right switch the columns, Up / Down the items, L1 / R1 jump five.
+		// Library: L1 / R1 switch the tabs; the games scroll sideways, the other tabs up and down.
+		int prevCategory = m_category > 0 ? m_category - 1 : -1;
+		int nextCategory = m_category < CATEGORY_COUNT - 1 ? m_category + 1 : -1;
+		uint32_t prevTab = BTN_LEFT, nextTab = BTN_RIGHT, prevItem = BTN_UP, nextItem = BTN_DOWN;
+		uint32_t prevPage = BTN_L1, nextPage = BTN_R1;
+		if (Library())
+		{
+			const int tab = LibraryTab();
+			prevCategory = tab > 0 ? (int)TABS[tab - 1] : -1;
+			nextCategory = tab < TAB_COUNT - 1 ? (int)TABS[tab + 1] : -1;
+			prevTab = BTN_L1;
+			nextTab = BTN_R1;
+			prevItem = games ? BTN_LEFT : BTN_UP;
+			nextItem = games ? BTN_RIGHT : BTN_DOWN;
+			prevPage = nextPage = 0;
+		}
+		if ((pressed & prevTab) && prevCategory >= 0)
+		{
+			m_category = prevCategory;
+			Play("category");
+		}
+		else if ((pressed & nextTab) && nextCategory >= 0)
+		{
+			m_category = nextCategory;
+			Play("category");
+		}
+		else if ((pressed & prevItem) && selected > 0)
+		{
+			selected--;
+			Play("move");
+		}
+		else if ((pressed & nextItem) && selected < count - 1)
+		{
+			selected++;
+			Play("move");
+		}
+		else if ((pressed & prevPage) && selected > 0)
+		{
+			selected = std::max(0, selected - 5);
+			Play("move");
+		}
+		else if ((pressed & nextPage) && selected < count - 1)
+		{
+			selected = std::min(count - 1, selected + 5);
+			Play("move");
+		}
+		else if (pressed & BTN_CROSS)
+		{
+			if (!items.empty())
+				ActivateItem(items[selected]);
+		}
+		else if ((pressed & BTN_SQUARE) && games)
+		{
+			RefreshGames();
+			Play("confirm");
+		}
+		else if ((pressed & BTN_OPTIONS) && games && Library())
+		{
+			// The next game order; the selected game stays selected.
+			size_t sort = 0;
+			while (sort < std::size(SORT_NAMES) && m_prefs.sort != SORT_NAMES[sort][0])
+				sort++;
+			m_prefs.sort = SORT_NAMES[(sort + 1) % std::size(SORT_NAMES)][0];
+			m_prefs.Save(m_dataDir + "/launcher.ini");
+			const int game = items.empty() ? -1 : items[selected].game;
+			BuildItems();
+			const auto& sorted = m_items[m_category];
+			for (size_t i = 0; i < sorted.size(); i++)
+			{
+				if (game >= 0 && sorted[i].game == game)
+					m_selected[m_category] = (int)i;
+			}
+			m_itemPos[m_category] = (float)m_selected[m_category];
+			m_sortShown = 2.5f;
+			Play("category");
+		}
+		else if (pressed & BTN_TRIANGLE)
+		{
+			if (!items.empty() && items[selected].game >= 0)
+			{
+				const Game& game = m_games[items[selected].game];
+				m_panel = {};
+				m_panel.open = true;
+				m_panel.title = "Game";
+				m_panel.options = {"Start"};
+				if (!game.homebrew)
+					m_panel.options.push_back("Game Settings");
+				if (!game.homebrew)
+					m_panel.options.push_back("Graphic Packs");
+				if (!game.homebrew)
+					m_panel.options.push_back("Update & DLC");
+				if (!game.homebrew)
+					m_panel.options.push_back("Cheats");
+				m_panel.options.push_back("Information");
+				m_panel.options.push_back(m_prefs.defaultGame == game.path ? "Remove Default Game" : "Set as Default Game");
+				m_panel.options.push_back("Delete");
+				Play("menu");
+			}
+		}
+		else if (pressed & BTN_CIRCLE)
+		{
+			Play("back");
+		}
+	}
+
+	// Cross on an item (both styles).
+	void Menu::ActivateItem(const Item& item)
+	{
+		if (item.game >= 0)
+		{
+			m_launch = item.game;
+			m_launchTime = 0.0f;
+			m_prefs.lastGame = m_games[item.game].path;
+			m_prefs.Save(m_dataDir + "/launcher.ini");
+			m_played[m_games[item.game].path] = (int64_t)std::time(nullptr);
+			SavePlayed();
+			Play("launch");
+		}
+		else if (item.setting >= 0)
+		{
+			OpenSettingPanel(item.setting);
+			Play("menu");
+		}
+		else if (item.theme != -1)
+		{
+			if (item.theme >= 0)
+			{
+				m_prefs.theme = THEMES[item.theme].name;
+				m_prefs.wallpaper.clear();
+			}
+			else
+			{
+				m_prefs.wallpaper = m_wallpapers[-2 - item.theme];
+			}
+			ApplyPreferences();
+			BuildItems();
+			Play("confirm");
+		}
+		else
+		{
+			Play("error");
+		}
+	}
+
+	int Menu::LibraryTab() const
+	{
+		for (int i = 0; i < TAB_COUNT; i++)
+		{
+			if ((int)TABS[i] == m_category)
+				return i;
+		}
+		return 0;
+	}
+
+	std::string Menu::SortName() const
+	{
+		for (const auto& [key, name] : SORT_NAMES)
+		{
+			if (m_prefs.sort == key)
+				return name;
+		}
+		return SORT_NAMES[0][1];
+	}
+
+	// data_dir/played.ini: "<Unix time> <game path>" per line.
+	void Menu::LoadPlayed()
+	{
+		std::ifstream file(m_dataDir + "/played.ini");
+		std::string line;
+		while (std::getline(file, line))
+		{
+			while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+				line.pop_back();
+			const size_t space = line.find(' ');
+			if (space != std::string::npos && space > 0)
+				m_played[line.substr(space + 1)] = std::atoll(line.c_str());
+		}
+	}
+
+	void Menu::SavePlayed() const
+	{
+		std::ofstream file(m_dataDir + "/played.ini", std::ios::trunc);
+		for (const auto& [path, when] : m_played)
+			file << when << ' ' << path << '\n';
+	}
