+	// The games folder's games, then the network library's (Settings > Online)
+	std::vector<LibraryEntry> Menu::ScanAllGames()
+	{
+		std::vector<LibraryEntry> library = ScanLibrary(GamesFolder());
+		const std::string network = CremaSettings::NetworkLibraryFolder();
+		if (!network.empty())
+		{
+			std::vector<LibraryEntry> shared = ScanLibrary(network);
+			Log("network library: " + std::to_string(shared.size()) + " games");
+			for (LibraryEntry& entry : shared)
+				library.push_back(std::move(entry));
+		}
+		return library;
+	}
