+extern "C" void ps4_filestream_report(const char* why)
+{
+	std::map<std::string, int> perFolder;
+	size_t total = 0;
+	{
+		std::lock_guard lock(s_openStreamsLock);
+		total = s_openStreams.size();
+		for (auto& [stream, entry] : s_openStreams)
+		{
+			const std::string& path = entry.first;
+			const size_t slash = path.find_last_of('/');
+			perFolder[slash == std::string::npos ? path : path.substr(0, slash)]++;
+		}
+	}
+	std::vector<std::pair<int, std::string>> sorted;
+	for (auto& [folder, count] : perFolder)
+		sorted.emplace_back(count, folder);
+	std::sort(sorted.rbegin(), sorted.rend());
