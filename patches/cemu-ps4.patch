+	// The menus switch at once (every font is loaded already); games use it from their next start.
+	void Menu::SetLanguage(const std::string& code)
+	{
+		CremaSettings::Set("language", code);
+		PS4Lang::Load(m_assetsDir, code);
+		Log("language: " + code);
+		BuildItems();
