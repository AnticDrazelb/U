+	// ---------------------------------------------------------------------------------------------
+	// Preferences (data_dir/launcher.ini, "key=value" lines).
+
+	struct Preferences
+	{
+		std::string theme = THEMES[0].name;
+		std::string wallpaper; // file name in data_dir/themes, empty = the theme's waves
+		bool sounds = true;
+		int volume = 80;
+		bool clock = true;
+		std::string gamesDir; // Settings -> Game Folder; empty = data_dir/games
+		std::string lastGame;
+		std::string style;           // "library" (covers) or "xmb"; empty: not chosen yet (asked)
+		std::string sort = "title";  // "title", "recent" (last played first)
+		std::string defaultGame;     // starts by itself when the app opens
+		bool autoUpdate = true;      // look for a new version on GitHub when the launcher opens
+
+		void Load(const std::string& path)
+		{
+			std::ifstream file(path);
+			std::string line;
+			while (std::getline(file, line))
+			{
+				while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+					line.pop_back();
+				const size_t eq = line.find('=');
+				if (eq == std::string::npos)
+					continue;
+				const std::string key = line.substr(0, eq), value = line.substr(eq + 1);
+				if (key == "theme")
+					theme = value;
+				else if (key == "wallpaper")
+					wallpaper = value;
+				else if (key == "sounds")
+					sounds = value == "on";
+				else if (key == "volume")
+					volume = std::clamp(std::atoi(value.c_str()), 0, 100);
+				else if (key == "clock")
+					clock = value == "on";
+				else if (key == "games_dir")
+					gamesDir = value;
+				else if (key == "last_game")
+					lastGame = value;
+				else if (key == "style")
+					style = value == "xmb" ? "xmb" : value == "library" ? "library" : "";
+				else if (key == "sort")
+					sort = value;
+				else if (key == "default_game")
+					defaultGame = value;
+				else if (key == "auto_update")
+					autoUpdate = value != "off";
+			}
+		}
+		void Save(const std::string& path) const
+		{
+			std::ofstream file(path, std::ios::trunc);
+			file << "# Crema launcher preferences (edited by the menu)\n";
+			file << "theme=" << theme << "\nwallpaper=" << wallpaper << "\nsounds=" << (sounds ? "on" : "off")
+				 << "\nvolume=" << volume << "\nclock=" << (clock ? "on" : "off") << "\ngames_dir=" << gamesDir
+				 << "\nlast_game=" << lastGame << "\nstyle=" << style << "\nsort=" << sort
+				 << "\ndefault_game=" << defaultGame << "\nauto_update=" << (autoUpdate ? "on" : "off") << "\n";
+		}
+	};
+
+	// ---------------------------------------------------------------------------------------------
+	// The game library: every launchable title under the games folder, parsed by Cemu's TitleInfo.
+
+	struct LibraryEntry
+	{
+		std::string path;     // what launch.txt gets (title.tmd, an .rpx, a .wua, ...)
+		std::string titleId;  // 16 hex digits, empty for homebrew
+		std::string title;
+		std::string product;  // GameTDB-style ID from meta.xml (product code + company), e.g. ARDE01
+		std::string region;
+		uint16 version = 0;
+		std::string format;   // "NUS", "Folder", "WUA", "WUD", "WUHB", "Homebrew"
+		std::vector<uint8> icon; // RGBA
+		uint32_t iconWidth = 0, iconHeight = 0;
+		uint64 appId = 0;     // the title ID: 00050000 a game, 0005000E its update, 0005000C its DLC
+		int kind = 0;         // 0 a game (or homebrew), 1 an update, 2 DLC
+	};
+
+	std::string Lower(std::string text)
+	{
+		std::transform(text.begin(), text.end(), text.begin(), ::tolower);
+		return text;
+	}
+
+	std::string RegionName(CafeConsoleRegion region)
+	{
+		const uint32 r = (uint32)region;
+		if (r == 1)
+			return "Japan";
+		if (r == 2)
+			return "USA";
+		if (r == 4)
+			return "Europe";
+		if (r & 7)
+			return "Region free";
+		return "";
+	}
+
+	void LoadIcon(TitleInfo& info, LibraryEntry& entry)
+	{
+		const std::string mount = TitleInfo::GetUniqueTempMountingPath();
+		if (!info.Mount(mount, "", FSC_PRIORITY_BASE))
+			return;
+		auto tga = fsc_extractFile((mount + "/meta/iconTex.tga").c_str());
+		if (tga && !DecodeTga(*tga, entry.icon, entry.iconWidth, entry.iconHeight))
+			entry.icon.clear();
+		info.Unmount(mount);
+	}
+
+	std::vector<LibraryEntry> ScanLibrary(const std::string& gamesDir)
+	{
+		std::vector<LibraryEntry> library;
+		std::vector<fs::path> candidates;
+		std::error_code ec;
+		const bool network = gamesDir.rfind("/net/", 0) == 0;
+		for (auto it = fs::recursive_directory_iterator(gamesDir, ec); !ec && it != fs::recursive_directory_iterator(); it.increment(ec))
+		{
+			if (network && it->is_directory(ec))
+			{
+				// over the network every folder costs a round trip: a game's content and meta
+				// folders hold thousands of files and nothing to find
+				const std::string folder = Lower(it->path().filename().string());
+				if (folder == "content" || folder == "meta")
+					it.disable_recursion_pending();
+				continue;
+			}
+			if (!it->is_regular_file(ec))
+				continue;
+			const fs::path path = it->path();
+			const std::string name = Lower(path.filename().string()), ext = Lower(path.extension().string());
+			// an unpacked title: its code/<name>.rpx (one per title folder)
+			if (ext == ".rpx" && Lower(path.parent_path().filename().string()) == "code")
+				candidates.push_back(path);
+			else if (ext == ".rpx" || ext == ".elf" || ext == ".wua" || ext == ".wuhb" || ext == ".wud" || ext == ".wux" ||
+					 name == "title.tmd")
+				candidates.push_back(path);
+		}
+		std::sort(candidates.begin(), candidates.end());
+		for (const fs::path& path : candidates)
+		{
+			LibraryEntry entry;
+			entry.path = _pathToUtf8(path);
+			const std::string ext = Lower(path.extension().string());
+			const bool unpacked = ext == ".rpx" && Lower(path.parent_path().filename().string()) == "code";
+			// an unpacked title is parsed from its folder (code, content and meta in it)
+			TitleInfo info(unpacked ? path.parent_path().parent_path() : path);
+			if (info.IsValid() && info.ParseXmlInfo() && info.HasValidXmlInfo())
+			{
+				if (info.IsSystemDataTitle())
+					continue;
+				entry.titleId = fmt::format("{:016x}", info.GetAppTitleId());
+				entry.appId = info.GetAppTitleId();
+				// updates and DLC go with their game (BuildGames), not in the list
+				const auto type = TitleIdParser(entry.appId).GetType();
+				entry.kind = type == TitleIdParser::TITLE_TYPE::BASE_TITLE_UPDATE ? 1 : type == TitleIdParser::TITLE_TYPE::AOC ? 2 : 0;
+				entry.title = info.GetMetaTitleName();
+				entry.version = info.GetAppTitleVersion();
+				entry.region = RegionName(info.GetMetaRegion());
+				if (ParsedMetaXml* meta = info.GetMetaInfo())
+				{
+					std::string product = meta->GetProductCode(); // "WUP-P-ARDE"
+					if (product.size() >= 4)
+						product = product.substr(product.size() - 4);
+					std::string company = meta->GetCompanyCode(); // "0001"
+					if (company.size() >= 2)
+						company = company.substr(company.size() - 2);
+					entry.product = product + company;
+				}
+				const auto format = info.GetFormat();
+				entry.format = format == TitleInfo::TitleDataFormat::HOST_FS ? "Folder" :
+					format == TitleInfo::TitleDataFormat::WIIU_ARCHIVE ? "WUA" :
+					format == TitleInfo::TitleDataFormat::WUD ? "WUD" :
+					format == TitleInfo::TitleDataFormat::WUHB ? "WUHB" : "NUS";
+				if (entry.kind == 0)
+					LoadIcon(info, entry); // (an update's or DLC's icon isn't shown: not read, over the network either)
+			}
+			else
+			{
+				entry.format = "Homebrew";
+			}
+			// newlines in meta.xml titles ("Game\nSubtitle")
+			std::replace(entry.title.begin(), entry.title.end(), '\n', ' ');
+			if (entry.title.empty())
+				entry.title = path.stem().string();
+			library.push_back(std::move(entry));
+		}
+		return library;
+	}
