+// Crema's performance log: where the GPU thread (LatteThread) waited since the last call, in % of
+// the time: for commands from the game (idle), on a game's fence (WAIT_REG_MEM) or semaphore, for
+// the PS4 GPU (GX2DrawDone's full sync, readbacks) and compiling shaders.
+std::string LattePerformanceMonitor_cremaWaits()
+{
+	static uint64 s_last[6]{}, s_lastTsc = 0;
+	const uint64 now = PPCTimer_getRawTsc();
+	const uint64 totals[6] = {performanceMonitor.gpuTime_idleTime.getTotal(), performanceMonitor.gpuTime_fenceTime.getTotal(),
+		performanceMonitor.gpuTime_semaphoreTime.getTotal(), performanceMonitor.gpuTime_waitForAsync.getTotal(),
+		performanceMonitor.gpuTime_shaderCreate.getTotal(), performanceMonitor.gpuTime_frameTime.getTotal()};
+	const uint64 span = s_lastTsc ? now - s_lastTsc : 0;
+	uint64 pct[6]{};
+	for (int i = 0; i < 6; i++)
+	{
+		pct[i] = span ? (totals[i] - s_last[i]) * 100 / span : 0;
+		s_last[i] = totals[i];
+	}
+	s_lastTsc = now;
+	return fmt::format("latte waits: idle {}%, game fence {}%, semaphore {}%, gpu sync {}%, shaders {}%", pct[0], pct[1], pct[2],
+		pct[3], pct[4]);
+}
+#endif
