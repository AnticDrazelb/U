+// The open regular files that aren't FileStreams, named by matching their inode against the files
+// under /data/Crema and /app0: v01.73 showed only ~95 of the ~250 open files were FileStreams, the
+// rest grew during play, and the PS4 refuses new files at ~250 distinct opens (a dup()ed descriptor
+// costs nothing: 4096 dups worked). The kernel's file list (kern.proc.filedesc) has no paths here.
+namespace
+{
+	using FileKey = std::pair<uint64_t, uint64_t>; // device, inode
+
+	// one descriptor per folder level while it runs
+	void FindFiles(const std::string& folder, std::map<FileKey, std::string>& wanted, size_t& left, int depth)
+	{
+		if (left == 0 || depth > 12)
+			return;
+		DIR* dir = opendir(folder.c_str());
+		if (!dir)
+			return;
+		std::vector<std::string> subfolders;
+		while (dirent* entry = readdir(dir))
+		{
+			if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
+				continue;
+			std::string path = folder == "/" ? "/" + std::string(entry->d_name) : folder + "/" + entry->d_name;
+			struct stat info;
+			if (lstat(path.c_str(), &info) != 0)
+				continue;
+			if (S_ISDIR(info.st_mode))
+				subfolders.push_back(std::move(path));
+			else if (S_ISREG(info.st_mode))
+			{
+				auto it = wanted.find({(uint64_t)info.st_dev, (uint64_t)info.st_ino});
+				if (it != wanted.end() && it->second.empty())
+				{
+					it->second = std::move(path);
+					left--;
+				}
+			}
+		}
+		closedir(dir);
+		for (auto& subfolder : subfolders)
+			FindFiles(subfolder, wanted, left, depth + 1);
+	}
+}
