diff --git a/src/util/Fiber/FiberPS4.cpp b/src/util/Fiber/FiberPS4.cpp
new file mode 100644
index 0000000..3784081
--- /dev/null
+++ b/src/util/Fiber/FiberPS4.cpp
@@ -0,0 +1,113 @@
+// PS4: fibers by stack switching. The OpenOrbis C library (musl) has no ucontext functions, so
+// the switch saves the callee-saved registers (System V x86-64) plus MXCSR and the x87 control
+// word on the current stack and swaps stack pointers.
+#include "Fiber.h"
+#include <atomic>
+
+thread_local Fiber* sCurrentFiber{};
+
+extern "C" void cemu_ps4_fiber_switch(void** saveSp, void* loadSp);
+extern "C" void cemu_ps4_fiber_start();
+
+asm(R"(
+	.text
+	.globl cemu_ps4_fiber_switch
+	.type cemu_ps4_fiber_switch, @function
+cemu_ps4_fiber_switch:
+	pushq %rbp
+	pushq %rbx
+	pushq %r12
+	pushq %r13
+	pushq %r14
+	pushq %r15
+	subq $8, %rsp
+	stmxcsr (%rsp)
+	fnstcw 4(%rsp)
+	movq %rsp, (%rdi)
+	movq %rsi, %rsp
+	ldmxcsr (%rsp)
+	fldcw 4(%rsp)
+	addq $8, %rsp
+	popq %r15
+	popq %r14
+	popq %r13
+	popq %r12
+	popq %rbx
+	popq %rbp
+	ret
+	.size cemu_ps4_fiber_switch, .-cemu_ps4_fiber_switch
+
+	.globl cemu_ps4_fiber_start
+	.type cemu_ps4_fiber_start, @function
+cemu_ps4_fiber_start:
+	movq %r12, %rdi
+	callq *%r13
+	ud2
+	.size cemu_ps4_fiber_start, .-cemu_ps4_fiber_start
+)");
+
+namespace
+{
+	struct FiberContext
+	{
+		void* sp;
+	};
+}
+
+Fiber::Fiber(void(*FiberEntryPoint)(void* userParam), void* userParam, void* privateData) : m_privateData(privateData)
+{
+	const size_t stackSize = 2 * 1024 * 1024;
+	m_stackPtr = malloc(stackSize);
+	uint64* top = (uint64*)(((uintptr_t)m_stackPtr + stackSize) & ~(uintptr_t)15);
+	// Frame popped by the first switch into this fiber; "ret" lands in cemu_ps4_fiber_start with
+	// a 16-byte aligned stack, which calls FiberEntryPoint(userParam) (r13, r12).
+	uint32 mxcsr;
+	uint16 fpuControl;
+	asm volatile("stmxcsr %0" : "=m"(mxcsr));
+	asm volatile("fnstcw %0" : "=m"(fpuControl));
+	top[-1] = (uint64)&cemu_ps4_fiber_start; // return address
+	top[-2] = 0; // rbp
+	top[-3] = 0; // rbx
+	top[-4] = (uint64)userParam; // r12
+	top[-5] = (uint64)FiberEntryPoint; // r13
+	top[-6] = 0; // r14
+	top[-7] = 0; // r15
+	top[-8] = (uint64)mxcsr | ((uint64)fpuControl << 32);
+	FiberContext* ctx = new FiberContext();
+	ctx->sp = &top[-8];
+	m_implData = ctx;
+}
+
+Fiber::Fiber(void* privateData) : m_privateData(privateData)
+{
+	m_implData = new FiberContext();
+	m_stackPtr = nullptr;
+}
+
+Fiber::~Fiber()
+{
+	if (m_stackPtr)
+		free(m_stackPtr);
+	delete (FiberContext*)m_implData;
+}
+
+Fiber* Fiber::PrepareCurrentThread(void* privateData)
+{
+	cemu_assert_debug(sCurrentFiber == nullptr);
+	sCurrentFiber = new Fiber(privateData);
+	return sCurrentFiber;
+}
+
+void Fiber::Switch(Fiber& targetFiber)
+{
+	Fiber* leavingFiber = sCurrentFiber;
+	sCurrentFiber = &targetFiber;
+	std::atomic_thread_fence(std::memory_order_seq_cst);
+	cemu_ps4_fiber_switch(&((FiberContext*)leavingFiber->m_implData)->sp, ((FiberContext*)targetFiber.m_implData)->sp);
+	std::atomic_thread_fence(std::memory_order_seq_cst);
+}
+
+void* Fiber::GetFiberPrivateData()
+{
+	return sCurrentFiber->m_privateData;
+}
diff --git a/src/util/MemMapper/MemMapperPS4.cpp b/src/util/MemMapper/MemMapperPS4.cpp
new file mode 100644
index 0000000..ff346d0
--- /dev/null
+++ b/src/util/MemMapper/MemMapperPS4.cpp
@@ -0,0 +1,210 @@
+// PS4 memory mapping. Large PROT_NONE mmaps fail on the PS4 (4 GiB+ is ENOMEM) and regular
+// flexible memory is only ~255 MiB, so:
+//  - reservations come from sceKernelReserveVirtualRange (placed away from 0x200000000, where
+//    libkernel keeps its own objects),
+//  - committing inside a reservation maps direct memory (16 KiB pages, 4.5 GiB with the plain
+//    homebrew identity) at the fixed address, zero-filled like an anonymous mapping,
+//  - other allocations (the recompiler's RWX code blocks) are plain mmaps, which the runtime's
+//    __wrap_mmap serves from system flexible memory (RWX allowed there).
+#include "util/MemMapper/MemMapper.h"
+
+#include <sys/mman.h>
+#include <sys/types.h>
+
+extern "C"
+{
+	int32_t sceKernelReserveVirtualRange(void** addr, size_t len, int32_t flags, size_t alignment);
+	int32_t sceKernelMunmap(void* addr, size_t len);
+	int32_t sceKernelMprotect(const void* addr, size_t len, int32_t prot);
+	size_t sceKernelGetDirectMemorySize(void);
+	int32_t sceKernelAllocateDirectMemory(off_t start, off_t end, size_t len, size_t align, int32_t type, off_t* physOut);
+	int32_t sceKernelReleaseDirectMemory(off_t start, size_t len);
+	int32_t sceKernelMapDirectMemory(void** addr, size_t len, int32_t prot, int32_t flags, off_t phys, size_t align);
+}
+
+namespace MemMapper
+{
+	constexpr size_t kPage = 16 * 1024; // direct memory maps in 16 KiB pages only
+	constexpr int32_t kMapFixed = 0x10;
+	constexpr int32_t kMemoryTypeWbOnion = 0;
+	constexpr int32_t kProtCpuRead = 0x1, kProtCpuWrite = 0x2, kProtCpuExec = 0x4;
+	constexpr off_t kNotCommitted = -1;
+
+	struct Reservation
+	{
+		uintptr_t base;
+		size_t size;
+		std::vector<off_t> phys; // physical address of each committed 16 KiB page, kNotCommitted otherwise
+	};
+	std::mutex sMutex;
+	std::vector<Reservation> sReservations;
+	uintptr_t sNextHint = 0x4000000000ull; // the app heap lives at 0x1000000000+, vss at 0x2000000000
+
+	size_t GetPageSize()
+	{
+		return kPage;
+	}
+
+	static int32_t ToSceProt(PAGE_PERMISSION permissionFlags)
+	{
+		int32_t prot = 0;
+		if (HAS_FLAG(permissionFlags, PAGE_PERMISSION::P_READ))
+			prot |= kProtCpuRead;
+		if (HAS_FLAG(permissionFlags, PAGE_PERMISSION::P_WRITE))
+			prot |= kProtCpuRead | kProtCpuWrite;
+		if (HAS_FLAG(permissionFlags, PAGE_PERMISSION::P_EXECUTE))
+			prot |= kProtCpuRead | kProtCpuExec;
+		return prot;
+	}
+
+	static int ToPosixProt(PAGE_PERMISSION permissionFlags)
+	{
+		int prot = 0;
+		if (HAS_FLAG(permissionFlags, PAGE_PERMISSION::P_READ))
+			prot |= PROT_READ;
+		if (HAS_FLAG(permissionFlags, PAGE_PERMISSION::P_WRITE))
+			prot |= PROT_READ | PROT_WRITE;
+		if (HAS_FLAG(permissionFlags, PAGE_PERMISSION::P_EXECUTE))
+			prot |= PROT_READ | PROT_EXEC;
+		return prot;
+	}
+
+	static Reservation* FindReservation(uintptr_t addr)
+	{
+		for (auto& r : sReservations)
+			if (addr >= r.base && addr < r.base + r.size)
+				return &r;
+		return nullptr;
+	}
+
+	void* ReserveMemory(void* baseAddr, size_t size, PAGE_PERMISSION permissionFlags)
+	{
+		std::lock_guard _l(sMutex);
+		size = (size + kPage - 1) & ~(kPage - 1);
+		const size_t alignment = size >= 0x10000000 ? 0x10000000 : 0x200000;
+		void* addr = baseAddr;
+		int32_t r;
+		if (baseAddr)
+			r = sceKernelReserveVirtualRange(&addr, size, kMapFixed, kPage);
+		else
+		{
+			addr = (void*)((sNextHint + alignment - 1) & ~(alignment - 1));
+			r = sceKernelReserveVirtualRange(&addr, size, 0, alignment);
+			if (r == 0 && (uintptr_t)addr < 0x400000000ull)
+				cemuLog_log(LogType::Force, "MemMapper: reservation of {:#x} bytes landed low at {}", size, addr);
+		}
+		if (r != 0)
+		{
+			cemuLog_log(LogType::Force, "MemMapper: reserving {:#x} bytes at {} failed ({:#x})", size, baseAddr, (uint32)r);
+			return nullptr;
+		}
+		sNextHint = std::max(sNextHint, (uintptr_t)addr + size + 0x10000000);
+		sReservations.push_back({(uintptr_t)addr, size, std::vector<off_t>(size / kPage, kNotCommitted)});
+		return addr;
+	}
+
+	void FreeReservation(void* baseAddr, size_t size)
+	{
+		std::lock_guard _l(sMutex);
+		for (auto it = sReservations.begin(); it != sReservations.end(); ++it)
+		{
+			if (it->base != (uintptr_t)baseAddr)
+				continue;
+			sceKernelMunmap((void*)it->base, it->size);
+			for (off_t phys : it->phys)
+				if (phys != kNotCommitted)
+					sceKernelReleaseDirectMemory(phys, kPage);
+			sReservations.erase(it);
+			return;
+		}
+	}
+
+	// Commits pages [first, last) of a reservation that aren't committed yet, run by run.
+	static bool CommitPages(Reservation& res, size_t first, size_t last, int32_t prot)
+	{
+		size_t i = first;
+		while (i < last)
+		{
+			if (res.phys[i] != kNotCommitted)
+			{
+				sceKernelMprotect((void*)(res.base + i * kPage), kPage, prot);
+				i++;
+				continue;
+			}
+			size_t runEnd = i;
+			while (runEnd < last && res.phys[runEnd] == kNotCommitted)
+				runEnd++;
+			const size_t len = (runEnd - i) * kPage;
+			off_t phys = 0;
+			int32_t r = sceKernelAllocateDirectMemory(0, sceKernelGetDirectMemorySize(), len, kPage, kMemoryTypeWbOnion, &phys);
+			if (r != 0)
+			{
+				cemuLog_log(LogType::Force, "MemMapper: out of direct memory for {:#x} bytes ({:#x})", len, (uint32)r);
+				return false;
+			}
+			void* addr = (void*)(res.base + i * kPage);
+			r = sceKernelMapDirectMemory(&addr, len, prot | kProtCpuRead | kProtCpuWrite, kMapFixed, phys, kPage);
+			if (r != 0 || addr != (void*)(res.base + i * kPage))
+			{
+				cemuLog_log(LogType::Force, "MemMapper: mapping {:#x} bytes at {:#x} failed ({:#x})", len, res.base + i * kPage, (uint32)r);
+				sceKernelReleaseDirectMemory(phys, len);
+				return false;
+			}
+			memset(addr, 0, len); // direct memory isn't zeroed; committed memory must read as zero
+			if ((prot & kProtCpuWrite) == 0)
+				sceKernelMprotect(addr, len, prot);
+			for (size_t p = i; p < runEnd; p++)
+				res.phys[p] = phys + (off_t)((p - i) * kPage);
+			i = runEnd;
+		}
+		return true;
+	}
+
+	void* AllocateMemory(void* baseAddr, size_t size, PAGE_PERMISSION permissionFlags, bool fromReservation)
+	{
+		if (!fromReservation)
+		{
+			void* r = mmap(baseAddr, size, ToPosixProt(permissionFlags), MAP_PRIVATE | MAP_ANON, -1, 0);
+			return r == MAP_FAILED ? nullptr : r;
+		}
+		std::lock_guard _l(sMutex);
+		Reservation* res = FindReservation((uintptr_t)baseAddr);
+		if (!res || (uintptr_t)baseAddr + size > res->base + res->size)
+		{
+			cemuLog_log(LogType::Force, "MemMapper: commit of {:#x} bytes at {} outside any reservation", size, baseAddr);
+			return nullptr;
+		}
+		const size_t first = ((uintptr_t)baseAddr - res->base) / kPage;
+		const size_t last = ((uintptr_t)baseAddr + size - res->base + kPage - 1) / kPage;
+		if (!CommitPages(*res, first, last, ToSceProt(permissionFlags)))
+			return nullptr;
+		return baseAddr;
+	}
+
+	void FreeMemory(void* baseAddr, size_t size, bool fromReservation)
+	{
+		if (!fromReservation)
+		{
+			munmap(baseAddr, size);
+			return;
+		}
+		std::lock_guard _l(sMutex);
+		Reservation* res = FindReservation((uintptr_t)baseAddr);
+		if (!res)
+			return;
+		// only pages entirely inside the range: a partly covered page may still back other data
+		const size_t first = ((uintptr_t)baseAddr - res->base + kPage - 1) / kPage;
+		const size_t last = std::min(((uintptr_t)baseAddr + size - res->base) / kPage, res->phys.size());
+		for (size_t i = first; i < last; i++)
+		{
+			if (res->phys[i] == kNotCommitted)
+				continue;
+			void* addr = (void*)(res->base + i * kPage);
+			sceKernelMunmap(addr, kPage);
+			sceKernelReleaseDirectMemory(res->phys[i], kPage);
+			res->phys[i] = kNotCommitted;
+			// unmapping also dropped the reservation of this page: take it back
+			sceKernelReserveVirtualRange(&addr, kPage, kMapFixed, kPage);
+		}
+	}
+};
