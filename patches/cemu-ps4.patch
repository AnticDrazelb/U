+	// title-sources.ini: "<title ID>.update=auto|off|<path>" and ".dlc=..." (Triangle > Update & DLC)
+	void Menu::LoadSources()
+	{
+		m_sources.clear();
+		std::ifstream file(m_dataDir + "/title-sources.ini");
+		std::string line;
+		while (std::getline(file, line))
+		{
+			while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+				line.pop_back();
+			const size_t eq = line.find('=');
+			if (eq != std::string::npos && line[0] != '#')
+				m_sources[line.substr(0, eq)] = line.substr(eq + 1);
+		}
+	}
+
+	void Menu::SaveSources()
+	{
+		std::ofstream file(m_dataDir + "/title-sources.ini", std::ios::trunc);
+		file << "# Crema: which update and DLC each game uses (Triangle > Update & DLC); auto = the newest found\n";
+		for (const auto& [key, value] : m_sources)
+			if (value != "auto")
+				file << key << "=" << value << "\n";
+	}
+
+	std::string Menu::SourceChoice(const std::string& titleId, const char* what) const
+	{
+		auto it = m_sources.find(titleId + "." + what);
+		return it == m_sources.end() ? "auto" : it->second;
+	}
+
+	// the update / DLC a game starts with: the chosen one, else the newest found; none when off
+	const Game::Source* Menu::ChosenSource(const Game& game, const char* what) const
+	{
+		const auto& list = std::string(what) == "update" ? game.updates : game.dlcs;
+		const std::string choice = SourceChoice(game, what);
+		if (choice == "off" || list.empty())
+			return nullptr;
+		for (const Game::Source& source : list)
+			if (source.path == choice)
+				return &source;
+		return &list.front();
+	}
+
+	// title-extras.txt: "<game's path>\t<its update or DLC>" for the game process
+	// (PS4WindowSystem.cpp PrepareTitle adds them to Cemu's title list, so they mount as installed)
+	void Menu::WriteTitleExtras()
+	{
+		std::ofstream file(m_dataDir + "/title-extras.txt", std::ios::trunc);
+		for (const Game& game : m_games)
+		{
+			for (const char* what : {"update", "dlc"})
+				if (const Game::Source* source = ChosenSource(game, what))
+					file << game.path << "\t" << source->path << "\n";
+		}
+	}
+
+	// "v208, network library" / "Off" / "None found" (an update installed in mlc01 is used too)
+	std::string Menu::SourceLabel(const Game& game, const char* what) const
+	{
+		const auto& list = std::string(what) == "update" ? game.updates : game.dlcs;
+		if (list.empty())
+			return "None found";
+		const std::string choice = SourceChoice(game, what);
+		if (choice == "off")
+			return "Off";
+		const Game::Source* source = ChosenSource(game, what);
+		const std::string where = source->path.rfind("/net/", 0) == 0 ? "network library" : "games folder";
+		return fmt::format("{}v{}, {}", choice == "auto" ? "Auto: " : "", source->version, where);
+	}
