From 8c9b4fb509fbae0542a54022a435f7ac4cfb4578 Mon Sep 17 00:00:00 2001
From: ShiroKlein <ihaideezi@gmail.com>
Date: Sat, 17 Oct 2026 18:53:32 +0300
Subject: [PATCH] PS4: the aligned vertex fetch rule switchable at run time
 (ac_ps4_unaligned_vertex_fetch, Crema setting Vertex Fetch)

---
 src/amd/common/ac_shader_util.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/amd/common/ac_shader_util.c b/src/amd/common/ac_shader_util.c
index 322449a..b4b08d3 100644
--- a/src/amd/common/ac_shader_util.c
+++ b/src/amd/common/ac_shader_util.c
@@ -506,6 +506,11 @@ ac_get_vtx_format_info(enum amd_gfx_level level, bool has_alpha_adjust_bug, enum
  * also if the VBO offset is aligned to a scalar (eg. stride is 8 and VBO
  * offset is 2 for R16G16B16A16_SNORM).
  */
+#if defined(__PS4__) || defined(AC_PS4_ALIGNED_VERTEX_FETCH)
+/* PS4 (Crema setting vertex_fetch): 1 = gfx7's usual unaligned typed fetches, as upstream (a test) */
+int ac_ps4_unaligned_vertex_fetch = 0;
+#endif
+
 static bool
 is_fetch_size_safe(const enum amd_gfx_level gfx_level, const struct ac_vtx_format_info* vtx_info,
                    const unsigned offset, const unsigned alignment, const unsigned channels)
@@ -519,7 +524,7 @@ is_fetch_size_safe(const enum amd_gfx_level gfx_level, const struct ac_vtx_forma
     * An 8_8 fetch at an odd address (an R8G8B8A8 attribute whose first channel is unused) read
     * wrong data: the bone weights of every skinned model in Sonic Lost World, whose legs shattered.
     */
-   const bool unaligned_ok = false;
+   const bool unaligned_ok = ac_ps4_unaligned_vertex_fetch && gfx_level >= GFX7 && gfx_level <= GFX9;
 #else
    const bool unaligned_ok = gfx_level >= GFX7 && gfx_level <= GFX9;
 #endif
