+   *cs++ = 0xC03E1000;
+   *cs++ = 0x68750777;
+   for (int i = 0; i < 62; i++)
+      *cs++ = 0;
+   void *dcb[1] = {ib};
+   uint32_t dcb_size[1] = {(uint32_t)(cs - ib) * 4};
+   void *ccb[1] = {NULL};
+   uint32_t ccb_size[1] = {0};
+   /* behind the queued submissions (ps4_queue_job) */
+   struct ps4_job job;
+   job.dev = dev;
+   job.flip = true;
+   job.num_ibs = 1;
+   job.dcb[0] = dcb[0];
+   job.dcb_sizes[0] = dcb_size[0];
+   job.seq = seq;
+   job.video = video;
