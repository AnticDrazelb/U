diff --git a/nx/source/runtime/exception.s b/nx/source/runtime/exception.s
index 54cc4d0..81fe1dd 100644
--- a/nx/source/runtime/exception.s
+++ b/nx/source/runtime/exception.s
@@ -15,8 +15,14 @@
 
 .weak __libnx_exception_handler
 
-.weak __libnx_exception_entry
-CODE_BEGIN __libnx_exception_entry
+// Weak, so a program can replace it: CODE_BEGIN's .global would override that (an error in LLVM's
+// assembler, silently ignored by GNU as).
+    .section .text.__libnx_exception_entry, "ax", %progbits
+    .weak __libnx_exception_entry
+    .type __libnx_exception_entry, %function
+    .align 2
+    .cfi_startproc
+__libnx_exception_entry:
     cmp x1, #0
     beq __libnx_exception_entry_abort
 
