diff --git a/nx/source/display/buffer_producer.c b/nx/source/display/buffer_producer.c
index c74458e..4188065 100644
--- a/nx/source/display/buffer_producer.c
+++ b/nx/source/display/buffer_producer.c
@@ -254,37 +254,27 @@ Result bqSetPreallocatedBuffer(Binder *b, s32 buf, const BqGraphicBuffer *input)
 
     parcelWriteInt32(&parcel, hasInput);
     if (hasInput) {
-        struct {
-            u32 magic;
-            u32 width;
-            u32 height;
-            u32 stride;
-            u32 format;
-            u32 usage;
-
-            u32 pid;
-            u32 refcount;
-
-            u32 numFds;
-            u32 numInts;
-
-            u32 ints[input->native_handle->num_ints];
-        } buf;
-
-        // Serialize the buffer
-        buf.magic = 0x47424652; // GBFR (Graphic Buffer)
-        buf.width = input->width;
-        buf.height = input->height;
-        buf.stride = input->stride;
-        buf.format = input->format;
-        buf.usage = input->usage;
-        buf.pid = 42; // Official sw sets this to the value of getpid(), which is hardcoded to return 42.
-        buf.refcount = 0; // Official sw sets this to the output of android_atomic_inc(). We instead don't care and set it to zero since it is ignored during marshalling.
-        buf.numFds = 0;
-        buf.numInts = input->native_handle->num_ints;
-        memcpy(buf.ints, input->native_handle+1, sizeof(buf.ints));
-
-        parcelWriteFlattenedObject(&parcel, &buf, sizeof(buf));
+        // The flattened GraphicBuffer: a header of 10 words, then the native handle's ints. (A
+        // fixed array rather than a structure ending in a variable-length array, which only GCC
+        // accepts.)
+        enum { HeaderWords = 10, MaxInts = 0x100 };
+        const u32 num_ints = input->native_handle->num_ints;
+        if (num_ints > MaxInts)
+            return MAKERESULT(Module_Libnx, LibnxError_BadInput);
+        u32 buf[HeaderWords + MaxInts];
+        buf[0] = 0x47424652; // GBFR (Graphic Buffer)
+        buf[1] = input->width;
+        buf[2] = input->height;
+        buf[3] = input->stride;
+        buf[4] = input->format;
+        buf[5] = input->usage;
+        buf[6] = 42; // pid: official sw sets this to the value of getpid(), which is hardcoded to return 42.
+        buf[7] = 0; // refcount: official sw sets this to the output of android_atomic_inc(); ignored during marshalling.
+        buf[8] = 0; // numFds
+        buf[9] = num_ints;
+        memcpy(&buf[HeaderWords], input->native_handle+1, num_ints * sizeof(u32));
+
+        parcelWriteFlattenedObject(&parcel, buf, (HeaderWords + num_ints) * sizeof(u32));
     }
 
     rc = parcelTransact(b, SET_PREALLOCATED_BUFFER, &parcel, &parcel_reply);
