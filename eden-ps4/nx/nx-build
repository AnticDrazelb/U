#!/usr/bin/env bash
# Builds a Switch homebrew program (.nro) with clang and libnx built from source:
#   nx-build <out.nro> "<title>" "<author>" "<version>" <sources...> [-- extra compile flags]
set -euo pipefail
D="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$D/devkitA64/bin"
out="$1"; title="$2"; author="$3"; version="$4"; shift 4
srcs=(); extra=()
while [ $# -gt 0 ]; do
    if [ "$1" = "--" ]; then shift; extra=("$@"); break; fi
    srcs+=("$1"); shift
done
work="$(mktemp -d)"; trap 'rm -rf "$work"' EXIT
flags=(-O2 -fPIE -ffunction-sections -fdata-sections -ftls-model=local-exec -D__SWITCH__
    -I"$D/libnx/include" -include "$D/libnx-clang/clang_atomics.h" "${extra[@]}")
objs=()
for s in "${srcs[@]}"; do
    o="$work/$(basename "$s").o"
    "$BIN/aarch64-none-elf-gcc" "${flags[@]}" -c "$s" -o "$o"
    objs+=("$o")
done
# switch.specs' link flags, for lld (no --nx-module-name: a devkitA64 binutils option)
"$BIN/aarch64-none-elf-ld" -T "$D/libnx-clang/switch_clang.ld" -pie --no-dynamic-linker \
    --gc-sections -z text -z now -z nodynamic-undefined-weak --build-id=sha1 \
    -u _start -u main \
    "$D/libnx-clang/crt_clang.o" "${objs[@]}" \
    -L"$D/libnx/lib" -L"$D/devkitA64/aarch64-none-elf/lib" \
    --start-group -lnx -lc -lm -lsysbase -lclang_rt.builtins-aarch64 --end-group \
    -o "$work/out.elf"
"$D/tools/bin/nacptool" --create "$title" "$author" "$version" "$work/out.nacp" >/dev/null
"$D/tools/bin/elf2nro" "$work/out.elf" "$out" --nacp="$work/out.nacp" >/dev/null
cp "$work/out.elf" "${out%.nro}.elf"
echo "$out"
