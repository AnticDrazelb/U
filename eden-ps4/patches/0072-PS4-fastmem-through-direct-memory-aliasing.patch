index 6d39483b9..d37217ec9 100644
--- a/src/common/orbis_memory.h
+++ b/src/common/orbis_memory.h
@@ -11,6 +11,7 @@
 #ifdef __OPENORBIS__
 
 #include <cstddef>
+#include <cstdint>
 
 namespace Common::Orbis {
 
@@ -47,6 +48,57 @@ void ClearOnDemand(std::size_t offset, std::size_t length, unsigned char fill);
 std::size_t OnDemandBytes();
 std::size_t OnDemandPeakBytes();
 
+/// Fastmem: the Switch's memory at its own addresses in an arena (a reserved range), each page
+/// there the same direct memory as its place in the emulated DRAM, which the PS4 allows once
+/// sceKernelEnableDmemAliasing has been called. Pages are mapped lazily: an access to one not
+/// mapped yet faults, and ResolveFault maps it if the game's page table says it's ordinary
+/// memory (else the recompiler's fallback takes the access, through the page table).
+/// Enables direct memory aliasing for the app (once; true if the kernel allows it).
+bool EnableAliasing();
+/// Reserves the arena, the largest of 2^max_bits down to 2^32 bytes the kernel gives, for the
+/// emulated DRAM at `backing` (its size `backing_size`). Returns the arena, or nullptr (bits 0).
+void* ReserveFastmemArena(unsigned max_bits, void* backing, std::size_t backing_size, unsigned& bits);
+/// Unmaps the arena (before the DRAM's memory is given back)
+void ReleaseFastmemArena();
+/// log2 of the arena's size, 0 without one; its address (0: none)
+unsigned FastmemArenaBits();
+std::uintptr_t FastmemArenaBase();
+/// The page table whose ordinary pages the arena maps (the application's; nullptr: none)
+void SetFastmemPageTable(const void* page_table);
+/// Takes back [offset, offset + length) of the arena (to be mapped again, from the page table,
+/// when next touched): its mappings or page types changed. Call between LockArena/UnlockArena,
+/// around the page table's change, so that no fault maps a page from the entries as they were.
+void InvalidateArena(std::size_t offset, std::size_t length);
+void LockArena();
+void UnlockArena();
+/// Fault counts: arena pages mapped (bytes), faults resolved and declined
+std::size_t FastmemMappedBytes();
+std::size_t FastmemFaultsResolved();
+std::size_t FastmemFaultsDeclined();
+
+/// For a fault at `address` (any thread, in a signal handler): maps what belongs there if it's
+/// memory the port maps lazily (a sparse vector's page, a DRAM chunk, a fastmem page). True if
+/// the access can run again.
+bool ResolveFault(std::uintptr_t address);
+
+/// RAII: the arena locked while the page table changes (fastmem only)
+class ArenaUpdate {
+public:
+    explicit ArenaUpdate(bool active) : active{active} {
+        if (active)
+            LockArena();
+    }
+    ~ArenaUpdate() {
+        if (active)
+            UnlockArena();
+    }
+    ArenaUpdate(const ArenaUpdate&) = delete;
+    ArenaUpdate& operator=(const ArenaUpdate&) = delete;
+
+private:
+    bool active;
+};
+
 } // namespace Common::Orbis
 
 #endif
