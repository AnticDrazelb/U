 .../backend/exception_handler_posix.cpp       |  61 ++++-
 10 files changed, 431 insertions(+), 30 deletions(-)

diff --git a/src/common/host_memory.cpp b/src/common/host_memory.cpp
index 7e6d5805a..83c2707f0 100644
--- a/src/common/host_memory.cpp
+++ b/src/common/host_memory.cpp
@@ -730,6 +730,25 @@ HostMemory::HostMemory(size_t backing_size_, size_t virtual_size_)
     LOG_INFO(HW_Memory, "Emulated DRAM: {} MiB of direct memory, {}", backing_size >> 20,
              on_demand ? "taken as the game touches it" : "all taken now");
     virtual_base = nullptr;
+    // Fastmem: the Switch's memory at its own addresses, the same direct memory a second time
+    // (sceKernelEnableDmemAliasing allows it), mapped as the game touches it (orbis_memory.cpp).
+    // EDEN_PS4_FASTMEM=0 goes without (System Settings, CPU, Fastmem).
+    const char* fastmem_setting = std::getenv("EDEN_PS4_FASTMEM");
+    if (!(fastmem_setting && fastmem_setting[0] == '0')) {
+        unsigned bits = 0;
+        unsigned max_bits = 0;
+        for (size_t size = virtual_size; size > 1; size >>= 1) {
+            max_bits++;
+        }
+        if (void* arena = Orbis::ReserveFastmemArena(max_bits, backing_base, backing_size, bits)) {
+            virtual_base = static_cast<u8*>(arena);
+            virtual_size = size_t(1) << bits;
+            LOG_INFO(HW_Memory, "Fastmem: a {} GiB arena at {} (the Switch's addresses below 2^{})",
+                     virtual_size >> 30, arena, bits);
+        } else {
+            LOG_WARNING(HW_Memory, "Fastmem: none (direct memory aliasing refused, or no address range)");
+        }
+    }
 #elif defined(__managarm__)
     LOG_WARNING(HW_Memory, "Platform doesn't support fastmem");
     backing_base = static_cast<u8*>(mmap(nullptr, backing_size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0));
@@ -757,6 +776,9 @@ HostMemory::HostMemory(size_t backing_size_, size_t virtual_size_)
 
 HostMemory::~HostMemory() {
 #if defined(__OPENORBIS__)
+    if (virtual_base) {
+        Orbis::ReleaseFastmemArena(); // (before the memory behind it is given back)
+    }
     if (backing_base && on_demand) {
         Orbis::ReleaseOnDemand(backing_base, backing_size);
     } else if (backing_base) {
@@ -778,7 +800,12 @@ HostMemory::HostMemory(HostMemory&&) noexcept = default;
 HostMemory& HostMemory::operator=(HostMemory&&) noexcept = default;
 
 void HostMemory::Map(size_t virtual_offset, size_t host_offset, size_t length, MemoryPermission perms, bool separate_heap) {
-#if !(defined(__OPENORBIS__) || defined(__managarm__))
+#if defined(__OPENORBIS__)
+    // the arena's pages there are mapped again, from the page table, when next touched
+    if (virtual_base) {
+        Orbis::InvalidateArena(virtual_offset, length);
+    }
+#elif !defined(__managarm__)
     ASSERT(virtual_offset % PageAlignment == 0);
     ASSERT(host_offset % PageAlignment == 0);
     ASSERT(length % PageAlignment == 0);
@@ -792,7 +819,11 @@ void HostMemory::Map(size_t virtual_offset, size_t host_offset, size_t length, M
 }
 
 void HostMemory::Unmap(size_t virtual_offset, size_t length, bool separate_heap) {
-#if !(defined(__OPENORBIS__) || defined(__managarm__))
+#if defined(__OPENORBIS__)
+    if (virtual_base) {
+        Orbis::InvalidateArena(virtual_offset, length);
+    }
+#elif !defined(__managarm__)
     ASSERT(virtual_offset % PageAlignment == 0);
     ASSERT(length % PageAlignment == 0);
     ASSERT(virtual_offset + length <= virtual_size);
@@ -804,7 +835,13 @@ void HostMemory::Unmap(size_t virtual_offset, size_t length, bool separate_heap)
 }
 
 void HostMemory::Protect(size_t virtual_offset, size_t length, MemoryPermission perm) {
-#if !(defined(__OPENORBIS__) || defined(__managarm__))
+#if defined(__OPENORBIS__)
+    // The arena maps ordinary memory read/write (as the page table walk treats it); fewer rights
+    // (a page the GPU caches, a debug page) take its pages back: the page table decides again
+    if (virtual_base && !(True(perm & MemoryPermission::Read) && True(perm & MemoryPermission::Write))) {
+        Orbis::InvalidateArena(virtual_offset, length);
+    }
+#elif !defined(__managarm__)
     ASSERT(virtual_offset % PageAlignment == 0);
     ASSERT(length % PageAlignment == 0);
     ASSERT(virtual_offset + length <= virtual_size);
diff --git a/src/common/orbis_memory.cpp b/src/common/orbis_memory.cpp
index 5e8c8edf7..d91a7982e 100644
--- a/src/common/orbis_memory.cpp
+++ b/src/common/orbis_memory.cpp
@@ -18,6 +18,8 @@
 #include "common/literals.h"
 #include "common/logging.h"
 #include "common/orbis_memory.h"
+#include "common/page_table.h"
+#include "common/sparse_large_vector.h"
 
 // Declared here: the OpenOrbis headers give some of these other prototypes.
 extern "C" {
@@ -31,6 +33,8 @@ int32_t sceKernelMapDirectMemory(void** addr, size_t len, int32_t prot, int32_t
 int32_t sceKernelReleaseDirectMemory(off_t start, size_t len);
 int32_t sceKernelMapNamedFlexibleMemory(void** addr, size_t len, int32_t prot, int32_t flags,
                                         const char* name);
+int32_t sceKernelMprotect(const void* addr, size_t len, int32_t prot);
+int32_t sceKernelEnableDmemAliasing(void);
 // Crema's runtime (port/ps4_crashlog.cpp): a line in boot-trace.log, safe in a signal handler
 __attribute__((weak)) void ps4_boot_trace(const char* stage);
 }
@@ -171,20 +175,128 @@ void ChainSignal(const struct sigaction& previous, int sig, siginfo_t* info, voi
     }
 }
 
-void OnDemandFaultHandler(int sig, siginfo_t* info, void* context) {
-    const uintptr_t address = FaultAddress(info);
+// A fault in the on-demand range: its chunk mapped (true), or not ours / no memory (false)
+bool ResolveOnDemandFault(uintptr_t address) noexcept {
     const uintptr_t base = on_demand.base.load(std::memory_order_acquire);
-    if (base && address >= base && address - base < on_demand.size) {
-        const int saved_errno = errno; // (the code it interrupted may be about to read it)
-        const bool committed = CommitChunk((address - base) / OnDemandChunk);
-        errno = saved_errno;
-        if (committed)
-            return; // the access runs again, now with memory there
-        Trace("eden: the emulated RAM couldn't get direct memory (all of it is in use)");
+    if (!base || address < base || address - base >= on_demand.size)
+        return false;
+    if (CommitChunk((address - base) / OnDemandChunk))
+        return true; // the access runs again, now with memory there
+    Trace("eden: the emulated RAM couldn't get direct memory (all of it is in use)");
+    return false;
+}
+
+// The fastmem arena (see orbis_memory.h). The resolver reads the game's page table (atomics) and
+// maps under arena_lock, which the page table's changes take too (ArenaUpdate in core/memory.cpp).
+struct FastmemArena {
+    std::atomic<uintptr_t> base{0};
+    size_t size = 0;
+    unsigned bits = 0;
+    uintptr_t backing = 0;
+    size_t backing_size = 0;
+    std::atomic<const Common::PageTable*> table{nullptr};
+    std::atomic<size_t> mapped{0}, resolved{0}, declined{0};
+};
+FastmemArena arena;
+std::atomic_flag arena_lock = ATOMIC_FLAG_INIT;
+constexpr size_t ArenaPage = 16_KiB;   // the PS4's page
+constexpr size_t GuestPage = 4_KiB;
+constexpr size_t MaxArenaRun = 512_KiB; // mapped at once when the pages after qualify too
+
+// The direct memory behind DRAM offset `offset` (16 KiB aligned), committing its chunk if the
+// game hasn't touched it yet; -1 if there's none
+off_t PhysOf(size_t offset) noexcept {
+    if (on_demand.base.load(std::memory_order_acquire) == arena.backing) {
+        const size_t index = offset / OnDemandChunk;
+        if (!CommitChunk(index))
+            return -1;
+        return on_demand.phys[index] + off_t(offset % OnDemandChunk);
     }
+    size_t at = 0; // (all up front: MapDirectMemory's pieces, back to back)
+    for (const DirectPiece& piece : direct_pieces) {
+        if (reinterpret_cast<uintptr_t>(piece.base) != arena.backing)
+            continue;
+        if (offset < at + piece.size)
+            return piece.phys + off_t(offset - at);
+        at += piece.size;
+    }
+    return -1;
+}
+
+// The DRAM offset of the 16 KiB at guest address `va` (16 KiB aligned) if its four guest pages
+// are ordinary memory, back to back in the DRAM; else SIZE_MAX
+size_t ArenaPageSource(const Common::PageTable& table, u64 va) noexcept {
+    size_t source = SIZE_MAX;
+    for (size_t i = 0; i < ArenaPage / GuestPage; i++) {
+        const size_t index = (va >> 12) + i;
+        if (index >= table.entries.size())
+            return SIZE_MAX;
+        const auto [pointer, type, block] = table.entries.GetOrDefault(index).PointerTypeBlock(true);
+        (void)block;
+        if (type != Common::PageType::Memory || pointer == 0)
+            return SIZE_MAX;
+        const uintptr_t host = pointer + va + i * GuestPage;
+        if (host < arena.backing || host - arena.backing >= arena.backing_size)
+            return SIZE_MAX;
+        const size_t offset = host - arena.backing;
+        if (i == 0) {
+            if (offset % ArenaPage != 0)
+                return SIZE_MAX;
+            source = offset;
+        } else if (offset != source + i * GuestPage) {
+            return SIZE_MAX;
+        }
+    }
+    return source;
+}
+
+bool ResolveArenaFault(uintptr_t address) noexcept {
+    const uintptr_t base = arena.base.load(std::memory_order_acquire);
+    if (!base || address < base || address - base >= arena.size)
+        return false;
+    const Common::PageTable* table = arena.table.load(std::memory_order_acquire);
+    if (!table) {
+        arena.declined.fetch_add(1, std::memory_order_relaxed);
+        return false;
+    }
+    LockArena();
+    const u64 va = (address - base) & ~u64(ArenaPage - 1);
+    const size_t source = ArenaPageSource(*table, va);
+    bool mapped = false;
+    if (source != SIZE_MAX) {
+        // and the pages after it, as far as they follow on in the DRAM, in the same chunk
+        size_t length = ArenaPage;
+        while (length < MaxArenaRun && (source + length) % OnDemandChunk != 0 && va + length < arena.size &&
+               ArenaPageSource(*table, va + length) == source + length) {
+            length += ArenaPage;
+        }
+        const off_t phys = PhysOf(source);
+        if (phys >= 0) {
+            void* at = reinterpret_cast<void*>(base + va);
+            mapped = sceKernelMapDirectMemory(&at, length, ProtCpuReadWrite, MapFixed, phys, ArenaPage) == 0 &&
+                     at == reinterpret_cast<void*>(base + va);
+            if (mapped)
+                arena.mapped.fetch_add(length, std::memory_order_relaxed);
+        }
+    }
+    UnlockArena();
+    (mapped ? arena.resolved : arena.declined).fetch_add(1, std::memory_order_relaxed);
+    return mapped;
+}
+
+void OnDemandFaultHandler(int sig, siginfo_t* info, void* context) {
+    const int saved_errno = errno; // (the code it interrupted may be about to read it)
+    const bool resolved = ResolveFault(FaultAddress(info));
+    errno = saved_errno;
+    if (resolved)
+        return;
     ChainSignal(sig == SIGBUS ? previous_bus : previous_segv, sig, info, context);
 }
 
+// Installed once (on-demand DRAM or the fastmem arena, whichever comes first): installed twice it
+// would chain to itself
+std::once_flag fault_handler_once;
+
 void InstallOnDemandFaultHandler() {
     struct sigaction action;
     std::memset(&action, 0, sizeof(action));
@@ -266,8 +378,7 @@ bool ReserveOnDemand(void* base, size_t size) {
     on_demand.direct_size = sceKernelGetDirectMemorySize();
     on_demand.bytes = 0;
     on_demand.peak = 0;
-    static std::once_flag handler_once;
-    std::call_once(handler_once, InstallOnDemandFaultHandler);
+    std::call_once(fault_handler_once, InstallOnDemandFaultHandler);
     on_demand.base.store(reinterpret_cast<uintptr_t>(base), std::memory_order_release);
     return true;
 }
@@ -308,6 +419,105 @@ size_t OnDemandPeakBytes() {
     return on_demand.peak.load(std::memory_order_relaxed);
 }
 
+bool EnableAliasing() {
+    static const bool enabled = sceKernelEnableDmemAliasing() == 0;
+    return enabled;
+}
+
+void* ReserveFastmemArena(unsigned max_bits, void* backing, size_t backing_size, unsigned& bits) {
+    bits = 0;
+    if (!EnableAliasing())
+        return nullptr;
+    for (unsigned b = max_bits; b >= 32; b--) {
+        if (void* range = ReserveRange(size_t(1) << b, 2_MiB)) {
+            arena.size = size_t(1) << b;
+            arena.bits = b;
+            arena.backing = reinterpret_cast<uintptr_t>(backing);
+            arena.backing_size = backing_size;
+            arena.base.store(reinterpret_cast<uintptr_t>(range), std::memory_order_release);
+            // (faults outside recompiled code: the same resolver)
+            std::call_once(fault_handler_once, InstallOnDemandFaultHandler);
+            bits = b;
+            return range;
+        }
+    }
+    return nullptr;
+}
+
+void ReleaseFastmemArena() {
+    const uintptr_t base = arena.base.exchange(0, std::memory_order_acq_rel);
+    if (base)
+        sceKernelMunmap(reinterpret_cast<void*>(base), arena.size);
+    arena.table.store(nullptr, std::memory_order_release);
+    arena.bits = 0;
+}
+
+uintptr_t FastmemArenaBase() {
+    return arena.base.load(std::memory_order_acquire);
+}
+
+unsigned FastmemArenaBits() {
+    return arena.base.load(std::memory_order_acquire) ? arena.bits : 0;
+}
+
+void SetFastmemPageTable(const void* page_table) {
+    arena.table.store(static_cast<const Common::PageTable*>(page_table), std::memory_order_release);
+}
+
+void LockArena() {
+    while (arena_lock.test_and_set(std::memory_order_acquire)) {
+        sched_yield();
+    }
+}
+
+void UnlockArena() {
+    arena_lock.clear(std::memory_order_release);
+}
+
+void InvalidateArena(size_t offset, size_t length) {
+    const uintptr_t base = arena.base.load(std::memory_order_acquire);
+    if (!base || length == 0 || offset >= arena.size)
+        return;
+    const size_t begin = offset & ~(ArenaPage - 1);
+    const size_t end = std::min(arena.size, (offset + length + ArenaPage - 1) & ~(ArenaPage - 1));
+    sceKernelMprotect(reinterpret_cast<void*>(base + begin), end - begin, 0);
+}
+
+size_t FastmemMappedBytes() {
+    return arena.mapped.load(std::memory_order_relaxed);
+}
+
+size_t FastmemFaultsResolved() {
+    return arena.resolved.load(std::memory_order_relaxed);
+}
+
+size_t FastmemFaultsDeclined() {
+    return arena.declined.load(std::memory_order_relaxed);
+}
+
+bool ResolveFault(uintptr_t address) {
+    return ResolveVectorFault(address) || ResolveOnDemandFault(address) || ResolveArenaFault(address);
+}
+
+} // namespace Common::Orbis
+
+// dynarmic's fault handler (backend/exception_handler_posix.cpp, PS4) asks this first: a fault in
+// recompiled code may be a page table page, a DRAM chunk or a fastmem page to map, not a fastmem
+// access to send to its fallback
+extern "C" bool dynarmic_ps4_in_fastmem_arena(uintptr_t address) {
+    const uintptr_t base = Common::Orbis::FastmemArenaBase();
+    return base != 0 && address >= base && address - base < (std::size_t(1) << Common::Orbis::FastmemArenaBits());
+}
+
+extern "C" bool dynarmic_ps4_resolve_fault(uintptr_t address) {
+    const int saved_errno = errno;
+    const bool resolved = Common::Orbis::ResolveFault(address);
+    errno = saved_errno;
+    return resolved;
+}
+
+namespace Common::Orbis {
+
 } // namespace Common::Orbis
 
 #endif
