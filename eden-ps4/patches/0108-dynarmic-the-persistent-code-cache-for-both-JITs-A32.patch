-    // Each 8 bytes in [begin, end) holding a pointer into one of the objects
-    template<typename F>
-    static void CacheScan(const u8* begin, const u8* end, const std::vector<std::pair<u64, u64>>& objects, F&& found) {
-        u64 low = ~u64{0}, high = 0;
-        for (const auto& [pointer, size] : objects) {
-            low = std::min(low, pointer);
-            high = std::max(high, pointer + size);
-        }
-        for (const u8* p = begin; p + 8 <= end; ++p) {
-            u64 value;
-            std::memcpy(&value, p, 8);
-            if (value < low || value >= high)
-                continue;
-            if (const auto hit = CacheFindObject(objects, value)) {
-                found(p, hit->first, hit->second);
-                p += 7;
-            }
-        }
-    }
