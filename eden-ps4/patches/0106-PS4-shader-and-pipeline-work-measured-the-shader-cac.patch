diff --git a/src/video_core/buffer_cache/buffer_cache.h b/src/video_core/buffer_cache/buffer_cache.h
index f667912f3b..1a04ad6267 100644
--- a/src/video_core/buffer_cache/buffer_cache.h
+++ b/src/video_core/buffer_cache/buffer_cache.h
@@ -987,6 +987,31 @@ void BufferCache<P>::BindHostGraphicsUniformBuffer(size_t stage, u32 index, u32
 #ifdef __OPENORBIS__
         Common::PS4Perf::Bump(Common::PS4Perf::gpu_thread.ubo_copied);
         Common::PS4Perf::Bump(Common::PS4Perf::gpu_thread.ubo_copied_bytes, size);
+        {
+            // (04.17) How many copies repeat the slot's last one (what reusing a copy could save):
+            // 1 in 16 of the copies hashed, the same slot's next copy compared with it
+            namespace Perf = Common::PS4Perf;
+            UboSample& sample = ubo_samples[stage % NUM_STAGES][binding_index % NUM_GRAPHICS_UNIFORM_BUFFERS];
+            if (sample.armed || (++ubo_sample_tick & 15) == 0) {
+                if (const u8* const source = device_memory.GetSpan(device_addr, size)) {
+                    const u64 hash = Common::CityHash64(reinterpret_cast<const char*>(source), size);
+                    if (sample.armed) {
+                        sample.armed = false;
+                        Perf::Bump(Perf::gpu_thread.ubo_checks);
+                        if (sample.device_addr != device_addr || sample.size != size)
+                            Perf::Bump(Perf::gpu_thread.ubo_moved);
+                        else if (sample.hash == hash)
+                            Perf::Bump(Perf::gpu_thread.ubo_same);
+                        else
+                            Perf::Bump(Perf::gpu_thread.ubo_changed);
+                    } else {
+                        sample = {device_addr, size, hash, true};
+                    }
+                } else {
+                    sample.armed = false;
+                }
+            }
+        }
 #endif
         const std::span<u8> span = runtime.BindMappedUniformBuffer(stage, binding_index, size);
         device_memory.ReadBlockUnsafe(device_addr, span.data(), size);
