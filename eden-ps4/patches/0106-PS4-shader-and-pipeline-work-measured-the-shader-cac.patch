@@ -111,7 +128,24 @@ ComputePipeline::ComputePipeline(const Device& device_, Scheduler& scheduler, vk
             .basePipelineIndex = 0,
         };
         try {
+#ifdef __OPENORBIS__
+            const auto create_start = std::chrono::steady_clock::now();
