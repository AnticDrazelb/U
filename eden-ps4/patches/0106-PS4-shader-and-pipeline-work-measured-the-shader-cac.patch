             pipeline = device.GetLogical().CreateComputePipeline(compute_ci, *pipeline_cache);
+#ifdef __OPENORBIS__
+            const u64 us = u64(std::chrono::duration_cast<std::chrono::microseconds>(
+                                   std::chrono::steady_clock::now() - create_start).count());
+            auto& work = Common::PS4Perf::PipelineWorkNow();
+            work.created.fetch_add(1, std::memory_order_relaxed);
