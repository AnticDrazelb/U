From 0e2208c2ed38ad7e591afd323545c00c6b94253b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 2 Nov 2026 09:42:45 +0000
Subject: [PATCH] PS4: the game's code region lined up with 16 KiB pages (ASLR
 step), allocation rests in one piece

The loaders' ASLR offset was a random 4 KiB step: three times in four the code region (every
module's code, constants and globals) was out of line with its memory (blocks at their own size's
boundary) by 4, 8 or 12 KiB, so the PS4's fastmem, which maps 16 KiB pages from 16 KiB of the
DRAM, could map none of it, and each instruction touching it was recompiled to walk the page
table (about 135,000 in a Mario Kart session). On the PS4 the offset is now a 16 KiB step.
AllocatePageGroupImpl gives the rest under 64 KiB as one run at a 16 KiB boundary
(AllocateAligned) instead of single pages anywhere (the code region's end, its globals).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01VdsH7Cki1YqWbFL1ncEV7C
---
 src/core/hle/kernel/k_memory_manager.cpp      | 31 +++++++++++++++++++
 .../loader/deconstructed_rom_directory.cpp    |  6 ++++
 src/core/loader/nro.cpp                       |  6 ++++
 3 files changed, 43 insertions(+)

diff --git a/src/core/hle/kernel/k_memory_manager.cpp b/src/core/hle/kernel/k_memory_manager.cpp
index 743e29054..9a0fcfbc8 100644
--- a/src/core/hle/kernel/k_memory_manager.cpp
+++ b/src/core/hle/kernel/k_memory_manager.cpp
@@ -265,6 +265,37 @@ Result KMemoryManager::AllocatePageGroupImpl(KPageGroup* out, size_t num_pages,
 
     // Keep allocating until we've allocated all our pages.
     for (s32 index = heap_index; index >= 0 && num_pages > 0; index--) {
+#if defined(__OPENORBIS__) || defined(EDEN_TEST_ARENA_LINE_UP)
+        // The PS4's fastmem maps 16 KiB pages, each from 16 KiB of the DRAM: the rest under the
+        // smallest block but one (64 KiB) as one run at a 16 KiB boundary rather than single 4 KiB
+        // pages anywhere, so that it maps too (a code region's end, its globals, often is that rest)
+        if (index == 0 && num_pages > 1) {
+            constexpr size_t ArenaPages = 4;
+            const s32 aligned_index = KPageHeap::GetAlignedBlockIndex(num_pages, ArenaPages);
+            for (Impl* cur_manager = this->GetFirstManager(pool, dir);
+                 aligned_index >= 0 && cur_manager != nullptr && num_pages > 0;
+                 cur_manager = this->GetNextManager(cur_manager, dir)) {
+                const KPhysicalAddress run = cur_manager->AllocateAligned(aligned_index, num_pages, ArenaPages);
+                if (run == 0) {
+                    continue;
+                }
+                ON_RESULT_FAILURE_2 {
+                    cur_manager->Free(run, num_pages);
+                };
+                R_TRY(out->AddBlock(run, num_pages));
+#if !defined(__OPENORBIS__)
+                LOG_INFO(Kernel, "16 KiB-aligned rest: {} pages at {:#x}", num_pages, GetInteger(run));
+#endif
+                if (unoptimized) {
+                    cur_manager->TrackUnoptimizedAllocation(m_system.Kernel(), run, num_pages);
+                }
+                num_pages = 0;
+            }
+            if (num_pages == 0) {
+                break;
+            }
+        }
+#endif
         const size_t pages_per_alloc = KPageHeap::GetBlockNumPages(index);
         for (Impl* cur_manager = this->GetFirstManager(pool, dir); cur_manager != nullptr;
              cur_manager = this->GetNextManager(cur_manager, dir)) {
diff --git a/src/core/loader/deconstructed_rom_directory.cpp b/src/core/loader/deconstructed_rom_directory.cpp
index 5e2ec7e0b..fb31eb46c 100644
--- a/src/core/loader/deconstructed_rom_directory.cpp
+++ b/src/core/loader/deconstructed_rom_directory.cpp
@@ -233,6 +233,12 @@ AppLoader_DeconstructedRomDirectory::LoadResult AppLoader_DeconstructedRomDirect
     // TODO: this is bad form of ASLR, it sucks
     std::uintptr_t aslr_offset = ((::Settings::values.rng_seed_enabled.GetValue()
         ? ::Settings::values.rng_seed.GetValue() : Common::Random::Random64(0)) << 12) & 0xfff000;
+#ifdef __OPENORBIS__
+    // At a 16 KiB boundary: the code region's memory comes in blocks at their own size's boundary,
+    // so its every 16 KiB page then lines up with 16 KiB of the DRAM, which the PS4's fastmem maps
+    // (at a 4 KiB step, three times in four none of the game's code, constants and globals did)
+    aslr_offset &= ~std::uintptr_t(0x3fff);
+#endif
 
     // Setup the process code layout
     if (process.LoadFromMetadata(system.Kernel(), metadata, code_size, fastmem_base, aslr_offset).IsError()) {
