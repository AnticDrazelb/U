@@ -277,6 +277,12 @@ static bool LoadNroImpl(Core::System& system, Kernel::KProcess& process,
     // TODO: this is bad form of ASLR, it sucks
     std::uintptr_t aslr_offset = ((::Settings::values.rng_seed_enabled.GetValue()
         ? ::Settings::values.rng_seed.GetValue() : Common::Random::Random64(0)) << 12) & 0xfff000;
+#ifdef __OPENORBIS__
+    // At a 16 KiB boundary: the code region's memory comes in blocks at their own size's boundary,
+    // so its every 16 KiB page then lines up with 16 KiB of the DRAM, which the PS4's fastmem maps
+    // (at a 4 KiB step, three times in four none of the game's code, constants and globals did)
+    aslr_offset &= ~std::uintptr_t(0x3fff);
+#endif
 
     // Setup the process code layout
     if (process
