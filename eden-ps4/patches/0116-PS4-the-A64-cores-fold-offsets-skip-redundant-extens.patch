From 3673df5d3b0912b4c9c932bf93e35e82f1e1e859 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 3 Nov 2026 22:33:13 +0000
Subject: [PATCH 116/116] PS4: the A64 cores fold offsets, skip redundant
 extensions, split cold code; FPS counter at the top centre

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01REmpC53sSK3VTcKMxWFSSb
---
 src/core/arm/dynarmic/arm_dynarmic_64.cpp                 | 7 +++++++
 .../renderer_vulkan/present/window_adapt_pass.cpp         | 8 +++++---
 2 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/src/core/arm/dynarmic/arm_dynarmic_64.cpp b/src/core/arm/dynarmic/arm_dynarmic_64.cpp
index 92f7478b2b..c7bbae2a82 100644
--- a/src/core/arm/dynarmic/arm_dynarmic_64.cpp
+++ b/src/core/arm/dynarmic/arm_dynarmic_64.cpp
@@ -284,6 +284,13 @@ void ArmDynarmic64::MakeJit(Common::PageTable* page_table, std::size_t address_s
     config.inline_rsb_pop = true;
     // and each indirect jump (calls through registers, as C++ virtual calls; jump tables) too
     config.inline_fast_dispatch = true;
+    // (04.22) as the 32-bit cores since 04.05-04.07: with fastmem, LDR x0, [x1, #8] is one
+    // access at r13 + x1 + 8, without an add before it (the range check takes the 8 off its limit)
+    config.fold_address_offsets = true;
+    // LDRB/LDRH/STRB/STRH without zero extensions of their own
+    config.skip_redundant_extensions = true;
+    // each block's rarely run code apart from it: the code that runs packed together
+    config.split_cold_code = true;
 
     // Code cache size
 #if defined(__OPENORBIS__)
diff --git a/src/video_core/renderer_vulkan/present/window_adapt_pass.cpp b/src/video_core/renderer_vulkan/present/window_adapt_pass.cpp
index ab387c6f81..ef5164d70e 100644
--- a/src/video_core/renderer_vulkan/present/window_adapt_pass.cpp
+++ b/src/video_core/renderer_vulkan/present/window_adapt_pass.cpp
@@ -27,7 +27,7 @@ namespace Vulkan {
 namespace {
 
 // The FPS counter (Settings::values.show_fps_overlay): the game's frames each second, as
-// seven-segment digits drawn with clears in the present pass - no pipeline or texture of its own. A
+// seven-segment digits drawn with clears in the present pass, at the top centre - no pipeline or texture of its own. A
 // frame counts when the picture comes from another of the game's buffers than the last: a frame
 // presented again (the game slower than the display, or presented twice for a capture) doesn't.
 struct FpsCounter {
@@ -65,7 +65,9 @@ void FpsRects(u32 value, VkExtent2D area, std::vector<VkClearRect>& box, std::ve
     const s32 pad = thick * 2;
     const std::string text = std::to_string(std::min<u32>(value, 999));
     const s32 count = static_cast<s32>(text.size());
-    const s32 x0 = pad * 2, y0 = pad * 2;
+    // (PS4 04.22) at the top centre (top left before)
+    const s32 text_width = count * width + (count - 1) * gap;
+    const s32 x0 = std::max<s32>(pad * 2, (static_cast<s32>(area.width) - text_width) / 2), y0 = pad * 2;
     const auto rect = [&](s32 x, s32 y, s32 w, s32 h) {
         const s32 right = std::min<s32>(x + w, static_cast<s32>(area.width));
         const s32 bottom = std::min<s32>(y + h, static_cast<s32>(area.height));
@@ -77,7 +79,7 @@ void FpsRects(u32 value, VkExtent2D area, std::vector<VkClearRect>& box, std::ve
                            .baseArrayLayer = 0,
                            .layerCount = 1};
     };
-    box.push_back(rect(x0 - pad, y0 - pad, count * width + (count - 1) * gap + pad * 2, height + pad * 2));
+    box.push_back(rect(x0 - pad, y0 - pad, text_width + pad * 2, height + pad * 2));
     for (s32 i = 0; i < count; i++) {
         const u8 on = kSegments[text[static_cast<size_t>(i)] - '0'];
         const s32 x = x0 + i * (width + gap);
-- 
