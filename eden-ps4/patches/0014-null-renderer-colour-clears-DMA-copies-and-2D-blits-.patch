 #include "video_core/host1x/host1x.h"
 #include "video_core/memory_manager.h"
 #include "video_core/renderer_null/null_rasterizer.h"
@@ -11,11 +18,13 @@ namespace Null {
 
 AccelerateDMA::AccelerateDMA() = default;
 
+// Not accelerated: the DMA engine copies and fills in software instead, in emulated memory, which
+// the null renderer's frames are composed from.
 bool AccelerateDMA::BufferCopy(GPUVAddr start_address, GPUVAddr end_address, u64 amount) {
-    return true;
+    return false;
 }
 bool AccelerateDMA::BufferClear(GPUVAddr src_address, u64 amount, u32 value) {
-    return true;
