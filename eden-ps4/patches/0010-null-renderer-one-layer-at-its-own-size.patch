+bool RendererNull::ReadLayer(const Tegra::FramebufferConfig& layer, Common::Rectangle<int>& crop,
+                             u32& bpp) {
+    using namespace VideoCore::Surface;
+    bpp = BytesPerBlock(PixelFormatFromGPUPixelFormat(layer.pixel_format));
+    const u8* const tiled = m_device_memory.GetPointer<u8>(layer.address + layer.offset);
+    if (!tiled || layer.width == 0 || layer.height == 0 || bpp == 0) {
+        return false;
+    }
+    // Block linear, as the Vulkan presenter reads it (block height 16 GOBs).
+    constexpr u32 block_height_log2 = 4;
+    const u64 tiled_size = Tegra::Texture::CalculateSize(true, bpp, layer.stride, layer.height, 1,
+                                                         block_height_log2, 0);
+    m_linear.resize(size_t(layer.width) * layer.height * bpp);
+    Tegra::Texture::UnswizzleTexture(m_linear, std::span(tiled, tiled_size), bpp, layer.width,
+                                     layer.height, 1, block_height_log2, 0);
+
+    crop = layer.crop_rect;
+    if (crop.GetWidth() <= 0 || crop.GetHeight() <= 0) {
+        crop = {0, 0, int(layer.width), int(layer.height)};
+    }
+    crop.left = std::max(crop.left, 0);
+    crop.top = std::max(crop.top, 0);
+    crop.right = std::min<int>(crop.right, int(layer.width));
+    crop.bottom = std::min<int>(crop.bottom, int(layer.height));
+    return crop.GetWidth() > 0 && crop.GetHeight() > 0;
+}
+
+std::pair<bool, bool> RendererNull::Flips(const Tegra::FramebufferConfig& layer) {
+    const auto flags = static_cast<u32>(layer.transform_flags);
+    return {(flags & static_cast<u32>(Service::android::BufferTransformFlags::FlipH)) != 0,
+            (flags & static_cast<u32>(Service::android::BufferTransformFlags::FlipV)) != 0};
+}
+
 std::vector<u8> RendererNull::GetAppletCaptureBuffer() {
     return std::vector<u8>(VideoCore::Capture::TiledSize);
 }
