 void RendererNull::ComposeSoftwareFrame(std::span<const Tegra::FramebufferConfig> framebuffers) {
-    // The Switch's screen (handheld): layers are scaled to it, in order, bottom to top.
+    // The layers on the screen's stack, bottom to top.
+    std::vector<const Tegra::FramebufferConfig*> layers;
+    for (const auto& layer : framebuffers) {
+        if (layer.layer_stack_mask &
+            Service::Nvnflinger::LayerStackBit(Service::Nvnflinger::LayerStackId::Default)) {
+            layers.push_back(&layer);
+        }
+    }
+
+    // One layer, the usual case: its pixels at its own size (the frontend scales them to its
+    // screen, as the Switch's compositor scales a layer to the Switch's).
+    if (layers.size() == 1) {
+        Common::Rectangle<int> crop;
+        u32 bpp;
+        if (!ReadLayer(*layers[0], crop, bpp)) {
+            return;
+        }
+        const auto& layer = *layers[0];
+        const u32 width = u32(crop.GetWidth()), height = u32(crop.GetHeight());
+        const auto [flip_h, flip_v] = Flips(layer);
+        m_frame.resize(size_t(width) * height);
+        for (u32 y = 0; y < height; y++) {
+            const int sy = flip_v ? crop.bottom - 1 - int(y) : crop.top + int(y);
+            const u8* row = m_linear.data() + size_t(sy) * layer.width * bpp;
+            u32* out = m_frame.data() + size_t(y) * width;
+            for (u32 x = 0; x < width; x++) {
+                const int sx = flip_h ? crop.right - 1 - int(x) : crop.left + int(x);
+                out[x] = Blend(0xFF000000u, ToRgba(row + size_t(sx) * bpp, layer.pixel_format),
+                               layer.blending);
+            }
+        }
+        render_window.OnSoftwareFrame(m_frame, width, height);
+        return;
+    }
+
