+BlockOfCode::CacheLayout BlockOfCode::GetCacheLayout() const {
+    ASSERT(!in_cold);
+    const u8* const base = top_;
+    CacheLayout layout;
+    layout.prelude_end = size_t(static_cast<const u8*>(code_begin) - base);
+    layout.hot_end = size_;
+    layout.total = maxSize_;
+    if (cold_enabled) {
+        layout.cold_low = size_t(cold_low - base);
+        layout.cold_ptr = size_t(cold_ptr - base);
+        layout.cold_end = size_t(cold_end - base);
+    } else {
+        layout.cold_low = layout.cold_ptr = layout.cold_end = maxSize_;
+    }
+    return layout;
+}
+
+bool BlockOfCode::SetCacheLayout(const CacheLayout& layout) {
+    ASSERT(!in_cold);
+    const size_t prelude_end = size_t(static_cast<const u8*>(code_begin) - top_);
+    if (layout.total != maxSize_ || layout.prelude_end != prelude_end || layout.hot_end < prelude_end ||
+        layout.hot_end > layout.cold_low || layout.cold_low > layout.cold_ptr || layout.cold_ptr > layout.cold_end ||
+        layout.cold_end > layout.total || (!cold_enabled && layout.cold_low != layout.total)) {
+        return false;
+    }
+    setSize(layout.hot_end);
+    if (cold_enabled) {
+        cold_low = top_ + layout.cold_low;
+        cold_ptr = top_ + layout.cold_ptr;
+        cold_end = top_ + layout.cold_end;
+    }
+    return true;
+}
+
 CodePtr BlockOfCode::GetCodeBegin() const {
     return code_begin;
 }
