+bool ConstantPool::Restore(std::span<const std::pair<u64, u64>> saved) {
+    if (saved.size() < insertion_point || saved.size() > pool.size()) {
+        return false;
+    }
+    for (size_t i = 0; i < insertion_point; ++i) {
+        if (pool[i] != saved[i]) {
+            return false;
+        }
+    }
+    for (size_t i = insertion_point; i < saved.size(); ++i) {
+        pool[i] = saved[i];
+        constant_info.insert({saved[i], &pool[i]});
+    }
+    insertion_point = saved.size();
+    return true;
+}
