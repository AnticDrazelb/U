From f74b0f874e439699c096fdfc1341796d584ff27c Mon Sep 17 00:00:00 2001
From: Eden PS4 <eden-ps4@users.noreply.github.com>
Date: Sat, 31 Oct 2026 15:00:25 +0000
Subject: [PATCH] PS4: page table entries keep the whole host offset (no sign
 extension in the recompilers' walk)

On the PS4 an entry's offset takes bits 12-63 whole (EDEN_PAGE_ENTRY_FULL_OFFSET); the block id
keeps its low 9 bits, as it's only read back to be stored again. ATTRIBUTE_MASK is ~0xFFF and the
recompilers get no page_table_sign_extension, so their inline walk is one AND with an immediate
instead of that plus SHL and SAR, on every guest load and store outside a shared-walk group.

A packing test (2,000,000 random entries: negative offsets, marked bits, block ids) and the host
harnesses built with either layout (1,400 random A32, Thumb and A64 programs) agree; four dependent
A64 loads 19.6-20.8 -> 16.0-16.5 ns.
---
 src/common/page_table.h                   | 38 +++++++++++++++++++++++
 src/core/arm/dynarmic/arm_dynarmic_32.cpp |  2 +-
 src/core/arm/dynarmic/arm_dynarmic_64.cpp |  2 +-
 3 files changed, 40 insertions(+), 2 deletions(-)

diff --git a/src/common/page_table.h b/src/common/page_table.h
index 46a04ff48..906d7ac56 100644
--- a/src/common/page_table.h
+++ b/src/common/page_table.h
@@ -12,6 +12,14 @@
 #include "common/sparse_large_vector.h"
 #include "common/typed_address.h"
 
+// On the PS4 a page table entry keeps the whole host offset, bits 12-63, so that the recompiler's
+// inline walk only clears the attribute bits (one AND with an immediate) instead of also sign
+// extending from bit 55 (SHL and SAR, on every load and store of the game's). The block id keeps
+// its low 9 bits: it's only ever read back to be stored again.
+#if defined(__OPENORBIS__) && !defined(EDEN_PAGE_ENTRY_FULL_OFFSET)
+#define EDEN_PAGE_ENTRY_FULL_OFFSET 1
+#endif
+
 namespace Common {
 
 enum class PageType : u8 {
@@ -42,6 +50,13 @@ struct PageTable {
         u64 next_offset{};
     };
 
+#ifdef EDEN_PAGE_ENTRY_FULL_OFFSET
+    /// The whole offset, bits 12-63: no sign extension (FULL_OFFSET)
+    static constexpr bool FULL_OFFSET = true;
+    static constexpr u64 ATTRIBUTE_MASK = ~u64{0xFFF};
+    static constexpr u64 SIGN_BIT = 63;
+#else
+    static constexpr bool FULL_OFFSET = false;
     /// Masks out bits reserved for attribute tagging.
     static constexpr u64 ATTRIBUTE_MASK = ((1ULL << 44) - 1) << 12;
 
@@ -49,6 +64,7 @@ struct PageTable {
     /// ExtractPointer (bit 57 is cleared by the mask, so a recompiler sign-extending from it
     /// would turn negative offsets positive).
     static constexpr u64 SIGN_BIT = 43 + 12; // 44 bits of data + page offset
+#endif
 
     /**
      * Atomic tuple of host pointer, page type, and block id.
@@ -58,6 +74,19 @@ struct PageTable {
      */
     class PageEntryData {
     public:
+#ifdef EDEN_PAGE_ENTRY_FULL_OFFSET
+        struct Data {
+            Data(bool marked_, PageType type_, u16 block_, u64 page_)
+                : marked(static_cast<u64>(marked_) & 0b1)
+                , type(static_cast<u64>(type_) & ((1ULL << 2) - 1))
+                , block(static_cast<u64>(block_) & ((1ULL << 9) - 1))
+                , page(page_ >> 12) {}
+            u64 marked : 1;
+            u64 type   : 2;
+            u64 block  : 9;
+            u64 page   : 52; // bits 12-63 of the offset, its sign included
+        };
+#else
         struct Data {
             Data(bool marked_, PageType type_, u16 block_, u64 page_)
                 : marked(static_cast<u64>(marked_)       & 0b1)
@@ -71,6 +100,7 @@ struct PageTable {
             u64 page   : 45; // 44 bits of actual data (64 - page offset (12) - reserved (8)) + a sign bit
             u64 block2 : 7;
         };
+#endif
 
         [[nodiscard]] Data Raw() const noexcept {
             return std::bit_cast<Data>(data_raw.load(std::memory_order_relaxed));
@@ -112,13 +142,21 @@ struct PageTable {
 
         /// Unpack a pointer from a page info raw representation
         [[nodiscard]] static uintptr_t ExtractPointer(Data raw, bool ignore_marked = false) noexcept {
+#ifdef EDEN_PAGE_ENTRY_FULL_OFFSET
+            return raw.marked && !ignore_marked ? 0 : static_cast<uintptr_t>(u64{raw.page} << 12);
+#else
             return raw.marked && !ignore_marked ? 0
                 // shift raw.page's fake sign bit to the actual sign bit, then sign extend
                 : ((s64)(raw.page << (64 - 44))) >> (64 - 44 - 12);
+#endif
         }
 
         [[nodiscard]] static u16 ExtractBlock(Data raw) noexcept {
+#ifdef EDEN_PAGE_ENTRY_FULL_OFFSET
+            return static_cast<u16>(raw.block);
+#else
             return static_cast<u16>(raw.block | (raw.block2 << 9));
+#endif
         }
 
     private:
diff --git a/src/core/arm/dynarmic/arm_dynarmic_32.cpp b/src/core/arm/dynarmic/arm_dynarmic_32.cpp
index 7df3138af..4182d87f2 100644
--- a/src/core/arm/dynarmic/arm_dynarmic_32.cpp
+++ b/src/core/arm/dynarmic/arm_dynarmic_32.cpp
@@ -187,7 +187,7 @@ void ArmDynarmic32::MakeJit(Common::PageTable* page_table) {
         config.fastmem_exclusive_access = config.fastmem_pointer  != std::nullopt;
         config.recompile_on_exclusive_fastmem_failure = true;
 
-        if (reinterpret_cast<u64>(m_system.DeviceMemory().buffer.BackingBasePointer() +
+        if (!Common::PageTable::FULL_OFFSET && reinterpret_cast<u64>(m_system.DeviceMemory().buffer.BackingBasePointer() +
             Kernel::Board::Nintendo::Nx::KSystemControl::Init::GetIntendedMemorySize()) < (1ULL << 39)) {
             // Systems like FreeBSD allocate memory really low by default, and since we pack our page table entries,
             // we have to manually sign extend when our actual pointer is negative.
diff --git a/src/core/arm/dynarmic/arm_dynarmic_64.cpp b/src/core/arm/dynarmic/arm_dynarmic_64.cpp
index 3ed79d369..e2978a368 100644
--- a/src/core/arm/dynarmic/arm_dynarmic_64.cpp
+++ b/src/core/arm/dynarmic/arm_dynarmic_64.cpp
@@ -231,7 +231,7 @@ void ArmDynarmic64::MakeJit(Common::PageTable* page_table, std::size_t address_s
         config.fastmem_exclusive_access = config.fastmem_pointer != std::nullopt;
         config.recompile_on_exclusive_fastmem_failure = true;
 
-        if (reinterpret_cast<u64>(m_system.DeviceMemory().buffer.BackingBasePointer() +
+        if (!Common::PageTable::FULL_OFFSET && reinterpret_cast<u64>(m_system.DeviceMemory().buffer.BackingBasePointer() +
             Kernel::Board::Nintendo::Nx::KSystemControl::Init::GetIntendedMemorySize()) < (1ULL << 39)) {
             // Systems like FreeBSD allocate memory really low by default, and since we pack our page table entries,
             // we have to manually sign extend when our actual pointer is negative.
-- 
2.43.0

