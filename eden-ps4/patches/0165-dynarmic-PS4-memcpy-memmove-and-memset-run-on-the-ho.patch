--- /dev/null
+++ b/src/core/arm/dynarmic/native_functions.h
@@ -0,0 +1,164 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// (PS4 04.75) memcpy, memmove and memset run on the host instead of translated (dynarmic's
+// UserConfig::native_functions, A64 and A32): where the process's modules define them, and the
+// copies themselves.
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "common/common_funcs.h"
+#include "common/common_types.h"
+#include "common/elf.h"
+#include "common/logging.h"
+#include "core/arm/debug.h"
+#include "core/memory.h"
+
+namespace Core::NativeFunctions {
+
+using Table = std::vector<std::pair<u64, int>>;  // (address, 1 memcpy / 2 memmove / 3 memset)
+
+inline int Kind(const Table& table, u64 vaddr) {
+    for (const auto& [address, kind] : table)
+        if (address == vaddr)
+            return kind;
+    return 0;
+}
+
+// The functions as the process's modules define them (the SDK's, a static libc's): from each
+// module's dynamic symbol table, read in bulk (a game's can be large). Read once, at the first block
+// a core translates: the modules are all loaded by then. 32-bit: also the ARM EABI's
+// __aeabi_memcpy/__aeabi_memmove (and their 4- and 8-aligned forms: the same arguments); a Thumb
+// function's address without its bit 0 (as the JIT's location has it).
+template <typename Sym, typename Dyn>
+inline void FindIn(Core::Memory::Memory& memory, u64 base, std::string_view module_name, bool is_64, Table& found) {
+    using namespace Common::ELF;
+    struct {
+        u32 version, header_offset, version_offset;
+    } loc{};
+    struct {
+        u32 signature, dynamic_offset;
+    } hdr{};
+    if (!memory.ReadBlock(base, &loc, sizeof(loc)) || !memory.ReadBlock(base + loc.header_offset, &hdr, sizeof(hdr)) ||
+        hdr.signature != Common::MakeMagic('M', 'O', 'D', '0'))
+        return;
+    u64 symtab = 0, strtab = 0, strsz = 0, syment = sizeof(Sym);
+    u64 dyn = base + loc.header_offset + hdr.dynamic_offset;
+    for (int i = 0; i < 256; i++, dyn += sizeof(Dyn)) {
+        Dyn d{};
+        if (!memory.ReadBlock(dyn, &d, sizeof(d)) || d.d_tag == ElfDtNull)
+            break;
+        if (d.d_tag == ElfDtSymtab)
+            symtab = d.d_un.d_ptr;
+        else if (d.d_tag == ElfDtStrtab)
+            strtab = d.d_un.d_ptr;
+        else if (d.d_tag == ElfDtStrsz)
+            strsz = d.d_un.d_val;
+        else if (d.d_tag == ElfDtSyment)
+            syment = d.d_un.d_val;
+    }
+    // (the symbols run up to the strings, as Core::Symbols reads them)
+    if (symtab == 0 || strtab <= symtab || strsz == 0 || syment < sizeof(Sym) || strtab - symtab > (u64(64) << 20) ||
+        strsz > (u64(64) << 20))
+        return;
+    std::vector<u8> symbols(strtab - symtab);
+    std::vector<char> strings(strsz + 1, '\0');
+    if (!memory.ReadBlock(base + symtab, symbols.data(), symbols.size()) ||
+        !memory.ReadBlock(base + strtab, strings.data(), strsz))
+        return;
+    for (u64 at = 0; at + sizeof(Sym) <= symbols.size(); at += syment) {
+        Sym symbol;
+        std::memcpy(&symbol, symbols.data() + at, sizeof(symbol));
+        // (defined functions only: an import has no section and no value)
+        if (symbol.st_value == 0 || symbol.st_shndx == 0 || symbol.st_name >= strsz || (symbol.st_info & 0xf) != 2)
+            continue;
+        const std::string_view name{strings.data() + symbol.st_name};
+        int kind = name == "memcpy" ? 1 : name == "memmove" ? 2 : name == "memset" ? 3 : 0;
+        if (!is_64 && kind == 0) {
+            if (name == "__aeabi_memcpy" || name == "__aeabi_memcpy4" || name == "__aeabi_memcpy8")
+                kind = 1;
+            else if (name == "__aeabi_memmove" || name == "__aeabi_memmove4" || name == "__aeabi_memmove8")
+                kind = 2;
+        }
+        if (kind != 0) {
+            const u64 address = base + (u64(symbol.st_value) & (is_64 ? ~u64(0) : ~u64(1)));
+            found.emplace_back(address, kind);
+            LOG_INFO(Core_ARM, "native {} at {:#x} ({})", name, address, module_name);
+        }
+    }
+}
+
+inline Table Find(Kernel::KProcess* process, Core::Memory::Memory& memory, bool is_64) {
+    Table found;
+    for (const auto& [base, module_name] : Core::FindModules(process)) {
+        if (is_64)
+            FindIn<Common::ELF::Elf64_Sym, Common::ELF::Elf64_Dyn>(memory, base, module_name, true, found);
+        else
+            FindIn<Common::ELF::Elf32_Sym, Common::ELF::Elf32_Dyn>(memory, base, module_name, false, found);
+    }
+    return found;
+}
+
+// Plain memory (its page table entry has a host pointer) is read and written directly, a page at a
+// time; anything else (memory the GPU caches, which needs its notifications; unmapped) through
+// ReadBlock, WriteBlock and CopyBlock, as the guest's own loads and stores would be. memmove's result
+// (memcpy's too, whose overlap is undefined).
+inline void Move(Core::Memory::Memory& memory, u64 dest, u64 src, u64 n) {
+    using Core::Memory::YUZU_PAGEMASK;
+    using Core::Memory::YUZU_PAGESIZE;
+    if (n == 0 || dest == src)
+        return;
+    if ((src & YUZU_PAGEMASK) + n <= YUZU_PAGESIZE && (dest & YUZU_PAGEMASK) + n <= YUZU_PAGESIZE) {
+        u8* const to = memory.GetPlainPointer(dest);
+        const u8* const from = memory.GetPlainPointer(src);
+        if (to && from) {
+            std::memmove(to, from, n);
+            return;
+        }
+    }
+    if (dest < src + n && src < dest + n) {
+        // overlapping, across pages: through a copy
+        std::vector<u8> buffer(n);
+        memory.ReadBlock(src, buffer.data(), n);
+        memory.WriteBlock(dest, buffer.data(), n);
+        return;
+    }
+    for (u64 done = 0; done < n;) {
+        const u64 from_addr = src + done, to_addr = dest + done;
+        const u64 chunk =
+            (std::min)({n - done, YUZU_PAGESIZE - (from_addr & YUZU_PAGEMASK), YUZU_PAGESIZE - (to_addr & YUZU_PAGEMASK)});
+        u8* const to = memory.GetPlainPointer(to_addr);
+        const u8* const from = memory.GetPlainPointer(from_addr);
+        if (to && from)
+            std::memcpy(to, from, chunk);
+        else
+            memory.CopyBlock(to_addr, from_addr, chunk);
+        done += chunk;
+    }
+}
+
+inline void Fill(Core::Memory::Memory& memory, u64 dest, u8 c, u64 n) {
+    using Core::Memory::YUZU_PAGEMASK;
+    using Core::Memory::YUZU_PAGESIZE;
+    for (u64 done = 0; done < n;) {
+        const u64 to_addr = dest + done;
+        const u64 chunk = (std::min)(n - done, YUZU_PAGESIZE - (to_addr & YUZU_PAGEMASK));
+        if (u8* const to = memory.GetPlainPointer(to_addr)) {
+            std::memset(to, c, chunk);
+        } else {
+            std::array<u8, YUZU_PAGESIZE> fill;
+            fill.fill(c);
+            memory.WriteBlock(to_addr, fill.data(), chunk);
+        }
+        done += chunk;
+    }
+}
+
+} // namespace Core::NativeFunctions
