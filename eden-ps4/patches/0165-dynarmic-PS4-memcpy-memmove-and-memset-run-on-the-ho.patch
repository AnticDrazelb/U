+void A32EmitX64::EmitA32CallNative(A32EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const u8 kind = args[0].GetImmediateU8();
+    ctx.reg_alloc.HostCall(code, inst, {}, args[1], args[2], args[3]);
+    switch (kind) {
+    case 1:
+        Devirtualize<&A32::UserCallbacks::NativeMemcpy>(conf.callbacks).EmitCall(code);
+        break;
+    case 2:
+        Devirtualize<&A32::UserCallbacks::NativeMemmove>(conf.callbacks).EmitCall(code);
+        break;
+    default:
+        Devirtualize<&A32::UserCallbacks::NativeMemset>(conf.callbacks).EmitCall(code);
+        break;
+    }
+}
