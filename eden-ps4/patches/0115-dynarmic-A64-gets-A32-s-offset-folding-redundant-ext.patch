+// (PS4 04.22) A folded address made whole: A32's wraps at 32 bits, A64's doesn't
+[[maybe_unused]] static void EmitWholeAddress(BlockOfCode& code, Xbyak::Reg64 dst, Xbyak::Reg64 base, u32 disp) {
+#ifdef AXX_ADDRESS_64
+    code.lea(dst, code.ptr[base + disp]);
+#else
+    code.lea(dst.cvt32(), code.ptr[base + disp]);
+#endif
+}
