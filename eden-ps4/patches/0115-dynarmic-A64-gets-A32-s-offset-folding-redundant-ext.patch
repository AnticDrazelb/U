+void A64EmitX64::FoldAddressOffsets(A64EmitContext& ctx, IR::Block& block) {
+    folded_disp.clear();
+    if (conf.skip_redundant_extensions) {
+        for (auto& inst : block.instructions) {
+            switch (inst.GetOpcode()) {
+            case IR::Opcode::ZeroExtendByteToWord:
+            case IR::Opcode::ZeroExtendHalfToWord:
+            case IR::Opcode::ZeroExtendByteToLong:
+            case IR::Opcode::ZeroExtendHalfToLong: {
+                // a byte or halfword just loaded is zero-extended in its register already (movzx,
+                // the fallbacks' ZeroExtendFrom, the walks' movzx)
+                const IR::Value arg = inst.GetArg(0);
+                if (arg.IsImmediate())
+                    break;
+                const auto op = arg.GetInst()->GetOpcode();
+                if (op == IR::Opcode::A64ReadMemory8 || op == IR::Opcode::A64ReadMemory16)
+                    inst.ReplaceUsesWith(arg);
+                break;
+            }
+            case IR::Opcode::A64WriteMemory8:
+            case IR::Opcode::A64WriteMemory16: {
+                // stored from the wider value's register (the store writes its low 8 or 16 bits)
+                const IR::Value value = inst.GetArg(2);
+                if (value.IsImmediate())
+                    break;
+                IR::Inst* const narrow = value.GetInst();
+                const auto want = inst.GetOpcode() == IR::Opcode::A64WriteMemory8 ? IR::Opcode::LeastSignificantByte : IR::Opcode::LeastSignificantHalf;
+                if (narrow->GetOpcode() == want && narrow->UseCount() == 1 && !narrow->GetArg(0).IsImmediate()) {
+                    inst.SetArg(2, narrow->GetArg(0));
+                    narrow->Invalidate();
+                }
+                break;
+            }
+            default:
+                break;
+            }
+        }
+    }
+    // With fastmem, its range checked (not mirrored): a plain access (not ordered) through
+    // Add64(base, 1..65535) used by it alone takes the constant in its displacement; the
+    // Add64 goes. 128-bit accesses aren't folded (their fallbacks are xmm-based: untested here).
+    if (!conf.fastmem_pointer || !conf.fold_address_offsets || conf.silently_mirror_fastmem ||
+        conf.fastmem_address_space_bits >= 64)
+        return;
+    for (auto& inst : block.instructions) {
+        size_t acc_arg;
+        switch (inst.GetOpcode()) {
+        case IR::Opcode::A64ReadMemory8:
+        case IR::Opcode::A64ReadMemory16:
+        case IR::Opcode::A64ReadMemory32:
+        case IR::Opcode::A64ReadMemory64:
+            acc_arg = 2;
+            break;
+        case IR::Opcode::A64WriteMemory8:
+        case IR::Opcode::A64WriteMemory16:
+        case IR::Opcode::A64WriteMemory32:
+        case IR::Opcode::A64WriteMemory64:
+            acc_arg = 3;
+            break;
+        default:
+            continue;
+        }
+        if (folded_disp.size() == folded_disp.capacity())
+            break;
+        const IR::Value address = inst.GetArg(1);
+        const IR::AccType acc = inst.GetArg(acc_arg).GetAccType();
+        if (address.IsImmediate() || acc == IR::AccType::ORDERED || acc == IR::AccType::ORDEREDRW || acc == IR::AccType::LIMITEDORDERED)
+            continue;
+        IR::Inst* const add = address.GetInst();
+        if (add->GetOpcode() != IR::Opcode::Add64 || add->UseCount() != 1)
+            continue;
+        const IR::Value carry = add->GetArg(2), offset = add->GetArg(1);
+        if (!carry.IsImmediate() || carry.GetU1() || !offset.IsImmediate() || add->GetArg(0).IsImmediate())
+            continue;
+        const u64 disp = offset.GetU64();
+        if (disp == 0 || disp > 0xFFFF || !ShouldFastmem(ctx, &inst))
+            continue;
+        inst.SetArg(1, add->GetArg(0));
+        add->Invalidate();
+        folded_disp.emplace_back(&inst, u32(disp));
+    }
+}
