+/// A frontend's own log output. Called for every message that passes the filter, on the thread
+/// that logged it: `message` is the message alone, `line` the formatted log line (no newline).
+using Callback = void (*)(Class log_class, Level level, std::string_view message, std::string_view line);
+void SetCallback(Callback callback);
+
 } // namespace Common::Log
