+// (PS4 04.26) A 32- or 64-bit plain load into an XMM (its other lanes zeroed)
+template<std::size_t bitsize>
+const void* EmitReadMemoryMovXmm(BlockOfCode& code, int value_idx, const Xbyak::RegExp& addr) {
+    static_assert(bitsize == 32 || bitsize == 64);
+    const void* fastmem_location = code.getCurr();
+    if constexpr (bitsize == 32) {
+        code.movd(Xbyak::Xmm(value_idx), dword[addr]);
+    } else {
+        code.movq(Xbyak::Xmm(value_idx), qword[addr]);
+    }
+    return fastmem_location;
+}
