-void A64EmitX64::PeepholeQuad(IR::Block& block) {
+void A64EmitX64::PeepholeQuad(A64EmitContext& ctx, IR::Block& block) {
+    xmm_loads.clear();
     for (auto& inst : block.instructions) {
         // (movsxd reads the low 32 bits alone: no zero-extension of them first, SXTW, SMULL)
         if (inst.GetOpcode() == IR::Opcode::SignExtendWordToLong && !inst.GetArg(0).IsImmediate()) {
@@ -390,6 +391,23 @@ void A64EmitX64::PeepholeQuad(IR::Block& block) {
         if (widen->UseCount() == 0)
             widen->Invalidate();
     }
+    // (PS4 04.26) LDR S/D (a load widened to a quad, nothing else using it), with fastmem: loaded
+    // straight into an XMM
+    if (!conf.fastmem_pointer)
+        return;
+    for (auto& inst : block.instructions) {
+        if (inst.GetOpcode() != IR::Opcode::ZeroExtendLongToQuad || inst.GetArg(0).IsImmediate())
+            continue;
+        IR::Inst* const load = inst.GetArg(0).GetInst();
+        const auto op = load->GetOpcode();
+        if ((op != IR::Opcode::A64ReadMemory32 && op != IR::Opcode::A64ReadMemory64) || load->UseCount() != 1)
+            continue;
+        const auto acc = load->GetArg(2).GetAccType();
+        if (acc != IR::AccType::NORMAL && acc != IR::AccType::VEC)
+            continue;
+        if (ShouldFastmem(ctx, load))
+            xmm_loads.push_back(load);
+    }
 }
 
