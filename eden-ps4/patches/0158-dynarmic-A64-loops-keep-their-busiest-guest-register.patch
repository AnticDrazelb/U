+    // (PS4 04.73) back from a leaf function the block followed a BL into: on in the block, at the
+    // address the BL left in X30; its return stack entry dropped (the pop this was)
+    if (Rn == Reg::R30 && options.follow_known_returns && options.follow_direct_branches) {
+        if (const auto ret = KnownLinkRegister(); ret && Follow(*ret)) {
+            for (auto it = ir.block.instructions.begin(); it != ir.block.instructions.end(); ++it) {
+                // (the last push of that address)
+                if (it->GetOpcode() == IR::Opcode::PushRSB &&
+                    A64::LocationDescriptor{IR::LocationDescriptor{it->GetArg(0).GetU64()}}.PC() == *ret) {
+                    auto last = it;
+                    for (auto jt = std::next(it); jt != ir.block.instructions.end(); ++jt)
+                        if (jt->GetOpcode() == IR::Opcode::PushRSB &&
+                            A64::LocationDescriptor{IR::LocationDescriptor{jt->GetArg(0).GetU64()}}.PC() == *ret)
+                            last = jt;
+                    last->Invalidate();
+                    break;
+                }
+            }
+            return true;
+        }
+    }
     const auto target = X(64, Rn);
 
     ir.SetPC(target);
