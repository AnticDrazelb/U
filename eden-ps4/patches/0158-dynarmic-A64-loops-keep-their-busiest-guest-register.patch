@@ -787,6 +945,20 @@ void A64EmitX64::EmitA64SetNZCV(A64EmitContext& ctx, IR::Inst* inst) {
 
 void A64EmitX64::EmitA64GetW(A64EmitContext& ctx, IR::Inst* inst) {
     const A64::Reg reg = inst->GetArg(0).GetA64RegRef();
+    if (const auto pinned = PinnedGuestReg(size_t(reg))) {
+        // (PS4 04.73) in its loop's host register
+        if (SignedLoadBits(inst) == 64) {
+            const Xbyak::Reg64 wide = ctx.reg_alloc.ScratchGpr(code);
+            code.movsxd(wide, pinned->cvt32());
+            ctx.reg_alloc.DefineValue(code, inst, wide);
+            ctx.reg_alloc.WidenValue(inst, 64);
+            return;
+        }
+        const Xbyak::Reg32 result = ctx.reg_alloc.ScratchGpr(code).cvt32();
+        code.mov(result, pinned->cvt32());
+        ctx.reg_alloc.DefineValue(code, inst, result);
+        return;
+    }
     if (SignedLoadBits(inst) == 64) {
         // (PS4 04.26, PeepholeQuad: read for a SignExtendWordToLong alone) sign-extended as read
         const Xbyak::Reg64 wide = ctx.reg_alloc.ScratchGpr(code);
@@ -804,6 +976,11 @@ void A64EmitX64::EmitA64GetW(A64EmitContext& ctx, IR::Inst* inst) {
 void A64EmitX64::EmitA64GetX(A64EmitContext& ctx, IR::Inst* inst) {
     const A64::Reg reg = inst->GetArg(0).GetA64RegRef();
     const Xbyak::Reg64 result = ctx.reg_alloc.ScratchGpr(code);
+    if (const auto pinned = PinnedGuestReg(size_t(reg))) {
+        code.mov(result, *pinned);  // (PS4 04.73) in its loop's host register
+        ctx.reg_alloc.DefineValue(code, inst, result);
+        return;
+    }
 
     code.mov(result, qword[code.ABI_JIT_PTR + offsetof(A64JitState, reg) + sizeof(u64) * static_cast<size_t>(reg)]);
     ctx.reg_alloc.DefineValue(code, inst, result);
@@ -838,6 +1015,11 @@ void A64EmitX64::EmitA64GetQ(A64EmitContext& ctx, IR::Inst* inst) {
 
 void A64EmitX64::EmitA64GetSP(A64EmitContext& ctx, IR::Inst* inst) {
     const Xbyak::Reg64 result = ctx.reg_alloc.ScratchGpr(code);
+    if (const auto pinned = PinnedGuestReg(32)) {
+        code.mov(result, *pinned);  // (PS4 04.73) in its loop's host register
+        ctx.reg_alloc.DefineValue(code, inst, result);
+        return;
+    }
     code.mov(result, qword[code.ABI_JIT_PTR + offsetof(A64JitState, sp)]);
     ctx.reg_alloc.DefineValue(code, inst, result);
 }
@@ -862,6 +1044,14 @@ void A64EmitX64::EmitA64GetFPSR(A64EmitContext& ctx, IR::Inst* inst) {
 void A64EmitX64::EmitA64SetW(A64EmitContext& ctx, IR::Inst* inst) {
     auto args = ctx.reg_alloc.GetArgumentInfo(inst);
     const A64::Reg reg = inst->GetArg(0).GetA64RegRef();
+    if (const auto pinned = PinnedGuestReg(size_t(reg))) {
+        // (PS4 04.73) into its loop's host register (a 32-bit move clears the upper half)
+        if (args[1].IsImmediate())
+            code.mov(pinned->cvt32(), args[1].GetImmediateU32());
+        else
+            code.mov(pinned->cvt32(), ctx.reg_alloc.UseGpr(code, args[1]).cvt32());
+        return;
+    }
     const auto addr = qword[code.ABI_JIT_PTR + offsetof(A64JitState, reg) + sizeof(u64) * static_cast<size_t>(reg)];
     if (args[1].FitsInImmediateS32()) {
         code.mov(addr, args[1].GetImmediateS32());
@@ -887,6 +1077,16 @@ void A64EmitX64::EmitA64SetW(A64EmitContext& ctx, IR::Inst* inst) {
 void A64EmitX64::EmitA64SetX(A64EmitContext& ctx, IR::Inst* inst) {
     auto args = ctx.reg_alloc.GetArgumentInfo(inst);
     const A64::Reg reg = inst->GetArg(0).GetA64RegRef();
+    if (const auto pinned = PinnedGuestReg(size_t(reg))) {
+        // (PS4 04.73) into its loop's host register
+        if (args[1].IsImmediate())
+            code.mov(*pinned, args[1].GetImmediateU64());
+        else if (args[1].IsInXmm(ctx.reg_alloc))
+            code.movq(*pinned, ctx.reg_alloc.UseXmm(code, args[1]));
+        else
+            code.mov(*pinned, ctx.reg_alloc.UseGpr(code, args[1]));
+        return;
+    }
     const auto addr = qword[code.ABI_JIT_PTR + offsetof(A64JitState, reg) + sizeof(u64) * static_cast<size_t>(reg)];
     if (args[1].FitsInImmediateS32()) {
         code.mov(addr, args[1].GetImmediateS32());
@@ -933,6 +1133,16 @@ void A64EmitX64::EmitA64SetQ(A64EmitContext& ctx, IR::Inst* inst) {
 
 void A64EmitX64::EmitA64SetSP(A64EmitContext& ctx, IR::Inst* inst) {
     auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    if (const auto pinned = PinnedGuestReg(32)) {
+        // (PS4 04.73) into its loop's host register
+        if (args[0].IsImmediate())
+            code.mov(*pinned, args[0].GetImmediateU64());
+        else if (args[0].IsInXmm(ctx.reg_alloc))
+            code.movq(*pinned, ctx.reg_alloc.UseXmm(code, args[0]));
+        else
+            code.mov(*pinned, ctx.reg_alloc.UseGpr(code, args[0]));
+        return;
+    }
     const auto addr = qword[code.ABI_JIT_PTR + offsetof(A64JitState, sp)];
     if (args[0].FitsInImmediateS32()) {
         code.mov(addr, args[0].GetImmediateS32());
@@ -1304,6 +1514,8 @@ bool EmitTerminalImpl(A64EmitX64& e, IR::Term::CheckHalt terminal, IR::LocationD
 }
 
 bool A64EmitX64::EmitLeafTerminal(IR::Term::LeafTerminal const& terminal, IR::LocationDescriptor initial_location, bool is_single_step) noexcept {
+    if (loop_pins.active)
+        EmitLoopPinsLeaf(terminal, initial_location, is_single_step);
     if (auto const x = std::get_if<IR::Term::ReturnToDispatch>(&terminal))
         return EmitTerminalImpl(*this, *x, initial_location, is_single_step);
     if (auto const x = std::get_if<IR::Term::LinkBlock>(&terminal))
diff --git a/src/dynarmic/src/dynarmic/backend/x64/a64_emit_x64.h b/src/dynarmic/src/dynarmic/backend/x64/a64_emit_x64.h
index 7122ec77b3..93d38cb309 100644
--- a/src/dynarmic/src/dynarmic/backend/x64/a64_emit_x64.h
+++ b/src/dynarmic/src/dynarmic/backend/x64/a64_emit_x64.h
@@ -110,6 +110,24 @@ public:
     /// word loaded into a vector register comes: ZeroExtendLongToQuad(w) (one movd or insertps)
     void PeepholeQuad(A64EmitContext& ctx, IR::Block& block);
     void EmitSideExitLink(A64EmitContext& ctx, Xbyak::Label& taken, IR::LocationDescriptor target);
+    /// (PS4 04.73, loop_register_pins) The loop's pinned guest registers: guest index (0-30 an X
+    /// register, 32 SP), its host register (rbx, rbp, r12: callee-saved, out of the allocator's
+    /// set), whether the block writes it (stored back at each exit); `head`: past the loads, where
