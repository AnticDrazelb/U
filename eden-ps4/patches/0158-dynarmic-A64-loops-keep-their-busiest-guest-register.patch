+std::optional<u64> TranslatorVisitor::KnownLinkRegister() const {
+    std::optional<u64> value;
+    for (const auto& inst : ir.block.instructions) {
+        const auto op = inst.GetOpcode();
+        if ((op == IR::Opcode::A64SetX || op == IR::Opcode::A64SetW) && inst.GetArg(0).GetA64RegRef() == Reg::R30) {
+            const IR::Value v = inst.GetArg(1);
