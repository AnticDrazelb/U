+// (PS4 04.73, loop_register_pins) A block whose terminal links back to its own start: the guest
+// registers it uses most (those it reads and writes, carried round the loop, first) in rbx, rbp and
+// r12 for the whole block. Not with anything that reads the guest's registers from its state, or
+// leaves the block without its terminal or a side exit (a supervisor call, an exception, a halt
+// on a memory access), or needs rbx (exclusives, ordered 128-bit accesses: cmpxchg16b)
+bool A64EmitX64::PlanLoopPins(IR::Block& block) {
+    loop_pins = LoopPins{};
+    if (!conf.loop_register_pins || conf.enable_cycle_counting || conf.jit_frame_pointer ||
+        conf.check_halt_on_memory_access || !conf.HasOptimization(OptimizationFlag::BlockLinking))
+        return false;
+    const IR::LocationDescriptor self = block.Location();
+    if (A64::LocationDescriptor{self}.SingleStepping())
+        return false;
+    bool back = false;
+    const auto leaf = [&](const IR::Term::LeafTerminal& t) {
+        if (const auto* link = std::get_if<IR::Term::LinkBlock>(&t))
+            back = back || link->next == self;
+        else if (const auto* fast = std::get_if<IR::Term::LinkBlockFast>(&t))
+            back = back || fast->next == self;
+    };
+    if (const auto* x = std::get_if<IR::Term::LeafTerminal>(&block.terminal)) {
+        leaf(*x);
+    } else if (const auto* x = std::get_if<IR::Term::If>(&block.terminal)) {
+        leaf(x->then_);
+        leaf(x->else_);
+    } else if (const auto* x = std::get_if<IR::Term::CheckBit>(&block.terminal)) {
+        leaf(x->then_);
+        leaf(x->else_);
+    } else {
+        return false;  // (CheckHalt: its way out skips the stores)
+    }
+    if (!back)
+        return false;
+    std::array<u16, 33> reads{}, writes{};
+    for (const auto& inst : block.instructions) {
+        switch (inst.GetOpcode()) {
+        case IR::Opcode::A64CallSupervisor:
+        case IR::Opcode::A64ExceptionRaised:
+        case IR::Opcode::A64DataCacheOperationRaised:
+        case IR::Opcode::A64InstructionCacheOperationRaised:
+        case IR::Opcode::A64InstructionSynchronizationBarrier:
+        case IR::Opcode::A64ClearExclusive:
+        case IR::Opcode::A64SetPC:
+        case IR::Opcode::A64SetFPCR:
+        case IR::Opcode::A64ExclusiveReadMemory8:
+        case IR::Opcode::A64ExclusiveReadMemory16:
+        case IR::Opcode::A64ExclusiveReadMemory32:
+        case IR::Opcode::A64ExclusiveReadMemory64:
+        case IR::Opcode::A64ExclusiveReadMemory128:
+        case IR::Opcode::A64ExclusiveWriteMemory8:
+        case IR::Opcode::A64ExclusiveWriteMemory16:
+        case IR::Opcode::A64ExclusiveWriteMemory32:
+        case IR::Opcode::A64ExclusiveWriteMemory64:
+        case IR::Opcode::A64ExclusiveWriteMemory128:
+            return false;
+        case IR::Opcode::A64ReadMemory128:
+            if (const IR::AccType acc = inst.GetArg(2).GetAccType();
+                acc == IR::AccType::ORDERED || acc == IR::AccType::ORDEREDRW || acc == IR::AccType::LIMITEDORDERED)
+                return false;
+            break;
+        case IR::Opcode::A64WriteMemory128:
+            if (const IR::AccType acc = inst.GetArg(3).GetAccType();
+                acc == IR::AccType::ORDERED || acc == IR::AccType::ORDEREDRW || acc == IR::AccType::LIMITEDORDERED)
+                return false;
+            break;
+        case IR::Opcode::A64GetW:
+        case IR::Opcode::A64GetX:
+            if (const size_t r = size_t(inst.GetArg(0).GetA64RegRef()); r < 31)
+                reads[r]++;
+            break;
+        case IR::Opcode::A64SetW:
+        case IR::Opcode::A64SetX:
+            if (const size_t r = size_t(inst.GetArg(0).GetA64RegRef()); r < 31)
+                writes[r]++;
+            break;
+        case IR::Opcode::A64GetSP:
+            reads[32]++;
+            break;
+        case IR::Opcode::A64SetSP:
+            writes[32]++;
+            break;
+        default:
+            break;
+        }
+    }
+    // the busiest, those carried round the loop (read and written) first
+    std::array<u8, 33> order{};
+    for (size_t i = 0; i < order.size(); i++)
+        order[i] = u8(i);
+    const auto score = [&](size_t g) {
+        return (reads[g] && writes[g] ? 1000 : 0) + reads[g] + writes[g];
+    };
+    std::stable_sort(order.begin(), order.end(), [&](u8 a, u8 b) { return score(a) > score(b); });
+    constexpr std::array<HostLoc, 3> hosts{HostLoc::RBX, HostLoc::RBP, HostLoc::R12};
+    for (size_t i = 0; i < order.size() && loop_pins.count < hosts.size(); i++) {
+        const size_t g = order[i];
+        if (score(g) == 0)
+            break;
+        loop_pins.guest[loop_pins.count] = u8(g);
+        loop_pins.host[loop_pins.count] = hosts[loop_pins.count];
+        loop_pins.written[loop_pins.count] = writes[g] != 0;
+        loop_pins.count++;
+    }
+    if (loop_pins.count == 0)
+        return false;
+    loop_pins.active = true;
+    loop_pins.self = self;
+    return true;
+}
+
+std::optional<Xbyak::Reg64> A64EmitX64::PinnedGuestReg(size_t guest_index) const {
+    if (!loop_pins.active)
+        return std::nullopt;
+    for (size_t i = 0; i < loop_pins.count; i++)
+        if (loop_pins.guest[i] == guest_index)
+            return HostLocToReg64(loop_pins.host[i]);
+    return std::nullopt;
+}
+
+void A64EmitX64::EmitLoopPinsStore() {
+    for (size_t i = 0; i < loop_pins.count; i++) {
+        if (!loop_pins.written[i])
+            continue;
+        const size_t g = loop_pins.guest[i];
+        code.mov(qword[code.ABI_JIT_PTR + (g == 32 ? offsetof(A64JitState, sp) : offsetof(A64JitState, reg) + sizeof(u64) * g)],
+                 HostLocToReg64(loop_pins.host[i]));
+    }
+}
+
+// The way back to the block's start: no halt, straight past the loads; else (and at every other
+// exit) the written registers stored, then the leaf as usual
+bool A64EmitX64::EmitLoopPinsLeaf(IR::Term::LeafTerminal const& terminal, IR::LocationDescriptor, bool is_single_step) {
+    bool back = false;
+    if (const auto* link = std::get_if<IR::Term::LinkBlock>(&terminal))
+        back = link->next == loop_pins.self;
+    else if (const auto* fast = std::get_if<IR::Term::LinkBlockFast>(&terminal))
+        back = fast->next == loop_pins.self;
+    if (back && !is_single_step) {
+        code.cmp(dword[code.ABI_JIT_PTR + offsetof(A64JitState, halt_reason)], 0);
+        code.jz(loop_pins.head);
+    }
+    EmitLoopPinsStore();
+    return false;
+}
+
