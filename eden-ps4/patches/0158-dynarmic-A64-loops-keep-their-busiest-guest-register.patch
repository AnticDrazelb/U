+    struct LoopPins {
+        bool active = false;
+        size_t count = 0;
+        std::array<u8, 3> guest{};
+        std::array<HostLoc, 3> host{};
+        std::array<bool, 3> written{};
+        const void* head = nullptr;
+        IR::LocationDescriptor self{0};
+    } loop_pins;
+    bool PlanLoopPins(IR::Block& block);
+    std::optional<Xbyak::Reg64> PinnedGuestReg(size_t guest_index) const;
+    void EmitLoopPinsStore();
+    /// The leaf terminal as a pinned loop leaves it (or jumps back): true if it emitted it
+    bool EmitLoopPinsLeaf(IR::Term::LeafTerminal const& terminal, IR::LocationDescriptor initial_location, bool is_single_step);
     u64 RSBEntryFor(IR::LocationDescriptor target) const override;
     FakeCall FastmemCallback(u64 rip);
 
