diff --git a/src/dynarmic/src/dynarmic/backend/x64/emit_x64.h b/src/dynarmic/src/dynarmic/backend/x64/emit_x64.h
index 444886bad1..1e6bfa0f73 100644
--- a/src/dynarmic/src/dynarmic/backend/x64/emit_x64.h
+++ b/src/dynarmic/src/dynarmic/backend/x64/emit_x64.h
@@ -120,6 +120,41 @@ public:
     // constant folded into the access (A32EmitX64::FoldAddressOffsets): [r13 + base + disp] with
     // fastmem, the address rebuilt where it is needed whole (a fault's fallback, a walk)
     boost::container::small_vector<std::pair<const IR::Inst*, u32>, 32> folded_disp;
+    // (PS4 04.73, fastmem_range_check_reuse) for a fastmem access through a base value: whether
+    // an earlier access of the block checked that base already (skip its check), and else the
+    // offset to check it against (the largest any of the block's fastmem accesses through it uses)
+    boost::container::small_vector<std::pair<const IR::Inst*, u32>, 16> range_dmax;
+    boost::container::small_vector<const IR::Inst*, 16> range_checked;
+    // Only the stack pointer, or the stack pointer plus a constant under 64 KiB (a local's address):
+    // never a wild pointer in a working game. (Any base saves ~6% more of IL2CPP-like code, but a
+    // wild pointer used twice in a block, after its first access's check failed, would reach the
+    // host's memory past the arena's no-access room: the desktop test found one.)
+    static bool IsStackBase(const IR::Inst* base) {
+        if (base->GetOpcode() == IR::Opcode::A64GetSP)
+            return true;
+        if (base->GetOpcode() != IR::Opcode::Add64)
+            return false;
+        const IR::Value a = base->GetArg(0), b = base->GetArg(1);
+        return !a.IsImmediate() && a.GetInst()->GetOpcode() == IR::Opcode::A64GetSP && b.IsImmediate() &&
+               b.GetU64() < 0x10000;
+    }
+    std::pair<bool, u32> RangeCheckPlan(const IR::Inst* inst, u32 disp) {
+        if (range_dmax.empty() || inst->GetArg(1).IsImmediate())
+            return {false, disp};
+        const IR::Inst* const base = inst->GetArg(1).GetInst();
+        if (!IsStackBase(base))
+            return {false, disp};
+        for (const IR::Inst* checked : range_checked)
+            if (checked == base)
+                return {true, disp};
+        for (const auto& [b, dmax] : range_dmax) {
+            if (b == base) {
+                range_checked.push_back(base);
+                return {false, std::max(dmax, disp)};
+            }
+        }
+        return {false, disp};
+    }
     u32 FoldedDisp(const IR::Inst* inst) const {
         for (const auto& [folded, disp] : folded_disp) {
             if (folded == inst)
