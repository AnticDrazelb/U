From 2cf899d611c3a1d90b57f131c3ba010e54c91fec Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 03:03:49 +0000
Subject: [PATCH] dynarmic A64: a block's stack accesses range checked once;
 the fastmem arena with no-access room on either side

fastmem_range_check_reuse: a block's first fastmem access through the stack pointer (or the stack
pointer plus a constant under 64 KiB, a local's address) checks it against the largest offset any of
the block's fastmem accesses through that value uses; the others skip the range check (base +
offset is then inside the arena). The arena gets 16 MiB reserved with no access before and after
it, where an unchecked access of a base that failed its check (a stack at the very top of the
address space) faults and takes the fallback. Only stack bases: with any base, a wild pointer used
twice in a block reaches the host's memory past that room (the desktop test found one), for ~6%
more of IL2CPP-like code. On the PS4 with CPU Auto and Unsafe.

Measured (dynbench64, 20 steady frames, the Jaguar's features): unity64 -3.7% instructions on top of
the extras and loop pins, game64 -0.4%. Checked: 16,000 random blocks (no cycle counting, forward
branches, every run against no optimisation), the loop tests, Little Kitty's 31 blocks.
---
 src/common/orbis_memory.cpp                   |  9 ++++-
 src/core/arm/dynarmic/arm_dynarmic_64.cpp     |  6 +++
 .../src/dynarmic/backend/x64/a64_emit_x64.cpp | 38 +++++++++++++++++++
 .../dynarmic/backend/x64/a64_interface.cpp    |  1 +
 .../src/dynarmic/backend/x64/emit_x64.h       | 35 +++++++++++++++++
 .../backend/x64/emit_x64_memory.cpp.inc       | 17 +++++++--
 .../dynarmic/backend/x64/emit_x64_memory.h    | 15 +++++---
 .../src/dynarmic/interface/A64/config.h       |  7 ++++
 8 files changed, 116 insertions(+), 12 deletions(-)

diff --git a/src/common/orbis_memory.cpp b/src/common/orbis_memory.cpp
index 5ed0d9f37e..14a2194d6e 100644
--- a/src/common/orbis_memory.cpp
+++ b/src/common/orbis_memory.cpp
@@ -219,6 +219,7 @@ std::atomic_flag arena_lock = ATOMIC_FLAG_INIT;
 constexpr size_t ArenaPage = 16_KiB;   // the PS4's page
 constexpr size_t GuestPage = 4_KiB;
 constexpr size_t MaxArenaRun = 512_KiB; // mapped at once when the pages after qualify too
+constexpr size_t ArenaGuard = 16_MiB;   // (04.73) reserved, no access, before and after the arena
 
 // The direct memory behind DRAM offset `offset` (16 KiB aligned), committing its chunk if the
 // game hasn't touched it yet; -1 if there's none
@@ -609,7 +610,11 @@ void* ReserveFastmemArena(unsigned max_bits, void* backing, size_t backing_size,
     if (!EnableAliasing())
         return nullptr;
     for (unsigned b = max_bits; b >= 32; b--) {
-        if (void* range = ReserveAboveGpu(size_t(1) << b)) {
+        // (04.73) with 16 MiB reserved (no access) on either side: an access the recompiler didn't
+        // range check (fastmem_range_check_reuse: the base checked once a block) that lands just
+        // past either end faults there and takes the fallback
+        if (void* reserved = ReserveAboveGpu((size_t(1) << b) + 2 * ArenaGuard)) {
+            void* const range = static_cast<char*>(reserved) + ArenaGuard;
             arena.size = size_t(1) << b;
             arena.bits = b;
             arena.backing = reinterpret_cast<uintptr_t>(backing);
@@ -627,7 +632,7 @@ void* ReserveFastmemArena(unsigned max_bits, void* backing, size_t backing_size,
 void ReleaseFastmemArena() {
     const uintptr_t base = arena.base.exchange(0, std::memory_order_acq_rel);
     if (base)
-        sceKernelMunmap(reinterpret_cast<void*>(base), arena.size);
+        sceKernelMunmap(reinterpret_cast<void*>(base - ArenaGuard), arena.size + 2 * ArenaGuard);
     arena.table.store(nullptr, std::memory_order_release);
     arena.bits = 0;
 }
diff --git a/src/core/arm/dynarmic/arm_dynarmic_64.cpp b/src/core/arm/dynarmic/arm_dynarmic_64.cpp
index 5b99dcadd1..5d843dc6b4 100644
--- a/src/core/arm/dynarmic/arm_dynarmic_64.cpp
+++ b/src/core/arm/dynarmic/arm_dynarmic_64.cpp
@@ -399,6 +399,11 @@ void ArmDynarmic64::MakeJit(Common::PageTable* page_table, std::size_t address_s
     config.bitfield_shifts = true;
     // (04.73) a loop's busiest guest registers in host registers from its start to its exits
     config.loop_register_pins = true;
+#if defined(__OPENORBIS__)
+    // (04.73) a block's stack accesses range checked once (the arena has no-access room on either
+    // side: common/orbis_memory.cpp)
+    config.fastmem_range_check_reuse = true;
+#endif
     // (04.35-04.72: off with CPU Unsafe off, a switch to tell whether a game's trouble was theirs;
     // it never was: Little Kitty's was two translator bugs, fixed in 04.68 and 04.71, Captain
     // Toad's a GPU hang) (04.73) On with Auto and Unsafe again, now checked by the desktop
@@ -408,6 +413,7 @@ void ArmDynarmic64::MakeJit(Common::PageTable* page_table, std::size_t address_s
     const auto accuracy = Settings::values.cpu_accuracy.GetValue();
     if (accuracy != Settings::CpuAccuracy::Unsafe && accuracy != Settings::CpuAccuracy::Auto) {
         config.loop_register_pins = false;
+        config.fastmem_range_check_reuse = false;
         config.fold_address_offsets = false;
         config.skip_redundant_extensions = false;
         config.split_cold_code = false;
diff --git a/src/dynarmic/src/dynarmic/backend/x64/a64_emit_x64.cpp b/src/dynarmic/src/dynarmic/backend/x64/a64_emit_x64.cpp
index bf552b869d..9c52b9b664 100644
--- a/src/dynarmic/src/dynarmic/backend/x64/a64_emit_x64.cpp
+++ b/src/dynarmic/src/dynarmic/backend/x64/a64_emit_x64.cpp
@@ -122,6 +122,44 @@ A64EmitX64::BlockDescriptor A64EmitX64::Emit(IR::Block& block) noexcept {
     nzcv_stored_end = nullptr;
     host_cond_flags = HostCondFlags::None;
     FoldAddressOffsets(ctx, block);
+    // (PS4 04.73, fastmem_range_check_reuse) each base's largest offset among the block's fastmem
+    // accesses through it: its first access checks for that, the others skip the check
+    range_dmax.clear();
+    range_checked.clear();
+    if (conf.fastmem_range_check_reuse && conf.fastmem_pointer && !conf.silently_mirror_fastmem &&
+        conf.fastmem_address_space_bits < 64) {
+        for (auto& inst : block.instructions) {
+            switch (inst.GetOpcode()) {
+            case IR::Opcode::A64ReadMemory8:
+            case IR::Opcode::A64ReadMemory16:
+            case IR::Opcode::A64ReadMemory32:
+            case IR::Opcode::A64ReadMemory64:
+            case IR::Opcode::A64ReadMemory128:
+            case IR::Opcode::A64WriteMemory8:
+            case IR::Opcode::A64WriteMemory16:
+            case IR::Opcode::A64WriteMemory32:
+            case IR::Opcode::A64WriteMemory64:
+            case IR::Opcode::A64WriteMemory128: {
+                if (inst.GetArg(1).IsImmediate() || !IsStackBase(inst.GetArg(1).GetInst()) || !ShouldFastmem(ctx, &inst))
+                    break;
+                const IR::Inst* const base = inst.GetArg(1).GetInst();
+                const u32 d = FoldedDisp(&inst);
+                bool found = false;
+                for (auto& [b, dmax] : range_dmax) {
+                    if (b == base) {
+                        dmax = std::max(dmax, d);
+                        found = true;
+                    }
+                }
+                if (!found && range_dmax.size() < range_dmax.capacity())
+                    range_dmax.emplace_back(base, d);
+                break;
+            }
+            default:
+                break;
+            }
+        }
+    }
     FuseCheckBit(block);
     FuseCondFlags(block);
     PeepholeQuad(ctx, block);
