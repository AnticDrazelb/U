+                                              checked, check_disp);
 
         const void* location;
         if constexpr (bitsize == 32 || bitsize == 64) {
@@ -189,8 +192,10 @@ void AxxEmitX64::EmitMemoryRead(AxxEmitContext& ctx, IR::Inst* inst) {
     } else if (fastmem_marker) {
         // Use fastmem
         bool require_abort_handling = false;
