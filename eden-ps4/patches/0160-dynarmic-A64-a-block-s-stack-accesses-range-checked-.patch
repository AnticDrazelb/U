+                                               checked, check_disp);
 
         const void* location;
         if constexpr (bitsize == 32 || bitsize == 64) {
@@ -363,8 +371,9 @@ void AxxEmitX64::EmitMemoryWrite(AxxEmitContext& ctx, IR::Inst* inst) {
