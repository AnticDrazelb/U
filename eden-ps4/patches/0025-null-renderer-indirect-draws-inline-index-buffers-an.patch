               bool is_indexed, u32 instance_count);
 
+    /// The 3D engine's textured rectangle (NVN's DrawTexture): a texture's rectangle, scaled, into
+    /// render target 0.
+    void DrawTexture(Tegra::Engines::Maxwell3D& maxwell3d, Tegra::MemoryManager& gpu_memory);
+
     /// Something wrote to emulated memory there: textures decoded from it are checked again
     /// before they're next sampled.
     void MarkWritten(GPUVAddr address, u64 size);
