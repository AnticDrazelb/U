 }
 
+void SoftwareDraw::DrawTexture(Maxwell& maxwell3d, Tegra::MemoryManager& gpu_memory) {
+    const auto& regs = maxwell3d.regs;
+    const auto& state = maxwell3d.draw_manager.draw_texture_state;
+    const auto& rt = regs.rt[regs.rt_control.Map(0)];
+    std::array<u8, 16> probe{};
+    u32 bpp = 0;
+    if (rt.Address() == 0 || !EncodeColor(rt.format, {0, 0, 0, 0}, probe, bpp)) {
+        return;
+    }
+    if (state.src_texture > regs.tex_header.limit || state.src_sampler > regs.tex_sampler.limit) {
+        return;
+    }
+    Binding binding;
+    binding.texture = textures->Get(gpu_memory, regs.tex_header.Address() +
+                                                    u64{state.src_texture} * sizeof(Tegra::Texture::TICEntry));
+    gpu_memory.ReadBlockUnsafe(regs.tex_sampler.Address() + u64{state.src_sampler} * sizeof(Tegra::Texture::TSCEntry),
+                               &binding.sampler, sizeof(binding.sampler));
+    binding.Prepare();
+    if (!binding.texture || !binding.texture->ok) {
+        return;
+    }
+    const Level& level = binding.texture->levels[binding.texture->base_level];
+    const bool pitch_linear = rt.tile_mode.is_pitch_linear != 0;
+    const u32 width = pitch_linear ? rt.width / bpp : rt.width;
+    const u32 block_rows = 8u << rt.tile_mode.block_height;
+    const u32 block_bytes = 512u << rt.tile_mode.block_height;
+    const u64 block_row_size = u64{(width * bpp + 63) / 64} * block_bytes;
+    const s32 x0 = std::max(0, s32(std::floor(std::min(state.dst_x0, state.dst_x1))));
+    const s32 x1 = std::min(s32(width), s32(std::ceil(std::max(state.dst_x0, state.dst_x1))));
+    const s32 y0 = std::max(0, s32(std::floor(std::min(state.dst_y0, state.dst_y1))));
+    const s32 y1 = std::min(s32(rt.height), s32(std::ceil(std::max(state.dst_y0, state.dst_y1))));
+    const f32 scale_x = (state.src_x1 - state.src_x0) / (state.dst_x1 - state.dst_x0);
+    const f32 scale_y = (state.src_y1 - state.src_y0) / (state.dst_y1 - state.dst_y0);
+    IR::TextureInstInfo info{};
+    info.type.Assign(Shader::TextureType::Color2D);
+    const Cell no_offset{};
+    for (s32 y = y0; y < y1; ++y) {
+        for (s32 x = x0; x < x1; ++x) {
+            // the texel under the pixel's centre, in the source rectangle (texels)
+            Cell coords{};
+            SetCellF(coords, (state.src_x0 + (f32(x) + 0.5f - state.dst_x0) * scale_x) / f32(level.width), 0);
+            SetCellF(coords, (state.src_y0 + (f32(y) + 0.5f - state.dst_y0) * scale_y) / f32(level.height), 1);
+            const std::array<f32, 4> color = SampleTexture(binding, info, coords, no_offset, 0.0f, nullptr);
+            u64 offset;
+            if (pitch_linear) {
+                offset = u64(y) * rt.width + u64(x) * bpp;
+            } else {
+                const u32 xb = u32(x) * bpp, row = u32(y) % 8, in_gob = xb % 64;
+                offset = u64(u32(y) / block_rows) * block_row_size + u64{xb / 64} * block_bytes +
+                         (u32(y) % block_rows / 8) * 512 + (row / 2) * 64 + (row % 2) * 16 +
+                         (in_gob / 32) * 256 + ((in_gob % 32) / 16) * 32 + in_gob % 16;
+            }
+            u8* const out = gpu_memory.GetPointer(rt.Address() + offset);
+            std::array<u8, 16> encoded{};
+            u32 bytes = 0;
+            if (out && EncodeColor(rt.format, color, encoded, bytes)) {
+                std::memcpy(out, encoded.data(), bytes);
+            }
+        }
+    }
+    MarkWritten(rt.Address(), pitch_linear ? u64{rt.width} * rt.height
+                                           : block_row_size * ((rt.height + block_rows - 1) / block_rows));
+}
+
 void SoftwareDraw::MarkWritten(GPUVAddr address, u64 size) {
     textures->marks++;
     for (auto& [key, texture] : textures->entries) {
@@ -2989,7 +3056,15 @@ void SoftwareDraw::Draw(Maxwell& maxwell3d, Tegra::MemoryManager& gpu_memory, bo
     // The vertices the draw uses
     const u32 count = is_indexed ? draw_state.index_buffer.count : draw_state.vertex_buffer.count;
     std::vector<u32> indices(count);
-    if (is_indexed) {
+    if (is_indexed && !draw_state.inline_index_draw_indexes.empty()) {
+        // indices sent in the command stream (32-bit)
+        const auto& inline_indices = draw_state.inline_index_draw_indexes;
+        for (u32 i = 0; i < count && (i + 1) * 4 <= inline_indices.size(); ++i) {
+            u32 index;
+            std::memcpy(&index, inline_indices.data() + size_t(i) * 4, 4);
+            indices[i] = index + draw_state.base_index;
+        }
+    } else if (is_indexed) {
         const auto& ib = draw_state.index_buffer;
         const u32 size = static_cast<u32>(ib.FormatSizeInBytes());
         std::vector<u8> raw(size_t(count) * size);
diff --git a/src/video_core/renderer_null/software_draw.h b/src/video_core/renderer_null/software_draw.h
