Subject: [PATCH] null renderer: indirect draws, inline index buffers and
 DrawTexture in software

---
 .../renderer_null/null_rasterizer.cpp         | 52 ++++++++++++-
 .../renderer_null/null_rasterizer.h           |  1 +
 .../renderer_null/software_draw.cpp           | 77 ++++++++++++++++++-
 src/video_core/renderer_null/software_draw.h  |  4 +
 4 files changed, 132 insertions(+), 2 deletions(-)

diff --git a/src/video_core/renderer_null/null_rasterizer.cpp b/src/video_core/renderer_null/null_rasterizer.cpp
index f0debd283..e41faa0d6 100644
--- a/src/video_core/renderer_null/null_rasterizer.cpp
+++ b/src/video_core/renderer_null/null_rasterizer.cpp
@@ -39,7 +39,57 @@ void RasterizerNull::Draw(bool is_indexed, u32 instance_count) {
         m_software.Draw(*maxwell3d, *gpu_memory, is_indexed, instance_count);
     }
 }
-void RasterizerNull::DrawTexture() {}
+// Indirect draws: each draw's parameters read from the indirect buffer (and their count from the
+// count buffer), then drawn as a direct draw with them
+void RasterizerNull::DrawIndirect() {
+    if (!maxwell3d || !gpu_memory) {
+        return;
+    }
+    gpu_memory->FlushCaching();
+    auto& draw_manager = maxwell3d->draw_manager;
+    const auto params = draw_manager.indirect_state;
+    if (params.is_byte_count) {
+        LOG_WARNING(Render, "Software draw: transform feedback draws aren't drawn");
+        return;
+    }
+    u64 draws = std::max<u64>(params.max_draw_counts, 1);
+    if (params.include_count) {
+        draws = std::min<u64>(draws, gpu_memory->Read<u32>(params.count_start_address));
+    }
+    const u64 stride = params.stride ? params.stride : (params.is_indexed ? 20 : 16);
+    auto& state = draw_manager.draw_state;
+    const auto saved_vertices = state.vertex_buffer;
+    const auto saved_indices = state.index_buffer;
+    const u32 saved_base_index = state.base_index, saved_base_instance = state.base_instance;
+    for (u64 i = 0; i < draws; ++i) {
+        u32 command[5]{};
+        gpu_memory->ReadBlockUnsafe(params.indirect_start_address + i * stride, command,
+                                    params.is_indexed ? 20 : 16);
+        if (params.is_indexed) { // count, instances, first index, vertex offset, first instance
+            state.index_buffer.count = command[0];
+            state.index_buffer.first = command[2];
+            state.base_index = command[3];
+            state.base_instance = command[4];
+        } else { // count, instances, first vertex, first instance
+            state.vertex_buffer.count = command[0];
+            state.vertex_buffer.first = command[2];
+            state.base_instance = command[3];
+        }
+        if (command[0] != 0 && command[1] != 0) {
+            m_software.Draw(*maxwell3d, *gpu_memory, params.is_indexed, command[1]);
+        }
+    }
+    state.vertex_buffer = saved_vertices;
+    state.index_buffer = saved_indices;
+    state.base_index = saved_base_index, state.base_instance = saved_base_instance;
+}
+
+void RasterizerNull::DrawTexture() {
+    if (maxwell3d && gpu_memory) {
+        gpu_memory->FlushCaching();
+        m_software.DrawTexture(*maxwell3d, *gpu_memory);
+    }
+}
 
