From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eden PS4 <eden-ps4@localhost>
Date: Wed, 28 Oct 2026 15:39:25 +0000
Subject: [PATCH] null renderer: report gathered writes before draws and
 clears, as the Vulkan rasterizer does

---
 src/video_core/renderer_null/null_rasterizer.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/video_core/renderer_null/null_rasterizer.cpp b/src/video_core/renderer_null/null_rasterizer.cpp
index f726f329c..f0debd283 100644
--- a/src/video_core/renderer_null/null_rasterizer.cpp
+++ b/src/video_core/renderer_null/null_rasterizer.cpp
@@ -33,6 +33,9 @@ RasterizerNull::~RasterizerNull() = default;
 
 void RasterizerNull::Draw(bool is_indexed, u32 instance_count) {
     if (maxwell3d && gpu_memory) {
+        // the writes the memory manager has gathered (constant buffer updates among them) reported,
+        // as the Vulkan rasterizer reports them before a draw: they'd gather without end otherwise
+        gpu_memory->FlushCaching();
         m_software.Draw(*maxwell3d, *gpu_memory, is_indexed, instance_count);
     }
 }
@@ -120,6 +123,7 @@ void RasterizerNull::Clear(u32 layer_count) {
     if (!maxwell3d || !gpu_memory) {
         return;
     }
+    gpu_memory->FlushCaching();
     const auto& regs = maxwell3d->regs;
     const auto& surface = regs.clear_surface;
     const u32 layers = std::max<u32>(layer_count, 1);
