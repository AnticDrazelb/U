diff --git a/src/common/orbis_memory.cpp b/src/common/orbis_memory.cpp
new file mode 100644
index 000000000..2ea633dfd
--- /dev/null
+++ b/src/common/orbis_memory.cpp
@@ -0,0 +1,120 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#ifdef __OPENORBIS__
+
+#include <mutex>
+#include <vector>
+
+#include <sys/types.h>
+
+#include "common/literals.h"
+#include "common/logging.h"
+#include "common/orbis_memory.h"
+
+// Declared here: the OpenOrbis headers give some of these other prototypes.
+extern "C" {
+int32_t sceKernelReserveVirtualRange(void** addr, size_t len, int32_t flags, size_t alignment);
+int32_t sceKernelMunmap(void* addr, size_t len);
+size_t sceKernelGetDirectMemorySize(void);
+int32_t sceKernelAllocateDirectMemory(off_t start, off_t end, size_t len, size_t alignment,
+                                      int32_t memory_type, off_t* phys_out);
+int32_t sceKernelMapDirectMemory(void** addr, size_t len, int32_t prot, int32_t flags, off_t phys,
+                                 size_t alignment);
+int32_t sceKernelReleaseDirectMemory(off_t start, size_t len);
+int32_t sceKernelMapNamedFlexibleMemory(void** addr, size_t len, int32_t prot, int32_t flags,
+                                        const char* name);
+}
+
+namespace Common::Orbis {
+
+using namespace Common::Literals;
+
+namespace {
+
+constexpr int32_t ProtCpuReadWrite = 0x3;
+constexpr int32_t MapFixed = 0x10;
+constexpr int32_t MemoryTypeWriteBack = 0;
+constexpr size_t DirectAlignment = 2_MiB;
+
+struct DirectPiece {
+    void* base; // the range it was mapped for
+    off_t phys;
+    size_t size;
+};
+std::mutex direct_mutex;
+std::vector<DirectPiece> direct_pieces;
+
+void ReleasePieces(void* base) {
+    std::erase_if(direct_pieces, [base](const DirectPiece& piece) {
+        if (piece.base != base)
+            return false;
+        sceKernelReleaseDirectMemory(piece.phys, piece.size);
+        return true;
+    });
+}
+
+} // namespace
+
+void* ReserveRange(size_t size, size_t alignment) {
+    // Ranges the kernel places itself can land among the system libraries' objects, near
+    // 0x200000000: ask for higher addresses, as Crema's runtime does for its heap.
+    for (const uintptr_t hint : {0x1000000000ull, 0x800000000ull, 0x600000000ull}) {
+        void* address = reinterpret_cast<void*>(hint);
+        if (sceKernelReserveVirtualRange(&address, size, 0, alignment) != 0)
+            continue;
+        if (reinterpret_cast<uintptr_t>(address) >= 0x400000000ull)
+            return address;
+        sceKernelMunmap(address, size);
+    }
+    return nullptr;
+}
+
+void ReleaseRange(void* base, size_t size) {
+    sceKernelMunmap(base, size);
+}
+
+bool MapDirectMemory(void* base, size_t size) {
+    std::scoped_lock lock{direct_mutex};
+    size_t mapped = 0;
+    for (const size_t piece : {1_GiB, 256_MiB, 64_MiB, 16_MiB, 2_MiB}) {
+        while (size - mapped >= piece) {
+            off_t phys = 0;
+            if (sceKernelAllocateDirectMemory(0, sceKernelGetDirectMemorySize(), piece,
+                                              DirectAlignment, MemoryTypeWriteBack, &phys) != 0)
+                break;
+            void* at = static_cast<char*>(base) + mapped;
+            if (sceKernelMapDirectMemory(&at, piece, ProtCpuReadWrite, MapFixed, phys,
+                                         DirectAlignment) != 0 ||
+                at != static_cast<char*>(base) + mapped) {
+                sceKernelReleaseDirectMemory(phys, piece);
+                break;
+            }
+            direct_pieces.push_back({base, phys, piece});
+            mapped += piece;
+        }
+    }
+    if (mapped == size)
+        return true;
+    LOG_CRITICAL(HW_Memory, "Only {} MiB of the {} MiB of direct memory needed could be mapped",
+                 mapped >> 20, size >> 20);
+    sceKernelMunmap(base, size);
+    ReleasePieces(base);
+    return false;
+}
+
+void UnmapDirectMemory(void* base, size_t size) {
+    std::scoped_lock lock{direct_mutex};
+    sceKernelMunmap(base, size);
+    ReleasePieces(base);
+}
+
+bool MapFlexibleMemory(void* address, size_t size) {
+    void* at = address;
+    return sceKernelMapNamedFlexibleMemory(&at, size, ProtCpuReadWrite, MapFixed, "eden") == 0 &&
+           at == address;
+}
+
+} // namespace Common::Orbis
+
+#endif
diff --git a/src/common/orbis_memory.h b/src/common/orbis_memory.h
new file mode 100644
index 000000000..64c14f964
--- /dev/null
+++ b/src/common/orbis_memory.h
@@ -0,0 +1,37 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+// The PS4's memory pools, for the emulated DRAM (HostMemory) and the large sparse tables
+// (SparseLargeVector). An app gets three kinds of memory there: direct memory (the GPU's pool,
+// 4.5 GiB on a retail console), flexible memory (behind mmap; well under 1 GiB, all of it
+// committed when mapped) and system flexible memory (the only memory that runs code).
+
+#ifdef __OPENORBIS__
+
+#include <cstddef>
+
+namespace Common::Orbis {
+
+/// Reserves an address range (no memory behind it), above where the kernel places the system
+/// libraries' objects. Returns nullptr if there is none.
+void* ReserveRange(std::size_t size, std::size_t alignment);
+
+/// Releases a range from ReserveRange, with anything mapped in it.
+void ReleaseRange(void* base, std::size_t size);
+
+/// Maps `size` bytes of direct memory, in as few pieces as possible, back to back at `base` (a
+/// range from ReserveRange). On failure nothing stays allocated, and the range is released.
+bool MapDirectMemory(void* base, std::size_t size);
+
+/// Unmaps and frees what MapDirectMemory mapped at `base`.
+void UnmapDirectMemory(void* base, std::size_t size);
+
+/// Maps zero-filled read/write flexible memory at `address`, inside a reserved range. Safe to
+/// call from a signal handler.
+bool MapFlexibleMemory(void* address, std::size_t size);
+
+} // namespace Common::Orbis
+
+#endif
