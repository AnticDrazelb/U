 }
 #endif
 
+#ifdef __OPENORBIS__
+namespace {
+
+// The vectors' address ranges, for the fault handler: a fixed table it can read without locks.
+struct VectorRegion {
+    std::atomic<uintptr_t> base;
+    uintptr_t size;
+    std::atomic<u64>* committed;
+};
+constexpr size_t MaxVectorRegions = 64;
+VectorRegion vector_regions[MaxVectorRegions];
+// Taken by CommitVectorPage and the fault handler: a page is mapped once, and a page mapped and
+// written by one thread is never mapped over by another's fault.
+std::atomic_flag commit_lock = ATOMIC_FLAG_INIT;
+struct sigaction previous_segv, previous_bus;
+
+class CommitLock {
+public:
+    CommitLock() noexcept {
+        while (commit_lock.test_and_set(std::memory_order_acquire)) {
+        }
+    }
+    ~CommitLock() noexcept {
+        commit_lock.clear(std::memory_order_release);
+    }
+};
+
+bool CommitLocked(uintptr_t base, std::atomic<u64>* committed, uintptr_t page) noexcept {
+    const uintptr_t index = (page - base) >> HostPageBits;
+    auto& word = committed[index >> 6];
+    const u64 bit = 1ULL << (index & 63);
+    if (word.load(std::memory_order_acquire) & bit)
+        return true;
+    if (!Orbis::MapFlexibleMemory(reinterpret_cast<void*>(page), HostPageSize))
+        return false;
+    word.fetch_or(bit, std::memory_order_release);
+    return true;
+}
+
+void ChainSignal(const struct sigaction& previous, int sig, siginfo_t* info, void* context) {
+    if ((previous.sa_flags & SA_SIGINFO) && previous.sa_sigaction) {
+        previous.sa_sigaction(sig, info, context);
+    } else if (previous.sa_handler != SIG_DFL && previous.sa_handler != SIG_IGN) {
+        previous.sa_handler(sig);
+    } else {
+        // the default action: on return the access faults again, without this handler
+        signal(sig, SIG_DFL);
+    }
+}
+
+void VectorFaultHandler(int sig, siginfo_t* info, void* context) {
+    // si_addr at FreeBSD's offset (the musl headers have Linux's siginfo layout)
+    const uintptr_t address = *reinterpret_cast<const uintptr_t*>(reinterpret_cast<char*>(info) + 24);
+    for (auto& region : vector_regions) {
+        const uintptr_t base = region.base.load(std::memory_order_acquire);
+        if (base && address >= base && address - base < region.size) {
+            CommitLock lock;
+            if (CommitLocked(base, region.committed, address & HostPageMask))
+                return; // the access is retried, now with a page of zeros there
+            break;
+        }
+    }
+    ChainSignal(sig == SIGBUS ? previous_bus : previous_segv, sig, info, context);
+}
+
+void InstallVectorFaultHandler() {
+    struct sigaction action;
+    std::memset(&action, 0, sizeof(action));
+    action.sa_sigaction = VectorFaultHandler;
+    action.sa_flags = SA_SIGINFO | SA_ONSTACK;
+    sigemptyset(&action.sa_mask);
+    sigaction(SIGSEGV, &action, &previous_segv);
+    sigaction(SIGBUS, &action, &previous_bus);
+}
+
+} // namespace
+
+void RegisterVectorRegion(void* base, std::size_t size, std::atomic<u64>* committed) noexcept {
+    static std::once_flag handler_once;
+    std::call_once(handler_once, InstallVectorFaultHandler);
+    CommitLock lock;
+    for (auto& region : vector_regions) {
+        if (region.base.load(std::memory_order_relaxed) == 0) {
+            region.size = size;
+            region.committed = committed;
+            region.base.store(reinterpret_cast<uintptr_t>(base), std::memory_order_release);
+            return;
+        }
+    }
+    LOG_CRITICAL(HW_Memory, "More than {} large vectors: reads of unwritten pages will crash", MaxVectorRegions);
+}
+
+void UnregisterVectorRegion(void* base) noexcept {
+    CommitLock lock;
+    for (auto& region : vector_regions) {
+        if (region.base.load(std::memory_order_relaxed) == reinterpret_cast<uintptr_t>(base)) {
+            region.base.store(0, std::memory_order_release);
+        }
+    }
+}
+
+bool CommitVectorPage(void* base, std::atomic<u64>* committed, uintptr_t page) noexcept {
+    CommitLock lock;
+    return CommitLocked(reinterpret_cast<uintptr_t>(base), committed, page);
+}
+#endif
+
 #ifndef MAP_NOCORE
 #define MAP_NOCORE 0
 #endif
@@ -116,6 +229,8 @@ bool CommitVectorPage(uintptr_t addr, bool write) noexcept {
 void DecommitVectorPage(uintptr_t base) noexcept {
 #if defined(_WIN32)
     VirtualFree(reinterpret_cast<LPVOID>(base), HostPageSize, MEM_DECOMMIT);
+#elif defined(__OPENORBIS__)
+    std::memset(reinterpret_cast<void*>(base), 0, HostPageSize);
 #elif defined(__linux__)
     // Linux's MADV_DONTNEED zeros out pages for us
     madvise(reinterpret_cast<void*>(base), HostPageSize, MADV_DONTNEED);
@@ -147,6 +262,9 @@ void* AllocateMemoryPages(std::size_t size) noexcept {
         base = VirtualAlloc(nullptr, size, MEM_COMMIT, PAGE_READWRITE);
     }
     ASSERT_MSG(base, "Failed to reserve {:#x} sized region with error {}", size, GetLastError());
+#elif defined(__OPENORBIS__)
+    void* base = Orbis::ReserveRange(size, HostPageSize);
+    ASSERT_MSG(base, "Failed to reserve a {:#x} sized region", size);
 #else
     void* base = mmap(nullptr, size, PROT_READ, MAP_ANON | MAP_PRIVATE | MAP_NOCORE, -1, 0);
     if (base == MAP_FAILED)
@@ -166,6 +284,8 @@ void FreeMemoryPages(void* base, [[maybe_unused]] std::size_t size) noexcept {
     std::lock_guard lock(vector_regions_mutex);
     std::erase_if(vector_regions, [base](const auto& r) {return r.first == reinterpret_cast<u64>(base); });
     ASSERT(VirtualFree(base, 0, MEM_RELEASE));
+#elif defined(__OPENORBIS__)
+    Orbis::ReleaseRange(base, size);
 #else
     ASSERT(munmap(base, size) == 0);
 #endif
