-#ifdef _WIN32
+#if defined(_WIN32) || defined(__OPENORBIS__)
         if (!IsCommittedPage(index)) {
             return *reinterpret_cast<const T*>(&default_val);
         }
@@ -183,6 +206,13 @@ private:
         if (!CommitVectorPage(page, true)) {
