             auto denom = HostPageSize * 64;
             committed_pages = std::vector<std::atomic<u64>>((alloc_size + denom - 1) / denom);
+#ifdef __OPENORBIS__
+            RegisterVectorRegion(base_ptr, alloc_size, committed_pages.data());
