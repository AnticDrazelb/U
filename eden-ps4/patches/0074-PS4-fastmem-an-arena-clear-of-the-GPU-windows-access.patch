-// Where the arena may go: above the GPU's part of the address space. The port's Mesa reserves its
-// GPU address windows from 256 GiB up (port/mesa/ac_ps4_drm.c); an arena reserved first, at 68 to
-// 580 GiB (03.84), pushed them above it, to 581 GiB and up, and the app was killed at its first
-// GPU submission (no CPU signal: a GPU fault). The arena is only ever touched by the CPU, so it
-// goes at 1 TiB or above where the kernel allows, else at 512 GiB or above; never lower.
-constexpr uintptr_t ArenaFloor = 0x8000000000ull;
+// Where the arena may go: clear of the GPU's address windows. The port's Mesa reserves them from
+// 256 GiB up (port/mesa/ac_ps4_drm.c: 16 GiB, and a 4 GiB-aligned 32-bit one: at 256 and 272 GiB
+// in every run that worked); an arena reserved first, at 68 to 580 GiB (03.84), pushed them to 581
+// GiB and up, and the app was killed at its first GPU submission (a GPU fault: no CPU signal). The
+// arena is only ever touched by the CPU: from 288 GiB up it leaves 256-288 GiB to the windows, and
+// the kernel places other mappings low (64 GiB up, first fit). Above 512 GiB, a 2^39 arena didn't
+// fit (03.85: 2^38 at 512 GiB did), so 288 GiB is tried first.
+constexpr uintptr_t ArenaFloor = 0x4800000000ull;
 void* ReserveAboveGpu(size_t size) {
-    for (const uintptr_t hint : {0x10000000000ull, 0x20000000000ull, 0x40000000000ull, 0x8000000000ull}) {
+    for (const uintptr_t hint : {0x4800000000ull, 0x8000000000ull, 0x10000000000ull}) {
         void* address = reinterpret_cast<void*>(hint);
         if (sceKernelReserveVirtualRange(&address, size, 0, 2_MiB) != 0)
             continue;
