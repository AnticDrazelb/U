+// (04.80) memcmp: the difference of the first bytes that differ (as unsigned bytes), 0 if none, as
+// the SDK's (sub w0, w8, w9, uxtb): plain pages compared directly, anything else read with ReadBlock
+template <typename Memory>
+inline u32 Compare(Memory& memory, u64 a, u64 b, u64 n) {
+    using Core::Memory::YUZU_PAGEMASK;
+    using Core::Memory::YUZU_PAGESIZE;
+    for (u64 done = 0; done < n;) {
+        const u64 a_addr = a + done, b_addr = b + done;
+        const u64 chunk =
+            (std::min)({n - done, YUZU_PAGESIZE - (a_addr & YUZU_PAGEMASK), YUZU_PAGESIZE - (b_addr & YUZU_PAGEMASK)});
+        const u8* x = memory.GetPlainPointer(a_addr);
+        const u8* y = memory.GetPlainPointer(b_addr);
+        std::array<u8, YUZU_PAGESIZE> x_copy, y_copy;
+        if (!x) {
+            memory.ReadBlock(a_addr, x_copy.data(), chunk);
+            x = x_copy.data();
+        }
+        if (!y) {
+            memory.ReadBlock(b_addr, y_copy.data(), chunk);
+            y = y_copy.data();
+        }
+        for (u64 i = 0; i < chunk; i++)
+            if (x[i] != y[i])
+                return static_cast<u32>(int(x[i]) - int(y[i]));
+        done += chunk;
+    }
+    return 0;
+}
