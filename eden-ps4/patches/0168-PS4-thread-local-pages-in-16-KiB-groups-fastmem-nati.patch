+#ifdef EDEN_ARENA_LINE_UP
+bool KProcess::AllocateGroupedThreadLocalPage(KernelCore& kernel, KProcessAddress* out) {
+    constexpr size_t GroupPages = 16_KiB / PageSize;
+    std::scoped_lock lk{m_thread_local_groups_lock};
+    KProcessAddress page{};
+    for (auto& group : m_thread_local_groups) {
+        if (group.used != (1u << GroupPages) - 1) {
+            const unsigned index = static_cast<unsigned>(std::countr_one(group.used));
+            group.used |= static_cast<u8>(1u << index);
+            page = group.address + index * PageSize;
+            break;
+        }
+    }
+    if (page == 0) {
+        // a new group: 16 KiB of the system pool, back to back and aligned, mapped at a 16 KiB
+        // boundary; the allocation's reference kept until the group is unmapped (whatever the
+        // mapping itself opens, its unmapping closes)
+        auto& memory_manager = kernel.MemoryManager();
+        const KPhysicalAddress block = memory_manager.AllocateAndOpenContinuous(
+            GroupPages, GroupPages,
+            KMemoryManager::EncodeOption(KMemoryManager::Pool::System, KMemoryManager::Direction::FromFront));
+        if (block == 0) {
+            LOG_WARNING(Kernel, "thread local pages: no 16 KiB of the system pool for a group (a page of its own)");
+            return false;
+        }
+        KProcessAddress address{};
+        if (R_FAILED(m_page_table.MapPages(std::addressof(address), GroupPages, 16_KiB, block,
+                                           KMemoryState::ThreadLocal, KMemoryPermission::UserReadWrite))) {
+            memory_manager.Close(block, GroupPages);
+            LOG_WARNING(Kernel, "thread local pages: a group's mapping failed (a page of its own)");
+            return false;
+        }
+        m_thread_local_groups.push_back({address, block, 1});
+        LOG_WARNING(Kernel, "thread local pages: a 16 KiB group at {:#x} ({} in all)", GetInteger(address),
+                    m_thread_local_groups.size());
+        page = address;
+    }
+    // (a page as KPageBuffer::Allocate gives it: zeroed, whether new or a page a thread had)
+    this->GetMemory().ZeroBlock(page, PageSize);
+    *out = page;
+    return true;
+}
+
+bool KProcess::FreeGroupedThreadLocalPage(KernelCore& kernel, KProcessAddress address) {
+    constexpr size_t GroupPages = 16_KiB / PageSize;
+    KProcessAddress unmap{};
+    KPhysicalAddress block{};
+    {
+        std::scoped_lock lk{m_thread_local_groups_lock};
+        auto it = std::find_if(m_thread_local_groups.begin(), m_thread_local_groups.end(), [&](const ThreadLocalGroup& g) {
+            return address >= g.address && address < g.address + GroupPages * PageSize;
+        });
+        if (it == m_thread_local_groups.end()) {
+            return false;
+        }
+        it->used &= static_cast<u8>(~(1u << ((address - it->address) / PageSize)));
+        if (it->used == 0) {
+            unmap = it->address;
+            block = it->block;
+            m_thread_local_groups.erase(it);
+        }
+    }
+    if (unmap != 0) {
+        R_ASSERT(m_page_table.UnmapPages(unmap, GroupPages, KMemoryState::ThreadLocal));
+        kernel.MemoryManager().Close(block, GroupPages);
+    }
+    return true;
+}
+#endif
