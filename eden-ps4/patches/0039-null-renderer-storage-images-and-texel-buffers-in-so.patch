+/// Storage image loads, stores and atomics, for the lanes in 'exec' (stores and atomics only for
+/// the live ones: helpers have no effects). A typed load or store (a format in the instruction)
+/// moves the texel's bytes as they are; the rest convert them from and to the image's format.
+void RunImage(const SoftwareDraw::Program& program, const Op& o, Lanes* c, Io& io, u32 exec) {
+    using O = IR::Opcode;
+    IR::TextureInstInfo info{};
+    info.raw = o.extra;
+    const bool buffer = info.type == Shader::TextureType::Buffer;
+    const auto& descriptors = buffer ? program.image_buffers : program.images;
+    const u32 descriptor = info.descriptor_index;
+    const bool integer = descriptor < descriptors.size() && descriptors[descriptor].is_integer;
+    using F = Shader::ImageFormat;
+    const F format = info.image_format;
+    const u32 typed_bytes = format == F::R8_UINT || format == F::R8_SINT     ? 1
+                            : format == F::R16_UINT || format == F::R16_SINT ? 2
+                            : format == F::R32G32_UINT                       ? 8
+                            : format == F::R32G32B32A32_UINT                 ? 16
+                                                                             : 4;
+    Lanes& d = c[o.dest];
+    const Lanes& coords = c[o.a[1]];
+    const Lanes& value = c[o.a[2]];
+    if (o.op != O::ImageRead) {
+        exec &= io.live;
+    }
+    for (u32 m = exec; m != 0; m &= m - 1) {
+        const u32 i = u32(std::countr_zero(m));
+        const ImageView* const view = GetView(descriptors, io, descriptor, c[o.a[0]].w[0][i]);
+        GPUVAddr address;
+        const bool inside = view && ImageTexel(*view, info.type, coords, i, address);
+        if (o.op == O::ImageRead) {
+            std::array<u32, 4> texel{};
+            if (inside && format != F::Typeless) {
+                u8 bytes[16]{};
+                io.memory->ReadBlockUnsafe(address, bytes, typed_bytes);
+                std::memcpy(texel.data(), bytes, std::max(typed_bytes, 4u));
+                if (format == F::R8_SINT) {
+                    texel[0] = u32(s32(s8(bytes[0])));
+                } else if (format == F::R16_SINT) {
+                    s16 v;
+                    std::memcpy(&v, bytes, 2);
+                    texel[0] = u32(s32(v));
+                }
+            } else if (inside) {
+                u8 bytes[16]{};
+                io.memory->ReadBlockUnsafe(address, bytes, 1u << view->bpp_log2);
+                std::array<f32, 4> decoded{};
+                if (DecodeTexel(view->format, bytes, decoded)) {
+                    std::memcpy(texel.data(), decoded.data(), 16);
+                } else {
+                    LogOnce(fmt::format("storage image format {} not read", static_cast<u32>(view->format)));
+                }
+                (void)integer; // (an integer format's texels are its integers already)
+            }
+            for (u32 k = 0; k < 4; ++k) {
+                d.w[k][i] = texel[k];
+            }
+        } else if (o.op == O::ImageWrite) {
+            if (!inside) {
