+/// A storage image or a texel buffer: read (and written) in place, a texel at a time, where its
+/// texture header says it is
+struct ImageView {
+    GPUVAddr address = 0; // its level's first layer
+    PixelFormat format = PixelFormat::Invalid;
+    u32 bpp_log2 = 0;
+    u32 width = 0, height = 1, depth = 1, layers = 1; // the level's
+    bool linear = false; // rows 'pitch' bytes apart (a buffer: one row)
+    u32 pitch = 0;
+    u32 block_height = 0, block_depth = 0, gobs_in_x = 0; // block linear: the level's blocks (log2 GOBs)
+    u64 layer_stride = 0;
+    bool ok = false;
+};
+
+/// The view a texture header describes, at its base level and layer
+ImageView MakeView(Tegra::MemoryManager& gpu_memory, GPUVAddr tic_address) {
+    using namespace VideoCore::Surface;
+    Tegra::Texture::TICEntry tic{};
+    gpu_memory.ReadBlockUnsafe(tic_address, &tic, sizeof(tic));
+    const VideoCommon::ImageInfo info{tic};
+    ImageView view;
+    view.format = info.format;
+    if (info.format == PixelFormat::Invalid || IsPixelFormatASTC(info.format) || IsPixelFormatBCn(info.format) ||
+        DefaultBlockWidth(info.format) != 1 || info.num_samples > 1) {
+        return view;
+    }
+    view.bpp_log2 = u32(std::countr_zero(BytesPerBlock(info.format)));
+    view.address = tic.Address();
+    view.width = std::max(info.size.width, 1u);
+    if (info.type == VideoCommon::ImageType::Buffer) {
+        view.linear = true;
+        view.ok = true;
+        return view;
+    }
+    if (info.type == VideoCommon::ImageType::Linear) {
+        view.height = std::max(info.size.height, 1u);
+        view.linear = true;
+        view.pitch = info.pitch;
+        view.ok = true;
+        return view;
+    }
+    const u32 levels = u32(std::max(info.resources.levels, 1));
+    const u32 level = std::min<u32>(tic.res_min_mip_level, levels - 1);
+    const u32 base_layer = info.type == VideoCommon::ImageType::e3D ? 0 : tic.BaseLayer();
+    view.width = std::max(info.size.width >> level, 1u);
+    view.height = std::max(info.size.height >> level, 1u);
+    view.depth = std::max(info.size.depth >> level, 1u);
+    view.layers = u32(std::max(info.resources.layers - s32(base_layer), 1));
+    view.layer_stride = info.layer_stride;
+    view.address += VideoCommon::CalculateMipLevelOffsets(info)[level] + u64{base_layer} * info.layer_stride;
+    // the level's blocks, as Eden's UnswizzleImage finds them (smaller for a smaller level)
+    const auto fit = [](u32 extent, u32 block, u32 gob) {
+        while (block > 0 && extent <= (1u << (block - 1)) * gob) {
+            --block;
+        }
+        return block;
+    };
+    view.block_height = fit(view.height, info.block.height, 8);
+    view.block_depth = level == 0 && levels == 1 ? info.block.depth : fit(view.depth, info.block.depth, 1);
+    const u32 gob_width = 6 - view.bpp_log2 + info.tile_width_spacing;
+    const bool small = view.width <= (1u << gob_width) || view.height <= (1u << (3 + info.block.height)) ||
+                       view.depth < (1u << info.block.depth);
+    const u32 stride = Common::AlignUpLog2(view.width, small ? 6 - view.bpp_log2 : gob_width) << view.bpp_log2;
+    view.gobs_in_x = Common::DivCeil(stride, 64u);
+    view.ok = true;
+    return view;
+}
+
+/// Where a view's texel is (false: outside the view)
+bool TexelAddress(const ImageView& view, u32 x, u32 y, u32 z, u32 layer, GPUVAddr& address) {
+    if (!view.ok || x >= view.width || y >= view.height || z >= view.depth || layer >= view.layers) {
+        return false;
+    }
+    const u32 xb = x << view.bpp_log2;
+    u64 offset = layer * view.layer_stride;
+    if (view.linear) {
+        offset += u64(y) * view.pitch + xb;
+    } else {
+        // blocks a GOB (64 bytes by 8 rows) wide, 2^block_height GOBs tall and 2^block_depth deep;
+        // a row of them across the level, then the next row down, then the next slice of rows
+        const u32 bh = view.block_height, bd = view.block_depth;
+        const u64 block_row = u64{view.gobs_in_x} << (9 + bh + bd);
+        const u64 slice = u64{Common::DivCeil(view.height, 8u << bh)} * block_row;
+        const u32 gob_y = y >> 3;
+        offset += (z >> bd) * slice + (u64{z & ((1u << bd) - 1)} << (9 + bh)) + (gob_y >> bh) * block_row +
+                  (u64{gob_y & ((1u << bh) - 1)} << 9) + (u64{xb >> 6} << (9 + bh + bd)) +
+                  ((xb & 63) >> 5) * 256 + ((y & 7) >> 1) * 64 + ((xb & 31) >> 4) * 32 + (y & 1) * 16 + (xb & 15);
+    }
+    address = view.address + offset;
+    return true;
+}
+
+/// The unsigned 11- and 10-bit floats of B10G11R11, from a float
+u32 ToUfloat(f32 value, u32 mantissa_bits) {
+    const u32 f = std::bit_cast<u32>(value);
+    if (std::isnan(value)) {
+        return (31u << mantissa_bits) | 1;
+    }
+    if ((f >> 31) != 0) {
+        return 0;
+    }
+    const s32 exponent = s32(f >> 23) - 127 + 15;
+    if (exponent <= 0) {
+        return 0;
+    }
+    if (exponent >= 31) {
+        return 31u << mantissa_bits;
+    }
+    return (u32(exponent) << mantissa_bits) | ((f & 0x7FFFFF) >> (23 - mantissa_bits));
+}
+
+/// A texel of a format from four components (floats, or an integer format's integers), as a
+/// formatted image store writes it; its bytes in 'bytes'
+bool EncodeTexel(PixelFormat format, const std::array<u32, 4>& value, std::array<u8, 16>& out, u32& bytes) {
+    enum Kind { Unorm8, Unorm16, Snorm8, Snorm16, Int, Half, Full };
+    struct Channel {
+        u32 component, shift, bits;
+    };
+    Kind kind = Int;
+    std::array<Channel, 4> channels{};
+    u32 count = 0;
+    const auto fill = [&](Kind k, u32 n, u32 bits) { // R, G, B, A in order, 'bits' each
+        kind = k, count = n, bytes = n * bits / 8;
+        for (u32 c = 0; c < n; ++c) {
+            channels[c] = {c, c * bits, bits};
+        }
+    };
+    using P = PixelFormat;
+    switch (format) {
+    case P::A8B8G8R8_UNORM: fill(Unorm8, 4, 8); break;
+    case P::A8B8G8R8_SNORM: fill(Snorm8, 4, 8); break;
+    case P::A8B8G8R8_UINT: case P::A8B8G8R8_SINT: fill(Int, 4, 8); break;
+    case P::B8G8R8A8_UNORM:
+        fill(Unorm8, 4, 8);
+        channels[0].component = 2, channels[2].component = 0;
+        break;
+    case P::R16G16B16A16_FLOAT: fill(Half, 4, 16); break;
+    case P::R16G16B16A16_UNORM: fill(Unorm16, 4, 16); break;
+    case P::R16G16B16A16_SNORM: fill(Snorm16, 4, 16); break;
+    case P::R16G16B16A16_UINT: case P::R16G16B16A16_SINT: fill(Int, 4, 16); break;
+    case P::R32G32B32A32_FLOAT: fill(Full, 4, 32); break;
+    case P::R32G32B32A32_UINT: case P::R32G32B32A32_SINT: fill(Int, 4, 32); break;
+    case P::R32G32_FLOAT: fill(Full, 2, 32); break;
+    case P::R32G32_UINT: case P::R32G32_SINT: fill(Int, 2, 32); break;
+    case P::R16G16_FLOAT: fill(Half, 2, 16); break;
+    case P::R16G16_UNORM: fill(Unorm16, 2, 16); break;
+    case P::R16G16_SNORM: fill(Snorm16, 2, 16); break;
+    case P::R16G16_UINT: case P::R16G16_SINT: fill(Int, 2, 16); break;
+    case P::R8G8_UNORM: fill(Unorm8, 2, 8); break;
+    case P::R8G8_SNORM: fill(Snorm8, 2, 8); break;
+    case P::R8G8_UINT: case P::R8G8_SINT: fill(Int, 2, 8); break;
+    case P::R32_FLOAT: fill(Full, 1, 32); break;
+    case P::R32_UINT: case P::R32_SINT: fill(Int, 1, 32); break;
+    case P::R16_FLOAT: fill(Half, 1, 16); break;
+    case P::R16_UNORM: fill(Unorm16, 1, 16); break;
+    case P::R16_SNORM: fill(Snorm16, 1, 16); break;
+    case P::R16_UINT: case P::R16_SINT: fill(Int, 1, 16); break;
+    case P::R8_UNORM: fill(Unorm8, 1, 8); break;
+    case P::R8_SNORM: fill(Snorm8, 1, 8); break;
+    case P::R8_UINT: case P::R8_SINT: fill(Int, 1, 8); break;
+    case P::A2B10G10R10_UNORM: case P::A2B10G10R10_UINT: {
+        const bool unorm = format == P::A2B10G10R10_UNORM;
+        u32 packed = 0;
+        for (u32 c = 0; c < 4; ++c) {
+            const u32 bits = c == 3 ? 2 : 10;
+            const u32 v = unorm ? Unorm(std::bit_cast<f32>(value[c]), bits) : value[c] & ((1u << bits) - 1);
+            packed |= v << (c * 10);
+        }
+        std::memcpy(out.data(), &packed, 4);
+        bytes = 4;
+        return true;
+    }
+    case P::B10G11R11_FLOAT: {
+        const u32 packed = ToUfloat(std::bit_cast<f32>(value[0]), 6) |
+                           ToUfloat(std::bit_cast<f32>(value[1]), 6) << 11 |
+                           ToUfloat(std::bit_cast<f32>(value[2]), 5) << 22;
+        std::memcpy(out.data(), &packed, 4);
+        bytes = 4;
+        return true;
+    }
+    default:
+        return false;
+    }
+    std::array<u32, 4> words{};
+    for (u32 c = 0; c < count; ++c) {
+        const Channel& ch = channels[c];
+        const u32 raw = value[ch.component];
+        const f32 f = std::bit_cast<f32>(raw);
+        const u32 mask = ch.bits == 32 ? ~0u : (1u << ch.bits) - 1;
+        u32 v = 0;
+        switch (kind) {
+        case Unorm8: v = Unorm(f, 8); break;
+        case Unorm16: v = Unorm(f, 16); break;
+        case Snorm8: case Snorm16: {
+            const f32 max = kind == Snorm8 ? 127.0f : 32767.0f;
+            v = u32(s32(std::round(std::clamp(std::isnan(f) ? 0.0f : f, -1.0f, 1.0f) * max)));
+            break;
+        }
+        case Int: v = raw; break;
+        case Half: v = ToHalf(f); break;
+        case Full: v = raw; break;
+        }
+        words[ch.shift / 32] |= (v & mask) << (ch.shift % 32);
+    }
+    std::memcpy(out.data(), words.data(), bytes);
+    return true;
+}
+
 float FromSnorm(s32 value, u32 bits) {
     return std::max(float(value) / float((1 << (bits - 1)) - 1), -1.0f);
 }
