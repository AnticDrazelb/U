+/// The view of a texel buffer or storage image descriptor, the element of an array
+const ImageView* GetView(const std::vector<ViewDescriptor>& descriptors, const Io& io, u32 descriptor,
+                         u32 element) {
+    if (descriptor >= descriptors.size() || !io.views) {
+        return nullptr;
+    }
+    const ViewDescriptor& desc = descriptors[descriptor];
+    const size_t index = desc.first + std::min(element, std::max(desc.count, 1u) - 1);
+    return index < io.views->size() ? &(*io.views)[index] : nullptr;
+}
+
+/// An image instruction's texel: its coordinates by the image's type
+bool ImageTexel(const ImageView& view, Shader::TextureType type, const Lanes& coords, u32 i, GPUVAddr& address) {
+    using T = Shader::TextureType;
+    const u32 x = coords.w[0][i], y = coords.w[1][i], w = coords.w[2][i];
+    switch (type) {
+    case T::Color1D: case T::Buffer:
+        return TexelAddress(view, x, 0, 0, 0, address);
+    case T::ColorArray1D:
+        return TexelAddress(view, x, 0, 0, y, address);
+    case T::Color3D:
+        return TexelAddress(view, x, y, w, 0, address);
+    case T::ColorArray2D: case T::ColorCube: case T::ColorArrayCube:
+        return TexelAddress(view, x, y, 0, w, address);
+    default:
+        return TexelAddress(view, x, y, 0, 0, address);
+    }
+}
+
 f32 Fl(const Lanes& x, u32 i, u32 k = 0) {
     return std::bit_cast<f32>(x.w[k][i]);
 }
