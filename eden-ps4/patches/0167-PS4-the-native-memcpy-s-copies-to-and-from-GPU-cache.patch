--- a/src/core/arm/dynarmic/arm_dynarmic_32.cpp
+++ b/src/core/arm/dynarmic/arm_dynarmic_32.cpp
@@ -44,6 +44,26 @@ u64 DynarmicCallbacks32::MemoryRead(u32 vaddr, size_t size) {
     }
 }
 
+// (04.78) EDEN_PS4_JIT_OFF=<names, comma-separated>: those speed-ups alone off (the menu's CPU >
+// Speed-ups, to find the one behind a game's trouble): extras (the translator's PS4 shortcuts),
+// pins (loop registers), reuse (stack range checks), guard (direct calls), leaf (tiny functions),
+// native (memcpy/memmove/memset on the host)
+static bool JitOff(std::string_view name) {
+    const char* const list = std::getenv("EDEN_PS4_JIT_OFF");
+    if (list == nullptr)
+        return false;
+    std::string_view rest{list};
+    while (!rest.empty()) {
+        const size_t comma = rest.find(',');
+        if (rest.substr(0, comma) == name)
+            return true;
+        if (comma == std::string_view::npos)
+            break;
+        rest.remove_prefix(comma + 1);
+    }
+    return false;
+}
+
 int DynarmicCallbacks32::NativeFunction(u32 vaddr) {
     if (m_debugger_enabled || m_process == nullptr)
         return 0;
@@ -299,6 +319,20 @@ void ArmDynarmic32::MakeJit(Common::PageTable* page_table) {
         config.skip_redundant_extensions = false;
         config.split_cold_code = false;
     }
+    if (JitOff("pins"))
+        config.loop_register_pins = false;
+    if (JitOff("guard"))
+        config.guarded_indirect_links = false;
+    if (JitOff("native"))
+        config.native_functions = false;
+    if (JitOff("extras")) {
+        config.inline_conditional_instructions = false;
+        config.elide_dead_nzcv = false;
+        config.elide_dead_nzcv_abi = false;
+        config.fold_address_offsets = false;
+        config.skip_redundant_extensions = false;
+        config.split_cold_code = false;
+    }
 
     // Code cache size
 #if defined(__OPENORBIS__)
