     if (m_debugger_enabled || m_process == nullptr)  // (the debugger's watchpoints see every access)
         return 0;
@@ -465,6 +485,31 @@ void ArmDynarmic64::MakeJit(Common::PageTable* page_table, std::size_t address_s
         config.superblocks_cond = false;
         config.bitfield_shifts = false;
     }
+    if (JitOff("pins"))
+        config.loop_register_pins = false;
+    if (JitOff("reuse"))
+        config.fastmem_range_check_reuse = false;
+    if (JitOff("guard"))
+        config.guarded_indirect_links = false;
+    if (JitOff("leaf"))
+        config.follow_leaf_calls = false;
+    if (JitOff("native"))
+        config.native_functions = false;
+    if (JitOff("extras")) {
+        config.fold_address_offsets = false;
+        config.skip_redundant_extensions = false;
+        config.split_cold_code = false;
+        config.elide_dead_nzcv = false;
+        config.elide_dead_nzcv_abi = false;
+        config.return_stack_pc_only = false;
+        config.plain_acquire_loads = false;
+        config.elide_load_store_only_barriers = false;
+        config.superblocks = false;
+        config.superblocks_cond = false;
+        config.bitfield_shifts = false;
+    }
+    if (const char* off = std::getenv("EDEN_PS4_JIT_OFF"); off && m_core_index == 0)
+        LOG_WARNING(Core_ARM, "speed-ups off (the menu): {}", off);
 
     // Code cache size
 #if defined(__OPENORBIS__)
diff --git a/src/core/arm/dynarmic/native_functions.h b/src/core/arm/dynarmic/native_functions.h
index 582ddf1e00..e2c1381d4e 100644
--- a/src/core/arm/dynarmic/native_functions.h
+++ b/src/core/arm/dynarmic/native_functions.h
@@ -108,9 +108,11 @@ inline Table Find(Kernel::KProcess* process, Core::Memory::Memory& memory, bool
 
 // Plain memory (its page table entry has a host pointer) is read and written directly, a page at a
 // time; anything else (memory the GPU caches, which needs its notifications; unmapped) through
-// ReadBlock, WriteBlock and CopyBlock, as the guest's own loads and stores would be. memmove's result
+// ReadBlock and WriteBlock (a page at a time through a buffer), as the guest's own loads and stores
+// would be, with the GPU's notifications. memmove's result
 // (memcpy's too, whose overlap is undefined).
-inline void Move(Core::Memory::Memory& memory, u64 dest, u64 src, u64 n) {
+template <typename Memory>
+inline void Move(Memory& memory, u64 dest, u64 src, u64 n) {
     using Core::Memory::YUZU_PAGEMASK;
     using Core::Memory::YUZU_PAGESIZE;
     if (n == 0 || dest == src)
@@ -136,15 +138,21 @@ inline void Move(Core::Memory::Memory& memory, u64 dest, u64 src, u64 n) {
             (std::min)({n - done, YUZU_PAGESIZE - (from_addr & YUZU_PAGEMASK), YUZU_PAGESIZE - (to_addr & YUZU_PAGEMASK)});
         u8* const to = memory.GetPlainPointer(to_addr);
         const u8* const from = memory.GetPlainPointer(from_addr);
-        if (to && from)
+        if (to && from) {
             std::memcpy(to, from, chunk);
-        else
-            memory.CopyBlock(to_addr, from_addr, chunk);
+        } else {
+            // (04.78: not CopyBlock, which walked the destination and copied it onto itself, so a copy
+            // to or from memory the GPU caches did nothing: Echoes of Wisdom's flicker and crash)
+            std::array<u8, YUZU_PAGESIZE> buffer;
+            memory.ReadBlock(from_addr, buffer.data(), chunk);
+            memory.WriteBlock(to_addr, buffer.data(), chunk);
+        }
         done += chunk;
     }
 }
 
-inline void Fill(Core::Memory::Memory& memory, u64 dest, u8 c, u64 n) {
+template <typename Memory>
+inline void Fill(Memory& memory, u64 dest, u8 c, u64 n) {
     using Core::Memory::YUZU_PAGEMASK;
     using Core::Memory::YUZU_PAGESIZE;
     for (u64 done = 0; done < n;) {
diff --git a/src/core/memory.cpp b/src/core/memory.cpp
index ded87210b8..caf1d4838f 100644
--- a/src/core/memory.cpp
+++ b/src/core/memory.cpp
@@ -352,8 +352,10 @@ struct Memory::Impl {
         });
     }
 
+    // (PS4 04.78) the source walked, each piece written at the same offset in the destination: it
+    // walked the destination, so each piece was copied onto itself and nothing was copied
     bool CopyBlock(Common::ProcessAddress dest_addr, Common::ProcessAddress src_addr, const std::size_t size) {
-        return WalkBlock(dest_addr, size,
+        return WalkBlock(src_addr, size,
         [&](const std::size_t offset, const std::size_t copy_amount, const Common::ProcessAddress current_vaddr) {
             LOG_ERROR(HW_Memory, "Unmapped @ {:#016x} (start address = {:#016x}, size = {})", GetInteger(current_vaddr), GetInteger(src_addr), size);
             ZeroBlock(dest_addr + offset, copy_amount);
