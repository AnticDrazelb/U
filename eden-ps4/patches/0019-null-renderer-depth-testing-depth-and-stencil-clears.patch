-// Colour clears, done in emulated memory: what a program draws with clears (and the DMA and 2D
-// engines, and the software draws) shows in the null renderer's frames. Depth and stencil clears
-// still do nothing.
+namespace {
+
+/// A rectangle of a surface (a render target or depth buffer) in emulated memory, 'pixel' written
+/// to each of its pixels where 'mask' is set, a GOB column of a block at a time (block linear)
+/// or a row at a time (pitch)
+struct Fill {
+    GPUVAddr address;
+    bool pitch_linear;
+    u32 pitch;        // pitch surfaces
+    u32 width;        // in pixels
+    u32 bpp;
+    u32 block_height; // block linear surfaces: log2 of GOBs a block is high
+    u64 layer_stride;
+    std::array<u8, 16> pixel;
+    std::array<bool, 16> mask;
+};
+
+void FillRect(Tegra::MemoryManager& gpu_memory, Common::ScratchBuffer<u8>& scratch, const Fill& fill,
+              u32 x0, u32 y0, u32 x1, u32 y1, u32 first_layer, u32 layers) {
+    const u32 bpp = fill.bpp;
+    const bool all = std::all_of(fill.mask.begin(), fill.mask.begin() + bpp, [](bool b) { return b; });
+    const auto put = [&](u8* out) {
+        if (all) {
+            std::memcpy(out, fill.pixel.data(), bpp);
+            return;
+        }
+        for (u32 b = 0; b < bpp; ++b) {
+            if (fill.mask[b]) {
+                out[b] = fill.pixel[b];
+            }
+        }
+    };
+    if (fill.pitch_linear) {
+        for (u32 y = y0; y < y1; ++y) {
+            Tegra::Memory::GpuGuestMemoryScoped<u8, Tegra::Memory::GuestMemoryFlags::UnsafeReadWrite>
+                row(gpu_memory, fill.address + u64{y} * fill.pitch + u64{x0} * bpp, (x1 - x0) * bpp, &scratch);
+            for (u32 x = 0; x < x1 - x0; ++x) {
+                put(row.data() + x * bpp);
+            }
+        }
+        return;
+    }
+    // Block linear: a block (one GOB wide, 1 << block_height GOBs high) is contiguous, so each
+    // block the rectangle touches is read, written and written back on its own.
+    const u32 block_rows = 8u << fill.block_height;
+    const u32 block_bytes = 512u << fill.block_height;
+    const u32 gobs_in_x = (fill.width * bpp + 63) / 64;
+    const u64 block_row_size = u64{gobs_in_x} * block_bytes;
+    const u32 pixels_per_gob = 64 / bpp;
+    for (u32 layer = 0; layer < layers; ++layer) {
+        const GPUVAddr layer_address = fill.address + u64{first_layer + layer} * fill.layer_stride;
+        for (u32 by = y0 / block_rows; by <= (y1 - 1) / block_rows; ++by) {
+            const u32 ys = std::max(y0, by * block_rows), ye = std::min(y1, (by + 1) * block_rows);
+            for (u32 gx = x0 / pixels_per_gob; gx <= (x1 - 1) / pixels_per_gob; ++gx) {
+                const u32 xs = std::max(x0, gx * pixels_per_gob);
+                const u32 xe = std::min(x1, (gx + 1) * pixels_per_gob);
+                Tegra::Memory::GpuGuestMemoryScoped<u8, Tegra::Memory::GuestMemoryFlags::UnsafeReadWrite>
+                    block(gpu_memory, layer_address + by * block_row_size + u64{gx} * block_bytes,
+                          block_bytes, &scratch);
+                for (u32 y = ys; y < ye; ++y) {
+                    const u32 in_block = y - by * block_rows;
+                    const u32 row = in_block % 8;
+                    const u32 row_offset = (in_block / 8) * 512 + (row / 2) * 64 + (row % 2) * 16;
+                    for (u32 x = xs; x < xe; ++x) {
+                        const u32 xb = (x * bpp) % 64;
+                        put(block.data() + row_offset + (xb / 32) * 256 + ((xb % 32) / 16) * 32 + (xb % 16));
+                    }
+                }
+            }
+        }
+    }
+}
+
+} // Anonymous namespace
