+/// The depth test: the incoming depth against the buffer's, both as the buffer keeps them
+bool DepthPasses(Maxwell::Regs::ComparisonOp op, u32 incoming, u32 stored) {
+    using C = Maxwell::Regs::ComparisonOp;
+    switch (op) {
+    case C::Never_D3D: case C::Never_GL: return false;
+    case C::Less_D3D: case C::Less_GL: return incoming < stored;
+    case C::Equal_D3D: case C::Equal_GL: return incoming == stored;
+    case C::LessEqual_D3D: case C::LessEqual_GL: return incoming <= stored;
+    case C::Greater_D3D: case C::Greater_GL: return incoming > stored;
+    case C::NotEqual_D3D: case C::NotEqual_GL: return incoming != stored;
+    case C::GreaterEqual_D3D: case C::GreaterEqual_GL: return incoming >= stored;
+    default: return true;
+    }
+}
