+// Clears, done in emulated memory: what a program draws with clears (and the DMA and 2D engines,
+// and the software draws) shows in the null renderer's frames. Colour (render target), depth and
+// stencil (the depth buffer).
 void RasterizerNull::Clear(u32 layer_count) {
     if (!maxwell3d || !gpu_memory) {
         return;
     }
     const auto& regs = maxwell3d->regs;
     const auto& surface = regs.clear_surface;
+    const u32 layers = std::max<u32>(layer_count, 1);
+    const auto clear_rect = [&](u32 width, u32 height, u32& x0, u32& y0, u32& x1, u32& y1) {
+        x0 = 0, y0 = 0, x1 = width, y1 = height;
+        if (regs.clear_control.use_scissor && regs.scissor_test[0].enable) {
+            const auto& scissor = regs.scissor_test[0];
+            x0 = std::max<u32>(x0, scissor.min_x);
+            y0 = std::max<u32>(y0, scissor.min_y);
+            x1 = std::min<u32>(x1, scissor.max_x);
+            y1 = std::min<u32>(y1, scissor.max_y);
+        }
+        return x0 < x1 && y0 < y1;
+    };
+
+    // Depth and stencil
+    if ((surface.Z || surface.S) && regs.zeta_enable && regs.zeta.Address() != 0) {
+        const auto format = regs.zeta.format;
+        const u32 bpp = DepthBytes(format);
+        u32 x0, y0, x1, y1;
+        if (bpp == 0) {
+            LOG_WARNING(Render, "Software clear: depth format {:#x} not handled", static_cast<u32>(format));
+        } else if (clear_rect(regs.zeta_size.width, regs.zeta_size.height, x0, y0, x1, y1)) {
+            Fill fill{};
+            fill.address = regs.zeta.Address();
+            fill.pitch_linear = regs.zeta.tile_mode.is_pitch_linear != 0;
+            fill.width = regs.zeta_size.width;
+            fill.pitch = fill.width * bpp;
+            fill.bpp = bpp;
+            fill.block_height = regs.zeta.tile_mode.block_height;
+            fill.layer_stride = u64{regs.zeta.array_pitch} << 2;
+            // the bytes the depth and the stencil take: written to a zero pixel and to a full one
+            std::array<u8, 16> zeros{}, ones;
+            ones.fill(0xFF);
+            if (surface.Z) {
+                const u32 depth = DepthValue(format, regs.clear_depth);
+                WriteDepth(format, fill.pixel.data(), depth);
+                WriteDepth(format, zeros.data(), 0xFFFFFFFFu);
+                WriteDepth(format, ones.data(), 0);
+            }
+            if (surface.S) {
+                const u8 stencil = u8(regs.clear_stencil) & u8(regs.stencil_front_mask);
+                WriteStencil(format, fill.pixel.data(), stencil);
+                WriteStencil(format, zeros.data(), 0xFF);
+                WriteStencil(format, ones.data(), 0);
+            }
+            for (u32 b = 0; b < bpp; ++b) {
+                fill.mask[b] = zeros[b] != 0 || ones[b] != 0xFF;
+            }
+            m_software.MarkWritten(fill.address, std::max<u64>(fill.layer_stride, u64{fill.width} * regs.zeta_size.height * 16) *
+                                                     (surface.layer + layers));
+            FillRect(*gpu_memory, m_scratch, fill, x0, y0, x1, y1, surface.layer, layers);
+        }
+    }
+
+    // Colour
     if (!(surface.R || surface.G || surface.B || surface.A)) {
         return;
     }
@@ -56,13 +185,9 @@ void RasterizerNull::Clear(u32 layer_count) {
