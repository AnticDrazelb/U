diff --git a/src/video_core/renderer_null/software_draw.cpp b/src/video_core/renderer_null/software_draw.cpp
index c7bd160ad..6ca4d0c11 100644
--- a/src/video_core/renderer_null/software_draw.cpp
+++ b/src/video_core/renderer_null/software_draw.cpp
@@ -270,6 +270,83 @@ bool DecodeColor(Tegra::RenderTargetFormat format, const u8* in, std::array<f32,
     }
 }
 
+u32 DepthBytes(Tegra::DepthFormat format) {
+    using D = Tegra::DepthFormat;
+    switch (format) {
+    case D::Z16_UNORM: return 2;
+    case D::Z32_FLOAT: case D::Z24_UNORM_S8_UINT: case D::X8Z24_UNORM: case D::S8Z24_UNORM:
+    case D::V8Z24_UNORM: return 4;
+    case D::Z32_FLOAT_X24S8_UINT: return 8;
+    case D::S8_UINT: return 1;
+    default: return 0;
+    }
+}
+
+u32 DepthValue(Tegra::DepthFormat format, f32 depth) {
+    depth = std::isnan(depth) ? 0.0f : std::clamp(depth, 0.0f, 1.0f);
+    using D = Tegra::DepthFormat;
+    switch (format) {
+    case D::Z16_UNORM: return u32(depth * 65535.0f + 0.5f);
+    case D::Z32_FLOAT: case D::Z32_FLOAT_X24S8_UINT: return std::bit_cast<u32>(depth);
+    case D::S8_UINT: return 0;
+    default: return u32(f64(depth) * 16777215.0 + 0.5); // the 24-bit formats
+    }
+}
+
+u32 ReadDepth(Tegra::DepthFormat format, const u8* pixel) {
+    u32 v = 0;
+    using D = Tegra::DepthFormat;
+    switch (format) {
+    case D::Z16_UNORM: {
+        u16 h;
+        std::memcpy(&h, pixel, 2);
+        return h;
+    }
+    case D::S8_UINT: return 0;
+    default: std::memcpy(&v, pixel, 4); break;
+    }
+    switch (format) {
+    case D::Z24_UNORM_S8_UINT: return v >> 8;     // depth above, stencil below
+    case D::X8Z24_UNORM: case D::S8Z24_UNORM: case D::V8Z24_UNORM: return v & 0xFFFFFF;
+    default: return v;                            // the float formats
+    }
+}
+
+void WriteDepth(Tegra::DepthFormat format, u8* pixel, u32 value) {
+    using D = Tegra::DepthFormat;
+    u32 v;
+    switch (format) {
+    case D::Z16_UNORM: {
+        const u16 h = u16(value);
+        std::memcpy(pixel, &h, 2);
+        return;
+    }
+    case D::S8_UINT: return;
+    case D::Z32_FLOAT: case D::Z32_FLOAT_X24S8_UINT:
+        std::memcpy(pixel, &value, 4);
+        return;
+    case D::Z24_UNORM_S8_UINT:
+        std::memcpy(&v, pixel, 4);
+        v = (v & 0xFF) | (value << 8);
+        break;
+    default:
+        std::memcpy(&v, pixel, 4);
+        v = (v & 0xFF000000u) | (value & 0xFFFFFF);
+        break;
+    }
+    std::memcpy(pixel, &v, 4);
+}
+
+void WriteStencil(Tegra::DepthFormat format, u8* pixel, u8 stencil) {
+    using D = Tegra::DepthFormat;
+    switch (format) {
+    case D::Z24_UNORM_S8_UINT: case D::S8_UINT: pixel[0] = stencil; break;
+    case D::S8Z24_UNORM: pixel[3] = stencil; break;
+    case D::Z32_FLOAT_X24S8_UINT: pixel[4] = stencil; break;
+    default: break;
+    }
+}
+
