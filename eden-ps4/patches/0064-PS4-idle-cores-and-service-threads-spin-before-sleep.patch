 void PhysicalCore::Idle() {
+#ifdef __OPENORBIS__
+    // A core with nothing to run is usually handed work within microseconds (a thread another core
+    // made ready, a service's reply), and waking a sleeping host thread costs far more than that
+    // on the PS4: every handoff between the game's threads paid it. So an idle core spins for a
+    // while first (a core of the PS4's seven the game isn't using), then sleeps.
+    constexpr auto SpinTime = std::chrono::microseconds(50);
+    const auto spin_end = Common::g_wall_clock.GetTimeNS() + SpinTime;
+    while (!m_is_interrupted.load(std::memory_order_acquire)) {
+        for (int i = 0; i < 16; i++) {
+            _mm_pause();
+        }
+        if (Common::g_wall_clock.GetTimeNS() >= spin_end) {
+            break;
+        }
+    }
+    if (m_is_interrupted.load(std::memory_order_acquire)) {
+        Common::PS4Perf::idle_spin_wakes.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+#endif
     std::unique_lock lk{m_guard};
-    m_on_interrupt.wait(lk, [this] { return m_is_interrupted; });
+#ifdef __OPENORBIS__
+    const bool sleeps = !m_is_interrupted;
+#endif
+    m_on_interrupt.wait(lk, [this] { return m_is_interrupted.load(); });
+#ifdef __OPENORBIS__
+    if (sleeps) {
+        const u64 now = static_cast<u64>(Common::g_wall_clock.GetTimeNS().count());
+        Common::PS4Perf::idle_sleep_wakes.Add(now > m_interrupt_ns ? now - m_interrupt_ns : 0);
+    }
+#endif
 }
 
