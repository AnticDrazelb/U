diff --git a/src/common/ps4_perf.h b/src/common/ps4_perf.h
new file mode 100644
index 000000000..9fdc81a7d
--- /dev/null
+++ b/src/common/ps4_perf.h
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+// Where an emulated frame's time goes on the PS4, counted as it happens and read by the launcher
+// every 30 s (the boot trace): the emulated cores' sleeps and how long a wake-up took, the
+// game's calls to the HLE services and their round trips, how late the timing thread fired its
+// events, the recompiler's translations and cache flushes, and guest memory accesses that left
+// the recompiler's inline page table walk. Relaxed atomics: totals since the program started,
+// which the reader differences.
+
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+
+namespace Common::PS4Perf {
+
+struct Counter {
+    std::atomic<uint64_t> count{0}, total_ns{0}, max_ns{0};
+
+    void Add(uint64_t ns) {
+        count.fetch_add(1, std::memory_order_relaxed);
+        total_ns.fetch_add(ns, std::memory_order_relaxed);
+        uint64_t max = max_ns.load(std::memory_order_relaxed);
+        while (ns > max && !max_ns.compare_exchange_weak(max, ns, std::memory_order_relaxed)) {
+        }
+    }
+};
+
+// An emulated core that had nothing to run: woken while it still spun (no host sleep), or after
+// sleeping (the time from the interrupt to running again)
+inline std::atomic<uint64_t> idle_spin_wakes{0};
+inline Counter idle_sleep_wakes;
+// svcSendSyncRequest: from the call to the reply
+inline Counter ipc;
+// The timing thread's events: how late each fired; and its timed waits' overshoot, which it
+// learns and wakes that much early for (in ns, an average)
+inline Counter timer_late;
+inline std::atomic<int64_t> timer_overshoot_ns{0};
+// The recompiler: blocks translated, whole-cache flushes (a full cache, or asked for) and range
+// invalidations
+inline std::atomic<uint64_t> jit_blocks{0}, jit_full_flushes{0}, jit_range_flushes{0};
+// Guest memory accesses through the recompiler's callbacks instead of its inline page table walk,
+// per emulated core (a cache line each: a busy count shared by the cores would cost time itself)
+struct alignas(64) CoreCount {
+    std::atomic<uint64_t> n{0};
+};
+inline CoreCount slow_memory_accesses[4];
+inline uint64_t SlowMemoryAccesses() {
+    uint64_t total = 0;
+    for (const CoreCount& core : slow_memory_accesses) {
+        total += core.n.load(std::memory_order_relaxed);
+    }
+    return total;
+}
+
+} // namespace Common::PS4Perf
