     constexpr u32 idle_frames_kept = 300;
@@ -2877,6 +2977,16 @@ SoftwareDraw::Program* SoftwareDraw::GetProgram(Maxwell& maxwell3d,
             LogOnce("storage images aren't drawn");
         }
         program->ok = Flattener{*program}.Run(ir);
+        program->writes_memory = std::ranges::any_of(program->ops, [](const Op& op) {
+            return op.kind == Kind::Ir &&
+                   (op.op == IR::Opcode::WriteStorageU8 || op.op == IR::Opcode::WriteStorageS8 ||
