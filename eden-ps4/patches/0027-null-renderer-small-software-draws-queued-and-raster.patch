     const auto& surface = regs.clear_surface;
@@ -291,10 +292,13 @@ void RasterizerNull::Clear(u32 layer_count) {
     m_software.MarkWritten(address, FillBytes(fill, rt.height, surface.layer, layers));
     FillRect(*gpu_memory, m_scratch, fill, x0, y0, x1, y1, surface.layer, layers);
 }
