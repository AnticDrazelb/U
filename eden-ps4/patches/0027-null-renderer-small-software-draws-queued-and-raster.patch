 void RasterizerNull::Query(GPUVAddr gpu_addr, VideoCommon::QueryType type,
                            VideoCommon::QueryPropertiesFlags flags, u32 payload, u32 subreport) {
+    m_software.Flush(); // a semaphore: the program may read what's been drawn once it sees it
     if (!gpu_memory) {
         return;
     }
@@ -309,8 +313,12 @@ void RasterizerNull::Query(GPUVAddr gpu_addr, VideoCommon::QueryType type,
