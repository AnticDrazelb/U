+namespace {
+
+/// A render target a draw writes: its format, layout (block linear: GOBs of 512 bytes, 8 rows of
+/// 64; or pitch), blending and colour mask
+using Factor = Maxwell::Regs::Blend::Factor;
+using Equation = Maxwell::Regs::Blend::Equation;
+struct Target {
+    u32 attachment; // the fragment shader's output
+    Tegra::RenderTargetFormat format;
+    GPUVAddr address;
+    bool pitch_linear;
+    u32 pitch, bpp, width, height;
+    u32 block_rows, block_bytes, gobs_in_x;
+    u64 block_row_size;
+    bool blend, bgra, write_any, write_all, fast_write, alpha_by_one;
+    std::array<bool, 4> write_channel;
+    Equation color_op, alpha_op;
+    Factor color_src, color_dst, alpha_src, alpha_dst;
+};
+
+/// A varying the fragment shader reads, and how it's interpolated
+struct Varying {
+    u16 input;  // its attribute
+    u16 vertex; // its place in a vertex's varyings
+    Shader::Interpolation interpolation;
+};
+
+/// A face's stencil test and updates
+using StencilOpKind = Maxwell::Regs::StencilOp::Op;
+struct StencilFace {
+    StencilOpKind fail, zfail, zpass;
+    Maxwell::Regs::ComparisonOp func;
+    u8 ref, func_mask, write_mask;
+};
+
+u8 StencilOpApply(StencilOpKind op, u8 value, u8 ref) {
+    switch (op) {
+    case StencilOpKind::Zero_D3D: case StencilOpKind::Zero_GL: return 0;
+    case StencilOpKind::Replace_D3D: case StencilOpKind::Replace_GL: return ref;
+    case StencilOpKind::IncrSaturate_D3D: case StencilOpKind::IncrSaturate_GL: return value == 0xFF ? value : u8(value + 1);
+    case StencilOpKind::DecrSaturate_D3D: case StencilOpKind::DecrSaturate_GL: return value == 0 ? value : u8(value - 1);
+    case StencilOpKind::Invert_D3D: case StencilOpKind::Invert_GL: return u8(~value);
+    case StencilOpKind::Incr_D3D: case StencilOpKind::Incr_GL: return u8(value + 1);
+    case StencilOpKind::Decr_D3D: case StencilOpKind::Decr_GL: return u8(value - 1);
+    default: return value; // keep
+    }
+}
+
+/// A triangle set up for rasterizing: window coordinates in 24.8 fixed point (edge functions
+/// exact, edges shared by two triangles drawn once by the top-left rule), its varyings in the
+/// draw's varying data
+struct Triangle {
+    std::array<s32, 3> x, y;
+    std::array<f32, 3> z, inv_w;
+    f32 inv_area;
+    bool front;
+    bool affine; // its vertices' w the same (2D): no perspective correction to do
+    s32 x0, y0, x1, y1; // the pixels it may cover
+    size_t varyings;
+};
+
+} // Anonymous namespace
+
+/// A draw set up and kept for rasterizing: everything its pixels need. Small draws are queued and
+/// rasterized together, a GOB row at a time across the rasterizing threads (each row in draw
+/// order, so the pixels come out as drawn one by one).
+struct SoftwareDraw::Batch {
+    Tegra::MemoryManager* memory = nullptr;
+    Program* fs = nullptr;
+    std::array<std::vector<u32>, 18> fs_cbufs;
+    std::vector<Binding> fs_textures;
+    std::vector<StorageBuffer> fs_storage;
+    std::vector<Target> targets;
+    std::array<f32, 4> blend_constant{};
+    std::vector<Varying> varyings;
+    std::vector<Triangle> triangles;
+    std::vector<f32> varying_data;
+    bool zs_test = false, depth_test = false, stencil_test = false, depth_write = false;
+    Tegra::DepthFormat zeta_format{};
+    u32 zeta_bpp = 0;
+    Maxwell::Regs::ComparisonOp depth_func{};
+    StencilFace front_stencil{}, back_stencil{};
+    GPUVAddr zeta_address = 0;
+    bool zeta_pitch_linear = false;
+    u32 zeta_width = 0, zeta_block_rows = 0, zeta_block_bytes = 0, zeta_gobs_in_x = 0;
+    u64 zeta_block_row_size = 0;
+    s32 rows_begin = 0, rows_end = 0; // the pixel rows its triangles cover
+    u64 pixels = 0;                   // their bounding boxes' pixels
+};
+
 /// A rasterizing thread's state: the fragment shader's values and its inputs and outputs
 struct SoftwareDraw::Raster {
     std::vector<Lanes> cells;
@@ -1433,6 +1530,7 @@ struct SoftwareDraw::Raster {
     std::array<bool, LANES> stencil_pass{};
     std::array<bool, LANES> depth_pass{};
     bool blend_ok = true;
+    const Program* program = nullptr; // whose values 'cells' holds
 };
 
