-    u64 marks = 0, textures_hashed = 0, bytes_hashed = 0, textures_decoded = 0;
+    u64 marks = 0, textures_hashed = 0, bytes_hashed = 0, textures_decoded = 0, flushes = 0;
     u32 threads = 1;
     Clock::duration setup{}, raster{};
 
@@ -2916,14 +3026,14 @@ struct Stats {
         const f64 seconds = std::chrono::duration<f64>(now - last).count();
         const auto ms = [&](Clock::duration d) { return std::chrono::duration<f64, std::milli>(d).count() / seconds; };
         LOG_WARNING(Render, "Software draw: a second: {:.0f} draws, {:.0f} triangles, {:.0f} k fragments; "
-                            "{:.1f} ms setting up, {:.1f} ms rasterizing (on up to {} threads); "
+                            "{:.1f} ms setting up, {:.1f} ms rasterizing ({:.0f} batches, on up to {} threads); "
                             "textures: {:.0f} writes marked, {:.0f} checked ({:.1f} MB hashed), {:.0f} decoded",
                     f64(draws) / seconds, f64(triangles) / seconds, f64(fragments) / seconds / 1000.0,
-                    ms(setup), ms(raster), threads, f64(marks) / seconds, f64(textures_hashed) / seconds,
+                    ms(setup), ms(raster), f64(flushes) / seconds, threads, f64(marks) / seconds, f64(textures_hashed) / seconds,
