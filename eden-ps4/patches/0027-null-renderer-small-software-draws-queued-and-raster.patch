     }
 };
@@ -2935,6 +3045,371 @@ Stats& GetStats() {
 
 } // Anonymous namespace
 
+void SoftwareDraw::RasterRows(Batch& b, Raster& st, s32 row_begin, s32 row_end) {
+    Tegra::MemoryManager& gpu_memory = *b.memory;
+    const auto& targets = b.targets;
+    const auto& triangles = b.triangles;
+    const auto& varying_data = b.varying_data;
+    const auto& varyings = b.varyings;
+    const size_t num_varyings = varyings.size();
+    Program* const fs = b.fs;
+    const auto& fs_cbufs = b.fs_cbufs;
+    const auto& fs_textures = b.fs_textures;
+    const auto& fs_storage = b.fs_storage;
+    const auto& blend_constant = b.blend_constant;
+    const bool zs_test = b.zs_test, depth_test = b.depth_test, stencil_test = b.stencil_test;
+    const bool depth_write = b.depth_write;
+    const auto zeta_format = b.zeta_format;
+    const u32 zeta_bpp = b.zeta_bpp;
+    const auto depth_func = b.depth_func;
+    const StencilFace& front_stencil = b.front_stencil;
+    const StencilFace& back_stencil = b.back_stencil;
+    const GPUVAddr zeta_address = b.zeta_address;
+    const bool zeta_pitch_linear = b.zeta_pitch_linear;
+    const u32 zeta_width = b.zeta_width, zeta_block_rows = b.zeta_block_rows;
+    const u32 zeta_block_bytes = b.zeta_block_bytes, zeta_gobs_in_x = b.zeta_gobs_in_x;
+    const u64 zeta_block_row_size = b.zeta_block_row_size;
+    std::array<GPUVAddr, 8> gob_row_address{};
+    for (size_t ti = 0; ti < targets.size(); ++ti) {
+        const Target& tg = targets[ti];
+        st.gobs[ti].assign(tg.gobs_in_x, nullptr);
+        gob_row_address[ti] = tg.address + u64(u32(row_begin) / tg.block_rows) * tg.block_row_size +
+                              u64{u32(row_begin) % tg.block_rows / 8} * 512;
+    }
+    const auto pixel = [&](size_t ti, s32 x, s32 y) -> u8* {
+        const Target& tg = targets[ti];
+        if (u32(x) >= tg.width || u32(y) >= tg.height) {
+            return nullptr;
+        }
+        if (tg.pitch_linear) {
+            return gpu_memory.GetPointer(tg.address + u64(y) * tg.pitch + u64(x) * tg.bpp);
+        }
+        const u32 xb = u32(x) * tg.bpp;
+        const u32 column = xb / 64;
+        u8*& gob = st.gobs[ti][column];
+        if (!gob) {
+            gob = gpu_memory.GetPointer(gob_row_address[ti] + u64{column} * tg.block_bytes);
+            if (!gob) {
+                return nullptr;
+            }
+        }
+        const u32 row = u32(y) % 8, in_gob = xb % 64;
+        return gob + (row / 2) * 64 + (row % 2) * 16 + (in_gob / 32) * 256 + ((in_gob % 32) / 16) * 32 + in_gob % 16;
+    };
+    if (zs_test) {
+        st.zeta_gobs.assign(zeta_gobs_in_x, nullptr);
+    }
+    const GPUVAddr zeta_gob_row_address = zeta_address + u64(u32(row_begin) / zeta_block_rows) * zeta_block_row_size +
+                                          u64{u32(row_begin) % zeta_block_rows / 8} * 512;
+    const auto depth_pixel = [&](s32 x, s32 y) -> u8* {
+        if (zeta_pitch_linear) {
+            return gpu_memory.GetPointer(zeta_address + (u64(y) * zeta_width + u64(x)) * zeta_bpp);
+        }
+        const u32 xb = u32(x) * zeta_bpp;
+        const u32 column = xb / 64;
+        u8*& gob = st.zeta_gobs[column];
+        if (!gob) {
+            gob = gpu_memory.GetPointer(zeta_gob_row_address + u64{column} * zeta_block_bytes);
+            if (!gob) {
+                return nullptr;
+            }
+        }
+        const u32 row = u32(y) % 8, in_gob = xb % 64;
+        return gob + (row / 2) * 64 + (row % 2) * 16 + (in_gob / 32) * 256 + ((in_gob % 32) / 16) * 32 + in_gob % 16;
+    };
+    f32* const in = st.inputs.data();
+    const auto input = [&](IR::Attribute attribute) { return in + static_cast<u32>(attribute) * LANES; };
+    Io io{in, st.outputs.data(), st.colors.data(), st.discard.data(), LANES, 0,
+          &fs_cbufs, st.local.data(), fs->local_words, &fs_textures, &fs_storage, &gpu_memory};
+    for (const Triangle& t : triangles) {
+        const s32 ys = std::max(t.y0, row_begin), ye = std::min(t.y1, row_end);
+        if (ys >= ye) {
+            continue;
+        }
+        // edge i: from vertex i+1 to i+2; steps per pixel, and the top-left rule's bias
+        s64 step_x[3], step_y[3], bias[3];
+        for (u32 i = 0; i < 3; ++i) {
+            const u32 a = (i + 1) % 3, b = (i + 2) % 3;
+            step_x[i] = -s64(t.y[b] - t.y[a]) * 256;
+            step_y[i] = s64(t.x[b] - t.x[a]);
+            const bool top_left = t.y[a] > t.y[b] || (t.y[a] == t.y[b] && t.x[b] > t.x[a]);
+            bias[i] = top_left ? 0 : -1;
+        }
+        const f32* const data = varying_data.data() + t.varyings;
+        std::fill_n(input(IR::Attribute::FrontFace), LANES, std::bit_cast<f32>(t.front ? 0xFFFFFFFFu : 0u));
+        for (s32 y = ys; y < ye; ++y) {
+            // the row's span: where all three edge functions are positive
+            const s64 py = s64(y) * 256 + 128, px = s64(t.x0) * 256 + 128;
+            s64 e[3];
+            s32 xs = t.x0, xe = t.x1;
+            for (u32 i = 0; i < 3; ++i) {
+                const u32 a = (i + 1) % 3;
+                e[i] = step_x[i] / 256 * (px - t.x[a]) + step_y[i] * (py - t.y[a]) + bias[i];
+                if (step_x[i] > 0) {
+                    if (e[i] < 0) {
+                        xs = std::max<s64>(xs, t.x0 + (-e[i] + step_x[i] - 1) / step_x[i]);
+                    }
+                } else if (step_x[i] < 0) {
+                    xe = e[i] < 0 ? xs : std::min<s64>(xe, t.x0 + e[i] / -step_x[i] + 1);
+                } else if (e[i] < 0) {
+                    xe = xs;
+                }
+            }
+            for (s32 bx = xs; bx < xe; bx += s32(LANES)) {
