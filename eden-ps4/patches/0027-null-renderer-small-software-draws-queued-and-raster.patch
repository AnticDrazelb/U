+/// Rasterizes the queued draws: a GOB row (8 pixel rows) at a time, on the rasterizing threads when
+/// there's enough to share, otherwise on this one
+void SoftwareDraw::Flush() {
+    if (queue.empty()) {
+        return;
+    }
+    Stats& stats = GetStats();
+    const auto raster_start = Stats::Clock::now();
+    s32 rows_begin = std::numeric_limits<s32>::max(), rows_end = 0;
+    u64 pixels = 0;
+    for (const auto& batch : queue) {
+        rows_begin = std::min(rows_begin, batch->rows_begin);
+        rows_end = std::max(rows_end, batch->rows_end);
+        pixels += batch->pixels;
+    }
+    const s32 first_gob_row = rows_begin / 8;
+    const u32 jobs = u32((rows_end + 7) / 8 - first_gob_row);
+    const auto job = [&](u32 index, u32 thread) {
+        const s32 begin = (first_gob_row + s32(index)) * 8;
+        const s32 row_begin = std::max(begin, rows_begin), row_end = std::min(begin + 8, rows_end);
+        Raster& st = raster[thread];
+        for (const auto& batch : queue) {
+            if (batch->rows_end <= row_begin || batch->rows_begin >= row_end) {
+                continue;
+            }
+            if (st.program != batch->fs) {
+                Broadcast(batch->fs->cells, st.cells);
+                st.local.assign(batch->fs->local_words + 1, 0);
+                st.program = batch->fs;
+            }
+            RasterRows(*batch, st, std::max(row_begin, batch->rows_begin), std::min(row_end, batch->rows_end));
+        }
+    };
+    constexpr u64 shared_pixels = 8192;
+    const u32 threads = pixels >= shared_pixels && jobs > 1 ? RasterThreads() : 1;
+    raster.resize(std::max<size_t>(raster.size(), threads));
+    for (u32 i = 0; i < threads; ++i) {
+        raster[i].program = nullptr;
+        raster[i].blend_ok = true;
+    }
+    if (threads > 1) {
+        workers->Run(jobs, job);
+    } else {
+        for (u32 index = 0; index < jobs; ++index) {
+            job(index, 0);
+        }
+    }
+    for (u32 i = 0; i < threads; ++i) {
+        if (!raster[i].blend_ok) {
+            LogOnce("a blend factor or equation not handled");
+        }
+    }
+    queue.clear();
+    queued_pixels = 0;
+    pending_texture_writes = false;
+    if (stats.enabled) {
+        stats.raster += Stats::Clock::now() - raster_start;
+        stats.threads = std::max(stats.threads, threads);
+        stats.flushes++;
+    }
+}
