+    // The render targets the fragment shader's outputs go to, each with its own format, layout
+    // (block linear: GOBs of 512 bytes, 8 rows of 64; or pitch), blending and colour mask
+    using Factor = Maxwell::Regs::Blend::Factor;
+    using Equation = Maxwell::Regs::Blend::Equation;
+    struct Target {
+        u32 attachment; // the fragment shader's output
+        Tegra::RenderTargetFormat format;
+        GPUVAddr address;
+        bool pitch_linear;
+        u32 pitch, bpp, width, height;
+        u32 block_rows, block_bytes, gobs_in_x;
+        u64 block_row_size;
+        bool blend, bgra, write_any, write_all, fast_write, alpha_by_one;
+        std::array<bool, 4> write_channel;
+        Equation color_op, alpha_op;
+        Factor color_src, color_dst, alpha_src, alpha_dst;
+    };
+    std::vector<Target> targets;
+    const std::array<f32, 4> blend_constant{regs.blend_color.r, regs.blend_color.g,
+                                            regs.blend_color.b, regs.blend_color.a};
+    const auto is = [](Factor f, Factor d3d, Factor gl) { return f == d3d || f == gl; };
+    const auto is_add = [](Equation e) { return e == Equation::Add_D3D || e == Equation::Add_GL; };
+    for (u32 attachment = 0; attachment < std::min<u32>(regs.rt_control.count, 8); ++attachment) {
+        const auto& rt = regs.rt[regs.rt_control.Map(attachment)];
+        Target tg{};
+        std::array<u8, 16> probe{};
+        if (rt.Address() == 0 || !EncodeColor(rt.format, {0, 0, 0, 0}, probe, tg.bpp)) {
+            if (rt.Address() != 0) {
+                LogOnce(fmt::format("render target format {:#x} not handled", static_cast<u32>(rt.format)));
+            }
+            continue;
+        }
+        tg.attachment = attachment;
+        tg.format = rt.format;
+        tg.address = rt.Address();
+        tg.pitch_linear = rt.tile_mode.is_pitch_linear != 0;
+        tg.pitch = rt.width; // a pitch render target's width is its pitch
+        tg.width = tg.pitch_linear ? rt.width / tg.bpp : rt.width;
+        tg.height = rt.height;
+        tg.block_rows = tg.pitch_linear ? 8 : 8u << rt.tile_mode.block_height;
+        tg.block_bytes = 512u << rt.tile_mode.block_height;
+        tg.gobs_in_x = (tg.width * tg.bpp + 63) / 64;
+        tg.block_row_size = u64{tg.gobs_in_x} * tg.block_bytes;
+        tg.blend = regs.blend.enable[attachment] != 0;
+        bool separate_alpha;
+        if (regs.blend_per_target_enabled) {
+            const auto& target = regs.blend_per_target[attachment];
+            tg.color_op = target.color_op, tg.color_src = target.color_source, tg.color_dst = target.color_dest;
+            tg.alpha_op = target.alpha_op, tg.alpha_src = target.alpha_source, tg.alpha_dst = target.alpha_dest;
+            separate_alpha = target.separate_alpha != 0;
+        } else {
+            tg.color_op = regs.blend.color_op, tg.color_src = regs.blend.color_source, tg.color_dst = regs.blend.color_dest;
+            tg.alpha_op = regs.blend.alpha_op, tg.alpha_src = regs.blend.alpha_source, tg.alpha_dst = regs.blend.alpha_dest;
+            separate_alpha = regs.blend.separate_alpha != 0;
+        }
+        if (!separate_alpha) {
+            tg.alpha_op = tg.color_op, tg.alpha_src = tg.color_src, tg.alpha_dst = tg.color_dst;
+        }
+        const auto& mask = regs.color_mask[regs.color_mask_common ? 0 : attachment];
+        tg.write_channel = {mask.R != 0, mask.G != 0, mask.B != 0, mask.A != 0};
+        tg.write_any = tg.write_channel[0] || tg.write_channel[1] || tg.write_channel[2] || tg.write_channel[3];
+        tg.write_all = tg.write_channel[0] && tg.write_channel[1] && tg.write_channel[2] && tg.write_channel[3];
+        tg.bgra = rt.format == Tegra::RenderTargetFormat::A8R8G8B8_UNORM ||
+                  rt.format == Tegra::RenderTargetFormat::A8R8G8B8_SRGB;
+        // the commonest cases done in integers: RGBA8 targets written whole, opaque or blended by
+        // source alpha (alpha itself by source alpha, or one)
+        const bool rgba8 = tg.write_all && (rt.format == Tegra::RenderTargetFormat::A8B8G8R8_UNORM ||
+                                            rt.format == Tegra::RenderTargetFormat::A8R8G8B8_UNORM);
+        const bool source_alpha_blend =
+            tg.blend && is_add(tg.color_op) && is_add(tg.alpha_op) &&
+            is(tg.color_src, Factor::SourceAlpha_D3D, Factor::SourceAlpha_GL) &&
+            is(tg.color_dst, Factor::OneMinusSourceAlpha_D3D, Factor::OneMinusSourceAlpha_GL) &&
+            (is(tg.alpha_src, Factor::SourceAlpha_D3D, Factor::SourceAlpha_GL) || is(tg.alpha_src, Factor::One_D3D, Factor::One_GL)) &&
+            is(tg.alpha_dst, Factor::OneMinusSourceAlpha_D3D, Factor::OneMinusSourceAlpha_GL);
+        tg.alpha_by_one = is(tg.alpha_src, Factor::One_D3D, Factor::One_GL);
+        tg.fast_write = rgba8 && (!tg.blend || source_alpha_blend);
+        targets.push_back(tg);
     }
