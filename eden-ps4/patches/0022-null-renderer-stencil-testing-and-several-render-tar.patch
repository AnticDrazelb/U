-    std::vector<u8*> gobs; // the render target's GOBs in the row being drawn, as they're reached
-    std::vector<u8*> zeta_gobs; // the depth buffer's
+    std::array<std::vector<u8*>, 8> gobs; // each render target's GOBs in the row being drawn, as
+                                          // they're reached
+    std::vector<u8*> zeta_gobs;           // the depth buffer's
     std::array<u8*, LANES> depth_pixel{};
     std::array<u32, LANES> depth_value{};
+    std::array<u8, LANES> stencil_value{};
+    std::array<bool, LANES> stencil_pass{};
     std::array<bool, LANES> depth_pass{};
     bool blend_ok = true;
 };
