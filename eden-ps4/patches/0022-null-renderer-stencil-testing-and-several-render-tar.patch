Subject: [PATCH] null renderer: stencil testing and several render targets in
 software draws

---
 .../renderer_null/software_draw.cpp           | 417 ++++++++++++------
 src/video_core/renderer_null/software_draw.h  |   5 +-
 2 files changed, 278 insertions(+), 144 deletions(-)

diff --git a/src/video_core/renderer_null/software_draw.cpp b/src/video_core/renderer_null/software_draw.cpp
index 55765ed56..ebd703535 100644
--- a/src/video_core/renderer_null/software_draw.cpp
+++ b/src/video_core/renderer_null/software_draw.cpp
@@ -337,6 +337,22 @@ void WriteDepth(Tegra::DepthFormat format, u8* pixel, u32 value) {
     std::memcpy(pixel, &v, 4);
 }
 
+bool HasStencil(Tegra::DepthFormat format) {
+    using D = Tegra::DepthFormat;
+    return format == D::Z24_UNORM_S8_UINT || format == D::S8Z24_UNORM ||
+           format == D::Z32_FLOAT_X24S8_UINT || format == D::S8_UINT;
+}
+
+u8 ReadStencil(Tegra::DepthFormat format, const u8* pixel) {
+    using D = Tegra::DepthFormat;
+    switch (format) {
+    case D::Z24_UNORM_S8_UINT: case D::S8_UINT: return pixel[0];
+    case D::S8Z24_UNORM: return pixel[3];
+    case D::Z32_FLOAT_X24S8_UINT: return pixel[4];
+    default: return 0;
+    }
+}
+
 void WriteStencil(Tegra::DepthFormat format, u8* pixel, u8 stencil) {
     using D = Tegra::DepthFormat;
     switch (format) {
@@ -1383,6 +1399,7 @@ struct SoftwareDraw::Program {
     bool one_lane = false; // it branches (or uses local memory): run a pixel at a time
     std::vector<Shader::StorageBufferDescriptor> storage;
     bool writes_depth = false;
+    bool can_discard = false;
 };
 
 struct SoftwareDraw::Textures {
@@ -1400,10 +1417,13 @@ struct SoftwareDraw::Raster {
     std::array<f32, 256 * LANES> outputs{};
     std::array<f32, 8 * 4 * LANES> colors{};
