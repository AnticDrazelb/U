     GenTerminalHandlers();
     code.PreludeComplete();
     code.EnableColdCode(this->conf.split_cold_code);
+    zero_extend_known_zero_upper = this->conf.skip_redundant_extensions;
     ClearFastDispatchTable();
 
     if (conf.fastmem_pointer.has_value()) {
@@ -469,6 +470,55 @@ void A64EmitX64::PeepholeQuad(A64EmitContext& ctx, IR::Block& block) {
         if (bits != 0)
             zero_upper.emplace_back(&inst, bits);
     }
+    // (PS4 04.30) a LeastSignificantWord whose every use reads the low 32 bits of its register
+    // alone (32-bit x64 operations, cmov, a 32-bit store): the register as it is, no mov r32, r32
+    // and no copy of the 64-bit value to make one
+    low_word_only.clear();
+    if (!conf.skip_redundant_extensions)
+        return;
+    for (auto& inst : block.instructions) {
+        if (inst.GetOpcode() == IR::Opcode::LeastSignificantWord && !inst.GetArg(0).IsImmediate())
+            low_word_only.push_back(&inst);
+    }
+    if (low_word_only.empty())
+        return;
+    for (auto& inst : block.instructions) {
+        const auto op = inst.GetOpcode();
+        for (size_t i = 0; i < inst.NumArgs(); ++i) {
+            const IR::Value arg = inst.GetArg(i);
+            if (arg.IsImmediate() || arg.GetInst()->GetOpcode() != IR::Opcode::LeastSignificantWord)
+                continue;
+            bool low = false;
+            switch (op) {
+            case IR::Opcode::Add32:
+            case IR::Opcode::Sub32:
+            case IR::Opcode::Mul32:
+            case IR::Opcode::And32:
+            case IR::Opcode::AndNot32:
+            case IR::Opcode::Or32:
+            case IR::Opcode::Eor32:
+                low = i < 2;
+                break;
+            case IR::Opcode::Not32:
+            case IR::Opcode::LogicalShiftLeft32:
+            case IR::Opcode::LogicalShiftRight32:
+            case IR::Opcode::ArithmeticShiftRight32:
+                low = i == 0;
+                break;
+            case IR::Opcode::ConditionalSelect32:
+            case IR::Opcode::ConditionalSelectHost32:
+                low = i == 1 || i == 2;
+                break;
+            case IR::Opcode::A64WriteMemory32:
+                low = i == 2;
+                break;
+            default:
+                break;
+            }
+            if (!low)
+                low_word_only.erase(std::remove(low_word_only.begin(), low_word_only.end(), arg.GetInst()), low_word_only.end());
+        }
+    }
 }
 
