diff --git a/src/dynarmic/src/dynarmic/backend/x64/emit_x64.h b/src/dynarmic/src/dynarmic/backend/x64/emit_x64.h
index dce1039673..444886bad1 100644
--- a/src/dynarmic/src/dynarmic/backend/x64/emit_x64.h
+++ b/src/dynarmic/src/dynarmic/backend/x64/emit_x64.h
@@ -146,6 +146,58 @@ public:
         }
         return 0;
     }
+    // (PS4 04.30) A value of 32 bits or fewer whose host register is zero above 32 bits by how it
+    // was made: a 32-bit x64 operation (add/lea, sub, imul, and, andn, or, xor, not, cmov, shifts
+    // without a carry out, mov r32, movzx) or a load of 32 bits or fewer not sign-extended (mov,
+    // movzx; the fallbacks' ZeroExtendFrom). Moves keep it so (EmitMove: 32-bit moves and spills
+    // for these widths; movd from an XMM). Storing it as a W register or widening it to 64 bits
+    // then needs no mov r32, r32 while it is in a GPR (A64SetW, ZeroExtendWordToLong).
+    // (PS4 04.30) LeastSignificantWords whose uses read the low 32 bits alone (PeepholeQuad): the
+    // 64-bit value's register as it is (EmitLeastSignificantWord); not zero above 32 bits then
+    boost::container::small_vector<const IR::Inst*, 16> low_word_only;
+    bool IsLowWordOnly(const IR::Inst* inst) const {
+        return std::find(low_word_only.begin(), low_word_only.end(), inst) != low_word_only.end();
+    }
+    // (PS4 04.30) ZeroExtendWordToLong of a value GprZeroUpper32 knows in a GPR: that register
+    bool zero_extend_known_zero_upper = false;
+    bool GprZeroUpper32(const IR::Inst* inst) const {
+        // (an extension the pre-passes took out is an Identity of the load now)
+        while (inst->GetOpcode() == IR::Opcode::Identity) {
+            if (inst->GetArg(0).IsImmediate())
+                return false;
+            inst = inst->GetArg(0).GetInst();
+        }
+        switch (inst->GetOpcode()) {
+        case IR::Opcode::Add32:
+        case IR::Opcode::Sub32:
+        case IR::Opcode::Mul32:
+        case IR::Opcode::And32:
+        case IR::Opcode::Eor32:
+        case IR::Opcode::Or32:
+        case IR::Opcode::Not32:
+        case IR::Opcode::AndNot32:
+        case IR::Opcode::ConditionalSelect32:
+        case IR::Opcode::ConditionalSelectHost32:
+        case IR::Opcode::LeastSignificantWord:
+            return !IsLowWordOnly(inst);
+        case IR::Opcode::ZeroExtendByteToWord:
+        case IR::Opcode::ZeroExtendHalfToWord:
+            return true;
+        case IR::Opcode::LogicalShiftLeft32:
+        case IR::Opcode::LogicalShiftRight32:
+        case IR::Opcode::ArithmeticShiftRight32:
+            // (the carry-out forms shift in 64 bits: ASR's movsxd, sar)
+            return !const_cast<IR::Inst*>(inst)->GetAssociatedPseudoOperation(IR::Opcode::GetCarryFromOp);
+        case IR::Opcode::A64GetW:
+            return SignedLoadBits(inst) != 64;
+        case IR::Opcode::A64ReadMemory8:
+        case IR::Opcode::A64ReadMemory16:
+        case IR::Opcode::A64ReadMemory32:
+            return SignedLoadBits(inst) == 0 && !IsXmmLoad(inst);
+        default:
+            return false;
+        }
+    }
     // (PS4 04.26) A load whose one use sign-extends it (LDRSB, LDRSH, LDRSW), with fastmem: loaded
     // with movsx/movsxd to 32 or 64 bits, the extension then nothing
     static constexpr size_t SignedLoadTag32 = 0x200, SignedLoadTag64 = 0x400;
