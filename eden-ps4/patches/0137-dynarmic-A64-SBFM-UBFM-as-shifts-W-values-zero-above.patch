+        code.mov(to_store.cvt32(), args[1].GetImmediateU32());
+        code.mov(addr, to_store);
     } else {
         // TODO: zext tracking, xmm variant
         const Xbyak::Reg64 to_store = ctx.reg_alloc.UseScratchGpr(code, args[1]);
