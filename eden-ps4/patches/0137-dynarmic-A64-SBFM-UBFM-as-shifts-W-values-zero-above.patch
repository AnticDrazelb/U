diff --git a/src/dynarmic/src/dynarmic/frontend/A64/translate/impl/data_processing_bitfield.cpp b/src/dynarmic/src/dynarmic/frontend/A64/translate/impl/data_processing_bitfield.cpp
index aec6729ad8..9fb6649ae9 100644
--- a/src/dynarmic/src/dynarmic/frontend/A64/translate/impl/data_processing_bitfield.cpp
+++ b/src/dynarmic/src/dynarmic/frontend/A64/translate/impl/data_processing_bitfield.cpp
@@ -7,6 +7,34 @@
 
 namespace Dynarmic::A64 {
 
+namespace {
+// (PS4 04.30, TranslationOptions::bitfield_shifts) SBFM/UBFM of datasize d with immr R, imms S as
+// shifts: a field S..R (S >= R: SBFX, UBFX, LSR) moved down, or bits S..0 (S < R: SBFIZ, UBFIZ,
+// LSL) moved up to bit d - R, sign- or zero-extended above. One shift (LSL, LSR), a shift and an
+// AND with a mask an imm32 holds (UBFX, UBFIZ, UXTB, UXTH), or a left shift then a right one.
+IR::U32U64 BitfieldShifts(IREmitter& ir, bool is_signed, size_t d, IR::U32U64 src, unsigned R, unsigned S) {
+    const auto mask = [&](unsigned w) { return d == 32 ? IR::U32U64{ir.Imm32(u32((u64{1} << w) - 1))} : IR::U32U64{ir.Imm64((u64{1} << w) - 1)}; };
+    const auto shl = [&](IR::U32U64 v, unsigned n) { return n == 0 ? v : ir.LogicalShiftLeft(v, ir.Imm8(u8(n))); };
+    const auto shr = [&](IR::U32U64 v, unsigned n) {
+        return n == 0 ? v : is_signed ? ir.ArithmeticShiftRight(v, ir.Imm8(u8(n))) : ir.LogicalShiftRight(v, ir.Imm8(u8(n)));
+    };
+    if (S >= R) {
+        const unsigned w = S - R + 1;
+        if (S == d - 1)
+            return shr(src, R);
+        if (!is_signed && w < 32)
+            return ir.And(shr(src, R), mask(w));
+        return shr(shl(src, unsigned(d) - 1 - S), unsigned(d) - w);
+    }
+    const unsigned lsb = unsigned(d) - R, w = S + 1;
+    if (S + 1 == R)
+        return shl(src, lsb);
+    if (!is_signed && w < 32)
+        return shl(ir.And(src, mask(w)), lsb);
+    return shr(shl(src, unsigned(d) - w), unsigned(d) - w - lsb);
+}
+}  // namespace
+
 bool TranslatorVisitor::SBFM(bool sf, bool N, Imm<6> immr, Imm<6> imms, Reg Rn, Reg Rd) {
     if (sf && !N) {
         return ReservedValue();
@@ -26,6 +54,11 @@ bool TranslatorVisitor::SBFM(bool sf, bool N, Imm<6> immr, Imm<6> imms, Reg Rn,
     const size_t datasize = sf ? 64 : 32;
     const auto src = X(datasize, Rn);
 
+    if (options.bitfield_shifts) {
+        X(datasize, Rd, BitfieldShifts(ir, true, datasize, src, R, S));
+        return true;
+    }
+
     auto bot = ir.And(ir.RotateRight(src, ir.Imm8(R)), I(datasize, masks->wmask));
     auto top = ir.ReplicateBit(src, S);
 
@@ -78,6 +111,10 @@ bool TranslatorVisitor::UBFM(bool sf, bool N, Imm<6> immr, Imm<6> imms, Reg Rn,
 
     const size_t datasize = sf ? 64 : 32;
     const auto src = X(datasize, Rn);
+    if (options.bitfield_shifts) {
+        X(datasize, Rd, BitfieldShifts(ir, false, datasize, src, R, imms.ZeroExtend<u8>()));
+        return true;
+    }
     const auto bot = ir.And(ir.RotateRight(src, ir.Imm8(R)), I(datasize, masks->wmask));
 
     X(datasize, Rd, ir.And(bot, I(datasize, masks->tmask)));
