+    case O::LoadSharedU16: case O::LoadSharedS16: case O::WriteSharedU16:
+        return 2;
+    case O::LoadSharedU64: case O::WriteSharedU64:
+        return 8;
+    case O::LoadSharedU128: case O::WriteSharedU128:
