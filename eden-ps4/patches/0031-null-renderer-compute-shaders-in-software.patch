+/// The compute engine's program, found as GetProgram finds a stage's
+SoftwareDraw::Program* SoftwareDraw::GetComputeProgram(Tegra::Engines::KeplerCompute& kepler_compute,
+                                                       Tegra::MemoryManager& gpu_memory) {
+    const GPUVAddr base = kepler_compute.regs.code_loc.Address();
+    const u32 start = kepler_compute.launch_description.program_start;
+    const u64 recent_key = (base + start) ^ (u64{7} << 60);
+    RecentProgram& recent = recent_programs[recent_key];
+    if (recent.program && recent.frame == frame_count) {
+        return recent.program;
+    }
+    if (recent.program && !recent.code.empty()) {
+        code_scratch.resize(recent.code.size());
+        gpu_memory.ReadBlockUnsafe(recent.address, code_scratch.data(), code_scratch.size());
+        if (code_scratch == recent.code) {
+            recent.frame = frame_count;
+            return recent.program;
+        }
+    }
+    VideoCommon::ComputeEnvironment env{kepler_compute, gpu_memory, base, start};
+    const std::optional<u64> hash = env.Analyze();
+    if (!hash) {
+        LogOnce("a compute program whose end can't be found");
+        return nullptr;
+    }
+    const auto& qmd = kepler_compute.launch_description;
+    const u64 key = *hash ^ (u64{7} << 60) ^ (u64{start} << 32) ^ (u64{qmd.shared_alloc} << 8);
+    recent.frame = frame_count;
+    recent.address = base + start;
+    recent.size = env.CachedSizeBytes();
+    recent.code.resize(recent.size);
+    gpu_memory.ReadBlockUnsafe(recent.address, recent.code.data(), recent.code.size());
+    recent.device_range = false;
+    if (gpu_memory.IsContinuousRange(recent.address, recent.size)) {
+        if (const auto device = gpu_memory.GpuToCpuAddress(recent.address)) {
+            recent.device_address = *device;
+            recent.device_range = true;
+        }
+    }
+    if (const auto it = programs.find(key); it != programs.end()) {
+        recent.program = it->second.get();
+        return recent.program;
+    }
+    recent.program = programs.emplace(key, Translate(env, static_cast<u32>(env.StartAddress()), false)).first->second.get();
     return recent.program;
 }
 
+/// A dispatch: every workgroup in turn, its invocations 16 at a time. A program with barriers runs
+/// each group of 16 to the next barrier, then the next group, until all are past it.
+void SoftwareDraw::Dispatch(Tegra::Engines::KeplerCompute& kepler_compute, Tegra::MemoryManager& gpu_memory) {
+    Flush();
+    Program* const cs = GetComputeProgram(kepler_compute, gpu_memory);
+    if (!cs || !cs->ok) {
+        return;
+    }
+    const auto& qmd = kepler_compute.launch_description;
+    const auto& regs = kepler_compute.regs;
+    // constant buffers, from the launch description
+    std::array<std::vector<u32>, 18> cbufs;
+    for (u32 i = 0; i < qmd.const_buffer_config.size(); ++i) {
+        const auto& cbuf = qmd.const_buffer_config[i];
+        if (((qmd.const_buffer_enable_mask.Value() >> i) & 1) == 0 || cbuf.Address() == 0) {
+            continue;
+        }
+        cbufs[i].resize(std::min<u32>(cbuf.size, 0x10000) / 4);
+        gpu_memory.ReadBlockUnsafe(cbuf.Address(), cbufs[i].data(), cbufs[i].size() * 4);
+    }
+    const auto word = [&](u32 cbuf, u32 offset) -> u32 {
+        return cbuf < cbufs.size() && offset / 4 < cbufs[cbuf].size() ? cbufs[cbuf][offset / 4] : 0;
+    };
+    // textures, from the compute engine's pools; storage buffers, from the constant buffers
+    std::vector<Binding> bindings;
+    for (const Shader::TextureDescriptor& desc : cs->textures) {
+        for (u32 element = 0; element < std::max(desc.count, 1u); ++element) {
+            const u32 element_offset = element << desc.size_shift;
+            u32 raw = word(desc.cbuf_index, desc.cbuf_offset + element_offset);
+            if (desc.has_secondary) {
+                raw = (raw << desc.shift_left) |
+                      (word(desc.secondary_cbuf_index, desc.secondary_cbuf_offset + element_offset)
+                       << desc.secondary_shift_left);
+            }
+            const auto [tic_index, tsc_index] = Tegra::Texture::TexturePair(raw, qmd.linked_tsc != 0);
+            Binding binding;
+            if (tic_index <= regs.tic.limit) {
+                binding.texture = textures->Get(gpu_memory, regs.tic.Address() + u64{tic_index} * sizeof(Tegra::Texture::TICEntry));
+            }
+            if (tsc_index <= regs.tsc.limit) {
+                gpu_memory.ReadBlockUnsafe(regs.tsc.Address() + u64{tsc_index} * sizeof(Tegra::Texture::TSCEntry),
+                                           &binding.sampler, sizeof(binding.sampler));
+            }
+            binding.Prepare();
+            bindings.push_back(binding);
+        }
+    }
+    std::vector<StorageBuffer> storage;
+    for (const Shader::StorageBufferDescriptor& desc : cs->storage) {
+        StorageBuffer buffer;
+        buffer.address = u64{word(desc.cbuf_index, desc.cbuf_offset)} |
+                         (u64{word(desc.cbuf_index, desc.cbuf_offset + 4)} << 32);
+        const u32 size = word(desc.cbuf_index, desc.cbuf_offset + 8);
+        const bool size_follows = word(desc.cbuf_index, desc.cbuf_offset + 12) == 0 && size != 0;
+        buffer.size = size_follows ? size : 8u << 20;
+        storage.push_back(buffer);
+    }
+
+    const u32 size_x = std::max<u32>(qmd.block_dim_x, 1), size_y = std::max<u32>(qmd.block_dim_y, 1);
+    const u32 size_z = std::max<u32>(qmd.block_dim_z, 1);
+    const u32 invocations = size_x * size_y * size_z;
+    const u32 groups = (invocations + LANES - 1) / LANES;
+    // a group of 16 at a time unless there are barriers: then each group's values are kept
+    const u32 kept = cs->has_barrier ? groups : 1;
+    std::vector<std::vector<Lanes>> cells(kept);
+    for (auto& group_cells : cells) {
+        Broadcast(cs->cells, group_cells);
+    }
+    std::vector<std::vector<u32>> local(kept, std::vector<u32>(size_t(cs->local_words + 1) * LANES));
+    std::vector<RunState> states(kept);
+    std::vector<u8> shared(std::max<u32>(qmd.shared_alloc, cs->shared_bytes) + 16);
+    std::vector<f32> inputs(256 * LANES), outputs(256 * LANES), colors(32 * LANES);
+    std::array<bool, LANES> discard{};
+    std::vector<u32> local_ids(size_t(3) * LANES * groups);
+    std::vector<u32> group_lanes(groups);
+    for (u32 g = 0; g < groups; ++g) {
+        for (u32 i = 0; i < LANES; ++i) {
+            const u32 index = g * LANES + i;
+            if (index >= invocations) {
+                continue;
+            }
+            group_lanes[g] |= 1u << i;
+            local_ids[(size_t(g) * 3 + 0) * LANES + i] = index % size_x;
+            local_ids[(size_t(g) * 3 + 1) * LANES + i] = index / size_x % size_y;
+            local_ids[(size_t(g) * 3 + 2) * LANES + i] = index / (size_x * size_y);
+        }
+    }
+    Io io{inputs.data(), outputs.data(), colors.data(), discard.data(), LANES, 0,
+          &cbufs, nullptr, cs->local_words, &bindings, &storage, &gpu_memory};
+    io.quads = true; // (a subgroup of 16)
+    io.shared = shared.data();
+    io.shared_bytes = u32(shared.size() - 16);
+    const u32 grid_x = qmd.grid_dim_x, grid_y = qmd.grid_dim_y, grid_z = qmd.grid_dim_z;
+    for (u32 wz = 0; wz < grid_z; ++wz) {
+        for (u32 wy = 0; wy < grid_y; ++wy) {
+            for (u32 wx = 0; wx < grid_x; ++wx) {
+                io.workgroup_id = {wx, wy, wz};
+                std::fill(shared.begin(), shared.end(), u8{0});
+                const auto run_group = [&](u32 g, u32 slot) {
+                    io.run = io.live = group_lanes[g];
+                    io.local_id = local_ids.data() + size_t(g) * 3 * LANES;
+                    io.local = local[slot].data();
+                    io.resume = cs->has_barrier ? &states[slot] : nullptr;
+                    Run(*cs, cells[slot].data(), io, LANES);
+                };
+                if (!cs->has_barrier) {
+                    for (u32 g = 0; g < groups; ++g) {
+                        run_group(g, 0);
+                    }
+                    continue;
+                }
+                // each group to its next barrier, in turn, until none stopped at one
+                for (RunState& state : states) {
+                    state = {};
+                }
+                bool stopped = true;
+                for (u32 round = 0; stopped && round < 1u << 16; ++round) {
+                    stopped = false;
+                    for (u32 g = 0; g < groups; ++g) {
+                        if (round > 0 && !states[g].suspended) {
+                            continue; // done
+                        }
+                        run_group(g, g);
+                        stopped |= states[g].suspended;
+                    }
+                }
+            }
+        }
+    }
+    if (cs->writes_memory) {
+        MarkAllWritten(); // textures it may have written to are checked again
+    }
+}
