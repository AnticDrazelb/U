+/// An atomic operation's new value from the old one and its operand (for 32 bits)
+u32 AtomicResult(IR::Opcode op, u32 old, u32 value) {
+    using O = IR::Opcode;
+    switch (op) {
+    case O::SharedAtomicIAdd32: case O::StorageAtomicIAdd32: case O::GlobalAtomicIAdd32:
+        return old + value;
+    case O::SharedAtomicSMin32: case O::StorageAtomicSMin32: case O::GlobalAtomicSMin32:
+        return u32(std::min(s32(old), s32(value)));
+    case O::SharedAtomicUMin32: case O::StorageAtomicUMin32: case O::GlobalAtomicUMin32:
+        return std::min(old, value);
+    case O::SharedAtomicSMax32: case O::StorageAtomicSMax32: case O::GlobalAtomicSMax32:
+        return u32(std::max(s32(old), s32(value)));
+    case O::SharedAtomicUMax32: case O::StorageAtomicUMax32: case O::GlobalAtomicUMax32:
+        return std::max(old, value);
+    case O::SharedAtomicInc32: case O::StorageAtomicInc32: case O::GlobalAtomicInc32:
+        return old >= value ? 0 : old + 1;
+    case O::SharedAtomicDec32: case O::StorageAtomicDec32: case O::GlobalAtomicDec32:
+        return old == 0 || old > value ? value : old - 1;
+    case O::SharedAtomicAnd32: case O::StorageAtomicAnd32: case O::GlobalAtomicAnd32:
+        return old & value;
+    case O::SharedAtomicOr32: case O::StorageAtomicOr32: case O::GlobalAtomicOr32:
+        return old | value;
+    case O::SharedAtomicXor32: case O::StorageAtomicXor32: case O::GlobalAtomicXor32:
+        return old ^ value;
+    case O::StorageAtomicAddF32: case O::GlobalAtomicAddF32:
+        return std::bit_cast<u32>(std::bit_cast<f32>(old) + std::bit_cast<f32>(value));
+    default: // exchanges
+        return value;
+    }
+}
