     std::array<u8, 16> pixel{};
     u32 bpp = 0;
     if (!EncodeColor(rt.format, regs.clear_color, pixel, bpp)) {
@@ -180,7 +184,11 @@ void RasterizerNull::FlushRegion(DAddr addr, u64 size, VideoCommon::CacheType) {
