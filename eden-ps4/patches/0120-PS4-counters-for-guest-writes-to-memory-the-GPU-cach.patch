From 08d9206b8977af33eb226fee704808c6e526bd3f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 4 Nov 2026 01:03:25 +0000
Subject: [PATCH] PS4: counters for guest writes to memory the GPU caches (same
 page, collected, invalidating)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01REmpC53sSK3VTcKMxWFSSb
---
 src/common/ps4_perf.h |  5 +++++
 src/core/memory.cpp   | 12 ++++++++++++
 2 files changed, 17 insertions(+)

diff --git a/src/common/ps4_perf.h b/src/common/ps4_perf.h
index 67112a32fe..5367801e4a 100644
--- a/src/common/ps4_perf.h
+++ b/src/common/ps4_perf.h
@@ -105,6 +105,11 @@ inline std::atomic<uint64_t> jit_cache_loaded[4], jit_cache_used[4], jit_cache_s
 // (04.22) Per core: the guest accesses fastmem was declined for (recompiled to walk the page table
 // from then on, for every thread), and of them those through the stack pointer
 inline std::atomic<uint64_t> jit_walked_sites[4], jit_walked_stack_sites[4];
+// (04.23) Guest writes to memory the GPU caches (core/memory.cpp HandleRasterizerWrite): to the
+// page the core's last one went to (collected at once), collected for the GPU's own changes
+// (OnCPUWrite true: a buffer the GPU modified), and invalidating the GPU's caches there (OnCPUWrite
+// false: the buffer cache's and texture cache's locks, their lookups, the shader cache's)
+inline std::atomic<uint64_t> gpu_cached_writes_same{0}, gpu_cached_writes_collected{0}, gpu_cached_writes_invalidated{0};
 inline GpuThreadCounters gpu_thread;
 // (04.09) What's new to it: graphics pipelines not in the cache (the disk shader cache's are, from
 // the boot), draws skipped while their pipeline builds (asynchronous shaders), images and buffers
diff --git a/src/core/memory.cpp b/src/core/memory.cpp
index 88885b1337..f7d89df521 100644
--- a/src/core/memory.cpp
+++ b/src/core/memory.cpp
@@ -15,6 +15,7 @@
 
 #ifdef __OPENORBIS__
 #include "common/orbis_memory.h"
+#include "common/ps4_perf.h"
 #endif
 #include "common/assert.h"
 #include "common/atomic_ops.h"
@@ -751,10 +752,21 @@ struct Memory::Impl {
                     && system.GPU().OnCPUWrite(address, size);
                 if (do_collection) {
                     current_area.last_address = subaddress;
+#ifdef __OPENORBIS__
+                    ::Common::PS4Perf::gpu_cached_writes_collected.fetch_add(1, std::memory_order_relaxed);
+#endif
                 } else {
+#ifdef __OPENORBIS__
+                    ::Common::PS4Perf::gpu_cached_writes_invalidated.fetch_add(1, std::memory_order_relaxed);
+#endif
                     return;
                 }
             }
+#ifdef __OPENORBIS__
+            else {
+                ::Common::PS4Perf::gpu_cached_writes_same.fetch_add(1, std::memory_order_relaxed);
+            }
+#endif
             gpu_dirty_managers[core].Collect(address, size);
         });
     }
