 void CoreTiming::ScheduleEvent(std::chrono::nanoseconds ns_into_future,
                                const std::shared_ptr<EventType>& event_type, bool absolute_time) {
+    bool earliest = true;
     {
-        std::scoped_lock scope{basic_lock};
+        Common::SpinLockGuard scope{basic_lock, &Common::PS4Perf::lock_timing};
         const auto next_time{absolute_time ? ns_into_future : GetGlobalTimeNs() + ns_into_future};
 
-        auto h{event_queue.emplace(Event{next_time.count(), event_fifo_id++, event_type, 0})};
+        const u64 fifo_id = event_fifo_id++;
+        auto h{event_queue.emplace(Event{next_time.count(), fifo_id, event_type, 0})};
         (*h).handle = h;
+#ifdef __OPENORBIS__
+        // The timing thread waits for the earliest event: a later one needs no wake (it sees it
+        // when it next wakes), and a wake on the PS4 is a system call the scheduling core pays
+        earliest = event_queue.top().fifo_order == fifo_id;
+#endif
     }
 
-    event.Set();
+#ifdef __OPENORBIS__
+    (earliest ? Common::PS4Perf::timing_wakes : Common::PS4Perf::timing_wakes_skipped)
+        .fetch_add(1, std::memory_order_relaxed);
+#endif
+    if (earliest) {
+        event.Set();
+    }
 }
 
