+// Host locks taken (common/ps4_spin_lock.h): a try that failed, then got it while spinning (and
+// the time that took), or slept on it (and the time until it had it)
+struct alignas(64) LockStats {
+    std::atomic<uint64_t> spun{0}, spun_ns{0}, slept{0}, slept_ns{0};
+    void Spun(uint64_t ns) {
+        spun.fetch_add(1, std::memory_order_relaxed);
+        spun_ns.fetch_add(ns, std::memory_order_relaxed);
+    }
+    void Slept(uint64_t ns) {
+        slept.fetch_add(1, std::memory_order_relaxed);
+        slept_ns.fetch_add(ns, std::memory_order_relaxed);
+    }
+};
+// the kernel's scheduler lock, its hardware timer's, its other spin locks (handle tables...), the
+// emulated cores' context locks (PhysicalCore::m_guard), CoreTiming's event queue
+inline LockStats lock_scheduler, lock_timer, lock_kernel_other, lock_core_context, lock_timing;
+// CoreTiming's timing thread woken for a new event (the earliest), or not (a later one: it wakes
+// for the earliest anyway, and sees it then)
+inline std::atomic<uint64_t> timing_wakes{0}, timing_wakes_skipped{0};
+
 // An emulated core that had nothing to run: woken while it still spun (no host sleep), or after
 // sleeping (the time from the interrupt to running again)
 inline std::atomic<uint64_t> idle_spin_wakes{0};
