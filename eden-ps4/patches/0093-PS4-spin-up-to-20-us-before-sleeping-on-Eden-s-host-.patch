new file mode 100644
index 0000000000..aaf797a654
--- /dev/null
+++ b/src/common/ps4_spin_lock.h
@@ -0,0 +1,68 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+// Host locks the emulated cores take on every system call and thread switch (the kernel's
+// scheduler lock, the hardware timer's, each core's context lock, CoreTiming's event queue).
+// On the PS4 a std::mutex that is taken sleeps in the kernel at once, and waking from that sleep
+// costs tens of microseconds, far more than these locks are held for. So, on the PS4, a lock
+// that is taken is first tried again for a while (PAUSE between tries), and only then slept on.
+// The spin is bounded: a waiter that spins for ever can keep a lower-priority holder on its own
+// host core from running (04.00's 20-second freeze); this one sleeps after SpinNs, and the holder
+// runs. Each lock class counts its contention (common/ps4_perf.h: LockStats).
+
+#include <cstdint>
+#include <mutex>
+
+#include "common/ps4_perf.h"
+#ifdef __OPENORBIS__
+#include <immintrin.h>
+#include "common/cpu_features.h"
+#endif
+
+namespace Common {
+
+inline void SpinThenLock(std::mutex& m, PS4Perf::LockStats* stats) {
+#ifdef __OPENORBIS__
+    if (m.try_lock())
+        return;
+    constexpr int64_t SpinNs = 20'000;
+    const int64_t begin = g_wall_clock.GetTimeNS().count();
+    int64_t now = begin;
+    do {
+        for (int i = 0; i < 8; i++)
+            _mm_pause();
+        if (m.try_lock()) {
+            if (stats)
+                stats->Spun(static_cast<uint64_t>(g_wall_clock.GetTimeNS().count() - begin));
+            return;
+        }
+        now = g_wall_clock.GetTimeNS().count();
+    } while (now - begin < SpinNs);
+    m.lock();
+    if (stats)
+        stats->Slept(static_cast<uint64_t>(g_wall_clock.GetTimeNS().count() - begin));
+#else
+    (void)stats;
+    m.lock();
+#endif
+}
+
+// std::scoped_lock's place for one mutex, spinning first (on the PS4)
+class SpinLockGuard {
+public:
+    explicit SpinLockGuard(std::mutex& m, PS4Perf::LockStats* stats) : m_m{m} {
+        SpinThenLock(m, stats);
+    }
+    ~SpinLockGuard() {
+        m_m.unlock();
+    }
+    SpinLockGuard(const SpinLockGuard&) = delete;
+    SpinLockGuard& operator=(const SpinLockGuard&) = delete;
+
+private:
+    std::mutex& m_m;
+};
+
+} // namespace Common
