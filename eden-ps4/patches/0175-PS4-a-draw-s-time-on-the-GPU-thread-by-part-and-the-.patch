+                        Common::PS4Perf::Bump(Common::PS4Perf::gpu_draw_phases.fence_waits_semaphore);
                     dma_pusher.rasterizer->ReleaseFences();
                     continue;
                 }
             } else if (op == GpuSemaphoreOperation::AcquireMask) {
                 if (word && regs.semaphore_sequence == 0) {
+                    if (Common::PS4Perf::on_gpu_thread) // (PS4 04.84)
+                        Common::PS4Perf::Bump(Common::PS4Perf::gpu_draw_phases.fence_waits_semaphore);
                     dma_pusher.rasterizer->ReleaseFences();
                     continue;
                 }
@@ -129,6 +138,8 @@ void Puller::ProcessSemaphoreAcquire(DmaPusher& dma_pusher) {
     while (word != value) {
         regs.acquire_active = true;
         regs.acquire_value = value;
+        if (Common::PS4Perf::on_gpu_thread) // (PS4 04.84)
+            Common::PS4Perf::Bump(Common::PS4Perf::gpu_draw_phases.fence_waits_semaphore);
         dma_pusher.rasterizer->ReleaseFences();
         word = dma_pusher.memory_manager.Read<u32>(regs.semaphore_address.SemaphoreAddress());
         // TODO(kemathe73) figure out how to do the acquire_timeout
