diff --git a/src/common/ps4_perf.h b/src/common/ps4_perf.h
index 4e6da3085..9269e9db5 100644
--- a/src/common/ps4_perf.h
+++ b/src/common/ps4_perf.h
@@ -87,6 +87,45 @@ struct alignas(64) GpuThreadCounters {
     std::atomic<uint64_t> ubo_checks{0}, ubo_same{0}, ubo_changed{0}, ubo_moved{0};
 };
 
+// (04.84) Where a draw's time goes on the GPU thread: TSC ticks per part of the Vulkan
+// rasterizer's PrepareDraw and the pipeline's ConfigureImpl (DrawLap at each boundary: one TSC
+// read each, ~10 a draw), and what the thread waited on: the PS4's GPU (fences the puller made it
+// wait for, the scheduler's waits), the buffer and texture caches' locks; and its mprotect calls
+// (the arena's pages the GPU caches, protected and released). Counted on the GPU thread only.
+enum DrawPhase : int {
+    PhaseFlush,           // FlushWork, the memory manager's cached writes
+    PhasePipeline,        // the graphics pipeline looked up
+    PhaseLocks,           // the buffer and texture caches' locks taken (waiting for them)
+    PhaseDescriptors,     // texture/sampler descriptors read, storage buffers bound, samplers
+    PhaseImageViews,      // the texture cache's image views (FillImageViews)
+    PhaseTextureBuffers,  // texture and image buffers bound
+    PhaseGeometry,        // vertex and index buffers (UpdateGraphicsBuffers, BindHostGeometryBuffers)
+    PhaseUniforms,        // each stage's uniform and storage buffers (BindHostStageBuffers)
+    PhaseImageDescs,      // each stage's image descriptors (PushImageDescriptors)
+    PhaseRenderTargets,   // render targets, feedback loop check
+    PhaseDescriptorSet,   // the descriptor set written and bound, the pipeline bound (ConfigureDraw)
+    PhaseDynamicState,    // UpdateDynamicStates
+    PhaseRecord,          // queries, transform feedback, the draw recorded
+    PhaseTickWork,        // GPU::TickWork after the draw
+    PhaseCount
+};
+inline constexpr const char* kDrawPhaseNames[PhaseCount] = {
+    "flush", "pipeline", "cache locks", "descriptors", "image views", "texture buffers", "vertex/index",
+    "uniforms", "image descriptors", "render targets", "descriptor set", "dynamic state", "record", "tick"};
+struct alignas(64) GpuDrawPhases {
+    std::atomic<uint64_t> ticks[PhaseCount]{};
+    std::atomic<uint64_t> draws{0};  // PrepareDraw calls that got as far as the pipeline
+    // the GPU thread's waits: fences forced (ReleaseFences(true): all queued GPU work), by what
+    // asked (the puller's fence acquire, a semaphore acquire, anything else); the scheduler's
+    // Wait(tick)/Finish; ticks and counts
+    std::atomic<uint64_t> fence_waits{0}, fence_wait_ticks{0};
+    std::atomic<uint64_t> fence_waits_acquire{0}, fence_waits_semaphore{0};
+    std::atomic<uint64_t> scheduler_waits{0}, scheduler_wait_ticks{0};
+    // mprotect calls on the GPU thread (Common::HostMemory::Protect) and their ticks
+    std::atomic<uint64_t> protects{0}, protect_ticks{0};
+};
+inline GpuDrawPhases gpu_draw_phases;
+
 // (04.17) Shaders and pipelines (the tester's question: what the first race builds): those built
 // at boot from the game's shader cache (vulkan.bin) and those built in play. Pipelines; Eden's
 // translation of their shaders to SPIR-V (us, summed over its threads); the driver's pipeline
@@ -129,6 +168,43 @@ inline uint64_t Ticks() {
 }
 inline thread_local bool on_gpu_thread = false;
 inline thread_local int gpu_raster_depth = 0;
+// (04.84) The draw laps: DrawLapStart at PrepareDraw's start, DrawLap(phase) at the end of each part
+// (the time since the last mark added to that part's ticks). On the GPU thread only.
+inline thread_local uint64_t draw_lap_last = 0;
+inline void DrawLapStart() {
+    if (on_gpu_thread)
+        draw_lap_last = Ticks();
+}
+inline void DrawLap(DrawPhase phase) {
+    if (!on_gpu_thread || draw_lap_last == 0)
+        return;
+    const uint64_t now = Ticks();
+    Bump(gpu_draw_phases.ticks[phase], now - draw_lap_last);
+    draw_lap_last = now;
+}
+inline void DrawLapEnd(DrawPhase phase) {
+    DrawLap(phase);
+    draw_lap_last = 0;
+}
+/// A wait of the GPU thread's, timed into a count and a tick total (nothing elsewhere)
+struct GpuWaitScope {
+    std::atomic<uint64_t>* count;
+    std::atomic<uint64_t>* ticks;
+    uint64_t start = 0;
+    GpuWaitScope(std::atomic<uint64_t>& count_, std::atomic<uint64_t>& ticks_)
+        : count{on_gpu_thread ? &count_ : nullptr}, ticks{&ticks_} {
+        if (count)
+            start = Ticks();
+    }
+    ~GpuWaitScope() {
+        if (!count)
+            return;
+        Bump(*count);
+        Bump(*ticks, Ticks() - start);
+    }
+    GpuWaitScope(const GpuWaitScope&) = delete;
+    GpuWaitScope& operator=(const GpuWaitScope&) = delete;
+};
 struct GpuRasterScope {
     uint64_t start = 0;
     bool counted = false;
