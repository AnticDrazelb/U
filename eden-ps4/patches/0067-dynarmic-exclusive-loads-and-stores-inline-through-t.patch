@@ -696,7 +696,12 @@ void A32EmitX64::EmitA32DataSynchronizationBarrier(A32EmitContext&, IR::Inst*) {
 }
 
 void A32EmitX64::EmitA32DataMemoryBarrier(A32EmitContext&, IR::Inst*) {
-    code.mfence();
+    // A locked no-op on the stack's top (a line of its own, hot): a full barrier for ordinary
+    // (write-back) memory as mfence is, at a fraction of its cost (Linux's smp_mb on x86-64 does
+    // the same). Guest memory is ordinary memory; the JIT has no non-temporal stores to order.
+    // Clobbers the flags, which no IR instruction keeps live across another.
+    code.lock();
+    code.or_(code.dword[rsp], 0);
 }
 
 void A32EmitX64::EmitA32InstructionSynchronizationBarrier(A32EmitContext& ctx, IR::Inst*) {
