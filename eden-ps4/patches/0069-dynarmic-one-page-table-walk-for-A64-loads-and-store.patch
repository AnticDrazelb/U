+namespace {
+// The A64 page table walk in pieces, as EmitVAddrLookup<A64EmitContext>: the page index of `vaddr`
+// into `tmp` (or a jump to `fail` when vaddr is outside the table's address space) ...
+void EmitA64PageIndex(BlockOfCode& code, const A64::UserConfig& conf, Xbyak::Reg64 tmp, Xbyak::Reg64 vaddr, Xbyak::Label& fail) {
+    const size_t valid_page_index_bits = conf.page_table_address_space_bits - page_table_const_bits;
+    const size_t unused_top_bits = 64 - conf.page_table_address_space_bits;
+    code.mov(tmp, vaddr);
+    if (unused_top_bits == 0) {
+        code.shr(tmp, int(page_table_const_bits));
+    } else if (conf.silently_mirror_page_table) {
+        if (valid_page_index_bits >= 32) {
+            code.shl(tmp, int(unused_top_bits));
+            code.shr(tmp, int(unused_top_bits + page_table_const_bits));
+        } else {
+            code.shr(tmp, int(page_table_const_bits));
+            code.and_(tmp, u32((1 << valid_page_index_bits) - 1));
+        }
+    } else {
+        ASSERT(valid_page_index_bits < 32);
+        code.shr(tmp, int(page_table_const_bits));
+        code.test(tmp, u32(-(1 << valid_page_index_bits)));
+        code.jnz(fail, code.T_NEAR);
+    }
+}
+
+// ... and the entry for that index (in `tmp`, which this clobbers) into `page`: its host page,
+// without the attribute bits, or a jump to `fail` when it's unmapped, or marked and a write (or a
+// read, with page_table_marked_bit_reads)
+void EmitA64PageEntry(BlockOfCode& code, const A64::UserConfig& conf, Xbyak::Reg64 page, Xbyak::Reg64 tmp, bool is_write,
+                      Xbyak::Label& fail) {
+    if (conf.page_table_log2_stride > 3) {
+        code.shl(tmp, int(conf.page_table_log2_stride));
+        code.mov(page, qword[r14 + tmp]);
+    } else {
+        code.mov(page, qword[r14 + tmp * int(1 << conf.page_table_log2_stride)]);
+    }
+    if (conf.page_table_marked_bit && (is_write || conf.page_table_marked_bit_reads)) {
+        code.bt(page, *conf.page_table_marked_bit);
+        code.jc(fail, code.T_NEAR);
+    }
+    if (conf.page_table_pointer_mask == 0) {
+        code.test(page, page);
+    } else if (std::in_range<s32>(s64(EffectivePointerMask(conf)))) {
+        code.and_(page, u32(s32(EffectivePointerMask(conf))));
+    } else {
+        code.mov(tmp, conf.page_table_pointer_mask);
+        code.and_(page, tmp);
+    }
+    if (conf.page_table_sign_extension) {
+        code.shl(page, 63 - int(*conf.page_table_sign_extension));
+        code.sar(page, 63 - int(*conf.page_table_sign_extension));
+    }
+    code.jz(fail, code.T_NEAR);
+}
+
+// A load (zero-extended) or store of `bitsize` bits between value (a general register, or for
+// 128 bits an XMM register, by index) and host memory at `where`
+void EmitA64HostMov(BlockOfCode& code, size_t bitsize, bool is_write, int value_idx, const Xbyak::RegExp& where) {
+    const Xbyak::Reg64 value{value_idx};
+    switch (bitsize) {
+    case 8:
+        is_write ? code.mov(code.byte[where], value.cvt8()) : code.movzx(value.cvt32(), code.byte[where]);
+        break;
+    case 16:
+        is_write ? code.mov(code.word[where], value.cvt16()) : code.movzx(value.cvt32(), code.word[where]);
+        break;
+    case 32:
+        is_write ? code.mov(code.dword[where], value.cvt32()) : code.mov(value.cvt32(), code.dword[where]);
+        break;
+    case 64:
+        is_write ? code.mov(code.qword[where], value) : code.mov(value, code.qword[where]);
+        break;
+    default:
+        is_write ? code.movups(code.xword[where], Xbyak::Xmm{value_idx}) : code.movups(Xbyak::Xmm{value_idx}, code.xword[where]);
+        break;
+    }
+}
+
+// The slow path of an access of a group whose shared walk failed (A64HostPointer gave 0): its own
+// walk (in two registers saved on the stack meanwhile), and if that fails too the fallback (the
+// memory callbacks). `start` holds the access's address meanwhile (start + offset, taken off again
+// after: the fallbacks keep every register but a load's value).
+void EmitA64ViaSlowPath(BlockOfCode& code, const A64::UserConfig& conf, size_t bitsize, Xbyak::Reg64 start, int value_idx,
+                        Xbyak::Reg64 host, bool is_write, void (*fallback)(), u32 offset, Xbyak::Label& end) {
+    const bool value_is_gpr = bitsize != 128;
+    const auto avoid = [&](const Xbyak::Reg64& r) {
+        return r.getIdx() == start.getIdx() || r.getIdx() == host.getIdx() || (value_is_gpr && r.getIdx() == value_idx);
+    };
+    Xbyak::Reg64 regs[2];
+    size_t found = 0;
+    for (const Xbyak::Reg64& r : {code.rax, code.rcx, code.rdx, code.rbx, code.rsi, code.rdi, code.r8, code.r9}) {
+        if (found < 2 && !avoid(r)) {
+            regs[found++] = r;
+        }
+    }
+    const Xbyak::Reg64 page = regs[0], tmp = regs[1];
+    Xbyak::Label callback;
+    if (offset != 0) {
+        code.add(start, offset);
+    }
+    code.push(page);
+    code.push(tmp);
+    // an access that would cross into the next page goes to the callbacks
+    if (bitsize > 8) {
+        code.mov(tmp.cvt32(), start.cvt32());
+        code.and_(tmp.cvt32(), u32(page_table_const_mask));
+        code.cmp(tmp.cvt32(), u32(page_table_const_size - bitsize / 8));
+        code.ja(callback, code.T_NEAR);
+    }
+    EmitA64PageIndex(code, conf, tmp, start, callback);
+    EmitA64PageEntry(code, conf, page, tmp, is_write, callback);
+    if (conf.absolute_offset_page_table) {
+        code.add(page, start);
+    } else {
+        code.mov(tmp, start);
+        code.and_(tmp, u32(page_table_const_mask));
+        code.add(page, tmp);
+    }
+    EmitA64HostMov(code, bitsize, is_write, value_idx, page);
+    code.pop(tmp);
+    code.pop(page);
+    if (offset != 0) {
+        code.sub(start, offset);
+    }
+    code.jmp(end, code.T_NEAR);
+
+    code.L(callback);
+    code.pop(tmp);
+    code.pop(page);
+    code.call(fallback);
+    if (offset != 0) {
+        code.sub(start, offset);
+    }
+    code.jmp(end, code.T_NEAR);
+}
+}  // namespace
+
+// One page table walk for a group of loads and stores sharing a base (A64SharedWalkPass): the host
+// address of [vaddr, vaddr + span), or 0 when any of them would leave the inline walk (the span
+// crosses into the next page, is outside the address space, the page is unmapped, or it's marked
+// and one of them writes)
+void A64EmitX64::EmitA64HostPointer(A64EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const u32 span = args[1].GetImmediateU32();
+    const bool is_write = args[2].GetImmediateU1();
+    ASSERT(conf.page_table && span >= 1 && span <= page_table_const_size);
+
+    const Xbyak::Reg64 vaddr = ctx.reg_alloc.UseGpr(code, args[0]);
+    const Xbyak::Reg64 page = ctx.reg_alloc.ScratchGpr(code);
+    const Xbyak::Reg64 tmp = ctx.reg_alloc.ScratchGpr(code);
+    Xbyak::Label fail, done;
+
+    code.mov(tmp.cvt32(), vaddr.cvt32());
+    code.and_(tmp.cvt32(), u32(page_table_const_mask));
+    code.cmp(tmp.cvt32(), u32(page_table_const_size - span));
+    code.ja(fail, code.T_NEAR);
+    EmitA64PageIndex(code, conf, tmp, vaddr, fail);
+    EmitA64PageEntry(code, conf, page, tmp, is_write, fail);
+    if (conf.absolute_offset_page_table) {
+        code.add(page, vaddr);
+    } else {
+        code.mov(tmp, vaddr);
+        code.and_(tmp, u32(page_table_const_mask));
+        code.add(page, tmp);
+    }
+    code.jmp(done, code.T_NEAR);
+    code.L(fail);
+    code.xor_(page.cvt32(), page.cvt32());
+    code.L(done);
+
+    ctx.reg_alloc.DefineValue(code, inst, page);
+}
+
+// An access of such a group through its host address (A64HostPointer); or, when that is 0, its own
+// walk and if need be the callbacks (EmitA64ViaSlowPath), for its address: the start (args[1], the
+// whole group's) plus its offset
+template<size_t bitsize>
+void A64EmitX64::EmitReadMemoryVia(A64EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const u32 offset = args[2].GetImmediateU32();
+    const Xbyak::Reg64 host = ctx.reg_alloc.UseGpr(code, args[0]);
+    const Xbyak::Reg64 start = ctx.reg_alloc.UseGpr(code, args[1]);
+    const int value_idx = bitsize == 128 ? ctx.reg_alloc.ScratchXmm(code).getIdx() : ctx.reg_alloc.ScratchGpr(code).getIdx();
+    const auto wrapped_fn = read_fallbacks[std::make_tuple(false, bitsize, start.getIdx(), value_idx)];
+
+    SharedLabel slow = ctx.GenSharedLabel(), end = ctx.GenSharedLabel();
+    code.test(host, host);
+    code.jz(*slow, code.T_NEAR);
+    EmitA64HostMov(code, bitsize, false, value_idx, host + s32(offset));
+    code.L(*end);
+    ctx.deferred_emits.emplace_back([=, this] {
+        code.L(*slow);
+        EmitA64ViaSlowPath(code, conf, bitsize, start, value_idx, host, false, wrapped_fn, offset, *end);
+    });
+
+    if constexpr (bitsize == 128) {
+        ctx.reg_alloc.DefineValue(code, inst, Xbyak::Xmm{value_idx});
+    } else {
+        ctx.reg_alloc.DefineValue(code, inst, Xbyak::Reg64{value_idx});
+    }
+}
+
+template<size_t bitsize>
+void A64EmitX64::EmitWriteMemoryVia(A64EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const u32 offset = args[3].GetImmediateU32();
+    const Xbyak::Reg64 host = ctx.reg_alloc.UseGpr(code, args[0]);
+    Xbyak::Reg64 start = ctx.reg_alloc.UseGpr(code, args[1]);
+    const int value_idx = bitsize == 128 ? ctx.reg_alloc.UseXmm(code, args[2]).getIdx() : ctx.reg_alloc.UseGpr(code, args[2]).getIdx();
+    if (bitsize != 128 && start.getIdx() == value_idx) {
+        // (storing the base register itself: the slow path's offset mustn't change the value)
+        const Xbyak::Reg64 copy = ctx.reg_alloc.ScratchGpr(code);
+        code.mov(copy, start);
+        start = copy;
+    }
+    const auto wrapped_fn = write_fallbacks[std::make_tuple(false, bitsize, start.getIdx(), value_idx)];
+
+    SharedLabel slow = ctx.GenSharedLabel(), end = ctx.GenSharedLabel();
+    code.test(host, host);
+    code.jz(*slow, code.T_NEAR);
+    EmitA64HostMov(code, bitsize, true, value_idx, host + s32(offset));
+    code.L(*end);
+    ctx.deferred_emits.emplace_back([=, this] {
+        code.L(*slow);
+        EmitA64ViaSlowPath(code, conf, bitsize, start, value_idx, host, true, wrapped_fn, offset, *end);
+    });
+}
+
+void A64EmitX64::EmitA64ReadMemoryVia8(A64EmitContext& ctx, IR::Inst* inst) {
+    EmitReadMemoryVia<8>(ctx, inst);
+}
+
+void A64EmitX64::EmitA64ReadMemoryVia16(A64EmitContext& ctx, IR::Inst* inst) {
+    EmitReadMemoryVia<16>(ctx, inst);
+}
+
+void A64EmitX64::EmitA64ReadMemoryVia32(A64EmitContext& ctx, IR::Inst* inst) {
+    EmitReadMemoryVia<32>(ctx, inst);
+}
+
+void A64EmitX64::EmitA64ReadMemoryVia64(A64EmitContext& ctx, IR::Inst* inst) {
+    EmitReadMemoryVia<64>(ctx, inst);
+}
+
+void A64EmitX64::EmitA64ReadMemoryVia128(A64EmitContext& ctx, IR::Inst* inst) {
+    EmitReadMemoryVia<128>(ctx, inst);
+}
+
+void A64EmitX64::EmitA64WriteMemoryVia8(A64EmitContext& ctx, IR::Inst* inst) {
+    EmitWriteMemoryVia<8>(ctx, inst);
+}
+
+void A64EmitX64::EmitA64WriteMemoryVia16(A64EmitContext& ctx, IR::Inst* inst) {
+    EmitWriteMemoryVia<16>(ctx, inst);
+}
+
+void A64EmitX64::EmitA64WriteMemoryVia32(A64EmitContext& ctx, IR::Inst* inst) {
+    EmitWriteMemoryVia<32>(ctx, inst);
+}
+
+void A64EmitX64::EmitA64WriteMemoryVia64(A64EmitContext& ctx, IR::Inst* inst) {
+    EmitWriteMemoryVia<64>(ctx, inst);
+}
+
+void A64EmitX64::EmitA64WriteMemoryVia128(A64EmitContext& ctx, IR::Inst* inst) {
+    EmitWriteMemoryVia<128>(ctx, inst);
+}
+
 }  // namespace Dynarmic::Backend::X64
