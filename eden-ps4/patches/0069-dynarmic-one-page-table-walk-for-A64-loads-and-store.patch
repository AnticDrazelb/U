diff --git a/src/dynarmic/src/dynarmic/ir/opt_passes.cpp b/src/dynarmic/src/dynarmic/ir/opt_passes.cpp
index bc68b6849..412eebe79 100644
--- a/src/dynarmic/src/dynarmic/ir/opt_passes.cpp
+++ b/src/dynarmic/src/dynarmic/ir/opt_passes.cpp
@@ -189,6 +189,110 @@ static void A32SharedWalkPass(IR::Block& block) {
     }
 }
 
+// A64: loads and stores through one base register value plus constants within a block share one
+// page table walk (A64HostPointer before the first of them), as A32SharedWalkPass. The base is
+// followed through chains of constant adds and subtracts (a pre-indexed STP's new SP, then the
+// stores after it), so the accesses of a function's prologue and epilogue form one group.
+static void A64SharedWalkPass(IR::Block& block) {
+    struct Member {
+        IR::Block::iterator it;
+        s64 offset;
+        s64 bytes;
+        IR::Opcode via;
+        bool write;
+    };
+    struct Group {
+        IR::Inst* base;
+        std::vector<Member> members;
+    };
+    const auto resolve = [](IR::Value v) {
+        while (v.IsIdentity()) {
+            v = v.GetInst()->GetArg(0);
+        }
+        return v;
+    };
+    std::vector<Group> groups;
+    for (auto it = block.instructions.begin(); it != block.instructions.end(); ++it) {
+        IR::Opcode via;
+        s64 bytes;
+        bool write;
+        switch (it->GetOpcode()) {
+        case IR::Opcode::A64ReadMemory8: via = IR::Opcode::A64ReadMemoryVia8, bytes = 1, write = false; break;
+        case IR::Opcode::A64ReadMemory16: via = IR::Opcode::A64ReadMemoryVia16, bytes = 2, write = false; break;
+        case IR::Opcode::A64ReadMemory32: via = IR::Opcode::A64ReadMemoryVia32, bytes = 4, write = false; break;
+        case IR::Opcode::A64ReadMemory64: via = IR::Opcode::A64ReadMemoryVia64, bytes = 8, write = false; break;
+        case IR::Opcode::A64ReadMemory128: via = IR::Opcode::A64ReadMemoryVia128, bytes = 16, write = false; break;
+        case IR::Opcode::A64WriteMemory8: via = IR::Opcode::A64WriteMemoryVia8, bytes = 1, write = true; break;
