 // SPDX-FileCopyrightText: Copyright 2021 yuzu Emulator Project
 // SPDX-License-Identifier: GPL-2.0-or-later
 
+#include "common/ps4_perf.h"
 #include "common/settings.h"
 #include "core/core.h"
 #include "video_core/dma_pusher.h"
@@ -112,6 +113,9 @@ bool DmaPusher::Step() {
 }
 
 void DmaPusher::ProcessCommands(std::span<const CommandHeader> commands) {
+#ifdef __OPENORBIS__
+    Common::PS4Perf::gpu_command_words.fetch_add(commands.size(), std::memory_order_relaxed);
+#endif
     for (size_t index = 0; index < commands.size();) {
         // Data word of methods command
         if (dma_state.method_count && dma_state.non_incrementing) {
@@ -123,6 +127,13 @@ void DmaPusher::ProcessCommands(std::span<const CommandHeader> commands) {
             dma_state.is_last_call = true;
             index += max_write;
         } else if (dma_state.method_count) {
+            // (04.08) A run of plain register writes (methods the engine only sinks, not ones it
+            // executes): one loop, without a call and a reload of the DMA state for each word,
+            // leaving the state the per-word path below would
+            if (const size_t run = SinkRun(commands, index); run != 0) {
+                index += run;
+                continue;
+            }
             auto const command_header = commands[index]; //can copy
             dma_state.dma_word_offset = u32(index * sizeof(u32));
             dma_state.is_last_call = dma_state.method_count <= 1;
@@ -166,6 +177,47 @@ void DmaPusher::ProcessCommands(std::span<const CommandHeader> commands) {
     }
 }
 
+size_t DmaPusher::SinkRun(std::span<const CommandHeader> commands, size_t index) {
+    // (only with an incrementing method count left: the caller's branch; non-incrementing words
+    // go to CallMultiMethod)
+    if (dma_state.method < non_puller_methods) {
+        return 0;
+    }
+    Engines::EngineInterface* const engine = subchannels[dma_state.subchannel];
+    if (engine == nullptr) {
+        return 0;
+    }
+    u32 method = dma_state.method;
+    u32 count = dma_state.method_count;
+    bool non_incrementing = dma_state.non_incrementing;
+    size_t i = index;
+    const size_t end = commands.size();
+    while (count != 0 && i < end && !non_incrementing && !engine->execution_mask[method]) {
+        engine->method_sink.emplace_back(method, commands[i].argument);
+        ++i;
+        --count;
+        // as the per-word path: the method advances, then IncreaseOnce makes the rest
+        // non-incrementing (CallMultiMethod's, after this run)
+        ++method;
+        non_incrementing = dma_increment_once;
+    }
+    const size_t run = i - index;
+#ifdef __OPENORBIS__
+    if (run > 1) {
+        Common::PS4Perf::gpu_sink_run_words.fetch_add(run, std::memory_order_relaxed);
+    }
+#endif
+    if (run != 0) {
+        // what the last word's per-word call left
+        dma_state.dma_word_offset = u32((i - 1) * sizeof(u32));
+        dma_state.is_last_call = count == 0;
+        dma_state.method = method;
+        dma_state.method_count = count;
+        dma_state.non_incrementing = non_incrementing;
+    }
+    return run;
+}
+
 void DmaPusher::SetState(const CommandHeader& command_header) {
     dma_state.method = command_header.method;
     dma_state.subchannel = command_header.subchannel;
