diff --git a/src/common/ps4_perf.h b/src/common/ps4_perf.h
index 487152b09b..8a180dc5f8 100644
--- a/src/common/ps4_perf.h
+++ b/src/common/ps4_perf.h
@@ -48,6 +48,10 @@ inline LockStats lock_scheduler, lock_timer, lock_kernel_other, lock_core_contex
 // for the earliest anyway, and sees it then)
 inline std::atomic<uint64_t> timing_wakes{0}, timing_wakes_skipped{0};
 
+// Eden's GPU thread (04.08): draws, the command words it read, and how many of those were in runs
+// of plain register writes (DmaPusher::SinkRun). Added in bulk (a command list's words at once)
+inline std::atomic<uint64_t> gpu_draws{0}, gpu_command_words{0}, gpu_sink_run_words{0};
+
 // The services' host threads (KThread's dummy threads) waiting for their next request: woken
 // while they still spun, or after sleeping (and the time from the signal until they ran); the
 // spin is longer (to 250 us) after a short wait (requests coming close together, 04.07)
diff --git a/src/video_core/buffer_cache/buffer_cache.h b/src/video_core/buffer_cache/buffer_cache.h
index fbe92e3e4b..c68d96ba4e 100644
--- a/src/video_core/buffer_cache/buffer_cache.h
+++ b/src/video_core/buffer_cache/buffer_cache.h
@@ -78,6 +78,7 @@ void BufferCache<P>::RunGarbageCollector() {
 
 template <class P>
 void BufferCache<P>::TickFrame() {
+    fence_behavior_accurate = Settings::IsGPUFenceBehaviorAccurate();
     // Homebrew console apps don't create or bind any channels, so this will be nullptr.
     if (!channel_state) {
         return;
@@ -1364,7 +1365,19 @@ void BufferCache<P>::UpdateVertexBuffers() {
     }
     flags[Dirty::VertexBuffers] = false;
 
-    for (u32 index = 0; index < NUM_VERTEX_BUFFERS; ++index) {
+    // (04.08) Only the vertex buffers marked dirty, in order: UpdateVertexBuffer returns at once
+    // for the others, but that was a call for each of the 32 on every draw that changed one.
+    // (Nothing here changes those dirty bits, so the mask taken first is the loop's.)
+    static_assert(NUM_VERTEX_BUFFERS <= 32);
+    using Flags = std::remove_cvref_t<decltype(flags)>;
+    static constexpr Flags low_word{0xFFFFFFFFULL};
+    u32 dirty_mask = static_cast<u32>(((flags >> Dirty::VertexBuffer0) & low_word).to_ullong());
+    if constexpr (NUM_VERTEX_BUFFERS < 32) {
+        dirty_mask &= (1U << NUM_VERTEX_BUFFERS) - 1;
+    }
+    while (dirty_mask != 0) {
+        const u32 index = static_cast<u32>(std::countr_zero(dirty_mask));
+        dirty_mask &= dirty_mask - 1;
         UpdateVertexBuffer(index);
     }
 }
@@ -1547,7 +1560,7 @@ BufferId BufferCache<P>::FindBuffer(DAddr device_addr, u32 size, bool sparse_com
     if (buffer_id) {
         Buffer& buffer = slot_buffers[buffer_id];
         if (buffer.IsInBounds(device_addr, size)) {
-            const bool should_sync = Settings::IsGPUFenceBehaviorAccurate();
+            const bool should_sync = fence_behavior_accurate;
             if (should_sync) {
                 SynchronizeBufferWrites(buffer);
             }
