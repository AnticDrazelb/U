+#endif
     const auto& params = maxwell3d->draw_manager.indirect_state;
     buffer_cache.SetDrawIndirect(&params);
     PrepareDraw(params.is_indexed, [this, &params] {
@@ -1879,6 +1886,16 @@ void RasterizerVulkan::UpdateStencilTestEnable(Tegra::Engines::Maxwell3D::Regs&
     });
 }
 
+VkFormat RasterizerVulkan::CachedVertexFormat(Maxwell::VertexAttribute::Type type,
+                                              Maxwell::VertexAttribute::Size size) {
+    const size_t index = (static_cast<size_t>(type) & 7) * 64 + (static_cast<size_t>(size) & 63);
+    if (!vertex_formats_known[index]) {
+        vertex_formats[index] = MaxwellToVK::VertexFormat(device, type, size);
+        vertex_formats_known[index] = true;
+    }
+    return vertex_formats[index];
+}
+
 void RasterizerVulkan::UpdateVertexInput(Tegra::Engines::Maxwell3D::Regs& regs) {
     auto& dirty{maxwell3d->dirty.flags};
     const bool vertex_input_dirty = dirty[Dirty::VertexInput];
@@ -1910,7 +1927,7 @@ void RasterizerVulkan::UpdateVertexInput(Tegra::Engines::Maxwell3D::Regs& regs)
             .pNext = nullptr,
             .location = index,
             .binding = binding,
-            .format = MaxwellToVK::VertexFormat(device, attribute.type, attribute.size),
+            .format = CachedVertexFormat(attribute.type, attribute.size),
             .offset = attribute.offset,
         });
     }
