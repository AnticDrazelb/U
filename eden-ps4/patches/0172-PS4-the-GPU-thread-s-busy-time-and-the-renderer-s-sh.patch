From 8fcb549ef3c555d573f50d8636a11d87ff2e4e3a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 18:13:54 +0000
Subject: [PATCH] PS4: the GPU thread's busy time and the renderer's share of
 it (TSC ticks)

Common::PS4Perf::gpu_thread.busy_ticks: each command the GPU thread takes from its queue, until
done; raster_ticks: within that, the outermost of RasterizerVulkan's entry points (draws, clears,
compute, queries, uniform buffer binds, cache flushes and invalidations, fences, blits, inline
uploads, DMA: GpuRasterScope, counted on the GPU thread only). The launcher's 30 s line shows the
GPU thread's busy share and the renderer's against command processing: what a split of the GPU
thread into a front end and a back end (docs/gpu-thread-split.md) can gain.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01W5pLthrq7391gS4qodPV4u
---
 src/common/ps4_perf.h                         | 37 +++++++++++++++++++
 src/video_core/gpu_thread.cpp                 |  5 +++
 .../renderer_vulkan/vk_rasterizer.cpp         | 30 +++++++++++++++
 3 files changed, 72 insertions(+)

diff --git a/src/common/ps4_perf.h b/src/common/ps4_perf.h
index 5367801e4a..4e6da30854 100644
--- a/src/common/ps4_perf.h
+++ b/src/common/ps4_perf.h
@@ -71,6 +71,9 @@ struct alignas(64) GpuThreadCounters {
     std::atomic<uint64_t> cb_bytes{0};
     std::atomic<uint64_t> ubo_copied{0}, ubo_copied_bytes{0}, ubo_cached{0}, ubo_cached_hits{0};
     std::atomic<uint64_t> ubo_frames{0}, ubo_frames_copying{0};
+    // (04.82, docs/gpu-thread-split.md) the thread's time in TSC ticks: busy (a command from its
+    // queue taken until done), and of that in the renderer's entry points (GpuRasterScope)
+    std::atomic<uint64_t> busy_ticks{0}, raster_ticks{0};
     // (04.15) graphics pipeline lookups: all of them, those that reused the last one (none of the
     // key's registers changed), the reuses checked (the key refreshed and compared), and the
     // checks that found it changed (reuse then off for the session)
@@ -111,6 +114,40 @@ inline std::atomic<uint64_t> jit_walked_sites[4], jit_walked_stack_sites[4];
 // false: the buffer cache's and texture cache's locks, their lookups, the shader cache's)
 inline std::atomic<uint64_t> gpu_cached_writes_same{0}, gpu_cached_writes_collected{0}, gpu_cached_writes_invalidated{0};
 inline GpuThreadCounters gpu_thread;
+
+// (04.82) TSC ticks (cheap: the GPU thread reads them twice a draw), and the renderer's share of
+// the GPU thread's time: a scope at each of its entry points (draws, clears, compute, queries,
+// uniform buffer binds, cache flushes and invalidations, blits, DMA), the outermost one counted,
+// only on the GPU thread. What's left of its busy time is command processing: the front end a split
+// of the GPU thread would put on a core of its own (docs/gpu-thread-split.md).
+inline uint64_t Ticks() {
+#if defined(__x86_64__)
+    return __builtin_ia32_rdtsc();
+#else
+    return 0;
+#endif
+}
+inline thread_local bool on_gpu_thread = false;
+inline thread_local int gpu_raster_depth = 0;
+struct GpuRasterScope {
+    uint64_t start = 0;
+    bool counted = false;
+    GpuRasterScope() {
+        if (on_gpu_thread && gpu_raster_depth++ == 0) {
+            counted = true;
+            start = Ticks();
+        }
+    }
+    ~GpuRasterScope() {
+        if (!on_gpu_thread)
+            return;
+        gpu_raster_depth--;
+        if (counted)
+            Bump(gpu_thread.raster_ticks, Ticks() - start);
+    }
+    GpuRasterScope(const GpuRasterScope&) = delete;
+    GpuRasterScope& operator=(const GpuRasterScope&) = delete;
+};
 // (04.09) What's new to it: graphics pipelines not in the cache (the disk shader cache's are, from
 // the boot), draws skipped while their pipeline builds (asynchronous shaders), images and buffers
 // created; for what a race's start waits on
