+// (PS4 04.28) A 32- or 64-bit plain store from an XMM's low lane
+template<std::size_t bitsize>
+const void* EmitWriteMemoryMovXmm(BlockOfCode& code, const Xbyak::RegExp& addr, int value_idx) {
+    static_assert(bitsize == 32 || bitsize == 64);
+    const void* fastmem_location = code.getCurr();
+    if constexpr (bitsize == 32) {
+        code.movd(dword[addr], Xbyak::Xmm(value_idx));
+    } else {
+        code.movq(qword[addr], Xbyak::Xmm(value_idx));
+    }
+    return fastmem_location;
+}
+
