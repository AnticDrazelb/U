+// (PS4 04.28, superblocks) A side exit: the condition tested here, taken, a link to the target in
+// the cold code (the guest registers and flags were stored before this: A64GetSetElimination
+// keeps them)
+void A64EmitX64::EmitSideExitLink(A64EmitContext& ctx, Xbyak::Label& taken, IR::LocationDescriptor target) {
+    const IR::LocationDescriptor initial_location = ctx.block.Location();
+    ctx.deferred_emits.emplace_back([this, taken, target, initial_location]() mutable {
+        code.L(taken);
+        if (conf.jit_frame_pointer)
+            code.mov(rbp, code.qword[rsp + ABI_SHADOW_SPACE + offsetof(StackLayout, abi_base_pointer)]);
+        EmitLeafTerminal(IR::Term::LinkBlock{target}, initial_location, false);
+    });
+}
+
+void A64EmitX64::EmitA64ExitIfZero32(A64EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const bool when_zero = args[1].GetImmediateU1();
+    const IR::LocationDescriptor target{args[2].GetImmediateU64()};
+    const Xbyak::Reg32 value = ctx.reg_alloc.UseGpr(code, args[0]).cvt32();
+    Xbyak::Label taken;
+    code.test(value, value);
+    when_zero ? code.jz(taken, code.T_NEAR) : code.jnz(taken, code.T_NEAR);
+    EmitSideExitLink(ctx, taken, target);
+}
+
+void A64EmitX64::EmitA64ExitIfZero64(A64EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const bool when_zero = args[1].GetImmediateU1();
+    const IR::LocationDescriptor target{args[2].GetImmediateU64()};
+    const Xbyak::Reg64 value = ctx.reg_alloc.UseGpr(code, args[0]);
+    Xbyak::Label taken;
+    code.test(value, value);
+    when_zero ? code.jz(taken, code.T_NEAR) : code.jnz(taken, code.T_NEAR);
+    EmitSideExitLink(ctx, taken, target);
+}
+
+void A64EmitX64::EmitA64ExitIfTestBit(A64EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const u8 bit = args[1].GetImmediateU8();
+    const bool when_set = args[2].GetImmediateU1();
+    const IR::LocationDescriptor target{args[3].GetImmediateU64()};
+    const Xbyak::Reg64 value = ctx.reg_alloc.UseGpr(code, args[0]);
+    Xbyak::Label taken;
+    if (bit < 32) {
+        code.test(value.cvt32(), u32(1) << bit);
+        when_set ? code.jnz(taken, code.T_NEAR) : code.jz(taken, code.T_NEAR);
+    } else {
+        code.bt(value, bit);
+        when_set ? code.jc(taken, code.T_NEAR) : code.jnc(taken, code.T_NEAR);
+    }
+    EmitSideExitLink(ctx, taken, target);
+}
