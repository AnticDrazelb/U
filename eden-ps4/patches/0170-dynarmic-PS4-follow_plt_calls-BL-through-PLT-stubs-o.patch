diff --git a/src/dynarmic/src/dynarmic/frontend/A64/translate/a64_translate.cpp b/src/dynarmic/src/dynarmic/frontend/A64/translate/a64_translate.cpp
index 3bc38d4e13..dbc35730b9 100644
--- a/src/dynarmic/src/dynarmic/frontend/A64/translate/a64_translate.cpp
+++ b/src/dynarmic/src/dynarmic/frontend/A64/translate/a64_translate.cpp
@@ -259,10 +259,12 @@ void LookAheadForFlags(IR::Block& block, const MemoryReadCodeFuncType& read_code
 
 }  // namespace
 
-void Translate(IR::Block& block, LocationDescriptor descriptor, MemoryReadCodeFuncType memory_read_code, TranslationOptions options) {
+void Translate(IR::Block& block, LocationDescriptor descriptor, MemoryReadCodeFuncType memory_read_code, TranslationOptions options,
+               const MemoryReadCodeFuncType* peek) {
     const bool single_step = descriptor.SingleStepping();
     TranslatorVisitor visitor{block, descriptor, options};
     visitor.read_code = &memory_read_code;
+    visitor.peek = peek;
 
     bool should_continue = true;
     visitor.piece_start = descriptor.PC();
diff --git a/src/dynarmic/src/dynarmic/frontend/A64/translate/a64_translate.h b/src/dynarmic/src/dynarmic/frontend/A64/translate/a64_translate.h
index 241185d77c..a44d255c59 100644
--- a/src/dynarmic/src/dynarmic/frontend/A64/translate/a64_translate.h
+++ b/src/dynarmic/src/dynarmic/frontend/A64/translate/a64_translate.h
@@ -79,6 +79,9 @@ struct TranslationOptions {
     /// With superblocks: a backward one too, unless to the block's own start (UserConfig::superblocks_backward)
     bool superblocks_backward = false;
 
+    /// With follow_leaf_calls: BL into a PLT stub, and on into its target if a short leaf (UserConfig::follow_plt_calls)
+    bool follow_plt_calls = false;
+
     /// SBFM and UBFM (LSL, LSR, UBFX, UBFIZ, SBFX, SBFIZ, UXTB, UXTH by immediate) as shifts and
     /// extensions, not a rotate and two masks (UserConfig::bitfield_shifts)
     bool bitfield_shifts = false;
@@ -91,7 +94,10 @@ struct TranslationOptions {
  * @param options Configures how certain instructions are translated.
  * @return A translated basic block in the intermediate representation.
  */
-void Translate(IR::Block& block, LocationDescriptor descriptor, MemoryReadCodeFuncType memory_read_code, TranslationOptions options);
+/// (PS4 04.81) peek: memory as it is now, without side effects (UserCallbacks::PeekCode): a PLT
+/// stub's GOT slot (follow_plt_calls); none, no slot is read
+void Translate(IR::Block& block, LocationDescriptor descriptor, MemoryReadCodeFuncType memory_read_code, TranslationOptions options,
+               const MemoryReadCodeFuncType* peek = nullptr);
 
 /**
  * This function translates a single provided instruction into our intermediate representation.
diff --git a/src/dynarmic/src/dynarmic/frontend/A64/translate/impl/a64_branch.cpp b/src/dynarmic/src/dynarmic/frontend/A64/translate/impl/a64_branch.cpp
index 2bad58e7e0..1200c6251d 100644
--- a/src/dynarmic/src/dynarmic/frontend/A64/translate/impl/a64_branch.cpp
+++ b/src/dynarmic/src/dynarmic/frontend/A64/translate/impl/a64_branch.cpp
@@ -45,9 +45,13 @@ bool TranslatorVisitor::Follow(u64 target, bool leaf_call) {
     const u64 pc = ir.PC();
     if (target >= piece_start && target <= pc)
         return false;
-    for (const auto& [start, end] : pieces) {
-        if (target >= start && target < end)
-            return false;
+    // (a piece the block has already: not again, as a loop would be unrolled; but a leaf call's (a
+    // leaf, a PLT stub, the way back) may be: none of them branches back, follows_left bounds them)
+    if (!leaf_call) {
+        for (const auto& [start, end] : pieces) {
+            if (target >= start && target < end)
+                return false;
+        }
     }
     if (pieces.size() == pieces.capacity())
         return false;
@@ -70,10 +74,44 @@ bool TranslatorVisitor::BL(Imm<26> imm26) {
                                        : options.follow_leaf_calls && IsShortLeaf(target) && Follow(target, true)) {
         return true;
     }
+    if (options.follow_plt_calls && FollowPltCall(target))
+        return true;
     ir.SetTerm(IR::Term::LinkBlockFast{ir.current_location->SetPC(target)});
     return false;
 }
 
+// (PS4 04.81, follow_plt_calls) ADRP X16, page; LDR X17, [X16, #o]; ADD X16, X16, #o; BR X17
+bool TranslatorVisitor::FollowPltCall(u64 stub) {
+    if (!read_code || (stub & 3) != 0 || ir.current_location->SingleStepping())
+        return false;
+    u32 w[4];
+    for (u64 i = 0; i < 4; i++) {
+        const auto word = (*read_code)(stub + 4 * i);
+        if (!word)
+            return false;
+        w[i] = *word;
+    }
+    if ((w[0] & 0x9F00001F) != 0x90000010 || (w[1] & 0xFFC003FF) != 0xF9400211 || (w[2] & 0xFFC003FF) != 0x91000210 ||
+        w[3] != 0xD61F0220)
+        return false;
+    // the slot: ADRP's page plus LDR's scaled offset (the ADD's offset, the same, isn't needed)
+    const u64 immlo = (w[0] >> 29) & 3, immhi = (w[0] >> 5) & 0x7FFFF;
+    const s64 page_offset = s64((immhi << 2 | immlo) << 43) >> 31;  // (21 bits sign-extended, times 4096)
+    const u64 slot = (stub & ~u64(0xFFF)) + u64(page_offset) + (((w[1] >> 10) & 0xFFF) << 3);
+    plt_leaf.reset();
+    if (options.superblocks && side_exits_left > 0 && peek) {
+        const auto lo = (*peek)(slot), hi = (*peek)(slot + 4);
+        const u64 value = lo && hi ? (u64(*lo) | u64(*hi) << 32) : 0;
+        if (value != 0 && (value & 3) == 0 && IsShortLeaf(value))
+            plt_leaf = PltLeaf{stub + 12, value};
+    }
+    if (!Follow(stub, true)) {
+        plt_leaf.reset();
+        return false;
+    }
+    return true;
+}
+
 // (PS4 04.75: a RET within five instructions: up to four of the callee's; unity64 lost ~1% with
 // six to twelve - longer leaves pushed blocks to their limits - and game64 gains 2.3% with five)
 constexpr u64 kLeafMax = 5;
@@ -93,7 +131,9 @@ bool TranslatorVisitor::IsShortLeaf(u64 target) const {
             (inst & 0x7E000000) == 0x36000000 ||  // TBZ, TBNZ
             (inst & 0xFF000010) == 0x54000000 ||  // B.cond
             (inst & 0xFF000000) == 0xD4000000 ||  // SVC, HVC, SMC, BRK, HLT
-            (inst & 0xFFC00000) == 0xD5000000 ||  // system: MSR, MRS, hints, barriers, SYS
+            ((inst & 0xFFC00000) == 0xD5000000 &&  // system: MSR, MRS, hints, barriers, SYS
+             // (04.81) but MRS of TPIDRRO_EL0 or TPIDR_EL0: a read of the thread pointer
+             (inst & 0xFFFFFFE0) != 0xD53BD060 && (inst & 0xFFFFFFE0) != 0xD53BD040) ||
             (inst & 0x1F) == 30 ||                // X30 its first register field (a write, or a store of it)
             ((inst >> 5) & 0x1F) == 30 ||         // or its second (a base written back, a source)
             ((inst & 0x3A000000) == 0x28000000 && ((inst >> 10) & 0x1F) == 30))  // LDP/STP's second
@@ -116,6 +156,20 @@ bool TranslatorVisitor::BLR(Reg Rn) {
 bool TranslatorVisitor::BR(Reg Rn) {
     const auto target = X(64, Rn);
 
+    // (PS4 04.81, follow_plt_calls) a followed stub's BR to its short leaf: out here when X17 holds
+    // another function (a block of its own at this BR dispatches to it), else on into the leaf
+    if (plt_leaf && Rn == Reg::R17 && ir.PC() == plt_leaf->br_pc) {
+        const u64 leaf = plt_leaf->target;
+        plt_leaf.reset();
+        if (side_exits_left > 0 && instructions < 64) {
+            side_exits_left--;
+            ir.ExitIfZero(ir.Sub(IR::U64{target}, ir.Imm64(leaf)), false, *ir.current_location);
+            if (Follow(leaf, true))
+                return true;
+            // (not followed after all: the BR's own way below, X17 the leaf when it gets there)
+        }
+    }
+
     ir.SetPC(target);
     ir.SetTerm(IR::Term::FastDispatchHint{});
     return false;
