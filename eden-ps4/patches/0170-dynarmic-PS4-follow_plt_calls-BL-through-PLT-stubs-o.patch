diff --git a/src/dynarmic/src/dynarmic/backend/x64/a64_interface.cpp b/src/dynarmic/src/dynarmic/backend/x64/a64_interface.cpp
index bc0b1a74f0..bb3d28925d 100644
--- a/src/dynarmic/src/dynarmic/backend/x64/a64_interface.cpp
+++ b/src/dynarmic/src/dynarmic/backend/x64/a64_interface.cpp
@@ -332,6 +332,7 @@ private:
         // (the exits' flags need the look-ahead)
         options.superblocks_cond = options.superblocks && conf.superblocks_cond && options.nzcv_lookahead;
         options.superblocks_backward = options.superblocks && conf.superblocks_backward;
+        options.follow_plt_calls = conf.follow_leaf_calls && conf.follow_plt_calls;
         options.bitfield_shifts = conf.bitfield_shifts;
         const int native = conf.native_functions && !arch_descriptor.SingleStepping()
                                ? conf.callbacks->NativeFunction(arch_descriptor.PC())
@@ -348,7 +349,8 @@ private:
             ir_block.SetEndLocation(arch_descriptor.AdvancePC(4));
             ir_block.lookahead.emplace_back(arch_descriptor.PC(), arch_descriptor.PC() + 64);
         } else {
-            A64::Translate(ir_block, arch_descriptor, get_code, options);
+            const A64::MemoryReadCodeFuncType peek = [this](u64 vaddr) { return conf.callbacks->PeekCode(vaddr); };
+            A64::Translate(ir_block, arch_descriptor, get_code, options, &peek);
         }
         // (PS4 04.70) the launcher's search: this block's guest code and IR before and after
         const u64 block_pc = arch_descriptor.PC();
@@ -477,6 +479,7 @@ private:
         add(conf.superblocks);
         add(conf.superblocks_cond);
         add(conf.superblocks_backward);
+        add(conf.follow_plt_calls);
         add(conf.bitfield_shifts);
         add(conf.enable_cycle_counting);
