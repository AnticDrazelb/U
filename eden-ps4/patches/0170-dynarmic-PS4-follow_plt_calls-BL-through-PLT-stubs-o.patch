--- a/src/dynarmic/src/dynarmic/frontend/A64/translate/impl/impl.h
+++ b/src/dynarmic/src/dynarmic/frontend/A64/translate/impl/impl.h
@@ -31,9 +31,11 @@ struct TranslatorVisitor final {
 
     // (options.follow_direct_branches) The block's guest code so far: the pieces before the
     // current one ([start, end)), the current one's start, and how many more branches it may follow
-    boost::container::static_vector<std::pair<u64, u64>, 4> pieces;
+    // (04.81: up to six followed, eight pieces: two calls through PLT stubs into leaves take three
+    // each - into the stub, into the leaf, back)
+    boost::container::static_vector<std::pair<u64, u64>, 8> pieces;
     u64 piece_start = 0;
-    int follows_left = 3;
+    int follows_left = 6;
     int side_exits_left = 8;
     // A side exit to target here, if the block may have one more (superblocks)
     bool MaySideExit(u64 target);
@@ -44,7 +46,16 @@ struct TranslatorVisitor final {
     // (PS4 04.74, follow_leaf_calls) the code the block is translated from, and whether a BL's
     // target is a short leaf function
     const MemoryReadCodeFuncType* read_code = nullptr;
+    // (PS4 04.81) memory as it is now (PeekCode): a PLT stub's GOT slot
+    const MemoryReadCodeFuncType* peek = nullptr;
     bool IsShortLeaf(u64 target) const;
+    // (PS4 04.81, follow_plt_calls) a BL to a PLT stub followed into it; the stub's BR (at br_pc)
+    // then goes on into its slot's function if that is a short leaf (leaf set)
+    bool FollowPltCall(u64 stub);
+    struct PltLeaf {
+        u64 br_pc = 0, target = 0;
+    };
+    std::optional<PltLeaf> plt_leaf;
     // (PS4 04.73, follow_known_returns) X30's value if the block set it to a constant last
     std::optional<u64> KnownLinkRegister() const;
 
diff --git a/src/dynarmic/src/dynarmic/interface/A64/config.h b/src/dynarmic/src/dynarmic/interface/A64/config.h
index 292dca097e..08da2d732e 100644
--- a/src/dynarmic/src/dynarmic/interface/A64/config.h
+++ b/src/dynarmic/src/dynarmic/interface/A64/config.h
@@ -491,6 +491,16 @@ struct UserConfig {
     /// and the registers it carries from one part to the next stay in host registers.
     bool superblocks_backward = false;
 
+    /// (PS4 04.81) With follow_leaf_calls: a BL to a PLT stub (ADRP X16; LDR X17, [X16, #o];
+    /// ADD X16, X16, #o; BR X17) is translated on into the stub, whose BR then ends the block
+    /// (guarded_indirect_links makes it a link to the function its GOT slot holds). If that function
+    /// (the slot's value when translated) is a short leaf, and superblocks are on: on into it too,
+    /// the BR a side exit for when X17 isn't it (a block of its own there dispatches), and back
+    /// after the BL at its RET. A short leaf may read TPIDRRO_EL0 and TPIDR_EL0 (MRS) too. Bluey's
+    /// "current thread" (MRS X8, TPIDRRO_EL0; LDR X0, [X8, #504]; RET), called through a stub, was
+    /// 29% of its samples with the stub.
+    bool follow_plt_calls = false;
+
     /// (PS4 04.30) SBFM and UBFM by immediate (LSL, LSR, UBFX, UBFIZ, SBFX, SBFIZ, UXTB, UXTH) as
     /// one or two shifts or an extension (SBFIZ #n, #32: movsxd and shl) instead of the
     /// architecture's rotate and two masks (rorx, and, movabs, and; nine instructions for SBFIZ)
