diff --git a/src/common/ps4_mem_log.h b/src/common/ps4_mem_log.h
new file mode 100644
index 0000000000..8d79dec3a6
--- /dev/null
+++ b/src/common/ps4_mem_log.h
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <atomic>
+#include <cstdlib>
+
+namespace Common::PS4Diagnostics {
+// (New Eden 04.65) The game's memory calls in log.txt with their results (EDEN_PS4_MEM_LOG=1, the
+// launcher's test of a game that corrupts its heap): the first 6000 of them (GetInfo's, 400)
+inline bool MemLogOn() {
+    static const bool on = [] {
+        const char* e = std::getenv("EDEN_PS4_MEM_LOG");
+        return e && e[0] == '1';
+    }();
+    return on;
+}
+inline std::atomic<int> mem_log_left{6000}, mem_info_log_left{400};
+inline bool MemLogTake(bool info = false) {
+    return MemLogOn() && (info ? mem_info_log_left : mem_log_left).fetch_sub(1, std::memory_order_relaxed) > 0;
+}
+} // namespace Common::PS4Diagnostics
