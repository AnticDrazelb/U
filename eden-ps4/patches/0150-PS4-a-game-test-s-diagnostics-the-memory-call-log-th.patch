     m_parent.m_jit->HaltExecution(Dynarmic::HaltReason::CacheInvalidation);
 }
 
+namespace {
+// (New Eden 04.65) The first guest exception that isn't a hint (as a game's heap check failing):
+// what its registers point at (the block, the physical page, the bytes there) and the process's
+// memory map, in log.txt, once per process
+void DumpForDiagnosis(Core::Memory::Memory& memory, Kernel::KProcess* process,
+                      const Kernel::Svc::ThreadContext& ctx) {
+    static std::atomic<bool> done{false};
+    if (process == nullptr || done.exchange(true)) {
+        return;
+    }
+    auto& table = process->GetPageTable();
+    const u64 space_start = GetInteger(table.GetAddressSpaceStart());
+    const u64 space_end = space_start + table.GetAddressSpaceSize();
+    const auto query = [&](u64 address, Kernel::KMemoryInfo& info) {
+        Kernel::Svc::PageInfo page_info{};
+        return R_SUCCEEDED(table.QueryInfo(&info, &page_info, address));
+    };
+    LOG_WARNING(Core_ARM, "diag: the first guest exception, at pc {:#x}: what its registers point at", ctx.pc);
+    for (size_t r = 0; r < 32; r++) {
+        const u64 value = r < 29 ? ctx.r[r] : r == 29 ? ctx.fp : r == 30 ? ctx.lr : ctx.sp;
+        const std::string name = r < 29 ? fmt::format("x{}", r) : r == 29 ? "fp" : r == 30 ? "lr" : "sp";
+        Kernel::KMemoryInfo info{};
+        if (value < space_start || value >= space_end || !query(value, info) ||
+            info.GetState() == Kernel::KMemoryState::Free) {
+            continue;
+        }
+        Kernel::KPhysicalAddress physical{};
+        const bool has_physical = table.GetPhysicalAddress(&physical, value);
+        LOG_WARNING(Core_ARM, "diag: {} = {:#x}: block {:#x}+{:#x}, state {:#x}, permission {:#x}, attribute {:#x}; "
+                    "physical {}", name, value, info.GetAddress(), info.GetSize(), u32(info.GetState()),
+                    u32(info.GetPermission()), u32(info.GetAttribute()),
+                    has_physical ? fmt::format("{:#x}", GetInteger(physical)) : std::string("none"));
+        if (!True(info.GetPermission() & Kernel::KMemoryPermission::UserRead)) {
+            continue;
+        }
+        const u64 begin = (std::max)(value & ~u64(63), u64(info.GetAddress()));
+        const u64 end = (std::min)(begin + (r < 2 ? 256 : 64), u64(info.GetEndAddress()));
+        std::vector<u8> bytes(end - begin);
+        if (bytes.empty() || !memory.ReadBlock(begin, bytes.data(), bytes.size())) {
+            continue;
+        }
+        for (size_t at = 0; at < bytes.size(); at += 32) {
+            std::string line;
+            for (size_t i = at; i < (std::min)(at + 32, bytes.size()); i++) {
+                line += fmt::format("{:02x}{}", bytes[i], (i % 8) == 7 ? "  " : " ");
+            }
+            LOG_WARNING(Core_ARM, "diag:   {:#x}: {}", begin + at, line);
+        }
+    }
+    // the memory map (what isn't free)
+    size_t blocks = 0;
+    for (u64 at = space_start; at < space_end && blocks < 800;) {
+        Kernel::KMemoryInfo info{};
+        if (!query(at, info) || info.GetEndAddress() <= at) {
+            break;
+        }
+        if (info.GetState() != Kernel::KMemoryState::Free) {
+            LOG_WARNING(Core_ARM, "diag: map {:#x}+{:#x}: state {:#x}, permission {:#x}, attribute {:#x}",
+                        info.GetAddress(), info.GetSize(), u32(info.GetState()), u32(info.GetPermission()),
+                        u32(info.GetAttribute()));
+            blocks++;
+        }
+        at = info.GetEndAddress();
+    }
+    LOG_WARNING(Core_ARM, "diag: {} blocks mapped", blocks);
+}
+} // namespace
+
 void DynarmicCallbacks64::ExceptionRaised(u64 pc, Dynarmic::A64::Exception exception) {
     switch (exception) {
     case Dynarmic::A64::Exception::WaitForInterrupt:
@@ -143,6 +218,11 @@ void DynarmicCallbacks64::ExceptionRaised(u64 pc, Dynarmic::A64::Exception excep
         } else {
             m_parent.LogBacktrace(m_process);
             LOG_CRITICAL(Core_ARM, "ExceptionRaised(exception = {}, pc = {:08X}, code = {:08X})", static_cast<std::size_t>(exception), pc, m_memory.Read32(pc));
+            if (Common::PS4Diagnostics::MemLogOn()) {
+                Kernel::Svc::ThreadContext ctx{};
+                m_parent.GetContext(ctx);
+                DumpForDiagnosis(m_memory, m_process, ctx);
+            }
         }
     }
 }
