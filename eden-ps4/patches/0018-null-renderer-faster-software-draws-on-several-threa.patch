+/// With EDEN_SW_STATS set: what the software draws did and how long they took, every 2 seconds
+struct Stats {
+    using Clock = std::chrono::steady_clock;
+    bool enabled = std::getenv("EDEN_SW_STATS") != nullptr;
+    Clock::time_point last = Clock::now();
+    u64 draws = 0, triangles = 0, fragments = 0;
+    u32 threads = 1;
+    Clock::duration setup{}, raster{};
+
+    void Report() {
+        const auto now = Clock::now();
+        if (now - last < std::chrono::seconds(2)) {
+            return;
+        }
+        const f64 seconds = std::chrono::duration<f64>(now - last).count();
+        const auto ms = [&](Clock::duration d) { return std::chrono::duration<f64, std::milli>(d).count() / seconds; };
+        LOG_WARNING(Render, "Software draw: a second: {:.0f} draws, {:.0f} triangles, {:.0f} k fragments; "
+                            "{:.1f} ms setting up, {:.1f} ms rasterizing (on up to {} threads)",
+                    f64(draws) / seconds, f64(triangles) / seconds, f64(fragments) / seconds / 1000.0,
+                    ms(setup), ms(raster), threads);
+        last = now;
+        draws = triangles = fragments = 0;
+        setup = raster = {};
+    }
+};
+
+Stats& GetStats() {
+    static Stats stats;
+    return stats;
