+/// Threads that rasterize along with the one drawing, jobs handed out by a counter
+struct SoftwareDraw::Workers {
+    explicit Workers(u32 count) {
+        for (u32 i = 0; i < count; ++i) {
+            threads.emplace_back([this, i] { Loop(i + 1); });
+        }
+    }
+
