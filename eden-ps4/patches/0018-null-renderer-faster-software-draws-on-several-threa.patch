+/// How many threads rasterize: EDEN_SW_THREADS, or half the processors (up to 4)
+u32 SoftwareDraw::RasterThreads() {
+    if (!workers) {
+        u32 count = 0;
+        if (const char* env = std::getenv("EDEN_SW_THREADS")) {
+            count = u32(std::strtoul(env, nullptr, 10));
+        }
+        if (count == 0) {
+            const u32 processors = std::thread::hardware_concurrency();
+            count = processors ? std::clamp(processors / 2, 1u, 4u) : 3;
+        }
+        worker_count = std::clamp(count, 1u, 16u);
+        workers = std::make_unique<Workers>(worker_count - 1);
+    }
+    return worker_count;
+}
