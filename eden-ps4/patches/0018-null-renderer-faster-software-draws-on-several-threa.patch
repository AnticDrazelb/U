+/// A program's values for every lane, its constants filled in
+void Broadcast(const std::vector<Cell>& cells, std::vector<Lanes>& out) {
+    out.resize(cells.size());
+    for (size_t c = 0; c < cells.size(); ++c) {
+        for (u32 k = 0; k < 4; ++k) {
+            std::fill_n(out[c].w[k], LANES, cells[c].w[k]);
+        }
+    }
+}
