 }
 
+// The CondFlags* instruction (and its arguments) that sets the host's flags for `cond` as the
+// guest flags `flags` (an A64SetNZCV's value) have them: a compare (cmp) for a subtraction's, an
+// addition (add) for an addition's but for HI and LS, a test for an And's (C and V clear: not HI,
+// LS), N and Z of the result (test r, r) for EQ, NE, MI, PL when the result is wanted anyway
+// (more than by the flags: its operands then needn't live on), a float compare's (ucomis, swapped
+// for the conditions on N or C alone and HI/LS; EQ and NE only with fp_eq: two jumps, the parity).
+// None for anything else (ADCS, SBCS, CCMP, MSR NZCV, a constant).
+struct CondFlagsChoice {
+    IR::Opcode op;
+    boost::container::static_vector<IR::Value, 2> args;
+};
+static std::optional<CondFlagsChoice> ChooseCondFlags(IR::Inst* flags, IR::Cond cond, bool fp_eq) {
+    const bool nz_only = cond == IR::Cond::EQ || cond == IR::Cond::NE || cond == IR::Cond::MI || cond == IR::Cond::PL;
+    const bool hi_ls = cond == IR::Cond::HI || cond == IR::Cond::LS;
+    if (cond == IR::Cond::AL || cond == IR::Cond::NV)
+        return std::nullopt;
+    if (flags->GetOpcode() == IR::Opcode::FPCompare32 || flags->GetOpcode() == IR::Opcode::FPCompare64) {
+        if (!fp_eq && (cond == IR::Cond::EQ || cond == IR::Cond::NE))
+            return std::nullopt;
+        const bool swap = cond == IR::Cond::MI || cond == IR::Cond::PL || cond == IR::Cond::HI || cond == IR::Cond::LS ||
+                          cond == IR::Cond::CS || cond == IR::Cond::CC;
+        return CondFlagsChoice{flags->GetOpcode() == IR::Opcode::FPCompare32 ? IR::Opcode::CondFlagsFP32 : IR::Opcode::CondFlagsFP64,
+                               {flags->GetArg(swap ? 1 : 0), flags->GetArg(swap ? 0 : 1)}};
+    }
+    if (flags->GetOpcode() != IR::Opcode::GetNZCVFromOp || flags->GetArg(0).IsImmediate())
+        return std::nullopt;
+    const IR::Value source = flags->GetArg(0);
+    IR::Inst* const op = source.GetInst();
+    const bool is64 = source.GetType() == IR::Type::U64;
+    if (!is64 && source.GetType() != IR::Type::U32)
+        return std::nullopt;
+    const auto carry_in = [&](bool value) {
+        return op->GetArg(2).IsImmediate() && op->GetArg(2).GetU1() == value;
+    };
+    const bool result_used = op->UseCount() > 1;
+    const IR::Opcode nz = is64 ? IR::Opcode::CondFlagsNZ64 : IR::Opcode::CondFlagsNZ32;
+    switch (op->GetOpcode()) {
+    case IR::Opcode::Sub32:
+    case IR::Opcode::Sub64:
+        if (!carry_in(true))
+            return std::nullopt;  // (SBCS)
