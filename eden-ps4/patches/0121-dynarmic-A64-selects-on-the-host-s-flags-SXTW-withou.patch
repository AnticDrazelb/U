+// (A64SelectOnHostFlagsPass) The host's flags as the CondFlags* right before this left them:
+// only moves between them (no immediate loaded with an xor), then a cmov
+static void EmitConditionalSelectHost(BlockOfCode& code, EmitContext& ctx, IR::Inst* inst, int bitsize, EmitX64::HostCondFlags kind) {
+    ASSERT(kind != EmitX64::HostCondFlags::None);
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const IR::Cond cond = args[0].GetImmediateCond();
+    const auto load = [&](Argument& arg, bool scratch) -> Xbyak::Reg {
+        if (arg.IsImmediate()) {
+            const Xbyak::Reg64 r = ctx.reg_alloc.ScratchGpr(code);
+            const u64 value = arg.GetImmediateU64();
+            if (bitsize == 32 || value <= 0xFFFFFFFF)
+                code.mov(r.cvt32(), u32(value));  // (mov: the flags stay)
+            else
+                code.mov(r, value);
+            return r.changeBit(bitsize);
+        }
+        return (scratch ? ctx.reg_alloc.UseScratchGpr(code, arg) : ctx.reg_alloc.UseGpr(code, arg)).changeBit(bitsize);
+    };
+    const Xbyak::Reg else_ = load(args[2], true);
+    const Xbyak::Reg then_ = load(args[1], false);
+    using K = EmitX64::HostCondFlags;
+    if (kind == K::FP) {
+        // ucomis (swapped for some, ChooseCondFlags): EmitCond's FP mapping, EQ and NE not here
+        switch (cond) {
+        case IR::Cond::GT: case IR::Cond::MI: case IR::Cond::CC: code.cmova(else_, then_); break;
+        case IR::Cond::GE: case IR::Cond::LS: code.cmovae(else_, then_); break;
+        case IR::Cond::LT: case IR::Cond::HI: code.cmovb(else_, then_); break;
+        case IR::Cond::LE: case IR::Cond::PL: case IR::Cond::CS: code.cmovbe(else_, then_); break;
+        case IR::Cond::VS: code.cmovp(else_, then_); break;
+        case IR::Cond::VC: code.cmovnp(else_, then_); break;
+        default: UNREACHABLE();
+        }
+    } else {
+        ASSERT(kind == K::Sub || (cond != IR::Cond::HI && cond != IR::Cond::LS));
+        switch (cond) {
+        case IR::Cond::EQ: code.cmovz(else_, then_); break;
+        case IR::Cond::NE: code.cmovnz(else_, then_); break;
+        // ARM's C after a subtraction is x64's CF inverted (no borrow); after an addition, the carry;
+        // after a test clear (as x64's)
+        case IR::Cond::CS: kind == K::Sub ? code.cmovae(else_, then_) : code.cmovc(else_, then_); break;
+        case IR::Cond::CC: kind == K::Sub ? code.cmovb(else_, then_) : code.cmovnc(else_, then_); break;
+        case IR::Cond::MI: code.cmovs(else_, then_); break;
+        case IR::Cond::PL: code.cmovns(else_, then_); break;
+        case IR::Cond::VS: code.cmovo(else_, then_); break;
+        case IR::Cond::VC: code.cmovno(else_, then_); break;
+        case IR::Cond::HI: code.cmova(else_, then_); break;
+        case IR::Cond::LS: code.cmovbe(else_, then_); break;
+        case IR::Cond::GE: code.cmovge(else_, then_); break;
+        case IR::Cond::LT: code.cmovl(else_, then_); break;
+        case IR::Cond::GT: code.cmovg(else_, then_); break;
+        case IR::Cond::LE: code.cmovle(else_, then_); break;
+        default: UNREACHABLE();
+        }
+    }
+    ctx.reg_alloc.DefineValue(code, inst, else_);
+}
+
+void EmitX64::EmitConditionalSelectHost32(EmitContext& ctx, IR::Inst* inst) {
+    const HostCondFlags kind = host_cond_flags;
+    host_cond_flags = HostCondFlags::None;
+    EmitConditionalSelectHost(code, ctx, inst, 32, kind);
+}
+
+void EmitX64::EmitConditionalSelectHost64(EmitContext& ctx, IR::Inst* inst) {
+    const HostCondFlags kind = host_cond_flags;
+    host_cond_flags = HostCondFlags::None;
+    EmitConditionalSelectHost(code, ctx, inst, 64, kind);
+}
+
