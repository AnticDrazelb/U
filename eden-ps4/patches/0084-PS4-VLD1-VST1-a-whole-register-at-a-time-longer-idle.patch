diff --git a/src/common/ps4_perf.h b/src/common/ps4_perf.h
index ca6ff43b3..667712ced 100644
--- a/src/common/ps4_perf.h
+++ b/src/common/ps4_perf.h
@@ -49,6 +49,20 @@ inline std::atomic<uint64_t> jit_compile_ns{0};
 // each emulated core's code cache: KiB of it free (after its last translation), and its whole flushes
 inline std::atomic<uint32_t> jit_cache_free_kib[4];
 inline std::atomic<uint64_t> jit_core_full_flushes[4];
+// The game's system calls by the emulated core their thread was on when it made them: how many,
+// and the time until each returned (a wait's whole length: what the core's threads waited on)
+inline constexpr size_t SvcIds = 0x80;
+struct alignas(64) SvcCore {
+    std::atomic<uint64_t> count[SvcIds];
+    std::atomic<uint64_t> total_ns[SvcIds];
+};
+inline SvcCore svc_cores[4];
+inline void AddSvc(size_t core, uint32_t id, uint64_t ns) {
+    if (core < 4 && id < SvcIds) {
+        svc_cores[core].count[id].fetch_add(1, std::memory_order_relaxed);
+        svc_cores[core].total_ns[id].fetch_add(ns, std::memory_order_relaxed);
+    }
+}
 // The kernel's timer (KHardwareTimer: the game's threads' sleeps and timed waits ending), of the
 // timer events
 inline std::atomic<uint64_t> kernel_timer_tasks{0};
