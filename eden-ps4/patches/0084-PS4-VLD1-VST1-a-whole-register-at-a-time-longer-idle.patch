     : m_core_index{core_index}
 {
     m_is_single_core = !kernel.IsMulticore();
+#ifdef __OPENORBIS__
+    // The cores the game runs on (0-2) have a core of the PS4 each when threads are pinned (the
+    // launcher's Thread Placement): theirs spin far longer, which takes nothing from any other
+    // thread, and catch nearly every wake-up without a sleep's latency (about 20 us after the
+    // signal) or the waking thread's system call. Core 3 shares its module with the services,
+    // audio and the Vulkan worker: a short spin.
+    const char* pinned = std::getenv("EDEN_PS4_PIN_THREADS");
+    if (core_index < 3 && (!pinned || pinned[0] != '0')) {
+        m_idle_spin = std::chrono::microseconds(1000);
+    }
+#endif
 }
 PhysicalCore::~PhysicalCore() = default;
 
@@ -236,9 +249,8 @@ void PhysicalCore::Idle() {
     // A core with nothing to run is usually handed work within microseconds (a thread another core
     // made ready, a service's reply), and waking a sleeping host thread costs far more than that
     // on the PS4: every handoff between the game's threads paid it. So an idle core spins for a
-    // while first (a core of the PS4's seven the game isn't using), then sleeps.
-    constexpr auto SpinTime = std::chrono::microseconds(50);
-    const auto spin_end = Common::g_wall_clock.GetTimeNS() + SpinTime;
+    // while first (m_idle_spin), then sleeps.
+    const auto spin_end = Common::g_wall_clock.GetTimeNS() + m_idle_spin;
     while (!m_is_interrupted.load(std::memory_order_acquire)) {
         for (int i = 0; i < 16; i++) {
             _mm_pause();
