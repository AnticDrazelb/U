+    if (nelem == 1 && !ir.current_location.EFlag()) {
+        // VST1: the registers' bytes in order (little-endian), whatever the element size: one
+        // 64-bit store a D register, the two halves of a Q register taken from the one value
+        const IR::U32 base = ir.GetRegister(n);
+        const auto at = [&](size_t r) -> IR::U32 { return r == 0 ? base : IR::U32{ir.Add(base, ir.Imm32(static_cast<u32>(8 * r)))}; };
+        for (size_t r = 0; r < regs;) {
+            const ExtReg ext_reg = d + r;
+            if (RegNumber(ext_reg) % 2 == 0 && r + 1 < regs) {
+                const IR::U128 q = ir.GetVector(ExtReg::Q0 + RegNumber(ext_reg) / 2);
+                ir.WriteMemory64(at(r), IR::U64{ir.VectorGetElement(64, q, 0)}, IR::AccType::NORMAL);
+                ir.WriteMemory64(at(r + 1), IR::U64{ir.VectorGetElement(64, q, 1)}, IR::AccType::NORMAL);
+                r += 2;
+            } else {
+                ir.WriteMemory64(at(r), IR::U64{ir.GetExtendedRegister(ext_reg)}, IR::AccType::NORMAL);
+                r += 1;
