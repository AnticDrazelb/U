-/// The texture instructions, a lane at a time
-void RunTexture(const SoftwareDraw::Program& program, const Op& o, Lanes* c, Io& io, u32 n) {
+/// How the fast paths take a texel coordinate outside the texture along an axis: repeated (a
+/// power-of-two size), clamped to the edge, or not at all (the lane done one at a time)
+struct AxisWrap {
+    bool repeat, clamp;
+    s32 size;
+
+    AxisWrap(Tegra::Texture::WrapMode mode, s32 size_)
+        : repeat{mode == Tegra::Texture::WrapMode::Wrap && (size_ & (size_ - 1)) == 0},
+          clamp{mode == Tegra::Texture::WrapMode::ClampToEdge}, size{size_} {}
+
+    /// The coordinate wrapped or clamped; 'inside' cleared when it can't be
+    s32 operator()(s32 i, bool& inside) const {
+        if (repeat) {
+            return i & (size - 1);
+        }
+        if (clamp) {
+            return std::clamp(i, 0, size - 1);
+        }
+        inside &= i >= 0 && i < size;
+        return i;
+    }
+};
+
+/// A lane's implicit level of detail, before the sampler's bias: from its quad's coordinates, as
+/// the hardware does it, once a quad (the differences across its top row and down its left
+/// column), in texels of the base level
+f32 QuadLod(const Texture& texture, Shader::TextureType type, const Lanes& coords, u32 lane) {
+    using T = Shader::TextureType;
+    const u32 q = QuadTopLeft(lane), qx = q | 1, qy = q | 8;
+    const Level& level = texture.levels[texture.base_level];
+    std::array<f32, 3> size{f32(level.width), f32(level.height), f32(level.depth)};
+    u32 dims = 2;
+    switch (type) {
+    case T::Color1D:
+    case T::ColorArray1D:
+        dims = 1;
+        break;
+    case T::Color2DRect:
+        size = {1.0f, 1.0f, 1.0f};
+        break;
+    case T::Color3D:
+        dims = 3;
+        break;
+    case T::ColorCube:
+    case T::ColorArrayCube: {
+        // the direction's change over its major axis, on a face the base level's size
+        const f32 major = std::max({std::fabs(Fl(coords, q, 0)), std::fabs(Fl(coords, q, 1)),
+                                    std::fabs(Fl(coords, q, 2))});
+        const f32 scale = major > 0.0f ? 0.5f * size[0] / major : 0.0f;
+        size = {scale, scale, scale};
+        dims = 3;
+        break;
+    }
+    default:
+        break;
+    }
+    f32 across = 0.0f, down = 0.0f;
+    for (u32 k = 0; k < dims; ++k) {
+        const f32 dx = (Fl(coords, qx, k) - Fl(coords, q, k)) * size[k];
+        const f32 dy = (Fl(coords, qy, k) - Fl(coords, q, k)) * size[k];
+        across += dx * dx, down += dy * dy;
+    }
+    const f32 rho2 = std::max(across, down);
+    return rho2 > 0.0f ? 0.5f * std::log2(rho2) : -128.0f;
+}
+
+/// Each running lane's implicit level of detail, before the sampler's bias: its quad's (see
+/// QuadLod) in fragment shaders, the base level elsewhere
+void ImplicitLods(const Io& io, const Texture& texture, Shader::TextureType type, const Lanes& coords,
+                  u32 exec, f32* lods) {
+    std::fill_n(lods, LANES, 0.0f);
+    if (!io.quads) {
+        return;
+    }
+    for (u32 top_left = 0; top_left < LANES / 2; top_left += 2) {
+        if (exec & (0x303u << top_left)) {
+            const f32 lod = QuadLod(texture, type, coords, top_left);
+            lods[top_left] = lods[top_left + 1] = lods[top_left + 8] = lods[top_left + 9] = lod;
+        }
+    }
+}
+
+/// The fast paths' samples of a level of a 2D texture of 8-bit texels (an identity swizzle; for
+/// bilinear ones, not sRGB), for the lanes in 'exec': all lanes at once in arrays (the compiler
+/// vectorizes all but the texel loads), each lane's texel or footprint wrapped or clamped as the
+/// sampler says. Into 'd' for those lanes; returned, the lanes it can't do (a footprint outside the
+/// texture, neither wrapped nor clamped), for one at a time.
+u32 SampleLevelFast(const Texture& texture, const Binding& binding, const Level& level, bool linear,
+                    const Lanes& coords, f32 scale_u, f32 scale_v, s32 offset_x, s32 offset_y, u32 exec,
+                    Lanes& d) {
+    const s32 width = s32(level.width), height = s32(level.height);
+    const AxisWrap wrap_x{binding.wrap[0], width}, wrap_y{binding.wrap[1], height};
+    const u32* const texels = level.rgba8.data() + size_t(texture.base_layer) * level.height * level.depth * level.width;
+    alignas(64) f32 out[4][LANES];
+    u32 slow = 0;
+    if (!linear) { // the texel under each lane's coordinates
+        alignas(64) u32 index[LANES];
+        for (u32 i = 0; i < LANES; ++i) {
+            f32 u = Fl(coords, i, 0) * scale_u, v = Fl(coords, i, 1) * scale_v;
+            u = u == u ? u : 0.0f, v = v == v ? v : 0.0f;
+            bool inside = true;
+            const s32 x = wrap_x(FloorToInt(std::clamp(u * f32(width), -1e6f, 1e6f)) + offset_x, inside);
+            const s32 y = wrap_y(FloorToInt(std::clamp(v * f32(height), -1e6f, 1e6f)) + offset_y, inside);
+            index[i] = inside ? u32(y) * level.width + u32(x) : 0; // (done again one at a time if not)
+            slow |= u32(!inside) << i;
+        }
+        slow &= exec;
+        if (slow == exec) {
+            return slow;
+        }
+        const f32* const rgb = texture.rgb_table;
+        const f32* const unorm = UnormTable().data();
+        for (u32 i = 0; i < LANES; ++i) {
+            const u32 t = texels[index[i]];
+            out[0][i] = rgb[t & 0xFF], out[1][i] = rgb[(t >> 8) & 0xFF], out[2][i] = rgb[(t >> 16) & 0xFF];
+            out[3][i] = unorm[t >> 24];
+        }
+    } else { // the four texels around each lane's coordinates, weighted in 8 bits
+        alignas(64) u32 wx[LANES], wy[LANES], left[LANES], right[LANES], top[LANES], bottom[LANES];
+        for (u32 i = 0; i < LANES; ++i) {
+            f32 u = Fl(coords, i, 0) * scale_u, v = Fl(coords, i, 1) * scale_v;
+            u = u == u ? u : 0.0f, v = v == v ? v : 0.0f;
+            const f32 tx = std::clamp(u * f32(width) - 0.5f, -1e6f, 1e6f);
+            const f32 ty = std::clamp(v * f32(height) - 0.5f, -1e6f, 1e6f);
+            const s32 ix = FloorToInt(tx), iy = FloorToInt(ty);
+            wx[i] = u32(s32((tx - f32(ix)) * 256.0f + 0.5f));
+            wy[i] = u32(s32((ty - f32(iy)) * 256.0f + 0.5f));
+            bool inside = true;
+            const s32 xa = wrap_x(ix + offset_x, inside), xb = wrap_x(ix + offset_x + 1, inside);
+            const s32 ya = wrap_y(iy + offset_y, inside), yb = wrap_y(iy + offset_y + 1, inside);
+            left[i] = inside ? u32(xa) : 0, right[i] = inside ? u32(xb) : 0;
+            top[i] = inside ? u32(ya) * level.width : 0, bottom[i] = inside ? u32(yb) * level.width : 0;
+            slow |= u32(!inside) << i;
+        }
+        slow &= exec;
+        if (slow == exec) {
+            return slow;
+        }
+        alignas(64) u32 t00[LANES], t10[LANES], t01[LANES], t11[LANES];
+        for (u32 i = 0; i < LANES; ++i) {
+            t00[i] = texels[top[i] + left[i]], t10[i] = texels[top[i] + right[i]];
+            t01[i] = texels[bottom[i] + left[i]], t11[i] = texels[bottom[i] + right[i]];
+        }
+        for (u32 ch = 0; ch < 4; ++ch) {
+            const u32 shift = ch * 8;
+            for (u32 i = 0; i < LANES; ++i) {
+                const u32 w00 = (256 - wx[i]) * (256 - wy[i]), w10 = wx[i] * (256 - wy[i]);
+                const u32 w01 = (256 - wx[i]) * wy[i], w11 = wx[i] * wy[i];
+                const u32 sum = ((t00[i] >> shift) & 0xFF) * w00 + ((t10[i] >> shift) & 0xFF) * w10 +
+                                ((t01[i] >> shift) & 0xFF) * w01 + ((t11[i] >> shift) & 0xFF) * w11;
+                out[ch][i] = f32((sum + 32768) >> 16) * (1.0f / 255.0f);
+            }
+        }
+    }
+    for (u32 ch = 0; ch < 4; ++ch) {
+        for (u32 i = 0; i < LANES; ++i) {
+            d.w[ch][i] = ((exec >> i) & 1) != 0 ? std::bit_cast<u32>(out[ch][i]) : d.w[ch][i];
+        }
+    }
+    return slow;
+}
