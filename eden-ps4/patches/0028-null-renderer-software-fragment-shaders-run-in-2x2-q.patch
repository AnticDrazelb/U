+/// A fragment shader's lanes are 8 columns by 2 rows of pixels: four 2x2 quads. Each lane's
+/// invocation id, as the guest's warp numbers them (a quad's four together: top left, top right,
+/// bottom left, bottom right), and each id's lane
+constexpr std::array<u32, LANES> INVOCATION_ID = [] {
+    std::array<u32, LANES> ids{};
+    for (u32 i = 0; i < LANES; ++i) {
+        ids[i] = (i & 7) / 2 * 4 + (i & 1) + (i / 8) * 2;
+    }
+    return ids;
+}();
+constexpr std::array<u32, LANES> INVOCATION_LANE = [] {
+    std::array<u32, LANES> lanes{};
+    for (u32 i = 0; i < LANES; ++i) {
+        lanes[INVOCATION_ID[i]] = i;
+    }
+    return lanes;
+}();
+/// The top-left lane of a lane's quad (the one to its right is | 1, the one below | 8)
+constexpr u32 QuadTopLeft(u32 lane) {
+    return lane & ~9u;
+}
