diff --git a/src/dynarmic/src/dynarmic/ir/opt_passes.cpp b/src/dynarmic/src/dynarmic/ir/opt_passes.cpp
index 85e2ac9a9..8886c0595 100644
--- a/src/dynarmic/src/dynarmic/ir/opt_passes.cpp
+++ b/src/dynarmic/src/dynarmic/ir/opt_passes.cpp
@@ -92,7 +92,7 @@ static void ConstantMemoryReads(IR::Block& block, A32::UserCallbacks* cb) {
 // A32ReadMemoryVia* or A32WriteMemoryVia* (whose slow path is the access's own walk). Only groups
 // spanning at most 256 bytes: one that crosses into the next page at run time costs that walk again.
 template<typename Walks>
-static void A32SharedWalkPass(IR::Block& block, Walks&& walks) {
+static void A32SharedWalkPass(IR::Block& block, Walks&& walks, size_t min_members = 2) {
     struct Member {
         IR::Block::iterator it;
         s64 offset;
@@ -161,7 +161,7 @@ static void A32SharedWalkPass(IR::Block& block, Walks&& walks) {
         group->members.push_back({it, offset, bytes, via, write});
     }
     for (Group& group : groups) {
-        if (group.members.size() < 2) {
+        if (group.members.size() < min_members) {
             continue;
         }
         s64 lowest = group.members[0].offset, end = lowest;
@@ -1706,8 +1706,39 @@ void Optimize(IR::Block& block, const A32::UserConfig& conf, const Optimization:
     }
 }
 
-void A32SharedWalkForSlowAccesses(IR::Block& block, const std::function<bool(const IR::Inst&)>& walks) {
-    Optimization::A32SharedWalkPass(block, walks);
+AddressBase ClassifyAddressBase(const IR::Inst& access) {
+    IR::Value value = access.GetArg(1);
+    for (int depth = 0; depth < 16; depth++) {
+        while (value.IsIdentity())
+            value = value.GetInst()->GetArg(0);
+        if (value.IsImmediate())
+            return AddressBase::Other;
+        const IR::Inst* inst = value.GetInst();
+        switch (inst->GetOpcode()) {
+        case IR::Opcode::Add32:
+        case IR::Opcode::Sub32:
+        case IR::Opcode::Add64:
+        case IR::Opcode::Sub64:
+            if (!inst->GetArg(1).IsImmediate())
+                return AddressBase::Other;
+            value = inst->GetArg(0);
+            continue;
+        case IR::Opcode::A32GetRegister:
+            return inst->GetArg(0).GetA32RegRef() == A32::Reg::SP ? AddressBase::Stack : AddressBase::Other;
+        case IR::Opcode::A64GetSP:
+            return AddressBase::Stack;
+        case IR::Opcode::A32CoprocGetOneWord:
+        case IR::Opcode::A64GetTPIDRRO:
+            return AddressBase::ThreadLocal;
+        default:
+            return AddressBase::Other;
+        }
+    }
+    return AddressBase::Other;
+}
+
+void A32SharedWalkForSlowAccesses(IR::Block& block, const std::function<bool(const IR::Inst&)>& walks, size_t min_members) {
+    Optimization::A32SharedWalkPass(block, walks, min_members);
     Optimization::DeadCodeElimination(block);
     Optimization::IdentityRemovalPass(block);
 }
diff --git a/src/dynarmic/src/dynarmic/ir/opt_passes.h b/src/dynarmic/src/dynarmic/ir/opt_passes.h
index b006eddbe..a7a9d6d3b 100644
--- a/src/dynarmic/src/dynarmic/ir/opt_passes.h
+++ b/src/dynarmic/src/dynarmic/ir/opt_passes.h
@@ -18,6 +18,7 @@ struct UserCallbacks;
 struct UserConfig;
 }
 
+#include <cstddef>
 #include <functional>
 
 namespace Dynarmic::IR {
@@ -40,6 +41,12 @@ void Optimize(IR::Block& block, const A64::UserConfig& conf, const Optimization:
 /// A32 with fastmem: the loads and stores that fastmem was declined for (`walks`: they walk the page
 /// table each), when several go through one base register value plus constants, share one walk
 /// (A32SharedWalkPass); the others keep fastmem
-void A32SharedWalkForSlowAccesses(IR::Block& block, const std::function<bool(const IR::Inst&)>& walks);
+void A32SharedWalkForSlowAccesses(IR::Block& block, const std::function<bool(const IR::Inst&)>& walks,
+                                  std::size_t min_members = 2);
+
+/// What a memory access's address is, plus or minus constants: the stack pointer, the thread
+/// pointer (a read of CP15's TPIDRURO, TPIDRRO_EL0), or something else
+enum class AddressBase : unsigned char { Other = 0, Stack = 1, ThreadLocal = 2 };
+AddressBase ClassifyAddressBase(const IR::Inst& access);
 
 }  // namespace Dynarmic::Optimization
