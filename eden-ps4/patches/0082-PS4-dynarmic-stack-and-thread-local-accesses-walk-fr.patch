+++ b/src/dynarmic/src/dynarmic/backend/x64/emit_x64_memory.cpp.inc
@@ -41,6 +41,8 @@ FakeCall AxxEmitX64::FastmemCallback(u64 rip_) {
             const auto marker = iter->second.marker;
             do_not_fastmem.insert(marker);
             blocks_without_fastmem.insert(std::get<0>(marker));
+            stack_walks |= iter->second.base == static_cast<unsigned char>(Optimization::AddressBase::Stack);
