+++ b/src/dynarmic/src/dynarmic/backend/x64/a32_interface.cpp
@@ -214,12 +214,24 @@ private:
         // Accesses fastmem was declined for (pages the PS4 can't map at the game's addresses: a
         // thread's stack, its local storage) walk the page table: one walk for those through one
         // base (a PUSH or POP, a function's stack frame), as without fastmem
-        if (conf.fastmem_pointer && conf.fastmem_declined_shared_walk && emitter.HasAccessWithoutFastmem(descriptor)) {
+        // (and, once fastmem was declined for one through the stack or thread pointer, every access
+        // through it, a lone one too: no fault and recompile for each of them first)
+        if (conf.fastmem_pointer && conf.fastmem_declined_shared_walk &&
+            (emitter.stack_walks || emitter.thread_local_walks || emitter.HasAccessWithoutFastmem(descriptor))) {
+            const bool proactive = emitter.stack_walks || emitter.thread_local_walks;
             Optimization::A32SharedWalkForSlowAccesses(ir_block, [&](const IR::Inst& inst) {
-                return emitter.AccessWithoutFastmem(descriptor, inst.GetName());
-            });
+                if (emitter.AccessWithoutFastmem(descriptor, inst.GetName()))
+                    return true;
+                if (!proactive)
+                    return false;
+                const auto base = Optimization::ClassifyAddressBase(inst);
+                return (emitter.stack_walks && base == Optimization::AddressBase::Stack) ||
+                       (emitter.thread_local_walks && base == Optimization::AddressBase::ThreadLocal);
+            }, proactive ? 1 : 2);
         }
         auto block = emitter.Emit(ir_block);
+        ::Common::PS4Perf::jit_cache_free_kib[conf.processor_id & 3].store(
+            u32(block_of_code.SpaceRemaining() >> 10), std::memory_order_relaxed);
         ::Common::PS4Perf::jit_compile_ns.fetch_add(
             u64(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - compile_start).count()),
             std::memory_order_relaxed);
@@ -239,6 +251,7 @@ private:
             jit_state.ResetRSB();
             if (invalidate_entire_cache) {
                 ::Common::PS4Perf::jit_full_flushes.fetch_add(1, std::memory_order_relaxed);
+                ::Common::PS4Perf::jit_core_full_flushes[conf.processor_id & 3].fetch_add(1, std::memory_order_relaxed);
                 block_of_code.ClearCache();
                 emitter.ClearCache();
             } else {
