+        unsigned char base = 0;  // (Optimization::AddressBase of the access's address)
     };
     std::optional<DoNotFastmemMarker> ShouldFastmem(A32EmitContext& ctx, IR::Inst* inst) const;
     FakeCall FastmemCallback(u64 rip);
@@ -143,6 +144,9 @@ public:
     ::Common::unordered_set<DoNotFastmemMarker> do_not_fastmem;
     // the blocks with an access fastmem was declined for (FastmemCallback)
     ::Common::unordered_set<IR::LocationDescriptor> blocks_without_fastmem;
