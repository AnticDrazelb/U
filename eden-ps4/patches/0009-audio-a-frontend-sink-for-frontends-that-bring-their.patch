+            }
+            return std::make_unique<FrontendSink>(device_id);
+        },
+        [](bool capture) { return std::vector<std::string>{"frontend"}; },
+        []() { return FrontendFramesPerBuffer; },
+    },
     SinkDetails{
         Settings::AudioEngine::Null,
         [](std::string_view device_id) -> std::unique_ptr<Sink> {
