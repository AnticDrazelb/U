new file mode 100644
index 000000000..45a92cc50
--- /dev/null
+++ b/src/audio_core/sink/frontend_sink.cpp
@@ -0,0 +1,156 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+
+#include "audio_core/common/common.h"
+#include "audio_core/sink/frontend_sink.h"
+#include "audio_core/sink/sink_stream.h"
+#include "common/logging.h"
+#include "common/thread.h"
+
+namespace AudioCore::Sink {
+
+namespace {
+
+std::mutex factory_mutex;
+FrontendAudioFactory frontend_factory;
+
+class FrontendSinkStream final : public SinkStream {
+public:
+    FrontendSinkStream(u32 device_channels_, u32 system_channels_, const std::string& name_,
+                       StreamType type_, Core::System& system_)
+        : SinkStream{system_, type_} {
+        device_channels = device_channels_;
+        system_channels = system_channels_;
+        name = name_;
+        if (type == StreamType::In) {
+            return; // no audio input
+        }
+        {
+            std::scoped_lock lk{factory_mutex};
+            if (frontend_factory) {
+                output = frontend_factory();
+            }
+        }
+        if (output && !output->Open(FrontendFramesPerBuffer, device_channels)) {
+            LOG_ERROR(Audio_Sink, "the frontend's audio output didn't open for stream {}", name);
+            output.reset();
+        }
+        if (output) {
+            thread = std::jthread([this](std::stop_token token) { Play(token); });
+        }
+    }
+
+    ~FrontendSinkStream() override {
+        Finalize();
+    }
+
+    void Finalize() override {
+        if (thread.joinable()) {
+            thread.request_stop();
+            start_cv.notify_all();
+            thread.join();
+        }
+        output.reset();
+    }
+
+    void Start(bool resume = false) override {
+        if (!paused) {
+            return;
+        }
+        {
+            std::scoped_lock lk{start_mutex};
+            paused = false;
+        }
+        start_cv.notify_all();
+    }
+
+    void Stop() override {
+        if (paused) {
+            return;
+        }
+        SignalPause();
+    }
+
+private:
+    void Play(std::stop_token token) {
+        Common::SetCurrentThreadName("FrontendAudio");
+        std::vector<s16> buffer(FrontendFramesPerBuffer * device_channels);
+        while (!token.stop_requested()) {
+            if (paused) {
+                std::unique_lock lk{start_mutex};
+                start_cv.wait(lk, token, [this] { return !paused.load(); });
+                continue;
+            }
+            ProcessAudioOutAndRender(buffer, FrontendFramesPerBuffer);
+            output->Output(buffer);
+        }
+    }
+
+    std::unique_ptr<FrontendAudioOutput> output;
+    std::mutex start_mutex;
+    std::condition_variable_any start_cv;
+    std::jthread thread;
+};
+
+} // Anonymous namespace
+
+void SetFrontendAudio(FrontendAudioFactory factory) {
+    std::scoped_lock lk{factory_mutex};
+    frontend_factory = std::move(factory);
+}
+
+bool HasFrontendAudio() {
+    std::scoped_lock lk{factory_mutex};
+    return static_cast<bool>(frontend_factory);
+}
+
+FrontendSink::FrontendSink(std::string_view) {
+    device_channels = 2;
+}
+
+FrontendSink::~FrontendSink() = default;
+
+SinkStream* FrontendSink::AcquireSinkStream(Core::System& system, u32 system_channels_,
+                                            const std::string& name, StreamType type) {
+    system_channels = system_channels_;
+    SinkStreamPtr& stream = sink_streams.emplace_back(std::make_unique<FrontendSinkStream>(
+        device_channels, system_channels, name, type, system));
+    stream->SetDeviceVolume(device_volume);
+    return stream.get();
+}
+
+void FrontendSink::CloseStream(SinkStream* stream) {
+    for (size_t i = 0; i < sink_streams.size(); i++) {
+        if (sink_streams[i].get() == stream) {
+            sink_streams.erase(sink_streams.begin() + i);
+            break;
+        }
+    }
+}
+
+void FrontendSink::CloseStreams() {
+    sink_streams.clear();
+}
+
+f32 FrontendSink::GetDeviceVolume() const {
+    return device_volume;
+}
+
+void FrontendSink::SetDeviceVolume(f32 volume) {
+    device_volume = volume;
+    for (auto& stream : sink_streams) {
+        stream->SetDeviceVolume(volume);
+    }
+}
+
+void FrontendSink::SetSystemVolume(f32 volume) {
+    for (auto& stream : sink_streams) {
+        stream->SetSystemVolume(volume);
+    }
+}
+
+} // namespace AudioCore::Sink
diff --git a/src/audio_core/sink/frontend_sink.h b/src/audio_core/sink/frontend_sink.h
new file mode 100644
index 000000000..ee900befd
--- /dev/null
+++ b/src/audio_core/sink/frontend_sink.h
@@ -0,0 +1,56 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <functional>
+#include <memory>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "audio_core/sink/sink.h"
+#include "common/common_types.h"
+
+namespace AudioCore::Sink {
+
+/// An audio output a frontend provides, for platforms without cubeb or SDL: 48 kHz, signed 16-bit
+/// samples, channels interleaved.
+class FrontendAudioOutput {
+public:
+    virtual ~FrontendAudioOutput() = default;
+    /// Opens the output for buffers of `frames` frames of `channels` channels. False if it can't.
+    virtual bool Open(u32 frames, u32 channels) = 0;
+    /// Plays one buffer, blocking until the output takes it.
+    virtual void Output(std::span<const s16> samples) = 0;
+};
+
+/// Frames per buffer the frontend sink hands to an output: about 10 ms.
+constexpr u32 FrontendFramesPerBuffer = 512;
+
+using FrontendAudioFactory = std::function<std::unique_ptr<FrontendAudioOutput>()>;
+
+/// Sets what the frontend sink (AudioEngine::Frontend) plays through: one output per stream.
+void SetFrontendAudio(FrontendAudioFactory factory);
+bool HasFrontendAudio();
+
+/// A sink whose streams each play through a frontend's output, from a thread of their own.
+class FrontendSink final : public Sink {
+public:
+    explicit FrontendSink(std::string_view device_id);
+    ~FrontendSink() override;
+
+    SinkStream* AcquireSinkStream(Core::System& system, u32 system_channels,
+                                  const std::string& name, StreamType type) override;
+    void CloseStream(SinkStream* stream) override;
+    void CloseStreams() override;
+    f32 GetDeviceVolume() const override;
+    void SetDeviceVolume(f32 volume) override;
+    void SetSystemVolume(f32 volume) override;
+
+private:
+    std::vector<SinkStreamPtr> sink_streams;
+};
+
+} // namespace AudioCore::Sink
