+// The FPSCR's NZCV (a VCMP's flags) along the same paths: a VMRS reads it, a VCMP or VMSR sets it;
+// calls and returns as for the flags (abi); anything else that leaves the code it can follow
+// counts as a read
+struct FpscrLookahead {
+    FlagsLookahead& code;  // (its reads, runs and abi)
+    int budget = 48;
+    boost::container::static_vector<u32, 16> targets;
+
+    bool Seen(u32 pc) {
+        if (std::find(targets.begin(), targets.end(), pc) != targets.end())
+            return true;
+        if (targets.size() < targets.capacity())
+            targets.push_back(pc);
+        return false;
+    }
+
+    bool Live(u32 pc, int branches) {
+        if (Seen(pc))
+            return false;
+        for (;;) {
+            if (--budget < 0)
+                return true;
+            const auto word = code.tcb->MemoryReadCode(pc);
+            if (!word || !code.Read(pc))
+                return true;
+            const u32 inst = *word;
+            const u32 cond = inst >> 28;
+            const bool conditional = cond != 0xE;
+            if (cond == 0xF) {
