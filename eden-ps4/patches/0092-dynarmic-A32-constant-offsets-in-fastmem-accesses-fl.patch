+void EmitX64::EmitCondFlagsFP32(EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const Xbyak::Xmm a = ctx.reg_alloc.UseXmm(code, args[0]);
+    const Xbyak::Xmm b = ctx.reg_alloc.UseXmm(code, args[1]);
+    code.ucomiss(a, b);
+    host_cond_flags = HostCondFlags::FP;
+}
+
+void EmitX64::EmitCondFlagsFP64(EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const Xbyak::Xmm a = ctx.reg_alloc.UseXmm(code, args[0]);
+    const Xbyak::Xmm b = ctx.reg_alloc.UseXmm(code, args[1]);
+    code.ucomisd(a, b);
+    host_cond_flags = HostCondFlags::FP;
+}
+
 Xbyak::Label EmitX64::EmitCond(IR::Cond cond) {
     Xbyak::Label pass;
 
+    if (host_cond_flags == HostCondFlags::FP) {
+        // ucomis x, y: greater CF=ZF=PF=0, less CF=1, equal ZF=1, unordered ZF=PF=CF=1. ARM's VCMP
+        // flags: equal Z and C, less N, greater C, unordered C and V. The conditions on N or on C
+        // alone and HI/LS compare the other way round (A32DeadNZCVPass swaps the operands for
+        // them), so that each is one jump; EQ and NE also look at the parity (unordered).
+        host_cond_flags = HostCondFlags::None;
+        nzcv_stored_end = nullptr;
+        switch (cond) {
+        case IR::Cond::EQ: {
+            Xbyak::Label unordered;
+            code.jp(unordered);
+            code.jz(pass);
+            code.L(unordered);
+            break;
+        }
+        case IR::Cond::NE: code.jp(pass); code.jnz(pass); break;
+        case IR::Cond::GT: case IR::Cond::MI: case IR::Cond::CC: code.ja(pass); break;
+        case IR::Cond::GE: case IR::Cond::LS: code.jae(pass); break;
+        case IR::Cond::LT: case IR::Cond::HI: code.jb(pass); break;
+        case IR::Cond::LE: case IR::Cond::PL: case IR::Cond::CS: code.jbe(pass); break;
+        case IR::Cond::VS: code.jp(pass); break;
+        case IR::Cond::VC: code.jnp(pass); break;
+        default: code.jmp(pass); break;
+        }
+        return pass;
+    }
+
     if (host_cond_flags != HostCondFlags::None) {
         // the host's flags as CondFlags* left them (nothing in between changes them)
         const HostCondFlags kind = host_cond_flags;
