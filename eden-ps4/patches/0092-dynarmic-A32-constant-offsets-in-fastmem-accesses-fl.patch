+void A32EmitX64::FoldAddressOffsets(A32EmitContext& ctx, IR::Block& block) {
+    // A plain load or store (fastmem, not ordered) through Add32(base, 1..65535) used by it alone:
+    // the access takes the base and the constant goes into its displacement; the Add32 goes. (The
+    // address can pass 4 GiB in the arena, where it faults and the fallback rebuilds it with the
+    // 32-bit wrap; a negative one could go below the arena, so those aren't folded.)
+    folded_disp.clear();
+    if (conf.skip_redundant_extensions) {
+        for (auto& inst : block.instructions) {
+            switch (inst.GetOpcode()) {
+            case IR::Opcode::ZeroExtendByteToWord:
+            case IR::Opcode::ZeroExtendHalfToWord:
+            case IR::Opcode::ZeroExtendByteToLong:
+            case IR::Opcode::ZeroExtendHalfToLong: {
+                // a byte or halfword just loaded is zero-extended in its register already (every
+                // way a load gets it: movzx, the fallbacks' ZeroExtendFrom)
+                const IR::Value arg = inst.GetArg(0);
+                if (arg.IsImmediate())
+                    break;
+                const auto op = arg.GetInst()->GetOpcode();
+                if (op == IR::Opcode::A32ReadMemory8 || op == IR::Opcode::A32ReadMemory16)
+                    inst.ReplaceUsesWith(arg);
+                break;
+            }
+            case IR::Opcode::A32WriteMemory8:
+            case IR::Opcode::A32WriteMemory16: {
+                // a byte or halfword stored from a word's: the store takes the word's register
+                // (it writes its low 8 or 16 bits) without a movzx into another first
+                const IR::Value value = inst.GetArg(2);
+                if (value.IsImmediate())
+                    break;
+                IR::Inst* const narrow = value.GetInst();
+                const auto want = inst.GetOpcode() == IR::Opcode::A32WriteMemory8 ? IR::Opcode::LeastSignificantByte : IR::Opcode::LeastSignificantHalf;
+                if (narrow->GetOpcode() == want && narrow->UseCount() == 1 && !narrow->GetArg(0).IsImmediate()) {
+                    inst.SetArg(2, narrow->GetArg(0));
+                    narrow->Invalidate();
+                }
+                break;
+            }
+            default:
+                break;
+            }
+        }
+    }
+    if (!conf.fastmem_pointer || !conf.fold_address_offsets)
+        return;
+    for (auto& inst : block.instructions) {
+        size_t acc_arg;
+        switch (inst.GetOpcode()) {
+        case IR::Opcode::A32ReadMemory8:
+        case IR::Opcode::A32ReadMemory16:
+        case IR::Opcode::A32ReadMemory32:
+        case IR::Opcode::A32ReadMemory64:
+            acc_arg = 2;
+            break;
+        case IR::Opcode::A32WriteMemory8:
+        case IR::Opcode::A32WriteMemory16:
+        case IR::Opcode::A32WriteMemory32:
+        case IR::Opcode::A32WriteMemory64:
+            acc_arg = 3;
+            break;
+        default:
+            continue;
+        }
+        if (folded_disp.size() == folded_disp.capacity())
+            break;
+        const IR::Value address = inst.GetArg(1);
+        const IR::AccType acc = inst.GetArg(acc_arg).GetAccType();
+        if (address.IsImmediate() || acc == IR::AccType::ORDERED || acc == IR::AccType::ORDEREDRW || acc == IR::AccType::LIMITEDORDERED)
+            continue;
+        IR::Inst* const add = address.GetInst();
+        if (add->GetOpcode() != IR::Opcode::Add32 || add->UseCount() != 1)
+            continue;
+        const IR::Value carry = add->GetArg(2), offset = add->GetArg(1);
+        if (!carry.IsImmediate() || carry.GetU1() || !offset.IsImmediate())
+            continue;
+        const u32 disp = offset.GetU32();
+        if (disp == 0 || disp > 0xFFFF || !ShouldFastmem(ctx, &inst))
+            continue;
+        inst.SetArg(1, add->GetArg(0));
+        add->Invalidate();
+        folded_disp.emplace_back(&inst, disp);
+    }
+}
