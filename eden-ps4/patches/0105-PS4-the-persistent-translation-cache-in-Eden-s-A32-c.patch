         ++cache_use.used;
+        ::Common::PS4Perf::jit_cache_used[conf.processor_id & 3].fetch_add(1, std::memory_order_relaxed);
         const CodePtr entrypoint = block_of_code.CacheBase() + it->entry;
         for (const auto& [start, end] : ranges)
             emitter.block_ranges.AddRange(boost::icl::discrete_interval<u32>::closed(start, end - 1), descriptor);
@@ -784,9 +787,13 @@ private:
         auto block = emitter.Emit(ir_block);
         ::Common::PS4Perf::jit_cache_free_kib[conf.processor_id & 3].store(
             u32(block_of_code.SpaceRemaining() >> 10), std::memory_order_relaxed);
-        ::Common::PS4Perf::jit_compile_ns.fetch_add(
-            u64(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - compile_start).count()),
-            std::memory_order_relaxed);
+        {
+            const u64 ns = u64(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - compile_start).count());
+            ::Common::PS4Perf::jit_compile_ns.fetch_add(ns, std::memory_order_relaxed);
+            // (04.17) per core
+            ::Common::PS4Perf::jit_core_compile_ns[conf.processor_id & 3].fetch_add(ns, std::memory_order_relaxed);
+            ::Common::PS4Perf::jit_core_blocks[conf.processor_id & 3].fetch_add(1, std::memory_order_relaxed);
+        }
         return block;
     }
 
