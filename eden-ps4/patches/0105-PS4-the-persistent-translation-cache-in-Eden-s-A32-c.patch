+#include <cstdio>
 #include <cstring>
+#include <string>
+#include <vector>
 #include "common/ps4_perf.h"
 #include "common/settings.h"
 #include "core/arm/dynarmic/arm_dynarmic.h"
@@ -169,6 +172,9 @@ void ArmDynarmic32::MakeJit(Common::PageTable* page_table) {
     config.callbacks = std::addressof(*m_cb);
     config.coprocessors[15] = m_cp15;
     config.define_unpredictable_behaviour = true;
+    // (PS4 04.17) What translated code points into, for a saved translation cache: this object
+    // (the callbacks are in it), the CP15 (its registers, and this as its CNTPCT callback's argument)
+    config.code_cache_objects = {{this, sizeof(ArmDynarmic32)}, {m_cp15.get(), sizeof(DynarmicCP15)}};
 
     if (page_table) {
         constexpr size_t PageBits = 12;
@@ -426,6 +432,45 @@ ArmDynarmic32::ArmDynarmic32(System& system, bool uses_wall_clock, Kernel::KProc
 
 ArmDynarmic32::~ArmDynarmic32() = default;
 
+bool ArmDynarmic32::SaveCodeCache(const std::string& path, std::string* why) {
+    const std::string temporary = path + ".tmp";
+    std::FILE* f = std::fopen(temporary.c_str(), "wb");
+    if (!f) {
+        if (why)
+            *why = "can't create the file";
+        return false;
+    }
+    std::vector<char> buffer(size_t(1) << 20);
+    std::setvbuf(f, buffer.data(), _IOFBF, buffer.size());
+    const bool saved = m_jit->SaveCodeCache([f](const void* data, std::size_t size) {
+        return std::fwrite(data, 1, size, f) == size;
+    });
+    const bool closed = std::fclose(f) == 0;
+    if (!saved || !closed || std::rename(temporary.c_str(), path.c_str()) != 0) {
+        std::remove(temporary.c_str());
+        if (why)
+            *why = "can't write it";
+        return false;
+    }
+    return true;
+}
+
+bool ArmDynarmic32::LoadCodeCache(const std::string& path, std::string* why) {
+    std::FILE* f = std::fopen(path.c_str(), "rb");
+    if (!f) {
+        if (why)
+            *why = "none saved";
+        return false;
+    }
+    std::vector<char> buffer(size_t(1) << 20);
+    std::setvbuf(f, buffer.data(), _IOFBF, buffer.size());
+    const bool loaded = m_jit->LoadCodeCache([f](void* data, std::size_t size) {
+        return std::fread(data, 1, size, f) == size;
+    }, why);
+    std::fclose(f);
+    return loaded;
+}
+
 void ArmDynarmic32::SetTpidrroEl0(u64 value) {
     m_cp15->uro = static_cast<u32>(value);
 }
