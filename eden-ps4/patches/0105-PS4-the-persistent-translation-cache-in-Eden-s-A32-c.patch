From d79b92150cf9551733e0dc8b126f4bcf01122d3b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 3 Nov 2026 14:50:26 +0000
Subject: [PATCH 105/106] PS4: the persistent translation cache in Eden's A32
 cores; recompiler counts per core

ArmDynarmic32 declares itself (it holds the callbacks) and its CP15 as objects translated code
points into, and saves/loads its JIT's code cache to/from a file (written beside it, then renamed
over it). Per-core counts of blocks translated and the time, and of the cache's blocks loaded, used
and found stale.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01REmpC53sSK3VTcKMxWFSSb
---
 src/common/ps4_perf.h                         | 23 ++++++++++
 src/core/arm/dynarmic/arm_dynarmic_32.cpp     | 45 +++++++++++++++++++
 src/core/arm/dynarmic/arm_dynarmic_32.h       |  6 +++
 .../dynarmic/backend/x64/a32_interface.cpp    | 13 ++++--
 4 files changed, 84 insertions(+), 3 deletions(-)

diff --git a/src/common/ps4_perf.h b/src/common/ps4_perf.h
index 6c13a49b07..7e69801433 100644
--- a/src/common/ps4_perf.h
+++ b/src/common/ps4_perf.h
@@ -78,7 +78,30 @@ struct alignas(64) GpuThreadCounters {
         pipeline_reuse_mismatches{0};
     // (04.16) texture and sampler descriptors read, and those read in place (the pool one host range)
     std::atomic<uint64_t> descriptor_reads{0}, descriptor_reads_in_place{0};
+    // (04.17) uniform buffer copies sampled (1 in 16 of them hashed) and compared with the same
+    // slot's next copy: the same range with the same bytes (a copy that could have been reused),
+    // the same range changed, another range
+    std::atomic<uint64_t> ubo_checks{0}, ubo_same{0}, ubo_changed{0}, ubo_moved{0};
 };
+
+// (04.17) Shaders and pipelines (the tester's question: what the first race builds): those built
+// at boot from the game's shader cache (vulkan.bin) and those built in play. Pipelines; Eden's
+// translation of their shaders to SPIR-V (us, summed over its threads); the driver's pipeline
+// creation (us); of the creations the driver reported on (creation feedback), those it found in
+// its pipeline cache (vulkan_pipelines.bin); creations under 2 ms (a cache hit's time). Written
+// by Eden's shader threads too: atomics.
+struct PipelineWork {
+    std::atomic<uint64_t> translated{0}, translate_us{0}, created{0}, create_us{0}, reported{0}, hits{0}, quick{0};
+};
+inline PipelineWork pipelines_at_boot, pipelines_in_play;
+inline std::atomic<bool> loading_shader_cache{false};
+inline PipelineWork& PipelineWorkNow() {
+    return loading_shader_cache.load(std::memory_order_relaxed) ? pipelines_at_boot : pipelines_in_play;
+}
+// (04.17) The recompiler per emulated core (each core's own thread): blocks translated, the time;
+// and the persistent translation cache: blocks loaded, used (their guest code the same), stale
+inline std::atomic<uint64_t> jit_core_blocks[4], jit_core_compile_ns[4];
+inline std::atomic<uint64_t> jit_cache_loaded[4], jit_cache_used[4], jit_cache_stale[4];
 inline GpuThreadCounters gpu_thread;
 // (04.09) What's new to it: graphics pipelines not in the cache (the disk shader cache's are, from
 // the boot), draws skipped while their pipeline builds (asynchronous shaders), images and buffers
