diff --git a/src/common/fs/file.h b/src/common/fs/file.h
index b1ccfbd18..f8b9c11c5 100644
--- a/src/common/fs/file.h
+++ b/src/common/fs/file.h
@@ -285,6 +285,7 @@ public:
         if (!IsOpen()) {
             return 0;
         }
+        TouchForKernel(data.data(), data.size_bytes());
         return std::fread(data.data(), sizeof(T), data.size(), file);
     }
 
@@ -311,6 +312,7 @@ public:
             return 0;
         }
 
+        TouchForKernel(data.data(), data.size_bytes());
         return std::fwrite(data.data(), sizeof(T), data.size(), file);
     }
 
@@ -450,6 +452,22 @@ public:
     [[nodiscard]] s64 Tell() const;
 
 private:
+    /// The PS4's emulated DRAM gets its memory as it's first touched (common/orbis_memory.h), by a
+    /// fault handler, which the kernel's own accesses don't reach: a large read() or write()
+    /// straight from such a buffer (the C library's, past its buffer size) would fail. One read in
+    /// each MiB maps it first; elsewhere this does nothing.
+    static void TouchForKernel([[maybe_unused]] const void* data, [[maybe_unused]] size_t size) {
+#ifdef __OPENORBIS__
+        const auto* bytes = static_cast<const volatile char*>(data);
+        for (size_t offset = 0; offset < size; offset += size_t(1) << 20) {
+            (void)bytes[offset];
+        }
+        if (size != 0) {
+            (void)bytes[size - 1];
+        }
+#endif
+    }
+
     std::filesystem::path file_path;
     FileAccessMode file_access_mode{};
     FileType file_type{};
