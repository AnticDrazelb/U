 int32_t sceKernelMapNamedFlexibleMemory(void** addr, size_t len, int32_t prot, int32_t flags,
                                         const char* name);
+// Crema's runtime (port/ps4_crashlog.cpp): a line in boot-trace.log, safe in a signal handler
+__attribute__((weak)) void ps4_boot_trace(const char* stage);
 }
 
 namespace Common::Orbis {
@@ -54,6 +63,138 @@ void ReleasePieces(void* base) {
     });
 }
 
+// ReserveOnDemand's range. A chunk is free (no memory: an access faults), busy (a thread is
+// mapping it; others wait for it) or mapped. What the fault handler touches is fixed while the
+// range is registered (base nonzero), and it only uses atomics and system calls.
+enum : u8 { ChunkFree, ChunkBusy, ChunkMapped };
+struct OnDemandRange {
+    std::atomic<uintptr_t> base{0};
+    size_t size = 0;
+    size_t direct_size = 0;
+    std::atomic<u8>* state = nullptr;
+    off_t* phys = nullptr;
+    std::atomic<size_t> bytes{0};
+    std::atomic<size_t> peak{0};
+};
+OnDemandRange on_demand;
+struct sigaction previous_segv, previous_bus;
+
+void Trace(const char* line) {
+    if (ps4_boot_trace)
+        ps4_boot_trace(line);
+}
+
+// Maps a chunk of direct memory at chunk `index`, zeroed. Direct memory run out (the GPU's caches
+// hold it: they give it back as the RAM grows, see Vulkan::Device::GetDeviceMemoryUsage) is
+// waited for, up to about 4 s.
+bool CommitChunk(size_t index) noexcept {
+    std::atomic<u8>& state = on_demand.state[index];
+    for (;;) {
+        u8 expected = ChunkFree;
+        if (state.compare_exchange_weak(expected, ChunkBusy, std::memory_order_acquire))
+            break;
+        if (expected == ChunkMapped)
+            return true;
+        sched_yield(); // another thread is mapping it
+    }
+    char* const at = reinterpret_cast<char*>(on_demand.base.load(std::memory_order_relaxed)) +
+                     index * OnDemandChunk;
+    off_t phys = 0;
+    size_t alignment = OnDemandChunk; // (large pages), else any
+    bool allocated = false;
+    for (int attempt = 0; attempt < 2000 && !allocated; attempt++) {
+        for (const size_t align : {OnDemandChunk, size_t(64_KiB)}) {
+            if (sceKernelAllocateDirectMemory(0, on_demand.direct_size, OnDemandChunk, align,
+                                              MemoryTypeWriteBack, &phys) == 0) {
+                alignment = align;
+                allocated = true;
+                break;
+            }
+        }
+        if (!allocated) {
+            if (attempt == 0)
+                Trace("eden: the emulated RAM is out of direct memory: waiting for the GPU's to come back");
+            const timespec pause{0, 2000000};
+            nanosleep(&pause, nullptr);
+        }
+    }
+    if (!allocated) {
+        state.store(ChunkFree, std::memory_order_release);
+        return false;
+    }
+    // Zeroed before it appears in the range (reused direct memory isn't): once mapped there,
+    // other threads touching the chunk don't fault, and would see it - or write to it - while it
+    // was cleared. So it's cleared where the kernel puts it first, then moved (one mapping at a
+    // time: an app can't map memory twice).
+    void* scratch = nullptr;
+    bool zeroed = false;
+    if (sceKernelMapDirectMemory(&scratch, OnDemandChunk, ProtCpuReadWrite, 0, phys, alignment) == 0) {
+        std::memset(scratch, 0, OnDemandChunk);
+        sceKernelMunmap(scratch, OnDemandChunk);
+        zeroed = true;
+    }
+    void* mapped = at;
+    if (sceKernelMapDirectMemory(&mapped, OnDemandChunk, ProtCpuReadWrite, MapFixed, phys,
+                                 alignment) != 0 ||
+        mapped != at) {
+        sceKernelReleaseDirectMemory(phys, OnDemandChunk);
+        state.store(ChunkFree, std::memory_order_release);
+        return false;
+    }
+    if (!zeroed)
+        std::memset(at, 0, OnDemandChunk); // (no room elsewhere: here, as the next best thing)
+    on_demand.phys[index] = phys;
+    const size_t bytes = on_demand.bytes.fetch_add(OnDemandChunk) + OnDemandChunk;
+    size_t peak = on_demand.peak.load();
+    while (bytes > peak && !on_demand.peak.compare_exchange_weak(peak, bytes)) {
+    }
+    state.store(ChunkMapped, std::memory_order_release);
+    return true;
+}
+
+uintptr_t FaultAddress(siginfo_t* info) {
+#ifdef __linux__
+    return reinterpret_cast<uintptr_t>(info->si_addr); // (the desktop test)
+#else
+    // FreeBSD's offset (the musl headers have Linux's siginfo layout)
+    return *reinterpret_cast<const uintptr_t*>(reinterpret_cast<char*>(info) + 24);
+#endif
+}
+
+void ChainSignal(const struct sigaction& previous, int sig, siginfo_t* info, void* context) {
+    if ((previous.sa_flags & SA_SIGINFO) && previous.sa_sigaction) {
+        previous.sa_sigaction(sig, info, context);
+    } else if (previous.sa_handler != SIG_DFL && previous.sa_handler != SIG_IGN) {
+        previous.sa_handler(sig);
+    } else {
+        signal(sig, SIG_DFL); // the default action: on return the access faults again
+    }
+}
+
+void OnDemandFaultHandler(int sig, siginfo_t* info, void* context) {
+    const uintptr_t address = FaultAddress(info);
+    const uintptr_t base = on_demand.base.load(std::memory_order_acquire);
+    if (base && address >= base && address - base < on_demand.size) {
+        const int saved_errno = errno; // (the code it interrupted may be about to read it)
+        const bool committed = CommitChunk((address - base) / OnDemandChunk);
+        errno = saved_errno;
+        if (committed)
+            return; // the access runs again, now with memory there
+        Trace("eden: the emulated RAM couldn't get direct memory (all of it is in use)");
+    }
+    ChainSignal(sig == SIGBUS ? previous_bus : previous_segv, sig, info, context);
+}
+
+void InstallOnDemandFaultHandler() {
+    struct sigaction action;
+    std::memset(&action, 0, sizeof(action));
+    action.sa_sigaction = OnDemandFaultHandler;
+    action.sa_flags = SA_SIGINFO | SA_ONSTACK;
+    sigemptyset(&action.sa_mask);
+    sigaction(SIGSEGV, &action, &previous_segv);
+    sigaction(SIGBUS, &action, &previous_bus);
+}
+
 } // namespace
 
 void* ReserveRange(size_t size, size_t alignment) {
@@ -115,6 +256,58 @@ bool MapFlexibleMemory(void* address, size_t size) {
            at == address;
 }
 
+bool ReserveOnDemand(void* base, size_t size) {
+    if (on_demand.base.load() != 0 || size % OnDemandChunk != 0)
+        return false;
+    const size_t chunks = size / OnDemandChunk;
+    on_demand.state = new std::atomic<u8>[chunks]{};
+    on_demand.phys = new off_t[chunks]{};
+    on_demand.size = size;
+    on_demand.direct_size = sceKernelGetDirectMemorySize();
+    on_demand.bytes = 0;
+    on_demand.peak = 0;
+    static std::once_flag handler_once;
+    std::call_once(handler_once, InstallOnDemandFaultHandler);
+    on_demand.base.store(reinterpret_cast<uintptr_t>(base), std::memory_order_release);
+    return true;
+}
+
+void ReleaseOnDemand(void* base, size_t size) {
+    on_demand.base.store(0, std::memory_order_release); // (faults there aren't ours any more)
+    sceKernelMunmap(base, size);
+    for (size_t i = 0; i < on_demand.size / OnDemandChunk; i++) {
+        if (on_demand.state[i].load() == ChunkMapped)
+            sceKernelReleaseDirectMemory(on_demand.phys[i], OnDemandChunk);
+    }
+    delete[] on_demand.state;
+    delete[] on_demand.phys;
+    on_demand.state = nullptr;
+    on_demand.phys = nullptr;
+    on_demand.size = 0;
+    on_demand.bytes = 0;
+}
+
+void ClearOnDemand(size_t offset, size_t length, unsigned char fill) {
+    char* const base = reinterpret_cast<char*>(on_demand.base.load(std::memory_order_acquire));
+    for (size_t at = offset; at < offset + length;) {
+        const size_t index = at / OnDemandChunk;
+        const size_t end = std::min(offset + length, (index + 1) * OnDemandChunk);
+        // A chunk not mapped yet reads as zeros already. (One a fault is mapping right now is
+        // zeroed whole before anyone writes to it: this range of it stays zeros.)
+        if (fill != 0 || on_demand.state[index].load(std::memory_order_acquire) != ChunkFree)
+            std::memset(base + at, fill, end - at);
+        at = end;
+    }
+}
+
+size_t OnDemandBytes() {
+    return on_demand.bytes.load(std::memory_order_relaxed);
+}
+
+size_t OnDemandPeakBytes() {
+    return on_demand.peak.load(std::memory_order_relaxed);
+}
+
 } // namespace Common::Orbis
 
 #endif
diff --git a/src/common/orbis_memory.h b/src/common/orbis_memory.h
index 64c14f964..6d39483b9 100644
--- a/src/common/orbis_memory.h
+++ b/src/common/orbis_memory.h
@@ -32,6 +32,21 @@ void UnmapDirectMemory(void* base, std::size_t size);
 /// call from a signal handler.
 bool MapFlexibleMemory(void* address, std::size_t size);
 
+/// The emulated DRAM on demand: a range from ReserveRange whose direct memory is taken a chunk
+/// (OnDemandChunk) at a time, the first time the chunk is touched (a fault handler maps it, filled
+/// with zeros). A game that touches 1.5 of the 4 GiB leaves the rest to the GPU. One such range at
+/// a time.
+constexpr std::size_t OnDemandChunk = std::size_t(2) << 20;
+bool ReserveOnDemand(void* base, std::size_t size);
+/// Unmaps the range and gives back every chunk taken.
+void ReleaseOnDemand(void* base, std::size_t size);
+/// Fills [offset, offset + length) of the range with `fill`, leaving chunks never touched alone
+/// when it's zeros (they read as zeros already): a game's new heap takes no memory until it's used.
+void ClearOnDemand(std::size_t offset, std::size_t length, unsigned char fill);
+/// Bytes of direct memory the range holds now, and the most it has held
+std::size_t OnDemandBytes();
+std::size_t OnDemandPeakBytes();
+
 } // namespace Common::Orbis
 
 #endif
