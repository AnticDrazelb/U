diff --git a/src/video_core/vulkan_common/vulkan_device.cpp b/src/video_core/vulkan_common/vulkan_device.cpp
index 9a51389fe..49caef391 100644
--- a/src/video_core/vulkan_common/vulkan_device.cpp
+++ b/src/video_core/vulkan_common/vulkan_device.cpp
@@ -31,7 +31,10 @@
 #include "video_core/vulkan_common/vulkan_wrapper.h"
 #include "video_core/gpu_logging/gpu_logging.h"
 #ifdef __OPENORBIS__
+#include "common/orbis_memory.h"
 #include "common/ps4_diagnostics.h"
+// Mesa's PS4 winsys (port/mesa/ac_ps4_drm.c): direct memory the GPU's buffers hold
+extern "C" u64 ac_ps4_gpu_bytes();
 #endif
 
 #if defined(__ANDROID__) && defined(ARCHITECTURE_arm64)
@@ -1612,10 +1615,18 @@ void Device::ReleaseCustomBorderColorSamplers(size_t count) const {
 
 u64 Device::GetDeviceMemoryUsage() const {
 #ifdef __OPENORBIS__
-    // Every GPU allocation (and some CPU ones) comes out of the same ~0.5 GiB of direct memory;
-    // RADV's heaps claim 1 + 2 GiB. Usage = what has gone since the device was created.
+    // Every GPU allocation comes out of direct memory (RADV's heaps claim 1 + 2 GiB), and so does
+    // the emulated DRAM as the game touches it (Common::Orbis::ReserveOnDemand). The caches compare
+    // this with fractions of device_access_memory, the free direct memory when the device was made:
+    // what the GPU's buffers hold, scaled by how much smaller its share is now - what is free, plus
+    // what it holds, less a reserve for the DRAM to grow into. So their garbage collection tightens
+    // as the game's memory grows, and gives direct memory back for it.
+    constexpr u64 DramReserve = 384_MiB;
+    const u64 gpu = ac_ps4_gpu_bytes();
     const u64 free = Common::PS4Diagnostics::LargestFreeDirect();
-    return free < device_access_memory ? device_access_memory - free : 0;
+    const u64 share = std::max<u64>(free + gpu > DramReserve ? free + gpu - DramReserve : 0, 64_MiB);
+    return static_cast<u64>(static_cast<double>(gpu) * static_cast<double>(device_access_memory) /
+                            static_cast<double>(share));
 #endif
     VkPhysicalDeviceMemoryBudgetPropertiesEXT budget;
     budget.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT;
@@ -1674,7 +1685,8 @@ void Device::CollectPhysicalMemoryInfo() {
     // The caches size their garbage collection from this; the real limit is the free direct memory
     // left after the 4 GiB of guest RAM (00.16: Clubhouse Games ran it out with 3 GiB "reported").
     device_access_memory = Common::PS4Diagnostics::LargestFreeDirect();
-    LOG_INFO(Render_Vulkan, "PS4 GPU memory budget: {} MiB of free direct memory", device_access_memory >> 20);
+    LOG_INFO(Render_Vulkan, "PS4 GPU memory budget: {} MiB of free direct memory (the emulated DRAM holds {} MiB)",
+             device_access_memory >> 20, Common::Orbis::OnDemandBytes() >> 20);
 #endif
 }
 
