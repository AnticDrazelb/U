 void A32EmitX64::EmitA32SetCpsrNZCVRaw(A32EmitContext& ctx, IR::Inst* inst) {
     auto args = ctx.reg_alloc.GetArgumentInfo(inst);
     if (args[0].IsImmediate()) {
@@ -1262,6 +1270,24 @@ bool EmitTerminalImpl(A32EmitX64& e, IR::Term::PopRSBHint, IR::LocationDescripto
 bool EmitTerminalImpl(A32EmitX64& e, IR::Term::FastDispatchHint, IR::LocationDescriptor, bool is_single_step) {
     if (!e.conf.HasOptimization(OptimizationFlag::FastDispatch) || is_single_step) {
         e.code.ReturnFromRunCode();
+    } else if (e.conf.inline_fast_dispatch) {
+        // terminal_handler_fast_dispatch_hint, here (its miss path shared): this site's own jump
+        auto& code = e.code;
+        code.mov(ebx, dword[code.ABI_JIT_PTR + offsetof(A32JitState, upper_location_descriptor)]);
+        code.shl(rbx, 32);
+        code.mov(ecx, MJitStateReg(A32::Reg::PC));
+        code.mov(edi, ecx);
+        code.or_(rbx, rcx);
+        code.mov(r8, reinterpret_cast<u64>(e.fast_dispatch_table.data()));
+        code.mov(r12, rbx);
+        if (code.HasHostFeature(HostFeature::SSE42)) {
+            code.crc32(r12, r8);
+        }
+        code.and_(r12d, e.fast_dispatch_table_mask);
+        code.lea(r12, ptr[r8 + r12]);
+        code.cmp(rbx, qword[r12 + offsetof(A32EmitX64::FastDispatchEntry, location_descriptor)]);
+        code.jne(e.fast_dispatch_miss);
+        code.jmp(ptr[r12 + offsetof(A32EmitX64::FastDispatchEntry, code_ptr)]);
     } else {
         e.code.jmp(e.terminal_handler_fast_dispatch_hint);
     }
