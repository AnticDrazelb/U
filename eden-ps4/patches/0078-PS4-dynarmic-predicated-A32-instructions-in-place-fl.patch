+namespace {
+
+// What a conditional instruction translated in place may do: compute, read anything but memory,
+// write core registers other than PC, the VFP registers (D and S) and all four flags (CMP, CMN,
+// ADDS, SUBS...; one that sets only some of them, as TST or MOVS do, ends the block). Floating
+// point and vector operations are left out (one not executed must not touch the FPSCR's
+// cumulative flags).
+bool InlineConditionalAllowed(const IR::Inst& inst) {
+    const IR::Opcode op = inst.GetOpcode();
+    switch (op) {
+    case IR::Opcode::A32SetRegister:
+        return inst.GetArg(0).GetA32RegRef() != A32::Reg::PC;
+    case IR::Opcode::A32SetExtendedRegister32:
+    case IR::Opcode::A32SetExtendedRegister64:
+    case IR::Opcode::A32SetCpsrNZCV:
+        return true;
+    case IR::Opcode::A32GetVector:
+        return false;
+    default:
+        break;
+    }
+    if (IR::MayHaveSideEffects(op) || IR::IsMemoryRead(op))
+        return false;
+    const std::string_view name = IR::GetNameOf(op);
+    return !name.starts_with("FP") && !name.starts_with("Vector");
+}
+
+}  // namespace
+
+bool FinishInlineConditional(TranslatorVisitor& v, bool should_continue) {
+    const IR::Cond cond = *v.inline_cond;
+    v.inline_cond.reset();
+    IR::Block& block = v.ir.block;
+    const IR::Block::iterator first = std::next(v.inline_before);
+
+    bool allowed = should_continue && !block.HasTerminal() && v.cond_state == ConditionalState::None;
+    for (auto it = first; allowed && it != block.instructions.end(); ++it)
+        allowed = InlineConditionalAllowed(*it);
+
+    if (!allowed) {
+        // Its IR undone (latest first: each drops its uses of the earlier ones), and the block
+        // ended before it, as without inline_conditionals
+        while (std::next(v.inline_before) != block.instructions.end()) {
+            auto last = std::prev(block.instructions.end());
+            last->Invalidate();
+            block.instructions.erase(last);
+        }
+        v.cond_state = ConditionalState::Break;
+        if (block.HasTerminal())
+            block.ReplaceTerminal(IR::Term::LinkBlockFast{v.ir.current_location});
+        else
+            v.ir.SetTerm(IR::Term::LinkBlockFast{v.ir.current_location});
+        return false;
+    }
+
+    // Each write: the new value if the condition passes, else the register's value from before
+    // the instruction (read ahead of it)
+    std::vector<IR::Block::iterator> writes;
+    for (auto it = first; it != block.instructions.end(); ++it) {
+        const IR::Opcode op = it->GetOpcode();
+        if (op == IR::Opcode::A32SetRegister || op == IR::Opcode::A32SetExtendedRegister32 || op == IR::Opcode::A32SetExtendedRegister64
+            || op == IR::Opcode::A32SetCpsrNZCV)
+            writes.push_back(it);
+    }
+    for (const auto& write : writes) {
+        v.ir.SetInsertionPointBefore(first);
+        if (write->GetOpcode() == IR::Opcode::A32SetCpsrNZCV) {
+            // the flags as they were (the select reads them before this instruction's write)
+            const IR::NZCV old = v.ir.GetCpsrNZCV();
+            v.ir.SetInsertionPointBefore(write);
+            write->SetArg(0, v.ir.ConditionalSelect(cond, IR::NZCV{write->GetArg(0)}, old));
+            continue;
+        }
+        const IR::Value value = write->GetArg(1);
+        if (write->GetOpcode() == IR::Opcode::A32SetRegister) {
+            const IR::U32 old = v.ir.GetRegister(write->GetArg(0).GetA32RegRef());
+            v.ir.SetInsertionPointBefore(write);
+            write->SetArg(1, v.ir.ConditionalSelect(cond, IR::U32{value}, old));
+        } else {
+            const A32::ExtReg reg = write->GetArg(0).GetA32ExtRegRef();
+            const IR::U32U64 old = v.ir.GetExtendedRegister(reg);
+            v.ir.SetInsertionPointBefore(write);
+            if (write->GetOpcode() == IR::Opcode::A32SetExtendedRegister32)
+                write->SetArg(1, v.ir.ConditionalSelect(cond, IR::U32{value}, IR::U32{old}));
+            else
+                write->SetArg(1, v.ir.ConditionalSelect(cond, IR::U64{value}, IR::U64{old}));
+        }
+    }
+    v.ir.SetInsertionPointBefore(block.instructions.end());
+    return true;
+}
+
 }  // namespace Dynarmic::A32
