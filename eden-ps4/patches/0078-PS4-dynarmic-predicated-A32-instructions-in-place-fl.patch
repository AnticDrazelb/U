+// VMRS APSR_nzcv after a VCMP in the same block (a float compare and branch): the compare's
+// flags go to the CPSR as they are (both hold the host's format), instead of through the FPSCR's
+// ARM format and back (a store, a load and two conversions)
+static void A32FpscrNZCVForwarding(IR::Block& block) {
+    IR::Value last;
+    for (auto it = block.instructions.begin(); it != block.instructions.end(); ++it) {
+        switch (it->GetOpcode()) {
+        case IR::Opcode::A32SetFpscrNZCV:
+            last = it->GetArg(0);
+            break;
+        case IR::Opcode::A32SetFpscr:
+            last = {};
+            break;
+        case IR::Opcode::A32SetCpsrNZCVRaw: {
+            const IR::Value arg = it->GetArg(0);
+            if (!last.IsEmpty() && !arg.IsImmediate() && arg.GetInstRecursive()->GetOpcode() == IR::Opcode::A32GetFpscrNZCV) {
+                block.PrependNewInst(it, IR::Opcode::A32SetCpsrNZCV, {last});
+                it->Invalidate();
+            }
+            break;
+        }
+        default:
+            break;
+        }
+    }
+}
