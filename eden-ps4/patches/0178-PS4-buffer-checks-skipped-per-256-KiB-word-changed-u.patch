+    /// (PS4 04.87) The ranges each cache's side of InnerInvalidation last ran on, at its epoch (the
+    /// texture cache's write epoch, the query cache's and the shader cache's insert epochs): a
+    /// queued write within one of them, the epoch unchanged, would do nothing there
+    struct InvalidationMemo {
+        static constexpr size_t SIZE = 4;
+        struct Range {
+            DAddr begin = 0, end = 0;
+            u64 epoch = ~u64{0};
+        };
+        std::array<Range, SIZE> ranges{};
+        size_t next = 0;
+        [[nodiscard]] bool Covers(DAddr addr, size_t size, u64 epoch) const noexcept {
+            for (const Range& r : ranges) {
+                if (r.epoch == epoch && addr >= r.begin && addr + size <= r.end) {
+                    return true;
+                }
+            }
+            return false;
+        }
+        /// After the side ran over the range: the epoch read before it ran
+        void Note(DAddr addr, size_t size, u64 epoch) noexcept {
+            for (Range& r : ranges) {
+                if (r.epoch == epoch && r.end != 0 && addr <= r.end && addr + size >= r.begin) {
+                    r.begin = (std::min)(r.begin, addr);
+                    r.end = (std::max)(r.end, DAddr(addr + size));
+                    return;
+                }
+            }
+            ranges[next] = Range{addr, DAddr(addr + size), epoch};
+            next = (next + 1) % SIZE;
+        }
+    };
