@@ -402,6 +430,7 @@ bool RasterizerNull::AccelerateSurfaceCopy(const Tegra::Engines::Fermi2D::Surfac
 // Inline uploads (the upload engine's linear ones come here) written to emulated memory
 void RasterizerNull::AccelerateInlineToMemory(GPUVAddr address, size_t copy_size,
