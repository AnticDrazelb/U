diff --git a/src/core/hle/service/nvdrv/devices/nvhost_ctrl.cpp b/src/core/hle/service/nvdrv/devices/nvhost_ctrl.cpp
index 6ef32b890..a7036c6fa 100644
--- a/src/core/hle/service/nvdrv/devices/nvhost_ctrl.cpp
+++ b/src/core/hle/service/nvdrv/devices/nvhost_ctrl.cpp
@@ -176,6 +176,9 @@ NvResult nvhost_ctrl::IocCtrlEventWait(IocCtrlEventWaitParams& params, bool is_a
         return NvResult::BadParameter;
     }
 
+    // (PS4 04.83) the last wait's host action may still be finishing (below)
+    WaitOutSignalling(event);
+
     if (event.IsBeingUsed()) {
         return NvResult::BadParameter;
     }
@@ -221,6 +224,8 @@ NvResult nvhost_ctrl::FreeEvent(u32 slot) {
         return NvResult::Success;
     }
 
+    WaitOutSignalling(event);
+
     if (event.IsBeingUsed()) {
         return NvResult::Busy;
     }
diff --git a/src/core/hle/service/nvdrv/devices/nvhost_ctrl.h b/src/core/hle/service/nvdrv/devices/nvhost_ctrl.h
index 403f1a746..9adb0e741 100644
--- a/src/core/hle/service/nvdrv/devices/nvhost_ctrl.h
+++ b/src/core/hle/service/nvdrv/devices/nvhost_ctrl.h
@@ -5,6 +5,7 @@
 #pragma once
 
 #include <array>
+#include <thread>
 #include <vector>
 #include "common/bit_field.h"
 #include "common/common_types.h"
@@ -87,6 +88,19 @@ private:
         }
     };
 
+    /// (PS4 04.83) A host action signals its event and only then marks it Signalled: the guest
+    /// thread it woke can make its next wait on the event in between (libnx takes the same event
+    /// slot each time), and that wait was refused as BadParameter, which libnx's nvFenceWait
+    /// returns as an error without waiting - the program went on as if the GPU had got there
+    /// (gputest freed its framebuffer while the GPU still drew into it: a crash at exit, mostly on
+    /// one core, and with the GPU thread split, whose back end signals). Signalling lasts moments,
+    /// so it is waited out.
+    static void WaitOutSignalling(const InternalEvent& event) {
+        while (event.status.load(std::memory_order_acquire) == EventState::Signalling) {
+            std::this_thread::yield();
+        }
+    }
+
     std::unique_lock<std::mutex> NvEventsLock();
 
     void CreateNvEvent(u32 event_id);
