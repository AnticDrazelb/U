     m_software.FlushRegion(addr, size);
 }
 bool RasterizerNull::MustFlushRegion(DAddr addr, u64 size, VideoCommon::CacheType) {
@@ -332,6 +340,7 @@ bool RasterizerNull::MustFlushRegion(DAddr addr, u64 size, VideoCommon::CacheTyp
 // A write the memory manager reports (by device address): the software draws' textures there are
 // checked again before they're next sampled.
 void RasterizerNull::InvalidateRegion(DAddr addr, u64 size, VideoCommon::CacheType) {
+    std::scoped_lock lock{m_mutex};
     m_software.MarkDeviceWritten(addr, size);
 }
 bool RasterizerNull::OnCPUWrite(PAddr addr, u64 size) {
@@ -350,44 +359,62 @@ void RasterizerNull::InvalidateGPUCache() {}
 void RasterizerNull::UnmapMemory(DAddr addr, u64 size) {}
