     m_software.Flush(); // a semaphore: the program may read what's been drawn once it sees it
     if (!gpu_memory) {
         return;
@@ -321,9 +327,11 @@ void RasterizerNull::BindGraphicsUniformBuffer(size_t stage, u32 index, GPUVAddr
                                                u32 size) {}
 void RasterizerNull::DisableGraphicsUniformBuffer(size_t stage, u32 index) {}
 void RasterizerNull::FlushAll() {
+    std::scoped_lock lock{m_mutex};
     m_software.Flush();
