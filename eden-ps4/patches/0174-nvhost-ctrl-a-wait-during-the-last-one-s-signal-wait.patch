@@ -297,6 +301,7 @@ void RasterizerNull::Clear(u32 layer_count) {
     FillRect(*gpu_memory, m_scratch, fill, x0, y0, x1, y1, surface.layer, layers);
 }
 void RasterizerNull::DispatchCompute() {
+    std::scoped_lock lock{m_mutex};
     if (kepler_compute && gpu_memory) {
         gpu_memory->FlushCaching();
         m_software.Dispatch(*kepler_compute, *gpu_memory);
@@ -305,6 +310,7 @@ void RasterizerNull::DispatchCompute() {
 void RasterizerNull::ResetCounter(VideoCommon::QueryType type) {}
 void RasterizerNull::Query(GPUVAddr gpu_addr, VideoCommon::QueryType type,
                            VideoCommon::QueryPropertiesFlags flags, u32 payload, u32 subreport) {
