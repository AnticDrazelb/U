+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <memory>
+#include <unordered_map>
+
+#include "common/common_types.h"
+#include "common/scratch_buffer.h"
+#include "video_core/gpu.h"
+
+namespace Tegra {
+class MemoryManager;
+namespace Engines {
+class Maxwell3D;
+}
+} // namespace Tegra
+
+namespace Null {
+
+/// A colour in a render target format: its bytes and size. False for formats not handled.
+bool EncodeColor(Tegra::RenderTargetFormat format, const std::array<f32, 4>& color,
+                 std::array<u8, 16>& out, u32& bytes);
+
+/// A colour read back from a render target format (for blending). False for formats not handled.
+bool DecodeColor(Tegra::RenderTargetFormat format, const u8* in, std::array<f32, 4>& color);
+
+/// Draws on the CPU what the 3D engine's registers describe, into the render target in emulated
+/// memory: the shaders translated by Eden's shader recompiler and interpreted, triangles
+/// rasterized and their fragments blended into render target 0. For the null renderer, which has
+/// no GPU to draw with. What it can't do (a shader it can't interpret, a format, depth testing,
+/// textures) it skips, and logs once.
+class SoftwareDraw {
+public:
+    SoftwareDraw();
+    ~SoftwareDraw();
+
+    void Draw(Tegra::Engines::Maxwell3D& maxwell3d, Tegra::MemoryManager& gpu_memory,
+              bool is_indexed, u32 instance_count);
+
+    struct Program;
+
+private:
+    Program* GetProgram(Tegra::Engines::Maxwell3D& maxwell3d, Tegra::MemoryManager& gpu_memory,
+                        u32 stage);
+
+    struct Pools;
+    std::unique_ptr<Pools> pools;
+    std::unordered_map<u64, std::unique_ptr<Program>> programs;
+    Common::ScratchBuffer<u8> scratch;
+};
+
+} // namespace Null
