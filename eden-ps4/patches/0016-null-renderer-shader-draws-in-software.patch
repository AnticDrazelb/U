+namespace IR = Shader::IR;
+using Maxwell = Tegra::Engines::Maxwell3D;
+
+// ---- colour formats
+
+namespace {
+
+float ToSrgb(float linear) {
+    return linear <= 0.0031308f ? linear * 12.92f : 1.055f * std::pow(linear, 1.0f / 2.4f) - 0.055f;
+}
+
+float FromSrgb(float srgb) {
+    return srgb <= 0.04045f ? srgb / 12.92f : std::pow((srgb + 0.055f) / 1.055f, 2.4f);
+}
+
+u32 Unorm(float value, u32 bits) {
+    const float max = float((1u << bits) - 1);
+    return u32(std::clamp(value, 0.0f, 1.0f) * max + 0.5f);
+}
+
+float FromUnorm(u32 value, u32 bits) {
+    return float(value) / float((1u << bits) - 1);
+}
+
+u16 ToHalf(float value) {
+    u32 f;
+    std::memcpy(&f, &value, sizeof(f));
+    const u32 sign = (f >> 16) & 0x8000;
+    const s32 exponent = s32((f >> 23) & 0xFF) - 127 + 15;
+    const u32 mantissa = f & 0x7FFFFF;
+    if (((f >> 23) & 0xFF) == 0xFF) {
+        return u16(sign | 0x7C00 | (mantissa ? 0x200 : 0));
+    }
+    if (exponent <= 0) {
+        return u16(sign);
+    }
+    if (exponent >= 31) {
+        return u16(sign | 0x7C00);
+    }
+    return u16(sign | (u32(exponent) << 10) | (mantissa >> 13));
+}
+
+float FromHalf(u16 h) {
+    const u32 sign = u32(h & 0x8000) << 16;
+    const u32 exponent = (h >> 10) & 0x1F;
+    const u32 mantissa = h & 0x3FF;
+    u32 f;
+    if (exponent == 0) {
+        if (mantissa == 0) {
+            f = sign;
+        } else { // subnormal
+            float value = std::ldexp(float(mantissa), -24);
+            return sign ? -value : value;
+        }
+    } else if (exponent == 31) {
+        f = sign | 0x7F800000 | (mantissa << 13);
+    } else {
+        f = sign | ((exponent + 112) << 23) | (mantissa << 13);
+    }
+    return std::bit_cast<float>(f);
+}
+
+} // Anonymous namespace
+
+bool EncodeColor(Tegra::RenderTargetFormat format, const std::array<f32, 4>& color,
+                 std::array<u8, 16>& out, u32& bytes) {
+    const auto put32 = [&](u32 value) {
+        std::memcpy(out.data(), &value, 4);
+        bytes = 4;
+    };
+    const auto put16 = [&](u32 value) {
+        const u16 v = u16(value);
+        std::memcpy(out.data(), &v, 2);
+        bytes = 2;
+    };
+    const float r = color[0], g = color[1], b = color[2], a = color[3];
+    using F = Tegra::RenderTargetFormat;
+    switch (format) {
+    case F::A8B8G8R8_UNORM:
+        put32(Unorm(r, 8) | Unorm(g, 8) << 8 | Unorm(b, 8) << 16 | Unorm(a, 8) << 24);
+        return true;
+    case F::A8B8G8R8_SRGB:
+        put32(Unorm(ToSrgb(r), 8) | Unorm(ToSrgb(g), 8) << 8 | Unorm(ToSrgb(b), 8) << 16 |
+              Unorm(a, 8) << 24);
+        return true;
+    case F::X8B8G8R8_UNORM:
+        put32(Unorm(r, 8) | Unorm(g, 8) << 8 | Unorm(b, 8) << 16 | 0xFF000000u);
+        return true;
+    case F::X8B8G8R8_SRGB:
+        put32(Unorm(ToSrgb(r), 8) | Unorm(ToSrgb(g), 8) << 8 | Unorm(ToSrgb(b), 8) << 16 |
+              0xFF000000u);
+        return true;
+    case F::A8R8G8B8_UNORM:
+        put32(Unorm(b, 8) | Unorm(g, 8) << 8 | Unorm(r, 8) << 16 | Unorm(a, 8) << 24);
+        return true;
+    case F::A8R8G8B8_SRGB:
+        put32(Unorm(ToSrgb(b), 8) | Unorm(ToSrgb(g), 8) << 8 | Unorm(ToSrgb(r), 8) << 16 |
+              Unorm(a, 8) << 24);
+        return true;
+    case F::X8R8G8B8_UNORM:
+        put32(Unorm(b, 8) | Unorm(g, 8) << 8 | Unorm(r, 8) << 16 | 0xFF000000u);
+        return true;
+    case F::X8R8G8B8_SRGB:
+        put32(Unorm(ToSrgb(b), 8) | Unorm(ToSrgb(g), 8) << 8 | Unorm(ToSrgb(r), 8) << 16 |
+              0xFF000000u);
+        return true;
+    case F::A2B10G10R10_UNORM:
+        put32(Unorm(r, 10) | Unorm(g, 10) << 10 | Unorm(b, 10) << 20 | Unorm(a, 2) << 30);
+        return true;
+    case F::A2R10G10B10_UNORM:
+        put32(Unorm(b, 10) | Unorm(g, 10) << 10 | Unorm(r, 10) << 20 | Unorm(a, 2) << 30);
+        return true;
+    case F::R5G6B5_UNORM:
+        put16(Unorm(b, 5) | Unorm(g, 6) << 5 | Unorm(r, 5) << 11);
+        return true;
+    case F::A1R5G5B5_UNORM:
+        put16(Unorm(b, 5) | Unorm(g, 5) << 5 | Unorm(r, 5) << 10 | Unorm(a, 1) << 15);
+        return true;
+    case F::X1R5G5B5_UNORM:
+        put16(Unorm(b, 5) | Unorm(g, 5) << 5 | Unorm(r, 5) << 10 | 0x8000);
+        return true;
+    case F::R8G8_UNORM:
+        put16(Unorm(r, 8) | Unorm(g, 8) << 8);
+        return true;
+    case F::R8_UNORM:
+        out[0] = u8(Unorm(r, 8));
+        bytes = 1;
+        return true;
+    case F::R16G16B16A16_FLOAT:
+    case F::R16G16B16X16_FLOAT: {
+        const u16 h[4] = {ToHalf(r), ToHalf(g), ToHalf(b),
+                          ToHalf(format == F::R16G16B16X16_FLOAT ? 1.0f : a)};
+        std::memcpy(out.data(), h, 8);
+        bytes = 8;
+        return true;
+    }
+    case F::R32G32B32A32_FLOAT:
+    case F::R32G32B32X32_FLOAT:
+        std::memcpy(out.data(), color.data(), 16);
+        bytes = 16;
+        return true;
+    case F::R32_FLOAT:
+        std::memcpy(out.data(), &r, 4);
+        bytes = 4;
+        return true;
+    default:
+        return false;
+    }
+}
+
+bool DecodeColor(Tegra::RenderTargetFormat format, const u8* in, std::array<f32, 4>& color) {
+    u32 v32;
+    u16 v16;
+    std::memcpy(&v32, in, 4);
+    std::memcpy(&v16, in, 2);
+    const auto byte = [&](u32 shift) { return FromUnorm((v32 >> shift) & 0xFF, 8); };
+    using F = Tegra::RenderTargetFormat;
+    switch (format) {
+    case F::A8B8G8R8_UNORM:
+    case F::X8B8G8R8_UNORM:
+        color = {byte(0), byte(8), byte(16), format == F::X8B8G8R8_UNORM ? 1.0f : byte(24)};
+        return true;
+    case F::A8B8G8R8_SRGB:
+    case F::X8B8G8R8_SRGB:
+        color = {FromSrgb(byte(0)), FromSrgb(byte(8)), FromSrgb(byte(16)),
+                 format == F::X8B8G8R8_SRGB ? 1.0f : byte(24)};
+        return true;
+    case F::A8R8G8B8_UNORM:
+    case F::X8R8G8B8_UNORM:
+        color = {byte(16), byte(8), byte(0), format == F::X8R8G8B8_UNORM ? 1.0f : byte(24)};
+        return true;
+    case F::A8R8G8B8_SRGB:
+    case F::X8R8G8B8_SRGB:
+        color = {FromSrgb(byte(16)), FromSrgb(byte(8)), FromSrgb(byte(0)),
+                 format == F::X8R8G8B8_SRGB ? 1.0f : byte(24)};
+        return true;
+    case F::A2B10G10R10_UNORM:
+        color = {FromUnorm(v32 & 0x3FF, 10), FromUnorm((v32 >> 10) & 0x3FF, 10),
+                 FromUnorm((v32 >> 20) & 0x3FF, 10), FromUnorm(v32 >> 30, 2)};
+        return true;
+    case F::A2R10G10B10_UNORM:
+        color = {FromUnorm((v32 >> 20) & 0x3FF, 10), FromUnorm((v32 >> 10) & 0x3FF, 10),
+                 FromUnorm(v32 & 0x3FF, 10), FromUnorm(v32 >> 30, 2)};
+        return true;
+    case F::R5G6B5_UNORM:
+        color = {FromUnorm(v16 >> 11, 5), FromUnorm((v16 >> 5) & 0x3F, 6), FromUnorm(v16 & 0x1F, 5),
+                 1.0f};
+        return true;
+    case F::A1R5G5B5_UNORM:
+    case F::X1R5G5B5_UNORM:
+        color = {FromUnorm((v16 >> 10) & 0x1F, 5), FromUnorm((v16 >> 5) & 0x1F, 5),
+                 FromUnorm(v16 & 0x1F, 5), format == F::A1R5G5B5_UNORM ? float(v16 >> 15) : 1.0f};
+        return true;
+    case F::R8G8_UNORM:
+        color = {byte(0), byte(8), 0.0f, 1.0f};
+        return true;
+    case F::R8_UNORM:
+        color = {byte(0), 0.0f, 0.0f, 1.0f};
+        return true;
+    case F::R16G16B16A16_FLOAT:
+    case F::R16G16B16X16_FLOAT: {
+        u16 h[4];
+        std::memcpy(h, in, 8);
+        color = {FromHalf(h[0]), FromHalf(h[1]), FromHalf(h[2]),
+                 format == F::R16G16B16X16_FLOAT ? 1.0f : FromHalf(h[3])};
+        return true;
+    }
+    case F::R32G32B32A32_FLOAT:
+    case F::R32G32B32X32_FLOAT:
+        std::memcpy(color.data(), in, 16);
+        if (format == F::R32G32B32X32_FLOAT) {
+            color[3] = 1.0f;
+        }
+        return true;
+    case F::R32_FLOAT:
+        std::memcpy(color.data(), in, 4);
+        color[1] = color[2] = 0.0f;
+        color[3] = 1.0f;
+        return true;
+    default:
+        return false;
+    }
+}
+
+// ---- shaders: Eden's IR, flattened into a list of operations on numbered cells, interpreted
+
+namespace {
+
+struct Cell {
+    u32 w[4];
+};
+
+enum class Kind : u8 { Ir, Move, Jump, JumpIfTrue, JumpIfFalse, Return };
+
+struct Op {
+    Kind kind;
+    IR::Opcode op;
+    u16 dest;
+    std::array<u16, 4> a;
+    u32 extra; // a jump target, an attribute, an output slot
+};
+
+void LogOnce(const std::string& message) {
+    static std::set<std::string> logged;
+    if (logged.insert(message).second) {
+        LOG_WARNING(Render, "Software draw: {}", message);
+    }
+}
+
+bool IsSupported(IR::Opcode op) {
+    using O = IR::Opcode;
+    switch (op) {
+    case O::Phi: case O::Identity: case O::Void: case O::ConditionRef: case O::Reference:
+    case O::PhiMove: case O::Prologue: case O::Epilogue: case O::Join: case O::Barrier:
+    case O::WorkgroupMemoryBarrier: case O::DeviceMemoryBarrier:
+    case O::DemoteToHelperInvocation:
+    case O::GetCbufU8: case O::GetCbufS8: case O::GetCbufU16: case O::GetCbufS16:
+    case O::GetCbufU32: case O::GetCbufF32: case O::GetCbufU32x2:
+    case O::GetAttribute: case O::GetAttributeU32: case O::SetAttribute:
+    case O::GetAttributeIndexed: case O::SetAttributeIndexed:
+    case O::SetFragColor: case O::SetSampleMask: case O::SetFragDepth:
+    case O::IsHelperInvocation: case O::YDirection: case O::ResolutionDownFactor:
+    case O::SR_WScaleFactorXY: case O::SR_WScaleFactorZ: case O::InvocationId: case O::SampleId:
+    case O::UndefU1: case O::UndefU8: case O::UndefU16: case O::UndefU32: case O::UndefU64:
+    case O::LoadLocal: case O::WriteLocal:
+    case O::CompositeConstructU32x2: case O::CompositeConstructU32x3:
+    case O::CompositeConstructU32x4: case O::CompositeExtractU32x2:
+    case O::CompositeExtractU32x3: case O::CompositeExtractU32x4: case O::CompositeInsertU32x2:
+    case O::CompositeInsertU32x3: case O::CompositeInsertU32x4:
+    case O::CompositeConstructF32x2: case O::CompositeConstructF32x3:
+    case O::CompositeConstructF32x4: case O::CompositeExtractF32x2:
+    case O::CompositeExtractF32x3: case O::CompositeExtractF32x4: case O::CompositeInsertF32x2:
+    case O::CompositeInsertF32x3: case O::CompositeInsertF32x4:
+    case O::SelectU1: case O::SelectU8: case O::SelectU16: case O::SelectU32: case O::SelectF32:
+    case O::SelectU64:
+    case O::BitCastU32F32: case O::BitCastF32U32: case O::BitCastU64F64: case O::BitCastF64U64:
+    case O::PackUint2x32: case O::UnpackUint2x32: case O::PackHalf2x16: case O::UnpackHalf2x16:
+    case O::PackDouble2x32: case O::UnpackDouble2x32:
+    case O::FPAbs32: case O::FPAdd32: case O::FPFma32: case O::FPMax32: case O::FPMin32:
+    case O::FPMul32: case O::FPNeg32: case O::FPRecip32: case O::FPRecipSqrt32: case O::FPSqrt:
+    case O::FPSin: case O::FPCos: case O::FPExp2: case O::FPLog2: case O::FPSaturate32:
+    case O::FPClamp32: case O::FPRoundEven32: case O::FPFloor32: case O::FPCeil32: case O::FPTrunc32:
+    case O::FPOrdEqual32: case O::FPUnordEqual32: case O::FPOrdNotEqual32: case O::FPUnordNotEqual32:
+    case O::FPOrdLessThan32: case O::FPUnordLessThan32: case O::FPOrdGreaterThan32:
+    case O::FPUnordGreaterThan32: case O::FPOrdLessThanEqual32: case O::FPUnordLessThanEqual32:
+    case O::FPOrdGreaterThanEqual32: case O::FPUnordGreaterThanEqual32: case O::FPIsNan32:
+    case O::IAdd32: case O::ISub32: case O::IMul32: case O::SDiv32: case O::UDiv32: case O::INeg32:
+    case O::IAbs32: case O::IAdd64: case O::ISub64: case O::INeg64:
+    case O::ShiftLeftLogical32: case O::ShiftRightLogical32: case O::ShiftRightArithmetic32:
+    case O::ShiftLeftLogical64: case O::ShiftRightLogical64: case O::ShiftRightArithmetic64:
+    case O::BitwiseAnd32: case O::BitwiseOr32: case O::BitwiseXor32: case O::BitFieldInsert:
+    case O::BitFieldSExtract: case O::BitFieldUExtract: case O::BitReverse32: case O::BitCount32:
+    case O::BitwiseNot32: case O::FindSMsb32: case O::FindUMsb32: case O::SMin32: case O::UMin32:
+    case O::SMax32: case O::UMax32: case O::SClamp32: case O::UClamp32: case O::SLessThan:
+    case O::ULessThan: case O::IEqual: case O::SLessThanEqual: case O::ULessThanEqual:
+    case O::SGreaterThan: case O::UGreaterThan: case O::INotEqual: case O::SGreaterThanEqual:
+    case O::UGreaterThanEqual:
+    case O::LogicalOr: case O::LogicalAnd: case O::LogicalXor: case O::LogicalNot:
+    case O::ConvertS32F32: case O::ConvertU32F32: case O::ConvertF32S32: case O::ConvertF32U32:
+    case O::ConvertU64U32: case O::ConvertU32U64: case O::ConvertF32S8: case O::ConvertF32S16:
+    case O::ConvertF32U8: case O::ConvertF32U16: case O::ConvertU16U32: case O::ConvertU32U16:
+    case O::ConvertU8U32: case O::ConvertU32U8: case O::ConvertS32S8: case O::ConvertS32S16:
+    case O::ConvertS16F32: case O::ConvertU16F32:
+    case O::DPdxFine: case O::DPdyFine: case O::DPdxCoarse: case O::DPdyCoarse:
+        return true;
+    default:
+        return false;
+    }
+}
+
+f32 F(const Cell& c, int i = 0) {
+    return std::bit_cast<f32>(c.w[i]);
+}
+void SetF(Cell& c, f32 v, int i = 0) {
+    c.w[i] = std::bit_cast<u32>(v);
+}
+s32 S(const Cell& c) {
+    return static_cast<s32>(c.w[0]);
+}
+u64 U64(const Cell& c) {
+    return u64{c.w[0]} | (u64{c.w[1]} << 32);
+}
+void SetU64(Cell& c, u64 v) {
+    c.w[0] = u32(v);
+    c.w[1] = u32(v >> 32);
+}
+
+u32 BitFieldExtract(u32 base, u32 offset, u32 count, bool sign) {
+    offset &= 31;
+    if (count == 0) {
+        return 0;
+    }
+    count = std::min(count, 32 - offset);
+    u32 value = (base >> offset) & (count == 32 ? 0xFFFFFFFFu : (1u << count) - 1);
+    if (sign && count < 32 && (value >> (count - 1)) & 1) {
+        value |= ~((1u << count) - 1);
+    }
+    return value;
+}
+
+s32 ToS32(f32 v) {
+    if (std::isnan(v)) {
+        return 0;
+    }
+    return static_cast<s32>(std::clamp(v, -2147483648.0f, 2147483520.0f));
+}
+
+u32 ToU32(f32 v) {
+    if (std::isnan(v)) {
+        return 0;
+    }
+    return static_cast<u32>(std::clamp(v, 0.0f, 4294967040.0f));
+}
