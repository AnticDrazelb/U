+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <utility>
+
+#include "common/common_types.h"
+
+namespace Vulkan {
+
+/// (PS4) The Maxwell 3D registers FixedPipelineState::Refresh reads: each one some bit of which
+/// changed the key, from some register file and set of device features. Found by flipping every
+/// bit of every register from 5,000 random register files, topologies and feature sets
+/// (eden-ps4/tools/gpu-tests/pkeyregs.cpp; 200 already find all 412). Inclusive ranges. To be
+/// found again whenever Refresh (or what it calls) changes.
+inline constexpr std::pair<u16, u16> PIPELINE_KEY_REGISTERS[] = {
+    {0x084, 0x084}, {0x0c8, 0x0c8}, {0x0df, 0x0df}, {0x1c0, 0x1c2}, {0x1c4, 0x1c6}, {0x1c8, 0x1ca},
+    {0x1cc, 0x1ce}, {0x1d1, 0x1d1}, {0x204, 0x204}, {0x214, 0x214}, {0x224, 0x224}, {0x234, 0x234},
+    {0x244, 0x244}, {0x254, 0x254}, {0x264, 0x264}, {0x274, 0x274}, {0x286, 0x286}, {0x28e, 0x28e},
+    {0x296, 0x296}, {0x29e, 0x29e}, {0x2a6, 0x2a6}, {0x2ae, 0x2ae}, {0x2b6, 0x2b6}, {0x2be, 0x2be},
+    {0x2c6, 0x2c6}, {0x2ce, 0x2ce}, {0x2d6, 0x2d6}, {0x2de, 0x2de}, {0x2e6, 0x2e6}, {0x2ee, 0x2ee},
+    {0x2f6, 0x2f6}, {0x2fe, 0x2fe}, {0x35f, 0x35f}, {0x36b, 0x36b}, {0x370, 0x374}, {0x3e4, 0x3e4},
+    {0x3e7, 0x3e8}, {0x3fa, 0x3fa}, {0x452, 0x452}, {0x458, 0x477}, {0x4b3, 0x4b3}, {0x4b9, 0x4bb},
+    {0x4c3, 0x4c5}, {0x4d0, 0x4d4}, {0x4d6, 0x4d6}, {0x4d8, 0x4e4}, {0x4eb, 0x4eb}, {0x546, 0x546},
+    {0x54e, 0x54f}, {0x55c, 0x55c}, {0x565, 0x569}, {0x574, 0x574}, {0x591, 0x591}, {0x59b, 0x59b},
+    {0x5a0, 0x5a1}, {0x620, 0x63f}, {0x646, 0x648}, {0x64f, 0x64f}, {0x66f, 0x66f}, {0x671, 0x672},
+    {0x680, 0x687}, {0x700, 0x700}, {0x703, 0x704}, {0x707, 0x708}, {0x70b, 0x70c}, {0x70f, 0x710},
+    {0x713, 0x714}, {0x717, 0x718}, {0x71b, 0x71c}, {0x71f, 0x720}, {0x723, 0x724}, {0x727, 0x728},
+    {0x72b, 0x72c}, {0x72f, 0x730}, {0x733, 0x734}, {0x737, 0x738}, {0x73b, 0x73c}, {0x73f, 0x740},
+    {0x743, 0x744}, {0x747, 0x748}, {0x74b, 0x74c}, {0x74f, 0x750}, {0x753, 0x754}, {0x757, 0x758},
+    {0x75b, 0x75c}, {0x75f, 0x760}, {0x763, 0x764}, {0x767, 0x768}, {0x76b, 0x76c}, {0x76f, 0x770},
+    {0x773, 0x774}, {0x777, 0x778}, {0x77b, 0x77c}, {0x77f, 0x77f}, {0x781, 0x786}, {0x789, 0x78e},
+    {0x791, 0x796}, {0x799, 0x79e}, {0x7a1, 0x7a6}, {0x7a9, 0x7ae}, {0x7b1, 0x7b6}, {0x7b9, 0x7be},
+    {0xa00, 0xa7f},
+};
+
+} // namespace Vulkan
