 #include "video_core/renderer_vulkan/vk_descriptor_pool.h"
@@ -569,17 +571,76 @@ PipelineCache::~PipelineCache() {
 }
 
 GraphicsPipeline* PipelineCache::CurrentGraphicsPipeline() {
-
+#ifdef __OPENORBIS__
+    namespace P = Common::PS4Perf;
+    P::Bump(P::gpu_thread.pipeline_lookups);
+#endif
     if (!RefreshStages(graphics_key.unique_hashes)) {
         current_pipeline = nullptr;
+        key_pipeline = nullptr;
         return nullptr;
     }
-    graphics_key.state.Refresh(*maxwell3d, dynamic_features);
+
+    // (PS4 04.15) FixedPipelineState::Refresh reads ~410 registers spread over the engine's state
+    // (most in different cache lines), and the key is then compared whole with the last
+    // pipeline's: ~0.5 us a draw on the PS4's CPU, at ~25,000 draws a second at a race's start.
+    // When none of what it reads changed since the last lookup (the registers by the engine's
+    // pipeline_key_changed, the rest here), the key, and so the pipeline, are the last ones.
+    auto& dirty = maxwell3d->dirty;
+    if (!dirty.pipeline_key_regs_filled) {
+        for (const auto& [first, last] : PIPELINE_KEY_REGISTERS) {
+            for (u32 reg = first; reg <= last; ++reg) {
+                dirty.pipeline_key_regs[reg] = 1;
+            }
+        }
+        dirty.pipeline_key_regs_filled = true;
+        dirty.pipeline_key_changed = true;
+    }
+    const auto topology = maxwell3d->draw_manager.draw_state.topology;
+    const bool squashed_blend = Settings::values.use_squashed_iterated_blend;
+    const bool unchanged = key_reuse_enabled && key_pipeline != nullptr && key_pipeline == current_pipeline &&
+                           !dirty.pipeline_key_changed && key_maxwell3d == maxwell3d &&
+                           !dirty.flags[Dirty::VertexInput] && !dirty.flags[Dirty::ViewportSwizzles] &&
+                           !dirty.flags[Dirty::Blending] && key_topology == topology &&
+                           key_engine_state == maxwell3d->engine_state &&
+                           key_hashes == graphics_key.unique_hashes && key_squashed_blend == squashed_blend;
+    if (unchanged) {
+        if (--key_reuses_to_check != 0) {
+#ifdef __OPENORBIS__
+            P::Bump(P::gpu_thread.pipeline_reuses);
+#endif
+            return BuiltPipeline(current_pipeline);
+        }
+        // the check: refresh it as usual, and compare
+        key_reuses_to_check = 64;
+        const FixedPipelineState last_state = graphics_key.state;
+        graphics_key.state.Refresh(*maxwell3d, dynamic_features);
+        if (graphics_key.state != last_state) {
+            key_reuse_enabled = false;
+            LOG_ERROR(Render_Vulkan, "pipeline key changed with none of its registers changed: reuse off");
+#ifdef __OPENORBIS__
+            P::Bump(P::gpu_thread.pipeline_reuse_mismatches);
+#endif
+        } else {
+#ifdef __OPENORBIS__
+            P::Bump(P::gpu_thread.pipeline_reuse_checks);
+#endif
+        }
+    } else {
+        graphics_key.state.Refresh(*maxwell3d, dynamic_features);
+    }
+    dirty.pipeline_key_changed = false;
+    key_maxwell3d = maxwell3d;
+    key_topology = topology;
+    key_engine_state = maxwell3d->engine_state;
+    key_hashes = graphics_key.unique_hashes;
+    key_squashed_blend = squashed_blend;
 
     if (current_pipeline) {
         GraphicsPipeline* const next{current_pipeline->Next(graphics_key)};
         if (next) {
             current_pipeline = next;
+            key_pipeline = next;
             return BuiltPipeline(current_pipeline);
         }
     }
@@ -780,12 +841,14 @@ GraphicsPipeline* PipelineCache::CurrentGraphicsPipelineSlowPath() {
         pipeline = CreateGraphicsPipeline();
     }
     if (!pipeline) {
+        key_pipeline = nullptr;  // (PS4 04.15) no pipeline for this key: nothing to reuse
         return nullptr;
     }
     if (current_pipeline) {
         current_pipeline->AddTransition(pipeline.get());
     }
     current_pipeline = pipeline.get();
+    key_pipeline = current_pipeline;  // (PS4 04.15)
     return BuiltPipeline(current_pipeline);
 }
 
