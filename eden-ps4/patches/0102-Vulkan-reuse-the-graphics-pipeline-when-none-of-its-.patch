+    const Tegra::Engines::Maxwell3D* key_maxwell3d{};
+    Maxwell::PrimitiveTopology key_topology{};
+    Tegra::Engines::Maxwell3D::EngineHint key_engine_state{};
+    std::array<u64, 6> key_hashes{};
+    bool key_squashed_blend{};
+    GraphicsPipeline* key_pipeline{};
+    /// every 64th reuse refreshes the key anyway and compares it; a difference turns reuse off
+    u32 key_reuses_to_check{64};
+    bool key_reuse_enabled{true};
+
     ::Common::unordered_map<ComputePipelineCacheKey, std::unique_ptr<ComputePipeline>> compute_cache;
     ::Common::unordered_map<GraphicsPipelineCacheKey, std::unique_ptr<GraphicsPipeline>> graphics_cache;
 
