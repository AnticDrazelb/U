 size_t BlockOfCode::SpaceRemaining() const {
     ASSERT(prelude_complete);
-    const u8* current_ptr = getCurr<const u8*>();
-    if (current_ptr >= &top_[maxSize_])
+    const u8* current_ptr = in_cold ? hot_saved : getCurr<const u8*>();
+    const u8* limit = cold_enabled ? cold_low : &top_[maxSize_];
+    if (current_ptr >= limit)
         return 0;
-    return &top_[maxSize_] - current_ptr;
+    const size_t remaining = size_t(limit - current_ptr);
+    if (!cold_enabled)
+        return remaining;
+    // (room for one more chunk of cold code kept back: the next block may need one)
+    return remaining > COLD_CHUNK_SIZE ? remaining - COLD_CHUNK_SIZE : 0;
+}
+
+void BlockOfCode::ResetColdCode() {
+    cold_low = cold_ptr = cold_end = &top_[in_cold ? saved_max_size : maxSize_];
+}
+
+void BlockOfCode::EnableColdCode(bool on) {
+    ASSERT(!in_cold);
+    cold_enabled = on;
+    ResetColdCode();
+}
+
+bool BlockOfCode::SwitchToColdCode(size_t bound) {
+    ASSERT(!in_cold);
+    if (!cold_enabled || bound > COLD_CHUNK_SIZE)
+        return false;
+    const u8* hot = getCurr<const u8*>();
+    if (size_t(cold_end - cold_ptr) < bound) {
+        // a new chunk below the others (the rest of this one is left unused)
+        if (cold_low < hot || size_t(cold_low - hot) < COLD_CHUNK_SIZE)
+            return false;
+        cold_low -= COLD_CHUNK_SIZE;
+        cold_ptr = cold_low;
+        cold_end = cold_low + COLD_CHUNK_SIZE;
+    }
+    hot_saved = hot;
+    SetCodePtr(cold_ptr);
+    // (the chunk's end as the buffer's for now: code past it would throw, not overwrite the chunk
+    // above)
+    saved_max_size = maxSize_;
+    maxSize_ = size_t(cold_end - top_);
+    in_cold = true;
+    return true;
+}
+
+void BlockOfCode::SwitchToHotCode() {
+    ASSERT(in_cold);
+    cold_ptr = getCurr<const u8*>();
+    maxSize_ = saved_max_size;
+    in_cold = false;
+    SetCodePtr(hot_saved);
 }
 
