+bool A32EmitX64::ExitReadsWrittenPC(A32EmitContext& ctx, const IR::Inst* inst) const {
+    // Its last instruction, and an exit (possibly after the halt check, which only compares memory)
+    // that reads the PC and upper descriptor first thing: nothing runs in between to change ebx
+    // or ecx (no cycle counting either)
+    if (ctx.IsSingleStep() || conf.enable_cycle_counting || ctx.block.instructions.empty() ||
+        &ctx.block.instructions.back() != inst) {
+        return false;
     }
+    const IR::Term::Terminal terminal = ctx.block.GetTerminal();
+    const IR::Term::LeafTerminal* leaf = std::get_if<IR::Term::LeafTerminal>(&terminal);
+    if (const auto* halt = std::get_if<IR::Term::CheckHalt>(&terminal)) {
+        leaf = &halt->else_;
+    }
+    if (leaf == nullptr) {
+        return false;
+    }
+    if (std::holds_alternative<IR::Term::PopRSBHint>(*leaf)) {
+        return conf.inline_rsb_pop && conf.HasOptimization(OptimizationFlag::ReturnStackBuffer);
+    }
+    if (std::holds_alternative<IR::Term::FastDispatchHint>(*leaf)) {
+        return conf.inline_fast_dispatch && conf.HasOptimization(OptimizationFlag::FastDispatch);
+    }
+    return false;
 }
 
