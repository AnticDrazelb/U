+// (A64DeadNZCVPass: CMP, CMN, TST and the flag-setting forms on X registers)
+namespace {
+// b as an operand for a 64-bit instruction: an immediate that sign-extends from 32 bits, or a
+// register
+Xbyak::Reg64 CondFlagsOperand64(BlockOfCode& code, EmitContext& ctx, Argument& b, std::optional<u32>& imm) {
+    if (b.IsImmediate()) {
+        const u64 value = b.GetImmediateU64();
+        if (mcl::bit::sign_extend<32>(value) == value) {
+            imm = u32(value);
+            return Xbyak::Reg64{0};  // (unused)
+        }
+        const Xbyak::Reg64 r = ctx.reg_alloc.ScratchGpr(code);
+        code.mov(r, value);
+        return r;
+    }
+    return ctx.reg_alloc.UseGpr(code, b);
+}
+}  // namespace
+
+void EmitX64::EmitCondFlagsSub64(EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const Xbyak::Reg64 a = ctx.reg_alloc.UseGpr(code, args[0]);
+    std::optional<u32> imm;
+    const Xbyak::Reg64 b = CondFlagsOperand64(code, ctx, args[1], imm);
+    if (imm) {
+        code.cmp(a, *imm);
+    } else {
+        code.cmp(a, b);
+    }
+    host_cond_flags = HostCondFlags::Sub;
+}
+
+void EmitX64::EmitCondFlagsAdd64(EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const Xbyak::Reg64 a = ctx.reg_alloc.UseScratchGpr(code, args[0]);
+    std::optional<u32> imm;
+    const Xbyak::Reg64 b = CondFlagsOperand64(code, ctx, args[1], imm);
+    if (imm) {
+        code.add(a, *imm);
+    } else {
+        code.add(a, b);
+    }
+    host_cond_flags = HostCondFlags::Add;
+}
+
+void EmitX64::EmitCondFlagsTest64(EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const Xbyak::Reg64 a = ctx.reg_alloc.UseGpr(code, args[0]);
+    std::optional<u32> imm;
+    const Xbyak::Reg64 b = CondFlagsOperand64(code, ctx, args[1], imm);
+    if (imm) {
+        code.test(a, *imm);
+    } else {
+        code.test(a, b);
+    }
+    host_cond_flags = HostCondFlags::Logic;
+}
+
+void EmitX64::EmitCondFlagsNZ64(EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const Xbyak::Reg64 a = ctx.reg_alloc.UseGpr(code, args[0]);
+    code.test(a, a);
+    host_cond_flags = HostCondFlags::Logic;
+}
