+        if (result_used) {
+            cond_flags = is64 ? IR::Opcode::CondFlagsNZ64 : IR::Opcode::CondFlagsNZ32;
+            args = {source};
+        } else {
+            cond_flags = is64 ? IR::Opcode::CondFlagsTest64 : IR::Opcode::CondFlagsTest32;
+            args = {op->GetArg(0), op->GetArg(1)};
+        }
+        break;
+    default:
+        return;
+    }
+    if (args.size() == 2)
+        block.AppendNewInst(cond_flags, {args[0], args[1]});
+    else
+        block.AppendNewInst(cond_flags, {args[0]});
