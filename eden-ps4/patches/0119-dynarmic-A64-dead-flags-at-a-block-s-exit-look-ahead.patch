diff --git a/src/dynarmic/src/dynarmic/frontend/A64/translate/a64_translate.cpp b/src/dynarmic/src/dynarmic/frontend/A64/translate/a64_translate.cpp
index 7840c63d79..d0afb8e2f3 100644
--- a/src/dynarmic/src/dynarmic/frontend/A64/translate/a64_translate.cpp
+++ b/src/dynarmic/src/dynarmic/frontend/A64/translate/a64_translate.cpp
@@ -14,11 +14,252 @@
 #include "dynarmic/ir/basic_block.h"
 #include "dynarmic/ir/terminal.h"
 
+#include <boost/container/static_vector.hpp>
+
 namespace Dynarmic::A64 {
 
+namespace {
+
+constexpr u32 FlagN = 8, FlagZ = 4, FlagC = 2, FlagV = 1, FlagsAll = 15;
+
+// The flags a condition (an A64 Cond's encoding) reads
+constexpr u32 FlagsReadByCond(u32 cond) {
+    switch (cond >> 1) {
+    case 0: return FlagZ;                  // EQ, NE
+    case 1: return FlagC;                  // CS, CC
+    case 2: return FlagN;                  // MI, PL
+    case 3: return FlagV;                  // VS, VC
+    case 4: return FlagC | FlagZ;          // HI, LS
+    case 5: return FlagN | FlagV;          // GE, LT
+    case 6: return FlagN | FlagZ | FlagV;  // GT, LE
+    default: return 0;                     // AL, NV
+    }
+}
+
+constexpr bool IsCall(u32 inst) {
+    return (inst & 0xFC000000) == 0x94000000 ||  // BL
+           ((inst & 0xFE000000) == 0xD6000000 && ((inst >> 21) & 7) == 1);  // BLR, BLRAA...
+}
+
+constexpr bool IsReturn(u32 inst) {
+    return (inst & 0xFE000000) == 0xD6000000 && ((inst >> 21) & 0xF) == 2;  // RET, RETAA...
+}
+
+// Reads A64 code from a block's successor to tell whether the flags the block ends with can be
+// read there (as A32's FlagsLookahead): along every path, an instruction that reads a flag not set
+// again on that path yet makes them live; one that sets them all ends the path. Branches are
+// followed to their targets; anything it doesn't know (a jump through a register, a system call,
+// an exception, a PSTATE write, SVE...) counts as a read. Calls and returns end a path with the
+// flags set with abi (the procedure call standard: NZCV not preserved across a call, undefined on
+// entry to a function); without it calls are followed like branches and returns count as reads.
+struct FlagsLookahead {
+    const MemoryReadCodeFuncType& read_code;
+    bool abi = false;
+    int budget = 64;  // instructions read, on all paths together
+    boost::container::static_vector<std::pair<u64, u32>, 16> targets;  // (address, flags unset there)
+    boost::container::static_vector<std::pair<u64, u64>, 16> runs;     // the code read: [start, end)
+
+    bool Read(u64 pc) {
+        for (auto& [start, end] : runs) {
+            if (pc >= start && pc < end)
+                return true;
+            if (pc == end) {
+                end += 4;
+                return true;
+            }
+        }
+        if (runs.size() == runs.capacity())
+            return false;
+        runs.emplace_back(pc, pc + 4);
+        return true;
+    }
+
+    bool Seen(u64 pc, u32 unset) {
+        for (const auto& [address, then_unset] : targets) {
+            if (address == pc && (unset & ~then_unset) == 0)
+                return true;
+        }
+        if (targets.size() < targets.capacity())
+            targets.emplace_back(pc, unset);
+        return false;
+    }
+
+    bool Live(u64 pc, u32 unset, int branches) {
+        if (Seen(pc, unset))
+            return false;
+        while (unset != 0) {
+            if (--budget < 0)
+                return true;
+            const auto word = read_code(pc);
+            if (!word || !Read(pc))
+                return true;
+            const u32 inst = *word;
+            u32 reads = 0, sets = 0;
+
+            if ((inst & 0x0A000000) == 0x08000000) {
+                // loads and stores (all of them, SIMD's and the exclusives too)
+            } else if ((inst & 0x1C000000) == 0x10000000) {
+                // data processing (immediate)
+                if ((inst & 0x3F800000) == 0x31000000 ||  // ADDS, SUBS (CMN, CMP)
+                    (inst & 0x7F800000) == 0x72000000)    // ANDS (TST)
+                    sets = FlagsAll;
+            } else if ((inst & 0x0E000000) == 0x0A000000) {
+                // data processing (register)
+                if ((inst & 0x10000000) == 0) {
+                    if ((inst & 0x01000000) == 0) {
+                        if ((inst & 0x60000000) == 0x60000000)
+                            sets = FlagsAll;  // ANDS, BICS (TST)
+                    } else if (inst & 0x20000000) {
+                        sets = FlagsAll;  // ADDS, SUBS (shifted, extended register; CMN, CMP)
+                    }
+                } else if ((inst & 0x01000000) != 0) {
+                    // three sources (MADD, SMULH...)
+                } else {
+                    switch ((inst >> 21) & 0xF) {
+                    case 0b0000:  // ADC, ADCS, SBC, SBCS (RMIF, SETF8, SETF16: unknown)
+                        if ((inst & 0xFC00) != 0)
+                            return true;
+                        reads = FlagC;
+                        sets = (inst & 0x20000000) ? FlagsAll : 0;
+                        break;
+                    case 0b0010:  // CCMN, CCMP: the condition, then all of them
+                        if ((inst & 0x20000000) == 0)
+                            return true;
+                        reads = FlagsReadByCond((inst >> 12) & 0xF);
+                        sets = FlagsAll;
+                        break;
+                    case 0b0100:  // CSEL, CSINC, CSINV, CSNEG (CSET, CINC...)
+                        reads = FlagsReadByCond((inst >> 12) & 0xF);
+                        break;
+                    case 0b0110:  // one and two sources (CLZ, RBIT, REV, UDIV, LSLV, CRC32...)
+                        break;
+                    default:
+                        return true;
+                    }
+                }
+            } else if ((inst & 0x0E000000) == 0x0E000000) {
+                // SIMD and floating point
+                if ((inst & 0xFF20FC07) == 0x1E202000) {  // FCMP, FCMPE
+                    sets = FlagsAll;
+                } else if ((inst & 0xFF200C00) == 0x1E200400) {  // FCCMP, FCCMPE
+                    reads = FlagsReadByCond((inst >> 12) & 0xF);
+                    sets = FlagsAll;
+                } else if ((inst & 0xFF200C00) == 0x1E200C00) {  // FCSEL
+                    reads = FlagsReadByCond((inst >> 12) & 0xF);
+                }
+            } else if ((inst & 0x1C000000) == 0x14000000) {
+                // branches, exception generation, system
+                if ((inst & 0x7C000000) == 0x14000000) {  // B, BL
+                    if ((inst & 0x80000000) && abi)
+                        return false;  // a call
+                    if (branches <= 0)
+                        return true;
+                    const u64 target = pc + u64(s64(s32(inst << 6) >> 4));
+                    if (Seen(target, unset))
+                        return false;
+                    pc = target;
+                    branches--;
+                    continue;
+                }
+                u64 target = 0;
+                bool branch = true;
+                if ((inst & 0xFF000010) == 0x54000000) {  // B.cond
+                    if (FlagsReadByCond(inst & 0xF) & unset)
+                        return true;
+                    target = pc + u64(s64(s32(inst << 8) >> 11));
+                } else if ((inst & 0x7E000000) == 0x34000000) {  // CBZ, CBNZ
+                    target = pc + u64(s64(s32(inst << 8) >> 11));
+                } else if ((inst & 0x7E000000) == 0x36000000) {  // TBZ, TBNZ
+                    target = pc + u64(s64(s32(inst << 13) >> 16));
+                } else if ((inst & 0xFE000000) == 0xD6000000) {  // through a register
+                    if (abi && (IsCall(inst) || IsReturn(inst)))
+                        return false;
+                    return true;  // BR, ERET...: somewhere unknown
+                } else if ((inst & 0xFFFFF01F) == 0xD503201F || (inst & 0xFFFFF01F) == 0xD503301F) {
+                    // hints (NOP, YIELD, BTI, the PAC hints...), CLREX, DSB, DMB, ISB, SB
+                    branch = false;
+                } else if ((inst & 0xFFFFFFE0) == 0xD53B4200) {  // MRS Xt, NZCV
+                    return true;
+                } else if ((inst & 0xFFFFFFE0) == 0xD51B4200) {  // MSR NZCV, Xt
+                    sets = FlagsAll;
+                    branch = false;
+                } else if ((inst & 0xFFF00000) == 0xD5300000 || (inst & 0xFFF00000) == 0xD5100000 ||
+                           (inst & 0xFFF80000) == 0xD5080000) {
+                    // MRS, MSR (register), SYS (DC, IC, TLBI)
+                    branch = false;
+                } else {
+                    return true;  // SVC, BRK, HLT, MSR (immediate: PSTATE, CFINV, XAFLAG...), SYSL...
+                }
+                if (branch) {
+                    if (branches <= 0)
+                        return true;
+                    if (Live(target, unset, branches - 1))
+                        return true;
+                    branches--;
+                }
+            } else {
+                return true;  // SVE, SME, unallocated
+            }
+            if (reads & unset)
+                return true;
+            unset &= ~sets;
+            pc += 4;
+        }
+        return false;
+    }
+};
+
+// IR::Block::nzcv_dead_at_exit for a block ending in links to other code, or (abi) in a call or a
+// return
+void LookAheadForFlags(IR::Block& block, const MemoryReadCodeFuncType& read_code, bool abi) {
+    const LocationDescriptor end{block.EndLocation()};
+    if (abi) {
+        if (const auto last = read_code(end.PC() - 4); last && (IsCall(*last) || IsReturn(*last))) {
+            block.nzcv_dead_at_exit = true;
+            return;
+        }
+    }
+    boost::container::static_vector<LocationDescriptor, 2> successors;
+    const auto leaf = [&](const IR::Term::LeafTerminal& term) {
+        if (const auto* link = std::get_if<IR::Term::LinkBlock>(&term))
+            successors.push_back(LocationDescriptor{link->next});
+        else if (const auto* fast = std::get_if<IR::Term::LinkBlockFast>(&term))
+            successors.push_back(LocationDescriptor{fast->next});
+        else
+            return false;
+        return true;
+    };
+    const auto& terminal = block.GetTerminal();
+    if (const auto* if_ = std::get_if<IR::Term::If>(&terminal)) {
+        if (!leaf(if_->then_) || !leaf(if_->else_))
+            return;
+    } else if (const auto* check = std::get_if<IR::Term::CheckBit>(&terminal)) {
+        if (!leaf(check->then_) || !leaf(check->else_))
+            return;
+    } else if (const auto* l = std::get_if<IR::Term::LeafTerminal>(&terminal)) {
+        if (!leaf(*l))
+            return;
+    } else {
+        return;
+    }
+    for (const auto& next : successors) {
+        if (next.SingleStepping())
+            return;
+    }
+    FlagsLookahead lookahead{read_code, abi};
+    for (const auto& next : successors) {
+        if (lookahead.Live(next.PC(), FlagsAll, 6))
+            return;
+    }
+    block.nzcv_dead_at_exit = true;
+    block.lookahead.assign(lookahead.runs.begin(), lookahead.runs.end());
+}
+
+}  // namespace
