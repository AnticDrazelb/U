+            return;  // (SBCS)
+        if (nz_only && result_used) {
+            cond_flags = is64 ? IR::Opcode::CondFlagsNZ64 : IR::Opcode::CondFlagsNZ32;
+            args = {source};
+        } else {
+            cond_flags = is64 ? IR::Opcode::CondFlagsSub64 : IR::Opcode::CondFlagsSub32;  // CMP, SUBS
+            args = {op->GetArg(0), op->GetArg(1)};
+        }
+        break;
+    case IR::Opcode::Add32:
+    case IR::Opcode::Add64:
+        if (!carry_in(false))
+            return;  // (ADCS)
+        if (nz_only && result_used) {
+            cond_flags = is64 ? IR::Opcode::CondFlagsNZ64 : IR::Opcode::CondFlagsNZ32;
+            args = {source};
+        } else if (!hi_ls) {
