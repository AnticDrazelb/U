+// A64's: a block whose flags are dead at its exit (IR::Block::nzcv_dead_at_exit) doesn't store
+// those its last flag-setting instructions make (after the last instruction that reads them); one
+// that ends in a conditional branch then branches on the host's flags as a compare of the values
+// they came from left them (CondFlags*, the block's last instruction: cmp; jcc). A branch whose
+// flags have no such form (ADCS, CCMP, MSR NZCV) keeps the stored flags.
+static void A64DeadNZCVPass(IR::Block& block) {
+    if (!block.nzcv_dead_at_exit)
+        return;
+    boost::container::small_vector<IR::Inst*, 8> writes;  // the last setters, latest first
+    for (auto it = block.instructions.rbegin(); it != block.instructions.rend(); ++it) {
+        const auto op = it->GetOpcode();
+        if (op == IR::Opcode::A64SetNZCV || op == IR::Opcode::A64SetNZCVRaw) {
+            writes.push_back(&*it);
+            continue;
+        }
+        if (ReadsFromCPSR(op) || CausesCPUException(op))
+            break;
+    }
+    if (writes.empty())
+        return;
+
+    IR::Inst* compare = nullptr;  // a float compare left without uses (DCE keeps them)
+    const auto finish = [&] {
+        for (IR::Inst* const write : writes) {
+            if (write->GetOpcode() == IR::Opcode::A64SetNZCV && !write->GetArg(0).IsImmediate()) {
+                IR::Inst* const flags = write->GetArg(0).GetInst();
+                if (flags->GetOpcode() == IR::Opcode::FPCompare32 || flags->GetOpcode() == IR::Opcode::FPCompare64)
+                    compare = flags;
+            }
+            write->Invalidate();
+        }
+        if (compare && compare->UseCount() == 0)
+            compare->Invalidate();
+    };
+
+    const IR::Term::Terminal terminal = block.GetTerminal();
+    const auto* const if_ = std::get_if<IR::Term::If>(&terminal);
+    if (!if_ || if_->if_ == IR::Cond::AL || if_->if_ == IR::Cond::NV) {
+        finish();
+        return;
+    }
+    const IR::Cond cond = if_->if_;
+    const bool nz_only = cond == IR::Cond::EQ || cond == IR::Cond::NE || cond == IR::Cond::MI || cond == IR::Cond::PL;
+    const bool hi_ls = cond == IR::Cond::HI || cond == IR::Cond::LS;
+    IR::Inst* const last = writes.front();
+    if (last->GetOpcode() != IR::Opcode::A64SetNZCV || last->GetArg(0).IsImmediate())
+        return;
+    IR::Inst* const flags = last->GetArg(0).GetInst();
+
+    if (flags->GetOpcode() == IR::Opcode::FPCompare32 || flags->GetOpcode() == IR::Opcode::FPCompare64) {
+        // FCMP: ucomis of its operands, swapped for the conditions on N or C alone and HI/LS
+        // (EmitCond's FP mapping, the same flags as A32's VCMP)
+        const bool swap = cond == IR::Cond::MI || cond == IR::Cond::PL || cond == IR::Cond::HI || cond == IR::Cond::LS ||
+                          cond == IR::Cond::CS || cond == IR::Cond::CC;
+        const IR::Value x = flags->GetArg(swap ? 1 : 0), y = flags->GetArg(swap ? 0 : 1);
+        block.AppendNewInst(flags->GetOpcode() == IR::Opcode::FPCompare32 ? IR::Opcode::CondFlagsFP32 : IR::Opcode::CondFlagsFP64, {x, y});
+        finish();
+        return;
+    }
+    if (flags->GetOpcode() != IR::Opcode::GetNZCVFromOp || flags->GetArg(0).IsImmediate())
+        return;
+    const IR::Value source = flags->GetArg(0);
+    IR::Inst* const op = source.GetInst();
+    const bool is64 = source.GetType() == IR::Type::U64;
+    if (!is64 && source.GetType() != IR::Type::U32)
+        return;
+    const auto carry_in = [&](bool value) {
+        return op->GetArg(2).IsImmediate() && op->GetArg(2).GetU1() == value;
+    };
