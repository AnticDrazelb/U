+        // (PS4 04.29) each B.cond side exit: whether its target may read the flags (the code
+        // read is the block's too)
+        for (auto& inst : block.instructions) {
+            if (inst.GetOpcode() != IR::Opcode::A64ExitIfCond)
+                continue;
+            FlagsLookahead lookahead{memory_read_code, options.nzcv_lookahead_abi};
+            const LocationDescriptor target{IR::LocationDescriptor{inst.GetArg(1).GetU64()}};
+            const bool live = lookahead.Live(target.PC(), FlagsAll, 6);
+            inst.SetArg(2, IR::Value{live});
+            block.lookahead.insert(block.lookahead.end(), lookahead.runs.begin(), lookahead.runs.end());
+        }
     }
