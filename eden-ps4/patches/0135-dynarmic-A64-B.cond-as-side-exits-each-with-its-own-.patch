+// (PS4 04.29) A B.cond side exit: the stored flags (eax) or the host's as a CondFlags* right before
+// left them (ExitIfCondHost: always the latter)
+void A64EmitX64::EmitA64ExitIfCond(A64EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const IR::Cond cond = args[0].GetImmediateCond();
+    const IR::LocationDescriptor target{args[1].GetImmediateU64()};
+    ctx.reg_alloc.ScratchGpr(code, HostLoc::RAX);  // (EmitCond's: moves only, the host's flags stay)
+    code.setDefaultJmpNEAR(true);
+    Xbyak::Label taken = EmitCond(cond);
+    code.setDefaultJmpNEAR(false);
+    EmitSideExitLink(ctx, taken, target);
+}
+
+void A64EmitX64::EmitA64ExitIfCondHost(A64EmitContext& ctx, IR::Inst* inst) {
+    ASSERT(host_cond_flags != HostCondFlags::None);
+    EmitA64ExitIfCond(ctx, inst);
+}
