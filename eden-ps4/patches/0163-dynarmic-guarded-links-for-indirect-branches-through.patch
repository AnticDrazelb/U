@@ -34,6 +34,7 @@
 #include "dynarmic/backend/x64/ps4_block_map.h"
 #include "dynarmic/interface/exclusive_monitor.h"
 #include "dynarmic/common/atomic.h"
+#include "dynarmic/frontend/A32/a32_ir_emitter.h"
 #include "dynarmic/frontend/A32/a32_location_descriptor.h"
 #include "dynarmic/frontend/A32/translate/a32_translate.h"
 #include "dynarmic/interface/A32/a32.h"
@@ -72,6 +73,58 @@ static Optimization::PolyfillOptions GenPolyfillOptions(const BlockOfCode& code)
     };
 }
 
+// (PS4 04.73) UserConfig::guarded_indirect_links: an ARM-state block, unconditional, ending in the
+// lookup after a BXWritePC of a load from a constant address, changing nothing of the upper location
+// descriptor: the word there now compared with the loaded one at the end; equal, a link straight to
+// the location the BXWritePC makes of it (the hash EmitA32BXWritePC computes at run time)
+static void GuardIndirectLink(IR::Block& block, A32::UserCallbacks& callbacks) {
+    const IR::Term::Terminal terminal = block.GetTerminal();
+    const auto* const leaf = std::get_if<IR::Term::LeafTerminal>(&terminal);
+    if (!leaf || !std::holds_alternative<IR::Term::FastDispatchHint>(*leaf) || block.GetCondition() != IR::Cond::AL)
+        return;
+    const A32::LocationDescriptor start{block.Location()};
+    if (start.TFlag())
+        return;
+    IR::Inst* write_pc = nullptr;
+    for (auto& inst : block.instructions) {
+        switch (inst.GetOpcode()) {
+        case IR::Opcode::A32BXWritePC:
+            write_pc = &inst;
+            break;
+        case IR::Opcode::A32SetCpsr:
+        case IR::Opcode::A32SetFpscr:
+        case IR::Opcode::A32UpdateUpperLocationDescriptor:
+            return;
+        default:
+            break;
+        }
+    }
+    if (!write_pc || write_pc->GetArg(0).IsImmediate())
+        return;
+    IR::Inst* const load = write_pc->GetArg(0).GetInst();
+    if (load->GetOpcode() != IR::Opcode::A32ReadMemory32 || !load->GetArg(1).IsImmediate())
+        return;
+    const u32 vaddr = load->GetArg(1).GetU32();
+    if (vaddr & 3)
+        return;
+    const auto word = callbacks.PeekCode(vaddr);
+    if (!word)
+        return;
+    const u32 value = *word;
+    const bool thumb = (value & 1) != 0;
+    const u32 pc = value & (thumb ? 0xFFFFFFFEu : 0xFFFFFFFCu);
+    if (pc == 0 || (!thumb && (value & 2) != 0))
+        return;
+    const u64 upper_without_t =
+        (A32::LocationDescriptor{block.EndLocation()}.SetSingleStepping(false).UniqueHash() >> 32) & 0xFFFFFFFE;
+    const IR::LocationDescriptor next{((upper_without_t | (thumb ? 1 : 0)) << 32) | pc};
+    // (the new instructions after the BXWritePC: it then stores the PC and upper descriptor, the
+    // lookup reads them back)
+    A32::IREmitter ir{block, start, {}};
+    ir.SetCheckBit(ir.IsZero(ir.Sub(IR::U32{IR::Value{load}}, ir.Imm32(value))));
+    block.ReplaceTerminal(IR::Term::CheckBit{IR::Term::LinkBlock{next}, IR::Term::FastDispatchHint{}});
+}
+
 struct Jit::Impl {
     Impl(Jit* jit, A32::UserConfig conf) noexcept
         : block_of_code(GenRunCodeCallbacks(conf.callbacks, &GetCurrentBlockThunk, this, conf), JitStateInfo{jit_state}, conf.code_cache_size, GenRCP(conf))
@@ -225,6 +278,7 @@ struct Jit::Impl {
         add(conf.inline_fast_dispatch);
         add(conf.inline_conditional_instructions);
         add(conf.loop_register_pins);
+        add(conf.guarded_indirect_links);
         add(conf.elide_dead_nzcv);
         add(conf.elide_dead_nzcv_abi);
         add(conf.plain_acquire_loads);
@@ -329,6 +383,8 @@ private:
                                                                        !conf.check_halt_on_memory_access,
                                                                    conf.elide_dead_nzcv_abi});
         Optimization::Optimize(ir_block, conf, polyfill_options);
+        if (conf.guarded_indirect_links && !arch_descriptor.SingleStepping())
+            GuardIndirectLink(ir_block, *conf.callbacks);
         // Accesses fastmem was declined for (pages the PS4 can't map at the game's addresses: a
         // thread's stack, its local storage) walk the page table: one walk for those through one
         // base (a PUSH or POP, a function's stack frame), as without fastmem
