 #include "dynarmic/backend/x64/jitstate_info.h"
 #include "dynarmic/interface/exclusive_monitor.h"
 #include "dynarmic/common/atomic.h"
+#include "dynarmic/frontend/A64/a64_ir_emitter.h"
 #include "dynarmic/frontend/A64/translate/a64_translate.h"
 #include "dynarmic/interface/A64/a64.h"
 #include "dynarmic/ir/basic_block.h"
@@ -254,6 +255,48 @@ private:
         return GetBlock(A64::LocationDescriptor{GetCurrentLocation()}.SetSingleStepping(true));
     }
 
+    // (PS4 04.73) UserConfig::guarded_indirect_links: the block's last SetPC a load from a constant
+    // address, the block ending in the lookup (BR, BLR): the value there now, if it's an address
+    // code can be at, compared with the loaded one at the end; equal, a link straight to its block
+    void GuardIndirectLink(IR::Block& block) {
+        const IR::Term::Terminal terminal = block.GetTerminal();
+        const auto* const leaf = std::get_if<IR::Term::LeafTerminal>(&terminal);
+        if (!leaf || !std::holds_alternative<IR::Term::FastDispatchHint>(*leaf))
+            return;
+        IR::Inst* set_pc = nullptr;
+        for (auto& inst : block.instructions) {
+            switch (inst.GetOpcode()) {
+            case IR::Opcode::A64SetPC:
+                set_pc = &inst;
+                break;
+            case IR::Opcode::A64SetFPCR:  // (the next block's location carries the FPCR)
+                return;
+            default:
+                break;
+            }
+        }
+        if (!set_pc || set_pc->GetArg(0).IsImmediate())
+            return;
+        IR::Inst* const load = set_pc->GetArg(0).GetInst();
+        if (load->GetOpcode() != IR::Opcode::A64ReadMemory64 || !load->GetArg(1).IsImmediate())
+            return;
+        const u64 vaddr = load->GetArg(1).GetU64();
+        if (vaddr & 7)
+            return;
+        const auto lo = conf.callbacks->PeekCode(vaddr), hi = conf.callbacks->PeekCode(vaddr + 4);
+        if (!lo || !hi)
+            return;
+        const u64 target = u64(*lo) | (u64(*hi) << 32);
+        const auto next = A64::LocationDescriptor{block.Location()}.SetPC(target);
+        if (target == 0 || (target & 3) != 0 || next.PC() != target)  // (one a location can hold)
+            return;
+        // (the new instructions at the end, the terminal right after them: FuseCheckBit tests the
+        // difference in its register)
+        A64::IREmitter ir{block};
+        ir.SetCheckBit(ir.IsZero(ir.Sub(IR::U64{IR::Value{load}}, ir.Imm64(target))));
+        block.ReplaceTerminal(IR::Term::CheckBit{IR::Term::LinkBlock{next}, IR::Term::FastDispatchHint{}});
+    }
+
     CodePtr GetBlock(IR::LocationDescriptor descriptor) {
         if (auto block = emitter.GetBasicBlock(descriptor))
             return block->entrypoint;
@@ -294,6 +337,8 @@ private:
         const bool dump = block_pc >= conf.dump_pc_lo && block_pc < conf.dump_pc_hi;
         const std::string ir_before = dump ? IR::DumpBlock(ir_block) : std::string{};
         Optimization::Optimize(ir_block, conf, polyfill_options);
+        if (conf.guarded_indirect_links && !arch_descriptor.SingleStepping())
+            GuardIndirectLink(ir_block);
         // (PS4 04.25) With fastmem, the accesses it was declined for (pages the PS4 can't map at
         // the game's addresses) walk the page table: one walk for those through one base
         if (conf.fastmem_pointer && conf.page_table && conf.page_table_shared_walk && !conf.check_halt_on_memory_access &&
@@ -404,6 +449,7 @@ private:
         add(conf.return_stack_pc_only);
         add(conf.follow_direct_branches);
         add(conf.follow_known_returns);
+        add(conf.guarded_indirect_links);
         add(conf.loop_register_pins);
         add(conf.fastmem_range_check_reuse);
         add(conf.plain_acquire_loads);
