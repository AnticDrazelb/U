-/// The fast paths' samples of a level of a 2D texture of 8-bit texels (an identity swizzle; for
-/// bilinear ones, not sRGB), for the lanes in 'exec': all lanes at once in arrays (the compiler
+/// The fast paths' samples of a level of a 2D texture of 8-bit texels (an identity swizzle), for
+/// the lanes in 'exec': all lanes at once in arrays (the compiler
 /// vectorizes all but the texel loads), each lane's texel or footprint wrapped or clamped as the
 /// sampler says. Into 'd' for those lanes; returned, the lanes it can't do (a footprint outside the
 /// texture, neither wrapped nor clamped), for one at a time.
@@ -2140,14 +2141,40 @@ u32 SampleLevelFast(const Texture& texture, const Binding& binding, const Level&
             t00[i] = texels[top[i] + left[i]], t10[i] = texels[top[i] + right[i]];
             t01[i] = texels[bottom[i] + left[i]], t11[i] = texels[bottom[i] + right[i]];
         }
-        for (u32 ch = 0; ch < 4; ++ch) {
-            const u32 shift = ch * 8;
+        if (texture.srgb) { // decoded first (the colours through the sRGB table), filtered in floats
+            const f32* const rgb = texture.rgb_table;
+            const f32* const unorm = UnormTable().data();
+            for (u32 ch = 0; ch < 4; ++ch) {
+                const f32* const table = ch < 3 ? rgb : unorm;
+                const u32 shift = ch * 8;
+                for (u32 i = 0; i < LANES; ++i) {
+                    const f32 fx = f32(wx[i]) * (1.0f / 256.0f), fy = f32(wy[i]) * (1.0f / 256.0f);
+                    const f32 c00 = table[(t00[i] >> shift) & 0xFF], c10 = table[(t10[i] >> shift) & 0xFF];
+                    const f32 c01 = table[(t01[i] >> shift) & 0xFF], c11 = table[(t11[i] >> shift) & 0xFF];
+                    const f32 top = c00 + (c10 - c00) * fx, bottom = c01 + (c11 - c01) * fx;
+                    out[ch][i] = top + (bottom - top) * fy;
+                }
+            }
+        } else {
+            // two channels at once in each 32-bit multiply (red and blue, green and alpha, 16 bits
+            // apart): across, then down, each rounded
+            alignas(64) u32 filtered[LANES];
             for (u32 i = 0; i < LANES; ++i) {
-                const u32 w00 = (256 - wx[i]) * (256 - wy[i]), w10 = wx[i] * (256 - wy[i]);
-                const u32 w01 = (256 - wx[i]) * wy[i], w11 = wx[i] * wy[i];
-                const u32 sum = ((t00[i] >> shift) & 0xFF) * w00 + ((t10[i] >> shift) & 0xFF) * w10 +
-                                ((t01[i] >> shift) & 0xFF) * w01 + ((t11[i] >> shift) & 0xFF) * w11;
-                out[ch][i] = f32((sum + 32768) >> 16) * (1.0f / 255.0f);
+                constexpr u32 mask = 0x00FF00FF, half = 0x00800080;
+                const u32 ax = 256 - wx[i], ay = 256 - wy[i];
+                const auto across = [&](u32 a, u32 b, u32 shift) {
+                    return ((((a >> shift) & mask) * ax + ((b >> shift) & mask) * wx[i] + half) >> 8) & mask;
+                };
+                const u32 top_rb = across(t00[i], t10[i], 0), top_ga = across(t00[i], t10[i], 8);
+                const u32 bottom_rb = across(t01[i], t11[i], 0), bottom_ga = across(t01[i], t11[i], 8);
+                const u32 rb = ((top_rb * ay + bottom_rb * wy[i] + half) >> 8) & mask;
+                const u32 ga = ((top_ga * ay + bottom_ga * wy[i] + half) >> 8) & mask;
+                filtered[i] = rb | ga << 8;
+            }
+            for (u32 ch = 0; ch < 4; ++ch) {
+                for (u32 i = 0; i < LANES; ++i) {
+                    out[ch][i] = f32((filtered[i] >> (ch * 8)) & 0xFF) * (1.0f / 255.0f);
+                }
             }
         }
     }
