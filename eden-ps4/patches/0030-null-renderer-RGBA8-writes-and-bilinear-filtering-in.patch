@@ -3486,6 +3513,10 @@ void SoftwareDraw::RasterRows(Batch& b, Raster& st, s32 row_begin, s32 row_end)
     Io io{in, st.outputs.data(), st.colors.data(), st.discard.data(), LANES, 0,
