+                            const u32 b = Unorm(fragments[2 * LANES + j], 8), a = Unorm(fragments[3 * LANES + j], 8);
+                            src[j] = (tg.bgra ? b | r << 16 : r | b << 16) | g << 8 | a << 24;
                         }
+                        for (u32 half = 0; half < 2; ++half) {
