+            ballot |= a.w[0][i] != 0 ? bit : 0;
+        }
+        const u32 result = o.op == O::VoteAll   ? ballot == active
+                           : o.op == O::VoteAny ? ballot != 0
+                           : o.op == O::VoteEqual ? ballot == 0 || ballot == active
+                                                  : ballot;
+        LANE_LOOP d.w[0][i] = result;
+        break;
+    }
+    case O::SubgroupEqMask: case O::SubgroupLtMask: case O::SubgroupLeMask:
+    case O::SubgroupGtMask: case O::SubgroupGeMask:
+        LANE_LOOP {
+            const u32 id = io.quads ? INVOCATION_ID[i] : 0, size = io.quads ? 0xFFFFu : 1u;
+            const u32 lt = (1u << id) - 1, le = (2u << id) - 1;
+            d.w[0][i] = o.op == O::SubgroupEqMask   ? 1u << id
+                        : o.op == O::SubgroupLtMask ? lt
+                        : o.op == O::SubgroupLeMask ? le
+                        : o.op == O::SubgroupGtMask ? ~le & size
+                                                    : ~lt & size;
+        }
+        break;
+    case O::ShuffleIndex: case O::ShuffleUp: case O::ShuffleDown: case O::ShuffleButterfly:
+        // the source lane's value when it's in bounds (value, index, clamp, segment mask), as
+        // Eden's backends work it out; the in-bounds flag kept in the result's second word
+        LANE_LOOP {
+            const u32 id = io.quads ? INVOCATION_ID[i] : 0, index = b.w[0][i];
+            const u32 min_id = id & f.w[0][i], max_id = min_id | (e.w[0][i] & ~f.w[0][i]);
+            u32 source;
+            bool in_bounds;
+            if (o.op == O::ShuffleIndex) {
+                source = (index & ~f.w[0][i]) | min_id, in_bounds = s32(source) <= s32(max_id);
+            } else if (o.op == O::ShuffleUp) {
+                source = id - index, in_bounds = s32(source) >= s32(max_id);
+            } else if (o.op == O::ShuffleDown) {
+                source = id + index, in_bounds = s32(source) <= s32(max_id);
+            } else {
+                source = id ^ index, in_bounds = s32(source) <= s32(max_id);
+            }
+            const bool exists = io.quads ? source < LANES : source == 0;
+            d.w[0][i] = in_bounds && exists ? a.w[0][io.quads ? INVOCATION_LANE[source] : i] : a.w[0][i];
+            d.w[1][i] = in_bounds ? 1 : 0;
+        }
+        break;
+    case O::QuadBroadcast: case O::QuadSwap: // value, the quad's lane; value, direction
+        LANE_LOOP {
+            if (!io.quads) {
+                d.w[0][i] = a.w[0][i];
+                continue;
+            }
+            const u32 id = INVOCATION_ID[i];
+            const u32 source = o.op == O::QuadBroadcast ? (id & ~3u) | (b.w[0][i] & 3) : id ^ ((b.w[0][i] + 1) & 3);
+            d.w[0][i] = a.w[0][INVOCATION_LANE[source]];
+        }
+        break;
+    case O::FSwizzleAdd: { // each lane's mode by its place in its quad
+        static constexpr f32 modifier_a[4] = {1.0f, -1.0f, 1.0f, 0.0f};
+        static constexpr f32 modifier_b[4] = {1.0f, 1.0f, -1.0f, 1.0f};
+        LANE_LOOP {
+            const u32 id = io.quads ? INVOCATION_ID[i] : 0;
+            const u32 mode = (e.w[0][i] >> ((id & 3) * 2)) & 3;
+            SetFl(d, i, Fl(a, i) * modifier_a[mode] + Fl(b, i) * modifier_b[mode]);
+        }
+        break;
+    }
+    case O::IAbs64: LANE_LOOP SetU64l(d, i, s64(U64l(a, i)) < 0 ? 0 - U64l(a, i) : U64l(a, i)); break;
+    case O::LoadStorageU8: case O::LoadStorageS8: case O::LoadStorageU16: case O::LoadStorageS16:
+    case O::LoadStorage32: case O::LoadStorage64: case O::LoadStorage128: {
+        const u32 bytes = AccessBytes(o.op);
+        const bool sign = o.op == O::LoadStorageS8 || o.op == O::LoadStorageS16;
+        IO_LOOP {
+            GPUVAddr address;
+            if (StorageAddress(io, a.w[0][i], b.w[0][i], bytes, address)) {
+                ReadMemory(io, address, bytes, sign, d, i);
+            } else {
+                d.w[0][i] = d.w[1][i] = d.w[2][i] = d.w[3][i] = 0;
+            }
+        }
+        break;
+    }
+    case O::WriteStorageU8: case O::WriteStorageS8: case O::WriteStorageU16: case O::WriteStorageS16:
+    case O::WriteStorage32: case O::WriteStorage64: case O::WriteStorage128: {
+        const u32 bytes = AccessBytes(o.op);
+        EXEC_LOOP(exec & io.live) {
+            GPUVAddr address;
+            if (StorageAddress(io, a.w[0][i], b.w[0][i], bytes, address)) {
+                WriteMemory(io, address, bytes, e, i);
+            }
+        }
+        break;
+    }
+    case O::LoadGlobalU8: case O::LoadGlobalS8: case O::LoadGlobalU16: case O::LoadGlobalS16:
+    case O::LoadGlobal32: case O::LoadGlobal64: case O::LoadGlobal128: {
+        const u32 bytes = AccessBytes(o.op);
+        const bool sign = o.op == O::LoadGlobalS8 || o.op == O::LoadGlobalS16;
+        EXEC_LOOP(exec) ReadMemory(io, U64l(a, i), bytes, sign, d, i);
+        break;
+    }
+    case O::WriteGlobalU8: case O::WriteGlobalS8: case O::WriteGlobalU16: case O::WriteGlobalS16:
+    case O::WriteGlobal32: case O::WriteGlobal64: case O::WriteGlobal128: {
+        const u32 bytes = AccessBytes(o.op);
+        EXEC_LOOP(exec & io.live) WriteMemory(io, U64l(a, i), bytes, b, i);
+        break;
+    }
+    default:
+        break;
+    }
+}
+
+/// The same, called from native code (16 lanes, none waiting)
+void RunIrNative(const SoftwareDraw::Program* program, const Op* o, Lanes* c, Io* io, u32 exec) {
+    RunIr<true>(*program, *o, c, *io, LANES, exec, 0);
+}
+
+// ---- native code: a fragment or compute program's runs of instructions between branches
+// compiled to x86 (AVX, 128 bits: SSE's instructions in their three-operand form, which the
+// PS4's Jaguar cores have), for when no lanes wait at a branch. Arithmetic is done four lanes at
+// a time, a value to a register, the run's arithmetic once for each four (each lane's own: lanes
+// don't mix in it); what's left (textures, memory, lanes that mix) is called out to the
+// interpreter's code for all 16 lanes at once.
+
+#ifdef SOFTWARE_JIT
+u32 ReadCbufNative(const Io* io, u32 index, u32 byte_offset) {
+    return ReadCbuf(*io, index, byte_offset, 4);
+}
+
+using NativeFn = void (*)(Lanes* c, Io* io, u32 exec);
+
+/// Vectors native code reads, four of each: sign bits, all but them, 1.0, 0, 1, all bits,
+/// 65536.0, the low 16 bits
+alignas(16) constexpr u32 JIT_CONSTANTS[8][4] = {
+    {0x80000000u, 0x80000000u, 0x80000000u, 0x80000000u}, {0x7FFFFFFFu, 0x7FFFFFFFu, 0x7FFFFFFFu, 0x7FFFFFFFu},
+    {0x3F800000u, 0x3F800000u, 0x3F800000u, 0x3F800000u}, {0, 0, 0, 0},
+    {1, 1, 1, 1}, {~0u, ~0u, ~0u, ~0u},
+    {0x47800000u, 0x47800000u, 0x47800000u, 0x47800000u}, {0xFFFF, 0xFFFF, 0xFFFF, 0xFFFF},
+};
+enum JitConstant { SIGN, ABS, ONE, ZERO, ONE_INT, ALL_ONES, F65536, LOW16 };
+
+/// What native code does with an instruction
+enum class JitUse {
+    End,     // it ends a run (a branch, a return, a discard)
+    Lanes,   // done natively, four lanes at a time
+    Uniform, // a constant buffer's word at a constant offset: read once, for every lane
+    Call,    // called out, for all lanes at once
+};
+
+/// The process's native code memory (read, write and execute, as dynarmic's on the PS4) and its
+/// compiler
+class ShaderJit {
+public:
+    static ShaderJit* Get() {
+        static ShaderJit* const jit = [] () -> ShaderJit* {
+            if (const char* env = std::getenv("EDEN_SW_JIT"); env && std::string_view{env} == "0") {
+                return nullptr;
+            }
+            const Xbyak::util::Cpu cpu;
+            if (!cpu.has(Xbyak::util::Cpu::tAVX) || !cpu.has(Xbyak::util::Cpu::tSSE41)) {
+                LogOnce("no AVX: software shaders interpreted");
+                return nullptr;
+            }
+            void* const memory = mmap(nullptr, MEMORY_SIZE, PROT_READ | PROT_WRITE | PROT_EXEC,
+                                      MAP_PRIVATE | MAP_ANON, -1, 0);
+            if (memory == MAP_FAILED) {
+                LogOnce("no executable memory: software shaders interpreted");
+                return nullptr;
+            }
+            LogOnce("fragment and compute shaders compiled to native code (EDEN_SW_JIT=0: interpreted)");
+            return new ShaderJit(static_cast<u8*>(memory));
+        }();
+        return jit;
+    }
+
+    /// The program's runs compiled, each behind a Kind::Native op (its function in 'native', the
+    /// op after the run in 'extra'); the ops' jumps moved to match. False if nothing was.
+    bool Compile(SoftwareDraw::Program& program);
+
+private:
+    static constexpr size_t MEMORY_SIZE = 4u << 20;
+    explicit ShaderJit(u8* memory_) : memory{memory_} {}
+
+    u8* memory;
+    size_t used = 0;
+    bool full = false;
+};
+
+JitUse UseOf(const Op& o, const std::vector<bool>& written) {
+    using O = IR::Opcode;
+    if (o.kind == Kind::Move) {
+        return JitUse::Lanes;
+    }
+    if (o.kind != Kind::Ir || o.op == O::DemoteToHelperInvocation) {
+        return JitUse::End;
+    }
+    const auto constant = [&](u16 cell) { return !written[cell]; };
+    switch (o.op) {
+    case O::GetCbufU32: case O::GetCbufF32: case O::GetCbufU32x2:
+        return o.extra && constant(o.a[0]) && constant(o.a[1]) ? JitUse::Uniform : JitUse::Call;
+    case O::CompositeExtractU32x2: case O::CompositeExtractU32x3: case O::CompositeExtractU32x4:
+    case O::CompositeExtractF32x2: case O::CompositeExtractF32x3: case O::CompositeExtractF32x4:
+        return o.extra ? JitUse::Lanes : JitUse::Call;
+    case O::ShiftLeftLogical32: case O::ShiftRightLogical32: case O::ShiftRightArithmetic32:
+        return constant(o.a[1]) ? JitUse::Lanes : JitUse::Call;
+    case O::GetAttribute: case O::GetAttributeU32: case O::SetFragColor:
+    case O::CompositeConstructU32x2: case O::CompositeConstructU32x3: case O::CompositeConstructU32x4:
+    case O::CompositeConstructF32x2: case O::CompositeConstructF32x3: case O::CompositeConstructF32x4:
+    case O::BitCastU32F32: case O::BitCastF32U32: case O::BitCastU64F64: case O::BitCastF64U64:
+    case O::PackUint2x32: case O::UnpackUint2x32: case O::PackDouble2x32: case O::UnpackDouble2x32:
+    case O::SelectU1: case O::SelectU8: case O::SelectU16: case O::SelectU32: case O::SelectF32:
+    case O::SelectU64:
+    case O::FPAbs32: case O::FPAdd32: case O::FPFma32: case O::FPMax32: case O::FPMin32:
+    case O::FPMul32: case O::FPNeg32: case O::FPRecip32: case O::FPRecipSqrt32: case O::FPSqrt:
+    case O::FPSaturate32: case O::FPClamp32: case O::FPRoundEven32: case O::FPFloor32:
+    case O::FPCeil32: case O::FPTrunc32:
+    case O::FPOrdEqual32: case O::FPUnordEqual32: case O::FPOrdNotEqual32: case O::FPUnordNotEqual32:
+    case O::FPOrdLessThan32: case O::FPUnordLessThan32: case O::FPOrdGreaterThan32:
+    case O::FPUnordGreaterThan32: case O::FPOrdLessThanEqual32: case O::FPUnordLessThanEqual32:
+    case O::FPOrdGreaterThanEqual32: case O::FPUnordGreaterThanEqual32: case O::FPIsNan32:
+    case O::IAdd32: case O::ISub32: case O::IMul32: case O::INeg32:
+    case O::BitwiseAnd32: case O::BitwiseOr32: case O::BitwiseXor32: case O::BitwiseNot32:
+    case O::IEqual: case O::INotEqual: case O::SLessThan: case O::SGreaterThan:
+    case O::SLessThanEqual: case O::SGreaterThanEqual: case O::ULessThan: case O::UGreaterThan:
+    case O::ULessThanEqual: case O::UGreaterThanEqual:
+    case O::LogicalOr: case O::LogicalAnd: case O::LogicalXor: case O::LogicalNot:
+    case O::ConvertF32S32: case O::ConvertF32U32:
+    case O::UndefU1: case O::UndefU8: case O::UndefU16: case O::UndefU32: case O::UndefU64:
+        return JitUse::Lanes;
+    default:
+        return JitUse::Call;
+    }
+}
+
+/// A run's code
+class RunEmitter : public Xbyak::CodeGenerator {
+public:
+    RunEmitter(u8* at, size_t room, const SoftwareDraw::Program& program_, const std::vector<bool>& written_)
+        : Xbyak::CodeGenerator(room, at), program{program_}, written{written_} {}
+
+    /// ops[first, last): the new ops (their addresses called out with)
+    void Emit(const Op* ops, u32 first, u32 last) {
+        using namespace Xbyak::util;
+        push(rbx), push(rbp), push(r12), push(r13), push(r14), push(r15);
+        sub(rsp, 8);
+        mov(rbx, rdi);  // the cells
+        mov(r12, rsi);  // the io
+        mov(r13d, edx); // the lanes run
+        mov(r14, reinterpret_cast<u64>(&JIT_CONSTANTS[0][0]));
+        for (u32 pc = first; pc < last;) {
+            const JitUse use = UseOf(ops[pc], written);
+            if (use == JitUse::Call) {
+                mov(rdi, reinterpret_cast<u64>(&program));
+                mov(rsi, reinterpret_cast<u64>(&ops[pc]));
+                mov(rdx, rbx);
+                mov(rcx, r12);
+                mov(r8d, r13d);
+                mov(rax, reinterpret_cast<u64>(&RunIrNative));
+                call(rax);
+                ++pc;
+                continue;
+            }
+            // a stretch of lane-wise and uniform instructions: the uniforms first (nothing in it
+            // writes what they read), then the rest four lanes at a time
+            u32 end = pc;
+            while (end < last && UseOf(ops[end], written) != JitUse::Call) {
+                ++end;
+            }
+            bool lanes = false;
+            for (u32 i = pc; i < end; ++i) {
+                if (UseOf(ops[i], written) == JitUse::Uniform) {
+                    EmitUniform(ops[i]);
+                } else {
+                    lanes = true;
                 }
             }
-            break;
-        case O::SelectU1: case O::SelectU8: case O::SelectU16: case O::SelectU32: case O::SelectF32:
-        case O::SelectU64:
-            LANE_LOOP {
-                const Lanes& source = a.w[0][i] != 0 ? b : e;
-                for (u32 k = 0; k < 4; ++k) {
-                    d.w[k][i] = source.w[k][i];
+            if (lanes) {
+                mov(r8, ptr[r12 + offsetof(Io, inputs)]);
+                mov(r9, ptr[r12 + offsetof(Io, colors)]);
+                xor_(r10d, r10d); // the four lanes' offset in a word's sixteen
+                Xbyak::Label loop;
+                L(loop);
+                cache.Reset();
+                for (u32 i = pc; i < end; ++i) {
+                    if (UseOf(ops[i], written) == JitUse::Lanes) {
+                        EmitLanes(ops[i]);
+                    }
                 }
+                add(r10, 16);
+                cmp(r10, 64);
+                jne(loop);
             }
+            pc = end;
+        }
+        add(rsp, 8);
+        pop(r15), pop(r14), pop(r13), pop(r12), pop(rbp), pop(rbx);
+        ret();
+    }
+
+private:
+    /// Which registers hold which cells' words for the four lanes at hand (all also in memory)
+    struct Cache {
+        static constexpr int REGS = 13; // xmm0..12; 13..15 are scratch
+        std::array<std::vector<u32>, REGS> keys{};
+        std::array<u32, REGS> used{};
+        u32 clock = 0;
+        void Reset() {
+            for (auto& k : keys) {
+                k.clear();
+            }
+        }
+        int Find(u32 key) const {
+            for (int r = 0; r < REGS; ++r) {
+                if (std::ranges::find(keys[r], key) != keys[r].end()) {
+                    return r;
+                }
+            }
+            return -1;
+        }
+        void Forget(u32 key) {
+            for (auto& k : keys) {
+                std::erase(k, key);
+            }
+        }
+    };
+
+    static u32 Key(u16 cell, u32 word) {
+        return u32(cell) * 4 + word;
+    }
+    Xbyak::Address Mem(u16 cell, u32 word) {
+        using namespace Xbyak::util;
+        return ptr[rbx + r10 + (u32(cell) * sizeof(Lanes) + word * LANES * 4)];
+    }
+    Xbyak::Address Const(JitConstant constant) {
+        using namespace Xbyak::util;
+        return ptr[r14 + u32(constant) * 16];
+    }
+
+    /// A register for a result, none of 'keep' (the instruction's operands)
+    Xbyak::Xmm Alloc(std::initializer_list<int> keep = {}) {
+        int best = -1;
+        for (int r = 0; r < Cache::REGS; ++r) {
+            if (std::find(keep.begin(), keep.end(), r) != keep.end()) {
+                continue;
+            }
+            if (cache.keys[r].empty()) {
+                best = r;
+                break;
+            }
+            if (best < 0 || cache.used[r] < cache.used[best]) {
+                best = r;
+            }
+        }
+        cache.keys[best].clear();
+        cache.used[best] = ++cache.clock;
+        return Xbyak::Xmm(best);
+    }
+    /// A cell's word in a register (loaded unless it's there)
+    Xbyak::Xmm Load(u16 cell, u32 word, std::initializer_list<int> keep = {}) {
+        const u32 key = Key(cell, word);
+        if (const int r = cache.Find(key); r >= 0) {
+            cache.used[r] = ++cache.clock;
+            return Xbyak::Xmm(r);
+        }
+        const Xbyak::Xmm x = Alloc(keep);
+        vmovups(x, Mem(cell, word));
+        cache.keys[x.getIdx()].push_back(key);
+        return x;
+    }
+    /// The result in 'x' is the cell's word: stored, and kept
+    void Def(u16 cell, u32 word, const Xbyak::Xmm& x) {
+        const u32 key = Key(cell, word);
+        cache.Forget(key);
+        vmovups(Mem(cell, word), x);
+        cache.keys[x.getIdx()].push_back(key);
+        cache.used[x.getIdx()] = ++cache.clock;
+    }
+
+    void EmitUniform(const Op& o) {
+        using namespace Xbyak::util;
+        const u32 index = program.cells[o.a[0]].w[0], offset = program.cells[o.a[1]].w[0];
+        const u32 words = o.op == IR::Opcode::GetCbufU32x2 ? 2 : 1;
+        for (u32 k = 0; k < words; ++k) {
+            mov(rdi, r12);
+            mov(esi, index);
+            mov(edx, offset + k * 4);
+            mov(rax, reinterpret_cast<u64>(&ReadCbufNative));
+            call(rax);
+            vmovd(xmm0, eax);
+            vpshufd(xmm0, xmm0, 0);
+            for (u32 chunk = 0; chunk < LANES / 4; ++chunk) {
+                vmovups(ptr[rbx + (u32(o.dest) * sizeof(Lanes) + k * LANES * 4 + chunk * 16)], xmm0);
+            }
+        }
+    }
+
+    void EmitLanes(const Op& o) {
+        using O = IR::Opcode;
+        using namespace Xbyak::util;
+        const auto copy = [&](u32 to_word, u16 from, u32 from_word) { // a word, shared
+            const Xbyak::Xmm x = Load(from, from_word);
+            Def(o.dest, to_word, x);
+        };
+        if (o.kind == Kind::Move) {
+            for (u32 k = 0; k < o.extra; ++k) {
+                copy(k, o.a[0], k);
+            }
+            return;
+        }
+        // the instruction's result from one or two (or three) operands
+        const auto unary = [&](auto&& body) {
+            const Xbyak::Xmm a = Load(o.a[0], 0);
+            const Xbyak::Xmm d = Alloc({a.getIdx()});
+            body(d, a);
+            Def(o.dest, 0, d);
+        };
+        const auto binary = [&](auto&& body) {
+            const Xbyak::Xmm a = Load(o.a[0], 0);
+            const Xbyak::Xmm b = Load(o.a[1], 0, {a.getIdx()});
+            const Xbyak::Xmm d = Alloc({a.getIdx(), b.getIdx()});
+            body(d, a, b);
+            Def(o.dest, 0, d);
+        };
+        const auto ternary = [&](auto&& body) {
+            const Xbyak::Xmm a = Load(o.a[0], 0);
+            const Xbyak::Xmm b = Load(o.a[1], 0, {a.getIdx()});
+            const Xbyak::Xmm e = Load(o.a[2], 0, {a.getIdx(), b.getIdx()});
+            const Xbyak::Xmm d = Alloc({a.getIdx(), b.getIdx(), e.getIdx()});
+            body(d, a, b, e);
+            Def(o.dest, 0, d);
+        };
+        // std::fmax and fmin: a NaN operand gives the other
+        const auto fmax = [&](const Xbyak::Xmm& d, const Xbyak::Xmm& a, const Xbyak::Xmm& b) {
+            vmaxps(d, a, b); // (b if either is NaN)
+            vcmpunordps(xmm15, b, b);
+            vblendvps(d, d, a, xmm15);
+        };
+        const auto fmin = [&](const Xbyak::Xmm& d, const Xbyak::Xmm& a, const Xbyak::Xmm& b) {
+            vminps(d, a, b);
+            vcmpunordps(xmm15, b, b);
+            vblendvps(d, d, a, xmm15);
+        };
+        const auto compare = [&](u8 predicate) { // 1 where it holds
+            binary([&](auto d, auto a, auto b) {
+                vcmpps(d, a, b, predicate);
+                vpsrld(d, d, 31);
+            });
+        };
+        // integer comparisons: 'swap' compares b with a, 'invert' the opposite, 'is_unsigned' with
+        // the sign bits flipped
+        const auto icompare = [&](bool equal, bool swap, bool invert, bool is_unsigned) {
+            binary([&](auto d, auto a, auto b) {
+                Xbyak::Xmm x = a, y = b;
+                if (is_unsigned) {
+                    vpxor(xmm14, a, Const(SIGN));
+                    vpxor(xmm15, b, Const(SIGN));
+                    x = xmm14, y = xmm15;
+                }
+                if (equal) {
+                    vpcmpeqd(d, x, y);
+                } else if (swap) {
+                    vpcmpgtd(d, y, x);
+                } else {
+                    vpcmpgtd(d, x, y);
+                }
+                if (invert) {
+                    vpaddd(d, d, Const(ONE_INT)); // -1 to 0, 0 to 1
+                } else {
+                    vpsrld(d, d, 31);
+                }
+            });
+        };
