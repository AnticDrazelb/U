+bool ShaderJit::Compile(SoftwareDraw::Program& program) {
+    if (full) {
+        return false;
+    }
+    const std::vector<Op>& ops = program.ops;
+    // the cells no instruction writes: constants
+    std::vector<bool> written(program.cells.size());
+    for (const Op& o : ops) {
+        if (o.kind == Kind::Ir || o.kind == Kind::Move) {
+            written[o.dest] = true;
+        }
+    }
+    // the runs worth compiling: two or more instructions done natively
+    std::vector<std::pair<u32, u32>> runs;
+    for (u32 pc = 0; pc < ops.size();) {
+        if (UseOf(ops[pc], written) == JitUse::End) {
+            ++pc;
+            continue;
+        }
+        u32 end = pc, native = 0;
+        for (; end < ops.size() && UseOf(ops[end], written) != JitUse::End; ++end) {
+            native += UseOf(ops[end], written) != JitUse::Call ? 1 : 0;
+        }
+        if (native >= 2) {
+            runs.emplace_back(pc, end);
+        }
+        pc = end;
+    }
+    if (runs.empty()) {
+        return false;
+    }
+    // the ops with a Kind::Native op before each run; jumps to a run's start go to it
+    std::vector<Op> out;
+    std::vector<u32> moved(ops.size() + 1);
+    std::vector<u32> natives; // where each Native op is
+    size_t next_run = 0;
+    for (u32 pc = 0; pc < ops.size(); ++pc) {
+        if (next_run < runs.size() && runs[next_run].first == pc) {
+            natives.push_back(u32(out.size()));
+            moved[pc] = u32(out.size());
+            out.push_back(Op{Kind::Native, {}, u16(next_run), {}, 0});
+            ++next_run;
+        } else {
+            moved[pc] = u32(out.size());
+        }
+        out.push_back(ops[pc]);
+    }
+    moved[ops.size()] = u32(out.size());
+    for (Op& o : out) {
+        if (o.kind == Kind::Jump || o.kind == Kind::JumpIfTrue || o.kind == Kind::JumpIfFalse) {
+            o.extra = moved[o.extra];
+        }
+    }
+    for (size_t r = 0; r < runs.size(); ++r) {
+        out[natives[r]].extra = moved[runs[r].second];
+    }
+    // each run's code, calling out with the new ops' addresses
+    std::vector<void*> functions;
+    for (size_t r = 0; r < runs.size(); ++r) {
+        const u32 first = natives[r] + 1, last = natives[r] + 1 + (runs[r].second - runs[r].first);
+        u8* const at = memory + used;
+        try {
+            RunEmitter emitter(at, MEMORY_SIZE - used, program, written);
+            emitter.Emit(out.data(), first, last);
+            used += (emitter.getSize() + 63) & ~size_t{63};
+        } catch (const std::exception&) { // (Xbyak's: out of room)
+            full = true;
+            LogOnce("native code memory full: software shaders interpreted from here on");
+            return false;
+        }
+        functions.push_back(at);
+    }
+    program.ops = std::move(out);
+    program.native = std::move(functions);
+    return true;
+}
