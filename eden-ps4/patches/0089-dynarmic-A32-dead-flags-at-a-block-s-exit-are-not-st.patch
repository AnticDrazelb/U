diff --git a/src/dynarmic/src/dynarmic/frontend/A32/translate/translate_arm.cpp b/src/dynarmic/src/dynarmic/frontend/A32/translate/translate_arm.cpp
index 8e5a0d54ef..a2ae74c1cb 100644
--- a/src/dynarmic/src/dynarmic/frontend/A32/translate/translate_arm.cpp
+++ b/src/dynarmic/src/dynarmic/frontend/A32/translate/translate_arm.cpp
@@ -19,9 +19,216 @@
 #include "dynarmic/frontend/A32/translate/translate_callbacks.h"
 #include "dynarmic/interface/A32/config.h"
 #include "dynarmic/ir/basic_block.h"
+#include "dynarmic/ir/terminal.h"
+
+#include <algorithm>
+#include <boost/container/static_vector.hpp>
 
 namespace Dynarmic::A32 {
 
+namespace {
+
+// The flags as a mask
+constexpr u32 FlagN = 8, FlagZ = 4, FlagC = 2, FlagV = 1, FlagsAll = 15;
+
+constexpr u32 FlagsReadByCond(u32 cond) {
+    switch (cond) {
+    case 0x0: case 0x1: return FlagZ;                  // EQ, NE
+    case 0x2: case 0x3: return FlagC;                  // CS, CC
+    case 0x4: case 0x5: return FlagN;                  // MI, PL
+    case 0x6: case 0x7: return FlagV;                  // VS, VC
+    case 0x8: case 0x9: return FlagC | FlagZ;          // HI, LS
+    case 0xA: case 0xB: return FlagN | FlagV;          // GE, LT
+    case 0xC: case 0xD: return FlagN | FlagZ | FlagV;  // GT, LE
+    default: return 0;                                 // AL
+    }
+}
+
+// Reads ARM code from a block's successor to tell whether the flags the block ends with can be
+// read there: along every path, an instruction that reads a flag not set again on that path yet
+// makes them live; one that sets them all ends the path. Branches and calls (BL) are followed to
+// their targets; anything it doesn't know (a return, a jump or call through a register, a system
+// call, a status register access...) counts as a read. A branch target reached again with no
+// more flags unset than before adds no path (a loop). A limited read: past it, live.
+struct FlagsLookahead {
+    TranslateCallbacks* tcb;
+    int budget = 64;        // instructions read, on all paths together
+    u32 lo = ~u32(0);       // the code read
+    u32 hi = 0;
+    boost::container::static_vector<std::pair<u32, u32>, 16> targets;  // (address, flags unset there)
+
+    bool Seen(u32 pc, u32 unset) {
+        for (const auto& [address, then_unset] : targets) {
+            if (address == pc && (unset & ~then_unset) == 0)
+                return true;
+        }
+        if (targets.size() < targets.capacity())
+            targets.emplace_back(pc, unset);
+        return false;
+    }
+
+    bool Live(u32 pc, u32 unset, int branches) {
+        if (Seen(pc, unset))
+            return false;
+        while (unset != 0) {
+            if (--budget < 0)
+                return true;
+            const auto word = tcb->MemoryReadCode(pc);
+            if (!word)
+                return true;
+            lo = std::min(lo, pc);
+            hi = std::max(hi, pc + 4);
+            const u32 inst = *word;
+            const u32 cond = inst >> 28;
+
+            if (cond == 0xF) {
+                if ((inst & 0xFE000000) == 0xF2000000 || (inst & 0xFF100000) == 0xF4000000 ||  // ASIMD
+                    (inst & 0xFFFFFF00) == 0xF57FF000) {  // DMB, DSB, ISB, CLREX
+                    pc += 4;
+                    continue;
+                }
+                return true;
+            }
+            if (FlagsReadByCond(cond) & unset)
+                return true;
+            const bool conditional = cond != 0xE;
+            u32 sets = 0;
+
+            switch ((inst >> 25) & 7) {
+            case 0b000:
+            case 0b001: {
+                const bool imm = (inst & 0x02000000) != 0;
+                if (!imm && (inst & 0x90) == 0x90) {
+                    // multiplies (MULS, MLAS, the long ones with S: N and Z), extra loads and stores, swaps
+                    if ((inst & 0x0F0000F0) == 0x00000090 && (inst & 0x00100000) != 0)
+                        sets = FlagN | FlagZ;
+                    break;
+                }
+                const u32 opcode = (inst >> 21) & 0xF;
+                const bool s = (inst & 0x00100000) != 0;
+                if (!s && (opcode & 0b1100) == 0b1000) {
+                    // the miscellaneous instructions in the compares' place
+                    if (imm) {
+                        if ((inst & 0x0FB00000) == 0x03000000 ||  // MOVW, MOVT
+                            (inst & 0x0FFFFF00) == 0x0320F000)    // NOP, YIELD, WFE, WFI, SEV
+                            break;
+                        return true;  // MSR (immediate)
+                    }
+                    if ((inst & 0x0FFF0FF0) == 0x016F0F10 ||  // CLZ
+                        (inst & 0x0F900FF0) == 0x01000050 ||  // QADD, QSUB, QDADD, QDSUB (the Q flag)
+                        (inst & 0x0F900090) == 0x01000080)    // halfword multiplies (the Q flag)
+                        break;
+                    return true;  // BX, BLX, MRS, MSR, BKPT, SMC...
+                }
+                if (((inst >> 12) & 0xF) == 15 && (opcode & 0b1100) != 0b1000)
+                    return true;  // to the PC: a jump somewhere (or with S, an exception return)
+                bool reads_c = opcode == 0b0101 || opcode == 0b0110 || opcode == 0b0111;  // ADC, SBC, RSC
+                if (!imm && (inst & 0x10) == 0 && (inst & 0x60) == 0x60 && (inst & 0xF80) == 0)
+                    reads_c = true;  // RRX
+                if (reads_c && (unset & FlagC))
+                    return true;
+                if (s) {
+                    const bool logical = opcode <= 0b0001 || opcode == 0b1000 || opcode == 0b1001 || opcode >= 0b1100;
+                    if (!logical) {
+                        sets = FlagsAll;
+                    } else {
+                        sets = FlagN | FlagZ;
+                        // C, when the shifter makes one: a rotated immediate, a shift by an
+                        // immediate other than LSL #0 (one by a register leaves C if it is by 0)
+                        if (imm ? (inst & 0xF00) != 0 : ((inst & 0x10) == 0 && (inst & 0xFE0) != 0))
+                            sets |= FlagC;
+                    }
+                }
+                break;
+            }
+            case 0b010:
+            case 0b011:
+                if ((inst & 0x02000010) == 0x02000010) {
+                    // media instructions: none of them sets NZCV (UDF: raises)
+                    if ((inst & 0x0FF000F0) == 0x07F000F0)
+                        return true;
+                    break;
+                }
+                if ((inst & 0x00100000) != 0 && ((inst >> 12) & 0xF) == 15)
+                    return true;  // LDR to the PC
+                break;
+            case 0b100:
+                if ((inst & 0x00400000) != 0 || (inst & 0x00108000) == 0x00108000)
+                    return true;  // LDM with the PC (a return), user registers or an exception return
+                break;
+            case 0b101: {  // B, BL (the called code read like a branch's)
+                const u32 target = pc + 8 + u32(s32(inst << 8) >> 6);
+                if (branches <= 0)
+                    return true;
+                if (!conditional) {
+                    if (Seen(target, unset))
+                        return false;
+                    pc = target;
+                    branches--;
+                    continue;
+                }
+                if (Live(target, unset, branches - 1))
+                    return true;
+                branches--;
+                break;
+            }
+            case 0b110:
+                break;  // VLDR, VSTR, VLDM, VSTM, VPUSH, VPOP (other coprocessors' loads and stores)
+            case 0b111:
+                if (inst & 0x01000000)
+                    return true;  // SVC
+                if ((inst & 0x0FFFFFFF) == 0x0EF1FA10) {  // VMRS APSR_nzcv, FPSCR
+                    sets = FlagsAll;
+                    break;
+                }
+                if ((inst & 0x0F10F010) == 0x0E10F010)
+                    return true;  // MRC to APSR_nzcv
+                break;  // VFP data processing, VMOV, VMRS, VMSR, MCR, MRC
+            }
+            if (!conditional)
+                unset &= ~sets;
+            pc += 4;
+        }
+        return false;
+    }
+};
+
+// IR::Block::nzcv_dead_at_exit for a block ending in links to ARM code
+void LookAheadForFlags(IR::Block& block, TranslateCallbacks* tcb) {
+    if (block.GetCondition() != IR::Cond::AL)
+        return;
+    boost::container::static_vector<LocationDescriptor, 2> successors;
+    const auto leaf = [&](const IR::Term::LeafTerminal& term) {
+        if (const auto* link = std::get_if<IR::Term::LinkBlock>(&term))
+            successors.push_back(LocationDescriptor{link->next});
+        else if (const auto* fast = std::get_if<IR::Term::LinkBlockFast>(&term))
+            successors.push_back(LocationDescriptor{fast->next});
+        else
+            return false;
+        return true;
+    };
+    const auto& terminal = block.GetTerminal();
+    if (const auto* if_ = std::get_if<IR::Term::If>(&terminal)) {
+        if (!leaf(if_->then_) || !leaf(if_->else_))
+            return;
+    } else if (const auto* l = std::get_if<IR::Term::LeafTerminal>(&terminal)) {
+        if (!leaf(*l))
+            return;
+    } else {
+        return;
+    }
+    FlagsLookahead lookahead{tcb};
+    for (const auto& next : successors) {
+        if (next.TFlag() || next.EFlag() || next.SingleStepping() || lookahead.Live(next.PC(), FlagsAll, 6))
+            return;
+    }
+    block.nzcv_dead_at_exit = true;
+    block.lookahead_lo = lookahead.lo;
+    block.lookahead_hi = lookahead.hi;
+}
+
+}  // namespace
+
 void TranslateArm(IR::Block& block, LocationDescriptor descriptor, TranslateCallbacks* tcb, const TranslationOptions& options) {
     const bool single_step = descriptor.SingleStepping();
     TranslatorVisitor visitor{block, descriptor, options};
@@ -79,6 +286,10 @@ void TranslateArm(IR::Block& block, LocationDescriptor descriptor, TranslateCall
     }
     ASSERT(block.HasTerminal() && "Terminal has not been set");
     block.SetEndLocation(visitor.ir.current_location);
+
+    if (options.nzcv_lookahead && !single_step) {
+        LookAheadForFlags(block, tcb);
+    }
 }
 
