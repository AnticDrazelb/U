+void EmitX64::EmitCondFlagsSub32(EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const Xbyak::Reg32 a = ctx.reg_alloc.UseGpr(code, args[0]).cvt32();
+    if (args[1].IsImmediate()) {
+        code.cmp(a, args[1].GetImmediateU32());
+    } else {
+        code.cmp(a, ctx.reg_alloc.UseGpr(code, args[1]).cvt32());
+    }
+    host_cond_flags = HostCondFlags::Sub;
+}
+
+void EmitX64::EmitCondFlagsAdd32(EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const Xbyak::Reg32 a = ctx.reg_alloc.UseScratchGpr(code, args[0]).cvt32();
+    if (args[1].IsImmediate()) {
+        code.add(a, args[1].GetImmediateU32());
+    } else {
+        code.add(a, ctx.reg_alloc.UseGpr(code, args[1]).cvt32());
+    }
+    host_cond_flags = HostCondFlags::Add;
+}
+
+void EmitX64::EmitCondFlagsTest32(EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const Xbyak::Reg32 a = ctx.reg_alloc.UseGpr(code, args[0]).cvt32();
+    if (args[1].IsImmediate()) {
+        code.test(a, args[1].GetImmediateU32());
+    } else {
+        code.test(a, ctx.reg_alloc.UseGpr(code, args[1]).cvt32());
+    }
+    host_cond_flags = HostCondFlags::Logic;
+}
+
+void EmitX64::EmitCondFlagsNZ32(EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const Xbyak::Reg32 a = ctx.reg_alloc.UseGpr(code, args[0]).cvt32();
+    code.test(a, a);
+    host_cond_flags = HostCondFlags::Logic;
+}
+
 Xbyak::Label EmitX64::EmitCond(IR::Cond cond) {
     Xbyak::Label pass;
 
+    if (host_cond_flags != HostCondFlags::None) {
+        // the host's flags as CondFlags* left them (nothing in between changes them)
+        const HostCondFlags kind = host_cond_flags;
+        host_cond_flags = HostCondFlags::None;
+        nzcv_stored_end = nullptr;
+        ASSERT(kind != HostCondFlags::Logic || cond == IR::Cond::EQ || cond == IR::Cond::NE || cond == IR::Cond::MI || cond == IR::Cond::PL);
+        ASSERT(kind != HostCondFlags::Add || (cond != IR::Cond::HI && cond != IR::Cond::LS));
+        switch (cond) {
+        case IR::Cond::EQ: code.jz(pass); break;
+        case IR::Cond::NE: code.jnz(pass); break;
+        // ARM's C after a subtraction is x64's CF inverted (no borrow); after an addition, the carry
+        case IR::Cond::CS: kind == HostCondFlags::Sub ? code.jae(pass) : code.jc(pass); break;
+        case IR::Cond::CC: kind == HostCondFlags::Sub ? code.jb(pass) : code.jnc(pass); break;
+        case IR::Cond::MI: code.js(pass); break;
+        case IR::Cond::PL: code.jns(pass); break;
+        case IR::Cond::VS: code.jo(pass); break;
+        case IR::Cond::VC: code.jno(pass); break;
+        case IR::Cond::HI: code.ja(pass); break;
+        case IR::Cond::LS: code.jbe(pass); break;
+        case IR::Cond::GE: code.jge(pass); break;
+        case IR::Cond::LT: code.jl(pass); break;
+        case IR::Cond::GT: code.jg(pass); break;
+        case IR::Cond::LE: code.jle(pass); break;
+        default: code.jmp(pass); break;
+        }
+        return pass;
+    }
+
     if (nzcv_stored_end != nullptr && nzcv_stored_end == code.getCurr() && nzcv_stored_reg >= 0) {
         // (nothing emitted since the flags were stored: the register still holds them)
         if (nzcv_stored_reg != eax.getIdx()) {
