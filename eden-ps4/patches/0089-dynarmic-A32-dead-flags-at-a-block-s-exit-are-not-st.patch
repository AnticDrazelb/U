+// A block whose flags are dead at its exit (IR::Block::nzcv_dead_at_exit) doesn't store those
+// its last flag-setting instructions make (after the last instruction that reads the flags). If it
+// ends in a conditional branch, the branch tests the values the flags came from (CondFlags*, the
+// block's last instruction: cmp; jcc on the host) instead of the stored flags; a block whose
+// branch can't (its condition needs flags the last setter didn't make, a setter with no such form)
+// is left as it was.
+static void A32DeadNZCVPass(IR::Block& block) {
+    if (!block.nzcv_dead_at_exit)
+        return;
+
+    boost::container::small_vector<IR::Inst*, 8> writes;  // the last setters, latest first
+    for (auto it = block.instructions.rbegin(); it != block.instructions.rend(); ++it) {
+        const auto op = it->GetOpcode();
+        if (op == IR::Opcode::A32SetCpsrNZCV || op == IR::Opcode::A32SetCpsrNZ || op == IR::Opcode::A32SetCpsrNZC) {
+            writes.push_back(&*it);
+            continue;
+        }
+        if (ReadsFromCPSR(op) || WritesToCPSR(op) || CausesCPUException(op))
+            break;
+    }
+    if (writes.empty())
+        return;
+
+    const IR::Term::Terminal terminal = block.GetTerminal();
+    if (const auto* if_ = std::get_if<IR::Term::If>(&terminal)) {
+        const IR::Cond cond = if_->if_;
+        const bool nz_only = cond == IR::Cond::EQ || cond == IR::Cond::NE || cond == IR::Cond::MI || cond == IR::Cond::PL;
+        IR::Inst* const last = writes.front();
+        const IR::Value flags = last->GetArg(0);
+        if (flags.IsImmediate())
+            return;
+        const IR::Inst* const flags_inst = flags.GetInst();
+        const bool all_four = last->GetOpcode() == IR::Opcode::A32SetCpsrNZCV && flags_inst->GetOpcode() == IR::Opcode::GetNZCVFromOp;
+        const bool nz = flags_inst->GetOpcode() == IR::Opcode::GetNZFromOp && last->GetOpcode() != IR::Opcode::A32SetCpsrNZCV;
+        if (!all_four && !(nz && nz_only))
+            return;
+        const IR::Value source = flags_inst->GetArg(0);
+        if (source.GetType() != IR::Type::U32)
+            return;
+        if (source.IsImmediate()) {
+            if (!nz_only)
+                return;
+            block.AppendNewInst(IR::Opcode::CondFlagsNZ32, {source});  // (a constant's)
+            for (IR::Inst* const write : writes)
+                write->Invalidate();
+            return;
+        }
+        IR::Inst* const op = source.GetInst();
+
+        IR::Opcode cond_flags;
+        boost::container::static_vector<IR::Value, 2> args;
+        const auto carry_in = [&](bool value) {
+            return op->GetArg(2).IsImmediate() && op->GetArg(2).GetU1() == value;
+        };
+        if (all_four && op->GetOpcode() == IR::Opcode::Sub32 && carry_in(true)) {
+            cond_flags = IR::Opcode::CondFlagsSub32;  // CMP, SUBS: every condition
+            args = {op->GetArg(0), op->GetArg(1)};
+        } else if (all_four && op->GetOpcode() == IR::Opcode::Add32 && carry_in(false) &&
+                   cond != IR::Cond::HI && cond != IR::Cond::LS) {
+            cond_flags = IR::Opcode::CondFlagsAdd32;  // CMN, ADDS: every condition but HI and LS
+            args = {op->GetArg(0), op->GetArg(1)};
+        } else if (!nz_only) {
+            return;
+        } else if (op->GetOpcode() == IR::Opcode::And32 && op->UseCount() == 1) {
+            cond_flags = IR::Opcode::CondFlagsTest32;  // TST: N and Z
+            args = {op->GetArg(0), op->GetArg(1)};
+        } else if (nz || op->GetOpcode() == IR::Opcode::Sub32 || op->GetOpcode() == IR::Opcode::Add32) {
+            cond_flags = IR::Opcode::CondFlagsNZ32;  // N and Z of the result
+            args = {source};
+        } else {
+            return;
+        }
+
+        if (args.size() == 2)
+            block.AppendNewInst(cond_flags, {args[0], args[1]});
+        else
+            block.AppendNewInst(cond_flags, {args[0]});
+    }
+
+    for (IR::Inst* const write : writes)
+        write->Invalidate();
+}
