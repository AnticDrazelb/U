+                vpsrld(d, d, 31);
+            });
+            break;
+        case O::LogicalNot:
+            unary([&](auto d, auto a) {
+                vpcmpeqd(d, a, Const(ZERO));
+                vpsrld(d, d, 31);
+            });
+            break;
         case O::IEqual: icompare(true, false, false, false); break;
         case O::INotEqual: icompare(true, false, true, false); break;
         case O::SLessThan: icompare(false, true, false, false); break;
@@ -4210,6 +4258,136 @@ void RunLanes(const SoftwareDraw::Program& program, Lanes* c, Io& io, u32 n) {
 #undef IO_LOOP
 #undef LANE_LOOP
 
+void Run(const SoftwareDraw::Program& program, Lanes* c, Io& io, u32 n);
+
+#ifdef SOFTWARE_JIT
+/// With EDEN_SW_JIT_TEST set: each instruction native code does, compiled and run on awkward values
+/// (NaNs, infinities, zeros of both signs, denormals, the integers at the edges), its results
+/// against the interpreter's; how many differ is logged, and the first few
+void JitSelfTest(ShaderJit& jit) {
+    using O = IR::Opcode;
+    static constexpr O tested[] = {
+        O::GetAttribute, O::SetFragColor, O::CompositeConstructF32x2, O::CompositeConstructU32x3,
+        O::CompositeConstructF32x4, O::CompositeExtractF32x4, O::BitCastU32F32, O::BitCastU64F64,
+        O::SelectU32, O::SelectF32, O::SelectU64, O::FPAbs32, O::FPAdd32, O::FPFma32, O::FPMax32,
+        O::FPMin32, O::FPMul32, O::FPNeg32, O::FPRecip32, O::FPRecipSqrt32, O::FPSqrt,
+        O::FPSaturate32, O::FPClamp32, O::FPRoundEven32, O::FPFloor32, O::FPCeil32, O::FPTrunc32,
+        O::FPOrdEqual32, O::FPUnordEqual32, O::FPOrdNotEqual32, O::FPUnordNotEqual32,
+        O::FPOrdLessThan32, O::FPUnordLessThan32, O::FPOrdGreaterThan32, O::FPUnordGreaterThan32,
+        O::FPOrdLessThanEqual32, O::FPUnordLessThanEqual32, O::FPOrdGreaterThanEqual32,
+        O::FPUnordGreaterThanEqual32, O::FPIsNan32, O::IAdd32, O::ISub32, O::IMul32, O::INeg32,
+        O::BitwiseAnd32, O::BitwiseOr32, O::BitwiseXor32, O::BitwiseNot32, O::IEqual, O::INotEqual,
+        O::SLessThan, O::SGreaterThan, O::SLessThanEqual, O::SGreaterThanEqual, O::ULessThan,
+        O::UGreaterThan, O::ULessThanEqual, O::UGreaterThanEqual, O::LogicalOr, O::LogicalAnd,
+        O::LogicalXor, O::LogicalNot, O::ShiftLeftLogical32, O::ShiftRightLogical32,
+        O::ShiftRightArithmetic32, O::ConvertF32S32, O::ConvertF32U32, O::UndefU32,
+    };
+    static constexpr u32 awkward[] = {
+        0x00000000u, 0x80000000u, 0x3F800000u, 0xBF800000u, 0x7F800000u, 0xFF800000u, 0x7FC00000u,
+        0xFFC00001u, 0x7F800001u, 0x00000001u, 0x807FFFFFu, 0x3F000000u, 0x4B000001u, 0xCAFFFFFFu,
+        0x7FFFFFFFu, 0xFFFFFFFFu, 31, 32, 1, 0x00010000u, 0x4F800000u, 0x3FC00000u, 0xBFC00000u,
+    };
+    std::mt19937 rng(20261029);
+    const auto random_value = [&] {
+        switch (rng() % 3) {
+        case 0: return awkward[rng() % std::size(awkward)];
+        case 1: return std::bit_cast<u32>(std::uniform_real_distribution<f32>(-1000.0f, 1000.0f)(rng));
+        default: return u32(rng());
+        }
+    };
+    const auto words_of = [](O op) -> u32 {
+        switch (op) {
+        case O::CompositeConstructF32x2: case O::BitCastU64F64: case O::SelectU64: return 2;
+        case O::CompositeConstructU32x3: return 3;
+        case O::CompositeConstructF32x4: case O::UndefU32: return 4;
+        default: return 1;
+        }
+    };
+    const auto same = [](u32 a, u32 b) { // bit for bit, or both NaN, or both zero
+        const f32 fa = std::bit_cast<f32>(a), fb = std::bit_cast<f32>(b);
+        return a == b || (std::isnan(fa) && std::isnan(fb)) || (fa == 0.0f && fb == 0.0f);
+    };
+    u32 checked = 0, failures = 0;
+    std::vector<f32> inputs(256 * LANES), colors_native(32 * LANES), colors_interpreted(32 * LANES);
+    std::array<bool, LANES> discard{};
+    const std::array<std::vector<u32>, 18> cbufs{};
+    for (const O op : tested) {
+        for (u32 round = 0; round < 12; ++round) {
+            // cells: 0..2 the operands' sources, 3..5 the operands (written by moves: not
+            // constants), 6 and 7 the results, 8 a constant (shift counts)
+            SoftwareDraw::Program program;
+            program.ok = true;
+            program.cells.resize(9);
+            program.cells[8].w[0] = round * 3;
+            const u32 extra = op == O::CompositeExtractF32x4 ? 1 + round % 4
+                              : op == O::GetAttribute    ? 40 + round
+                              : op == O::SetFragColor    ? round % 32
+                                                         : 0;
+            const bool shift = op == O::ShiftLeftLogical32 || op == O::ShiftRightLogical32 ||
+                               op == O::ShiftRightArithmetic32;
+            const std::array<u16, 4> args{3, u16(shift ? 8 : 4), 5, 3};
+            program.ops = {
+                Op{Kind::Move, {}, 3, {0}, 4}, Op{Kind::Move, {}, 4, {1}, 4}, Op{Kind::Move, {}, 5, {2}, 4},
+                Op{Kind::Ir, op, 6, args, extra}, Op{Kind::Ir, op, 7, {5, u16(shift ? 8 : 3), 4, 5}, extra},
+                Op{Kind::Return, {}, 0, {}, 0},
+            };
+            SoftwareDraw::Program native = program;
+            if (!jit.Compile(native) || native.native.empty()) {
+                LOG_WARNING(Render, "Software draw: native code self-test: {} not compiled", op);
+                ++failures;
+                break;
+            }
+            std::vector<Lanes> cells;
+            Broadcast(program.cells, cells);
+            for (u32 cell = 0; cell < 3; ++cell) {
+                for (u32 k = 0; k < 4; ++k) {
+                    for (u32 i = 0; i < LANES; ++i) {
+                        cells[cell].w[k][i] = random_value();
+                    }
+                }
+            }
+            for (f32& input : inputs) {
+                input = std::bit_cast<f32>(random_value());
+            }
+            std::vector<Lanes> interpreted_cells = cells;
+            std::fill(colors_native.begin(), colors_native.end(), 0.0f);
+            std::fill(colors_interpreted.begin(), colors_interpreted.end(), 0.0f);
+            Io io{inputs.data(), nullptr, colors_native.data(), discard.data(), LANES, 0, &cbufs, nullptr, 0,
+                  nullptr, nullptr, nullptr};
+            io.run = io.live = 0xFFFF;
+            io.quads = true;
+            Io interpreted_io = io;
+            interpreted_io.colors = colors_interpreted.data();
+            Run(native, cells.data(), io, LANES);
+            Run(program, interpreted_cells.data(), interpreted_io, LANES);
+            bool ok = true;
+            for (u32 cell = 6; cell < 8; ++cell) {
+                for (u32 k = 0; k < words_of(op); ++k) {
+                    for (u32 i = 0; i < LANES; ++i) {
+                        const u32 a = cells[cell].w[k][i], b = interpreted_cells[cell].w[k][i];
+                        if (!same(a, b)) {
+                            if (ok && failures < 16) {
+                                LOG_WARNING(Render, "Software draw: native code self-test: {} gives {:#010x}, the "
+                                            "interpreter {:#010x} (operands {:#010x} {:#010x} {:#010x})",
+                                            op, a, b, interpreted_cells[3].w[0][i], interpreted_cells[4].w[0][i],
+                                            interpreted_cells[5].w[0][i]);
+                            }
+                            ok = false;
+                        }
+                    }
+                }
+            }
+            for (size_t i = 0; i < colors_native.size(); ++i) {
+                ok &= same(std::bit_cast<u32>(colors_native[i]), std::bit_cast<u32>(colors_interpreted[i]));
+            }
+            failures += ok ? 0 : 1;
+            ++checked;
+        }
+    }
+    LOG_WARNING(Render, "Software draw: native code self-test: {} of {} differ", failures, checked);
+}
+#endif
