                                      type == T::Color3D ? level.depth : array && type != T::ColorArray1D ? layers : 0,
                                      texture->num_levels};
                 std::memcpy(result.data(), dims, sizeof(dims));
@@ -3937,11 +3956,40 @@ private:
                 vpsubd(d, d, a);
             });
             break;
-        case O::BitwiseAnd32: case O::LogicalAnd: binary([&](auto d, auto a, auto b) { vpand(d, a, b); }); break;
-        case O::BitwiseOr32: case O::LogicalOr: binary([&](auto d, auto a, auto b) { vpor(d, a, b); }); break;
-        case O::BitwiseXor32: case O::LogicalXor: binary([&](auto d, auto a, auto b) { vpxor(d, a, b); }); break;
+        case O::BitwiseAnd32: binary([&](auto d, auto a, auto b) { vpand(d, a, b); }); break;
+        case O::BitwiseOr32: binary([&](auto d, auto a, auto b) { vpor(d, a, b); }); break;
+        case O::BitwiseXor32: binary([&](auto d, auto a, auto b) { vpxor(d, a, b); }); break;
         case O::BitwiseNot32: unary([&](auto d, auto a) { vpxor(d, a, Const(ALL_ONES)); }); break;
-        case O::LogicalNot: unary([&](auto d, auto a) { vpxor(d, a, Const(ONE_INT)); }); break;
+        // the logical ones as the interpreter's: any value but 0 true (each operand's "is 0" first)
+        case O::LogicalOr:
+            binary([&](auto d, auto a, auto b) {
+                vpor(d, a, b);
+                vpcmpeqd(d, d, Const(ZERO));
+                vpaddd(d, d, Const(ONE_INT));
+            });
+            break;
+        case O::LogicalAnd:
