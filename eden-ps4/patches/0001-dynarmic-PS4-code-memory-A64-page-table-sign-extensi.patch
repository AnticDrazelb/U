From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eden PS4 <eden-ps4@localhost>
Date: Tue, 27 Oct 2026 20:36:11 +0000
Subject: [PATCH] dynarmic: PS4 code memory, A64 page table sign extension

The A64 x86-64 backend shifts the page table entry by the sign bit itself
instead of 63 - bit (as the A32 lookup and the arm64 backend do), which
keeps only bits the attribute mask has already cleared: every lookup is 0
and every guest load and store takes the slow path.

The PS4 only runs code from memory mapped executable to begin with:
xbyak's code memory is mapped read/write/execute once.
---
 .../dynarmic/backend/x64/block_of_code.cpp    |  2 +-
 .../dynarmic/backend/x64/emit_x64_memory.h    |  7 +++-
 src/dynarmic/src/dynarmic/backend/x64/xbyak.h | 39 +++++++++++++++++++
 .../src/dynarmic/common/spin_lock_x64.cpp     |  6 ++-
 4 files changed, 50 insertions(+), 4 deletions(-)

diff --git a/src/dynarmic/src/dynarmic/backend/x64/block_of_code.cpp b/src/dynarmic/src/dynarmic/backend/x64/block_of_code.cpp
index 384d6203a..8de966090 100644
--- a/src/dynarmic/src/dynarmic/backend/x64/block_of_code.cpp
+++ b/src/dynarmic/src/dynarmic/backend/x64/block_of_code.cpp
@@ -149,7 +149,7 @@ BlockOfCode::BlockOfCode(RunCodeCallbacks cb, JitStateInfo jsi, size_t total_cod
 #else
         , nullptr //Allow RWE
 #endif
-        , nullptr)
+        , DYNARMIC_CODE_ALLOCATOR)
     , constant_pool(*this, CONSTANT_POOL_SIZE)
     , jsi(jsi)
     , cb(std::move(cb))
diff --git a/src/dynarmic/src/dynarmic/backend/x64/emit_x64_memory.h b/src/dynarmic/src/dynarmic/backend/x64/emit_x64_memory.h
index d072b9963..6ad6d273f 100644
--- a/src/dynarmic/src/dynarmic/backend/x64/emit_x64_memory.h
+++ b/src/dynarmic/src/dynarmic/backend/x64/emit_x64_memory.h
@@ -184,8 +184,11 @@ template<>
     }
     // check for sign bit, apply sign extension as needed
     if (ctx.conf.page_table_sign_extension) {
-        code.shl(page, *ctx.conf.page_table_sign_extension);
-        code.sar(page, *ctx.conf.page_table_sign_extension);
+        // sign-extend from that bit, as the A32 lookup above and the arm64 backend do (shifting by
+        // the bit index itself kept only the low bits, which the mask has cleared: every lookup
+        // then took the slow path)
+        code.shl(page, 63 - int(*ctx.conf.page_table_sign_extension));
+        code.sar(page, 63 - int(*ctx.conf.page_table_sign_extension));
     }
 
     code.jz(abort, code.T_NEAR);
diff --git a/src/dynarmic/src/dynarmic/backend/x64/xbyak.h b/src/dynarmic/src/dynarmic/backend/x64/xbyak.h
index 9dc67f377..209e03802 100644
--- a/src/dynarmic/src/dynarmic/backend/x64/xbyak.h
+++ b/src/dynarmic/src/dynarmic/backend/x64/xbyak.h
@@ -12,3 +12,42 @@
 #define XBYAK_STD_UNORDERED_MULTIMAP boost::unordered_multimap
 #include <xbyak/xbyak.h>
 #include <xbyak/xbyak_util.h>
+
+#if defined(__ORBIS__) || defined(DYNARMIC_RWX_CODE_ALLOCATOR)
+#    include <sys/mman.h>
+#    include <mutex>
+#    include <unordered_map>
+namespace Dynarmic::Backend::X64 {
+/// Code memory for systems that only make memory executable if it is mapped so (the PS4: an
+/// mprotect to add PROT_EXEC fails, and the runtime serves executable mappings from a pool that
+/// can run code). The buffer is mapped read/write/execute once and never re-protected.
+struct RWXCodeAllocator final : Xbyak::Allocator {
+    uint8_t* alloc(size_t size) override {
+        size = (size + 0x3FFF) & ~size_t(0x3FFF);
+        void* p = mmap(nullptr, size, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANON, -1, 0);
+        if (p == MAP_FAILED)
+            return nullptr;
+        std::lock_guard lock{mutex};
+        sizes[p] = size;
+        return static_cast<uint8_t*>(p);
+    }
+    void free(uint8_t* p) override {
+        std::lock_guard lock{mutex};
+        if (auto it = sizes.find(p); it != sizes.end()) {
+            munmap(p, it->second);
+            sizes.erase(it);
+        }
+    }
+    bool useProtect() const override { return false; }
+    std::mutex mutex;
+    std::unordered_map<void*, size_t> sizes;
+};
+inline Xbyak::Allocator* CodeAllocator() {
+    static RWXCodeAllocator allocator;
+    return &allocator;
+}
+}  // namespace Dynarmic::Backend::X64
+#    define DYNARMIC_CODE_ALLOCATOR (::Dynarmic::Backend::X64::CodeAllocator())
+#else
+#    define DYNARMIC_CODE_ALLOCATOR nullptr
+#endif
diff --git a/src/dynarmic/src/dynarmic/common/spin_lock_x64.cpp b/src/dynarmic/src/dynarmic/common/spin_lock_x64.cpp
index f1898a92e..cb2ecf007 100644
--- a/src/dynarmic/src/dynarmic/common/spin_lock_x64.cpp
+++ b/src/dynarmic/src/dynarmic/common/spin_lock_x64.cpp
@@ -78,7 +78,7 @@ namespace {
 struct SpinLockImpl {
     void Initialize() noexcept;
     static void GlobalInitialize() noexcept;
-    Xbyak::CodeGenerator code = Xbyak::CodeGenerator(4096, default_cg_mode);
+    Xbyak::CodeGenerator code = Xbyak::CodeGenerator(4096, default_cg_mode, DYNARMIC_CODE_ALLOCATOR);
     void (*lock)(volatile int*) = nullptr;
     void (*unlock)(volatile int*) = nullptr;
 };
@@ -91,7 +91,9 @@ std::optional<SpinLockImpl> impl;
 
 void SpinLockImpl::Initialize() noexcept {
     // Needed for W^X systems (i.e SElinux, OpenBSD)
+#if !defined(__ORBIS__) && !defined(DYNARMIC_RWX_CODE_ALLOCATOR)
     code.setProtectMode(Xbyak::CodeArray::ProtectMode::PROTECT_RW);
+#endif
     Xbyak::Reg64 const ABI_PARAM1 = Backend::X64::HostLocToReg64(Backend::X64::ABI_PARAM1);
     code.align();
     lock = code.getCurr<void (*)(volatile int*)>();
@@ -101,7 +103,9 @@ void SpinLockImpl::Initialize() noexcept {
     unlock = code.getCurr<void (*)(volatile int*)>();
     EmitSpinLockUnlock(code, ABI_PARAM1, code.eax);
     code.ret();
+#if !defined(__ORBIS__) && !defined(DYNARMIC_RWX_CODE_ALLOCATOR)
     code.setProtectMode(Xbyak::CodeArray::ProtectMode::PROTECT_RE);
+#endif
 }
 
 void SpinLockImpl::GlobalInitialize() noexcept {
