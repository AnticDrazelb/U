@@ -3150,9 +3156,11 @@ bool DepthPasses(Maxwell::Regs::ComparisonOp op, u32 incoming, u32 stored) {
 
 // ---- the draw
 
+constexpr u32 POINT_COORD_SLOT = 128; // where a vertex keeps a point's corner's coordinates
+
 struct Vertex {
     std::array<f32, 4> position; // clip space
-    std::array<f32, 128> varyings; // generic 0..31, xyzw
+    std::array<f32, 130> varyings; // generic 0..31, xyzw; then the point coordinates (s, t)
     f32 point_size;
 };
 
