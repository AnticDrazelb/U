+    const f32 bias_units = regs.depth_bias * 0.5f * bias_step, bias_slope = regs.slope_scale_depth_bias;
+    const f32 bias_clamp = regs.depth_bias_clamp;
     const auto add_triangle = [&](const ScreenVertex& a, const ScreenVertex& b, const ScreenVertex& c,
-                                  bool cullable = true) {
+                                  bool cullable = true, bool biased = false) {
