     const auto& regs{maxwell3d->regs};
     const bool via_header_index{regs.sampler_binding == Maxwell::SamplerBinding::ViaHeaderBinding};
+    // (PS4 04.16) The texture handles a draw reads from constant buffers sit next to each other:
+    // the last GPU page's host pointer kept for this draw, instead of translating the address
+    // (a page table walk) for every handle. A GPU page's 4 KiB are one device page, one host range.
+    GPUVAddr handle_page{~GPUVAddr{0}};
+    const u8* handle_page_host{};
+    const auto read_u32{[&](GPUVAddr addr) LAMBDA_FORCEINLINE {
+        const GPUVAddr page{addr & ~GPUVAddr{0xFFF}};
+        if (page != handle_page) {
+            handle_page = page;
+            handle_page_host = gpu_memory->GetPointer(page);
+        }
+        if (handle_page_host == nullptr || (addr & 0xFFF) > 0xFFC) [[unlikely]] {
+            return gpu_memory->Read<u32>(addr);
+        }
+        u32 value;
+        std::memcpy(&value, handle_page_host + (addr & 0xFFF), sizeof(value));
+        return value;
+    }};
     const auto config_stage{[&](size_t stage) LAMBDA_FORCEINLINE {
         const Shader::Info& info{stage_infos[stage]};
         buffer_cache.UnbindGraphicsStorageBuffers(stage);
