+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+// The PS4 profiler's map of recompiled blocks (port/ps4_sampler.cpp): which guest block a sampled
+// host address belongs to, and the hottest blocks' code, guest and host, for hotblocks.log. Kept
+// only while the profiler is on (dynarmic_ps4_block_map_enable).
+
+#include <cstddef>
+#include <cstdint>
+
+namespace Dynarmic::Backend::X64::Ps4BlockMap {
+
+enum class Kind : std::uint8_t { A32 = 0, A64 = 1 };
+
+#ifdef __OPENORBIS__
+/// A code cache's blocks from now on (its emitter's), whose guest code `callbacks` reads
+void Attach(const void* cache, std::size_t cache_size, Kind kind, void* callbacks);
+/// Its blocks forgotten (the cache cleared, or the emitter gone)
+void Clear(const void* cache, bool detach);
+void Register(const void* cache, const void* host, std::size_t host_size, std::uint64_t descriptor,
+              std::size_t guest_size);
+#else
+inline void Attach(const void*, std::size_t, Kind, void*) {}
+inline void Clear(const void*, bool) {}
+inline void Register(const void*, const void*, std::size_t, std::uint64_t, std::size_t) {}
+#endif
+
+}  // namespace Dynarmic::Backend::X64::Ps4BlockMap
