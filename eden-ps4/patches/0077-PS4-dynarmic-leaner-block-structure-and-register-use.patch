+        && e.conf.HasOptimization(OptimizationFlag::BlockLinking) && !is_single_step
+        && A32::LocationDescriptor{terminal.next}.PC() > A32::LocationDescriptor{initial_location}.PC()
+        && (terminal.next.Value() >> 32) == (initial_location.Value() >> 32)) {
+        return EmitTerminalImpl(e, IR::Term::LinkBlockFast{terminal.next}, initial_location, is_single_step);
+    }
     e.EmitSetUpperLocationDescriptor(terminal.next, initial_location);
     if (!e.conf.HasOptimization(OptimizationFlag::BlockLinking) || is_single_step) {
         e.code.mov(MJitStateReg(A32::Reg::PC), A32::LocationDescriptor{terminal.next}.PC());
@@ -1214,6 +1234,25 @@ bool EmitTerminalImpl(A32EmitX64& e, IR::Term::LinkBlockFast terminal, IR::Locat
 bool EmitTerminalImpl(A32EmitX64& e, IR::Term::PopRSBHint, IR::LocationDescriptor, bool is_single_step) {
     if (!e.conf.HasOptimization(OptimizationFlag::ReturnStackBuffer) || is_single_step) {
         e.code.ReturnFromRunCode();
+    } else if (e.conf.inline_rsb_pop) {
+        // terminal_handler_pop_rsb_hint, here: this return's own indirect jump, which the host's
+        // branch predictor learns on its own, instead of the one all returns share
+        auto& code = e.code;
+        code.mov(ebx, dword[code.ABI_JIT_PTR + offsetof(A32JitState, upper_location_descriptor)]);
+        code.shl(rbx, 32);
+        code.mov(ecx, MJitStateReg(A32::Reg::PC));
+        code.or_(rbx, rcx);
+        code.mov(eax, dword[code.ABI_JIT_PTR + offsetof(A32JitState, rsb_ptr)]);
+        code.sub(eax, 1);
+        code.and_(eax, u32(A32JitState::RSB_PTR_MASK));
+        code.mov(dword[code.ABI_JIT_PTR + offsetof(A32JitState, rsb_ptr)], eax);
+        code.cmp(rbx, qword[code.ABI_JIT_PTR + offsetof(A32JitState, rsb_location_descriptors) + rax * sizeof(u64)]);
+        if (e.conf.HasOptimization(OptimizationFlag::FastDispatch)) {
+            code.jne(e.terminal_handler_fast_dispatch_hint);
+        } else {
+            code.jne(code.GetReturnFromRunCodeAddress());
+        }
+        code.jmp(qword[code.ABI_JIT_PTR + offsetof(A32JitState, rsb_codeptrs) + rax * sizeof(u64)]);
     } else {
         e.code.jmp(e.terminal_handler_pop_rsb_hint);
     }
