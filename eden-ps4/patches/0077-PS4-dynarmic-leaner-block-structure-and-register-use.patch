+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// The PS4 profiler's map of recompiled blocks: port/ps4_sampler.cpp asks which guest block a
+// sampled host address is in (ps4_jit_block) and has the hottest written out (ps4_jit_dump_function,
+// to ps4_jit_dump_path's hotblocks.log, which the log bundle includes): each block's guest
+// location, its guest code (words, through the JIT's callbacks) and its host code (bytes), for
+// offline disassembly.
+
+#include "dynarmic/backend/x64/ps4_block_map.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <vector>
+
+#include <unistd.h>
+
+#include "dynarmic/interface/A32/config.h"
+#include "dynarmic/interface/A64/config.h"
+
+namespace Dynarmic::Backend::X64::Ps4BlockMap {
+namespace {
+
+std::atomic<bool> enabled{false};
+
+struct Entry {
+    std::uint32_t offset;      // host code, from the cache's start
+    std::uint16_t host_size;   // bytes (at most 65535)
+    std::uint16_t guest_size;  // bytes (at most 65535)
+    std::uint64_t descriptor;  // the guest location (IR::LocationDescriptor's value)
+};
+
+struct Cache {
+    const std::uint8_t* base;
+    Kind kind;
+    void* callbacks;
+    std::vector<Entry> entries;  // in address order: a cache fills upwards until cleared
+};
+
+std::mutex mutex;
+std::vector<Cache> caches;
+
+Cache* Find(const void* cache) {
+    for (Cache& c : caches)
+        if (c.base == cache)
+            return &c;
+    return nullptr;
+}
+
+// The cache and block a host address is in
+bool Lookup(std::uint64_t rip, const Cache*& cache, const Entry*& entry) {
+    for (const Cache& c : caches) {
+        const std::uint64_t base = reinterpret_cast<std::uint64_t>(c.base);
+        if (rip < base || c.entries.empty())
+            continue;
+        const std::uint64_t offset = rip - base;
+        auto it = std::upper_bound(c.entries.begin(), c.entries.end(), offset,
+                                   [](std::uint64_t o, const Entry& e) { return o < e.offset; });
+        if (it == c.entries.begin())
+            continue;
+        --it;
+        if (offset < std::uint64_t(it->offset) + it->host_size) {
+            cache = &c;
+            entry = &*it;
+            return true;
+        }
+    }
+    return false;
+}
+
+void Write(int fd, const char* text, std::size_t length) {
+    while (length > 0) {
+        const ssize_t written = write(fd, text, length);
+        if (written <= 0)
+            return;
+        text += written;
+        length -= std::size_t(written);
+    }
+}
+
+}  // namespace
+
+void Attach(const void* cache, std::size_t, Kind kind, void* callbacks) {
+    std::lock_guard lock{mutex};
+    if (Cache* c = Find(cache)) {
+        c->kind = kind;
+        c->callbacks = callbacks;
+        c->entries.clear();
+        return;
+    }
+    caches.push_back({static_cast<const std::uint8_t*>(cache), kind, callbacks, {}});
+}
+
+void Clear(const void* cache, bool detach) {
+    std::lock_guard lock{mutex};
+    for (auto it = caches.begin(); it != caches.end(); ++it) {
+        if (it->base != cache)
+            continue;
+        if (detach)
+            caches.erase(it);
+        else
+            std::vector<Entry>{}.swap(it->entries);
+        return;
+    }
+}
+
+void Register(const void* cache, const void* host, std::size_t host_size, std::uint64_t descriptor,
+              std::size_t guest_size) {
+    if (!enabled.load(std::memory_order_relaxed))
+        return;
+    std::lock_guard lock{mutex};
+    Cache* c = Find(cache);
+    if (!c)
+        return;
+    const std::uint64_t offset = std::uint64_t(static_cast<const std::uint8_t*>(host) - c->base);
+    if (offset >> 32)
+        return;
+    // a block below the last: the cache was cleared and refilled (drop what it overwrote)
+    while (!c->entries.empty() && c->entries.back().offset >= offset)
+        c->entries.pop_back();
+    c->entries.push_back({std::uint32_t(offset), std::uint16_t(std::min<std::size_t>(host_size, 0xFFFF)),
+                          std::uint16_t(std::min<std::size_t>(guest_size, 0xFFFF)), descriptor});
+}
+
+}  // namespace Dynarmic::Backend::X64::Ps4BlockMap
+
+using namespace Dynarmic::Backend::X64::Ps4BlockMap;
+
+// The launcher: the map kept while the profiler is on (from before the program boots)
+extern "C" void dynarmic_ps4_block_map_enable(int on) {
+    enabled.store(on != 0);
+    if (!on) {
+        std::lock_guard lock{mutex};
+        for (Cache& c : caches)
+            std::vector<Entry>{}.swap(c.entries);
+    }
+}
+
+// The sampler: the guest block a JIT address is in (its location: an A32 PC in the low 32 bits,
+// the Thumb flag in bit 32; an A64 PC in the low 56), and where its host code starts
+extern "C" int ps4_jit_block(std::uint64_t rip, std::uint64_t* guest, std::uint64_t* host_start, int* kind) {
+    std::lock_guard lock{mutex};
+    const Cache* cache;
+    const Entry* entry;
+    if (!Lookup(rip, cache, entry))
+        return 0;
+    *guest = entry->descriptor;
+    *host_start = reinterpret_cast<std::uint64_t>(cache->base) + entry->offset;
+    *kind = int(cache->kind);
+    return 1;
+}
+
+// Older sampler builds: the same, the guest location cut to 32 bits
+extern "C" int ps4_jit_owner(std::uint64_t rip, std::uint32_t* guest, std::uint64_t* host_start) {
+    std::uint64_t g;
+    int kind;
+    if (!ps4_jit_block(rip, &g, host_start, &kind))
+        return 0;
+    *guest = std::uint32_t(g);
+    return 1;
+}
+
+extern "C" const char* ps4_jit_dump_path(void) {
+    return "/data/eden-ps4/hotblocks.log";
+}
+
+// One hot block, as text: its location and share, its guest code (32-bit words) and its host code
+// (bytes), 32 a line
+extern "C" void ps4_jit_dump_function(int fd, std::uint32_t, std::uint64_t host_start, std::uint32_t samples) {
+    std::lock_guard lock{mutex};
+    const Cache* cache;
+    const Entry* entry;
+    if (!Lookup(host_start, cache, entry))
+        return;
+    char line[160];
+    const bool a64 = cache->kind == Kind::A64;
+    const std::uint64_t pc = a64 ? (entry->descriptor & ((std::uint64_t(1) << 56) - 1)) : (entry->descriptor & 0xFFFFFFFF);
+    const bool thumb = !a64 && ((entry->descriptor >> 32) & 1);
+    int n = std::snprintf(line, sizeof(line), "\nblock %s pc 0x%llx%s: %u samples, %u guest bytes, %u host bytes at 0x%llx (location %016llx)\n",
+                          a64 ? "a64" : "a32", (unsigned long long)pc, thumb ? " thumb" : "", samples,
+                          unsigned(entry->guest_size), unsigned(entry->host_size), (unsigned long long)host_start,
+                          (unsigned long long)entry->descriptor);
+    Write(fd, line, std::size_t(n));
+    // the guest code (the instructions the block was recompiled from), as they read now
+    const std::size_t guest_words = std::min<std::size_t>((entry->guest_size + 3) / 4, 96);
+    for (std::size_t i = 0; i < guest_words; i += 8) {
+        n = std::snprintf(line, sizeof(line), "guest");
+        for (std::size_t j = i; j < std::min(guest_words, i + 8); j++) {
+            std::optional<std::uint32_t> word;
+            const std::uint64_t address = (pc & ~std::uint64_t(3)) + 4 * j;
+            if (a64)
+                word = static_cast<Dynarmic::A64::UserCallbacks*>(cache->callbacks)->PeekCode(address);
+            else
+                word = static_cast<Dynarmic::A32::UserCallbacks*>(cache->callbacks)->PeekCode(std::uint32_t(address));
+            n += std::snprintf(line + n, sizeof(line) - std::size_t(n), word ? " %08x" : " --------", word ? *word : 0u);
+        }
+        line[n++] = '\n';
+        Write(fd, line, std::size_t(n));
+    }
+    // the host code, through a copy (the kernel never reads JIT memory for the write)
+    const std::size_t host_bytes = std::min<std::size_t>(entry->host_size, 2048);
+    std::uint8_t copy[2048];
+    std::memcpy(copy, reinterpret_cast<const void*>(host_start), host_bytes);
+    for (std::size_t i = 0; i < host_bytes; i += 32) {
+        n = std::snprintf(line, sizeof(line), "host ");
+        for (std::size_t j = i; j < std::min(host_bytes, i + 32); j++)
+            n += std::snprintf(line + n, sizeof(line) - std::size_t(n), "%02x", copy[j]);
+        line[n++] = '\n';
+        Write(fd, line, std::size_t(n));
+    }
+}
+
+// The crash log and the hang dump (a thread stopped in JIT code): the guest block it is in, while
+// the profiler is on (the map is empty otherwise). From a signal handler: nothing if the map is busy.
+extern "C" void ps4_crash_jit_info(int fd, std::uint64_t rip, int brief) {
+    std::unique_lock lock{mutex, std::try_to_lock};
+    if (!lock.owns_lock())
+        return;
+    const Cache* cache;
+    const Entry* entry;
+    if (!Lookup(rip, cache, entry))
+        return;
+    const bool a64 = cache->kind == Kind::A64;
+    const std::uint64_t host = reinterpret_cast<std::uint64_t>(cache->base) + entry->offset;
+    char line[160];
+    const int n = std::snprintf(line, sizeof(line), "%sjit block: %s location %016llx, host code +0x%llx of %u bytes\n",
+                                brief ? "    " : "", a64 ? "a64" : "a32", (unsigned long long)entry->descriptor,
+                                (unsigned long long)(rip - host), unsigned(entry->host_size));
+    Write(fd, line, std::size_t(n));
+}
