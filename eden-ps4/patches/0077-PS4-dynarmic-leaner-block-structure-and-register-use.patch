@@ -340,6 +340,7 @@ void RegAlloc::HostCall(
         return ret;
     }();
 
+    in_host_call = true;
     ScratchGpr(code, ABI_RETURN);
     if (result_def)
         DefineValueImpl(code, result_def, ABI_RETURN);
@@ -358,6 +359,7 @@ void RegAlloc::HostCall(
             LocInfo(HostLoc(i)).WriteLock();
         }
     }
+    in_host_call = false;
     for (size_t i = 0; i < args.size(); i++) {
         if (args[i] && !args[i]->get().IsVoid()) {
             // LLVM puts the burden of zero-extension of 8 and 16 bit values on the caller instead of the callee
@@ -516,10 +518,38 @@ void RegAlloc::Exchange(BlockOfCode& code, HostLoc a, HostLoc b) noexcept {
 void RegAlloc::MoveOutOfTheWay(BlockOfCode& code, HostLoc reg) noexcept {
     ASSERT(!LocInfo(reg).IsLocked());
     if (!LocInfo(reg).IsEmpty()) {
+        // A register move rather than a store to the stack and a load back later
+        if (const auto free = FindFreeRegister(reg)) {
+            Move(code, *free, reg);
+            return;
+        }
         SpillRegister(code, reg);
     }
 }
 
+std::optional<HostLoc> RegAlloc::FindFreeRegister(HostLoc reg) const noexcept {
+    const auto usable = [&](HostLoc i) {
+        return i != reg && LocInfo(i).IsEmpty();
+    };
+    if (HostLocIsGPR(reg)) {
+        // Callee-saved first: a value there stays through host calls
+        for (const HostLoc i : {HostLoc::RBX, HostLoc::R12})
+            if (gpr_order.test(size_t(i)) && usable(i))
+                return i;
+        if (in_host_call)
+            return std::nullopt;
+        for (const HostLoc i : {HostLoc::RCX, HostLoc::RDX, HostLoc::RSI, HostLoc::RDI, HostLoc::R8, HostLoc::R9,
+                                HostLoc::R10, HostLoc::R11, HostLoc::RAX})
+            if (gpr_order.test(size_t(i)) && usable(i))
+                return i;
+    } else if (HostLocIsXMM(reg) && !in_host_call) {
+        for (size_t n = size_t(HostLoc::XMM15); n >= size_t(HostLoc::XMM0); --n)
+            if (xmm_order.test(n) && usable(HostLoc(n)))
+                return HostLoc(n);
+    }
+    return std::nullopt;
+}
+
 void RegAlloc::SpillRegister(BlockOfCode& code, HostLoc loc) noexcept {
     ASSERT(HostLocIsRegister(loc) && "Only registers can be spilled");
     ASSERT(!LocInfo(loc).IsEmpty() && "There is no need to spill unoccupied registers");
