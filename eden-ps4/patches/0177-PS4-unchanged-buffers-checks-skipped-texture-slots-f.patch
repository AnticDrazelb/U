+    /// (PS4 04.86) The generations of the regions (at most two) a range lies in, for
+    /// BufferCache::SynchronizeBuffer's skip; false when it spans more, or a region doesn't exist yet
+    [[nodiscard]] bool RangeGenerations(VAddr cpu_address, u64 size, std::array<u64, 2>& out) const noexcept {
+        if (size == 0) {
+            return false;
+        }
+        const size_t first = cpu_address >> HIGHER_PAGE_BITS;
+        const size_t last = (cpu_address + size - 1) >> HIGHER_PAGE_BITS;
+        if (last - first > 1 || last >= NUM_HIGH_PAGES) {
+            return false;
+        }
+        const Manager* const a = top_tier[first];
+        const Manager* const b = last != first ? top_tier[last] : nullptr;
+        if (a == nullptr || (last != first && b == nullptr)) {
+            return false;
+        }
+        out = {a->generation, b != nullptr ? b->generation : 0};
+        return true;
+    }
+
     /// Call 'func' for each CPU modified range and unmark those pages as CPU modified
     template <typename Func>
     void ForEachUploadRange(VAddr query_cpu_range, u64 query_size, Func&& func) {
