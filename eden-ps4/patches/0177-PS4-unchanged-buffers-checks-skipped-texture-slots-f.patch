+        const u64 t3 = P::Ticks();
+        P::Bump(P::gpu_draw_phases.inner_calls);
+        P::Bump(P::gpu_draw_phases.inner_ranges, sequences.size());
+        P::Bump(P::gpu_draw_phases.inner_texture_ticks, t1 - t0);
+        P::Bump(P::gpu_draw_phases.inner_buffer_ticks, t2 - t1);
+        P::Bump(P::gpu_draw_phases.inner_other_ticks, t3 - t2);
+    }
 }
 
