+// (PS4 04.23) An A64 access at a constant address known to be in the arena (the whole access): its
+// range check is left out
+template<typename Conf>
+[[maybe_unused]] static bool ConstantAddressInArena([[maybe_unused]] const Conf& conf, [[maybe_unused]] const Argument& address,
+                                                    [[maybe_unused]] std::size_t bytes) {
+#ifdef AXX_ADDRESS_64
+    if (!address.IsImmediate() || conf.silently_mirror_fastmem || conf.fastmem_address_space_bits >= 64)
+        return false;
+    const u64 a = address.GetImmediateU64();
+    const u64 limit = u64(1) << conf.fastmem_address_space_bits;
+    return a < limit && bytes <= limit - a;
+#else
+    return false;
+#endif
+}
