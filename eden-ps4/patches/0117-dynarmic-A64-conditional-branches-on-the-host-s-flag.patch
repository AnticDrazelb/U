+    case CheckBitFusion::BitLow: {
+        const Xbyak::Reg32 value = ctx.reg_alloc.UseGpr(code, args[0]).cvt32();
+        code.test(value, u32(1) << check_bit_index);
+        break;
+    }
+    case CheckBitFusion::BitHigh: {
+        const Xbyak::Reg64 value = ctx.reg_alloc.UseGpr(code, args[0]);
+        code.bt(value, check_bit_index);
+        break;
+    }
+    }
 }
 
