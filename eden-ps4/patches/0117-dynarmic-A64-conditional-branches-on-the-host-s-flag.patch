+void A64EmitX64::FuseCheckBit(IR::Block& block) {
+    check_bit_fusion = CheckBitFusion::None;
+    // (cycle counting subtracts from the counter between the last instruction and the terminal:
+    // the flags wouldn't last)
+    if (conf.enable_cycle_counting || block.instructions.empty() ||
+        !std::holds_alternative<IR::Term::CheckBit>(block.GetTerminal()))
+        return;
+    IR::Inst& last = block.instructions.back();
+    if (last.GetOpcode() != IR::Opcode::A64SetCheckBit || last.GetArg(0).IsImmediate())
+        return;
+    IR::Inst* const producer = last.GetArg(0).GetInst();
+    const auto op = producer->GetOpcode();
+    if (producer->UseCount() == 1 && (op == IR::Opcode::IsZero32 || op == IR::Opcode::IsZero64) &&
+        !producer->GetArg(0).IsImmediate()) {
+        // CBZ/CBNZ: test the register itself
+        last.SetArg(0, producer->GetArg(0));
+        producer->Invalidate();
+        check_bit_fusion = op == IR::Opcode::IsZero32 ? CheckBitFusion::Zero32 : CheckBitFusion::Zero64;
+    } else if (producer->UseCount() == 1 && op == IR::Opcode::TestBit && !producer->GetArg(0).IsImmediate() &&
+               producer->GetArg(1).IsImmediate()) {
+        // TBZ/TBNZ: test the bit in the register
+        check_bit_index = u8(producer->GetArg(1).GetU8() & 63);
+        last.SetArg(0, producer->GetArg(0));
+        producer->Invalidate();
+        check_bit_fusion = check_bit_index < 32 ? CheckBitFusion::BitLow : CheckBitFusion::BitHigh;
+    } else {
+        // any other bit: tested in its register, no store
+        check_bit_fusion = CheckBitFusion::Bool;
+    }
+}
+
+void A64EmitX64::FuseCondFlags(IR::Block& block) {
+    if_flags_fused = false;
+    if (conf.enable_cycle_counting || block.instructions.empty())
+        return;
+    const IR::Term::Terminal terminal = block.GetTerminal();
+    const auto* const term = std::get_if<IR::Term::If>(&terminal);
+    if (!term || term->if_ == IR::Cond::AL || term->if_ == IR::Cond::NV)
+        return;
+    // from the end back: SetNZCV(GetNZCVFromOp(op)), with nothing between op and it but stores
+    // of results (plain movs: they leave the flags), and op an add or subtract that makes the
+    // flags itself (EmitAdd/EmitSub with their GetNZCVFromOp: CF is ARM's C after them)
+    auto it = block.instructions.end();
+    --it;
+    if (it->GetOpcode() != IR::Opcode::A64SetNZCV || it->GetArg(0).IsImmediate())
+        return;
+    const IR::Inst* const nzcv = it->GetArg(0).GetInst();
+    if (nzcv->GetOpcode() != IR::Opcode::GetNZCVFromOp || nzcv->GetArg(0).IsImmediate())
+        return;
+    const IR::Inst* const op = nzcv->GetArg(0).GetInst();
+    switch (op->GetOpcode()) {
+    case IR::Opcode::Add32:
+    case IR::Opcode::Add64:
+    case IR::Opcode::Sub32:
+    case IR::Opcode::Sub64:
+        break;
+    default:
+        return;
+    }
+    while (it != block.instructions.begin()) {
+        --it;
+        if (&*it == op) {
+            if_flags_fused = true;
+            return;
+        }
+        switch (it->GetOpcode()) {
+        case IR::Opcode::A64SetW:
+        case IR::Opcode::A64SetX:
+        case IR::Opcode::A64SetSP:
+        case IR::Opcode::GetNZCVFromOp:
+        case IR::Opcode::Void:
+            continue;
+        default:
+            return;
+        }
+    }
+}
