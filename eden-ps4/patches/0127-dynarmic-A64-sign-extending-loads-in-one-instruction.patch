+// (PS4 04.26) A plain load sign-extended to to_bits (32: the register's upper half zeroed)
+template<std::size_t bitsize>
+const void* EmitReadMemoryMovSigned(BlockOfCode& code, int value_idx, const Xbyak::RegExp& addr, unsigned to_bits) {
+    const void* fastmem_location = code.getCurr();
+    const Xbyak::Reg64 value{value_idx};
+    if constexpr (bitsize == 8) {
+        to_bits == 64 ? code.movsx(value, code.byte[addr]) : code.movsx(value.cvt32(), code.byte[addr]);
+    } else if constexpr (bitsize == 16) {
+        to_bits == 64 ? code.movsx(value, code.word[addr]) : code.movsx(value.cvt32(), code.word[addr]);
+    } else if constexpr (bitsize == 32) {
+        code.movsxd(value, code.dword[addr]);
+    } else {
+        UNREACHABLE();
+    }
+    return fastmem_location;
+}
