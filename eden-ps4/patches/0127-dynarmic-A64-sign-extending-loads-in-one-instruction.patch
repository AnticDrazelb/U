     xmm_loads.clear();
+    signed_loads.clear();
     for (auto& inst : block.instructions) {
         // (movsxd reads the low 32 bits alone: no zero-extension of them first, SXTW, SMULL)
         if (inst.GetOpcode() == IR::Opcode::SignExtendWordToLong && !inst.GetArg(0).IsImmediate()) {
@@ -408,6 +409,27 @@ void A64EmitX64::PeepholeQuad(A64EmitContext& ctx, IR::Block& block) {
         if (ShouldFastmem(ctx, load))
             xmm_loads.push_back(load);
     }
+    // (PS4 04.26) LDRSB, LDRSH, LDRSW (a load sign-extended, nothing else using it), with fastmem:
+    // loaded with movsx/movsxd
+    for (auto& inst : block.instructions) {
+        IR::Opcode want;
+        unsigned to_bits;
+        switch (inst.GetOpcode()) {
+        case IR::Opcode::SignExtendByteToWord: want = IR::Opcode::A64ReadMemory8, to_bits = 32; break;
+        case IR::Opcode::SignExtendByteToLong: want = IR::Opcode::A64ReadMemory8, to_bits = 64; break;
+        case IR::Opcode::SignExtendHalfToWord: want = IR::Opcode::A64ReadMemory16, to_bits = 32; break;
+        case IR::Opcode::SignExtendHalfToLong: want = IR::Opcode::A64ReadMemory16, to_bits = 64; break;
+        case IR::Opcode::SignExtendWordToLong: want = IR::Opcode::A64ReadMemory32, to_bits = 64; break;
+        default: continue;
+        }
+        if (inst.GetArg(0).IsImmediate())
+            continue;
+        IR::Inst* const load = inst.GetArg(0).GetInst();
+        if (load->GetOpcode() != want || load->UseCount() != 1 || load->GetArg(2).GetAccType() != IR::AccType::NORMAL)
+            continue;
+        if (ShouldFastmem(ctx, load))
+            signed_loads.emplace_back(load, to_bits);
+    }
 }
 
