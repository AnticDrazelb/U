diff --git a/src/dynarmic/src/dynarmic/backend/x64/emit_x64.h b/src/dynarmic/src/dynarmic/backend/x64/emit_x64.h
index 32f0c80e1c..7a17e016b5 100644
--- a/src/dynarmic/src/dynarmic/backend/x64/emit_x64.h
+++ b/src/dynarmic/src/dynarmic/backend/x64/emit_x64.h
@@ -136,11 +136,22 @@ public:
     virtual bool EmitTerminal(IR::Term::Terminal const& terminal, IR::LocationDescriptor initial_location, bool is_single_step) noexcept = 0;
 
     // Patching
+    // The places linked to a block (jumps and RSB pushes made before it existed, patched when it
+    // is compiled or invalidated). (PS4 04.20) One list, each site's kind in its pointer's top two
+    // bits (user addresses are below 2^47): 48 bytes a slot in the flat map, which costs every
+    // slot, used or not, its full size. Four small_vector<CodePtr, 4> made it 232: one core's map
+    // 57 MB in Zelda (about 215,000 targets), the next growth one allocation of 114 MB more.
     struct PatchInformation {
-        boost::container::small_vector<CodePtr, 4> jg; //4*8=32
-        boost::container::small_vector<CodePtr, 4> jz; //4*8=32
-        boost::container::small_vector<CodePtr, 4> jmp; //4*8=32
-        boost::container::small_vector<CodePtr, 4> mov_rcx; //4*8=32
+        enum Kind : u64 { Jg = 0, Jz = 1, Jmp = 2, MovRcx = 3 };
+        boost::container::small_vector<u64, 2> sites;
+        void Add(Kind kind, CodePtr location) {
+            sites.push_back(reinterpret_cast<u64>(location) | (u64(kind) << 62));
+        }
+        template<typename F>
+        void ForEach(F&& f) const {
+            for (const u64 site : sites)
+                f(Kind(site >> 62), reinterpret_cast<CodePtr>(site & ((u64{1} << 62) - 1)));
+        }
     };
     void Patch(const IR::LocationDescriptor& target_desc, CodePtr target_code_ptr);
     virtual void Unpatch(const IR::LocationDescriptor& target_desc);
