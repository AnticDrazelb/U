         std::vector<Site> sites;
         for (const auto& [target, info] : emitter.patch_information) {
-            const auto add = [&](const auto& list, u32 type) {
-                for (const CodePtr site : list)
-                    sites.push_back({target.Value(), u32(static_cast<const u8*>(site) - base), type});
-            };
-            add(info.jg, 0);
-            add(info.jz, 1);
-            add(info.jmp, 2);
-            add(info.mov_rcx, 3);
+            info.ForEach([&](auto kind, CodePtr site) {
+                sites.push_back({target.Value(), u32(static_cast<const u8*>(site) - base), u32(kind)});
+            });
         }
 
         // each block's guest ranges (its code and its look-ahead), from the invalidation map
@@ -279,13 +274,8 @@ public:
         // every link undone (the saved blocks register when looked up, and are linked then)
         for (const Site& site : sites) {
             auto& info = emitter.patch_information[IR::LocationDescriptor{site.target}];
-            const CodePtr location = base + site.offset;
-            switch (site.type) {
-            case 0: info.jg.push_back(location); break;
-            case 1: info.jz.push_back(location); break;
-            case 2: info.jmp.push_back(location); break;
-            default: info.mov_rcx.push_back(location); break;
-            }
+            using Kind = typename std::remove_reference_t<decltype(info)>::Kind;
+            info.Add(Kind(site.type & 3), base + site.offset);
         }
         for (const auto& [target, info] : emitter.patch_information)
             emitter.Patch(target, nullptr);
