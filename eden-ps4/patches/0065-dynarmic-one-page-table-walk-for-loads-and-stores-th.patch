+IREmitter::MultipleAccess IREmitter::BeginMultipleAccess(const IR::U32& start, size_t bytes, bool is_write) {
+    // (one word: nothing to share; more than a page: never in one)
+    if (!single_walk_multiple || bytes < 8 || bytes > 4096) {
+        return {};
+    }
+    return {Inst<IR::U64>(Opcode::A32HostPointer, start, Imm32(u32(bytes)), Imm1(is_write)), start};
+}
+
+IR::U32 IREmitter::ReadMemory32(const MultipleAccess& access, const IR::U32& vaddr, u32 offset, IR::AccType acc_type) {
+    if (!access.host) {
+        return ReadMemory32(vaddr, acc_type);
+    }
+    const auto value = Inst<IR::U32>(Opcode::A32ReadMemoryVia32, *access.host, *access.start, Imm32(offset));
+    return current_location.EFlag() ? ByteReverseWord(value) : value;
+}
+
+void IREmitter::WriteMemory32(const MultipleAccess& access, const IR::U32& vaddr, const IR::U32& value, u32 offset, IR::AccType acc_type) {
+    if (!access.host) {
+        return WriteMemory32(vaddr, value, acc_type);
+    }
+    Inst(Opcode::A32WriteMemoryVia32, *access.host, *access.start, current_location.EFlag() ? ByteReverseWord(value) : value, Imm32(offset));
+}
