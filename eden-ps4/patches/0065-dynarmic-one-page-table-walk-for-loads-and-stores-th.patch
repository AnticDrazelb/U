+namespace {
+// The slow path of a word of a multiple access whose shared walk failed (A32HostPointer gave 0):
+// its own walk, as an ordinary access's (in two registers saved on the stack meanwhile), and only
+// if that fails too the memory callbacks. `start` is the access's address for the time being (the
+// caller adds and takes off the offset); `value` is loaded (read) or stored (write).
+// A load (`is_write` false) or store of `bitsize` bits at `address`, zero-extending a load
+void EmitHostMov(BlockOfCode& code, size_t bitsize, bool is_write, Xbyak::Reg64 value, const Xbyak::Address& address) {
+    switch (bitsize) {
+    case 8:
+        is_write ? code.mov(address, value.cvt8()) : code.movzx(value.cvt32(), address);
+        break;
+    case 16:
+        is_write ? code.mov(address, value.cvt16()) : code.movzx(value.cvt32(), address);
+        break;
+    case 32:
+        is_write ? code.mov(address, value.cvt32()) : code.mov(value.cvt32(), address);
+        break;
+    default:
+        is_write ? code.mov(address, value) : code.mov(value, address);
+        break;
+    }
+}
+
+Xbyak::Address HostOperand(BlockOfCode& code, size_t bitsize, const Xbyak::RegExp& where) {
+    switch (bitsize) {
+    case 8:
+        return code.byte[where];
+    case 16:
+        return code.word[where];
+    case 32:
+        return code.dword[where];
+    default:
+        return code.qword[where];
+    }
+}
+
+void EmitViaSlowPath(BlockOfCode& code, const A32::UserConfig& conf, size_t bitsize, Xbyak::Reg64 start, Xbyak::Reg64 value,
+                     Xbyak::Reg64 host, bool is_write, void (*fallback)(), u32 offset, Xbyak::Label& end) {
+    const auto avoid = [&](const Xbyak::Reg64& r) {
+        return r.getIdx() == start.getIdx() || r.getIdx() == value.getIdx() || r.getIdx() == host.getIdx();
+    };
+    Xbyak::Reg64 regs[2];
+    size_t found = 0;
+    for (const Xbyak::Reg64& r : {code.rax, code.rcx, code.rdx, code.rbx, code.rsi, code.rdi, code.r8, code.r9}) {
+        if (found < 2 && !avoid(r)) {
+            regs[found++] = r;
+        }
+    }
+    const Xbyak::Reg64 page = regs[0], tmp = regs[1];
+    Xbyak::Label callback;
+    if (offset != 0) {
+        code.add(start.cvt32(), offset);
+    }
+    code.push(page);
+    code.push(tmp);
+    // an access that would cross into the next page goes to the callbacks
+    if (bitsize > 8) {
+        code.mov(tmp.cvt32(), start.cvt32());
+        code.and_(tmp.cvt32(), u32(page_table_const_mask));
+        code.cmp(tmp.cvt32(), u32(page_table_const_size - bitsize / 8));
+        code.ja(callback, code.T_NEAR);
+    }
+    code.mov(tmp, start);
+    code.shr(tmp, int(page_table_const_bits));
+    if (conf.page_table_log2_stride > 3) {
+        code.shl(tmp, int(conf.page_table_log2_stride));
+        code.mov(page, qword[r14 + tmp]);
+    } else {
+        code.mov(page, qword[r14 + tmp * int(1 << conf.page_table_log2_stride)]);
+    }
+    if (conf.page_table_marked_bit && (is_write || conf.page_table_marked_bit_reads)) {
+        code.bt(page, *conf.page_table_marked_bit);
+        code.jc(callback, code.T_NEAR);
+    }
+    if (conf.page_table_pointer_mask == 0) {
+        code.test(page, page);
+    } else if (std::in_range<s32>(s64(EffectivePointerMask(conf)))) {
+        code.and_(page, u32(s32(EffectivePointerMask(conf))));
+    } else {
+        code.mov(tmp, conf.page_table_pointer_mask);
+        code.and_(page, tmp);
+    }
+    if (conf.page_table_sign_extension) {
+        code.shl(page, 63 - int(*conf.page_table_sign_extension));
+        code.sar(page, 63 - int(*conf.page_table_sign_extension));
+    }
+    code.jz(callback, code.T_NEAR);
+    if (!conf.absolute_offset_page_table) {
+        code.mov(tmp, start);
+        code.and_(tmp, u32(page_table_const_mask));
+        code.add(page, tmp);
+    } else {
+        code.add(page, start);
+    }
+    EmitHostMov(code, bitsize, is_write, value, HostOperand(code, bitsize, page));
+    code.pop(tmp);
+    code.pop(page);
+    if (offset != 0) {
+        code.sub(start.cvt32(), offset);
+    }
+    code.jmp(end, code.T_NEAR);
+
+    code.L(callback);
+    code.pop(tmp);
+    code.pop(page);
+    code.call(fallback);
+    if (offset != 0) {
+        code.sub(start.cvt32(), offset);
+    }
+    code.jmp(end, code.T_NEAR);
+}
+}  // namespace
+
+// One page table walk for a load or store of several words (frontend: BeginMultipleAccess): the host
+// address of the first, or 0 when any of them would leave the inline walk (the words cross into the
+// next page, or the page is unmapped, or marked and this is a write). As EmitVAddrLookup, once.
+void A32EmitX64::EmitA32HostPointer(A32EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const u32 span = args[1].GetImmediateU32();
+    const bool is_write = args[2].GetImmediateU1();
+    ASSERT(conf.page_table && span >= 1 && span <= page_table_const_size);
+
+    const Xbyak::Reg64 vaddr = ctx.reg_alloc.UseGpr(code, args[0]);
+    const Xbyak::Reg64 page = ctx.reg_alloc.ScratchGpr(code);
+    const Xbyak::Reg64 tmp = ctx.reg_alloc.ScratchGpr(code);
+    Xbyak::Label fail, done;
+
+    // all of [vaddr, vaddr + span) in vaddr's page
+    code.mov(tmp.cvt32(), vaddr.cvt32());
+    code.and_(tmp.cvt32(), u32(page_table_const_mask));
+    code.cmp(tmp.cvt32(), u32(page_table_const_size - span));
+    code.ja(fail, code.T_NEAR);
+
+    code.mov(tmp, vaddr);
+    code.shr(tmp, int(page_table_const_bits));
+    if (conf.page_table_log2_stride > 3) {
+        code.shl(tmp, int(conf.page_table_log2_stride));
+        code.mov(page, qword[r14 + tmp]);
+    } else {
+        code.mov(page, qword[r14 + tmp * int(1 << conf.page_table_log2_stride)]);
+    }
+    if (conf.page_table_marked_bit && (is_write || conf.page_table_marked_bit_reads)) {
+        code.bt(page, *conf.page_table_marked_bit);
+        code.jc(fail, code.T_NEAR);
+    }
+    if (conf.page_table_pointer_mask == 0) {
+        code.test(page, page);
+    } else if (std::in_range<s32>(s64(EffectivePointerMask(conf)))) {
+        code.and_(page, u32(s32(EffectivePointerMask(conf))));
+    } else {
+        code.mov(tmp, conf.page_table_pointer_mask);
+        code.and_(page, tmp);
+    }
+    if (conf.page_table_sign_extension) {
+        code.shl(page, 63 - int(*conf.page_table_sign_extension));
+        code.sar(page, 63 - int(*conf.page_table_sign_extension));
+    }
+    code.jz(fail, code.T_NEAR);
+    if (conf.absolute_offset_page_table) {
+        code.add(page, vaddr);
+    } else {
+        code.mov(tmp, vaddr);
+        code.and_(tmp, u32(page_table_const_mask));
+        code.add(page, tmp);
+    }
+    code.jmp(done, code.T_NEAR);
+    code.L(fail);
+    code.xor_(page.cvt32(), page.cvt32());
+    code.L(done);
+
+    ctx.reg_alloc.DefineValue(code, inst, page);
+}
+
+// An access of a multiple access, or of a group sharing a base register (A32SharedWalkPass), through
+// its host address (A32HostPointer); or, when that is 0, its own walk and if need be the memory
+// callbacks (EmitViaSlowPath), for its address: the start (args[1], the same for the whole group)
+// plus its offset, put in the start's register meanwhile and taken off again after (the fallbacks
+// keep every register but the value's)
+template<size_t bitsize>
+void A32EmitX64::EmitReadMemoryVia(A32EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const u32 offset = args[2].GetImmediateU32();
+    const Xbyak::Reg64 host = ctx.reg_alloc.UseGpr(code, args[0]);
+    const Xbyak::Reg64 start = ctx.reg_alloc.UseGpr(code, args[1]);
+    const Xbyak::Reg64 value = ctx.reg_alloc.ScratchGpr(code);
+    const auto wrapped_fn = read_fallbacks[std::make_tuple(false, bitsize, start.getIdx(), value.getIdx())];
+
+    SharedLabel slow = ctx.GenSharedLabel(), end = ctx.GenSharedLabel();
+    code.test(host, host);
+    code.jz(*slow, code.T_NEAR);
+    EmitHostMov(code, bitsize, false, value, HostOperand(code, bitsize, host + s32(offset)));
+    code.L(*end);
+    ctx.deferred_emits.emplace_back([=, this] {
+        code.L(*slow);
+        EmitViaSlowPath(code, conf, bitsize, start, value, host, false, wrapped_fn, offset, *end);
+    });
+
+    ctx.reg_alloc.DefineValue(code, inst, value);
+}
+
+template<size_t bitsize>
+void A32EmitX64::EmitWriteMemoryVia(A32EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const u32 offset = args[3].GetImmediateU32();
+    const Xbyak::Reg64 host = ctx.reg_alloc.UseGpr(code, args[0]);
+    Xbyak::Reg64 start = ctx.reg_alloc.UseGpr(code, args[1]);
+    const Xbyak::Reg64 value = ctx.reg_alloc.UseGpr(code, args[2]);
+    if (start.getIdx() == value.getIdx()) {
+        // (storing the base register itself: the slow path's offset mustn't change the value)
+        const Xbyak::Reg64 copy = ctx.reg_alloc.ScratchGpr(code);
+        code.mov(copy.cvt32(), start.cvt32());
+        start = copy;
+    }
+    const auto wrapped_fn = write_fallbacks[std::make_tuple(false, bitsize, start.getIdx(), value.getIdx())];
+
+    SharedLabel slow = ctx.GenSharedLabel(), end = ctx.GenSharedLabel();
+    code.test(host, host);
+    code.jz(*slow, code.T_NEAR);
+    EmitHostMov(code, bitsize, true, value, HostOperand(code, bitsize, host + s32(offset)));
+    code.L(*end);
+    ctx.deferred_emits.emplace_back([=, this] {
+        code.L(*slow);
+        EmitViaSlowPath(code, conf, bitsize, start, value, host, true, wrapped_fn, offset, *end);
+    });
+}
+
+void A32EmitX64::EmitA32ReadMemoryVia8(A32EmitContext& ctx, IR::Inst* inst) {
+    EmitReadMemoryVia<8>(ctx, inst);
+}
+
+void A32EmitX64::EmitA32ReadMemoryVia16(A32EmitContext& ctx, IR::Inst* inst) {
+    EmitReadMemoryVia<16>(ctx, inst);
+}
+
+void A32EmitX64::EmitA32ReadMemoryVia32(A32EmitContext& ctx, IR::Inst* inst) {
+    EmitReadMemoryVia<32>(ctx, inst);
+}
+
+void A32EmitX64::EmitA32ReadMemoryVia64(A32EmitContext& ctx, IR::Inst* inst) {
+    EmitReadMemoryVia<64>(ctx, inst);
+}
+
+void A32EmitX64::EmitA32WriteMemoryVia8(A32EmitContext& ctx, IR::Inst* inst) {
+    EmitWriteMemoryVia<8>(ctx, inst);
+}
+
+void A32EmitX64::EmitA32WriteMemoryVia16(A32EmitContext& ctx, IR::Inst* inst) {
+    EmitWriteMemoryVia<16>(ctx, inst);
+}
+
+void A32EmitX64::EmitA32WriteMemoryVia32(A32EmitContext& ctx, IR::Inst* inst) {
+    EmitWriteMemoryVia<32>(ctx, inst);
+}
+
+void A32EmitX64::EmitA32WriteMemoryVia64(A32EmitContext& ctx, IR::Inst* inst) {
+    EmitWriteMemoryVia<64>(ctx, inst);
+}
