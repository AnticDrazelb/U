+// A desktop build's test of the lining up (EDEN_TEST_ARENA_LINE_UP): the arena's padding table
+// alone (common/orbis_memory.cpp's on the PS4)
+namespace Common::Orbis {
+namespace {
+std::mutex padding_mutex;
+std::map<u64, std::pair<unsigned, size_t>> paddings;
+} // namespace
+bool AddArenaPadding(u64 group_va, unsigned mask, size_t dram_offset) {
+    std::scoped_lock lk{padding_mutex};
+    const bool added = paddings.emplace(group_va, std::make_pair(mask, dram_offset)).second;
+    LOG_INFO(Kernel, "arena padding: +{:#x} mask {:#x} at DRAM {:#x}{} ({} now)", group_va, mask,
+             dram_offset, added ? "" : " (taken)", paddings.size());
+    return added;
+}
+unsigned RemoveArenaPadding(u64 group_va, size_t& dram_offset) {
+    std::scoped_lock lk{padding_mutex};
+    const auto it = paddings.find(group_va);
+    if (it == paddings.end()) {
+        return 0;
+    }
+    const unsigned mask = it->second.first;
+    dram_offset = it->second.second;
+    paddings.erase(it);
+    LOG_INFO(Kernel, "arena padding: -{:#x} mask {:#x} ({} now)", group_va, mask, paddings.size());
+    return mask;
+}
+unsigned PopArenaPadding(u64& group_va, size_t& dram_offset) {
+    std::scoped_lock lk{padding_mutex};
+    if (paddings.empty()) {
+        return 0;
+    }
+    const auto it = paddings.begin();
+    group_va = it->first;
+    const unsigned mask = it->second.first;
+    dram_offset = it->second.second;
+    paddings.erase(it);
+    return mask;
+}
+} // namespace Common::Orbis
