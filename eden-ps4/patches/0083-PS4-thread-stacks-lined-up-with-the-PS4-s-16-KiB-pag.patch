+#ifdef EDEN_ARENA_LINE_UP
+// The PS4's fastmem arena maps the Switch's memory 16 KiB at a time (the PS4's page), each 16 KiB
+// from 16 KiB of the DRAM: four guest pages back to back there, at their places in a 16 KiB page.
+// A game's thread stacks are heap memory it aliases (svcMapMemory) at addresses it picks to 4 KiB,
+// which mostly don't line up: the arena can't map them, and the recompiler walks the page table
+// for the stack's accesses instead. So such an alias goes on a copy of its source's data, in
+// memory at the alias's place in a 16 KiB page, with spare pages for the rest of its first and
+// last 16 KiB, which the arena maps where the guest pages beside the alias are free (where the
+// Switch would fault). The source keeps its own pages (locked while the alias is there, as on the
+// Switch), and gets the alias's data back when it's unmapped: the heap there stays lined up.
+bool KPageTableBase::CopyAliasForArena(KProcessAddress dst_address, const KPageGroup& src_pg,
+                                       size_t num_pages, ArenaAliasCopy& out) {
+    constexpr size_t GroupPages = 16_KiB / PageSize;
+#ifdef __OPENORBIS__
+    Common::PS4Perf::aliases.fetch_add(1, std::memory_order_relaxed);
+    const auto not_copied = [] {
+        Common::PS4Perf::aliases_not_moved.fetch_add(1, std::memory_order_relaxed);
+        return false;
+    };
+#else
+    const auto not_copied = [] { return false; };
+#endif
+    if (num_pages == 0 || num_pages > 8_MiB / PageSize) {
+        return not_copied();
+    }
+    const size_t head = (GetInteger(dst_address) / PageSize) % GroupPages;
+    const size_t total = Common::AlignUp(head + num_pages, GroupPages);
+    const size_t tail = total - head - num_pages;
+    const KProcessAddress first_group = dst_address - head * PageSize;
+
+    // The free guest pages in the alias's first and last 16 KiB (spare pages go there)
+    const auto is_free = [&](size_t index) {
+        const KProcessAddress address = first_group + index * PageSize;
+        return this->Contains(address, PageSize) &&
+               R_SUCCEEDED(this->CheckMemoryState(address, PageSize, KMemoryState::All,
+                                                  KMemoryState::Free, KMemoryPermission::None,
+                                                  KMemoryPermission::None, KMemoryAttribute::None,
+                                                  KMemoryAttribute::None));
+    };
+    unsigned first_mask = 0, last_mask = 0;
+    for (size_t i = 0; i < head; i++) {
+        first_mask |= is_free(i) ? 1u << i : 0u;
+    }
+    for (size_t i = GroupPages - tail; i < GroupPages; i++) {
+        last_mask |= is_free(total - GroupPages + i) ? 1u << i : 0u;
+    }
+
+    // The source lined up already, with nothing free beside the alias: the alias on its pages
+    size_t src_blocks = 0;
+    for ([[maybe_unused]] const auto& node : src_pg) {
+        src_blocks++;
+    }
+    const bool lined_up =
+        src_blocks == 1 &&
+        (GetInteger(src_pg.begin()->GetAddress()) - head * PageSize) % 16_KiB == 0;
+    if (lined_up && first_mask == 0 && last_mask == 0) {
+        return false;
+    }
+
+    // The copy: whole 16 KiB, the alias at its place in the first. From the applet pool, which
+    // the HLE applets leave unused: the application's pool is the game's own to the last page (its
+    // resource limit is the pool's size), and some games take all of it. At most 128 MiB.
+    constexpr size_t MaxCopyBytes = 128_MiB;
+    if (m_alias_copy_bytes + total * PageSize > MaxCopyBytes) {
+        return not_copied();
+    }
+    const KPhysicalAddress block = m_system.Kernel().MemoryManager().AllocateAndOpenContinuous(
+        total, GroupPages,
+        KMemoryManager::EncodeOption(KMemoryManager::Pool::Applet,
+                                     KMemoryManager::Direction::FromBack));
+    if (block == 0) {
+        return not_copied();
+    }
+#ifdef __OPENORBIS__
+    Common::PS4Perf::aliases_moved.fetch_add(1, std::memory_order_relaxed);
+#else
+    LOG_INFO(Kernel, "alias {:#x}+{:#x} on a copy at {:#x} ({} source blocks{}), spare {}/{}; "
+             "{:#x} bytes free in the pool before",
+             GetInteger(dst_address), num_pages * PageSize, GetInteger(block + head * PageSize),
+             src_blocks, lined_up ? ", lined up" : "", head, tail,
+             m_system.Kernel().MemoryManager().GetFreeSize(KMemoryManager::Pool::Applet) +
+                 total * PageSize);
+#endif
+    auto& device_memory = m_system.DeviceMemory();
+    u8* to = device_memory.GetPointer<u8>(block + head * PageSize);
+    for (const auto& node : src_pg) {
+        std::memcpy(to, device_memory.GetPointer<u8>(node.GetAddress()), node.GetSize());
+        to += node.GetSize();
+    }
+    if (head != 0) {
+        ClearBackingRegion(m_system, block, head * PageSize, 0);
+    }
+    if (tail != 0) {
+        ClearBackingRegion(m_system, block + (head + num_pages) * PageSize, tail * PageSize, 0);
+    }
+    out = {block, total, head, tail, first_mask, last_mask};
+    return true;
+}
+
+// The alias is mapped on the copy: the copy's spare pages are the arena's padding where their
+// guest pages are free (else freed), and the alias is noted, for its unmapping
+void KPageTableBase::FinishAliasCopy(KProcessAddress dst_address, KProcessAddress src_address,
+                                     size_t num_pages, const ArenaAliasCopy& copy) {
+    constexpr size_t GroupPages = 16_KiB / PageSize;
+    auto& memory_manager = m_system.Kernel().MemoryManager();
+    // (the alias's mapping holds its pages now; the allocation's reference goes)
+    memory_manager.Close(copy.block + copy.head * PageSize, num_pages);
+
+    const size_t groups = copy.total_pages / GroupPages;
+    const u64 first_group = GetInteger(dst_address) - copy.head * PageSize;
+    const size_t block_offset = GetInteger(copy.block) - Core::DramMemoryMap::Base;
+    const auto pad = [&](size_t group, unsigned mask) {
+        const bool padded =
+            mask != 0 && Common::Orbis::AddArenaPadding(first_group + group * 16_KiB, mask,
+                                                        block_offset + group * 16_KiB);
+        return padded ? mask : 0u;
+    };
+    unsigned kept_first, kept_last;
+    if (groups == 1) {
+        kept_first = kept_last = pad(0, copy.first_mask | copy.last_mask);
+    } else {
+        kept_first = pad(0, copy.first_mask);
+        kept_last = pad(groups - 1, copy.last_mask);
+    }
+    for (size_t i = 0; i < copy.head; i++) {
+        if (!((kept_first >> i) & 1)) {
+            memory_manager.Close(copy.block + i * PageSize, 1);
+        }
+    }
+    for (size_t i = GroupPages - copy.tail; i < GroupPages; i++) {
+        if (!((kept_last >> i) & 1)) {
+            memory_manager.Close(copy.block + (copy.total_pages - GroupPages + i) * PageSize, 1);
+        }
+    }
+    m_alias_copies[GetInteger(dst_address)] = {GetInteger(src_address), num_pages, num_pages,
+                                               copy.total_pages};
+    m_alias_copy_bytes += copy.total_pages * PageSize;
+}
+
+// An alias being unmapped (all of it or a part) that's on a copy of `src_address`'s pages: its
+// data (`dst_pg`, the alias's pages) back to them. False if it isn't.
+bool KPageTableBase::CopyBackAlias(KProcessAddress dst_address, KProcessAddress src_address,
+                                   size_t num_pages, const KPageGroup& dst_pg) {
+    const u64 dst = GetInteger(dst_address), src = GetInteger(src_address);
+    auto it = m_alias_copies.upper_bound(dst);
+    if (it == m_alias_copies.begin()) {
+        return false;
+    }
+    --it;
+    const u64 alias = it->first;
+    const AliasCopy& entry = it->second;
+    if (dst + num_pages * PageSize > alias + entry.num_pages * PageSize ||
+        src - entry.src != dst - alias) {
+        return false;
+    }
+    KPageGroup src_pg(m_system.Kernel(), m_block_info_manager);
+    if (R_FAILED(this->MakePageGroup(src_pg, src_address, num_pages)) ||
+        src_pg.GetNumPages() != num_pages || dst_pg.GetNumPages() != num_pages) {
+        return false;
+    }
+    std::vector<KPhysicalAddress> src_pages;
+    src_pages.reserve(num_pages);
+    for (const auto& node : src_pg) {
+        for (size_t i = 0; i < node.GetNumPages(); i++) {
+            src_pages.push_back(node.GetAddress() + i * PageSize);
+        }
+    }
+    auto& device_memory = m_system.DeviceMemory();
+    size_t page = 0;
+    for (const auto& node : dst_pg) {
+        for (size_t i = 0; i < node.GetNumPages(); i++) {
+            std::memcpy(device_memory.GetPointer<u8>(src_pages[page++]),
+                        device_memory.GetPointer<u8>(node.GetAddress() + i * PageSize), PageSize);
+        }
+    }
+    return true;
+}
+
+// An alias on a copy unmapped (all of it or a part): its spare pages out of the arena and freed
+// with its last page
+void KPageTableBase::ForgetAliasCopy(KProcessAddress dst_address, size_t num_pages) {
+    auto it = m_alias_copies.upper_bound(GetInteger(dst_address));
+    if (it == m_alias_copies.begin()) {
+        return;
+    }
+    --it;
+    const u64 alias = it->first;
+    AliasCopy& entry = it->second;
+    entry.mapped_pages -= (std::min)(entry.mapped_pages, num_pages);
+    if (entry.mapped_pages != 0) {
+        return;
+    }
+    const size_t pages = entry.num_pages;
+    m_alias_copy_bytes -= (std::min)(m_alias_copy_bytes, entry.total_pages * PageSize);
+    m_alias_copies.erase(it);
+    const u64 first = Common::AlignDown(alias, 16_KiB);
+    const u64 last = Common::AlignDown(alias + pages * PageSize - 1, 16_KiB);
+    for (const u64 group : {first, last}) {
+        size_t dram_offset = 0;
+        const unsigned mask = Common::Orbis::RemoveArenaPadding(group, dram_offset);
+        for (size_t i = 0; i < 16_KiB / PageSize; i++) {
+            if ((mask >> i) & 1) {
+                m_system.Kernel().MemoryManager().Close(
+                    Core::DramMemoryMap::Base + dram_offset + i * PageSize, 1);
+            }
+        }
+        if (first == last) {
+            break;
+        }
+    }
+#ifndef __OPENORBIS__
+    LOG_INFO(Kernel, "alias {:#x}+{:#x} unmapped; {:#x} bytes free in the pool", alias,
+             pages * PageSize,
+             m_system.Kernel().MemoryManager().GetFreeSize(KMemoryManager::Pool::Applet));
+#endif
+}
+
+// Every spare page (the process ends)
+void KPageTableBase::ReleaseAllArenaPadding() {
+    m_alias_copies.clear();
+    m_alias_copy_bytes = 0;
+    u64 group = 0;
+    size_t dram_offset = 0;
+    while (const unsigned mask = Common::Orbis::PopArenaPadding(group, dram_offset)) {
+        for (size_t i = 0; i < 16_KiB / PageSize; i++) {
+            if ((mask >> i) & 1) {
+                m_system.Kernel().MemoryManager().Close(
+                    Core::DramMemoryMap::Base + dram_offset + i * PageSize, 1);
+            }
+        }
+    }
+}
