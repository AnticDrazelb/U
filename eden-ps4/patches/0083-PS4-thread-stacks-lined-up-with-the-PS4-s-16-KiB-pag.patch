+bool AddArenaPadding(u64 group_va, unsigned mask, size_t dram_offset) {
+    if (group_va % ArenaPage != 0 || dram_offset % ArenaPage != 0 || mask == 0 || mask >= (1u << (ArenaPage / GuestPage)))
+        return false;
+    LockArena();
+    const bool added = padding_count < MaxPaddings && !FindPadding(group_va);
+    if (added) {
+        paddings[padding_count++] = {group_va, dram_offset, mask};
+        // (declined before, with free pages in it: mapped again when next touched)
+        InvalidateArena(group_va, ArenaPage);
+    }
+    UnlockArena();
+    return added;
+}
+
+unsigned RemoveArenaPadding(u64 group_va, size_t& dram_offset) {
+    unsigned mask = 0;
+    LockArena();
+    for (size_t i = 0; i < padding_count; i++) {
+        if (paddings[i].group_va != group_va)
+            continue;
+        mask = paddings[i].mask;
+        dram_offset = paddings[i].dram_offset;
+        paddings[i] = paddings[--padding_count];
+        // out of the arena before the caller frees the spare pages
+        InvalidateArena(group_va, ArenaPage);
+        break;
+    }
+    UnlockArena();
+    return mask;
+}
+
+unsigned PopArenaPadding(u64& group_va, size_t& dram_offset) {
+    unsigned mask = 0;
+    LockArena();
+    if (padding_count != 0) {
+        const Padding& last = paddings[--padding_count];
+        group_va = last.group_va;
+        dram_offset = last.dram_offset;
+        mask = last.mask;
+        InvalidateArena(group_va, ArenaPage);
+    }
+    UnlockArena();
+    return mask;
+}
+
+size_t ArenaPaddingCount() {
+    LockArena();
+    const size_t count = padding_count;
+    UnlockArena();
+    return count;
+}
+
+size_t ArenaPaddedMaps() {
+    return padded_maps.load(std::memory_order_relaxed);
+}
