+// ---- the proxy ----
+
+RasterizerProxy::RasterizerProxy(VideoCore::RasterizerInterface& real_, GpuBackend& backend_)
+    : real{real_}, backend{backend_} {}
+
+RasterizerProxy::~RasterizerProxy() = default;
+
+template <typename F>
+void RasterizerProxy::Forward(F&& f) {
+    if (!g_gpu_front_thread) {
+        f(real);
+        return;
+    }
+    backend.Push([this, f = std::forward<F>(f)]() mutable { f(real); });
+}
+
+void RasterizerProxy::SyncState() {
+    if (!g_gpu_front_thread) {
+        return;
+    }
+    Shadowed* const s = bound;
+    if (s == nullptr || s->front == nullptr || s->shadow == nullptr) {
+        return;
+    }
+    using Maxwell = Tegra::Engines::Maxwell3D;
+    Maxwell& front = *s->front;
+    const u32* const now = front.regs.reg_array.data();
+    u32* const sent = s->sent.get();
+    // the registers that changed: compared eight bytes at a time, the words of a differing pair
+    // looked at alone
+    std::vector<std::pair<u16, u32>> changed;
+    constexpr size_t n = Maxwell::Regs::NUM_REGS;
+    for (size_t i = 0; i + 1 < n; i += 2) {
+        u64 a, b;
+        std::memcpy(&a, now + i, sizeof(a));
+        std::memcpy(&b, sent + i, sizeof(b));
+        if (a == b) {
+            continue;
+        }
+        for (size_t j = i; j < i + 2; j++) {
+            if (now[j] != sent[j]) {
+                changed.emplace_back(static_cast<u16>(j), now[j]);
+                sent[j] = now[j];
+            }
+        }
+    }
+    if constexpr ((n & 1) != 0) {
+        if (now[n - 1] != sent[n - 1]) {
+            changed.emplace_back(static_cast<u16>(n - 1), now[n - 1]);
+            sent[n - 1] = now[n - 1];
+        }
+    }
+    const Maxwell::DirtyState::Flags flags = front.dirty.flags;
+    front.dirty.flags.reset();
+    const bool key_changed = front.dirty.pipeline_key_changed;
+    front.dirty.pipeline_key_changed = false;
+    auto draw_state = front.draw_manager.draw_state;
+    const auto draw_texture_state = front.draw_manager.draw_texture_state;
+    const auto indirect_state = front.draw_manager.indirect_state;
+    const auto engine_state = front.engine_state;
+    Maxwell* const shadow = s->shadow;
+    backend.Push([shadow, changed = std::move(changed), flags, key_changed, draw_state = std::move(draw_state),
+                  draw_texture_state, indirect_state, engine_state]() mutable {
+        auto& dirty = shadow->dirty;
+        for (const auto& [index, value] : changed) {
+            // (as ProcessDirtyRegisters: a register of the pipeline key with a new value)
+            if (dirty.pipeline_key_regs[index] != 0 && shadow->regs.reg_array[index] != value) {
+                dirty.pipeline_key_changed = true;
+            }
+            shadow->regs.reg_array[index] = value;
+        }
+        dirty.flags |= flags;
+        if (key_changed) {
+            dirty.pipeline_key_changed = true;
+        }
+        shadow->draw_manager.draw_state = std::move(draw_state);
+        shadow->draw_manager.draw_texture_state = draw_texture_state;
+        shadow->draw_manager.indirect_state = indirect_state;
+        shadow->engine_state = engine_state;
+    });
+}
