+void RasterizerProxy::BindGraphicsUniformBuffer(size_t stage, u32 index, GPUVAddr gpu_addr, u32 size) {
+    Shadowed* const s = g_gpu_front_thread ? bound : nullptr;
+    if (s != nullptr && s->front != nullptr && s->shadow != nullptr) {
+        // (the 3D engine's binding table, which ProcessCBBind has just set, to the shadow with it)
+        const auto entry = s->front->state.shader_stages[stage].const_buffers[index];
+        Tegra::Engines::Maxwell3D* const shadow = s->shadow;
+        backend.Push([this, shadow, entry, stage, index, gpu_addr, size] {
+            shadow->state.shader_stages[stage].const_buffers[index] = entry;
+            real.BindGraphicsUniformBuffer(stage, index, gpu_addr, size);
+        });
+        return;
+    }
+    Forward([=](VideoCore::RasterizerInterface& r) { r.BindGraphicsUniformBuffer(stage, index, gpu_addr, size); });
+}
