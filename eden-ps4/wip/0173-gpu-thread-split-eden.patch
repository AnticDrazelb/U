@@ -0,0 +1,189 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+// (PS4 04.83) The GPU thread's work on two threads (eden-ps4 docs/gpu-thread-split.md): the GPU
+// thread as the front end - DmaPusher fetching and decoding the command lists, the puller's
+// BindObject, the 3D engine's methods and macros - and a back end thread for everything else:
+// every rasterizer call (through RasterizerProxy, in order), the other engines' methods, the
+// puller's other methods, the 3D engine's own memory writes, the GPU thread's other commands. The
+// rasterizer and its caches read a shadow of each channel's 3D engine, which the front end brings up
+// to date (the registers that changed, the dirty flags, the draw state) before each queued
+// operation that reads it. Off (EDEN_PS4_GPU_SPLIT unset or 0): none of this exists, the GPU
+// thread runs as before.
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+#include "common/common_types.h"
+#include "video_core/rasterizer_interface.h"
+
+namespace Core {
+class System;
+}
+
+namespace Tegra::Engines {
+class Maxwell3D;
+}
+
+namespace VideoCommon {
+
+/// Whether the split is on (read once: EDEN_PS4_GPU_SPLIT=1)
+bool GpuSplitEnabled();
+
+/// The back end: a thread running the front end's tasks in the order they were pushed
+class GpuBackend {
+public:
+    using Task = std::function<void()>;
+
+    GpuBackend();
+    ~GpuBackend();
+
+    /// Starts the thread; `on_start` runs on it first (its name, priority, host thread registration)
+    void Start(std::function<void()> on_start);
+    /// The front end's: a task into its batch (published when the batch is full)
+    void Push(Task&& task);
+    /// The front end's: its batch to the back end
+    void Publish();
+    /// The front end's: publish, and wait until the back end has run every task so far
+    void Drain();
+    /// Stops the thread (the tasks left are dropped)
+    void Stop();
+
+    bool OnBackend() const noexcept {
+        return std::this_thread::get_id() == thread_id.load(std::memory_order_relaxed);
+    }
+
+    /// Tasks run, batches published, drains, and the TSC ticks spent running tasks (the 30 s line)
+    std::atomic<u64> tasks_run{0}, batches{0}, drains{0}, busy_ticks{0};
+
+private:
+    void Run(std::stop_token stop_token);
+
+    static constexpr size_t kBatch = 64;          // tasks a batch, at most
+    static constexpr size_t kMaxQueuedTasks = 16384;  // queued and not yet run: the front end waits
+
+    std::vector<Task> batch;  // the front end's, not yet published
+    std::mutex mutex;
+    std::condition_variable_any work_cv, done_cv;
+    std::deque<std::vector<Task>> queue;
+    size_t queued_tasks = 0;  // in `queue`
+    bool running_task = false;
+    std::atomic<u64> published{0}, taken{0};  // batches: the back end's spin watches these
+    std::atomic<std::thread::id> thread_id{};
+    std::jthread thread;
+};
+
+/// The rasterizer the front end's engines (the 3D engine, DmaPusher, the puller) are bound to: each
+/// call queued for the real one on the back end (run straight away on the back end itself), the 3D
+/// engine's shadow brought up to date first where the call reads it; a call that returns something
+/// waits for the back end to empty its queue
+class RasterizerProxy final : public VideoCore::RasterizerInterface {
+public:
+    RasterizerProxy(VideoCore::RasterizerInterface& real_, GpuBackend& backend_);
+    ~RasterizerProxy() override;
+
+    VideoCore::RasterizerInterface& Real() {
+        return real;
+    }
+
+    /// The 3D engine's state the rasterizer reads, from the bound channel's front end engine to its
+    /// shadow: the registers that changed since the last time, the dirty flags (cleared on the front
+    /// end, which only sets them), the pipeline key's flag, the draw manager's state, the engine hint
+    void SyncState();
+
+    void Draw(bool is_indexed, u32 instance_count) override;
