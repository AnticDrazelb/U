+private:
+    /// Runs `f` on the real rasterizer: now on the back end, else queued
+    template <typename F>
+    void Forward(F&& f);
+
+    struct Shadowed {
+        Tegra::Engines::Maxwell3D* front = nullptr;
+        Tegra::Engines::Maxwell3D* shadow = nullptr;
+        std::unique_ptr<u32[]> sent;  // the front end's registers as last sent
+    };
+    VideoCore::RasterizerInterface& real;
+    GpuBackend& backend;
+    std::mutex channels_mutex;  // (channels are made on the emulated CPU's threads)
+    std::unordered_map<s32, Shadowed> channels;  // by bind id
+    Shadowed* bound = nullptr;  // the front end's: the bound channel
+};
+
+/// The split's objects while it's on: the back end and the proxy (set by the GPU when it starts)
+struct GpuSplit {
+    GpuBackend backend;
+    std::unique_ptr<RasterizerProxy> proxy;
+};
+/// Set on the front end's thread (the GPU thread): only it puts work on the back end; anything
+/// else (the emulated CPU's threads) calls the real rasterizer as before
+inline thread_local bool g_gpu_front_thread = false;
+
+/// Null with the split off
+GpuSplit* ActiveGpuSplit();
+void SetActiveGpuSplit(GpuSplit* split);
+
+/// The front end's way to put work on the back end, in order (the 3D engine's memory writes, the
+/// other engines' methods): run now if the split is off (or this is the back end)
+void RunOnGpuBackend(std::function<void()>&& task);
+
+/// Whether work of the front end's must go to the back end (the split on, and this isn't it): the
+/// callers copy what the task needs only then, the single thread's path unchanged
+inline bool DeferToGpuBackend() {
+    return g_gpu_front_thread && ActiveGpuSplit() != nullptr;
+}
