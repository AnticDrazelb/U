+
+void RasterizerProxy::InitializeChannel(Tegra::Control::ChannelState& channel) {
+    // (at the channel's creation, before it runs: as the real rasterizer is called now)
+    real.InitializeChannel(channel);
+    auto& payload = *channel.payload;
+    std::scoped_lock lock{channels_mutex};
+    Shadowed& s = channels[channel.bind_id];
+    s.front = &payload.maxwell_3d;
+    s.shadow = payload.shadow_maxwell_3d.get();
+    if (s.shadow != nullptr) {
+        // the renderer's dirty tables are the shadow's (the caches read it): the front end's
+        // register writes set the same flags
+        s.front->dirty.tables = s.shadow->dirty.tables;
+        s.sent = std::make_unique<u32[]>(Tegra::Engines::Maxwell3D::Regs::NUM_REGS);
+        std::memcpy(s.sent.get(), s.shadow->regs.reg_array.data(),
+                    sizeof(u32) * Tegra::Engines::Maxwell3D::Regs::NUM_REGS);
+    }
+}
+
+void RasterizerProxy::BindChannel(Tegra::Control::ChannelState& channel) {
+    {
+        std::scoped_lock lock{channels_mutex};
+        const auto it = channels.find(channel.bind_id);
+        bound = it == channels.end() ? nullptr : &it->second;
+    }
+    Tegra::Control::ChannelState* const state = &channel;
+    Forward([state](VideoCore::RasterizerInterface& r) { r.BindChannel(*state); });
+}
