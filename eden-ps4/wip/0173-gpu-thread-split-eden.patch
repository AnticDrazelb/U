+bool GpuSplitEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("EDEN_PS4_GPU_SPLIT");
+        return value != nullptr && std::string_view{value} == "1";
+    }();
+    return enabled;
+}
+
+namespace {
+std::atomic<GpuSplit*> g_split{nullptr};
+} // namespace
+
+GpuSplit* ActiveGpuSplit() {
+    return g_split.load(std::memory_order_acquire);
+}
+
+void SetActiveGpuSplit(GpuSplit* split) {
+    g_split.store(split, std::memory_order_release);
+}
+
+void RunOnGpuBackend(std::function<void()>&& task) {
+    GpuSplit* const split = ActiveGpuSplit();
+    if (split == nullptr || !g_gpu_front_thread) {
+        task();
+        return;
+    }
+    split->backend.Push(std::move(task));
+}
+
+// ---- the back end ----
+
+GpuBackend::GpuBackend() {
+    batch.reserve(kBatch);
+}
+
+GpuBackend::~GpuBackend() {
+    Stop();
+}
+
+void GpuBackend::Start(std::function<void()> on_start) {
+    thread = std::jthread([this, on_start = std::move(on_start)](std::stop_token stop_token) {
+        thread_id.store(std::this_thread::get_id(), std::memory_order_relaxed);
+        if (on_start) {
+            on_start();
+        }
+        Run(stop_token);
+    });
+}
+
+void GpuBackend::Push(Task&& task) {
+    batch.push_back(std::move(task));
+    if (batch.size() >= kBatch) {
+        Publish();
+    }
+}
+
+void GpuBackend::Publish() {
+    if (batch.empty()) {
+        return;
+    }
+    const size_t count = batch.size();
+    {
+        std::unique_lock lock{mutex};
+        // (bounded: the front end can't run frames ahead of the back end)
+        done_cv.wait(lock, [&] { return queued_tasks + count <= kMaxQueuedTasks || queue.empty() || !thread.joinable(); });
+        queue.push_back(std::move(batch));
+        queued_tasks += count;
+        published.fetch_add(1, std::memory_order_release);
+    }
+    batches.fetch_add(1, std::memory_order_relaxed);
+    work_cv.notify_one();
+    batch = {};
+    batch.reserve(kBatch);
+}
+
+void GpuBackend::Drain() {
+    ASSERT(!OnBackend());
+    Publish();
+    std::unique_lock lock{mutex};
+    done_cv.wait(lock, [&] { return (queue.empty() && !running_task) || !thread.joinable(); });
+    drains.fetch_add(1, std::memory_order_relaxed);
+}
+
+void GpuBackend::Stop() {
+    if (!thread.joinable()) {
+        return;
+    }
+    thread.request_stop();
+    work_cv.notify_all();
+    thread.join();
+    std::scoped_lock lock{mutex};
+    queue.clear();
+    queued_tasks = 0;
+    running_task = false;
+    done_cv.notify_all();
+}
+
+void GpuBackend::Run(std::stop_token stop_token) {
+    while (!stop_token.stop_requested()) {
+        std::vector<Task> tasks;
+        {
+            std::unique_lock lock{mutex};
+            if (queue.empty()) {
+                // (a short spin first, as the GPU thread does for its own queue: the next batch
+                // usually comes within microseconds, a sleeping thread's wake-up takes hundreds)
+                lock.unlock();
+                const u64 seen = taken.load(std::memory_order_relaxed);
+                const auto spin_end = std::chrono::steady_clock::now() + std::chrono::microseconds(500);
+                while (published.load(std::memory_order_acquire) == seen && !stop_token.stop_requested() &&
+                       std::chrono::steady_clock::now() < spin_end) {
+#if defined(__x86_64__)
+                    for (int i = 0; i < 16; i++) {
+                        _mm_pause();
+                    }
+#endif
+                }
+                lock.lock();
+                work_cv.wait(lock, stop_token, [&] { return !queue.empty(); });
+                if (stop_token.stop_requested()) {
+                    return;
+                }
+            }
+            tasks = std::move(queue.front());
+            queue.pop_front();
+            taken.fetch_add(1, std::memory_order_relaxed);
+            running_task = true;
+        }
+        const u64 start = Common::PS4Perf::Ticks();
+        for (Task& task : tasks) {
+            task();
+        }
+        busy_ticks.fetch_add(Common::PS4Perf::Ticks() - start, std::memory_order_relaxed);
+        tasks_run.fetch_add(tasks.size(), std::memory_order_relaxed);
+        {
+            std::scoped_lock lock{mutex};
+            queued_tasks -= tasks.size();
+            running_task = false;
+        }
+        done_cv.notify_all();
+    }
+}
